# Log files the sample backend writes, relative to wherever it is run from
# (application.properties: logging.file=logs/health-record.log), plus log.zm's
# rotated `.1`, `.2`, ... siblings. The directory itself stays tracked, through
# logs/.gitkeep: fs.append_text does not create a missing directory, it just
# fails, so a fresh clone without logs/ would silently stop logging.
logs/*.log
logs/*.log.*

# tools/preflight.sh writes one log per step
.preflight-*.log

# Claude Code session state: a lock file for scheduled tasks and any throwaway
# worktrees. The skills under .claude/skills/ are committed on purpose -- they are
# repository tooling -- so this ignores the state beside them rather than the directory.
.claude/scheduled_tasks.lock
.claude/worktrees/
