// `len` works on all four builders, not just on an array, string, map or set -- so asking a
// builder its size no longer needs a per-type name, and never needs a conversion. The per-type
// functions still work and must agree, which is what the pairs below check.

fn main() {
    val ab = mutable_array_new<int>()
    push(ab, 1, 2, 3)
    print(len(ab))
    print(len(ab))

    val sb = mutable_string_new()
    append(sb, "hello")
    print(byte_len(sb))
    print(byte_len(sb))

    val mb = mutable_map_new<string, int>()
    set(mb, "a", 1)
    set(mb, "b", 2)
    print(len(mb))
    print(len(mb))

    val st = mutable_set_new<int>()
    add(st, 7)
    add(st, 7)
    print(len(st))
    print(len(st))

    // Live, like every other read on a builder: an append and a clear both show up.
    push(ab, 4)
    print(len(ab))
    clear(ab)
    print(len(ab))

    val empty = mutable_string_new()
    print(byte_len(empty))
}
