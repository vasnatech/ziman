// F51, the other '|' habit from the same wave (task 39): the F#/Elixir/OCaml pipeline. Same
// misleading "did you mean '||'?" before this. Ziman's answer is a nested call or a val per step.

fn main() {
    val xs = [1, 2, 3, 4]
    val total = xs
        |> filter(fn(n: int) -> bool { n % 2 == 0 })
        |> array_sum()
    print(total)
}
