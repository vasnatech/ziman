use fs
use log
use log.Level

fn main() {
    val path = "/tmp/ziman_fixture_log_basic.log"
    val _ = fs.remove(path)
    val l = log.logger(level: Level.Info, file: path, timestamps: false, prefix: "app: ")
    log.debug(l, "hidden")
    log.info(l, "shown")
    log.warn(with_prefix_demo(l), "component")
    log.error(l, "boom")
    print(unwrap(fs.read_text(path)))
    print(log.enabled(l, Level.Debug))
    print(log.enabled(l, Level.Error))
    print(log.parse_level("WARNING"))
    print(log.parse_level(" Debug "))
    print(log.parse_level("loud"))

    // **`log.format` answers the bare name**, unpadded. It used to pad to five ("INFO ") so the
    // text format's columns line up, which put a presentation detail in the value every other
    // caller got -- `json_line` trimmed it back off, and anyone writing their own format inherited
    // a space they had to know about. The padding is in the text formatter now, and the lines
    // printed above are byte-identical to before.
    print(concat("[", log.format(Level.Debug), "]"))
    print(concat("[", log.format(Level.Info), "]"))
    print(concat("[", log.format(Level.Warn), "]"))
    print(concat("[", log.format(Level.Error), "]"))
    print(log.rank(Level.Debug) < log.rank(Level.Error))

    val _ = fs.remove(path)
}

fn with_prefix_demo(l: log.Logger) -> log.Logger {
    return log.with_prefix(l, "db: ")
}
