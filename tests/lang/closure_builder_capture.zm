// F40: capturing a builder handle from a lambda and mutating through it is intended, not a hole.
// Capture is by value, and what gets copied is the *handle* -- the builder's state lives behind it,
// so mutations through the copy are shared. That is how mutable state in a lambda is already
// expressible without capturing a `var`: a memoising closure, below, needs no language change.
//
// The thing that would actually be unsafe -- two threads mutating one builder -- is a compile
// error, and has its own fixture in diag_lambda_builder_crosses_thread.
fn main() {
    val cache = mutable_map_new<int, int>()
    val square = fn(n: int) -> int {
        if contains(cache, n) {
            return get_or(cache, n, 0)
        }
        val computed = n * n
        set(cache, n, computed)
        return computed
    }
    print(square(7))
    print(square(7))
    print(len(cache))

    // and the accumulate case, which `fold` covers without any capture at all
    val b = mutable_map_new<string, int>()
    val bump = fn(k: string) { set(b, k, 1) }
    bump("a")
    bump("b")
    print(len(b))
}
