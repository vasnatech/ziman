use crypto
use number

fn h(s: string) -> string {
    return number.bytes_to_hex(crypto.sha256(to_bytes(s)))
}

fn main() {
    // FIPS 180-4 / NIST vectors
    print(h(""))
    print(h("abc"))
    print(h("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
    // multi-block boundary (55, 56, 64 bytes)
    print(h("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
    print(h("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
    print(h("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
}
