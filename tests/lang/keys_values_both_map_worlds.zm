// F194, item 2 of the Map/Set pairing pass: `keys` and `values` over a Map and a MutableMap.
//
// Both answer *immutable* values from either world -- `keys` a `Set<K>`, `values` a `[V]` --
// unlike the in-place half of `filter`. That is not an inconsistency: these are queries, and a
// query's result is nearly always consumed by a `for` or returned, so handing back a handle
// would allocate a thread-bound one for nothing.
//
// This is the row the 2026-10-09 benchmark pointed at. A run concluded "there is no keys
// function" when the builtin existed under the name `map_keys`; afterwards `mutable_map_keys`
// was invisible to `--api builtins`, so the same question asked of a builder still answered
// nothing. One name now covers both.
fn main() {
    val m = Map<string, int> { "a": 1, "b": 2 }
    print(keys(m))
    print(values(m))

    val b = mutable(m)
    print(keys(b))
    print(values(b))

    // insertion order is kept in both worlds, which is what makes the two comparable at all
    set<string, int>(b, "c", 3)
    print(keys(b))
    print(values(b))

    // named arguments, which F193's table split allows for a converted builtin
    print(keys(m: m))

    // and the empty cases
    print(len(keys(Map<string, int> { })))
    print(values(mutable(Map<string, int> { })))
}
