fn main() {
    val some = Option<int>.Some(42)
    val none = Option<int>.None
    print(Option.is_Some(some))
    print(Option.unwrap_Some(some))
    print(get_or<int>(none, -1))

    var m = Map<string, int> {}
    m = set(m, "alice", 30)
    m = set(m, "bob", 25)
    m = set(m, "alice", 31) // overwrite

    print(contains(m, "alice"))
    print(get_or<int>(get(m, "alice"), -1))
    print(get_or<int>(get(m, "bob"), -1))
    print(contains(m, "carol"))

    m = remove(m, "bob")
    print(contains(m, "bob"))

    var s = Set<int> {}
    s = insert(s, 1)
    s = insert(s, 2)
    s = insert(s, 1) // duplicate, no-op

    print(contains(s, 1))
    print(contains(s, 2))
    print(contains(s, 3))

    s = remove(s, 1)
    print(contains(s, 1))
}
