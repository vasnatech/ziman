use net
use client
use http
use http.HttpMethod

// An echo server that works on raw bytes, so a body may hold 0 bytes.
fn find_head_end(buf: [byte]) -> int {
    var i = 0
    while i + 3 < len(buf) {
        if buf[i] == 13b && buf[i + 1] == 10b && buf[i + 2] == 13b && buf[i + 3] == 10b {
            return i + 4
        }
        i = i + 1
    }
    return -1
}

fn handle(s: net.Socket) {
    defer net.close(s)
    unwrap(net.set_timeout(s, 2000))
    var buf: [byte] = []
    var end = find_head_end(buf)
    while end < 0 {
        buf = bytes_concat(buf, unwrap(net.read(s, 4096)))
        end = find_head_end(buf)
    }
    val head = to_lower(unwrap(bytes_to_string(slice<byte>(buf, 0, end))))
    var want = 0
    if contains(head, "content-length: ") {
        want = unwrap(parse_int(trim(split(split(head, "content-length: ")[1], "\r\n")[0])))
    }
    var body = slice<byte>(buf, end, len(buf))
    if want > len(body) {
        body = bytes_concat(body, unwrap(net.read_exact(s, want - len(body))))
    }
    if contains(head, "get /bin ") {
        body = [104b, 0b, 105b]
    }
    unwrap(net.write_text(s, format("HTTP/1.1 200 OK\r\nContent-Length: {}\r\n\r\n", len(body))))
    if len(body) > 0 {
        unwrap(net.write(s, body))
    }
}

fn accept_loop(l: net.Listener) {
    while true {
        val c = net.accept(l)
        if !is_ok(c) {
            return
        }
        spawn handle(unwrap(c))
    }
}

fn main() {
    val l = unwrap(net.listen("127.0.0.1", 0))
    val url = format("http://127.0.0.1:{}/", net.listener_port(l))
    spawn accept_loop(l)

    val payload = [1b, 0b, 255b, 10b, 0b]
    val r = client.request(method: HttpMethod.Post, url: url, body: payload)
    val resp = unwrap(r)
    print(resp.status)
    print(resp.body == payload)
    print(len(resp.body))

    val empty = unwrap(client.request(method: HttpMethod.Get, url: url))
    print(len(empty.body))

    val text = client.request(method: HttpMethod.Post, url: url, body: string_to_bytes("plain text"))
    print(unwrap(bytes_to_string(unwrap(text).body)))

    val bin_url = format("{}bin", url)
    print(unwrap(client.request(method: HttpMethod.Get, url: bin_url)).body == [104b, 0b, 105b])
    // a binary body is not text: reading it as text says so, and http.response_text agrees
    val as_text = bytes_to_string(unwrap(client.get(bin_url)).body)
    print(is_ok(as_text))
    print(unwrap_err(as_text))
    print(is_ok(http.response_text(unwrap(client.get(bin_url)))))
    // No `net.close_listener(l)`, for the reason http_body_cap_option.zm spells out and
    // httpclient_redirect_keeps_url_credentials.zm was fixed for (9cab978): closing the listener is
    // not how a server is stopped, so closing it under the accepting thread is an error that
    // `on_error` would print into this fixture's own stdout. The window here is narrow -- the loop
    // breaks on a non-Ok accept and hands each connection to another thread, so it is back in
    // `accept` almost immediately -- which is why this never flaked where the inline-handling one
    // did. Narrow is not closed. Process exit tears the listener down.
}
