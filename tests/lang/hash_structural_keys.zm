use uuid

struct Key {
    patient: uuid.Uuid
    year: int
}

enum Rank {
    Low
    Mid(int)
    High(string)
}

struct Wrap {
    r: Option<int>
    tags: [string]
}

fn main() {
    val a = unwrap(uuid.uuid_from_string("00000000-0000-4000-8000-000000000001"))
    val b = unwrap(uuid.uuid_from_string("00000000-0000-4000-8000-000000000002"))
    val a2 = unwrap(uuid.uuid_from_string("00000000-0000-4000-8000-000000000001"))
    print(hash(a) == hash(a2))
    print(hash(a) == hash(b))

    var m = Map<uuid.Uuid, string> {}
    m = set(m, a, "ada")
    m = set(m, b, "bob")
    print(get(m, a2))
    print(len(m))

    var by_rank = Map<Rank, int> {}
    by_rank = set(by_rank, Rank.Low, 1)
    by_rank = set(by_rank, Rank.Mid(5), 2)
    by_rank = set(by_rank, Rank.High("x"), 3)
    print(get(by_rank, Rank.Mid(5)))
    print(get(by_rank, Rank.Mid(6)))
    print(get(by_rank, Rank.High("x")))

    var s = Set<Key> {}
    s = insert(s, Key { patient: a, year: 2024 })
    s = insert(s, Key { patient: a2, year: 2024 })
    s = insert(s, Key { patient: a, year: 2025 })
    print(len(s))
    print(contains(s, Key { patient: a2, year: 2025 }))
    print(contains(s, Key { patient: b, year: 2025 }))

    print(hash(Option<int>.Some(3)) == hash(Option<int>.Some(3)))
    print(hash([1, 2, 3]) == hash([1, 2, 3]))
    print(hash([1, 2, 3]) == hash([3, 2, 1]))
    print(hash(0.0) == hash(-0.0))
    val r1: Result<int, string> = 1
    val r2: Result<int, string> = 1
    print(hash(r1) == hash(r2))
    print(hash(Wrap { r: Option<int>.None, tags: ["a"] }) == hash(Wrap { r: Option<int>.None, tags: ["a"] }))
}
