enum Maybe<T> {
    Some(T)
    None
}

fn main() {
    val a = Maybe<int>.Some(5)
    val b = Maybe<int>.None

    print(Maybe.is_Some(a))
    print(Maybe.is_None(a))
    print(Maybe.unwrap_Some(a))
    print(Maybe.is_Some(b))
    print(Maybe.is_None(b))

    val s = Maybe<string>.Some("hi")
    print(Maybe.unwrap_Some(s))
}
