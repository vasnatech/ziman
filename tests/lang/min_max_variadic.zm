// min/max are variadic and Ord-bounded, not just the four numeric scalars: two or more
// individually-listed arguments, or exactly one already-built array as the whole list, works
// for anything Ord (int/float/bigint/decimal/byte/string, or a struct/enum with its own
// <type>_compare), the same rule compare/sort already use.
// `abs`/`min`/`max` moved from the prelude to the `math` module on 2026-10-22, so these
// are `math.`-qualified and the fixture needs a `use`.
use math

struct Person {
    name: string
    age: int
}

fn person_compare(a: Person, b: Person) -> int {
    return a.age - b.age
}

fn main() {
    print(math.min(3, 1, 4, 1, 5, 9, 2, 6))       // 1
    print(math.max(3, 1, 4, 1, 5, 9, 2, 6))       // 9
    print(math.min([3, 1, 4, 1, 5]))              // 1 -- a single array argument
    print(math.min("banana", "apple", "cherry"))  // apple
    print(math.min(5))                            // 5 -- one argument is legal

    val people = [Person { name: "Ada", age: 36 }, Person { name: "Bo", age: 20 }]
    print(math.min(people).name)  // Bo
    print(math.max(people).name)  // Ada
}
