// Regression test: a variadic parameter whose *element* type is itself
// an array used to be misinterpreted at runtime -- collapse_variadic_args
// decided "one trailing argument, and it's an array, so treat it as the
// whole spread tail" purely from `.type.kind == TY_ARRAY`, which can't
// tell "one element that happens to be an array" apart from "the whole
// already-built tail array" when the element type is an array too. Only
// check_call's own static, unambiguous decision (recorded on the AST,
// see ast.h's variadic_tail_is_array_spread) can tell them apart
// correctly. See docs/design/journal/.
fn concat_rows(rows: variadic [int]) -> int {
    var total = 0
    for row in rows {
        for x in row {
            total = total + x
        }
    }
    return total
}

fn main() {
    // The genuinely ambiguous case: exactly one trailing argument, of
    // the element type ([int]), not the whole spread tail ([[int]]).
    print(concat_rows([1, 2, 3]))

    // Multiple individually-listed elements -- never ambiguous.
    print(concat_rows([1, 2], [3, 4], [5]))

    // An explicit spread: one trailing argument of the *array* type
    // ([[int]]), passed through directly.
    val many: [[int]] = [[1], [2], [3]]
    print(concat_rows(many))
}
