// `xs[0] = 9` used to be refused in the parser -- "arrays are values, not mutable containers" --
// because the repair it pointed at, `xs = set(xs, 0, 9)`, was the only way to say it. The repair is
// what this now means: the checker rewrites the statement into exactly that assignment, so the
// rebinding still happens and `var` is still required (index_assign_val_rejected).
fn main() {
    var xs = [1, 2, 3]
    xs[0] = 9
    print(xs)
}
