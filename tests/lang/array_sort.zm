
#[derive(Ord)]
struct Person {
    last: string
    first: string
}

struct Patient {
    name: string
    age: int
}

fn main() {
    print(sort([5, 2, 9, 1, 5, 6]))
    print(sort(["pear", "apple", "fig", "apple"]))
    print(sort([2.5, 0.5, 1.5]))
    print(reverse(sort([3, 1, 2])))
    val empty: [int] = []
    print(sort(empty))
    print(sort([7]))
    val people = [Person { last: "Lovelace", first: "Ada" }, Person { last: "Babbage", first: "Charles" }, Person { last: "Lovelace", first: "Annabella" }]
    for p in sort(people) {
        print(concat(p.last, concat(", ", p.first)))
    }
    // sort by a field via a key array
    val patients = [Patient { name: "Zoe", age: 30 }, Patient { name: "Al", age: 71 }, Patient { name: "Mo", age: 30 }]
    var ages: [int] = []
    for p in patients {
        ages = push(ages, p.age)
    }
    for p in array_sort_by_keys<Patient, int>(patients, ages) {
        print(concat(p.name, str(p.age)))
    }
    print(array_is_sorted<int>([1, 2, 2, 3]))
    print(array_is_sorted<int>([1, 3, 2]))
    val s = sort([10, 20, 20, 30, 40])
    print(array_binary_search<int>(s, 20))
    print(array_binary_search<int>(s, 25))
    print(array_binary_search<int>(s, 40))
    // a big one
    var big: [int] = []
    for i in 0..500 {
        big = push(big, (i * 7919) % 1000)
    }
    print(array_is_sorted<int>(sort(big)))
}
