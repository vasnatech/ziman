// `#[derive(Json)]`'s three struct functions, written in Ziman: `to_json`, `from_json` and the
// accumulating `from_json_all`. **Still a partial port** -- the two enum halves are in
// `src/derive.c`, and `derive_json.generate` refuses by name rather than answering a struct and
// failing an enum, so nothing is wired yet and `#[derive(Json)]` goes through the C.
//
// The struct covers every shape these reach: a `Uuid`, all the scalars, a **module-qualified**
// `time.Instant` (short-spelled converters, and the one shape whose type name is written out),
// an array, a `Map<string, int>` and two `Option`s. The expected text is what the C emits today,
// byte for byte, **including the temporary names** -- those come from a counter, the order they
// are taken in differs between an array and a set, and getting it wrong diverges invisibly.
use derive_json
use meta

fn f(name: string, t: meta.Type) -> meta.Field {
    return meta.field(name, t)
}
fn opt(t: meta.Type) -> meta.Type {
    return meta.optional_type(t)
}
fn main() {
    val none: [string] = []
    val d = meta.struct_decl("Wide", "wide", none, [
        f("id", meta.named_type("uuid.Uuid", [])),
        f("count", meta.int_type()),
        f("ratio", meta.float_type()),
        f("ok", meta.bool_type()),
        f("label", meta.string_type()),
        f("at", meta.named_type("time.Instant", [])),
        f("tags", meta.array_type(meta.string_type())),
        f("scores", meta.map_type(meta.string_type(), meta.int_type())),
        f("middle_name", opt(meta.string_type())),
        f("seen", opt(meta.named_type("time.Instant", [])))
    ])
    // `generate` is exactly those three concatenated, and calling it rather than the three
    // keeps this fixture from re-stating the order they are spliced in.
    print(unwrap(derive_json.generate(d)))
}
