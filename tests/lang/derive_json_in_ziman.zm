// `#[derive(Json)]` written in Ziman: `to_json`, `from_json` and the accumulating
// `from_json_all` for a struct, and `to_json`/`from_json` for an enum.
//
// **The "partly ported" note this file carried is gone** (2026-10-29): it said the enum halves
// were still in `src/derive.c` and that `generate` refused an enum by name, which was true at
// F226 and stopped being true when the port finished at F229. `src/derive.c` generates nothing
// at all now.
//
// **The enum half is pinned here for the first time**, which is why it was added: changing the
// indentation of generated enum code moved no fixture at all, because the enum fixtures that
// exist (`derive_json_enum_tagged`, `derive_json_generic`) check that a value round-trips rather
// than what the generator wrote. Round-tripping cannot see a temporary named twice or a block
// closed in the wrong arm.
//
// The struct covers every shape these reach: a `Uuid`, all the scalars, a **module-qualified**
// `time.Instant` (short-spelled converters, and the one shape whose type name is written out),
// an array, a `Map<string, int>` and two `Option`s. The expected text is what the C emits today,
// byte for byte, **including the temporary names** -- those come from a counter, the order they
// are taken in differs between an array and a set, and getting it wrong diverges invisibly.
use derive_json
use meta

val no_attrs: [meta.Attr] = []

fn f(name: string, t: meta.Type) -> meta.Field {
    return meta.field(name, t, no_attrs)
}
fn opt(t: meta.Type) -> meta.Type {
    return meta.optional_type(t)
}
fn main() {
    val none: [string] = []
    val d = meta.struct_decl("Wide", "wide", meta.no_arg(), none, [
        f("id", meta.named_type("uuid.Uuid", [])),
        f("count", meta.int_type()),
        f("ratio", meta.float_type()),
        f("ok", meta.bool_type()),
        f("label", meta.string_type()),
        f("at", meta.named_type("time.Instant", [])),
        f("tags", meta.array_type(meta.string_type())),
        f("scores", meta.map_type(meta.string_type(), meta.int_type())),
        f("middle_name", opt(meta.string_type())),
        f("seen", opt(meta.named_type("time.Instant", [])))
    ])
    // `generate` is exactly those three concatenated, and calling it rather than the three
    // keeps this fixture from re-stating the order they are spliced in.
    print(unwrap(derive_json.generate(d)))

    // An enum, with the three variant shapes the generator distinguishes: a payload that needs a
    // converter call, a payload that is a scalar written inline, and no payload at all. The
    // opener/closer dance -- `if`, `} else if`, `} else`, and the brace the last arm leaves open --
    // is what this text is really checking, since it is spread across two templates and a flag.
    val e = meta.enum_decl("Shape", "shape", meta.no_arg(), none, [
        meta.payload_variant("Circle", meta.named_type("time.Instant", [])),
        meta.payload_variant("Square", meta.float_type()),
        meta.unit_variant("Point")
    ])
    print(unwrap(derive_json.generate(e)))
}
