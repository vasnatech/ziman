// The other half of discard_overload_purity_rejected: the builder members of the same sets
// return nothing, so a bare call is how they are meant to be written and the gate must stay
// silent.
//
// This file said that a mutating overload which returned a value would need a marker on the
// declaration rather than the return-type rule, and would be the file to change. Three of them
// exist -- `remove` on each of the three builders -- so the marker is `#[effectful]` and they are
// exercised below. The one on a MutableArray only joined them in F208: until then the checker
// rewrote the callee to `mutable_array_remove`, and the only reason a discarded `remove(b, 0)`
// was accepted is that the gate did not recognise the name it had just written.
fn main() {
    val b = mutable([3, 1, 2])
    sort(b)
    reverse(b)
    filter(b, fn(x: int) -> bool { return x > 1 })
    sort_desc(b)
    sort_by(b, fn(x: int) -> int { return -x })
    for_each(b, fn(x: int) { print(x) })
    print(snapshot(b))

    // and the query members of the very same names are still refused when discarded -- see the
    // rejection fixture; here they are bound, which is the repair the message asks for.
    val d = distinct(b)
    val n = count(b, fn(x: int) -> bool { return x > 1 })
    print(len(d))
    print(n)

    // `#[effectful]`: these three write the container *and* answer a value, and discarding the
    // value is the ordinary call -- `remove(b, len(b) - 1)` is how `pop` is spelled, and the map
    // and set forms are "delete if present". The array's `remove` copies and changes nothing, so
    // discarding that one is still refused; the rejection fixture holds that half.
    remove(b, len(b) - 1)
    print(snapshot(b))

    val m = mutable_map_new<string, int>()
    set(m, "a", 1)
    remove(m, "a")
    remove(m, "gone")
    print(len(m))

    val s = mutable_set_new<int>()
    remove(s, 7)
    print(len(s))

    // `add` and `remove_all` on a builder joined them in F212, for the reason their own comments
    // give: each writes the container and answers whether anything changed, and "make sure these
    // are in here" / "delete these if present" has no use for that answer. Both were *refused*
    // from F199 until then, so `val _ = add(s, x)` was the spelling the corpus had to use.
    add(s, 1, 2)
    remove_all(s, 1)
    remove_all(m, "gone")
    print(len(s))
    print(len(m))
}
