fn show(r: Result<string, string>) {
    switch r {
        Ok(s) {
            print(format("ok: {}", s))
        }
        Err(e) {
            print(format("err: {}", e))
        }
    }
}

fn main() {
    show(format_dynamic("{} of {}", ["3", "10"]))
    show(format_dynamic("no placeholders", []))
    show(format_dynamic("{{{}}} and {{}}", ["x"]))
    show(format_dynamic("", []))
    show(format_dynamic("{}{}{}", ["a", "", "c"]))
    show(format_dynamic("{} of", ["3", "10"]))
    show(format_dynamic("{} of {}", ["3"]))
    show(format_dynamic("{:.2}", ["3"]))
    show(format_dynamic("oops { here", []))
    show(format_dynamic("oops } here", []))
    show(format_dynamic("{:.}", ["1"]))
    show(format_dynamic("{:.101}", ["1"]))
}
