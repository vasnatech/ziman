fn main() {
    // Everything defaulted -- the fully-omitted call this feature exists
    // to make possible (`mutable_string_new()` alone, no named or positional args at
    // all, is ambiguous between "positional zero-arg" and "named,
    // everything omitted" -- treated as the latter).
    val sb = mutable_string_new()
    print(len(sb))
    append(sb, "Hello")
    append(sb, ", ", "world", "!")
    print(snapshot(sb))
    print(len(sb))

    // Custom capacity/grow_factor, named, forcing many reallocations.
    val sb2 = mutable_string_new(capacity: 4, grow_factor: 1.5)
    var i = 0
    while i < 50 {
        append(sb2, "x")
        i = i + 1
    }
    print(len(sb2))
    print(len(snapshot(sb2)))

    // Fully positional, both args given explicitly.
    val sb3 = mutable_string_new(10, 3.0)
    append(sb3, "hi")
    print(snapshot(sb3))

    // Appending an already-built array (variadic spread).
    val sb4 = mutable_string_new()
    val pieces = ["a", "b", "c"]
    append(sb4, pieces)
    print(snapshot(sb4))

    // snapshot is a snapshot, not a one-time "finish" -- calling it
    // more than once, and continuing to append in between, both work.
    val sb5 = mutable_string_new()
    append(sb5, "one")
    print(snapshot(sb5))
    append(sb5, "-two")
    print(snapshot(sb5))

    // Two independent builders never interfere with each other.
    val sb6 = mutable_string_new()
    val sb7 = mutable_string_new()
    append(sb6, "A")
    append(sb7, "B")
    print(snapshot(sb6))
    print(snapshot(sb7))
}
