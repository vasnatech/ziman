use datasource
use db.db_error_message

fn main() {
    val url = "sqlite:/tmp/ziman_fixture_pool_timeout.db"
    val pool = unwrap(datasource.open_pool(url, 2))
    val a = unwrap(datasource.acquire_timeout(pool, 50))
    val b = unwrap(datasource.acquire_timeout(pool, 0))
    val none = datasource.acquire_timeout(pool, 40)
    print(is_ok(none))
    print(db_error_message(unwrap_err(none)))
    print(is_ok(datasource.acquire_timeout(pool, 0)))
    datasource.release(pool, a)
    val again = datasource.acquire_timeout(pool, 40)
    print(is_ok(again))
    datasource.release(pool, unwrap(again))
    datasource.release(pool, b)
    // discard puts a fresh connection back
    val c = unwrap(datasource.acquire(pool))
    datasource.discard(pool, c)
    val d = unwrap(datasource.acquire_timeout(pool, 0))
    print(is_ok(datasource.query(d, "SELECT 1 AS n")))
    datasource.release(pool, d)
    // on a plain connection both are no-ops
    val plain = unwrap(datasource.open("sqlite::memory:"))
    val same = unwrap(datasource.acquire_timeout(plain, 10))
    datasource.discard(plain, same)
    print(is_ok(datasource.query(plain, "SELECT 1 AS n")))
    datasource.close(pool)
    datasource.close(plain)
}
