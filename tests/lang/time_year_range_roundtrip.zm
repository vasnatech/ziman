use time
use time.add_days
use time.parse_localdate
use time.localdate_of

fn main() {
    val d = unwrap(parse_localdate("9999-06-01"))
    val due = add_days(d, 280)
    print(time.format(due))
    switch parse_localdate(time.format(due)) {
        Ok(x) { print(time.format(x)) }
        Err(e) { print(e) }
    }
    val early = add_days(unwrap(localdate_of(1, 1, 1)), -800000)
    print(time.format(early))
    for s in ["-0044-03-15", "+9999-01-01", "+123-01-01", "+1234567890-01-01", "0000-01-01", "abcd-01-01"] {
        switch parse_localdate(s) {
            Ok(x) { print(format("{} -> {}", s, time.format(x))) }
            Err(e) { print(e) }
        }
    }
}
