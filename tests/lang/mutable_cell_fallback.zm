// Everything without a builder answers a `Mutable<T>` cell, the mutable counterpart of a single
// value. A string is in this half rather than answering a MutableString, because a MutableString is
// *filled* rather than converted and so is not this conversion.
//
// A builder is in this half too, and it answers a cell holding that same handle rather than a clone
// of it -- pushing through what comes back out changes the original, which is what the last two
// lines check. There is no way to clone a builder at all: `mutable_array_from` and its two
// siblings were removed once `mutable` covered the conversion they were mostly used for.
fn main() {
    val ci = mutable(7)
    set<int>(ci, 8)
    print(get<int>(ci))

    val cs = mutable("hi")
    set<string>(cs, "there")
    print(get<string>(cs))

    print(get<bool>(mutable(true)))

    val ab = mutable<int>([1, 2])
    val held = get<MutableArray<int>>(mutable(ab))
    push(held, 3)
    print(snapshot(ab))
}
