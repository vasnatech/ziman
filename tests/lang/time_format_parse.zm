use time
use time.LocalDate
use time.localdate_of
use time.parse_localdate
use time.LocalTime
use time.localtime_of
use time.parse_time
use time.LocalDateTime
use time.localdatetime_of
use time.parse_datetime
use time.Instant
use time.instant_of
use time.parse_instant
use time.zoneoffset_utc
use time.zoneoffset_of_hours_minutes
use time.parse_offset
use time.parse_zone
use time.Duration
use time.duration_of_seconds
use time.parse_duration
use time.iso_date_format
use time.iso_datetime_format
use time.datetime_format_of

fn main() {
    // Custom (non-ISO) pattern formatting and parsing -- compiled once
    // via datetime_format_of, then reused for both calls.
    val custom_fmt = datetime_format_of("dd/MM/yyyy")
    val d = unwrap(localdate_of(2024, 1, 31))
    print(time.format(d, custom_fmt))
    print(unwrap(parse_localdate("31/01/2024", custom_fmt)) == d)

    // ISO parse/format round trip.
    print(unwrap(parse_localdate("2024-01-31")) == d)
    print(time.format(d, iso_date_format))

    val t = unwrap(localtime_of(9, 5, 3, 0))
    print(unwrap(parse_time("09:05:03")) == t)
    val t2 = unwrap(localtime_of(9, 5, 3, 123000000))
    print(unwrap(parse_time("09:05:03.123000000")) == t2)

    val dt = localdatetime_of(d, t)
    print(time.format(dt, iso_datetime_format))
    print(unwrap(parse_datetime("2024-01-31T09:05:03")) == dt)

    // Instant round trip via UTC.
    val i = instant_of(0, 0)
    print(unwrap(parse_instant("1970-01-01T00:00:00Z")) == i)

    // Instant with a real (non-UTC) offset -- formatted, then parsed
    // back to the same absolute instant.
    val plus5 = unwrap(zoneoffset_of_hours_minutes(5, 0))
    val formatted = time.format(i, plus5, iso_datetime_format)
    print(formatted)
    print(unwrap(parse_instant(formatted, iso_datetime_format)) == i)

    // Duration round trip, including the negative-with-fraction
    // magnitude transform (the fiddliest inverse in this module).
    val neg = duration_of_seconds(0, -500000000)
    print(time.format(neg))
    print(unwrap(parse_duration(time.format(neg))) == neg)
    val pos = duration_of_seconds(90061, 500000000)
    print(unwrap(parse_duration(time.format(pos))) == pos)

    // ZoneOffset/ZoneId round trip.
    print(unwrap(parse_offset("Z")) == zoneoffset_utc())
    print(unwrap(parse_offset(time.format(plus5))) == plus5)
    print(is_ok(parse_zone("UTC")))
    print(is_ok(parse_zone("Not/AZone")))
}
