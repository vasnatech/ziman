// The operations that take a second collection from either world: push_all, set_all, and the four
// set operations. Only the *second* argument takes either world -- the first is always the handle
// being changed.
//
// The second half is the half worth having a fixture for. Self-aliasing gets three different
// answers across the three types, and each is a decision rather than an accident:
//
//   push_all(d, d)      doubles the array -- a reasonable thing to mean, so the source length is
//                       read once before the first append, or the loop would chase a source
//                       growing under it
//   set_all(m, m)       a no-op by definition, every key already mapping to its own value -- and
//                       the early return is not an optimisation, because without it this would be
//                       iterating a table it is writing
//   difference(s, s)    empties the set, which is the one that is NOT a no-op, and walking the
//                       trie while removing from it is exactly what must not happen
//
// union and intersect with yourself are genuine no-ops, and is_subset is trivially true.
fn main() {
    val xs = mutable_array_new<int>()
    concat(xs, [1, 2])
    concat(xs, mutable([3]))
    print(snapshot(xs))

    val m = mutable_map_new<string, int>()
    mutable_map_set_all(m, Map<string, int> { "a": 1 })
    mutable_map_set_all(m, mutable(Map<string, int> { "b": 2, "a": 9 }))
    print(keys(m))
    print(values(m))

    val s = to_mutable_set([1, 2, 3])
    union(s, Set<int> { 4 })
    print(items(s))
    intersect(s, Set<int> { 2, 3, 4, 9 })
    print(items(s))
    difference(s, to_mutable_set([3]))
    print(items(s))
    print(is_subset(s, Set<int> { 2, 4, 7 }))
    print(is_subset(s, Set<int> { 2 }))

    // the three different self-aliasing answers
    val d = mutable([1, 2])
    concat(d, d)
    print(snapshot(d))

    val sm = mutable(Map<string, int> { "k": 1 })
    mutable_map_set_all(sm, sm)
    print(values(sm))

    val ss = to_mutable_set([1, 2])
    union(ss, ss)
    print(items(ss))
    intersect(ss, ss)
    print(items(ss))
    difference(ss, ss)
    print(len(ss))
    print(is_subset(ss, ss))
}
