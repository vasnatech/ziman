        Err(__derive_err_5) { return err(concat("ratio: ", __derive_err_5)) }
    }
    val field_ok_raw = try json.require(j, "ok")
    if !Json.is_JBool(field_ok_raw) { return err("ok: expected a boolean") }
    val field_ok = Json.unwrap_JBool(field_ok_raw)
    val field_label_raw = try json.require(j, "label")
    if !Json.is_JString(field_label_raw) { return err("label: expected a string") }
    val field_label = Json.unwrap_JString(field_label_raw)
    val field_at_raw = try json.require(j, "at")
    val field_at = switch to_instant(field_at_raw) {
        Ok(__derive_ok_6) { __derive_ok_6 }
        Err(__derive_err_7) { return err(concat("at: ", __derive_err_7)) }
    }
    val field_tags_raw = try json.require(j, "tags")
    if !Json.is_JArray(field_tags_raw) { return err("tags: expected an array") }
    val __derive_ab_8 = mutable_array_new<string>()
    for __derive_item_9 in Json.unwrap_JArray(field_tags_raw) {
    if !Json.is_JString(__derive_item_9) { return err("expected a string") }
    val __derive_item_val_10 = Json.unwrap_JString(__derive_item_9)
    push<string>(__derive_ab_8, __derive_item_val_10)
    }
    val field_tags = snapshot(__derive_ab_8)
    val field_scores_raw = try json.require(j, "scores")
    if !Json.is_JObject(field_scores_raw) { return err("scores: expected an object") }
    val __derive_builder_15 = mutable_map_new<string, int>()
    for __derive_key_11, __derive_raw_12 in Json.unwrap_JObject(field_scores_raw) {
    val __derive_entry_13 = try int_from_json(__derive_raw_12)
    set<string, int>(__derive_builder_15, __derive_key_11, __derive_entry_13)
    }
    val field_scores = snapshot(__derive_builder_15)
    val field_middle_name_found = json.get(j, "middleName")
    var field_middle_name = Option<string>.None
    if Option.is_Some(field_middle_name_found) {
    val field_middle_name_raw = Option.unwrap_Some(field_middle_name_found)
    if !Json.is_JNull(field_middle_name_raw) {
    if !Json.is_JString(field_middle_name_raw) { return err("middleName: expected a string") }
    val field_middle_name_inner = Json.unwrap_JString(field_middle_name_raw)
    field_middle_name = Option<string>.Some(field_middle_name_inner)
    }
    }
    val field_seen_found = json.get(j, "seen")
    var field_seen = Option<time.Instant>.None
    if Option.is_Some(field_seen_found) {
    val field_seen_raw = Option.unwrap_Some(field_seen_found)
    if !Json.is_JNull(field_seen_raw) {
    val field_seen_inner = switch to_instant(field_seen_raw) {
