use http
use model
use paging.Listing
use paging.listing_encoder
use rest
use server
use wiring.Ctx
use wiring.Principal
use wiring.api
use wiring.authenticated

#[route(method: GET, path: "/api/orders", produces: "csv")]
pub fn handle_list(ctx: Ctx, who: Principal) -> Result<Listing<model.OrderResponse>, string> {
    return err("x")
}

