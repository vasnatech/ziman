#![derive(Repository(Note))]

use datasource
use db.DbError
use eql
use memdb

#[derive(Row, Entity("notes"))]
pub struct Note {
    #[pk]
    id: int
    owner: int
    body: string
}

#[derive(Repository)]
pub fn count_by_owner_order_by_id(conn: datasource.Connection, owner: int) -> Result<int, DbError>

