-- bare language, BCP 47 dash, POSIX name, explicit codeset --
  tr -> tr_TR.UTF-8
  tr-TR -> tr_TR.UTF-8
  tr_TR -> tr_TR.UTF-8
  tr_TR.UTF-8 -> tr_TR.UTF-8
  TR -> tr_TR.UTF-8
  en -> en_US.UTF-8
  en_US -> en_US.UTF-8
  de -> de_DE.UTF-8
  ja -> ja_JP.UTF-8
  sv -> sv_SE.UTF-8
  C -> C.UTF-8
-- unavailable names resolve to root, visibly --
  [xx] -> C.UTF-8 (is root: true)
  [xx_XX] -> C.UTF-8 (is root: true)
  [klingon] -> C.UTF-8 (is root: true)
  [] -> C.UTF-8 (is root: true)
  [   ] -> C.UTF-8 (is root: true)
-- root, and the default until something sets it --
  root            C.UTF-8
  default (unset) C.UTF-8
-- the process default is settable and readable --
  after set_default(tr)  tr_TR.UTF-8
  after set_default(root) C.UTF-8
-- resolving a name does not depend on the current default --
  IT under a tr default  it_IT.UTF-8
  IT under root          it_IT.UTF-8
-- a Locale survives collection pressure, being reached through an int --
  still de_DE.UTF-8
