// `lib/ui/widget` meeting `lib/graphics`: a window laid out, painted, and rasterised to pixels.
//
// **`tests/stdlib/widget_test.zm` is the layout gate and this is the integration one.** That file
// checks boxes against numbers with a fake metrics and no font, which is where the arithmetic lives;
// this one checks that the `Scene` the UI layer produces is a scene the renderer actually draws, in
// the places the layout said. The two failures it is here to catch are a paint order that hides a
// widget behind its own background and a layout that agrees with itself but disagrees with the
// pixels -- neither of which a unit test over rectangles can see.
//
// Uses `vendor/fonts/Caladea-Regular.ttf`, as `graphics_text.zm` does and for the same reason: a
// fixture cannot rely on a system face.
use font
use fs
use geom
use image
use paint
use raster
use scene
use widget

val font_path = "vendor/fonts/Caladea-Regular.ttf"

fn triple(img: image.Image, x: int, y: int) -> string {
    val c = unwrap(image.pixel_at(img, x, y))
    return concat(format("{:.1}", c.red), ",", format("{:.1}", c.green), ",", format("{:.1}", c.blue))
}

// A window shaped like an application: a toolbar of its own height, then a row of a fixed sidebar
// and a content area taking the rest. Each region has a distinct background, so a pixel's colour
// says which region it landed in -- which is the only way to check a layout against a render.
fn window(w: float, h: float) -> widget.Widget {
    val toolbar = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 4.0,
        padding: widget.insets_all(2.0),
        surface: widget.filled(paint.rgb(1.0, 0.0, 0.0)),
        align: widget.stretched(),
        children: [widget.label_of("File", 8.0, paint.black()), widget.flex()],
        name: "toolbar"
    })
    val sidebar = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.filled(paint.rgb(0.0, 1.0, 0.0)),
        align: widget.stretched(),
        children: [widget.flex()],
        name: "sidebar"
    })
    val content = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.filled(paint.rgb(0.0, 0.0, 1.0)),
        align: widget.stretched(),
        children: [widget.flex()],
        name: "content"
    })
    val body = widget.row_of(0.0, [widget.fixed_of(40.0, h, sidebar), widget.expand(content)])
    val _ = w
    return widget.column_of(0.0, [widget.fixed_of(w, 20.0, toolbar), widget.expand(body)])
}

fn demo() -> Result<unit, string> {
    val data = switch fs.read_bytes(font_path) {
        Ok(d) { d }
        Err(e) { return err(concat("cannot read ", font_path, ": ", fs.fs_error_message(e))) }
    }
    val face = try font.load(data)
    val metrics = try widget.metrics_for(face)

    val laid = widget.layout(window(120.0, 80.0), geom.rect_of(0.0, 0.0, 120.0, 80.0), metrics)

    // The layout first, as the UI layer sees it: the toolbar keeps its 20, the body takes the rest,
    // the sidebar its 40, and the content everything left across.
    print(concat("toolbar: ", rect_text(laid.children[0].bounds)))
    print(concat("body:    ", rect_text(laid.children[1].bounds)))
    val body = laid.children[1].children[0]
    print(concat("sidebar: ", rect_text(body.children[0].bounds)))
    print(concat("content: ", rect_text(body.children[1].bounds)))
    print(concat("names:   ", concat(
        laid.children[0].children[0].name,
        " ",
        body.children[0].children[0].name,
        " ",
        body.children[1].children[0].name
    )))

    // Then the pixels, which is the check the layout numbers cannot make. A region's colour says
    // which region a pixel landed in.
    val img = try raster.render(
        widget.paint(laid, metrics),
        with raster.options() { fonts: [face], samples: 4 }
    )
    print(concat("in the toolbar:  ", triple(img, 60, 10)))
    print(concat("in the sidebar:  ", triple(img, 10, 50)))
    print(concat("in the content:  ", triple(img, 90, 50)))
    // The toolbar's label is dark text on red, so some pixel in its first few columns must be
    // darker than the background it sits on. Asserted as a comparison rather than a value, because
    // which pixel a glyph's stem lands on is the font's business.
    var darkest = 1.0
    var x = 2
    while x < 24 {
        var y = 2
        while y < 18 {
            val r = unwrap(image.pixel_at(img, x, y)).red
            if r < darkest {
                darkest = r
            }
            y = y + 1
        }
        x = x + 1
    }
    print(concat("label darkens red:  ", str(darkest < 0.5)))

    // ---- two faces, through the whole chain
    //
    // **The claim multi-font support makes is that a `Label` naming face 1 is *rendered* in face
    // 1**, and neither layer can show that alone: `widget_test.zm` proves the op carries the index
    // and `graphics_text.zm` proves the renderer honours one, while this is the only place the two
    // meet. Caladea Bold is vendored beside the Regular for exactly this kind of case -- see the
    // glyph-cache note in `graphics_text.zm`, where the same pair caught a cache key that did not
    // name the face.
    //
    // Measured as **ink**, the sum of alpha over the glyphs: the same word in bold lays down more
    // of it. A tree that drew everything in face 0 -- which is what this layer did until the index
    // stopped being a literal -- would print two identical numbers.
    val bold_data = switch fs.read_bytes("vendor/fonts/Caladea-Bold.ttf") {
        Ok(d) { d }
        Err(e) { return err(concat("cannot read the bold face: ", fs.fs_error_message(e))) }
    }
    val bold = try font.load(bold_data)
    val both = try widget.metrics_for_faces([face, bold])
    val word = "Hamburgefonstiv"
    var inks = [0.0, 0.0]
    for which in [0, 1] {
        val tree = widget.label_in_face(word, 16.0, paint.black(), which)
        val box = geom.rect_of(0.0, 0.0, 200.0, 30.0)
        val scene_of_it = widget.paint(widget.layout(tree, box, both), both)
        val pixels = try raster.render(scene_of_it, with raster.options() {
            fonts: [face, bold],
            samples: 4,
            background: Option<paint.Color>.Some(paint.white())
        })
        var total = 0.0
        var py = 0
        while py < pixels.height {
            var px = 0
            while px < pixels.width {
                // Ink is how far from white the pixel is, since the background is white.
                total = total + (1.0 - unwrap(image.pixel_at(pixels, px, py)).red)
                px = px + 1
            }
            py = py + 1
        }
        inks = if which == 0 { [total, inks[1]] } else { [inks[0], total] }
    }
    printf(
        "bold lays down more ink than regular: {} ({:.0} vs {:.0})\n",
        str(inks[1] > inks[0]),
        inks[0],
        inks[1]
    )
    // And the faces are otherwise the same font, so this cannot pass by one being wider: the
    // measured widths differ by under a tenth, while the ink differs by far more.
    val regular_width = widget.width_in(both, 0, word, 16.0)
    val bold_width = widget.width_in(both, 1, word, 16.0)
    printf(
        "widths are close ({:.1} vs {:.1}), ink is not: {}\n",
        regular_width,
        bold_width,
        str((inks[1] - inks[0]) / inks[0] > (bold_width - regular_width) / regular_width)
    )
    // ---- a picture, through the whole chain
    //
    // **The one thing only pixels can answer about an image: that the handle lines up.** Everything
    // between `widget.picture_of(1, ...)` and `raster.Options.images[1]` is an integer passed
    // along, and a layer that renumbered would draw the wrong picture rather than fail. So two
    // images are registered and the *second* is asked for -- with one, an index dropped to zero
    // would pass.
    val red = try image.canvas(2, 2, image.Pixels.Rgba8)
    val _ = try image.set(red, 0, 0, paint.rgb(1.0, 0.0, 0.0))
    val _ = try image.set(red, 1, 0, paint.rgb(1.0, 0.0, 0.0))
    val _ = try image.set(red, 0, 1, paint.rgb(1.0, 0.0, 0.0))
    val _ = try image.set(red, 1, 1, paint.rgb(1.0, 0.0, 0.0))
    val green = try image.canvas(2, 2, image.Pixels.Rgba8)
    val _ = try image.set(green, 0, 0, paint.rgb(0.0, 1.0, 0.0))
    val _ = try image.set(green, 1, 0, paint.rgb(0.0, 1.0, 0.0))
    val _ = try image.set(green, 0, 1, paint.rgb(0.0, 1.0, 0.0))
    val _ = try image.set(green, 1, 1, paint.rgb(0.0, 1.0, 0.0))

    // A 40x20 picture fitted into a 40x40 box: aspect kept, so it lands 10 points down and 20 tall.
    val framed = widget.layout(
        widget.picture_fitted(1, 40.0, 20.0, "a green square"),
        geom.rect_of(0.0, 0.0, 40.0, 40.0),
        metrics
    )
    val shown = try raster.render(
        widget.paint(framed, metrics),
        with raster.options() {
            images: [image.snapshot_image(red), image.snapshot_image(green)],
            fonts: [face],
            samples: 1
        }
    )
    print(concat("the picture is the second image: ", triple(shown, 20, 20)))
    val above = try image.pixel_at(shown, 20, 2)
    print(concat("above the picture is clear:      ", str(above.alpha < 0.01)))
    print(concat("where it landed: ", rect_text(widget.picture_box(
        widget.Pictured {
            image: 1,
            width: 40.0,
            height: 20.0,
            fit: widget.Fit.Contain,
            alt: "",
            name: ""
        },
        geom.rect_of(0.0, 0.0, 40.0, 40.0)
    ))))
    return ok(unit)
}

fn rect_text(r: geom.Rect) -> string {
    return prelude.format("{},{} {}x{}", str(r.x), str(r.y), str(r.width), str(r.height))
}

fn main() {
    switch demo() {
        Ok(_) { print("ok") }
        Err(why) { print(concat("FAILED: ", why)) }
    }
}
