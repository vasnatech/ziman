use uuid
use uuid.Uuid
use uuid.uuid_new

fn main() {
    val u = uuid_new()
    val s = uuid.format(u)
    print(unwrap(uuid.parse(s)) == u)

    // uuid.format's own output is lowercase, but parsing accepts
    // uppercase too.
    print(unwrap(uuid.parse(to_upper(s))) == u)

    print(is_ok(uuid.parse("too-short")))
    print(unwrap_err(uuid.parse("too-short")))

    print(is_ok(uuid.parse("gggggggg-gggg-gggg-gggg-gggggggggggg")))
    print(unwrap_err(uuid.parse("gggggggg-gggg-gggg-gggg-gggggggggggg")))

    // Right length, wrong dash positions.
    print(is_ok(uuid.parse("aaaaaaaaXbbbbXccccXddddXeeeeeeeeeeee")))
}
