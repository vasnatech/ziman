use time
use uuid

fn main() {
    val d1 = unwrap(time.parse_localdate("2024-03-05"))
    val d2 = unwrap(time.parse_localdate("2023-12-31"))
    val d3 = unwrap(time.parse_localdate("2024-01-01"))
    for d in sort([d1, d2, d3]) {
        print(time.format(d))
    }
    val a = unwrap(uuid.parse("00000000-0000-4000-8000-000000000002"))
    val b = unwrap(uuid.parse("00000000-0000-4000-8000-000000000001"))
    for u in sort([a, b]) {
        print(uuid.format(u))
    }
}
