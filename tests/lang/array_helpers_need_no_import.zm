// The bare array helpers, used with no `use` line at all -- which is the point of them:
// `Map` and `Set` have had bare `map_*`/`set_*` helpers all along, and arrays were the one
// collection whose helpers needed an import. `array_map`/`filter`/`flat_map`/`reverse`/
// `sort`/`sort_desc`/`sort_with` are wrappers over these and still work; these are canonical.

struct P {
    key: int
    tag: string
}

// Only `key` is compared, so two entries with the same key are genuine ties and a stable sort
// has to keep them in input order -- in both directions, which is not the same as reversing.
fn p_compare(a: P, b: P) -> int {
    return compare(a.key, b.key)
}

fn tags(ps: [P]) -> string {
    val out = mutable_string_new()
    for p in ps {
        mutable_string_append(out, str(p.key), p.tag, " ")
    }
    return trim(snapshot(out))
}

fn main() {
    val ns = [5, 2, 9, 1, 5]
    print(map<int, int>(ns, fn(n) { n * 2 }))
    print(filter(ns, fn(n) { n > 2 }))
    print(flat_map<int, int>([1, 2, 3], fn(n) { [n, n] }))
    print(reverse(ns))

    print(sort(ns))
    print(sort_desc(ns))
    print(sort(["pear", "fig", "apple"]))
    print(sort_with(ns, fn(a: int, b: int) -> int { return compare(b, a) }))

    val empty: [int] = []
    print(sort(empty))

    // The non-scalar path, through `compare` rather than the packed natives.
    val ps = [P { key: 2, tag: "a" }, P { key: 1, tag: "b" }, P { key: 2, tag: "c" }, P { key: 1, tag: "d" }]
    print(tags(ps))
    print(tags(sort(ps)))
    print(tags(sort_desc(ps)))
    print(tags(sort_with(ps, fn(a: P, b: P) -> int { return compare(a.key, b.key) })))

    // filter_present: the Nones dropped, the order kept. Variadic, because the call site is
    // nearly always a written-out list of maybes.
    print(filter_present<int>(Option<int>.Some(1), Option<int>.None, Option<int>.Some(3)))
    print(filter_present<string>(Option<string>.None, Option<string>.None))
    print(len(filter_present<int>()))
    // an array already in hand goes in under the parameter name, which a native takes and a
    // builtin does not -- `concat` lost this spelling when it became one
    val held = [Option<string>.Some("a"), Option<string>.None, Option<string>.Some("b")]
    print(filter_present<string>(items: held))
}
