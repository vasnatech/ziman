struct Point {
    x: int
    y: int
}
struct Line {
    start: Point
    end: Point
}
fn main() {
    val l1 = Line { start: Point { x: 0, y: 0 }, end: Point { x: 1, y: 1 } }
    val l2 = Line { start: Point { x: 0, y: 0 }, end: Point { x: 1, y: 1 } }
    val l3 = Line { start: Point { x: 0, y: 0 }, end: Point { x: 9, y: 9 } }
    print(l1 == l2)
    print(l1 == l3)
}
