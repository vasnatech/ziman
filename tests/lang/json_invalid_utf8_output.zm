// JSON is defined over Unicode text, so a document containing a byte that is not valid UTF-8 is not
// JSON. Before this was fixed the encoder copied such bytes through, producing a document Python's
// `json` refused to decode while this module's own `parse_json` accepted it: every test written in
// Ziman passed and the client failed. The encoder substitutes U+FFFD, so what leaves is always
// valid UTF-8.
//
// **The way in is `append_byte`.** `substring`, `char_at` and `index_of` counted bytes until
// 2026-10-23 and splitting a multi-byte character was a documented possibility; they count
// characters now and cannot split one at all. What remains is the raw-byte door, which exists on
// purpose -- `append_byte` is how text is assembled from a decoder -- and `snapshot` does not
// re-validate what it copies. That is the one route, so it is the one this tests.
use json

#[derive(Json)]
struct Note {
    text: string
}

// A string holding exactly these bytes, whether or not they are valid UTF-8.
fn raw(bytes: [byte]) -> string {
    val b = mutable_string_new()
    append_byte(b, bytes)
    return snapshot(b)
}

fn main() {
    // valid text of every width passes through untouched
    print(json.json_to_string(json.Json.JString("café 日本語")))

    // control characters are still escaped, not replaced
    print(json.json_to_string(json.Json.JString("a\tb\nc")))

    // a three-byte character (日 is E6 97 A5) truncated at each point, then whole
    print(json.json_to_string(json.Json.JString(raw([230b]))))
    print(json.json_to_string(json.Json.JString(raw([230b, 151b]))))
    print(json.json_to_string(json.Json.JString(raw([230b, 151b, 165b]))))

    // a four-byte character (😀 is F0 9F 98 80), truncated then whole
    print(json.json_to_string(json.Json.JString(raw([240b, 159b]))))
    print(json.json_to_string(json.Json.JString(raw([240b, 159b, 152b, 128b]))))

    // and through a derived encoder, which is how it reaches a real client
    print(json.json_to_string(note_to_json(Note { text: raw([99b, 97b, 102b, 195b]) })))

    // bytes_to_string, by contrast, refuses invalid input outright rather than substituting
    switch bytes_to_string([99b, 195b]) {
        Ok(v) { printf("unexpectedly accepted: {}\n", v) }
        Err(e) { printf("bytes_to_string: {}\n", e) }
    }
}
