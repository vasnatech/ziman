
struct P {
    name: string
    age: int
}

fn main() {
    print(sort_desc([3, 1, 2, 3]))
    print(sort_desc(["b", "c", "a"]))
    val empty: [int] = []
    print(sort_desc(empty))
    // descending is stable: equal keys keep their input order (a before c)
    val people = [P { name: "a", age: 30 }, P { name: "b", age: 71 }, P { name: "c", age: 30 }, P { name: "d", age: 5 }]
    for p in sort_by_desc<P, int>(people, fn(p: P) -> int { return p.age }) {
        print(concat(p.name, str(p.age)))
    }
    // the *permutation* is stable the same way, which is what sort_by_desc is built on.
    // `array_order_of` is the one primitive since F169 deleted the two sort_indices wrappers.
    print(array_order_of<int>([5, 9, 5, 1], true))
}
