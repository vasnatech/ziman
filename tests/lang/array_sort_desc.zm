
struct P {
    name: string
    age: int
}

fn main() {
    print(sort_desc([3, 1, 2, 3]))
    print(sort_desc(["b", "c", "a"]))
    val empty: [int] = []
    print(sort_desc(empty))
    // descending is stable: equal keys keep their input order (a before c)
    val people = [P { name: "a", age: 30 }, P { name: "b", age: 71 }, P { name: "c", age: 30 }, P { name: "d", age: 5 }]
    for p in sort_by_desc<P, int>(people, fn(p: P) -> int { return p.age }) {
        print(concat(p.name, str(p.age)))
    }
    // The *permutation* under it is stable the same way, which is what `sort_by_desc` is built
    // on, and this called `array_order_of` directly to show it. That declaration is the prelude's
    // one non-`pub` name and stopped being reachable from program code on 2026-10-22; the
    // `sort_by_desc` loop above has equal ages in it, so the stability it was pinning is pinned
    // there -- by the consumer, which is the only caller that exists outside the prelude anyway.
}
