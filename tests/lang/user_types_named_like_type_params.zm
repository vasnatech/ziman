struct T {
    x: int
}

struct K {
    n: string
}

enum V {
    Small
    Big
}

fn main() {
    val items = mutable_array_new<T>()
    push<T>(items, T { x: 1 })
    push<T>(items, T { x: 2 })
    val all = snapshot(items)
    print(len(all))
    val m = mutable_map_new<string, K>()
    set<string, K>(m, "a", K { n: "k" })
    print(len(snapshot(m)))
    val o = Option<V>.Some(V.Big)
    print(is_Some(o))
    val arr = push<T>(all, T { x: 3 })
    print(arr[2].x)
}
