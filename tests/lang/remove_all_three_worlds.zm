// F197/F198, item 6 and the last of Group A: `remove_all` over a Map, a MutableMap and a
// MutableSet, all three taking `variadic`.
//
// The Map half took `keys: [K]` when the row was first paired, which left one name with two call
// shapes. F198 made it variadic too, which costs the builtin branch a few lines -- a builtin gets
// the raw `args` where a native variadic tail would have been handed one array -- and buys the
// same four spellings in every world: an array, several values, one value, or none.
//
// The returns still differ, for the usual reason: the immutable half answers a new Map, the
// builders answer whether anything was actually removed, as `remove` always has.
fn main() {
    val m = Map<string, int> { "a": 1, "b": 2, "c": 3 }
    print(remove_all(m, ["a", "b"]))
    print(remove_all(m, "a", "b"))
    print(remove_all(m, "a"))
    print(remove_all<string, int>(m))
    print(len(m))

    val mm = mutable(m)
    print(remove_all(mm, "a", "b"))
    print(snapshot(mm))
    print(remove_all(mm, "zz"))

    val ms = mutable(Set<int> { 1, 2, 3 })
    print(remove_all(ms, [1, 2]))
    print(snapshot(ms))
    print(remove_all(ms, 9))
}
