// The operators a term may carry -- `in`, `between`, `not`, `ignore_case`, `is_null`,
// `is_not_null` -- and an entity whose columns are `Uuid` and `Option<string>`.
//
// An `Option` column's parameter is its *inner* type: `find_by_note(conn, note: string)` reads the
// rows whose nullable note is that text, and `_is_null` is how the other side is asked for. A
// parameter of `Option<string>` would bind NULL for None, and `note = NULL` matches no row.
#![derive(Repository(Reading))]

use datasource
use db.DbError
use memdb
use uuid

#[derive(Row, Entity("readings"))]
pub struct Reading {
    #[pk]
    id: uuid.Uuid
    patient_id: uuid.Uuid
    kind: string
    value: int
    note: Option<string>
}

#[derive(Repository)]
pub fn find_by_kind_in(conn: datasource.Connection, kind: [string]) -> Result<[Reading], DbError>

#[derive(Repository)]
pub fn find_by_value_between(conn: datasource.Connection, value_from: int, value_to: int) -> Result<[Reading], DbError>

#[derive(Repository)]
pub fn find_by_kind_ignore_case(conn: datasource.Connection, kind: string) -> Result<[Reading], DbError>

#[derive(Repository)]
pub fn find_by_patient_id_and_kind_not(
    conn: datasource.Connection,
    patient_id: uuid.Uuid,
    kind: string
) -> Result<[Reading], DbError>

#[derive(Repository)]
pub fn count_by_note_is_null(conn: datasource.Connection) -> Result<int, DbError>

#[derive(Repository)]
pub fn find_by_note_is_not_null_order_by_value_desc(conn: datasource.Connection) -> Result<[Reading], DbError>

#[derive(Repository)]
pub fn find_by_note(conn: datasource.Connection, note: string) -> Result<[Reading], DbError>

fn main() {
    val drivers = datasource.registry([memdb.driver()])
    val conn = unwrap(datasource.open(drivers, "memdb:"))
    unwrap(datasource.execute(
        conn,
        "CREATE TABLE readings (id TEXT PRIMARY KEY, patient_id TEXT NOT NULL, kind TEXT NOT NULL, value INTEGER NOT NULL, note TEXT)"
    ))
    val p1 = unwrap(uuid.parse("11111111-1111-1111-1111-111111111111"))
    val p2 = unwrap(uuid.parse("22222222-2222-2222-2222-222222222222"))
    val none: Option<string> = Option<string>.None
    unwrap(insert(
        conn,
        Reading {
            id: unwrap(uuid.parse("aaaaaaaa-0000-0000-0000-000000000001")),
            patient_id: p1,
            kind: "HEART_RATE",
            value: 70,
            note: none
        }
    ))
    unwrap(insert(
        conn,
        Reading {
            id: unwrap(uuid.parse("aaaaaaaa-0000-0000-0000-000000000002")),
            patient_id: p1,
            kind: "WEIGHT",
            value: 80,
            note: Option<string>.Some("after lunch")
        }
    ))
    unwrap(insert(
        conn,
        Reading {
            id: unwrap(uuid.parse("aaaaaaaa-0000-0000-0000-000000000003")),
            patient_id: p2,
            kind: "heart_rate",
            value: 90,
            note: none
        }
    ))

    print(prelude.len(unwrap(find_by_kind_in(conn, ["WEIGHT", "heart_rate"]))))
    print(prelude.len(unwrap(find_by_value_between(conn, 75, 95))))
    print(prelude.len(unwrap(find_by_kind_ignore_case(conn, "heart_rate"))))
    print(prelude.len(unwrap(find_by_patient_id_and_kind_not(conn, p1, "WEIGHT"))))
    print(unwrap(count_by_note_is_null(conn)))
    for r in unwrap(find_by_note_is_not_null_order_by_value_desc(conn)) {
        print(r.value)
    }
    print(prelude.len(unwrap(find_by_note(conn, "after lunch"))))
}
