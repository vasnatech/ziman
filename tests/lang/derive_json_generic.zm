use json.Json
use json.json_to_string

#[derive(Json)]
pub struct Point {
    x: int
    y: int
}

#[derive(Json)]
pub struct Page<T> {
    items: [T]
    total: int
}

#[derive(Json)]
pub struct Tagged<K, V> {
    key: K
    value: V
    note: Option<V>
}

#[derive(Json)]
pub enum Either<L, R> {
    Left(L)
    Right(R)
    Neither
}

#[derive(Json)]
pub struct Wrapper<T> {
    inner: Page<T>
    pts: Page<Point>
}

fn main() {
    val page = Page<int> { items: [1, 2, 3], total: 3 }
    val j = page_to_json<int>(page, int_to_json)
    print(json_to_string(j))
    val back = unwrap(page_from_json<int>(j, int_from_json))
    print(len(back.items))
    print(back.total)

    val pts = Page<Point> { items: [Point { x: 1, y: 2 }], total: 1 }
    print(json_to_string(page_to_json<Point>(pts, point_to_json)))

    val t = Tagged<string, float> { key: "k", value: 1.5, note: Option<float>.Some(2.5) }
    val tj = tagged_to_json<string, float>(t, string_to_json, float_to_json)
    print(json_to_string(tj))
    val tb = unwrap(tagged_from_json<string, float>(tj, string_from_json, float_from_json))
    print(tb.key)
    print(Option.is_Some(tb.note))

    val e = Either<int, string>.Right("x")
    val ej = either_to_json<int, string>(e, int_to_json, string_to_json)
    print(json_to_string(ej))
    print(Either.is_Right(unwrap(either_from_json<int, string>(ej, int_from_json, string_from_json))))
    val nj = either_to_json<int, string>(Either<int, string>.Neither, int_to_json, string_to_json)
    print(Either.is_Neither(unwrap(either_from_json<int, string>(nj, int_from_json, string_from_json))))

    val w = Wrapper<bool> { inner: Page<bool> { items: [true], total: 1 }, pts: pts }
    val wj = wrapper_to_json<bool>(w, bool_to_json)
    print(json_to_string(wj))
    val wb = unwrap(wrapper_from_json<bool>(wj, bool_from_json))
    print(wb.inner.items[0])
    print(wb.pts.items[0].y)

    val bad = page_from_json<int>(Json.JString("nope"), int_from_json)
    print(is_ok(bad))
}
