#![derive(Repository(Note))]

use datasource
use db.DbError
use eql
use memdb

#[derive(Row, Entity("notes"))]
pub struct Note {
    #[pk]
    id: int
    owner: int
    body: string
}

// Parameters bind by name. Two transposed `int`s compile in Spring Data and answer the wrong rows
// forever; here they are this error.
#[derive(Repository)]
pub fn find_by_id_and_owner(conn: datasource.Connection, owner: int, id: int) -> Result<[Note], DbError>

fn main() {
    print(1)
}
