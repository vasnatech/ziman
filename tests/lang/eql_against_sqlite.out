-- SELECT v.reason, count(*) AS n, sum(v.cost) AS total FROM Visit v GROUP BY v.reason ORDER BY v.reason
   SELECT v.reason, count(*) AS n, sum(v.cost) AS total FROM visits AS v GROUP BY v.reason ORDER BY v.reason
   agree    2 row(s) | reason=Text(checkup) n=Int(3) total=Float(225.75) | reason=Text(follow up) n=Int(1) total=Float(80.0)
-- SELECT v.reason FROM Visit v GROUP BY v.reason HAVING sum(v.cost) > :floor ORDER BY v.reason
   SELECT v.reason FROM visits AS v GROUP BY v.reason HAVING sum(v.cost) > $1 ORDER BY v.reason
   agree    1 row(s) | reason=Text(checkup)
-- SELECT v FROM Visit v JOIN Patient p ON p.id = v.patient_id WHERE p.last_name = :name ORDER BY v.id
   SELECT v.id AS id, v.patient_id AS patient_id, v.reason AS reason, v.cost AS cost FROM visits AS v INNER JOIN patients AS p ON p.id = v.patient_id WHERE p.last_name = $1 ORDER BY v.id
   agree    3 row(s) | id=Int(1) patient_id=Int(1) reason=Text(checkup) cost=Float(120.5) | id=Int(2) patient_id=Int(1) reason=Text(follow up) cost=Float(80.0) | id=Int(4) patient_id=Int(3) reason=Text(checkup) cost=Float(10.0)
