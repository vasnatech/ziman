-- SELECT p FROM Patient p ORDER BY p.id
   SELECT p.id AS id, p.last_name AS last_name, p.gender AS gender FROM patients AS p ORDER BY p.id
   agree    4 row(s) | id=Int(1) last_name=Text(Ada) gender=Text(f) | id=Int(2) last_name=Text(Bob) gender=Null | id=Int(3) last_name=Text(Ada) gender=Text(m) | id=Int(4) last_name=Text(Cy) gender=Text(m)
-- SELECT p FROM Patient p WHERE p.last_name = :name ORDER BY p.id
   SELECT p.id AS id, p.last_name AS last_name, p.gender AS gender FROM patients AS p WHERE p.last_name = $1 ORDER BY p.id
   agree    2 row(s) | id=Int(1) last_name=Text(Ada) gender=Text(f) | id=Int(3) last_name=Text(Ada) gender=Text(m)
-- SELECT p.id, p.last_name FROM Patient p WHERE p.gender IS NULL ORDER BY p.id
   SELECT p.id, p.last_name FROM patients AS p WHERE p.gender IS NULL ORDER BY p.id
   agree    1 row(s) | id=Int(2) last_name=Text(Bob)
