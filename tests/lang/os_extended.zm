use os

fn main() {
    print(os.args())
    print(byte_len(unwrap(os.cwd())) > 0)
    print(os.pid() > 0)
    print(os.set_env("ZIMAN_TEST_VAR", "hello"))
    print(os.get_env("ZIMAN_TEST_VAR"))
    print(os.set_env("BAD=NAME", "x"))
    print(os.set_env("", "x"))
    print(os.get_env("ZIMAN_TEST_UNSET_VAR"))
}
