use db
use http

fn main() {
    val sb = mutable_string_new()
    print(append_byte(sb, 104b))
    print(append_byte(sb, 0b))
    print(append_byte(sb, 105b))
    print(snapshot(sb))
    print(byte_len(sb))

    // a multi-byte UTF-8 character assembled from two raw bytes
    val u = mutable_string_new()
    append_byte(u, 195b)
    append_byte(u, 169b)
    print(snapshot(u))

    // several at once; a 0b anywhere appends nothing
    val m = mutable_string_new()
    print(append_byte(m, 104b, 105b))
    print(append_byte(m, 33b, 0b, 33b))
    print(append_byte(s: m, pieces: [111b, 107b]))
    print(snapshot(m))

    print(unwrap(http.percent_decode("caf%C3%A9 au+lait%21", true)))
    print(unwrap(http.percent_decode("x%2By+z", false)))
    print(http.percent_decode("bad%zz", false))
    print(http.percent_decode("cut%4", false))
    print(http.percent_decode("nul%00byte", false))
    print(unwrap(http.percent_decode("", true)))
    print(unwrap(db.percent_decode("p%40ss%3Aw%2Frd")))
    print(is_ok(db.percent_decode("a%00b")))
}
