use json
use json.Json
use json.parse

// `\r` is a string escape now, which also lets JSON handle CRLF.
fn main() {
    val crlf = "a\r\nb"
    print(byte_len(crlf))
    print(substring(crlf, 1, 2) == "\r")
    // CR as structural whitespace between JSON tokens
    val j = unwrap(parse("{\r\n  \"k\": \"v\"\r\n}"))
    print(json.format(j))
    // a \r escape inside a JSON string round-trips
    val s = unwrap(parse("\"x\\ry\""))
    print(byte_len(Json.unwrap_JString(s)))
    print(json.format(s))
}
