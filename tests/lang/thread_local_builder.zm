// **Runs under `--gc-stress`** (its `.args`), because that is the only way this fixture has ever
// failed. A value whose single reference was a `thread.local` slot was invisible to the per-thread
// `gc_heap` collector -- Boehm scans the slot arrays, that collector did not -- so a collection
// landing between `slot_set` storing the value and the next statement binding it swept the value
// while the slot still pointed at it. A builder is the shape that shows it: its wrapper is a
// gc_heap object whose freed memory reads back as a zero handle, and marking that dereferences
// NULL. An ordinary growth-triggered collection almost never lands in that window, so the fixture
// passed for as long as it existed and segfaulted the first time the whole suite was run under
// stress. The fix is one more root source in `mark_this_threads_roots`.
use thread

// A builder is thread-bound, but a ThreadLocal holding one may still be a module-level val: the key is
// only a number and a function, and each thread makes and keeps its own builder.
val cache = thread.local<MutableMap<string, int>>(fn() -> MutableMap<string, int> {
    return mutable_map_new<string, int>()
})

fn worker(out: Channel<int>) {
    val mine = thread.get(cache)
    set(mine, "w", 1)
    set(mine, "x", 2)
    send(out, len(mine))
}

fn main() {
    val mine = thread.get(cache)
    set(mine, "m", 1)

    val out: Channel<int> = channel_new()
    spawn worker(out)
    print(receive(out))
    print(len(thread.get(cache)))

    // What a thread keeps in its slot survives a lot of allocation (and so collections).
    var junk = 0
    for i in 0..200000 {
        junk = junk + byte_len(str(i))
    }
    set(thread.get(cache), "later", 3)
    print(len(thread.get(cache)))
    print(junk > 0)
    print(snapshot(thread.get(cache)))
}
