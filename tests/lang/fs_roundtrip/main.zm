use fs

fn main() {
    val _ = fs.write_text("/tmp/ziman_test_native_io_roundtrip.txt", "round trip ok")
    val r = fs.read_text("/tmp/ziman_test_native_io_roundtrip.txt")
    if is_ok(r) {
        print(unwrap(r))
    } else {
        print(concat("unexpected failure: ", fs.fs_error_message(unwrap_err(r))))
    }
}
