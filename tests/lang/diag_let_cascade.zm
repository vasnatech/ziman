// count below is the whole assertion: one diagnostic per wrong binding word and nothing else, which
// is what the parser's rewrite to a real `val` and the poisoning that follows it buy. The genuine
// error on the last line has to survive, or the cure would be worse than the noise.
fn main() {
    let total = 0
    let name = "ada"
    total = total + 5
    print(total)
    print(name)
    print(format("{}: {}", name, total))
    print(nope)
}
