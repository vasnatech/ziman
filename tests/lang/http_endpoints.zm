use http
use mime
use server

struct Ctx {
    prefix: string
}

struct Item {
    id: int
}

fn fault(status: int, message: string) -> http.Response {
    return server.text_response(status, format("fault {}: {}", status, message))
}

fn failure(e: string) -> http.Response {
    return server.text_response(422, format("failure: {}", e))
}

fn as_text(item: Item) -> string {
    return format("item {}", item.id)
}

fn as_csv(item: Item) -> string {
    return format("id\n{}\n", item.id)
}

fn read_item(text: string) -> Result<Item, string> {
    val n = parse_int(trim(text))
    if !is_ok(n) {
        return err("body is not a number")
    }
    return Item { id: unwrap(n) }
}

fn read_id(params: server.Params) -> Result<int, string> {
    val n = parse_int(server.param(params, "id"))
    if !is_ok(n) {
        return err("bad id")
    }
    return unwrap(n)
}

fn read_csv_item(text: string) -> Result<Item, string> {
    val lines = split(trim(text), "\n")
    if len(lines) != 2 || lines[0] != "id" {
        return err("csv body must be `id` and a number")
    }
    return read_item(lines[1])
}

fn get_item(ctx: Ctx, id: int) -> Result<Item, string> {
    if id == 0 {
        return err("no such item")
    }
    return Item { id: id }
}

fn newest_item(ctx: Ctx) -> Result<Item, string> {
    return Item { id: 99 }
}

fn create_item(ctx: Ctx, item: Item) -> Result<Item, string> {
    if item.id < 0 {
        return err("negative id")
    }
    return Item { id: item.id + 100 }
}

struct Caller {
    name: string
    admin: bool
}

// Who is calling, from `Authorization: Bearer <name>`: `ada` is a user, `root` an admin, `boom` makes the lookup itself fail.
fn any_caller(ctx: Ctx, req: http.Request) -> Result<Caller, server.Denied> {
    val header = http.header(req, "Authorization")
    if !is_Some(header) {
        return server.Denied.Unauthenticated("missing token")
    }
    val token = unwrap_Some(header)
    if token == "Bearer ada" {
        return Caller { name: "ada", admin: false }
    }
    if token == "Bearer root" {
        return Caller { name: "root", admin: true }
    }
    if token == "Bearer boom" {
        return server.Denied.Failed("token store down")
    }
    return server.Denied.Unauthenticated("bad token")
}

fn admin_only(ctx: Ctx, req: http.Request) -> Result<Caller, server.Denied> {
    val caller = try any_caller(ctx, req)
    if !caller.admin {
        return server.Denied.Forbidden("admins only")
    }
    return caller
}

fn me_as_text(c: Caller) -> string {
    return format("caller {} admin={}", c.name, c.admin)
}

fn whoami(ctx: Ctx, caller: Caller) -> Result<Caller, string> {
    return caller
}

fn get_secret(ctx: Ctx, caller: Caller, id: int) -> Result<Item, string> {
    return Item { id: id + 1000 }
}

fn replace_item(ctx: Ctx, id: int, item: Item) -> Result<Item, string> {
    return Item { id: id * 1000 + item.id }
}

fn delete_item(ctx: Ctx, caller: Caller, id: int) -> Result<bool, string> {
    if id == 0 {
        return err("no such item")
    }
    return true
}

fn post_secret(ctx: Ctx, caller: Caller, item: Item) -> Result<Item, string> {
    return Item { id: item.id + 2000 }
}

// A binary media type goes through decoder/encoder directly, over the bytes: the body reversed, NUL bytes and all.
fn reverse_bytes(data: [byte]) -> Result<[byte], string> {
    val out = mutable_array_new<byte>()
    var i = len(data) - 1
    while i >= 0 {
        push<byte>(out, data[i])
        i = i - 1
    }
    return snapshot(out)
}

fn echo_binary(ctx: Ctx, data: [byte]) -> Result<[byte], string> {
    return data
}

fn request_bytes(method: string, path: string, headers: [http.Header], body: [byte]) -> http.Request {
    return http.Request {
        method: http.method_parse(method),
        target: path,
        path: path,
        query: "",
        version: "HTTP/1.1",
        headers: headers,
        body: body,
        peer: None
    }
}

fn request(method: string, path: string, headers: [http.Header], body: string) -> http.Request {
    return http.Request {
        method: http.method_parse(method),
        target: path,
        path: path,
        query: "",
        version: "HTTP/1.1",
        headers: headers,
        body: to_bytes(body),
        peer: None
    }
}

// A body as text, with newlines shown as `|`; one that is not text (a NUL byte) as its bytes.
fn shown(body: [byte]) -> string {
    return switch bytes_to_string(body) {
        Ok(text) { text }
        Err(_) { format("{}", body) }
    }
}

fn h(name: string, value: string) -> http.Header {
    return http.Header { name: name, value: value }
}

fn main() {
    val text_out = server.text_encoder<Item>(mime.text_plain(), as_text)
    val csv_out = server.text_encoder<Item>(mime.text_csv(), as_csv)
    val text_in = server.text_decoder<Item>(mime.text_plain(), read_item)
    val csv_in = server.text_decoder<Item>(mime.text_csv(), read_csv_item)
    val caller_out = server.text_encoder<Caller>(mime.text_plain(), me_as_text)
    val api = server.Api<string> { failure: failure, fault: fault }
    val endpoints = [
        server.Endpoint<Ctx> {
            method: http.HttpMethod.Get,
            pattern: "/items/{id}",
            handler: server.public_path_handler(
                path: read_id,
                encoders: [text_out, csv_out],
                status: 200,
                run: get_item,
                api: api
            )
        },
        server.Endpoint<Ctx> {
            method: http.HttpMethod.Get,
            pattern: "/newest",
            handler: server.public_handler(
                encoders: [text_out],
                run: newest_item,
                api: api
            )
        },
        server.Endpoint<Ctx> {
            method: http.HttpMethod.Get,
            pattern: "/me",
            handler: server.secure_handler(
                who: any_caller,
                encoders: [caller_out],
                run: whoami,
                api: api
            )
        },
        server.Endpoint<Ctx> {
            method: http.HttpMethod.Get,
            pattern: "/admin/{id}",
            handler: server.secure_path_handler(
                who: admin_only,
                path: read_id,
                encoders: [text_out],
                run: get_secret,
                api: api
            )
        },
        server.Endpoint<Ctx> {
            method: http.HttpMethod.Post,
            pattern: "/secret",
            handler: server.secure_body_handler(
                who: any_caller,
                decoders: [text_in],
                encoders: [text_out],
                status: 201,
                run: post_secret,
                api: api
            )
        },
        server.Endpoint<Ctx> {
            method: http.HttpMethod.Put,
            pattern: "/items/{id}",
            handler: server.public_path_body_handler(
                path: read_id,
                decoders: [text_in],
                encoders: [text_out],
                run: replace_item,
                api: api
            )
        },
        server.Endpoint<Ctx> {
            method: http.HttpMethod.Delete,
            pattern: "/items/{id}",
            handler: server.secure_path_handler(
                who: any_caller,
                path: read_id,
                encoders: [],
                status: 204,
                run: delete_item,
                api: api
            )
        },
        server.Endpoint<Ctx> {
            method: http.HttpMethod.Post,
            pattern: "/binary",
            handler: server.public_body_handler(
                decoders: [server.decoder<[byte]>(mime.application_octet_stream(), reverse_bytes)],
                encoders: [server.encoder<[byte]>(mime.application_octet_stream(), fn(data) { return data })],
                run: echo_binary,
                api: api
            )
        },
        server.Endpoint<Ctx> {
            method: http.HttpMethod.Post,
            pattern: "/items",
            handler: server.public_body_handler(
                decoders: [text_in, csv_in],
                encoders: [text_out],
                status: 201,
                run: create_item,
                api: api
            )
        }
    ]
    val table = server.routes<Ctx>(endpoints)
    val ctx = Ctx { prefix: "x" }
    val plain = [h("Content-Type", "text/plain; charset=utf-8")]

    val cases = [
        request("GET", "/items/7", [], ""),
        request("GET", "/items/7", [h("Accept", "text/csv")], ""),
        request("GET", "/items/7", [h("Accept", "text/*, text/csv;q=0")], ""),
        // The endpoint lists text/plain first, so these three are what the client's `q` weights decide and
        // the endpoint's own order does not: csv when the client prefers csv, plain when it prefers plain,
        // and the endpoint's first choice only when the two weigh the same.
        request("GET", "/items/7", [h("Accept", "text/csv, text/plain;q=0.5")], ""),
        request("GET", "/items/7", [h("Accept", "text/csv;q=0.4, text/plain;q=0.8")], ""),
        request("GET", "/items/7", [h("Accept", "text/csv, text/plain")], ""),
        // The most specific matching range decides, so a wildcard cannot rescue what `text/*;q=0` refused.
        request("GET", "/items/7", [h("Accept", "*/*, text/*;q=0")], ""),
        request("GET", "/items/7", [h("Accept", "application/json")], ""),
        request("GET", "/items/x", [], ""),
        request("GET", "/items/0", [], ""),
        request("GET", "/newest", [], ""),
        request("GET", "/newest", [h("Accept", "text/csv")], ""),
        request("POST", "/items", plain, "5"),
        request("POST", "/items", plain, "-5"),
        request("POST", "/items", plain, "five"),
        request("POST", "/items", [h("Content-Type", "application/json")], "5"),
        request("POST", "/items", [], "5"),
        request("POST", "/items", [h("Content-Type", "text/plain"), h("Accept", "text/csv")], "5"),
        request("POST", "/items", [h("Content-Type", "text/csv; charset=utf-8")], "id\n7\n"),
        request("POST", "/items", [h("Content-Type", "text/csv")], "nope"),
        request("GET", "/me", [], ""),
        request("GET", "/me", [h("Authorization", "Bearer ada")], ""),
        request("GET", "/me", [h("Authorization", "Bearer nope")], ""),
        request("GET", "/me", [h("Authorization", "Bearer boom")], ""),
        request("GET", "/me", [h("Authorization", "Bearer ada"), h("Accept", "application/json")], ""),
        request("GET", "/admin/5", [h("Authorization", "Bearer ada")], ""),
        request("GET", "/admin/5", [h("Authorization", "Bearer root")], ""),
        request("GET", "/admin/x", [h("Authorization", "Bearer root")], ""),
        request("GET", "/admin/x", [h("Authorization", "Bearer ada")], ""),
        request("POST", "/secret", [], "5"),
        request("POST", "/secret", [h("Content-Type", "application/json")], "5"),
        request("POST", "/secret", [h("Authorization", "Bearer ada"), h("Content-Type", "application/json")], "5"),
        request("POST", "/secret", [h("Authorization", "Bearer ada"), h("Content-Type", "text/plain")], "5"),
        request("POST", "/secret", [h("Authorization", "Bearer ada"), h("Content-Type", "text/plain")], "five"),
        request("PUT", "/items/2", plain, "3"),
        request("PUT", "/items/x", plain, "3"),
        request("PUT", "/items/2", plain, "three"),
        request("PUT", "/items/2", [h("Content-Type", "application/json")], "3"),
        request("DELETE", "/items/5", [], ""),
        request("DELETE", "/items/5", [h("Authorization", "Bearer ada")], ""),
        request("DELETE", "/items/5", [h("Authorization", "Bearer ada"), h("Accept", "application/json")], ""),
        request("DELETE", "/items/0", [h("Authorization", "Bearer ada")], ""),
        request("DELETE", "/items/x", [h("Authorization", "Bearer ada")], ""),
        request("DELETE", "/items", [], ""),
        request("GET", "/nothing", [], "")
    ]
    val binary = request_bytes("POST", "/binary", [h("Content-Type", "application/octet-stream")], [1b, 0b, 2b, 255b])
    val nul_text = request_bytes("POST", "/items", plain, [53b, 0b])
    val all = concat(cases, [binary, nul_text])
    for c in all {
        val r = server.dispatch<Ctx>(table, ctx, c, fault)
        val kind = http.content_type(r.headers)
        val allow = http.header_value(r.headers, "Allow")
        print(format(
            "{} {} -> {} [{}] {}{}",
            http.method_name(c.method),
            c.path,
            r.status,
            if Option.is_Some(kind) { mime.to_string(Option.unwrap_Some(kind)) } else { "-" },
            replace(shown(r.body), "\n", "|"),
            if Option.is_Some(allow) { format(" Allow={}", Option.unwrap_Some(allow)) } else { "" }
        ))
    }
}
