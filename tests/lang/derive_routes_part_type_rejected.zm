// `#[part]` on a type a form cannot carry. A part is either the uploaded file -- a `server.Part` --
// or a field of the same form, which arrives as text and converts as a query parameter does; a
// struct is neither, and the refusal names both halves rather than failing inside generated code.
//
// **A `server.Part` is matched exactly, not by suffix.** `is_uuid` accepts anything ending in
// `Uuid`, which is right for one type spelled two ways; `ends_with(name, "Part")` would accept an
// application's own `BodyPart`, and in a health record that is a type somebody really has.
#![derive(Routes)]

use derive_routes
use http
use server
use uuid.Uuid

struct Ctx {
    name: string
}

struct Principal {
    id: Uuid
}

struct Upload {
    note: string
}

#[route(method: POST, path: "/api/me/import")]
pub fn handle_import(
    ctx: Ctx,
    who: Principal,
    #[part] file: Upload
) -> Result<Upload, string> {
    return err("x")
}

fn main() {
    print("unreachable")
}
