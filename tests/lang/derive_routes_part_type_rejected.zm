// `#[part]` on something that is not a `server.Part`. A part is bytes with a filename and a
// client's claim about its own media type; nothing converts it, so there is no "read a part as an
// int" the way a query parameter is read as one -- and the refusal names what the binding takes.
//
// **The type is matched exactly, not by suffix.** `is_uuid` accepts anything ending in `Uuid`,
// which is right for one type spelled two ways; `ends_with(name, "Part")` would accept an
// application's own `BodyPart`, and in a health record that is a type somebody really has.
#![derive(Routes)]

use derive_routes
use http
use server
use uuid.Uuid

struct Ctx {
    name: string
}

struct Principal {
    id: Uuid
}

struct Upload {
    note: string
}

#[route(method: POST, path: "/api/me/import")]
pub fn handle_import(
    ctx: Ctx,
    who: Principal,
    #[part] file: string
) -> Result<Upload, string> {
    return err("x")
}

fn main() {
    print("unreachable")
}
