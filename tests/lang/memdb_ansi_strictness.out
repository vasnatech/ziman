-- LIKE: SQLite folds ASCII case, the standard and PostgreSQL compare by collation
   SELECT id FROM t WHERE name LIKE 'A%' ORDER BY id
   lax:    2 row(s) | Int(1) | Int(2)
   ansi:   1 row(s) | Int(1)
   sqlite: 2 row(s) | Int(1) | Int(2)
-- the same pattern the other way round
   SELECT id FROM t WHERE name LIKE 'a%' ORDER BY id
   lax:    2 row(s) | Int(1) | Int(2)
   ansi:   1 row(s) | Int(2)
   sqlite: 2 row(s) | Int(1) | Int(2)
-- division by zero: SQLite answers NULL, the standard makes it an error (22012)
   SELECT 1 / 0 AS boom
   lax:    1 row(s) | Null
   ansi:   refused: database error: division by zero
   sqlite: 1 row(s) | Null
-- the same, reached through columns rather than literals
   SELECT n / (n - n) AS boom FROM t WHERE id = 1
   lax:    1 row(s) | Null
   ansi:   refused: database error: division by zero
   sqlite: 1 row(s) | Null
-- number against text: SQLite orders by a type rank and matches nothing, the standard refuses
   SELECT id FROM t WHERE name = 1 ORDER BY id
   lax:    0 row(s)
   ansi:   refused: database error: cannot compare TEXT with INTEGER (the strict engine refuses what SQLite would order by type)
   sqlite: 0 row(s)
-- the same comparison the other way round
   SELECT id FROM t WHERE n > 'x' ORDER BY id
   lax:    0 row(s)
   ansi:   refused: database error: cannot compare INTEGER with TEXT (the strict engine refuses what SQLite would order by type)
   sqlite: 0 row(s)
-- a boolean in a select list: SQLite has no boolean type and answers 0 or 1, while the standard and PostgreSQL answer one
   SELECT id = 1 AS yes FROM t ORDER BY id
   lax:    3 row(s) | Int(1) | Int(0) | Int(0)
   ansi:   3 row(s) | Bool(true) | Bool(false) | Bool(false)
   sqlite: 3 row(s) | Int(1) | Int(0) | Int(0)
-- the same, reached through a predicate rather than a comparison
   SELECT n IS NULL AS unknown FROM t ORDER BY id
   lax:    3 row(s) | Int(0) | Int(0) | Int(0)
   ansi:   3 row(s) | Bool(false) | Bool(false) | Bool(false)
   sqlite: 3 row(s) | Int(0) | Int(0) | Int(0)
-- a qualified star in a RETURNING clause: SQLite refuses it outright and PostgreSQL answers it, so here the usual direction is reversed -- what fails on the lax reading and passes on the strict one is PostgreSQL-only SQL that will break on SQLite. Chosen to match no rows, so neither connection's data moves
   DELETE FROM t WHERE id = 999 RETURNING t.*
   lax:    refused: database error: RETURNING may not use "TABLE.*" wildcards
   ansi:   0 row(s)
   sqlite: refused: database error: RETURNING may not use "TABLE.*" wildcards
-- the same, on an UPDATE, and again matching nothing
   UPDATE t SET n = n WHERE id = 999 RETURNING t.*, t.id
   lax:    refused: database error: RETURNING may not use "TABLE.*" wildcards
   ansi:   0 row(s)
   sqlite: refused: database error: RETURNING may not use "TABLE.*" wildcards
lax matches sqlite on 10 of 10
ansi differs from lax on 10 of 10
-- the two readings agree on everything else --
the two readings agree on 23 of 23
