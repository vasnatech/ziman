// F192, item 1 of the Map/Set pairing pass: one `filter` over all six collections.
//
// The immutable three answer a new collection; the builders rearrange in place and answer
// nothing -- the split every paired name in this language uses. A Map's predicate takes two
// parameters where the others take one, which costs nothing: the resolver reads a lambda's
// *arity* without checking it, and argument one has already decided anyway.
fn main() {
    print(filter([1, 2, 3], fn(x: int) -> bool { return x > 1 }))
    val a = mutable([1, 2, 3])
    filter(a, fn(x: int) -> bool { return x > 1 })
    print(snapshot(a))

    print(filter(Map<string, int> { "a": 1, "b": 2 }, fn(k: string, v: int) -> bool { return v > 1 }))
    val m = mutable(Map<string, int> { "a": 1, "b": 2 })
    filter(m, fn(k: string, v: int) -> bool { return v > 1 })
    print(snapshot(m))

    print(filter(Set<int> { 1, 2, 3 }, fn(x: int) -> bool { return x > 1 }))
    val s = mutable(Set<int> { 1, 2, 3 })
    filter(s, fn(x: int) -> bool { return x > 1 })
    print(snapshot(s))

    // named arguments work, which they did not before any of this: the array halves are natives
    // and the Map/Set halves are ordinary declarations, and none of the six is dispatched by a
    // name the author wrote
    print(filter(items: [4, 5, 6], keep: fn(x: int) -> bool { return x > 5 }))

    // empty collections keep their types
    val none: [int] = []
    print(filter(none, fn(x: int) -> bool { return true }))
    print(len(filter(Map<string, int> { }, fn(k: string, v: int) -> bool { return true })))
}
