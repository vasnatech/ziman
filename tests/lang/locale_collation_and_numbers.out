-- code-point order, which suits no language --
  [Zulu, apple, oak, zebra, Öl, ärger]
-- the same words in real collations --
  en [apple, ärger, oak, Öl, zebra, Zulu]
  de [apple, ärger, oak, Öl, zebra, Zulu]
  sv [apple, oak, zebra, Zulu, ärger, Öl]
  tr [apple, ärger, oak, Öl, zebra, Zulu]
-- the sign directly, and that the generic order still differs --
  sv compare(ärger, zebra) = 1  (after z)
  de compare(ärger, zebra) = -1  (with a)
  generic compare(ärger, zebra) = 1  (code points)
  equal strings compare 0: 0
-- numbers, from the locale's own separators --
  en -> 1,234,567.89
  tr -> 1.234.567,89
  de -> 1.234.567,89
  sv -> 1 234 567,89
  ar -> 1234567.89
  C -> 1234567.89
  ar groups with nothing, which is a real answer: []
-- str is not locale-aware, under any default --
  default=tr: str(1234.56) = 1234.56  str(7) = 7
  and parse_float round-trips: true
