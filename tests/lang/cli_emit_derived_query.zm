// What a derived query becomes: one private `Translated` val, translated when the module loads,
// and the body that binds to it. Everything a reader has to trust about the feature is in this
// output, which is why it is asserted rather than only run.
#![repository(Note)]

use datasource
use db.DbError
use memdb

#[derive(Row, Entity("notes"))]
struct Note {
    #[pk]
    id: int
    owner: int
    body: string
}

#[repository]
fn find_by_owner_and_body_ignore_case_order_by_id_desc(
    conn: datasource.Connection,
    owner: int,
    body: string
) -> Result<[Note], DbError>

#[repository]
fn delete_by_id_and_owner(conn: datasource.Connection, id: int, owner: int) -> Result<unit, DbError>

fn main() {
    print(1)
}
