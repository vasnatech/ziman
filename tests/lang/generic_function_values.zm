
fn identity<T>(x: T) -> T { return x }

fn twice<T>(f: fn(T) -> T, x: T) -> T { return f(f(x)) }

fn describe<T>(x: T) -> string { return format("<{}>", x) }

fn wrap<T>(x: T) -> [T] { return [x] }

fn main() {
    val f = identity<int>
    print(f(5))
    val g: fn(string) -> string = identity<string>
    print(g("hi"))
    print(twice<int>(identity<int>, 3))
    print(map<int, string>([1, 2, 3], describe<int>))
    print(map<string, [string]>(["a", "b"], wrap<string>))
    // `array_order_of`, not `sort`: F178 made `sort` an overload set, and a set has no argument
    // list in value position to choose from, so it cannot be one. This fixture is about generic
    // functions as values, so it uses a generic function that still has one declaration.
    val h = array_order_of<int>
    print(h([3, 1, 2], false))
}
