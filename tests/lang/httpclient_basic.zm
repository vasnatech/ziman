use net
use clock
use http
use http.Header
use client
use http.HttpMethod

// A raw-socket server with canned answers, so the client is tested against exact wire formats.

fn read_head(s: net.Socket) -> string {
    var acc = ""
    while !contains(acc, "\r\n\r\n") {
        acc = concat(acc, unwrap(net.read_text(s, 4096)))
    }
    return acc
}

fn put(s: net.Socket, text: string) {
    unwrap(net.write_text(s, text))
}

fn handle(s: net.Socket) {
    defer net.close(s)
    unwrap(net.set_timeout(s, 2000))
    var req = read_head(s)
    val parts = split(req, "\r\n\r\n")
    val head = parts[0]
    var body = join(separator: "\r\n\r\n", pieces: [parts[1]])
    val first = split(head, "\r\n")[0]
    val method = split(first, " ")[0]
    val path = split(first, " ")[1]
    if contains(to_lower(head), "content-length: ") {
        val want = unwrap(parse_int(trim(split(split(to_lower(head), "content-length: ")[1], "\r\n")[0])))
        while byte_len(body) < want {
            body = concat(body, unwrap(net.read_text(s, 4096)))
        }
    }
    if path == "/plain" {
        put(s, "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nhello")
    } else if path == "/chunked" {
        put(s, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n")
        put(s, "7;ext=1\r\n, world\r\n0\r\n\r\n")
    } else if path == "/close" {
        put(s, "HTTP/1.0 200 OK\r\n\r\nuntil-close")
    } else if path == "/head" {
        put(s, "HTTP/1.1 200 OK\r\nContent-Length: 999\r\n\r\n")
    } else if path == "/redir" {
        put(s, "HTTP/1.1 302 Found\r\nLocation: /plain\r\nContent-Length: 0\r\n\r\n")
    } else if path == "/redir-post" {
        put(s, "HTTP/1.1 303 See Other\r\nLocation: /echo\r\nContent-Length: 0\r\n\r\n")
    } else if path == "/loop" {
        put(s, "HTTP/1.1 302 Found\r\nLocation: /loop\r\nContent-Length: 0\r\n\r\n")
    } else if path == "/missing" {
        put(s, "HTTP/1.1 404 Not Found\r\nContent-Length: 4\r\n\r\ngone")
    } else if path == "/echo" {
        val text = format("{} {} body={} ct={}", method, path, body, contains(head, "Content-Type: application/json"))
        put(s, format("HTTP/1.1 201 Created\r\nContent-Length: {}\r\n\r\n{}", byte_len(text), text))
    } else if path == "/hang" {
        clock.sleep_millis(1500)
    } else if path == "/garbage" {
        put(s, "NOT HTTP\r\n\r\n")
    } else {
        put(s, "HTTP/1.1 500 Oops\r\nContent-Length: 0\r\n\r\n")
    }
}

fn accept_loop(l: net.Listener) {
    while true {
        val c = net.accept(l)
        if !is_ok(c) {
            return
        }
        spawn handle(unwrap(c))
    }
}

fn show(r: Result<http.Response, client.ClientError>) {
    if is_ok(r) {
        val resp = unwrap(r)
        printf("{} [{}]\n", resp.status, unwrap(bytes_to_string(resp.body)))
    } else {
        printf("error: {}\n", error_message(unwrap_err(r)))
    }
}

fn main() {
    val l = unwrap(net.listen("127.0.0.1", 0))
    val base = format("http://127.0.0.1:{}", net.listener_port(l))
    spawn accept_loop(l)

    show(client.get(concat(base, "/plain")))
    show(client.get(concat(base, "/chunked")))
    show(client.get(concat(base, "/close")))
    show(client.get(concat(base, "/missing")))
    show(client.get(concat(base, "/redir")))
    show(client.request(method: HttpMethod.Get, url: concat(base, "/redir"), max_redirects: 0))
    show(client.get(concat(base, "/loop")))
    show(client.request(method: HttpMethod.Head, url: concat(base, "/head")))
    show(client.post_json(concat(base, "/echo"), "{\"a\":1}"))
    show(client.request(method: HttpMethod.Post, url: concat(base, "/redir-post"), body: to_bytes("x")))
    show(client.get(concat(base, "/garbage")))
    show(client.request(method: HttpMethod.Get, url: concat(base, "/hang"), timeout_ms: 300))
    show(client.get("ftp://nope"))
    show(client.get("http://127.0.0.1:1/"))

    val h = unwrap(client.get(concat(base, "/plain")))
    print(http_header(h.headers, "content-type"))
    // No `net.close_listener(l)`, for the reason http_body_cap_option.zm spells out and
    // httpclient_redirect_keeps_url_credentials.zm was fixed for (9cab978): closing the listener is
    // not how a server is stopped, so closing it under the accepting thread is an error that
    // `on_error` would print into this fixture's own stdout. The window here is narrow -- the loop
    // breaks on a non-Ok accept and hands each connection to another thread, so it is back in
    // `accept` almost immediately -- which is why this never flaked where the inline-handling one
    // did. Narrow is not closed. Process exit tears the listener down.
}

fn http_header(headers: [Header], name: string) -> string {
    for h in headers {
        if to_lower(h.name) == name {
            return h.value
        }
    }
    return "(none)"
}
