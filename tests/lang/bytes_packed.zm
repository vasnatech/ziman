use crypto
use encoding

fn tail_bytes(n: int) -> [byte] {
    val ab = mutable_array_new<byte>()
    for i in 0..n {
        push<byte>(ab, (i % 251) as byte)
    }
    return slice<byte>(snapshot(ab), n - 4, n)
}

fn main() {
    val a = [1b, 2b, 3b, 4b, 5b]
    print(a)
    print(len(a))
    print(a[2])
    print(a == [1b, 2b, 3b, 4b, 5b])
    print(a == [1b, 2b, 3b, 4b, 6b])
    print(contains(a, 4b))
    print(contains(a, 9b))
    print(hash(a) == hash([1b, 2b, 3b, 4b, 5b]))
    print(compare(a, [1b, 2b, 3b, 4b, 6b]) < 0)
    print(compare([9b], [1b, 2b]) > 0)

    // edits build new arrays and leave the original alone
    val pushed = push(a, 6b)
    val inserted = insert(a, 1, 200b)
    val replaced = set(a, 0, 255b)
    val removed = remove(a, 2)
    print(pushed)
    print(inserted)
    print(replaced)
    print(removed)
    print(a)

    // for loops, both forms
    var total = 0
    for x in a {
        total = total + (x as int)
    }
    print(total)
    for i, x in slice<byte>(a, 3, 5) {
        print(i * 1000 + (x as int))
    }

    // slices of slices, and joining
    val s = slice<byte>(a, 1, 4)
    print(slice<byte>(s, 1, 3))
    print(concat(s, [9b], slice<byte>(a, 0, 1)))
    print(len(concat([0b], slice<byte>(a, 0, 0))))

    // conversions
    val text = to_bytes("héllo")
    print(len(text))
    print(unwrap(bytes_to_string(text)))
    print(is_ok(bytes_to_string([104b, 0b, 105b])))

    // a byte builder, appended to in several shapes
    val ab = mutable_array_new<byte>()
    push<byte>(ab, 1b, 2b)
    push<byte>(ab, slice<byte>(a, 2, 5))
    print(snapshot(ab))
    print(len(ab))

    // crypto works on packed input and produces a comparable result
    print(encoding.base64_encode(to_bytes("abc")))
    print(len(crypto.sha256(to_bytes("abc"))))
    print(crypto.bytes_xor([1b, 2b], [3b, 3b]))

    // a slice outlives the array it was cut from (matters under the GC build)
    val t = tail_bytes(2000)
    val junk = mutable_array_new<string>()
    for i in 0..3000 {
        push<string>(junk, format("junk {}", i))
    }
    print(t)
}
