// `lib/graphics` phase 5, part 3: text, rasterised against a font this repository owns.
//
// **Why this file exists.** `graphics_raster.zm` covers what the text path *refuses* when no font
// is loaded, because a fixture cannot rely on a system face being installed, let alone on which
// version of it. So until `vendor/fonts/` existed, nothing checked that text came out right — four
// changes to the glyph path in F270 were each verified by rendering a scene before and after and
// comparing a digest, which catches the author's mistake and nothing else. This is the gate.
//
// The same discipline as its sibling: no golden images, every number either exact arithmetic or a
// comparison between two renders that must differ, and each check chosen so that it fails for a
// nameable reason. `vendor/fonts/Caladea-Regular.ttf` also uses a **format 4** character map, where
// the face these were developed against uses format 12 — so `truetype.lookup4` is exercised here
// for the first time.
use font
use fs
use geom
use image
use paint
use raster
use scene
use truetype

val font_path = "vendor/fonts/Caladea-Regular.ttf"
val bold_path = "vendor/fonts/Caladea-Bold.ttf"

fn round4(x: float) -> string {
    return format("{:.4}", x)
}

// The sum of alpha over every pixel: the total coverage the rasteriser laid down. This is the
// number an off-by-one in the glyph blit changes and a visual comparison does not.
fn ink_sum(img: image.Image) -> float {
    var total = 0.0
    var y = 0
    while y < img.height {
        var x = 0
        while x < img.width {
            total = total + unwrap(image.pixel_at(img, x, y)).alpha
            x = x + 1
        }
        y = y + 1
    }
    return total
}

// How many distinct alpha levels appear, which is how anti-aliasing is visible to a test: a glyph
// rendered with no partial coverage has two levels and looks like a stencil.
fn distinct_alphas(img: image.Image) -> int {
    val seen = mutable_set_new<int>()
    var y = 0
    while y < img.height {
        var x = 0
        while x < img.width {
            add(seen, (unwrap(image.pixel_at(img, x, y)).alpha * 255.0 + 0.5) as int)
            x = x + 1
        }
        y = y + 1
    }
    return len(seen)
}

// Ink inside a column band. **`ink_sum` alone is translation-invariant**, so it cannot see text
// that moved: a glyph run shifted a pixel sideways has exactly the same total. Positioning is what
// the sub-pixel quantisation in `draw_text` exists to get right, and uneven spacing is the bug it
// guards against, so this fixture has to be able to see where the ink is and not only how much.
fn ink_in_columns(img: image.Image, from_x: int, to_x: int) -> float {
    var total = 0.0
    var y = 0
    while y < img.height {
        var x = from_x
        while x <= to_x && x < img.width {
            total = total + unwrap(image.pixel_at(img, x, y)).alpha
            x = x + 1
        }
        y = y + 1
    }
    return total
}

fn loaded() -> Result<font.FontRef, string> {
    return load_from(font_path)
}

fn load_from(path: string) -> Result<font.FontRef, string> {
    val data = switch fs.read_bytes(path) {
        Ok(d) { d }
        Err(e) { return err(concat("cannot read ", path, ": ", fs.fs_error_message(e))) }
    }
    return font.load(data)
}

fn face_of(f: font.FontRef) -> Result<truetype.Face, string> {
    return switch f {
        Embedded(face) { ok(face) }
        Standard(_) { err("the vendored font should have parsed as an embedded face") }
    }
}

fn text_scene(content: string, width: float, height: float, size: float, x: float) -> scene.Scene {
    return scene.with_ops(
        scene.scene_of(width, height),
        [
            scene.text_of(
                content,
                geom.point_of(x, height * 0.72),
                size,
                0,
                paint.Paint.Solid(paint.rgb(0.0, 0.0, 0.0))
            )
        ]
    )
}

fn rendered(s: scene.Scene, f: font.FontRef, samples: int) -> Result<image.Image, string> {
    return raster.render(s, with raster.options() { fonts: [f], samples: samples })
}

fn demo() -> Result<unit, string> {
    val f = try loaded()
    val face = try face_of(f)

    // ---- the character map, which is format 4 in this face
    //
    // Asserted as glyph ids rather than as pixels: a cmap that moved by one would still draw
    // *something*, and this is the check that says which glyph.
    print(concat("units per em:        ", str(face.units_per_em)))
    print(concat("cmap format:         ", str(face.cmap_format)))
    val ids = try font.glyphs_of(face, "Aa .")
    print(concat("glyphs for \"Aa .\":   ", str(ids[0]), " ", str(ids[1]), " ", str(ids[2]), " ", str(ids[3])))
    // A space is a real glyph with an advance and no outline, which is the case that makes a
    // renderer either skip it correctly or leave a gap of the wrong width.
    print(concat("advance of a space:  ", str(try truetype.advance_of(face, ids[2]))))
    print(concat("advance of 'A':      ", str(try truetype.advance_of(face, ids[0]))))

    // ---- that text is drawn at all, and anti-aliased
    val one = try rendered(text_scene("Hamburgefonstiv", 150.0, 24.0, 16.0, 2.0), f, 4)
    print(concat("ink over the line:   ", round4(ink_sum(one))))
    print(concat("alpha levels:        ", str(distinct_alphas(one))))
    // Where the ink is, not just how much: three bands across the line, which a run shifted
    // sideways by a single pixel changes and a total does not.
    print(concat("ink in columns 0-9:  ", round4(ink_in_columns(one, 0, 9))))
    print(concat("ink in columns 40-49: ", round4(ink_in_columns(one, 40, 49))))
    print(concat("ink in columns 90-99: ", round4(ink_in_columns(one, 90, 99))))

    // **Anti-aliasing has to change the picture.** Same scene, one sub-scanline instead of four:
    // fewer partial-coverage levels, and a different total. Two renders that must differ, rather
    // than a number that looks plausible.
    val aliased = try rendered(text_scene("Hamburgefonstiv", 150.0, 24.0, 16.0, 2.0), f, 1)
    print(concat("alpha levels, aa off: ", str(distinct_alphas(aliased))))
    print(concat("ink differs with aa: ", str(ink_sum(one) != ink_sum(aliased))))

    // ---- size scales the ink
    //
    // Twice the size is roughly four times the ink, which is the relationship a glyph transform
    // that lost its scale would break. Compared as a ratio rather than an absolute, so it says
    // something about the transform rather than about this face's shapes.
    val small = try rendered(text_scene("nnnn", 80.0, 40.0, 8.0, 2.0), f, 4)
    val big = try rendered(text_scene("nnnn", 80.0, 40.0, 16.0, 2.0), f, 4)
    val ratio = ink_sum(big) / ink_sum(small)
    print(concat("ink ratio 16px/8px:  ", round4(ratio)))
    print(concat("  between 3 and 5:   ", str(ratio > 3.0 && ratio < 5.0)))

    // ---- a glyph run that starts off the left edge
    //
    // The clipped-span case: the blit has to drop the columns that fall outside the canvas rather
    // than wrapping them onto the previous row, which is what an unclamped index does.
    val clipped = try rendered(text_scene("Hamburgefonstiv", 60.0, 24.0, 16.0, 0.0 - 20.0), f, 4)
    print(concat("clipped run has ink: ", str(ink_sum(clipped) > 0.0)))
    print(concat("  less than unclipped: ", str(ink_sum(clipped) < ink_sum(one))))

    // ---- the same text at a sub-pixel offset is not the same pixels
    //
    // Glyph positions are quantised to a quarter of a pixel, so a shift of half a pixel must move
    // the ink. A renderer that snapped glyphs to whole pixels would print `false` here, and its
    // text would be unevenly spaced in a way no total would reveal.
    val shifted = try rendered(text_scene("Hamburgefonstiv", 150.0, 24.0, 16.0, 2.5), f, 4)
    print(concat("half-pixel shift moves ink: ", str(ink_sum(shifted) != ink_sum(one))))

    // ---- the other two output formats carry the same glyphs
    val grey = try raster.render(
        text_scene("Hg", 30.0, 20.0, 14.0, 2.0),
        with raster.options() {
            fonts: [f],
            samples: 4,
            format: image.Pixels.Gray8,
            background: Option<paint.Color>.Some(paint.white())
        }
    )
    print(concat("gray8 channels:      ", str(image.channels_of(grey.format))))
    // White background, black text: some pixel must be darker than white, or nothing was drawn.
    var darkest = 255
    var i = 0
    while i < len(grey.data) {
        val v = grey.data[i] as int
        if v < darkest {
            darkest = v
        }
        i = i + 1
    }
    print(concat("gray8 darkest pixel: ", str(darkest)))

    // ---- a character the face cannot draw is named, not skipped
    //
    // U+4E2D is Chinese; this is a Latin face. The refusal has to say which code point, because a
    // caller's only other option is to guess which character of a long string was the problem.
    print(concat("missing glyph:       ", refusal(font.glyphs_of(face, "ok 中"))))

    // ---- two faces in one scene get their own glyphs
    //
    // **The case a single face cannot test, and the reason `Caladea-Bold` is vendored beside the
    // Regular.** `raster.zm` caches rasterised glyphs, and its key was the transform, the glyph id
    // and the subpixel offset -- nothing naming the face. These two are *1000 units per em with 420
    // glyphs each*, so every part of that key matched, and `a` is glyph 68 in both: drawing it in
    // each rendered the second in the first's shape. Regular above bold in one scene is as ordinary
    // as a heading over a paragraph.
    //
    // Asserted three ways, because each alone could pass for the wrong reason. The faces must be
    // indistinguishable by their metrics (or the key would separate them by accident); their ink
    // drawn *alone* must differ (or there is nothing for a cache to get wrong); and the bold drawn
    // after the regular **in one scene** must match the bold drawn alone.
    val bold_ref = try load_from(bold_path)
    val bold = try face_of(bold_ref)
    print(concat("bold units per em:   ", str(bold.units_per_em)))
    print(concat("same metrics:        ", str(
        bold.units_per_em == face.units_per_em && bold.glyph_count == face.glyph_count
    )))
    // The identity that does separate them, which is what the cache key carries.
    print(concat("face ids differ:     ", str(truetype.face_id(bold) != truetype.face_id(face))))
    val regular_ids = try font.glyphs_of(face, "a")
    val bold_ids = try font.glyphs_of(bold, "a")
    print(concat("'a' is one glyph id: ", str(regular_ids[0] == bold_ids[0]), " (", str(regular_ids[0]), ")"))

    // ---- a surface keeps its glyphs between frames, and keeps a bound on them
    //
    // **The other half of why `raster.Surface` exists**, and it needs a font, so it lives here
    // rather than beside the surface cases in `graphics_raster.zm`. Two frames of the same text:
    // the first fills the cache and the second finds it already filled, which is what makes a
    // repainting window cheaper than a sequence of one-off renders.
    val surface = switch raster.surface_of(150.0, 24.0, 1.0) {
        Ok(c) { c }
        Err(why) { return err(concat("surface refused: ", why)) }
    }
    val run = text_scene("Hamburgefonstiv", 150.0, 24.0, 16.0, 2.0)
    val opts = with raster.options() { fonts: [f], samples: 4 }
    print(concat("glyphs before:       ", str(raster.cached_glyphs(surface))))
    val frame_one = try raster.render_into(surface, run, opts)
    val after_one = raster.cached_glyphs(surface)
    print(concat("glyphs after a frame: ", str(after_one > 0)))
    val frame_two = try raster.render_into(surface, run, opts)
    print(concat("unchanged by frame 2: ", str(raster.cached_glyphs(surface) == after_one)))
    // And the pixels are the same both times, which is what the reuse must not cost.
    print(concat(
        "both frames identical: ",
        str(ink_in_columns(frame_one, 0, 149) == ink_in_columns(frame_two, 0, 149))
    ))

    // **The bound, with a limit of two instead of the real 8192**, which a fixture cannot reach.
    // Checked at the *start* of a frame, so the overflowing frame still finishes with a working
    // cache and the next one starts empty -- evicting mid-frame would thrash and be slower than no
    // cache at all.
    //
    // **Two different texts, and that is the whole design of this case.** The first version of it
    // drew the same text twice and asserted the count was unchanged -- which is true whether or not
    // the bound does anything, because the second frame either refills exactly what it dropped or
    // finds it all still there. Only a frame of *different* glyphs separates the two: a bounded
    // surface ends holding the second text alone, an unbounded one holds both. So it is asserted
    // against a default surface given the same two frames.
    val other = text_scene("QWXZ 1234", 150.0, 24.0, 16.0, 2.0)
    val bounded = switch raster.surface_of(150.0, 24.0, 1.0) {
        Ok(c) { with c { glyph_limit: 2 } }
        Err(why) { return err(concat("surface refused: ", why)) }
    }
    val unbounded = switch raster.surface_of(150.0, 24.0, 1.0) {
        Ok(c) { c }
        Err(why) { return err(concat("surface refused: ", why)) }
    }
    val _ = try raster.render_into(bounded, run, opts)
    print(concat("over the limit:      ", str(raster.cached_glyphs(bounded) > 2)))
    val _ = try raster.render_into(bounded, other, opts)
    val _ = try raster.render_into(unbounded, run, opts)
    val _ = try raster.render_into(unbounded, other, opts)
    print(concat("bounded dropped the first text: ", str(
        raster.cached_glyphs(bounded) < raster.cached_glyphs(unbounded)
    )))
    // And the unbounded one really did accumulate both, which is what makes the line above a
    // comparison between two behaviours rather than between two numbers that happen to differ.
    print(concat("unbounded kept both: ", str(
        raster.cached_glyphs(unbounded) > raster.cached_glyphs(bounded) + 1
    )))

    // ---- a point is not a pixel, and the ratio scales outlines rather than bitmaps
    //
    // **The sharp test for `Options.px_per_pt`.** Size 24 at a ratio of 1 and size 12 at a ratio of
    // 2 produce the same glyph transform, so if the ratio scales the *outline* before rasterising,
    // the two images are identical byte for byte. A renderer that rasterised at the unscaled size
    // and stretched the result would differ everywhere a curve is -- which is the whole difference
    // between type that is 18 pixels tall and type that is a blurred 12.
    //
    // The pen moves with the ratio too, so the smaller scene places its run at half the
    // coordinates to land on the same pixel.
    val at_24 = try raster.render(
        text_scene("Hamburg", 300.0, 48.0, 24.0, 4.0),
        with raster.options() { fonts: [f], samples: 4 }
    )
    val doubled = try raster.render(
        text_scene("Hamburg", 150.0, 24.0, 12.0, 2.0),
        with raster.options() { fonts: [f], samples: 4, px_per_pt: 2.0 }
    )
    print(concat("ratio 2 canvas is 300x48: ", str(doubled.width), "x", str(doubled.height)))
    print(concat("outlines scale, not bitmaps: ", str(ink_sum(at_24) == ink_sum(doubled))))
    print(concat("  and every pixel agrees:     ", str(same_pixels(at_24, doubled))))

    val alone_regular = try one_face("a", f, 0)
    val alone_bold = try one_face("a", bold_ref, 0)
    print(concat("alone, ink differs:  ", str(ink_sum(alone_regular) != ink_sum(alone_bold))))
    // Both faces in one render, so they share one cache. The bold run is read on its own half.
    val together = try raster.render(
        scene.with_ops(
            scene.scene_of(120.0, 40.0),
            [
                scene.text_of("a", geom.point_of(4.0, 29.0), 28.0, 0, paint.Paint.Solid(paint.rgb(0.0, 0.0, 0.0))),
                scene.text_of("a", geom.point_of(64.0, 29.0), 28.0, 1, paint.Paint.Solid(paint.rgb(0.0, 0.0, 0.0)))
            ]
        ),
        with raster.options() { fonts: [f, bold_ref], samples: 4 }
    )
    print(concat("bold after regular:  ", round4(ink_in_columns(together, 60, 119))))
    print(concat("  matches bold alone: ", str(
        round4(ink_in_columns(together, 60, 119)) == round4(ink_in_columns(try shifted_bold(bold_ref), 60, 119))
    )))
    return ok(unit)
}

// One character on a 120x40 canvas, drawn with the given font index out of a one-font list.
fn one_face(content: string, f: font.FontRef, index: int) -> Result<image.Image, string> {
    val _ = index
    return raster.render(
        scene.with_ops(
            scene.scene_of(120.0, 40.0),
            [scene.text_of(content, geom.point_of(4.0, 29.0), 28.0, 0, paint.Paint.Solid(paint.rgb(0.0, 0.0, 0.0)))]
        ),
        with raster.options() { fonts: [f], samples: 4 }
    )
}

// The bold 'a' at the *same place* the two-face scene puts it, so the two are comparable band for
// band rather than only in total -- `ink_sum` is translation-invariant and would not notice a run
// drawn in the wrong place.
fn shifted_bold(bold_ref: font.FontRef) -> Result<image.Image, string> {
    return raster.render(
        scene.with_ops(
            scene.scene_of(120.0, 40.0),
            [scene.text_of("a", geom.point_of(64.0, 29.0), 28.0, 0, paint.Paint.Solid(paint.rgb(0.0, 0.0, 0.0)))]
        ),
        with raster.options() { fonts: [bold_ref], samples: 4 }
    )
}

// Every pixel of two images compared, rather than a total: `ink_sum` is translation-invariant and
// would not notice a run drawn in the wrong place at the right weight.
fn same_pixels(a: image.Image, b: image.Image) -> bool {
    if a.width != b.width || a.height != b.height {
        return false
    }
    var y = 0
    while y < a.height {
        var x = 0
        while x < a.width {
            val p = unwrap(image.pixel_at(a, x, y))
            val q = unwrap(image.pixel_at(b, x, y))
            if round4(p.red) != round4(q.red) || round4(p.alpha) != round4(q.alpha) {
                return false
            }
            x = x + 1
        }
        y = y + 1
    }
    return true
}

fn refusal<T>(r: Result<T, string>) -> string {
    return switch r {
        Ok(_) { "no refusal" }
        Err(why) { why }
    }
}

fn main() {
    switch demo() {
        Ok(_) { print("ok") }
        Err(why) { print(concat("FAILED: ", why)) }
    }
}
