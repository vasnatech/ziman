fn main() {
    val nothing: [int] = []
    print(concat([1, 2], [3], nothing, [4, 5]))
    print(len(concat(nothing, nothing)))
    print(concat(["a"], ["b", "c"]))
    val many: [[int]] = [[1], [2, 3]]
    print(concat(many))
    val one = [7, 8]
    val joined = concat(one, one)
    print(joined)
    print(one)
}
