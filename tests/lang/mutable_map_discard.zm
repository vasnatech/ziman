// `discard` is `remove` without the answer: `remove(m, key)` hands back the `Option<V>` it took
// out, `discard(m, key)` hands back nothing. Keeping both is deliberate (user, 2026-10-20) -- the
// value is genuinely wanted about half the time, and building an `Option` to throw away is the
// cost `discard` exists to avoid.
//
// Both are bare names over the MutableMap world since F200. `discard` answered a `bool` until
// then; it answers nothing now, which is what makes the pair say *what they are for* rather than
// differ by a flag.
fn main() {
    val m = mutable(Map<string, int> { "a": 1, "b": 2, "c": 3 })

    discard(m, "a")
    print(snapshot(m))

    // discarding a key that is not there is not an error, and says nothing either way
    discard(m, "a")
    discard(m, "zz")
    print(snapshot(m))

    // `remove` is the one that answers
    print(remove(m, "b"))
    print(remove(m, "b"))
    print(snapshot(m))
}
