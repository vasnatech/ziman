// `#[derive(Ord)]`'s generator, written in Ziman and called as an ordinary function.
//
// **This is the test the C version could not have.** A generator in `src/derive.c` can only be
// exercised end to end -- run a program, compare its output -- because there is no way to call
// `generate_struct_ord` on a declaration and read the text back. Here the generator is a function
// from a `meta.Decl` to a string, so its output is just a value to compare, and the three shapes
// that matter (a struct, a generic struct, an enum with and without payloads) are three calls.
//
// The expected text is what `src/derive.c` emits today, byte for byte. See docs/roadmap/'s
// "Derives should be written in Ziman, not in C".
use derive_ord
use meta

val no_attrs: [meta.Attr] = []

fn member(name: string) -> meta.Field {
    return meta.field(name, meta.int_type(), no_attrs)
}

fn variant(name: string, payload: bool) -> meta.Variant {
    if payload {
        return meta.payload_variant(name, meta.int_type())
    }
    return meta.unit_variant(name)
}

fn main() {
    val none: [string] = []
    val point = meta.struct_decl("Point", "point", meta.no_args(), none, [member("x"), member("y")])
    print(unwrap(derive_ord.generate(point)))
    val boxed = meta.struct_decl("Box", "box", meta.no_args(), ["T", "U"], [member("first"), member("second")])
    print(unwrap(derive_ord.generate(boxed)))
    val shape = meta.enum_decl(
        "Shape",
        "shape",
        meta.no_args(),
        none,
        [variant("Dot", false), variant("Line", true), variant("Area", false)]
    )
    print(unwrap(derive_ord.generate(shape)))
}
