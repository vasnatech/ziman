// `mutable(x)` answers the mutable counterpart of whatever it is given. The three collections that
// have a builder answer that builder, which reads as `snapshot` backwards; each rewrites onto the
// `mutable_*_from` it mirrors.
//
// The map and set cases are here together on purpose: the interpreter tells `mutable_map_from` from
// `mutable_set_from` by the ninth character of the callee name, so a rewrite producing anything but
// those two exact names would build the wrong shape.
fn main() {
    val ab = mutable([1, 2, 3])
    push(ab, 4)
    print(snapshot(ab))

    val sb = mutable(Set<int> { 1, 2 })
    mutable_set_add<int>(sb, 3)
    print(snapshot(sb))

    val mb = mutable(Map<string, int> { "a": 1 })
    mutable_map_set<string, int>(mb, "b", 2)
    print(snapshot(mb))

    print(snapshot(mutable([7, 8])))
}
