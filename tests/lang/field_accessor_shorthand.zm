// **`Type::field` is the field-accessor shorthand**, standing for
// `fn($x: Type) { $x.field }`. It exists for the key-taking family -- `sort_by`, `min_by`,
// `max_by`, `group_by`, `index_by`, `map` -- where the lambda names the type twice and the field
// once to say one field: `fn(r: Row) -> string { return r.dept }` against `Row::dept`. That is the
// same argument `b[i]` won over `mutable_array_get(b, i)`, not an argument about length.
//
// **`.` could not have been the separator.** `Type.member` is already enum-variant access, so
// `P.age` answers "no enum named 'P'" -- `::` was unused in the lexer.
//
// It desugars in the *parser* into the lambda it means, so closures, captures, GC rooting and
// `--fmt` all see an ordinary lambda and no later phase knows about it. The body is the bare
// expression `$x.field` rather than `return $x.field`, because a lambda using `return` cannot have
// its return type inferred and the parser has no module to look a field's type up in; a final
// expression is inferred, which is how the field's type arrives. The parameter is `$x`, which does
// not lex as an identifier, so it can neither collide with nor be named by anything written.
//
// **The type arguments are gone from this file, and that was the other half of the feature.**
// Every call here read `map<Row, string>(rows, Row::dept)` until 2026-10-21: a shorthand whose
// whole argument is that the lambda names the type twice, used at a call site that then named it
// twice anyway. The cause was general rather than anything to do with `::` -- a lambda argument
// never contributed to inferring a generic *result*, because the first inference pass skips any
// lambda missing an annotation and nothing looked at one again. A second pass does now: the
// bindings the first pass made are substituted into the declared parameter type, and a lambda
// whose parameters have all become concrete is checked on its own, its final expression answering
// the result. `Point::x` inherited the gap and the fix; see DESIGN.md's "A lambda argument can
// answer a type parameter".
struct Row {
    dept: string
    age: int
}

fn main() {
    val rows = [Row { dept: "b", age: 30 }, Row { dept: "a", age: 40 }, Row { dept: "b", age: 20 }]

    // what it is for: one key, and the multi-key form where the noise was worst
    print(map(rows, Row::dept))
    print(map(sort_by(rows, Row::dept, Row::age), Row::age))

    // the rest of the key-taking family
    print(min_by(rows, Row::age))
    print(max_by(rows, Row::dept))
    print(len(group_by(rows, Row::dept)))
    print(len(index_by(rows, Row::age)))
    print(len(frequencies(map(rows, Row::dept))))

    // it is an ordinary function value: bindable, with its type inferred from the field
    val key = Row::age
    print(key(rows[0]))
    print(count(rows, fn(r: Row) { key(r) > 25 }))

    // and it reaches a builder's twin as any other key does
    val b = mutable(rows)
    sort_by(b, Row::age)
    print(map(snapshot(b), Row::age))
}
