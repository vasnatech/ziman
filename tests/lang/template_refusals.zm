// What the template module refuses, and what it says. Both directions of binding are checked --
// a hole naming nothing bound, and a binding the template never mentions -- because the second
// is the more likely mistake once a template has been edited.
//
// A source is a *sheet* of named templates (design §15), so everything here names one.
use template

fn show(what: string, r: Result<string, string>) {
    if Err(e) = r {
        print(concat(what, ": ", e))
    }
    if Ok(text) = r {
        print(concat(what, ": ok -> ", text))
    }
}

fn parsed(what: string, source: string) {
    if Err(e) = template.parse(source) {
        print(concat(what, ": ", e))
    }
    if Ok(_) = template.parse(source) {
        print(concat(what, ": ok"))
    }
}

fn wrap(body: string) -> string {
    return concat("@template t\n", body, "\n@end\n")
}

fn main() {
    parsed("text outside a template", "hello\n@template t\nx\n@end")
    parsed("a template with no name", "@template\nx\n@end")
    parsed("two templates of one name", "@template t\nx\n@end\n@template t\ny\n@end")
    parsed("a template never closed", "@template t\nx")
    parsed("a nested template", wrap("@template u\nx\n@end"))
    parsed("a lone @", wrap("x @ y"))
    parsed("an unclosed hole", wrap("x @{name y"))
    parsed("an empty hole", wrap("x @{} y"))
    parsed("an unknown directive", wrap("@foreach x in xs"))
    // The inner `@for` swallows the template's own `@end`, so what is left unclosed is the
    // template -- which is what it says, rather than guessing at the `@for`.
    parsed("an @for that eats the template @end", wrap("@for m in xs\nx"))
    // `@choose`/`@when`/`@otherwise` were removed with step 4b of the expression language: with
    // expressions they are `@if k == 'a'` written in more words and one more concept, so an
    // `@choose` is now an unknown directive like any other misspelling.
    parsed("@choose is gone", wrap("@choose k\n@when a\nx\n@end"))
    parsed("@when is gone", wrap("@when a\nx"))
    parsed("an @if never closed", wrap("@if k\nx"))
    parsed("a malformed condition", wrap("@if k ==\nx\n@end"))
    parsed("an @elif with no condition", wrap("@if k\nx\n@elif\ny\n@end"))

    val sheet = template.must_parse("""
@template greet
@{greeting}, @{name}
@end

@template pick
@if kind == 'loud'
LOUD
@elif kind == 'quiet'
quiet
@end
@end

@template pick_else
@if kind == 'loud'
LOUD
@else
something else
@end
@end

@template plain
@if on
on
@end
@end

@template over
@for r in rows
- @{r.cell}
@end
@end
""")
    show("an unknown template", template.render(sheet, "nope", []))
    show("an unbound hole", template.render(sheet, "greet", [template.text("greeting", "hello")]))
    show("a binding nothing uses", template.render(sheet, "greet", [
        template.text("greeting", "hello"),
        template.text("name", "Ada"),
        template.text("extra", "unused")
    ]))
    // **No arm matching and no `@else` emits nothing**, where `@choose` refused the tag. That is
    // what `@if` means everywhere, and it is the safety `@choose` had that the swap gives up: a
    // dispatch that must be exhaustive writes its last case as `@else`, as `pick_else` does.
    show("no arm matches", template.render(sheet, "pick", [template.text("kind", "shouty")]))
    show("an arm matches", template.render(sheet, "pick", [template.text("kind", "quiet")]))
    show("no arm matches, with an @else", template.render(sheet, "pick_else", [
        template.text("kind", "shouty")
    ]))
    // A comparison is a bool whatever it compares, so an array against a string is simply
    // `false` and the arm does not match. A *bare* condition is where the type shows: a bool
    // holds, and anything else is refused rather than being judged truthy.
    show("a comparison against an array", template.render(sheet, "pick", [
        template.rows("kind", [])
    ]))
    show("a bare condition that is a bool", template.render(sheet, "plain", [
        template.flag("on", true)
    ]))
    show("a bare condition that is a string", template.render(sheet, "plain", [
        template.text("on", "truthy")
    ]))
    show("@for over a string", template.render(sheet, "over", [template.text("rows", "not rows")]))
    show("a cell that is not there", template.render(sheet, "over", [
        template.rows("rows", [template.row([template.text("other", "x")])])
    ]))
}
