// `produces: "xml"` on a model that does **not** derive `Xml`.
//
// This fixture used to be about the refusal: XML was a format `produces:` could not reach at all,
// and it had a message of its own saying why. `#[derive(Xml)]` (2026-10-31) made it reachable, and
// what is left is the one thing `derive_routes` cannot check for itself -- whether the type named
// has the pair. An attribute carries values, not evidence about another module's declarations, so
// the generator emits `xml_encoder(model.order_response_to_xml)` and the *compiler* reports that
// the name does not resolve, at the module attribute that generated it.
//
// **That is the honest division and the same one `Json` has always had**: `produces: "json"` on a
// type that derives nothing fails exactly this way too. The message names the function, which is
// the thing to go and add the derive for.
//
// `tests/lang/derive_routes` is the passing twin, where both models derive both.
#![derive(Routes)]

use codec.csv_format
use codec.decoder_of
use codec.encoder_of
use codec.json_format
use codec.list_encoder_of
use codec.ndjson_format
use codec.xml_encoder
use codec.yaml_format
use derive_routes
use http
use model
use rest
use rest.uuid_param
use server
use uuid.Uuid
use wiring.Ctx
use wiring.Principal
use wiring.api
use wiring.authenticated

// `produces: "all"` is every format an array can be written as, so one `Accept` header picks
// between JSON, YAML, NDJSON and CSV. Nothing else about the handler changes.
#[route(method: GET, path: "/api/orders", produces: "all")]
pub fn handle_list(ctx: Ctx, who: Principal) -> Result<[model.OrderResponse], string> {
    return err("x")
}

// `xml` is named, and `model.OrderResponse` has no `_to_xml` to name -- so this is where it fails.
#[route(method: POST, path: "/api/orders", status: 201, produces: "json, xml")]
pub fn handle_create(ctx: Ctx, who: Principal, data: model.OrderRequest) -> Result<model.OrderResponse, string> {
    return err("x")
}

// `label:` names the noun in a bad-id message; it defaults to the module's own name, which is
// `main` here and `order` is what it should say.
#[route(method: DELETE, path: "/api/orders/{id}", status: 204, label: "order")]
pub fn handle_delete(ctx: Ctx, who: Principal, id: Uuid) -> Result<unit, string> {
    return err("x")
}

fn main() {
    print(prelude.len(main_routes))
}
