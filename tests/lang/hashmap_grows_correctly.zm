// Many inserts (the trie splits at every level) and every key still
// reachable with the right value, then overwriting every key: the count
// must not change.
fn main() {
    var m = Map<int, int> {}
    for i in 0..2000 {
        m = set(m, i, i * i)
    }
    print(len(m))

    var ok = true
    for i in 0..2000 {
        if get_or<int>(get(m, i), -1) != i * i {
            ok = false
        }
    }
    print(ok)

    for i in 0..2000 {
        m = set(m, i, i)
    }
    print(len(m))

    var ok2 = true
    for i in 0..2000 {
        if get_or<int>(get(m, i), -1) != i {
            ok2 = false
        }
    }
    print(ok2)
}
