
struct Person {
    name: string
    age: int
}

fn main() {
    val stock = Map<string, int> { "apple": 4, "fig": 9, "pear": 6 }

    // entries, in insertion order, and sorted by value
    val entries = entries<string, int>(stock)
    print(len(entries))
    print(entries[1].key)
    print(entries[1].value)
    val ranked = sort_by_desc<MapEntry<string, int>, int>(entries, fn(e) { e.value })
    print(map<MapEntry<string, int>, string>(ranked, fn(e) { e.key }))
    print(len(entries<string, int>(Map<string, int> {})))

    // map keeps keys and order
    val labels = map<string, int, string>(stock, fn(k, n) { format("{} units", n) })
    print(labels)
    print(map<string, int, bool>(stock, fn(k, n) { n > 5 }))
    print(len(map<string, int, int>(Map<string, int> {}, fn(k, n) { n })))

    // map: results merge
    val parity = map<int, int>(Set<int> { 1, 2, 3, 4, 5 }, fn(n) { n % 2 })
    print(parity)
    print(map<string, int>(Set<string> { "a", "bb", "cc" }, fn(s) { byte_len(s) }))
    print(len(map<int, int>(Set<int> {}, fn(n) { n })))

    // frequencies and index_by
    print(frequencies<string>(["a", "b", "a", "c", "a", "b"]))
    print(frequencies<int>([]))
    val people = [Person { name: "Ada", age: 36 }, Person { name: "Grace", age: 45 }, Person { name: "Ada", age: 29 }]
    val by_name = index_by<Person, string>(people, fn(p) { p.name })
    print(len(by_name))
    print(Option.unwrap_Some(get(by_name, "Ada")).age)
    print(keys(by_name))
    print(len(index_by<Person, int>([], fn(p) { p.age })))
}
