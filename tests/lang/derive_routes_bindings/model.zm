// The request also derives `Xml`, and the response derives both -- which is what lets
// `consumes:`/`produces:` name `"xml"` beside the tree formats. A type named with `"xml"` and not
// deriving it is a generated call that does not resolve, reported where the attribute is.
use xml

#[derive(Json)]
#[derive(Xml)]
#[derive(Validate)]
pub struct OrderRequest {
    #[not_blank]
    item: string
}

#[derive(Json)]
#[derive(Xml)]
pub struct OrderResponse {
    id: int
    item: string
}
