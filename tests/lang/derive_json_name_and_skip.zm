// `#[json(..)]`: the key override and the three shapes of `skip`.
//
// The three things worth pinning are the ones a round-trip test cannot see. A field skipped on the
// way out leaves **no trailing comma** behind it in the object literal, which is why `to_json`
// counts the kept fields rather than all of them. A field skipped on the way in is built from its
// type's own absent value, because Ziman has no field defaults. And `from_json_all` needs no
// special case at all: a skipped field's "read" is an assignment that cannot fail, so its lambda
// always succeeds and the accumulating decoder reports nothing for it.
#[derive(Json)]
struct Account {
    #[json(name: "loginName")]
    login: string

    // Neither written nor read.
    #[json(skip: true)]
    cached_at: Option<string>

    // Arrives in the body, never leaves -- the write-only secret.
    #[json(skip_write: true)]
    new_password: string

    // Leaves, never arrives -- and it is last, so the comma above it has to be the final one.
    #[json(skip_read: true)]
    roles: [string]
}

fn main() {
    print(1)
}
