use http
use http.HttpMethod
use rest
use server

// What `rest.routes` + `rest.dispatch` promise: the most specific matching endpoint wins -- a literal
// segment beats a `{param}` wherever either is declared, and registration order is only the tiebreak -- a
// trailing slash is ignored, captures are percent-decoded, an empty segment never fills a `{param}`, and a path
// that exists under other methods is a 405 naming them, while an unknown path is a 404.
//
// **This fixture asserted the opposite until 2026-11-01**, and said so: "Table order decides: `/items/{id}`
// comes before `/items/new`, so `new` is an id." That was the rule the index was built to preserve
// (docs/design/journal/part-02.md weighed a literal-preferring trie and rejected it for "silently changing
// that rule"), and it held for as long as an application kept every endpoint in one table where the order was
// visible and commented. `#![derive(Routes)]` ended that: the table is now assembled from a controller per
// resource, so "ahead of `/{id}`" means the order of two functions in one of twenty-three files. The North
// Star's `/api/me/medications/interaction-check` was swallowed by `/{id}` the moment its controller was
// converted -- answered 400 "invalid medication id: interaction-check" instead of its own 501 -- and only its
// behavioural suite caught it. Specificity cannot be got wrong by moving a function.
//
// HEAD is the exception to the method match, and this fixture used to assert the opposite: `HEAD /` expected a
// 405. RFC 9110 makes HEAD a GET without a body, so a path that serves GET has to serve HEAD, and a 405 there
// breaks the caches and link checkers that use HEAD to ask whether a resource exists. An unmatched HEAD now
// runs the GET handler -- the body comes back as usual and `write_response` withholds it on the wire while
// still writing the Content-Length it would have had -- and `Allow` names HEAD wherever GET is served, since
// after the fallback it really is allowed (E14).

struct Ctx {
    tag: string
}

fn fault(status: int, message: string) -> http.Response {
    return server.text_response(status, message)
}

fn says(name: string) -> fn(Ctx, http.Request, rest.Params) -> http.Response {
    return fn(ctx: Ctx, req: http.Request, params: rest.Params) -> http.Response {
        return server.text_response(200, name)
    }
}

fn param_id(ctx: Ctx, req: http.Request, params: rest.Params) -> http.Response {
    return server.text_response(200, concat("id=", rest.param(params, "id")))
}

fn two(ctx: Ctx, req: http.Request, params: rest.Params) -> http.Response {
    return server.text_response(200, format("{}/{}", rest.param(params, "a"), rest.param(params, "b")))
}

fn request(method: HttpMethod, path: string) -> http.Request {
    return http.Request {
        method: method,
        target: path,
        path: path,
        query: "",
        version: "HTTP/1.1",
        headers: [],
        body: [],
        peer: None
    }
}

fn show(table: rest.Routes<Ctx>, method: HttpMethod, path: string) {
    val r = rest.dispatch<Ctx>(table, Ctx { tag: "t" }, request(method, path), fault)
    val allow = http.header_value(r.headers, "Allow")
    val allowed = if Option.is_Some(allow) { concat("  Allow: ", Option.unwrap_Some(allow)) } else { "" }
    print(format(
        "{} {} -> {} {}{}",
        http.method_name(method),
        path,
        r.status,
        unwrap(bytes_to_string(r.body)),
        allowed
    ))
}

fn main() {
    val table = rest.routes<Ctx>([
        rest.Endpoint<Ctx> { method: HttpMethod.Get, pattern: "/", handler: says("root") },
        rest.Endpoint<Ctx> { method: HttpMethod.Get, pattern: "/items/{id}", handler: param_id },
        rest.Endpoint<Ctx> { method: HttpMethod.Get, pattern: "/items/new", handler: says("literal new") },
        rest.Endpoint<Ctx> { method: HttpMethod.Post, pattern: "/items", handler: says("create") },
        rest.Endpoint<Ctx> { method: HttpMethod.Delete, pattern: "/items/{id}", handler: says("delete") },
        rest.Endpoint<Ctx> { method: HttpMethod.Put, pattern: "/items/{id}", handler: says("put") },
        rest.Endpoint<Ctx> { method: HttpMethod.Get, pattern: "/pairs/{a}/{b}", handler: two },
        rest.Endpoint<Ctx> { method: HttpMethod.Get, pattern: "/health/", handler: says("health") }
    ])

    // The root, and a trailing slash on the request or the pattern.
    show(table, HttpMethod.Get, "/")
    show(table, HttpMethod.Get, "/health")
    show(table, HttpMethod.Get, "/health/")
    show(table, HttpMethod.Get, "/items/7/")

    // Specificity decides, not order: `/items/{id}` is registered first and `/items/new` still answers.
    show(table, HttpMethod.Get, "/items/new")

    // Captures are percent-decoded; an empty segment fills no `{param}`; bad encoding is no match.
    show(table, HttpMethod.Get, "/items/a%20b")
    show(table, HttpMethod.Get, "/pairs/x%2Fy/z")
    show(table, HttpMethod.Get, "/items//")
    show(table, HttpMethod.Get, "/pairs//z")
    show(table, HttpMethod.Get, "/items/%zz")

    // Same path, other methods: 405 listing what does exist, in table order. Nothing there: 404.
    show(table, HttpMethod.Patch, "/items/7")
    show(table, HttpMethod.Get, "/items")
    show(table, HttpMethod.Post, "/items/7")
    show(table, HttpMethod.Get, "/nope")
    show(table, HttpMethod.Get, "/items/7/extra")
    show(table, HttpMethod.Get, "/pairs/only")
    show(table, HttpMethod.Head, "/")
}
