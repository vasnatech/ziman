// Every expected value here was cross-checked against Python's own arbitrary-precision int
// bitwise operators (which already implement exactly the infinite-two's-complement semantics
// Java's BigInteger and this module both target), not hand-derived.
use bits

fn main() {
    print(bits.and(12n, 10n))                                     // 8
    print(bits.and(-1n, 5n))                                      // 5 -- -1 is all 1-bits
    print(bits.and(-5n, 3n))                                      // 3
    print(bits.and(-12n, -10n))                                   // -12
    print(bits.and(123456789012345678901234567890n, 987654321n))  // 169740432
    print(bits.and(-123456789012345678901234567890n, 555n))       // 42

    print(bits.or(12n, 10n))                                     // 14
    print(bits.or(-1n, 5n))                                      // -1
    print(bits.or(-12n, -10n))                                   // -10
    print(bits.or(123456789012345678901234567890n, 987654321n))  // 123456789012345678902052481779
    print(bits.or(-123456789012345678901234567890n, 555n))       // -123456789012345678901234567377

    print(bits.xor(12n, 10n))                                     // 6
    print(bits.xor(-1n, 5n))                                      // -6
    print(bits.xor(-12n, -10n))                                   // 2
    print(bits.xor(123456789012345678901234567890n, 987654321n))  // 123456789012345678901882741347
    print(bits.xor(-123456789012345678901234567890n, 555n))       // -123456789012345678901234567419

    print(bits.not(0n))                                // -1
    print(bits.not(-1n))                               // 0
    print(bits.not(5n))                                // -6
    print(bits.not(-123456789012345678901234567890n))  // 123456789012345678901234567889

    print(bits.shift_left(1n, 4))     // 16
    print(bits.shift_left(-1n, 100))  // -1267650600228229401496703205376

    print(bits.shift_right(8n, 1))                                 // 4
    print(bits.shift_right(-8n, 1))                                // -4
    print(bits.shift_right(-3n, 1))                                // -2, floors (not -3n / 2n, which is -1n)
    print(bits.shift_right(-123456789012345678901234567890n, 10))  // -120563270519868827051986883
    print(bits.shift_right(0n, 5))                                 // 0
}
