// `memdb:` and `memdb-ansi:` are the same engine reading SQL two ways, and this is the list of
// places the two readings part.
//
// **The point is a portability check, not a better engine.** The sample application ships on
// SQLite *and* PostgreSQL, and SQL that works on one and not the other is a live risk -- DESIGN.md
// records a two-commit PostgreSQL outage from exactly that. Where SQLite departs from the standard,
// PostgreSQL does not, so a query that passes on `memdb:` and fails on `memdb-ansi:` is leaning on
// SQLite and will break when it meets Postgres. Finding that costs a second local run instead of a
// container.
//
// Each case below is checked three ways: the lax engine, the strict engine, and real SQLite. The
// lax column must match SQLite -- that is what makes `memdb:` a usable stand-in -- and the strict
// column must differ, which is what makes `memdb-ansi:` worth running.
use datasource
use db
use memdb
use sqlite

val drivers = datasource.registry([memdb.driver(), memdb.strict_driver(), sqlite.driver()])

fn answer(conn: datasource.Connection, sql: string) -> string {
    return switch datasource.query(conn, sql) {
        Ok(rows) {
            val out = mutable_string_new()
            append(out, format("{} row(s)", prelude.len(rows)))
            for r in rows {
                append(out, " |")
                for i in 0..prelude.len(r.columns) {
                    append(out, format(" {}", r.values[i]))
                }
            }
            snapshot(out)
        }
        Err(e) { concat("refused: ", db.db_error_message(e)) }
    }
}

fn seed(url: string) -> datasource.Connection {
    val c = unwrap(datasource.open(drivers, url))
    unwrap(datasource.execute(c, "CREATE TABLE t (id INTEGER, name TEXT, n INTEGER)"))
    // Two tables with keys, for the constraint divergences. Written to by the cases below and read
    // by nothing, so what the two readings do to them cannot reach the shared list.
    unwrap(datasource.execute(c, "CREATE TABLE keyed (id INTEGER PRIMARY KEY, v TEXT)"))
    unwrap(datasource.execute(c, "CREATE TABLE widen (a INTEGER)"))
    for stmt in [
        "INSERT INTO t (id, name, n) VALUES (1, 'Ada', 10)",
        "INSERT INTO t (id, name, n) VALUES (2, 'ada', 0)",
        "INSERT INTO t (id, name, n) VALUES (3, 'Bob', 5)"
    ] {
        unwrap(datasource.execute(c, stmt))
    }
    return c
}

fn main() {
    val lax = seed("memdb:")
    val strict = seed("memdb-ansi:")
    val lite = seed("sqlite::memory:")

    // Each: the query, and why the two readings differ.
    val cases: [[string]] = [
        ["SELECT id FROM t WHERE name LIKE 'A%' ORDER BY id",
            "LIKE: SQLite folds ASCII case, the standard and PostgreSQL compare by collation"],
        ["SELECT id FROM t WHERE name LIKE 'a%' ORDER BY id",
            "the same pattern the other way round"],
        ["SELECT 1 / 0 AS boom",
            "division by zero: SQLite answers NULL, the standard makes it an error (22012)"],
        ["SELECT n / (n - n) AS boom FROM t WHERE id = 1",
            "the same, reached through columns rather than literals"],
        ["SELECT id FROM t WHERE name = 1 ORDER BY id",
            "number against text: SQLite orders by a type rank and matches nothing, the standard refuses"],
        ["SELECT id FROM t WHERE n > 'x' ORDER BY id",
            "the same comparison the other way round"],
        [
            "SELECT id = 1 AS yes FROM t ORDER BY id",
            "a boolean in a select list: SQLite has no boolean type and answers 0 or 1, while the standard and PostgreSQL answer one"
        ],
        [
            "SELECT n IS NULL AS unknown FROM t ORDER BY id",
            "the same, reached through a predicate rather than a comparison"
        ],
        [
            "DELETE FROM t WHERE id = 999 RETURNING t.*",
            "a qualified star in a RETURNING clause: SQLite refuses it outright and PostgreSQL answers it, so here the usual direction is reversed -- what fails on the lax reading and passes on the strict one is PostgreSQL-only SQL that will break on SQLite. Chosen to match no rows, so neither connection's data moves"
        ],
        [
            "UPDATE t SET n = n WHERE id = 999 RETURNING t.*, t.id",
            "the same, on an UPDATE, and again matching nothing"
        ],
        [
            "SELECT id FROM t UNION SELECT n FROM t INTERSECT SELECT n FROM t ORDER BY 1",
            "**how a compound query groups**: SQLite reads UNION, INTERSECT and EXCEPT strictly left to right, while the standard and PostgreSQL bind INTERSECT tighter than the other two -- so this one query is two different queries depending on the engine, and nothing in its text says which"
        ],
        [
            "SELECT id FROM t INTERSECT ALL SELECT id FROM t ORDER BY 1",
            "INTERSECT ALL: SQLite has no such syntax at all, PostgreSQL keeps a row as many times as it appears in the side it appears in least"
        ],
        [
            "SELECT id FROM t EXCEPT ALL SELECT n FROM t ORDER BY 1",
            "EXCEPT ALL, likewise absent from SQLite: it removes one occurrence per occurrence on the right"
        ],
        [
            "INSERT INTO keyed (id, v) VALUES (NULL, 'x')",
            "**a NULL in a PRIMARY KEY**: the standard and PostgreSQL make a key implicitly NOT NULL, while SQLite allows it -- and for a single-column INTEGER PRIMARY KEY, which is its rowid, fills in the next value instead. So the lax reading answers a row and the strict one refuses the write"
        ],
        [
            "ALTER TABLE widen ADD COLUMN u TEXT UNIQUE",
            "adding a UNIQUE column: SQLite refuses it outright because it does not rewrite the rows already there, where PostgreSQL rewrites and accepts. (Adding a NOT NULL column with no default is refused by both when the table has rows, so it is not a divergence)"
        ],
        [
            "ALTER TABLE t ADD CONSTRAINT k UNIQUE (id)",
            "ALTER TABLE ... ADD CONSTRAINT is standard SQL that SQLite does not have at all. The strict reading accepts it and records it nowhere, which is what it already does with a CREATE TABLE's constraints -- this engine enforces none. Nothing observable changes on either connection, which is why it is safe to run here"
        ],
        [
            "SELECT id FROM t UNION DISTINCT SELECT n FROM t ORDER BY 1",
            "UNION DISTINCT, which is what a bare UNION means and which SQLite nonetheless refuses -- the word is why `SetOp` keeps the quantifier it was written with instead of a flag"
        ]
    ]

    var agreed_with_sqlite = 0
    var diverged = 0
    for c in cases {
        val sql = c[0]
        val a = answer(lax, sql)
        val b = answer(strict, sql)
        val l = answer(lite, sql)
        print(concat("-- ", c[1]))
        print(concat("   ", sql))
        print(concat("   lax:    ", a))
        print(concat("   ansi:   ", b))
        print(concat("   sqlite: ", l))
        if a == l {
            agreed_with_sqlite = agreed_with_sqlite + 1
        } else {
            print("   !! the lax engine no longer matches SQLite")
        }
        if a != b {
            diverged = diverged + 1
        } else {
            print("   !! the strict engine no longer differs, so it is checking nothing")
        }
    }
    print(format("lax matches sqlite on {} of {}", agreed_with_sqlite, prelude.len(cases)))
    print(format("ansi differs from lax on {} of {}", diverged, prelude.len(cases)))

    // The two readings are the *only* difference: everything else must still agree, or the flag
    // has grown into a second engine by accident.
    print("-- the two readings agree on everything else --")
    var same = 0
    val shared: [string] = [
        "SELECT count(*) AS c FROM t",
        "SELECT count(n) AS c FROM t",
        "SELECT sum(n) AS s, min(n) AS lo, max(n) AS hi FROM t",
        "SELECT name, count(*) AS c FROM t GROUP BY name ORDER BY name",
        "SELECT id FROM t WHERE n IS NOT NULL AND n > 1 ORDER BY id",
        "SELECT id FROM t WHERE id IN (1, 3) ORDER BY id",
        "SELECT id FROM t WHERE n BETWEEN 1 AND 9 ORDER BY id",
        "SELECT substr(name, 1, 2) AS head FROM t ORDER BY id",
        "SELECT name || '!' AS shout FROM t ORDER BY id",
        "SELECT CASE WHEN n > 6 THEN 'big' ELSE 'small' END AS band FROM t ORDER BY id",
        "SELECT 7 / 2 AS half",
        "SELECT id FROM t WHERE nope = 1",
        "SELECT DISTINCT name FROM t ORDER BY name",
        "SELECT count(DISTINCT name) AS c FROM t",
        "SELECT CAST(n AS TEXT) AS t FROM t ORDER BY id",
        "SELECT a.id, b.id AS other FROM t AS a JOIN t AS b ON b.n = a.n ORDER BY a.id, b.id",
        "SELECT a.id FROM t AS a LEFT JOIN t AS b ON b.id = a.id + 10 ORDER BY a.id",
        "SELECT id FROM t WHERE id IN (SELECT id FROM t WHERE n > 1) ORDER BY id",
        "SELECT id FROM t WHERE EXISTS (SELECT 1 FROM t AS u WHERE u.n = t.n) ORDER BY id",
        "SELECT (SELECT max(n) FROM t) AS most",
        "SELECT id FROM t UNION SELECT n FROM t ORDER BY 1",
        "SELECT id FROM t UNION ALL SELECT n FROM t ORDER BY 1",
        "SELECT id FROM t INTERSECT SELECT n FROM t ORDER BY 1",
        "SELECT id FROM t EXCEPT SELECT n FROM t ORDER BY 1",
        "SELECT id AS k FROM t UNION SELECT n FROM t ORDER BY k DESC",
        "SELECT id FROM t UNION SELECT n FROM t ORDER BY 1 LIMIT 2 OFFSET 1",
        "SELECT id, name FROM t UNION SELECT n FROM t",
        "SELECT id FROM t UNION SELECT n FROM t ORDER BY 7",
        // `RETURNING` is **not** ANSI SQL -- the standard's form is a data change delta table,
        // `SELECT * FROM FINAL TABLE (INSERT ..)` -- and the strict reading runs it anyway. That is
        // deliberate: whether a connection has `RETURNING` is a question about the engine, which
        // `datasource.dialect` answers, and not about which reading of SQL's semantics is in force.
        // Refusing it here would fail every write in the sample application on a flag whose job is
        // to find SQL that leans on SQLite.
        "INSERT INTO t (id, name, n) VALUES (4, 'Dee', 1) RETURNING *",
        "UPDATE t SET n = n + 1 WHERE id = 4 RETURNING id, n",
        "DELETE FROM t WHERE id = 4 RETURNING id AS gone"
    ]
    for sql in shared {
        if answer(lax, sql) == answer(strict, sql) {
            same = same + 1
        } else {
            print(concat("   !! differ: ", sql))
            print(concat("      lax:  ", answer(lax, sql)))
            print(concat("      ansi: ", answer(strict, sql)))
        }
    }
    print(format("the two readings agree on {} of {}", same, prelude.len(shared)))

    datasource.close(lax)
    datasource.close(strict)
    datasource.close(lite)
}
