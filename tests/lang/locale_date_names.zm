// Month and day names from the host's locale data: `MMM`, `MMMM`, `EEE`, `EEEE`.
//
// **One compiled pattern renders in any language.** A `DateTimeFormat` carries no locale -- that is
// the point of compiling it once -- so the locale goes to the call that produces or reads a string,
// and the form without one uses `locale.default()`.
//
// Four things worth pinning:
//
//   * the `M` and `E` run lengths are matched longest-first, so `MMMM` is one token and not `MM`
//     twice, and `EEEEE` is `EEEE` plus a literal `E`;
//   * a parsed day name is **checked against the date**, because this library refuses 31 February
//     and accepting `Pazar, 23 Ekim 2026` for a Friday would be the looser of two inconsistent
//     answers -- and the complaint is in the reader's own language;
//   * **no name token has a fixed width**, since `ja_JP` abbreviates January as `1月` and `ar_SA`
//     as `يناير`, so `DateTimeFormat.width` is -1 for any pattern holding one;
//   * parsing folds case under the pattern's locale, not the invariant one: matching a Turkish name
//     is a Turkish question.
use locale
use time

fn main() {
    val d = unwrap(time.localdate_of(2026, 10, 23))
    val full = time.datetime_format_of("EEEE, dd MMMM yyyy")
    val short = time.datetime_format_of("EEE dd MMM yyyy")

    print("-- one pattern, six languages --")
    for tag in ["C", "en", "tr", "de", "ja", "sv"] {
        printf("  {} {}\n", tag, time.format(d, full, locale.of(tag)))
    }
    print("-- abbreviated --")
    for tag in ["en", "tr", "de", "ja", "sv"] {
        printf("  {} {}\n", tag, time.format(d, short, locale.of(tag)))
    }

    print("-- round trips, each in its own language --")
    for tag in ["en", "tr", "de", "sv"] {
        val l = locale.of(tag)
        val text = time.format(d, full, l)
        switch time.parse_localdate(text, full, l) {
            Ok(back) { printf("  {} round trip {}\n", tag, back == d) }
            Err(e) { printf("  {} ERR {}\n", tag, e) }
        }
    }

    // **Folded under the pattern's locale, which is the whole point.** `EKİM` with a dotted capital
    // matches `Ekim`, because that is Turkish's uppercase of it. `EKIM` with a dotless `I` does
    // not, and should not: the dotless `I` lowercases to `ı`, a different letter, so `EKIM` is a
    // different word. Folding these under the invariant locale would accept both and be wrong
    // about the language.
    print("-- case folds under the pattern's locale --")
    val tr = locale.of("tr")
    for text in ["23 Ekim 2026", "23 EKİM 2026", "23 ekim 2026", "23 EKIM 2026"] {
        switch time.parse_localdate(text, time.datetime_format_of("dd MMMM yyyy"), tr) {
            Ok(back) { printf("  [{}] -> {}\n", text, time.format(back)) }
            Err(e) { printf("  [{}] -> ERR {}\n", text, e) }
        }
    }

    print("-- a day name is checked against the date --")
    for text in ["Cuma, 23 Ekim 2026", "Pazar, 23 Ekim 2026", "Hiçbir, 23 Ekim 2026"] {
        switch time.parse_localdate(text, full, tr) {
            Ok(back) { printf("  [{}] -> {}\n", text, time.format(back)) }
            Err(e) { printf("  [{}] -> ERR {}\n", text, e) }
        }
    }

    print("-- the run-length dispatch --")
    for pat in ["EEE", "EEEE", "EEEEE", "MMM", "MMMM", "EEE EEE"] {
        val f = time.datetime_format_of(pat)
        printf("  {} -> [{}] width={}\n", pat, time.format(d, f, locale.of("en")), f.width)
    }

    print("-- width: real without a name, -1 with one --")
    printf("  yyyy-MM-dd         {}\n", time.datetime_format_of("yyyy-MM-dd").width)
    printf("  EEEE, dd MMMM yyyy {}\n", full.width)

    print("-- the default governs the form without a locale --")
    printf("  default=root {}\n", time.format(d, full))
    locale.set_default(tr)
    printf("  default=tr   {}\n", time.format(d, full))
    locale.set_default(locale.root())

    print("-- an instant, whose calendar part has no precomputed width --")
    val i = unwrap(time.parse_instant("2026-09-24T12:00:00Z"))
    val off = unwrap(time.zoneoffset_of_hours_minutes(2, 0))
    val dtf = time.datetime_format_of("EEEE dd MMMM yyyy HH:mm:ss")
    for tag in ["en", "tr"] {
        val l = locale.of(tag)
        val text = time.format(i, off, dtf, l)
        switch time.parse_instant(text, dtf, l) {
            Ok(back) { printf("  {} [{}] round trip {}\n", tag, text, back == i) }
            Err(e) { printf("  {} [{}] ERR {}\n", tag, text, e) }
        }
    }
}
