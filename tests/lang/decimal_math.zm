use math

fn main() {
    // decimal_pow: exact repeated multiplication.
    print(math.pow(1.5d, 2))
    print(math.pow(2d, 10))
    print(math.pow(2.5d, 0))
    print(math.pow(0d, 5))

    // A scale-0 dividend divides down to a whole number (ordinary decimal_div behavior);
    // a scale-4 one keeps the fraction -- decimal_pow doesn't pick the scale, `/` does.
    print(1d / math.pow(2d, 3))
    print(1.0000d / math.pow(2d, 3))

    // decimal_floor/decimal_ceil: decimal_round's one-directional cousins.
    print(math.floor(1.29d, 1))
    print(math.ceil(1.21d, 1))
    print(math.floor(-1.21d, 1))
    print(math.ceil(-1.29d, 1))
    print(math.floor(2d, 0))
    print(math.ceil(2d, 0))
    print(math.floor(1.5d, 4))
    print(math.ceil(1.5d, 4))
}
