use bits

fn main() {
    var bs = bits.bitset_new()
    bs = bits.set(bs, 0)
    bs = bits.set(bs, 3)
    bs = bits.set(bs, 5)
    bs = bits.set(bs, 63)
    print(bits.format(bs))                   // {0, 3, 5, 63}
    print(bits.len(bs))                      // 4
    print(bits.bit_length(bs))               // 64
    print(bits.get(bs, 3))                   // true
    print(bits.get(bs, 4))                   // false
    print(bits.is_empty(bs))                 // false
    print(bits.is_empty(bits.bitset_new()))  // true

    bs = bits.remove(bs, 3)
    print(bits.format(bs))  // {0, 5, 63}
    bs = bits.flip(bs, 3)   // adds 3 back
    bs = bits.flip(bs, 0)   // removes 0
    print(bits.format(bs))  // {3, 5, 63}

    val a = bits.set(bits.set(bits.bitset_new(), 1), 2)  // {1, 2}
    val b = bits.set(bits.set(bits.bitset_new(), 2), 3)  // {2, 3}
    print(bits.format(bits.intersect(a, b)))             // {2}
    print(bits.format(bits.union(a, b)))                 // {1, 2, 3}
    print(bits.format(bits.xor(a, b)))                   // {1, 3}
    print(bits.format(bits.difference(a, b)))            // {1}

    print(bits.bitset_to_int(bits.bitset_of_int(42)))  // 42

    // The three members `Set<int>` has that the old bitwise-only API did not.
    val c = bits.set(bits.bitset_new(), 2)                                                       // {2}
    print(bits.is_subset(c, a))                                                                  // true
    print(bits.is_subset(a, c))                                                                  // false
    print(join(separator: ",", pieces: map(bits.to_array(a), fn(i: int) -> string { str(i) })))  // 1,2
    print(prelude.len(bits.to_array(bits.bitset_new())))                                         // 0

    // `union`/`intersect` are variadic, the same shape the prelude's own are.
    print(bits.format(bits.union(a, b, c)))      // {1, 2, 3}
    print(bits.format(bits.intersect(a, b, c)))  // {2}

    // The complement within 0..63: 64 members minus this set's two.
    print(bits.len(bits.not(a)))                         // 62
    print(bits.bit_length(bits.not(bits.bitset_new())))  // 64
}
