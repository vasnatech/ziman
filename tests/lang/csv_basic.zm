use csv
use json

fn main() {
    val text = "name,age,note,ok\nAda,36,\"likes \"\"math\"\", tea\",true\r\nBob,007,,false\n\n\"Cy\nZ\",-1.5,x,\n"
    print(csv.parse_rows(text))
    val j = unwrap(csv.parse(text))
    print(json.json_to_string(j))
    val t = unwrap(csv.parse_typed(text))
    print(json.json_to_string(t))
    print(csv.format(t))
    print(unwrap_err(csv.parse("a,b\n1\n")))
    print(unwrap_err(csv.parse("a,a\n1,2\n")))
    print(unwrap_err(csv.parse("a\n\"open\n")))
    val nested = unwrap(json.parse_json("[{\"id\": 1, \"addr\": {\"city\": \"X\", \"zip\": \"01234\"}, \"tags\": null}, {\"id\": 2, \"extra\": \"a,b\"}]"))
    print(csv.format(nested))
    print(csv.format(unwrap(json.parse_json("[{\"a\": [1]}]"))))
    print(csv.parse_rows("a;b\n1;2\n", ";"))
}
