#![repository(Note)]

use datasource
use db.DbError
use eql
use memdb

#[derive(Row, Entity("notes"))]
pub struct Note {
    #[pk]
    id: int
    owner: int
    body: string
}

#[repository]
pub fn count_by_owner(conn: datasource.Connection, owner: int) -> Result<[Note], DbError>

fn main() {
    print(1)
}
