use time
use time.add_days
use time.add_hours
use time.add_months
use time.diff
use time.duration_of_seconds
use time.instant_compare
use time.instant_now
use time.instant_of
use time.localdate_of
use time.localdatetime_compare
use time.localdatetime_of
use time.localtime_of
use time.to_instant
use time.to_localdatetime
use time.zoneid_offset_at
use time.zoneid_utc
use time.zoneoffset_compare
use time.zoneoffset_of_hours_minutes
use time.zoneoffset_utc

fn main() {
    val dt = localdatetime_of(unwrap(localdate_of(2024, 12, 31)), unwrap(localtime_of(23, 30, 0, 0)))
    print(time.format(dt))
    print(time.format(add_hours(dt, 1)))
    print(time.format(add_days(dt, 1)))
    print(time.format(add_months(dt, 2)))

    val dt2 = localdatetime_of(unwrap(localdate_of(2025, 1, 1)), unwrap(localtime_of(0, 30, 0, 0)))
    print(localdatetime_compare(dt, dt2))
    print(time.format(diff(dt2, dt)))

    print(time.format(zoneoffset_utc()))
    val off = unwrap(zoneoffset_of_hours_minutes(-5, 0))
    print(time.format(off))
    val off2 = unwrap(zoneoffset_of_hours_minutes(5, 30))
    print(time.format(off2))
    print(zoneoffset_compare(off, off2))

    val i = to_instant(dt, zoneoffset_utc())
    print(time.format(i))
    val back = to_localdatetime(i, zoneoffset_utc())
    print(time.format(back))
    print(localdatetime_compare(dt, back))

    val i2 = time.add(i, duration_of_seconds(3600, 0))
    print(time.format(i2))
    print(time.format(diff(i2, i)))
    print(instant_compare(i, i2))

    val z = zoneid_utc()
    print(time.format(z))
    print(time.format(zoneid_offset_at(z, instant_of(0, 0))))

    val now = instant_now()
    print(byte_len(time.format(now)) > 0)

    val bad = zoneoffset_of_hours_minutes(-5, 30)
    print(is_ok(bad))
}
