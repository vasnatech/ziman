// `#[derive(Row)]`'s generator, written in Ziman and called as an ordinary function.
//
// The second generator ported out of `src/derive.c`, and the one that says whether templates pay
// at scale -- see docs/design/templates.md §14. The expected text is what the C emits today, byte
// for byte, which is also what `tools/check_template_examples.py` holds the worked examples in
// `lib/core/derive_row.zm` to.
//
// `Note` is the small case the file's own comments show. `Wide` is the one that matters: a
// `Uuid`, every scalar kind, an `Instant` (whose converters are spelled short) and three shapes
// of `Option` -- over a string, over a flat-named type, and over a user type.
use derive_row
use meta

fn f(name: string, t: meta.MetaType) -> meta.Member {
    return meta.Member { name: name, type: t, has_payload: false }
}

fn opt(t: meta.MetaType) -> meta.MetaType {
    return meta.generic("enum", "Option", [t])
}

fn decl(name: string, snake: string, members: [meta.Member]) -> meta.Decl {
    val none: [string] = []
    return meta.Decl { name: name, snake_name: snake, is_enum: false, type_params: none, members: members }
}

fn main() {
    print(unwrap(derive_row.generate(decl("Note", "note", [
        f("id", meta.scalar("int")),
        f("body", opt(meta.scalar("string")))
    ]))))
    print(unwrap(derive_row.generate(decl("Wide", "wide", [
        f("id", meta.named("struct", "Uuid")),
        f("count", meta.scalar("int")),
        f("ratio", meta.scalar("float")),
        f("ok", meta.scalar("bool")),
        f("label", meta.scalar("string")),
        f("amount", meta.scalar("decimal")),
        f("at", meta.named("struct", "Instant")),
        f("note", opt(meta.scalar("string"))),
        f("seen_at", opt(meta.named("struct", "Instant"))),
        f("owner", opt(meta.named("struct", "Uuid")))
    ]))))
}
