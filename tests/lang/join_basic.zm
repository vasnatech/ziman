fn main() {
    // Everything omitted (prefix/suffix/separator all default to None)
    // -- the same plain-concatenation behavior join always had.
    val empty: [string] = []
    print(join(pieces: empty))
    print(join(pieces: ["hello"]))
    print(join(pieces: ["Hello, ", "world", "!"]))

    val pieces: [string] = ["a", "b", "c", "d"]
    print(join(pieces: pieces))

    // Individual elements, not an array -- a named call's variadic slot
    // only ever accepts one value, so this needs a fully positional
    // call (every Option<string> spelled out) instead.
    print(join(Option<string>.None, Option<string>.None, Option<string>.None, "Hello, ", "world", "!"))

    // separator alone, then prefix+suffix+separator together, both as
    // bare strings (auto-wrapped to Some(...)).
    print(join(separator: ", ", pieces: pieces))
    print(join(prefix: "[", suffix: "]", separator: ", ", pieces: pieces))

    // Large enough to actually exercise the single-pass buffer, not
    // just the trivial cases above -- with and without prefix/suffix/
    // separator, since both paths sum lengths differently.
    var big: [string] = []
    var i = 0
    while i < 2000 {
        big = push(big, str(i))
        i = i + 1
    }
    print(byte_len(join(pieces: big)))
    print(byte_len(join(prefix: "[", suffix: "]", separator: ",", pieces: big)))

    // ---- a builder of pieces, which a variadic cannot take
    //
    // **`join` has a second declaration for a `MutableArray`**, because a variadic accepts a scalar
    // or an immutable array and nothing else -- and teaching variadics to take a builder would mean
    // materialising it at the call boundary, since a callee holds its tail as a `[T]` value it may
    // store. A builtin walks the builder and returns a string, retaining nothing, so this form
    // copies nothing where `pieces: snapshot(parts)` copied the whole array (F279).
    val parts = mutable_array_new<string>()
    push(parts, "a")
    push(parts, "b")
    push(parts, "c")
    print(join(separator: ",", pieces: parts))
    print(join(prefix: "<", suffix: ">", separator: " ", pieces: parts))
    // Both forms of the same content agree.
    print(join(separator: ",", pieces: parts) == join(separator: ",", pieces: snapshot(parts)))
    // Empty, which has no separator to place.
    print(concat("[", join(separator: ",", pieces: mutable_array_new<string>()), "]"))

    // **The answer does not alias the builder.** The string is finished when it is returned, so
    // growing the builder afterwards must not change what was already answered -- which is the
    // property that makes reading the buffer in place safe for a builtin and unsafe for a general
    // variadic.
    val answered = join(separator: ",", pieces: parts)
    push(parts, "d")
    print(answered)
    print(join(separator: ",", pieces: parts))
}
