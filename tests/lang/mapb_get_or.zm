// `Map` has `get_or`; `MutableMap` had only `get`, so every counting loop wrote the switch out.
// Added as ordinary Ziman rather than a builtin, because it is exactly that switch and nothing more.
fn main() {
    val counts = mutable_map_new<string, int>()
    for w in ["a", "b", "a", "c", "a"] {
        set<string, int>(counts, w, get_or(counts, w, 0) + 1)
    }
    print(get_or(counts, "a", 0))
    print(get_or(counts, "b", 0))
    print(get_or(counts, "missing", -1))
    print(len(counts))

    // the type arguments are inferred from the builder, as for any generic function
    val flags = mutable_map_new<int, bool>()
    set<int, bool>(flags, 1, true)
    print(get_or(flags, 1, false))
    print(get_or(flags, 2, false))
}
