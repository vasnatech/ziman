use json.Json
use json.Number
use json.parse
use json.require
use json.require_string

fn main() {
    val j = unwrap(parse("{\"name\": \"Ada\", \"age\": 42}"))

    print(unwrap(require_string(j, "name")))
    print(is_ok(require_string(j, "missing")))
    print(unwrap_err(require_string(j, "missing")))
    print(is_ok(require_string(j, "age")))
    print(unwrap_err(require_string(j, "age")))

    val age_json = unwrap(require(j, "age"))
    print(Number.is_Int(Json.unwrap_JNumber(age_json)))
}
