
struct Item {
    name: string
    qty: int
}

fn qty(i: Item) -> int {
    return i.qty
}

fn name_of(i: Item) -> string {
    return i.name
}

fn expand(n: int) -> [int] {
    if n == 2 {
        return []
    }
    return [n, n * 10]
}

fn main() {
    val sorted = [1, 3, 3, 3, 5, 8]
    print(lower_bound<int>(sorted, 3))
    print(upper_bound<int>(sorted, 3))
    print(lower_bound<int>(sorted, 0))
    print(lower_bound<int>(sorted, 9))
    print(upper_bound<int>(sorted, 4))
    print(binary_search<int>(sorted, 3))
    print(binary_search<int>(sorted, 4))
    print(binary_search<string>(["a", "c", "e"], "c"))

    val items = [Item { name: "pen", qty: 3 }, Item { name: "cup", qty: 9 }, Item { name: "ink", qty: 3 }]
    print(first<Item>(items))
    print(last<int>([1, 2, 3]))
    print(first<int>([]))
    print(min_by<Item, int>(items, qty))
    print(max_by<Item, int>(items, qty))
    print(min_by<Item, string>(items, name_of))
    print(max_by<int, int>([], fn(x) { x }))

    print(count<int>([1, 2, 3, 4, 5], fn(n) { n % 2 == 1 }))
    print(flat_map<int, int>([1, 2, 3], expand))
    print(distinct<int>([3, 1, 3, 2, 1]))
    print(distinct<string>(["b", "a", "b"]))
    print(group_by<Item, int>(items, qty))
    print(len(group_by<int, int>([], fn(x) { x })))

    // map / filter / flat_map / reverse keep packed element kinds and handle empty arrays
    print(map<int, float>([1, 2, 3], fn(x) { x as float / 2.0 }))
    print(map<int, bool>([1, 2, 3], fn(x) { x > 1 }))
    print(map<int, string>([1, 2], fn(x) { concat("n", str(x)) }))
    print(map<string, int>(["a", "bcd"], fn(s) { byte_len(s) }))
    print(filter([0.5, 1.5, 2.5], fn(x) { x > 1.0 }))
    print(filter(["a", "bb", "c"], fn(s) { byte_len(s) == 1 }))
    print(filter([1, 2, 3], fn(x) { x > 9 }))
    print(reverse(["a", "b", "c"]))
    print(reverse([1b, 2b, 3b]))
    // `reverse<int>([])` is not spellable now that `reverse` is a builtin: a builtin discards
    // explicit type arguments, so the empty literal has nothing to infer from and needs a typed
    // binding instead. The same rule SYNTAX.md already states for an empty literal in a variadic.
    val no_ints: [int] = []
    print(reverse(no_ints))
    print(map<int, int>([], fn(x) { x }))
    print(flat_map<int, string>([1, 2], fn(x) { ["a", "b"] }))
    print(flat_map<int, int>([], expand))

    // the native scalar sort and the generic merge sort agree, ties included
    print(sort([5, -2, 9, 5, 0]))
    print(sort_desc([5, -2, 9, 5, 0]))
    print(sort([2.5, -1.0, 0.0, 9.75]))
    print(sort(["pear", "fig", "apple", "fig", ""]))
    print(sort([200b, 3b, 90b]))
    // The permutation primitive both `sort_by` forms are built on used to be called directly
    // here, in both directions with ties. It is unreachable from program code as of 2026-10-22 --
    // `array_order_of` is the prelude's one non-`pub` declaration and a fixture is program code --
    // so what it proved is proved through its only consumers instead: the two `sort_by` calls
    // below are ties in both directions, and stability is the property that would break first.
    print(sort_by<string, int>(["ccc", "a", "dd", "b"], fn(s: string) -> int { return byte_len(s) }))
    print(sort_by_desc<string, int>(["ccc", "a", "dd", "b"], fn(s: string) -> int { return byte_len(s) }))
    var big: [int] = []
    for i in 0..300 {
        big = push(big, (i * 7919) % 101)
    }
    val fast = sort(big)
    val generic = sort_with(big, fn(a, b) { compare(a, b) })
    print(fast == generic)
    print(is_sorted<int>(fast))
    print(sort_desc(big) == reverse(fast))
    print(sort(no_ints))
    print(sort([7]))
}
