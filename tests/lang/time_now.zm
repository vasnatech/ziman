use time

fn main() {
    val utc = time.zoneoffset_utc()
    val plus5 = unwrap(time.zoneoffset_of_hours_minutes(5, 0))

    // the "now" helpers read the same clock as instant_now, shifted by the offset
    val before = time.instant_now()
    val dt = time.localdatetime_now(utc)
    val after = time.instant_now()
    val at = time.to_instant(dt, utc)
    print(time.instant_compare(at, time.add(before, time.duration_of_seconds(-1, 0))) >= 0)
    print(time.instant_compare(at, time.add(after, time.duration_of_seconds(1, 0))) <= 0)

    // a clock five hours ahead is the same instant
    val ahead = time.localdatetime_now(plus5)
    val ahead_at = time.to_instant(ahead, plus5)
    val gap = time.diff(ahead_at, at)
    print(gap.seconds >= -1 && gap.seconds <= 1)

    // the date and time helpers are the two halves of the same reading
    val d = time.localdate_now(utc)
    val t = time.localtime_now(utc)
    print(time.localdate_compare(d, dt.date) >= 0 && time.localdate_compare(d, dt.date) <= 1)
    print(t.hour >= 0 && t.hour <= 23 && t.minute >= 0 && t.minute <= 59)
}
