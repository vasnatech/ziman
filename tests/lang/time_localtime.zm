use time
use time.localtime_of
use time.add_hours
use time.add_minutes
use time.add_seconds
use time.add_nanos
use time.diff_nanos
use time.localtime_compare

fn main() {
    val t = unwrap(localtime_of(23, 59, 59, 0))
    print(time.format(t))
    print(time.format(add_seconds(t, 1)))
    print(time.format(add_hours(t, 1)))
    print(time.format(add_minutes(t, 1)))

    val t2 = unwrap(localtime_of(0, 0, 0, 500000000))
    print(time.format(t2))
    print(time.format(add_nanos(t2, 500000000)))

    val t3 = unwrap(localtime_of(1, 0, 0, 0))
    print(time.format(add_hours(t3, -2)))

    print(diff_nanos(t3, unwrap(localtime_of(0, 0, 0, 0))))
    print(localtime_compare(t3, t2))
    print(localtime_compare(t2, t3))

    val bad = localtime_of(24, 0, 0, 0)
    print(is_ok(bad))
}
