// `memdb` and `sqlite` given the same schema, the same data and the same queries, with their
// answers compared row by row.
//
// **This is the test that makes a second SQL engine safe to own.** A test suite that runs on
// `memdb` is only worth something if `memdb` answers what the real engine answers; a divergence
// has to be a failing test rather than a quiet difference nobody looks at. So this prints
// `agree` per query and nothing else -- the moment one of them disagrees, the recorded output
// changes and the suite fails.
//
// The divergences `memdb` already knows about are in its own header (no type affinity, NULLs
// first in ascending order, `LIKE` case-insensitive as SQLite has it, constraints recorded and
// not enforced). The queries below stay clear of them on purpose: this file is for catching the
// differences nobody has thought of yet.
use datasource
use db
use db.SqlValue
use memdb
use sqlite

val drivers = datasource.registry([memdb.driver(), sqlite.driver()])

// A schema and a dataset, as a test would keep them in schema.sql and data.sql.
val schema: [string] = [
    "CREATE TABLE patient (id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INTEGER, note TEXT)",
    "CREATE INDEX idx_patient_name ON patient (name)",
    "CREATE TABLE visit (id INTEGER PRIMARY KEY, patient_id INTEGER NOT NULL, reason TEXT, cost REAL)"
]

val data: [string] = [
    "INSERT INTO patient (id, name, age, note) VALUES (1, 'Ada', 36, 'first')",
    "INSERT INTO patient (id, name, age, note) VALUES (2, 'Bob', 41, NULL)",
    "INSERT INTO patient (id, name, age, note) VALUES (3, 'Cy', 29, 'third')",
    "INSERT INTO patient (id, name, age, note) VALUES (4, 'Dee', NULL, 'fourth')",
    "INSERT INTO visit (id, patient_id, reason, cost) VALUES (1, 1, 'checkup', 120.5)",
    "INSERT INTO visit (id, patient_id, reason, cost) VALUES (2, 1, 'follow up', 80.0)",
    "INSERT INTO visit (id, patient_id, reason, cost) VALUES (3, 2, 'checkup', 95.25)"
]

// Every query both engines must answer identically. Ordered wherever more than one row comes
// back, because neither engine promises an order without `ORDER BY` and a test that relied on
// one would be testing the implementation rather than the SQL.
val queries: [string] = [
    "SELECT id, name, age, note FROM patient ORDER BY id",
    "SELECT name FROM patient WHERE age > 30 ORDER BY name",
    "SELECT name FROM patient WHERE age IS NULL ORDER BY id",
    "SELECT name FROM patient WHERE age IS NOT NULL AND age < 40 ORDER BY id",
    "SELECT name, note FROM patient WHERE note IS NULL ORDER BY id",
    "SELECT name FROM patient ORDER BY name DESC",
    "SELECT name FROM patient ORDER BY name LIMIT 2",
    "SELECT name FROM patient ORDER BY name LIMIT 2 OFFSET 2",
    "SELECT id FROM patient WHERE id IN (1, 3) ORDER BY id",
    "SELECT id FROM patient WHERE id NOT IN (1, 3) ORDER BY id",
    "SELECT name FROM patient WHERE age BETWEEN 30 AND 40 ORDER BY id",
    "SELECT name FROM patient WHERE name LIKE 'A%' ORDER BY id",
    "SELECT name FROM patient WHERE name LIKE '_y' ORDER BY id",
    "SELECT name FROM patient WHERE note LIKE '%r%' ORDER BY id",
    "SELECT name, CASE WHEN age IS NULL THEN 'unknown' WHEN age > 40 THEN 'older' ELSE 'younger' END AS band FROM patient ORDER BY id",
    "SELECT id, age + 1 AS next, age * 2 AS doubled FROM patient WHERE age IS NOT NULL ORDER BY id",
    "SELECT name, length(name) AS n FROM patient ORDER BY id",
    "SELECT substr(name, 1, 2) AS head FROM patient ORDER BY id",
    "SELECT upper(name) AS up, lower(name) AS down FROM patient ORDER BY id",
    "SELECT coalesce(note, 'none') AS note FROM patient ORDER BY id",
    "SELECT name || '!' AS shout FROM patient ORDER BY id",
    "SELECT reason, cost FROM visit ORDER BY cost DESC",
    "SELECT patient_id FROM visit WHERE reason = 'checkup' ORDER BY id",
    // the three-valued logic a reader gets wrong before an engine does
    "SELECT id FROM patient WHERE age = NULL ORDER BY id",
    // SQL's precedence, which the sql module had wrong twice until the round-trip test caught it:
    // NOT is looser than a comparison, and IS NULL is looser than arithmetic
    "SELECT id FROM patient WHERE NOT age = 36 ORDER BY id",
    "SELECT id FROM patient WHERE NOT age > 30 ORDER BY id",
    "SELECT id, age + 0 IS NULL AS unknown FROM patient ORDER BY id",
    "SELECT id FROM patient WHERE NOT name LIKE 'A%' ORDER BY id",
    "SELECT id FROM patient WHERE NOT (age > 30 AND note IS NULL) ORDER BY id",
    "SELECT id FROM patient WHERE NOT (age > 30) ORDER BY id",
    "SELECT id FROM patient WHERE age > 30 OR note = 'fourth' ORDER BY id",
    // and integer division, which both engines truncate
    "SELECT 7 / 2 AS half",
    "SELECT 7.0 / 2 AS half",
    // the aggregates, whose NULL rules are the standard's and are the ones a reader guesses wrong
    "SELECT count(*) AS c FROM patient",
    "SELECT count(age) AS c FROM patient",
    "SELECT count(*) AS c FROM visit WHERE reason = 'nothing'",
    "SELECT count(age) AS c FROM visit WHERE reason = 'nothing'",
    "SELECT sum(cost) AS s FROM visit WHERE reason = 'nothing'",
    "SELECT min(age) AS lo, max(age) AS hi, sum(age) AS s FROM patient",
    "SELECT avg(age) AS a FROM patient",
    "SELECT sum(cost) AS s FROM visit",
    // grouping, including the NULL key that groups with itself although NULL = NULL is unknown
    "SELECT reason, count(*) AS c, sum(cost) AS s FROM visit GROUP BY reason ORDER BY reason",
    "SELECT patient_id, count(*) AS c FROM visit GROUP BY patient_id ORDER BY patient_id",
    "SELECT patient_id, count(*) AS c FROM visit GROUP BY patient_id HAVING count(*) > 1 ORDER BY patient_id",
    "SELECT note, count(*) AS c FROM patient GROUP BY note ORDER BY note",
    "SELECT reason, sum(cost) + 1 AS plus FROM visit GROUP BY reason ORDER BY reason",
    "SELECT patient_id, count(*) AS c FROM visit GROUP BY patient_id ORDER BY count(*) DESC, patient_id",
    // joins, where a column name may belong to either side
    "SELECT p.name, v.reason FROM patient AS p JOIN visit AS v ON v.patient_id = p.id ORDER BY v.id",
    "SELECT p.name, v.reason FROM patient AS p INNER JOIN visit AS v ON v.patient_id = p.id ORDER BY v.id",
    "SELECT p.name, v.reason FROM patient AS p LEFT JOIN visit AS v ON v.patient_id = p.id ORDER BY p.id, v.id",
    "SELECT count(*) AS c FROM patient CROSS JOIN visit",
    "SELECT p.name FROM patient AS p JOIN visit AS v ON v.patient_id = p.id WHERE v.cost > 100 ORDER BY p.id",
    "SELECT p.name, count(*) AS c, sum(v.cost) AS s FROM patient AS p JOIN visit AS v ON v.patient_id = p.id GROUP BY p.name ORDER BY p.name",
    "SELECT patient.name, visit.reason FROM patient JOIN visit ON visit.patient_id = patient.id ORDER BY visit.id",
    "SELECT * FROM patient AS p JOIN visit AS v ON v.patient_id = p.id ORDER BY v.id",
    "SELECT p.name, v.reason FROM patient AS p LEFT JOIN visit AS v ON v.patient_id = p.id AND v.reason = 'checkup' ORDER BY p.id, v.id",
    // a three-table chain, with the middle one joined twice
    "SELECT a.name, b.name AS other FROM patient AS a JOIN patient AS b ON b.id = a.id + 1 ORDER BY a.id",
    // subqueries: scalar, IN, EXISTS, correlated
    "SELECT name FROM patient WHERE id IN (SELECT patient_id FROM visit) ORDER BY id",
    "SELECT name FROM patient WHERE id NOT IN (SELECT patient_id FROM visit) ORDER BY id",
    "SELECT name FROM patient WHERE EXISTS (SELECT 1 FROM visit WHERE visit.patient_id = patient.id) ORDER BY id",
    "SELECT name FROM patient WHERE NOT EXISTS (SELECT 1 FROM visit WHERE visit.patient_id = patient.id) ORDER BY id",
    "SELECT name, (SELECT count(*) FROM visit WHERE visit.patient_id = patient.id) AS visits FROM patient ORDER BY id",
    "SELECT name FROM patient WHERE age > (SELECT avg(age) FROM patient) ORDER BY id",
    "SELECT (SELECT max(cost) FROM visit) AS most",
    "SELECT name FROM patient WHERE (SELECT count(*) FROM visit WHERE visit.patient_id = patient.id) > 1 ORDER BY id",
    // a subquery that answers no row at all, which is NULL rather than an error. `missing`
    // rather than `nothing` as the alias, because SQLite reserves NOTHING for `DO NOTHING` and
    // refuses it as a bare name -- a difference in the dialects' keyword lists, not in the engines.
    "SELECT (SELECT cost FROM visit WHERE id = 99) AS missing",
    // DISTINCT, after the projection and before the LIMIT
    "SELECT DISTINCT reason FROM visit ORDER BY reason",
    "SELECT DISTINCT patient_id FROM visit ORDER BY patient_id",
    "SELECT DISTINCT note FROM patient ORDER BY note",
    "SELECT DISTINCT reason FROM visit ORDER BY reason LIMIT 1",
    "SELECT count(DISTINCT patient_id) AS c FROM visit",
    "SELECT count(DISTINCT reason) AS c FROM visit",
    "SELECT count(DISTINCT note) AS c FROM patient",
    // CAST
    "SELECT CAST(age AS TEXT) AS t FROM patient ORDER BY id",
    "SELECT CAST('42' AS INTEGER) AS n",
    "SELECT CAST(cost AS INTEGER) AS whole FROM visit ORDER BY id",
    "SELECT CAST(age AS REAL) AS r FROM patient ORDER BY id",
    // a qualified star, which names one side of a join by the name the FROM gave it
    "SELECT p.* FROM patient AS p ORDER BY p.id",
    "SELECT patient.* FROM patient ORDER BY id",
    "SELECT p.*, v.* FROM patient AS p JOIN visit AS v ON v.patient_id = p.id ORDER BY v.id",
    "SELECT v.* FROM patient AS p JOIN visit AS v ON v.patient_id = p.id ORDER BY v.id",
    "SELECT v.*, p.name FROM patient AS p JOIN visit AS v ON v.patient_id = p.id ORDER BY v.id",
    "SELECT *, p.* FROM patient AS p ORDER BY p.id",
    "SELECT p.*, p.id FROM patient AS p ORDER BY p.id",
    "SELECT DISTINCT p.* FROM patient AS p ORDER BY p.id",
    "SELECT a.*, b.* FROM patient AS a JOIN patient AS b ON b.id = a.id ORDER BY a.id",
    "SELECT p.* FROM patient AS p LEFT JOIN visit AS v ON v.patient_id = p.id WHERE v.id IS NULL ORDER BY p.id",
    "SELECT p.name FROM patient AS p WHERE EXISTS (SELECT v.* FROM visit AS v WHERE v.patient_id = p.id) ORDER BY p.id",
    // an alias hides the table's own name, on both engines and on PostgreSQL
    "SELECT patient.* FROM patient AS p ORDER BY p.id",
    // and a qualifier naming no table at all
    "SELECT nope.* FROM patient",
    // and the column names a typo gives, which must be refused on both
    "SELECT nope FROM patient",
    "SELECT name FROM patient AS p JOIN visit AS v ON v.nope = p.id",
    "SELECT id FROM patient AS p JOIN visit AS v ON v.patient_id = p.id ORDER BY id"
]

// `RETURNING` is a write that answers rows, so these run through `query` rather than `execute` and
// are kept apart from the read-only list above: each one changes the table it reports on.
//
// SQLite has had `RETURNING` since 3.35 and the bundled driver reports 3.50, so this list is a
// real cross-check rather than a feature only one side has. MySQL has none at all, which is why
// the sample application asks `datasource.dialect` before using it.
val returning: [string] = [
    "INSERT INTO patient (id, name, age, note) VALUES (10, 'Eve', 50, 'tenth') RETURNING *",
    "INSERT INTO patient (id, name, age) VALUES (11, 'Fay', 22) RETURNING id",
    "INSERT INTO patient (id, name, age) VALUES (12, 'Gil', 23) RETURNING id, name",
    "INSERT INTO patient (id, name, age) VALUES (13, 'Hal', 24), (14, 'Ivy', 25) RETURNING id, age",
    "INSERT INTO patient (id, name, age) VALUES (15, 'Jo', 26) RETURNING id AS made, age * 2 AS twice",
    "INSERT INTO patient (id, name, age) VALUES (16, 'Kit', 27) RETURNING upper(name) AS up",
    // a `*` beside another item, which is what made the select list accept a star anywhere
    "INSERT INTO patient (id, name, age) VALUES (17, 'Lin', 28) RETURNING *, id",
    // the column `note` is not in the list, so its declared default (none, so NULL) comes back
    "INSERT INTO patient (id, name, age) VALUES (18, 'Max', 29) RETURNING id, note",
    // a typo in a RETURNING clause must be refused, not answered with NULL
    "INSERT INTO patient (id, name, age) VALUES (19, 'Ned', 30) RETURNING nope",
    // UPDATE returns the row as it now stands
    "UPDATE patient SET age = age + 1 WHERE id = 10 RETURNING *",
    "UPDATE patient SET note = 'edited' WHERE id = 11 RETURNING id, note",
    "UPDATE patient SET age = 0 WHERE id = 999 RETURNING id",
    "UPDATE patient SET note = 'all' WHERE age < 25 RETURNING id, note",
    // DELETE returns the row as it was, the only version of a deleted row there is
    "DELETE FROM patient WHERE id = 19 RETURNING *",
    "DELETE FROM patient WHERE id = 18 RETURNING id, name",
    "DELETE FROM patient WHERE id = 999 RETURNING id",
    "DELETE FROM patient WHERE age > 40 RETURNING id AS gone",
    // **SQLite refuses a qualified star in a RETURNING clause**, in those words, where PostgreSQL
    // answers it -- measured on postgres:17 rather than assumed. The SQLite-shaped reading refuses
    // it too; `memdb_ansi_strictness.zm` holds the other half, where the strict reading runs it.
    "INSERT INTO patient (id, name) VALUES (30, 'Pat') RETURNING patient.*",
    "UPDATE patient SET note = 'q' WHERE id = 1 RETURNING patient.*",
    "DELETE FROM patient WHERE id = 999 RETURNING patient.*",
    "INSERT INTO patient (id, name) VALUES (31, 'Quinn') RETURNING nope.*"
]

fn seed(url: string) -> datasource.Connection {
    val conn = unwrap(datasource.open(drivers, url))
    for statement in schema {
        unwrap(datasource.execute(conn, statement))
    }
    for statement in data {
        unwrap(datasource.execute(conn, statement))
    }
    return conn
}

// A result as one comparable string. `format`'s `{}` on a `SqlValue` prints its variant, so an
// `Int(1)` and a `Text(1)` can never compare equal by accident -- which is the point, since type
// affinity is one of the places the engines are allowed to differ and this test must notice.
fn rendered(conn: datasource.Connection, sql: string) -> string {
    return switch datasource.query(conn, sql) {
        Ok(rows) {
            val out = mutable_string_new()
            append(out, format("{} row(s)", prelude.len(rows)))
            for r in rows {
                append(out, " |")
                for i in 0..prelude.len(r.columns) {
                    append(out, format(" {}={}", r.columns[i], r.values[i]))
                }
            }
            snapshot(out)
        }
        Err(e) { concat("error: ", db.db_error_message(e)) }
    }
}

fn main() {
    val mem = seed("memdb:")
    val lite = seed("sqlite::memory:")
    print(format("engines: {} and {}", datasource.dialect(mem), datasource.dialect(lite)))

    var disagreements = 0
    for sql in queries {
        val a = rendered(mem, sql)
        val b = rendered(lite, sql)
        if a == b {
            print(concat("agree    ", sql))
        } else {
            disagreements = disagreements + 1
            print(concat("DISAGREE ", sql))
            print(concat("  memdb:  ", a))
            print(concat("  sqlite: ", b))
        }
    }
    print(format("{} of {} queries agree", prelude.len(queries) - disagreements, prelude.len(queries)))

    // Writes too: the same UPDATE and DELETE on both, then the same read back.
    print("-- writes --")
    for statement in ["UPDATE patient SET note = 'edited' WHERE id = 2", "DELETE FROM patient WHERE age IS NULL"] {
        val ma = unwrap(datasource.execute(mem, statement))
        val la = unwrap(datasource.execute(lite, statement))
        print(format("{} rows both: {}  <- {}", ma, ma == la, statement))
    }
    val after = "SELECT id, note FROM patient ORDER BY id"
    print(if rendered(mem, after) == rendered(lite, after) { "agree    after the writes" } else {
        concat("DISAGREE after the writes: ", rendered(mem, after), " vs ", rendered(lite, after))
    })

    // And a transaction rolled back on both.
    print("-- rollback --")
    for statement in ["BEGIN", "DELETE FROM patient", "ROLLBACK"] {
        unwrap(datasource.execute(mem, statement))
        unwrap(datasource.execute(lite, statement))
    }
    print(if rendered(mem, after) == rendered(lite, after) { "agree    after the rollback" } else {
        concat("DISAGREE after the rollback: ", rendered(mem, after), " vs ", rendered(lite, after))
    })

    // And the writes that answer rows. Last, because each changes the table it reports on.
    print("-- RETURNING --")
    var returning_disagreements = 0
    for sql in returning {
        val a = rendered(mem, sql)
        val b = rendered(lite, sql)
        if a == b {
            print(concat("agree    ", sql))
        } else {
            returning_disagreements = returning_disagreements + 1
            print(concat("DISAGREE ", sql))
            print(concat("  memdb:  ", a))
            print(concat("  sqlite: ", b))
        }
    }
    print(format(
        "{} of {} RETURNING statements agree",
        prelude.len(returning) - returning_disagreements,
        prelude.len(returning)
    ))
    // The shape the sample application actually issues, which is placeholders plus `RETURNING *`
    // read through `query_one` -- the rest of this file binds nothing, and a clause that worked
    // only with literals would pass every line above and fail in production.
    print("-- RETURNING with bound parameters, through query_one --")
    val insert = "INSERT INTO patient (id, name, age) VALUES ($1, $2, $3) RETURNING *"
    val bound: [SqlValue] = [SqlValue.Int(20), SqlValue.Text("Nan"), SqlValue.Int(31)]
    val one_mem = unwrap(datasource.query_one(mem, insert, bound))
    val one_lite = unwrap(datasource.query_one(lite, insert, bound))
    print(switch one_mem {
        Some(a) {
            switch one_lite {
                Some(b) {
                    if prelude.len(a.values) == prelude.len(b.values) && format("{}", a.values) == format(
                        "{}",
                        b.values
                    ) {
                        "agree    both engines handed back the row they stored"
                    } else {
                        format("DISAGREE {} vs {}", a.values, b.values)
                    }
                }
                None { "DISAGREE sqlite answered no row" }
            }
        }
        None { "DISAGREE memdb answered no row" }
    })
    // `execute` on a RETURNING statement still reports the affected count, because both read
    // `.affected` and `.rows` from one shared run.
    val changed_mem = unwrap(datasource.execute(
        mem,
        "UPDATE patient SET note = 'bound' WHERE id = $1 RETURNING id",
        [SqlValue.Int(20)]
    ))
    val changed_lite = unwrap(datasource.execute(
        lite,
        "UPDATE patient SET note = 'bound' WHERE id = $1 RETURNING id",
        [SqlValue.Int(20)]
    ))
    print(format("execute on a RETURNING update reports {} on both: {}", changed_mem, changed_mem == changed_lite))

    val left = "SELECT id, name, age, note FROM patient ORDER BY id"
    print(if rendered(mem, left) == rendered(lite, left) { "agree    what is left of the table" } else {
        concat("DISAGREE what is left: ", rendered(mem, left), " vs ", rendered(lite, left))
    })

    datasource.close(mem)
    datasource.close(lite)
}
