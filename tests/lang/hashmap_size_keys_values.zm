fn sum(xs: [int]) -> int {
    var total = 0
    for x in xs {
        total = total + x
    }
    return total
}

fn main() {
    var m = Map<string, int> {}
    print(len(m))

    m = set(m, "a", 1)
    m = set(m, "b", 2)
    m = set(m, "c", 3)
    print(len(m))
    print(sum(map_values(m)))
    print(len(map_keys(m)))

    m = set(m, "a", 10) // overwrite, not a new entry
    print(len(m))
    print(sum(map_values(m)))

    m = remove(m, "b")
    print(len(m))

    m = remove(m, "does-not-exist") // no-op
    print(len(m))
}
