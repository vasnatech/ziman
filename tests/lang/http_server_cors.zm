// CORS, generalised from the reference backend's own `route_cors`: every browser-facing server writes the
// same thirty lines. Two functions rather than one handler-wrapping closure, so it composes with `dispatch`,
// a hand-written router or anything else by sitting either side of it, and allocates nothing per request.
//
// `Vary=Origin` on every line but the wildcard is the point of F59, and this fixture is where the bug
// lived: it already printed every header, so its recorded output *was* the defect -- a test that locks a
// mistake in rather than one that misses it. The header matters because a shared cache without it may hand
// an allowed origin's `Access-Control-Allow-Origin` to a page that must not read the answer, or hand a
// cached refusal to an origin that should have been allowed. The wildcard line has none because that
// answer genuinely does not depend on the origin.
use http
use server
fn fault(status: int, message: string) -> http.Response {
    return server.response(status, to_bytes(message))
}
fn req_of(method: http.HttpMethod, headers: [http.Header]) -> http.Request {
    return http.Request {
        method: method,
        target: "/x",
        path: "/x",
        query: "",
        version: "HTTP/1.1",
        headers: headers,
        body: [],
        peer: None
    }
}
fn show(label: string, r: http.Response) {
    val out = mutable_array_new<string>()
    for h in r.headers { push(out, concat(h.name, "=", h.value)) }
    printf("{}: {} [{}]\n", label, r.status, join(separator: ", ", pieces: snapshot(out)))
}
fn main() {
    val policy = server.cors_policy(["https://app.example"])
    val inner = server.response(200, to_bytes("hi"))

    // a preflight from an allowed origin
    val pre = req_of(http.HttpMethod.Options, [
        http.Header { name: "Origin", value: "https://app.example" },
        http.Header { name: "Access-Control-Request-Method", value: "POST" }
    ])
    switch server.cors_preflight(policy, pre, fault) {
        Some(r) { show("preflight allowed", r) }
        None { print("preflight allowed: not a preflight") }
    }

    // a preflight from somewhere else
    val bad = req_of(http.HttpMethod.Options, [
        http.Header { name: "Origin", value: "https://evil.example" },
        http.Header { name: "Access-Control-Request-Method", value: "POST" }
    ])
    switch server.cors_preflight(policy, bad, fault) {
        Some(r) { show("preflight denied", r) }
        None { print("preflight denied: not a preflight") }
    }

    // an ordinary request is not a preflight
    val plain = req_of(http.HttpMethod.Get, [http.Header { name: "Origin", value: "https://app.example" }])
    printf("plain is preflight: {}\n", Option.is_Some(server.cors_preflight(policy, plain, fault)))
    show("allowed origin", server.cors_apply(policy, plain, inner))

    val other = req_of(http.HttpMethod.Get, [http.Header { name: "Origin", value: "https://evil.example" }])
    show("other origin", server.cors_apply(policy, other, inner))

    val none = req_of(http.HttpMethod.Get, [])
    show("no origin", server.cors_apply(policy, none, inner))

    // a wildcard policy echoes `*` and drops credentials
    val open_policy = server.cors_policy(["*"])
    show("wildcard", server.cors_apply(open_policy, other, inner))
}
