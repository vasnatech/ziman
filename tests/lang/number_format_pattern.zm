use number
use number.NumberFormat
use number.number_format_plain
use number.parse_pattern

fn main() {
    val fmt = parse_pattern("#,###.00")
    print(number.format("1234567.891", fmt))
    print(number.format("-1234567.891", fmt))
    print(number.format("5", fmt))
    print(number.format("1234567.891e+00", fmt))

    print(number.format(1234567, fmt))
    print(number.format(1234.5, fmt))
    print(number.format(123456789012345678901234567890n, fmt))
    print(number.format(42.5d, fmt))
    print(number.format(200b, fmt))

    print(number.format("42", number_format_plain()))

    val no_group = parse_pattern("0.0000")
    print(number.format("3.14", no_group))

    val euro: NumberFormat = NumberFormat {
        thousands_separator: ".",
        decimal_separator: ",",
        decimal_places: parse_pattern("#,###.00").decimal_places
    }
    print(number.format("1234567.891", euro))
    print(number.parse("1.234.567,89", euro))
}
