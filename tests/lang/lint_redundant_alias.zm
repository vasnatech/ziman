// `use x as x` is a line that does nothing: a whole-module import is already referenced by its path's
// last segment, and a per-name import already binds the imported name. There were 15 of these in the
// reference backend when the rule was added. A genuine rename is left alone, which is the half of this
// that matters -- a lint that fired on `use math as m` would be noise.
use bits as bits
use clock
use json.parse as parse
use math as m
use time.LocalDate as LocalDate

fn main() {
    print(str(m.sqrt(4.0)))
    print(str(bits.bitset_to_int(bits.bitset_new())))
    print(str(is_ok(parse("1"))))
    print(str(clock.monotonic_millis() >= 0))
    val d = LocalDate { year: 2026, month: 10, day: 7 }
    print(str(d.year))
}
