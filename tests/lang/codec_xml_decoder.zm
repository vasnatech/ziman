// **`Encoder`/`Decoder` is `T -> [byte]` and `[byte] -> T`, and XML is why that matters.**
//
// `codec.TreeFormat` is a shortcut for the four formats whose document is a `Json`-shaped tree.
// XML is not one: `xml.parse` answers a `Document` -- attributes, namespaces, element order --
// which no `Json` carries, and bending it into one would pick a convention and lose. So XML joins
// through the interface itself, with `codec.text_decoder`, and is a first-class member of it: the
// server negotiates on `Content-Type` exactly as it does for JSON, including the 415.
//
// **It now has a derived reader too** (2026-10-31): `#[derive(Xml)]` writes `order_to_xml` and
// `order_from_xml`, and `codec.xml_decoder`/`xml_encoder`/`xml_list_encoder` complete the
// interface for them. This fixture existed to show the cost of *not* having that -- it carried a
// hand-written `order_from_xml`, 12 lines of `xml.child` and `parse_int` -- and now shows the
// whole stack instead: a derived pair, negotiated on `Content-Type` and `Accept` like any other
// format, including the 415 for a body in a format the endpoint does not take.
use codec
use http
use mime
use rest
use server
use xml

#[derive(Xml)]
struct Order {
    #[xml(attribute: true)]
    id: int

    item: string
}

struct Ctx {
    name: string
}

fn failure(e: string) -> http.Response {
    return server.text_response(500, e)
}

fn fault(status: int, message: string) -> http.Response {
    return server.text_response(status, concat("fault: ", message))
}

fn handle(ctx: Ctx, o: Order) -> Result<Order, string> {
    return ok(o)
}

// A list answer, which is the one shape XML needs a name for that JSON does not: an array has no
// element of its own, so `xml_list_encoder` wraps each item's own root in one the caller names.
fn handle_list(ctx: Ctx) -> Result<[Order], string> {
    return ok([Order { id: 1, item: "desk" }, Order { id: 2, item: "lamp" }])
}

fn posted(content_type: string, body: string) -> http.Request {
    return http.request(
        http.method_parse("POST"),
        "/orders",
        [http.Header { name: "Content-Type", value: content_type }],
        to_bytes(body)
    )
}

fn getted(target: string) -> http.Request {
    return http.request(http.method_parse("GET"), target, [], to_bytes(""))
}

fn main() {
    val api = rest.Api<string> { failure: failure, fault: fault }
    val table = rest.routes<Ctx>([
        rest.Endpoint<Ctx> {
            method: http.HttpMethod.Post,
            pattern: "/orders",
            handler: rest.public_body_handler(
                decoders: [codec.xml_decoder<Order>(order_from_xml)],
                encoders: [codec.xml_encoder<Order>(order_to_xml)],
                run: handle,
                api: api
            )
        },
        rest.Endpoint<Ctx> {
            method: http.HttpMethod.Get,
            pattern: "/orders",
            handler: rest.public_handler(
                encoders: [codec.xml_list_encoder<Order>("orderList", order_to_xml)],
                run: handle_list,
                api: api
            )
        }
    ])
    val ctx = Ctx { name: "x" }
    // Three bodies: one the derived reader takes, one that is XML but not this model -- a 400
    // naming the attribute that is missing, which is what `#[derive(Xml)]`'s messages are for --
    // and one in a format this endpoint does not take at all, which never reaches the reader.
    for sent in [["application/xml", "<order id=\"7\"><item>desk</item></order>"],
        ["application/xml", "<order><item>desk</item></order>"],
        ["application/json", "{\"id\":7}"]] {
        val answer = rest.dispatch<Ctx>(table, ctx, posted(sent[0], sent[1]), fault)
        val text = switch bytes_to_string(answer.body) {
            Ok(t) { t }
            Err(_) { "<not text>" }
        }
        print(prelude.format("{}  ->  {} {}", sent[0], str(answer.status), text))
    }
    val listed = rest.dispatch<Ctx>(table, ctx, getted("/orders"), fault)
    print(switch bytes_to_string(listed.body) {
        Ok(t) { t }
        Err(_) { "<not text>" }
    })
    // XML is not a tree format, and saying so is the point.
    switch codec.tree_format_for(mime.application_xml()) {
        Some(_) { print("xml is a TreeFormat -- it should not be") }
        None { print("xml is not a TreeFormat, as intended") }
    }
}
