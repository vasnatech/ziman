use json

fn main() {
    val doc = "{\"name\": \"Ada\", \"tags\": [1, 2.5, true, null], \"note\": \"café \\u00e9\"}"
    print(json.format(unwrap(json.parse(to_bytes(doc)))))
    print(json.format(unwrap(json.parse(to_bytes(doc)))) == json.format(unwrap(json.parse(doc))))
    print(unwrap_err(json.parse(to_bytes("{\"a\": }"))))
    print(unwrap_err(json.parse(to_bytes("{\"a\":1} x"))))
    print(unwrap_err(json.parse([])))
    print(is_ok(json.parse_strict(to_bytes("{\"a\":1,\"b\":2}"))))
    print(unwrap_err(json.parse_strict(to_bytes("{\"a\":1,\"a\":2}"))))
    print(unwrap_err(json.parse([123b, 0b, 125b])))
}
