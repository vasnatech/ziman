// `abs`/`min`/`max` moved from the prelude to the `math` module on 2026-10-22, so these
// are `math.`-qualified and the fixture needs a `use`.
use math

fn main() {
    val max = 9223372036854775807
    val min = -max - 1
    print(max)
    print(min)
    print(max - 1 + 1)
    print(min + 1 - 1)
    print(max * 1)
    print(max / -1)
    print(min % -1)
    print(5 % -1)
    print(-(max))
    print(math.abs(min + 1))
    print(4611686018427387904 * 1)
    print(3037000499 * 3037000499)
}
