// Two readings of one name is a refusal, not a preference: `name_and_type` is a column *and*
// `name` and `type` are two columns, so `find_by_name_and_type` is genuinely two queries.
#![derive(Repository(Thing))]

use datasource
use db.DbError
use eql
use memdb

#[derive(Row, Entity("things"))]
pub struct Thing {
    #[pk]
    id: int
    name: string
    type: string
    name_and_type: string
}

#[derive(Repository)]
pub fn find_by_name_and_type(conn: datasource.Connection, name: string, type: string) -> Result<[Thing], DbError>

fn main() {
    print(1)
}
