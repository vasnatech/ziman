// `#![derive(Routes)]`, whose whole input is the `#[route(..)]`s on this module's own functions
// and what their signatures say. Run with `--emit-derived`, so the `.out` is the table it writes.
//
// The three routes are the three shapes that matter: a list, a create with a body and a 201, and a
// delete with a path id and a 204. Nothing below says which handler constructor to use, which
// decoder, which encoder, or what the JSON functions are called.
#![derive(Routes)]

use codec.csv_format
use codec.decoder_of
use codec.encoder_of
use codec.json_format
use codec.list_encoder_of
use codec.ndjson_format
use codec.xml_decoder
use codec.xml_encoder
use codec.xml_list_encoder
use codec.yaml_format
use derive_routes
use http
use model
use rest
use rest.uuid_param
use server
use uuid.Uuid
use wiring.Ctx
use wiring.Principal
use wiring.api
use wiring.authenticated

// `produces: "all"` is every format an array can be written as **from the type's JSON derive**, so
// one `Accept` header picks between JSON, YAML, NDJSON and CSV. XML is not in `"all"` on purpose --
// it needs `#[derive(Xml)]` too, so the word would otherwise demand a second derive of every type
// that used it -- and is named here beside it. Nothing else about the handler changes.
#[route(method: GET, path: "/api/orders", produces: "all, xml")]
pub fn handle_list(ctx: Ctx, who: Principal) -> Result<[model.OrderResponse], string> {
    return err("x")
}

// A body may arrive as any tree format or as XML, and the answer comes back as whichever is asked
// for. **XML passes no format to its builder**: it is not a `codec.TreeFormat`, so
// `xml_decoder(model.order_request_from_xml)` stands where
// `decoder_of(json_format(), model.order_request_from_json)` does.
#[route(method: POST, path: "/api/orders", status: 201, consumes: "json, yaml, xml", produces: "json yaml xml")]
pub fn handle_create(ctx: Ctx, who: Principal, data: model.OrderRequest) -> Result<model.OrderResponse, string> {
    return err("x")
}

// `label:` names the noun in a bad-id message; it defaults to the module's own name, which is
// `main` here and `order` is what it should say.
#[route(method: DELETE, path: "/api/orders/{id}", status: 204, label: "order")]
pub fn handle_delete(ctx: Ctx, who: Principal, id: Uuid) -> Result<unit, string> {
    return err("x")
}

fn main() {
    print(prelude.len(main_routes))
}
