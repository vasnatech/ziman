// Everything a generated endpoint names that the library cannot: the context type, the `Api` that
// says how this program's errors render, and the authorisation function a route names by `who:`.
//
// **In a module of its own, and imported**, which is the shape `#![derive(Routes)]` needs: a
// generated val is spliced *before* the routed module's own vals (src/derive.c), so a hand-written
// `val api` beside the handlers would not be in scope for the table. An import is in scope
// wherever it is written, which is also how an application with thirty controllers shares one.
use http
use server
use uuid.Uuid

pub struct Ctx {
    name: string
}

pub struct Principal {
    id: Uuid
}

fn failure(e: string) -> http.Response {
    return server.text_response(500, e)
}

fn fault(status: int, message: string) -> http.Response {
    return server.text_response(status, message)
}

pub val api: server.Api<string> = server.Api<string> { failure: failure, fault: fault }

pub fn authenticated(ctx: Ctx, req: http.Request) -> Result<Principal, server.Denied> {
    return server.Denied.Unauthenticated("no")
}
