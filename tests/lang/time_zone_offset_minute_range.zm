// `+05:99` used to parse as 5*3600 + 99*60 seconds, which is inside the +-18h total the range check
// looks at, so it was accepted -- and came back out of `format` as `+06:39`. A
// timestamp was stored at a different instant from the one the client wrote, with nothing reporting
// it. The minutes field is a field, not a count to be carried (D19).
use time

fn off(s: string) -> string {
    return switch time.parse_offset(s) {
        Ok(o) { time.format(o) }
        Err(e) { e }
    }
}

fn main() {
    for s in ["Z", "+00:00", "+05:30", "-05:30", "+18:00", "-18:00", "+05:59", "+05:60", "+05:99", "+19:00"] {
        print(format("{} -> {}", s, off(s)))
    }
}
