use time
use time.localdate_of
use time.add_days
use time.add_months
use time.add_years
use time.diff_days
use time.localdate_compare
use time.to_epoch_day
use time.localdate_from_epoch_day
use time.is_leap_year

fn main() {
    val d = unwrap(localdate_of(1970, 1, 1))
    print(time.format(d))
    print(to_epoch_day(d))

    val d2 = unwrap(localdate_of(2024, 2, 29))
    print(time.format(d2))
    print(is_leap_year(2024))
    print(is_leap_year(1900))
    print(is_leap_year(2000))

    val d3 = add_days(d2, 1)
    print(time.format(d3))

    val d4 = add_months(unwrap(localdate_of(2024, 1, 31)), 1)
    print(time.format(d4))

    val d5 = add_years(d2, 1)
    print(time.format(d5))

    print(diff_days(d3, d2))
    print(localdate_compare(d2, d3))
    print(localdate_compare(d3, d2))
    print(localdate_compare(d2, d2))

    print(time.format(localdate_from_epoch_day(0)))
    print(time.format(localdate_from_epoch_day(-1)))

    val bad = localdate_of(2023, 2, 29)
    print(is_ok(bad))
}
