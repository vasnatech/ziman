// `lib/ui/controls`: what an input does to a control.
//
// **These are the cases a rendered frame cannot show.** A button that fires when the user drags off
// it, a check box that clears a mixed state, a wheel event that goes to the focused list instead of
// the one under the pointer -- all three draw identically to the correct thing, every frame, and
// are only visible in what the state becomes.
use a11y
use controls
use focus
use geom
use locale
use paint
use scene
use shape
use test
use theme
use time
use widget
use widget.caret_name

fn metrics() -> widget.Metrics {
    return widget.metrics_of(
        fn(text: string, size: float) -> float { return (len(text) as float) * 10.0 },
        fn(size: float) -> float { return size * 2.0 }
    )
}

// A button's bounds, for the rules that need to know where it is.
val box = geom.rect_of(0.0, 0.0, 40.0, 20.0)

fn inside() -> geom.Point {
    return geom.point_of(10.0, 10.0)
}

fn outside() -> geom.Point {
    return geom.point_of(100.0, 10.0)
}

// Keys are named now rather than numbered -- `controls.Key.Left` where this used to say 65361 --
// which is the point of the control set owning its own vocabulary: a test reads as the gesture it
// describes, and a mistyped name is a compile error instead of a key that silently never arrives.
fn key(k: controls.Key) -> controls.Keystroke {
    return controls.keystroke_of(k)
}

val space = controls.Key.Space
val enter = controls.Key.Enter
val letter_a = controls.Key.Char("a")

fn press(b: controls.Button, p: geom.Point) -> controls.ButtonStep {
    return controls.button_input(b, controls.Input.Press(p), box)
}

fn release(b: controls.Button, p: geom.Point) -> controls.ButtonStep {
    return controls.button_input(b, controls.Input.Release(p), box)
}

// --- the button

#[test]
fn a_press_holds_it_and_a_release_inside_fires_it() {
    val held = press(controls.button_of("save", "Save"), inside())
    test.assert(held.button.held)
    test.assert_false(held.activated)

    val fired = release(held.button, inside())
    test.assert(fired.activated)
    test.assert_false(fired.button.held)
}

// **A press inside and a release outside does not fire**, which is every toolkit's behaviour and
// the reason `held` is state rather than the button simply reporting each click: a user who presses
// a button, thinks again and drags off it has cancelled, and a button that fired anyway would be
// the kind of defect a person does not report because they assume they misclicked.
#[test]
fn dragging_off_a_button_cancels_it() {
    val held = press(controls.button_of("save", "Save"), inside())
    val gone = release(held.button, outside())
    test.assert_false(gone.activated)
    test.assert_false(gone.button.held)
}

// And a release with no press before it fires nothing: a button under the pointer when the mouse
// comes up over it, having been pressed somewhere else, must not activate.
#[test]
fn a_release_without_a_press_fires_nothing() {
    val step = release(controls.button_of("save", "Save"), inside())
    test.assert_false(step.activated)
}

// A press that lands outside does not hold it either, which matters because `target` routes by hit
// test and a caller may still hand an input to the wrong control.
#[test]
fn a_press_outside_does_not_hold_it() {
    test.assert_false(press(controls.button_of("save", "Save"), outside()).button.held)
}

// **Space mirrors the pointer and Enter does not.** Space arms on the way down and fires on the way
// up, so it can be cancelled the way a drag can; Enter fires at once, because it is the key a
// default button answers and the user has already decided. Both are the platforms' own behaviour.
#[test]
fn space_fires_on_the_way_up_and_enter_on_the_way_down() {
    val b = controls.button_of("save", "Save")
    val armed = controls.button_input(b, controls.Input.KeyDown(key(space)), box)
    test.assert(armed.button.held)
    test.assert_false(armed.activated)
    test.assert(controls.button_input(armed.button, controls.Input.KeyUp(key(space)), box).activated)

    test.assert(controls.button_input(b, controls.Input.KeyDown(key(enter)), box).activated)
}

#[test]
fn an_ordinary_letter_does_nothing_to_a_button() {
    val b = controls.button_of("save", "Save")
    val step = controls.button_input(b, controls.Input.KeyDown(key(letter_a)), box)
    test.assert_false(step.activated)
    test.assert_false(step.button.held)
}

// A key up with nothing armed fires nothing -- the keyboard's version of a release without a press.
#[test]
fn a_space_release_with_nothing_armed_fires_nothing() {
    val b = controls.button_of("save", "Save")
    test.assert_false(controls.button_input(b, controls.Input.KeyUp(key(space)), box).activated)
}

// **A disabled button takes no input at all, and a disabled button is released.** The second half
// is the one worth a test: a button held down and then disabled must not still be held when it is
// enabled again, or it is drawn pressed by a frame nobody pressed.
#[test]
fn a_disabled_button_neither_fires_nor_stays_held() {
    val held = press(controls.button_of("save", "Save"), inside())
    val off = with held.button { disabled: true }
    val step = release(off, inside())
    test.assert_false(step.activated)
    test.assert_false(step.button.held)
    test.assert_false(press(off, inside()).button.held)
}

// --- the check box

fn click(c: controls.CheckBox) -> controls.CheckStep {
    val held = controls.check_box_input(c, controls.Input.Press(inside()), box)
    return controls.check_box_input(held.check_box, controls.Input.Release(inside()), box)
}

#[test]
fn a_click_toggles_an_unchecked_box_on_and_a_checked_box_off() {
    val off = controls.check_box_of("notify", "Notify me", widget.Toggle.Off)
    val on = click(off)
    test.assert(on.toggled)
    test.assert_eq(
        said_of(controls.check_box_widget(on.check_box, frame()), "notify"),
        "check box, Notify me, checked"
    )

    val back = click(on.check_box)
    test.assert(back.toggled)
    test.assert_eq(
        said_of(controls.check_box_widget(back.check_box, frame()), "notify"),
        "check box, Notify me, unchecked"
    )
}

// **A mixed box becomes checked, never unchecked.** "Toggle" suggests otherwise, and every platform
// does this: a mixed box means some of the things under it are on, and a user clicking it is asking
// for all of them. Going to unchecked would throw away choices that were already made.
#[test]
fn a_mixed_box_becomes_checked() {
    val mixed = controls.check_box_of("all", "Select all", widget.Toggle.Mixed)
    val after = click(mixed)
    test.assert(after.toggled)
    test.assert_eq(
        said_of(controls.check_box_widget(after.check_box, frame()), "all"),
        "check box, Select all, checked"
    )
}

// The button's cancel rule applies to it, because it is the button's rule and not a copy of it.
#[test]
fn dragging_off_a_check_box_leaves_it_alone() {
    val mixed = controls.check_box_of("all", "Select all", widget.Toggle.Mixed)
    val held = controls.check_box_input(mixed, controls.Input.Press(inside()), box)
    val gone = controls.check_box_input(held.check_box, controls.Input.Release(outside()), box)
    test.assert_false(gone.toggled)
    test.assert_false(gone.check_box.held)
}

#[test]
fn a_disabled_check_box_does_not_toggle() {
    val off = with controls.check_box_of("notify", "Notify me", widget.Toggle.Off) { disabled: true }
    test.assert_false(click(off).toggled)
}

// --- the switch

fn flick(s: controls.Switch) -> controls.SwitchStep {
    val held = controls.switch_input(s, controls.Input.Press(inside()), box)
    return controls.switch_input(held.control, controls.Input.Release(inside()), box)
}

// **"on", not "checked", and "switch", not "check box".** The two controls carry the same `Toggle`
// and this is the whole difference a user can hear: a switch is the state of a thing, a check box
// is a choice about to be submitted. Announcing a switch as "check box, Dark mode, checked" is the
// reader describing the drawing instead of the control -- which is what it did before `Role.Switch`
// existed, because a switch could only be a check box that looked different.
#[test]
fn a_switch_is_announced_as_a_switch_that_is_on_or_off() {
    val off = controls.switch_of("dark", "Dark mode", widget.Toggle.Off)
    test.assert_eq(
        said_of(controls.switch_widget(off, frame()), "dark"),
        "switch, Dark mode, off"
    )
    val on = flick(off)
    test.assert(on.toggled)
    test.assert_eq(
        said_of(controls.switch_widget(on.control, frame()), "dark"),
        "switch, Dark mode, on"
    )
    test.assert_eq(
        said_of(controls.switch_widget(flick(on.control).control, frame()), "dark"),
        "switch, Dark mode, off"
    )
}

// The button's rules are the button's, not copies: a drag off cancels, and a disabled switch is
// inert and does not stay held.
#[test]
fn a_switch_follows_the_button_s_rules() {
    val s = controls.switch_of("dark", "Dark mode", widget.Toggle.Off)
    val held = controls.switch_input(s, controls.Input.Press(inside()), box)
    val gone = controls.switch_input(held.control, controls.Input.Release(outside()), box)
    test.assert_false(gone.toggled)
    test.assert_false(gone.control.held)
    test.assert_false(flick(with s { disabled: true }).toggled)
}

// Space works it, because a control a pointer can reach and a keyboard cannot is not a control.
//
// **On the release, like every other button**, which is the behaviour and not an accident: Space
// held is a button held, so a user who presses it and changes their mind has somewhere to go. The
// first assertion is the one that would catch a switch wired to `KeyDown` -- it would toggle twice
// for one keystroke on a platform that auto-repeats.
#[test]
fn space_works_a_switch_on_the_release() {
    val s = controls.switch_of("dark", "Dark mode", widget.Toggle.Off)
    val down = controls.switch_input(s, controls.Input.KeyDown(key(space)), box)
    test.assert_false(down.toggled)
    test.assert(down.control.held)
    val up = controls.switch_input(down.control, controls.Input.KeyUp(key(space)), box)
    test.assert(up.toggled)
    test.assert(widget.Toggle.is_On(up.control.on))
    test.assert_false(up.control.held)
}

// The switch, painted. A switch draws two fills and no text of its own but the label, so "the
// smallest" is the knob and "the widest" is the track -- which is what these three read.
fn switch_scene(s: controls.Switch) -> scene.Scene {
    val laid = widget.layout(
        controls.switch_widget(s, frame()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    return widget.paint(laid, metrics())
}

fn smallest_fill(s: controls.Switch) -> geom.Rect {
    var best = geom.rect_of(0.0, 0.0, 100000.0, 100000.0)
    for op in switch_scene(s).ops {
        switch op {
            Fill(f) {
                val b = shape.path_bounds(f.path)
                if b.width * b.height < best.width * best.height {
                    best = b
                }
            }
            StrokePath(_) { unit }
            Text(_) { unit }
            DrawImage(_) { unit }
            Nested(_) { unit }
        }
    }
    return best
}

fn widest_fill(s: controls.Switch) -> geom.Rect {
    var best = geom.rect_of(0.0, 0.0, 0.0, 0.0)
    for op in switch_scene(s).ops {
        switch op {
            Fill(f) {
                val b = shape.path_bounds(f.path)
                if b.width > best.width {
                    best = b
                }
            }
            StrokePath(_) { unit }
            Text(_) { unit }
            DrawImage(_) { unit }
            Nested(_) { unit }
        }
    }
    return best
}

// **The knob moves, and it is the only thing that says which way the switch is set.** A switch
// whose knob does not move is a coloured capsule, and a user who cannot see colour -- or a look
// whose accent is close to its face -- has nothing left to read. So this asserts the one thing a
// screenshot would show: the knob sits on the other side.
//
// It is placed by a flexible gap rather than by arithmetic, so this also covers the thing that
// would break silently if `Along` were wrong in one arm: both ends, not one.
#[test]
fn the_knob_sits_at_the_end_the_switch_is_set_to() {
    val off = smallest_fill(controls.switch_of("dark", "Dark mode", widget.Toggle.Off))
    val on = smallest_fill(controls.switch_of("dark", "Dark mode", widget.Toggle.On))
    test.assert(on.x > off.x)
    // Square, and the same square at either end: a knob that changed size would mean the track's
    // padding was being applied to one side only.
    test.assert_eq(str(off.width), str(off.height))
    test.assert_eq(str(off.width), str(on.width))
}

// **Twice as wide as it is tall, and a line tall.** The height is the label's line box, which is
// what makes the control exactly as tall as the words beside it at any density -- the check box's
// reason, and the defect F286 found when the mark box was measured from a glyph instead.
#[test]
fn a_switch_is_a_line_tall_and_twice_as_wide() {
    val widest = widest_fill(controls.switch_of("dark", "Dark mode", widget.Toggle.Off))
    // **Asked of the metrics, which is the claim.** `style.text.label.size` would be a plausible
    // height and a wrong one -- it is the type size, not the line box, and a control measured that
    // way sits short beside its own label. That is the mistake the check box's mark box made until
    // F286, so this pins the choice rather than restating it: the 2:1 ratio below is the
    // independent half.
    val line = controls.line_for(metrics(), theme.plain().text.label)
    test.assert_eq(str(widest.height), str(line))
    test.assert_eq(str(widest.width), str(widest.height * 2.0))
}

// **An on switch is the accent, because that is what the accent is for.** The five state rows
// govern hovered, pressed and disabled -- the control's *state* -- and being on is its *value*, so
// `states.selected.face` would have drawn it in F295's pale selection tint where every platform
// draws a solid colour. The knob is `on_accent`, the one paint guaranteed to read on it.
#[test]
fn an_on_switch_is_drawn_in_the_look_s_accent() {
    val style = theme.plain()
    var track_colour = paint.black()
    var widest = 0.0
    for op in switch_scene(controls.switch_of("dark", "Dark mode", widget.Toggle.On)).ops {
        switch op {
            Fill(f) {
                val b = shape.path_bounds(f.path)
                if b.width > widest {
                    widest = b.width
                    track_colour = paint.flat_of(f.fill)
                }
            }
            StrokePath(_) { unit }
            Text(_) { unit }
            DrawImage(_) { unit }
            Nested(_) { unit }
        }
    }
    test.assert_eq(str(track_colour.red), str(style.accent.red))
    test.assert_eq(str(track_colour.green), str(style.accent.green))
    test.assert_eq(str(track_colour.blue), str(style.accent.blue))
}

// --- the progress bar

// The stops of the one gradient a bar paints. **The fraction is in the paint**, which is what the
// gradient-as-fill decision buys: a test can read the number back out instead of counting pixels
// or asserting a width that depends on the window.
fn bar_stops(b: controls.ProgressBar) -> [paint.Stop] {
    val laid = widget.layout(
        controls.progress_bar_widget(b, frame()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    var found: [paint.Stop] = []
    for op in widget.paint(laid, metrics()).ops {
        switch op {
            Fill(f) {
                switch f.fill {
                    LinearGradient(g) { found = g.stops }
                    Solid(_) { unit }
                    RadialGradient(_) { unit }
                    Pattern(_) { unit }
                }
            }
            StrokePath(_) { unit }
            Text(_) { unit }
            DrawImage(_) { unit }
            Nested(_) { unit }
        }
    }
    return found
}

// Where the fill ends: the last offset still drawn in the accent.
fn done_upto(b: controls.ProgressBar) -> float {
    val style = theme.plain()
    var upto = 0.0
    for s in bar_stops(b) {
        if s.color.red == style.accent.red && s.color.green == style.accent.green && s.color.blue == style.accent.blue {
            if s.offset > upto {
                upto = s.offset
            }
        }
    }
    return upto
}

// **The fill is the fraction, at any width.** A bar is a proportion of whatever space it is given
// and the widget tree has no proportional container, so the edge is a hard stop in a gradient
// whose endpoints are fractions of the painted box. This asserts the thing that would be wrong if
// that were done with arithmetic instead: the number, not a pixel count.
#[test]
fn a_bar_fills_the_fraction_it_was_given() {
    test.assert_eq(str(done_upto(controls.progress_bar_of("copy", "Copying", 0.0))), str(0.0))
    test.assert_eq(str(done_upto(controls.progress_bar_of("copy", "Copying", 0.4))), str(0.4))
    test.assert_eq(str(done_upto(controls.progress_bar_of("copy", "Copying", 1.0))), str(1.0))
}

// **Out of range is held, not wrapped and not an error.** A caller computing 7 of 5 files has a
// bug, and a bar that drew 140% or raised would turn it into a crash in the progress reporting
// rather than a full bar.
#[test]
fn a_fraction_outside_the_range_is_held_at_the_ends() {
    test.assert_eq(str(done_upto(controls.progress_bar_of("copy", "Copying", 0.0 - 2.0))), str(0.0))
    test.assert_eq(str(done_upto(controls.progress_bar_of("copy", "Copying", 4.0))), str(1.0))
}

// **A hard stop, which is two stops at one offset.** The fill's edge is sharp because the stop
// before it and the stop after it are at the same place; a single stop would be a gradient fading
// from accent to track across the whole bar, which looks like a bar that is always half done.
#[test]
fn the_fill_s_edge_is_a_hard_stop() {
    val stops = bar_stops(controls.progress_bar_of("copy", "Copying", 0.4))
    test.assert_eq(len(stops), 4)
    test.assert_eq(str(stops[1].offset), str(stops[2].offset))
    val style = theme.plain()
    test.assert_eq(str(stops[1].color.red), str(style.accent.red))
    test.assert_eq(str(stops[2].color.red), str(style.states.disabled.ink.red))
}

// **A busy bar is a segment somewhere, and at the ends of its cycle it is nowhere.** The segment
// travels from off the left to off the right so that the cycle has no visible stall; a segment
// clamped inside the bar would sit still at both ends and read as the job having stopped twice a
// second.
#[test]
fn a_busy_bar_moves_a_segment_across_and_off_both_ends() {
    val early = done_upto(controls.busy_bar_of("wait", "Contacting", 0.3))
    val later = done_upto(controls.busy_bar_of("wait", "Contacting", 0.6))
    test.assert(later > early)
    // At each end of the cycle the segment is entirely outside the bar, so nothing is in the
    // accent at all -- which is two stops of track and no fill.
    test.assert_eq(len(bar_stops(controls.busy_bar_of("wait", "Contacting", 0.0))), 2)
    test.assert_eq(len(bar_stops(controls.busy_bar_of("wait", "Contacting", 1.0))), 2)
}

// **What a reader is told, which is the only thing a progress bar is for.** A determinate bar has
// a percentage; an indeterminate one has "busy", because there is no percentage to read and a
// reader that said "progress bar, Copying" and stopped would have described a job that might as
// well be finished.
#[test]
fn a_bar_announces_a_percentage_or_that_it_is_busy() {
    test.assert_eq(
        said_of(controls.progress_bar_widget(controls.progress_bar_of("copy", "Copying files", 0.4), frame()), "copy"),
        "progress bar, Copying files, 40%"
    )
    test.assert_eq(
        said_of(controls.progress_bar_widget(controls.progress_bar_of("copy", "Copying files", 1.0), frame()), "copy"),
        "progress bar, Copying files, 100%"
    )
    test.assert_eq(
        said_of(
            controls.progress_bar_widget(controls.busy_bar_of("wait", "Contacting the server", 0.5), frame()),
            "wait"
        ),
        "progress bar, Contacting the server, busy"
    )
}

// **Not a tab stop, and still in the tree.** A control a user cannot operate must not take a stop
// on the way to one they can -- and it must still be announced, because "is it still going?" is
// the question it exists to answer.
#[test]
fn a_progress_bar_is_read_but_not_tabbed_to() {
    val laid = widget.layout(
        controls.progress_bar_widget(controls.progress_bar_of("copy", "Copying", 0.4), frame()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    test.assert_eq(len(focus.controls(laid)), 0)
    test.assert(len(a11y.tree_of(laid, "Records", "").nodes) > 1)
}

// --- the number field

// Wide enough to have steppers at its right-hand edge and a line tall.
val number_box = geom.rect_of(0.0, 0.0, 120.0, 24.0)

fn port_field() -> controls.NumberField {
    return controls.number_field_of("port", "Port", 8080.0, 1.0, 65535.0, 1.0)
}

fn typed(n: controls.NumberField, text: string) -> controls.NumberField {
    var now = n
    for ch in chars(text) {
        now = controls.number_field_input(now, controls.Input.Text(ch), number_box, frame()).field
    }
    return now
}

fn text_in(n: controls.NumberField) -> string {
    return n.entry.editor.text
}

fn cleared() -> controls.NumberField {
    val all = controls.number_field_of("n", "Count", 0.0, 10.0, 20.0, 1.0)
    return with all { entry: with all.entry { editor: edit.editor_of("") } }
}

// **The defect the whole design exists to avoid.** Into a field bounded 10 to 20, a user types
// `1` and then `5`. A field that clamped each keystroke would hold `10` after the first and then
// `105` -- clamped again to `20` -- so 15 would be unreachable and the field untypable. Nothing is
// clamped until it is committed, so the text is simply what was typed.
#[test]
fn a_range_can_be_typed_into() {
    val after = typed(cleared(), "15")
    test.assert_eq(text_in(after), "15")
    test.assert_eq(str(controls.number_or(after, 0.0)), str(15.0))
}

// **A number on its way is not a number, and the field says so rather than inventing one.** A
// field holding `-` has no value; a caller handed `0.0` for it would write a zero into a config.
#[test]
fn a_half_typed_number_has_no_value_and_is_still_typable() {
    val minus = typed(cleared(), "-")
    test.assert_eq(text_in(minus), "-")
    test.assert(Option.is_None(controls.number_in(minus)))
    // And it carries on being typed into.
    val whole = typed(minus, "12")
    test.assert_eq(str(controls.number_or(whole, 0.0)), str(0.0 - 12.0))
    // A trailing point is the same kind of thing.
    val point = typed(cleared(), "1.")
    test.assert_eq(text_in(point), "1.")
}

// **The one rule, applied to every edit: could this still become a number?** A character whitelist
// would let `--` and `1.2.3` through; asking whether the text could still parse does not. It also
// makes `inf` unreachable by typing, because `i` is not on the way to anything.
#[test]
fn an_edit_that_could_never_be_a_number_is_refused() {
    test.assert_eq(text_in(typed(port_field(), "a")), "8080")
    test.assert_eq(text_in(typed(cleared(), "--")), "-")
    test.assert_eq(text_in(typed(cleared(), "1.2.3")), "1.23")
    test.assert_eq(text_in(typed(cleared(), "i")), "")
}

// **A stepper commits, which is why it clamps where typing does not**: pressing it is not being in
// the middle of anything, so there is no half-typed state to protect.
#[test]
fn a_stepper_moves_by_the_step_and_clamps() {
    val up = controls.stepped(port_field(), 1.0)
    test.assert_eq(text_in(up), "8081")
    test.assert_eq(text_in(controls.stepped(up, 0.0 - 1.0)), "8080")
    // At the top it stays at the top rather than going past it.
    val top = controls.number_field_of("port", "Port", 65535.0, 1.0, 65535.0, 1.0)
    test.assert_eq(text_in(controls.stepped(top, 1.0)), "65535")
    // From text that is not a number at all it starts at the low end, which is the only answer
    // that is not a guess.
    test.assert_eq(text_in(controls.stepped(typed(cleared(), "-"), 1.0)), "11")
}

// A step that is not whole reads as the shortest exact text, so the field shows 1, 1.5, 2 -- never
// 1.0, and never 8080.0 in a port field.
#[test]
fn a_fractional_step_reads_in_its_shortest_exact_form() {
    val half = controls.number_field_of("gain", "Gain", 1.0, 0.0, 3.0, 0.5)
    test.assert_eq(text_in(half), "1")
    val up = controls.stepped(half, 1.0)
    test.assert_eq(text_in(up), "1.5")
    test.assert_eq(text_in(controls.stepped(up, 1.0)), "2")
}

// The arrow keys and the wheel are the stepper by another name, and **a wheel outside the field is
// not the field's**: a number that changed while the user scrolled the page it sits on would be a
// value altered by accident.
#[test]
fn the_arrows_step_and_a_wheel_only_counts_over_the_field() {
    val up = controls.number_field_input(
        port_field(),
        controls.Input.KeyDown(key(controls.Key.Up)),
        number_box,
        frame()
    )
    test.assert(up.changed)
    test.assert_eq(text_in(up.field), "8081")
    val down = controls.number_field_input(
        port_field(),
        controls.Input.KeyDown(key(controls.Key.Down)),
        number_box,
        frame()
    )
    test.assert_eq(text_in(down.field), "8079")

    val over = controls.Input.Wheel(controls.Wheel { at: geom.point_of(10.0, 10.0), vertical: 1, horizontal: 0 })
    test.assert_eq(text_in(controls.number_field_input(port_field(), over, number_box, frame()).field), "8081")
    val away = controls.Input.Wheel(controls.Wheel { at: geom.point_of(400.0, 400.0), vertical: 1, horizontal: 0 })
    val unmoved = controls.number_field_input(port_field(), away, number_box, frame())
    test.assert_false(unmoved.changed)
    test.assert_eq(text_in(unmoved.field), "8080")
}

// A press on the upper half of the stepper column steps up and the lower half steps down, worked
// out from the control's own bounds -- the scroll bar's pattern, so this is the one assertion that
// the arithmetic agrees with what was drawn.
#[test]
fn a_press_on_a_stepper_steps_it() {
    val right = number_box.x + number_box.width - 2.0
    val up = controls.Input.Press(geom.point_of(right, 2.0))
    val down = controls.Input.Press(geom.point_of(right, number_box.height - 2.0))
    test.assert_eq(text_in(controls.number_field_input(port_field(), up, number_box, frame()).field), "8081")
    test.assert_eq(text_in(controls.number_field_input(port_field(), down, number_box, frame()).field), "8079")
}

// **Enter commits**: it is the keystroke that means "I have finished", so it clamps and rewrites.
// An empty field stays empty, because a user who cleared it has not given an out-of-range number
// and filling it in on the way past would overwrite what they were about to type.
#[test]
fn enter_commits_and_clamps_but_leaves_an_empty_field_alone() {
    val over = typed(cleared(), "99")
    val sent = controls.number_field_input(over, controls.Input.KeyDown(key(enter)), number_box, frame())
    test.assert_eq(text_in(sent.field), "20")
    test.assert_eq(text_in(controls.committed(cleared())), "")
    test.assert_eq(text_in(controls.committed(typed(cleared(), "-"))), "-")
}

// **`changed` is about the number, not the text.** Typing the `.` of `1.5` changes what is on
// screen and not what the field is worth, and an application saving on every change would write a
// half-typed number to disk.
#[test]
fn only_a_change_in_the_number_counts_as_a_change() {
    val one = typed(cleared(), "1")
    val point = controls.number_field_input(one, controls.Input.Text("."), number_box, frame())
    test.assert_eq(text_in(point.field), "1.")
    test.assert_false(point.changed)
}

// **The range is announced, because a user typing into a field bounded 1 to 65535 cannot see the
// bounds** and learning them by being corrected is a form teaching nothing.
//
// The value comes before it, which is `announce`'s order and the platforms': name, role, value,
// and then the help text. Worth asserting as a whole line rather than field by field -- what a
// user hears is the sentence, and this is the only place it is written down.
#[test]
fn a_number_field_announces_its_range_and_its_value() {
    test.assert_eq(
        said_of(controls.number_field_widget(port_field(), frame()), "port"),
        "spin button, Port, 8080, from 1 to 65535"
    )
}

// **The steppers have extent, and the two of them agree.**
//
// This control's first version lost them: `fixed_of(w, 0.0, child)` means a height of *zero* and
// survives only while a parent stretches it back out -- a row does, a column does not -- which is
// the spelling that has cost this library ten controls now (see `widget.Fixed.constrains`). What
// caught that was the gallery's `no_demo_paints_into_no_space`, and it had to be: the trap is
// contextual, so a test can only catch it by wrapping the control the way the careless caller did,
// which is asserting the caller.
//
// What is worth asserting here is the arithmetic that replaced asking the column how tall the
// field came out -- half a line box and half the padding, twice. Zeroing it fails this test.
#[test]
fn a_number_field_in_a_column_still_has_extent() {
    val laid = widget.layout(
        widget.column_of(8.0, [
            widget.label_of("Port", 12.0, paint.black()),
            widget.row_of(0.0, [
                widget.wide_of(160.0, controls.number_field_widget(port_field(), frame())),
                widget.flex()
            ])
        ]),
        geom.rect_of(0.0, 0.0, 400.0, 200.0),
        metrics()
    )
    test.assert_eq(len(widget.measured_as_nothing(laid)), 0)
    val up = boxes_named(laid, "port-up")
    val down = boxes_named(laid, "port-down")
    test.assert(up > 0.0)
    test.assert_eq(str(up), str(down))
}

// The height of the first node with this name, or 0.
fn boxes_named(l: widget.Laid, name: string) -> float {
    if l.name == name {
        return l.bounds.height
    }
    var found = 0.0
    for c in l.children {
        if found == 0.0 {
            found = boxes_named(c, name)
        }
    }
    return found
}

// One tab stop, not two: the field's text box is drawn under this control rather than under a
// `TextField` of its own, so Tab reaches the number field and a reader announces one thing.
#[test]
fn a_number_field_is_one_tab_stop() {
    val laid = widget.layout(
        controls.number_field_widget(port_field(), frame()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    test.assert_eq(len(focus.controls(laid)), 1)
}

// --- the date field

// **Taller than it looks.** These tests measure with a line box twice the type size, which is
// deliberate and exaggerated, so a calendar here is roughly half as tall again as one drawn
// with a real face. The window has to be able to hold one for the placement to be testable.
val date_window = geom.rect_of(0.0, 0.0, 400.0, 560.0)

fn november() -> time.LocalDate {
    return switch time.localdate_of(2026, 11, 19) {
        Ok(d) { d }
        Err(_) { time.localdate_from_epoch_day(0) }
    }
}

fn due() -> controls.DateField {
    return controls.date_field_of("due", "Due", november())
}

// **One tree, used by the press and by whatever reads the geometry back.** Laying the field out
// one way to find a box and another way to deliver the press is how a test can agree with itself
// and with nothing else -- which is the very bug these tests are here to catch.
fn date_base(d: controls.DateField) -> widget.Widget {
    return widget.column_of(0.0, [controls.date_field_widget(d, frame()), widget.flex()])
}

fn date_laid(d: controls.DateField) -> widget.Laid {
    return widget.layout(date_base(d), date_window, metrics())
}

// The field with its popup over it, which is what the window lays out.
fn calendar_laid(d: controls.DateField) -> widget.Laid {
    val base = date_base(d)
    val first = widget.layout(base, date_window, metrics())
    return switch controls.calendar_layer(d, first, date_window, frame()) {
        Some(over) {
            widget.layout(widget.layered_of([widget.base_layer(base), over]), date_window, metrics())
        }
        None { first }
    }
}

fn date_step(d: controls.DateField, input: controls.Input) -> controls.DateStep {
    return controls.date_field_input(d, input, calendar_laid(d), date_window, frame())
}

fn opened_calendar() -> controls.DateField {
    return date_step(due(), controls.Input.Press(centre_in(date_laid(due()), "due"))).field
}

// 1970-01-01 was a Thursday, so epoch day 4 is a Monday. Derived from the one fact the epoch
// fixes rather than from a calendar I worked out by hand.
fn a_monday() -> time.LocalDate {
    return time.localdate_from_epoch_day(4)
}

fn same_weekday(a: time.LocalDate, b: time.LocalDate) -> bool {
    return (time.to_epoch_day(a) - time.to_epoch_day(b)) % 7 == 0
}

fn day_written(d: controls.DateField) -> string {
    return controls.date_text(d)
}

// **A picker cannot hold a non-date**, which is the whole benefit of not being editable: there is
// no way to put `2026-11-` into this control, so `date_in` answers a `LocalDate` and no caller
// has to check. An editable field would have to hold what somebody is halfway through typing --
// the number field's argument, sound and worth paying for only when there is typing to support.
//
// **And it is one control, not two.** A text field with a calendar button beside it is two things
// that have to agree about one value; this is the combo box's shape, so it is one tab stop and
// one node a reader names.
#[test]
fn a_date_field_is_one_control_holding_one_real_date() {
    test.assert_eq(controls.date_text(due()), "2026-11-19")
    test.assert_eq(controls.date_in(due()).day, 19)
    test.assert_eq(len(focus.controls(date_laid(due()))), 1)
    test.assert_eq(
        said_of(controls.date_field_widget(due(), frame()), "due"),
        "date field, Due, 2026-11-19, collapsed"
    )
}

// **A shut picker opens the way a combo box does**: a press on the box, or Down, Enter or Space.
#[test]
fn the_keyboard_opens_the_calendar_as_it_opens_a_combo_box() {
    test.assert_false(due().open)
    test.assert(date_step(due(), controls.Input.KeyDown(key(controls.Key.Down))).field.open)
    test.assert(date_step(due(), controls.Input.KeyDown(key(enter))).field.open)
    test.assert_false(date_step(due(), controls.Input.KeyDown(key(controls.Key.Home))).field.open)
}

// **The week starts where the locale says it does**, which is the thing a hand-written calendar
// gets wrong: Sunday in the United States and Japan, Monday across most of Europe, Saturday in
// much of the Arabic-speaking world. `locale.first_weekday` asks the host rather than carrying a
// list here that would be wrong for the languages nobody on this team speaks.
//
// The grid also runs day by day with no gap: the dates either side of the month are real dates
// drawn faded, not holes.
#[test]
fn the_grid_starts_on_the_locales_own_first_day() {
    val american = opened_in(locale.of("en_US.UTF-8"))
    val british = opened_in(locale.of("en_GB.UTF-8"))
    test.assert_eq(first_cell_weekday(american), locale.first_weekday(locale.of("en_US.UTF-8")))
    test.assert_eq(first_cell_weekday(british), locale.first_weekday(locale.of("en_GB.UTF-8")))
    // And the two really do differ on this machine, or the assertions above prove nothing.
    test.assert(first_cell_weekday(american) != first_cell_weekday(british))

    val grid = controls.calendar_box(british, date_laid(british), date_window, frame())
    val first = date_step(british, controls.Input.Press(cell_centre(grid, 0))).field
    val second = date_step(british, controls.Input.Press(cell_centre(grid, 1))).field
    test.assert_eq(time.diff_days(controls.date_in(second), controls.date_in(first)), 1)
}

fn opened_in(l: Locale) -> controls.DateField {
    val field = controls.date_field_of("due", "Due", november(), l)
    return date_step(field, controls.Input.Press(centre_in(date_laid(field), "due"))).field
}

// Which day of the week the grid's first cell falls on, 0 for Sunday, read back out of the field
// by pressing that cell.
fn first_cell_weekday(d: controls.DateField) -> int {
    val grid = controls.calendar_box(d, date_laid(d), date_window, frame())
    return weekday_number(controls.date_in(date_step(d, controls.Input.Press(cell_centre(grid, 0))).field))
}

// 1970-01-01 was a Thursday, so epoch day 4 is a Sunday-based 0... epoch day 0 is weekday 4.
fn weekday_number(on: time.LocalDate) -> int {
    val m = (time.to_epoch_day(on) + 4) % 7
    if m < 0 {
        return m + 7
    }
    return m
}

// **Paging the months must not write anything into the field.** A user looking for next March has
// chosen nothing yet, and a calendar that moved the value as the highlight moved would leave a
// date behind on the way past -- the number field's `committed` rule in another shape.
#[test]
fn paging_the_calendar_leaves_the_value_where_it_was() {
    val open = opened_calendar()
    val paged = date_step(open, controls.Input.KeyDown(key(controls.Key.PageDown))).field
    test.assert_eq(day_written(paged), "2026-11-19")
    test.assert_eq(paged.at.month, 12)
    val walked = date_step(paged, controls.Input.KeyDown(key(controls.Key.Down))).field
    test.assert_eq(day_written(walked), "2026-11-19")
    // And Enter is what commits it.
    val taken = date_step(walked, controls.Input.KeyDown(key(enter)))
    test.assert(taken.changed)
    test.assert_eq(day_written(taken.field), "2026-12-26")
    test.assert_false(taken.field.open)
}

// **Pressing the title zooms out, and choosing zooms back in.** A year twenty years away is four
// presses this way and two hundred and forty on a month arrow, which is the whole reason the
// months and years views exist.
//
// **Choosing a month is not choosing a date.** A user who picked March has said nothing about
// which March day they mean, so it steps back to the days rather than writing anything.
//
// **The cells are found in the laid tree, not worked out again here.** An earlier version of this
// test computed cell centres from its own copy of the grid arithmetic, which is how it went on
// passing while the drawing and the hit test were twenty-two points apart.
#[test]
fn the_title_zooms_out_through_months_to_years() {
    val days = opened_calendar()
    test.assert(controls.CalendarView.is_Days(days.view))

    val months = date_step(days, controls.Input.Press(title_middle(days))).field
    test.assert(controls.CalendarView.is_Months(months.view))
    val years = date_step(months, controls.Input.Press(title_middle(months))).field
    test.assert(controls.CalendarView.is_Years(years.view))
    // There is nowhere further out to go.
    val further = date_step(years, controls.Input.Press(title_middle(years))).field
    test.assert(controls.CalendarView.is_Years(further.view))

    // Twenty years to a block on fixed boundaries, so 2026 sits in 2020 to 2039 and the tenth
    // cell is 2029.
    val picked_year = date_step(years, controls.Input.Press(centre_of_cell(years, 9)))
    test.assert_false(picked_year.changed)
    test.assert(controls.CalendarView.is_Months(picked_year.field.view))
    test.assert_eq(picked_year.field.at.year, 2029)
    test.assert_eq(day_written(picked_year.field), "2026-11-19")

    // The third cell of the months grid is March.
    val picked_month = date_step(picked_year.field, controls.Input.Press(centre_of_cell(picked_year.field, 2)))
    test.assert_false(picked_month.changed)
    test.assert(controls.CalendarView.is_Days(picked_month.field.view))
    test.assert_eq(picked_month.field.at.month, 3)
    test.assert_eq(picked_month.field.at.year, 2029)
    test.assert_eq(day_written(picked_month.field), "2026-11-19")
}

// **The grid is twenty years, four across and five down**, and the arrows page by a whole block
// rather than by one year -- the same rule the days view pages by a whole month.
#[test]
fn the_years_grid_is_a_block_of_twenty() {
    val days = opened_calendar()
    val months = date_step(days, controls.Input.Press(title_middle(days))).field
    val years = date_step(months, controls.Input.Press(title_middle(months))).field

    // Four columns: cell 0 and cell 4 are in the same column, one row apart.
    test.assert_eq(drawn_cell(years, 0).x, drawn_cell(years, 4).x)
    test.assert(drawn_cell(years, 4).y > drawn_cell(years, 0).y)
    // Five rows: the last cell is the twentieth.
    test.assert(drawn_cell(years, 19).width > 0.0)
    test.assert_eq(drawn_cell(years, 19).x, drawn_cell(years, 3).x)

    // The block runs 2020 to 2039, and the first and last cells say so.
    test.assert_eq(date_step(years, controls.Input.Press(centre_of_cell(years, 0))).field.at.year, 2020)
    test.assert_eq(date_step(years, controls.Input.Press(centre_of_cell(years, 19))).field.at.year, 2039)
}

// **The two arrows page by whatever the view is showing**: a month of days, a year of months, a
// block of twenty years.
#[test]
fn the_arrows_page_by_what_is_on_screen() {
    val days = opened_calendar()
    test.assert_eq(date_step(days, controls.Input.KeyDown(key(controls.Key.PageDown))).field.at.month, 12)

    val months = date_step(days, controls.Input.Press(title_middle(days))).field
    test.assert_eq(date_step(months, controls.Input.KeyDown(key(controls.Key.PageDown))).field.at.year, 2027)

    val years = date_step(months, controls.Input.Press(title_middle(months))).field
    test.assert_eq(date_step(years, controls.Input.KeyDown(key(controls.Key.PageDown))).field.at.year, 2046)
    test.assert_eq(date_step(years, controls.Input.KeyDown(key(controls.Key.PageUp))).field.at.year, 2006)
}

// The centre of a cell as it was actually drawn.
fn centre_of_cell(d: controls.DateField, index: int) -> geom.Point {
    val at = drawn_cell(d, index)
    return geom.point_of(at.x + at.width * 0.5, at.y + at.height * 0.5)
}

// Escape zooms back in before it shuts, so one key undoes one step rather than throwing away
// three.
#[test]
fn escape_zooms_in_before_it_shuts() {
    val days = opened_calendar()
    val months = date_step(days, controls.Input.Press(title_middle(days))).field
    val back = date_step(months, controls.Input.KeyDown(key(controls.Key.Escape))).field
    test.assert(controls.CalendarView.is_Days(back.view))
    test.assert(back.open)
    test.assert_false(date_step(back, controls.Input.KeyDown(key(controls.Key.Escape))).field.open)
}

// **A press must land on the cell it is drawn in, at its corner and not only at its centre.**
//
// The months and years grids were drawn from one origin and hit-tested from another, twenty-two
// points apart -- the hit test still reserved the row of weekday names that only the days view
// draws. Every test passed, because the offset was a point and a half under half a row, so a
// press at a cell's centre still landed on it. The top of every cell belonged to the row above.
//
// **Corner and centre of the same drawn cell must do the same thing**, which is the invariant a
// second copy of the arithmetic breaks. It is checked in all three views, because the view is
// exactly what the two copies disagreed about.
#[test]
fn a_press_in_a_cells_own_corner_does_what_its_centre_does() {
    val days = opened_calendar()
    val months = date_step(days, controls.Input.Press(title_middle(days))).field
    val years = date_step(months, controls.Input.Press(title_middle(months))).field
    for d in [days, months, years] {
        for i in [0, 1, 5, 11] {
            val at = drawn_cell(d, i)
            test.assert(at.width > 0.0)
            test.assert_eq(
                outcome_of(d, geom.point_of(at.x + 1.0, at.y + 1.0)),
                outcome_of(d, geom.point_of(at.x + at.width * 0.5, at.y + at.height * 0.5))
            )
        }
    }
}

// The laid box of one cell of whatever view is showing, from the tree the window would draw.
fn drawn_cell(d: controls.DateField, index: int) -> geom.Rect {
    val stem = if controls.CalendarView.is_Days(d.view) { "due/day/" } else { "due/cell/" }
    return switch widget.node_named(calendar_laid(d), concat(stem, str(index))) {
        Some(n) { n.bounds }
        None { geom.rect_of(0.0, 0.0, 0.0, 0.0) }
    }
}

// Everything a press can change, in one string: the value it wrote and the month it moved to.
fn outcome_of(d: controls.DateField, p: geom.Point) -> string {
    val after = date_step(d, controls.Input.Press(p)).field
    return concat(controls.date_text(after), " @", str(after.at.year), "-", str(after.at.month))
}

// **A weekday name is a label and must not do anything.** The band above the day grid is the
// title *and* the row of weekday names, so a header press tested against the whole band meant
// pressing "Mon" paged the month or zoomed out to the year.
#[test]
fn a_press_on_a_weekday_name_does_nothing() {
    val d = opened_calendar()
    val grid = controls.calendar_box(d, calendar_laid(d), date_window, frame())
    // Just above the first row of days, which is where the weekday names are drawn.
    val on_name = geom.point_of(grid.x + grid.width * 0.5, drawn_cell(d, 0).y - 2.0)
    val after = date_step(d, controls.Input.Press(on_name)).field
    test.assert(controls.CalendarView.is_Days(after.view))
    test.assert_eq(after.at.month, d.at.month)
    test.assert_eq(controls.date_text(after), controls.date_text(d))
}

// **A header that works and does not look like it works is a header that is not there.** This was
// reported as the year picker being missing; it was reachable the whole time, by pressing a label
// that nothing said was pressable. The three parts are declared now, so each lights under the
// pointer and each has a name a reader can find.
//
// **And what they say changes with the view**, because the arrows do not step the same thing in
// each: a month of days, a year of months, a block of twenty years.
#[test]
fn the_calendars_header_names_its_three_buttons() {
    val days = opened_calendar()
    val months = date_step(days, controls.Input.Press(title_middle(days))).field
    val years = date_step(months, controls.Input.Press(title_middle(months))).field

    test.assert_eq(part_says(days, "/back"), "Previous month")
    test.assert_eq(part_says(days, "/forward"), "Next month")
    test.assert_eq(part_says(days, "/zoom"), "Choose a month")

    test.assert_eq(part_says(months, "/back"), "Previous year")
    test.assert_eq(part_says(months, "/zoom"), "Choose a year")

    test.assert_eq(part_says(years, "/forward"), "Next 20 years")
    // The years view has nowhere further out to go, so its heading says what it shows rather than
    // inviting a press that would do nothing.
    test.assert_eq(part_says(years, "/zoom"), "2020 to 2039")
}

fn part_says(d: controls.DateField, suffix: string) -> string {
    return switch a11y.node_of(
        a11y.tree_of(calendar_laid(d), "x", ""),
        concat("due", suffix)
    ) {
        Some(n) { n.name }
        None { "(absent)" }
    }
}

// The middle third of the header, which is the part that zooms rather than pages.
fn title_middle(d: controls.DateField) -> geom.Point {
    val grid = controls.calendar_box(d, date_laid(d), date_window, frame())
    return geom.point_of(grid.x + grid.width * 0.5, grid.y + 2.0)
}

// A cell of the months or years grid, three across.
fn cell_centre_of(grid: geom.Rect, column: int, rows_down: int) -> geom.Point {
    val wide = grid.width / 3.0
    val head = grid.height - (grid.width / 7.0) * 6.0
    val tall = (grid.height - head) / 4.0
    return geom.point_of(
        grid.x + (column as float) * wide + wide * 0.5,
        grid.y + head + (rows_down as float) * tall + tall * 0.5
    )
}

// **Escape shuts it without writing**, which is the other half of the same rule.
#[test]
fn escape_shuts_the_calendar_and_writes_nothing() {
    val gone = date_step(opened_calendar(), controls.Input.KeyDown(key(controls.Key.Escape)))
    test.assert_false(gone.field.open)
    test.assert_false(gone.changed)
    test.assert_eq(day_written(gone.field), "2026-11-19")
}

// **A calendar hanging off the bottom of the window is a calendar with half its month missing.**
#[test]
fn a_calendar_near_the_foot_of_the_window_goes_above_the_field() {
    val open = opened_calendar()
    val low = widget.layout(
        controls.date_field_widget(open, frame()),
        geom.rect_of(0.0, 520.0, 240.0, 30.0),
        metrics()
    )
    val grid = controls.calendar_box(open, low, date_window, frame())
    test.assert(grid.y >= date_window.y)
    test.assert(grid.y + grid.height <= date_window.y + date_window.height)
}

fn cell_centre(grid: geom.Rect, index: int) -> geom.Point {
    val side = grid.width / 7.0
    val head = grid.height - side * 6.0
    return geom.point_of(
        grid.x + ((index % 7) as float) * side + side * 0.5,
        grid.y + head + ((index / 7) as float) * side + side * 0.5
    )
}

// --- the toolbar

val tools_wide = 600.0
val tools_box = geom.rect_of(0.0, 0.0, 600.0, 40.0)

fn tool_strip() -> controls.Toolbar {
    return controls.toolbar_of("bar", "Request", [
        controls.ToolItem.Command(controls.button_of("bar-send", "Send")),
        controls.ToolItem.Command(controls.button_of("bar-stop", "Stop")),
        controls.ToolItem.Divider,
        controls.ToolItem.Command(controls.button_of("bar-save", "Save")),
        controls.ToolItem.Command(controls.button_of("bar-share", "Share"))
    ])
}

fn tools_laid(t: controls.Toolbar, width: float) -> widget.Laid {
    return widget.layout(
        controls.toolbar_widget(t, width, frame()),
        geom.rect_of(0.0, 0.0, width, 40.0),
        metrics()
    )
}

fn tools_step(t: controls.Toolbar, input: controls.Input, width: float) -> controls.ToolbarStep {
    return controls.toolbar_input(t, input, tools_laid(t, width), width, tools_box, frame())
}

fn tool_arrowed(t: controls.Toolbar, k: controls.Key) -> controls.Toolbar {
    return tools_step(t, controls.Input.KeyDown(key(k)), tools_wide).toolbar
}

fn centre_of(t: controls.Toolbar, name: string) -> geom.Point {
    return switch widget.node_named(tools_laid(t, tools_wide), name) {
        Some(n) { geom.point_of(n.bounds.x + n.bounds.width * 0.5, n.bounds.y + n.bounds.height * 0.5) }
        None { geom.point_of(0.0 - 1.0, 0.0 - 1.0) }
    }
}

// **The headline, and the only reason a toolbar is a control rather than a row.** Eight buttons in
// a row are eight stops in the tab order, so a user reaching the field underneath presses Tab nine
// times. Every platform's toolbar is one stop that the arrows walk.
#[test]
fn a_toolbar_is_one_tab_stop_however_many_commands_it_holds() {
    test.assert_eq(len(focus.controls(tools_laid(tool_strip(), tools_wide))), 1)
}

// **And the arrows never stop on a rule.** A divider is decoration; a keyboard that could land on
// one would give the user a position where Space does nothing.
#[test]
fn the_arrows_walk_the_commands_and_never_stop_on_a_rule() {
    test.assert_eq(tool_strip().at, 0)
    test.assert_eq(tool_arrowed(tool_strip(), controls.Key.Right).at, 1)
    // Index 2 is the divider, so Right from 1 lands on 3.
    test.assert_eq(tool_arrowed(tool_arrowed(tool_strip(), controls.Key.Right), controls.Key.Right).at, 3)
    test.assert_eq(tool_arrowed(tool_strip(), controls.Key.End).at, 4)
    // Clamped at the end rather than wrapped, as a tab strip is.
    test.assert_eq(tool_arrowed(tool_arrowed(tool_strip(), controls.Key.End), controls.Key.Right).at, 4)
    test.assert_eq(tool_arrowed(tool_strip(), controls.Key.Left).at, 0)
}

// **Space fires on the way up**, which is the rule everywhere here: a key held down is a command
// not yet committed to.
#[test]
fn space_fires_the_command_the_arrows_are_on() {
    val t = tool_strip()
    test.assert_eq(tools_step(t, controls.Input.KeyUp(key(space)), tools_wide).fired, "bar-send")
    test.assert_eq(tools_step(t, controls.Input.KeyDown(key(space)), tools_wide).fired, "")
    val moved = tool_arrowed(t, controls.Key.Right)
    test.assert_eq(tools_step(moved, controls.Input.KeyUp(key(space)), tools_wide).fired, "bar-stop")
}

// **A release has to land on the command the press did**, which is a button's rule: a user who
// presses the wrong one and drags off has cancelled it.
#[test]
fn a_command_fires_on_the_release_and_a_drag_off_it_cancels() {
    val t = tool_strip()
    val on_send = centre_of(t, "bar/0")
    val on_stop = centre_of(t, "bar/1")
    val held = tools_step(t, controls.Input.Press(on_send), tools_wide).toolbar
    test.assert_eq(held.held, 0)
    test.assert_eq(tools_step(held, controls.Input.Release(on_send), tools_wide).fired, "bar-send")
    test.assert_eq(tools_step(held, controls.Input.Release(on_stop), tools_wide).fired, "")
}

// **A rule must not promise a drag.** `Role.Separator` means a draggable divider here and
// `cursor_for` turns it into a resize arrow from the shape of its box, so a toolbar's rule is
// deliberately not one -- and this is what would catch it being made one by mistake.
#[test]
fn a_toolbars_rule_does_not_promise_a_drag() {
    val t = tool_strip()
    val before = centre_of(t, "bar/1")
    val after = centre_of(t, "bar/3")
    val between = (before.x + after.x) * 0.5
    test.assert_eq(cursor_over(tools_laid(t, tools_wide), between, before.y), "arrow")
}

// **What does not fit is still reachable.** A toolbar that silently drops its last two commands is
// worse than one that never had them, because nothing on screen says they are missing.
#[test]
fn what_does_not_fit_goes_into_the_overflow_and_still_fires() {
    val t = tool_strip()
    test.assert_eq(controls.toolbar_fits(t, tools_wide, frame()), 5)
    val narrow = 150.0
    val shown = controls.toolbar_fits(t, narrow, frame())
    test.assert(shown < 5)

    // The overflow button is in the tree only when something overflowed.
    test.assert(holds_named(tools_laid(t, narrow), controls.toolbar_more_name(t)))
    test.assert_false(holds_named(tools_laid(t, tools_wide), controls.toolbar_more_name(t)))

    val opened = controls.toolbar_input(
        t,
        controls.Input.Press(centre_in(tools_laid(t, narrow), controls.toolbar_more_name(t))),
        tools_laid(t, narrow),
        narrow,
        tools_box,
        frame()
    ).toolbar
    test.assert(opened.more.menu.open)
}

fn holds_named(l: widget.Laid, name: string) -> bool {
    return switch widget.node_named(l, name) {
        Some(_) { true }
        None { false }
    }
}

fn centre_in(l: widget.Laid, name: string) -> geom.Point {
    return switch widget.node_named(l, name) {
        Some(n) { geom.point_of(n.bounds.x + n.bounds.width * 0.5, n.bounds.y + n.bounds.height * 0.5) }
        None { geom.point_of(0.0 - 1.0, 0.0 - 1.0) }
    }
}

// --- the context menu

val window_box = geom.rect_of(0.0, 0.0, 400.0, 300.0)

fn commands() -> controls.ContextMenu {
    return controls.context_menu_of("ctx", "Request", ["Copy as curl", "Duplicate", "Delete"])
}

fn asked_at(x: float, y: float) -> controls.ContextMenu {
    return controls.context_menu_input(
        commands(),
        controls.Input.SecondaryPress(geom.point_of(x, y)),
        window_box,
        frame()
    ).context
}

// **The gesture is the library's, not every application's.** A context menu opened by a caller's
// own `if` would open on a different button in each program that wanted one -- and until
// `Input.SecondaryPress` existed there was no button to open it on, because `desktop.input_of`
// threw the platform's button away and every click was a left click.
#[test]
fn a_secondary_press_opens_a_context_menu_where_the_pointer_is() {
    val shut = commands()
    test.assert_false(controls.context_menu_open(shut))
    val open = asked_at(40.0, 50.0)
    test.assert(controls.context_menu_open(open))
    val at = controls.context_menu_box(open, window_box, frame())
    test.assert_eq(at.x, 40.0)
    test.assert_eq(at.y, 50.0)
}

// **And an ordinary press does not.** This is the half that was broken for every control in the
// library, not just this one: with no secondary variant, a right-click on a button fired it.
#[test]
fn the_secondary_button_does_not_work_an_ordinary_control() {
    val fired = controls.button_input(
        controls.button_of("save", "Save"),
        controls.Input.SecondaryPress(inside()),
        box
    )
    test.assert_false(fired.activated)
    test.assert_false(fired.button.held)
}

// **A menu over the edge of the window is a menu with its commands cut in half**, and the corner
// is the case a developer with a large screen never reaches: there is no room below *or* to the
// right, so it has to go up and back.
#[test]
fn a_context_menu_asked_for_in_the_corner_stays_inside_the_window() {
    val corner = controls.context_menu_box(asked_at(395.0, 295.0), window_box, frame())
    test.assert(corner.x >= window_box.x)
    test.assert(corner.y >= window_box.y)
    test.assert(corner.x + corner.width <= window_box.x + window_box.width)
    test.assert(corner.y + corner.height <= window_box.y + window_box.height)
}

// **Measured, because there is no title to inherit a width from.** A fixed width would clip the
// longest command or leave a band of empty menu beside the shortest.
#[test]
fn a_context_menu_is_wide_enough_for_its_longest_command() {
    val narrow = controls.context_menu_box(asked_at(10.0, 10.0), window_box, frame())
    val wider = controls.context_menu_box(
        controls.context_menu_input(
            controls.context_menu_of("ctx", "Request", ["Copy as curl with every header spelled out"]),
            controls.Input.SecondaryPress(geom.point_of(10.0, 10.0)),
            window_box,
            frame()
        ).context,
        window_box,
        frame()
    )
    test.assert(wider.width > narrow.width)
}

// **The box the popup is painted in is the box a click is tested against.** Worked out twice they
// could disagree, and a menu that can be dismissed by clicking one of its own rows is the result.
#[test]
fn a_press_on_a_context_menus_own_row_chooses_rather_than_dismisses() {
    val open = asked_at(40.0, 50.0)
    val at = controls.context_menu_box(open, window_box, frame())
    val on_first = geom.point_of(at.x + 4.0, at.y + 2.0)
    val step = controls.context_menu_input(open, controls.Input.Press(on_first), window_box, frame())
    test.assert_false(step.dismissed)
}

// --- the expander

val section_box = geom.rect_of(0.0, 0.0, 200.0, 120.0)

fn advanced(open: bool) -> controls.Expander {
    return controls.expander_of("advanced", "Advanced", open)
}

fn section(e: controls.Expander) -> widget.Widget {
    return controls.expander_widget(
        e,
        controls.button_widget(controls.button_of("go", "Go"), frame()),
        frame()
    )
}

// The header's own box, which is what the name finds and what a caller hands to `expander_input`.
fn header_of(e: controls.Expander) -> geom.Rect {
    val l = widget.layout(section(e), section_box, metrics())
    return switch widget.node_named(l, "advanced") {
        Some(n) { n.bounds }
        None { geom.rect_of(0.0, 0.0, 0.0, 0.0) }
    }
}

// **A press down in the content must not fold the section away under the user's hand.** The
// header is what carries the name, so the box a caller looks up is a strip at the top and a
// release below it is a release outside the control -- which is the whole of the protection, and
// this is the assertion that the geometry really is that shape.
#[test]
fn a_section_folds_from_its_header_and_not_from_its_content() {
    val head = header_of(advanced(true))
    test.assert(head.height < section_box.height)

    val at = geom.point_of(head.x + 10.0, head.y + head.height * 0.5)
    val held = controls.expander_input(advanced(false), controls.Input.Press(at), head)
    test.assert(held.expander.held)
    test.assert_false(held.toggled)
    val fired = controls.expander_input(held.expander, controls.Input.Release(at), head)
    test.assert(fired.toggled)
    test.assert(fired.expander.open)

    val deep = geom.point_of(head.x + 10.0, section_box.height - 5.0)
    val away = controls.expander_input(held.expander, controls.Input.Release(deep), head)
    test.assert_false(away.toggled)
}

// **A shut section is not in the tree at all**, which is the difference between hiding something
// and drawing it somewhere invisible. Content that is laid out but unseen is content a reader
// reads out and a Tab lands in, and a window whose focus disappears into a folded section is a
// window the keyboard has lost its place in.
#[test]
fn a_shut_section_holds_nothing_a_tab_can_reach() {
    test.assert_eq(len(focus.controls(widget.layout(section(advanced(true)), section_box, metrics()))), 2)
    test.assert_eq(len(focus.controls(widget.layout(section(advanced(false)), section_box, metrics()))), 1)
}

// **A button whose `expanded` state says what pressing it did**, which is what ATK and ARIA both
// model a disclosure as -- neither has an expander role. `State.expanded` has been in `widget`
// since accessibility was built and a tree row was the only thing that ever set it.
#[test]
fn an_expander_says_whether_it_is_open() {
    test.assert_eq(said_of(section(advanced(true)), "advanced"), "button, Advanced, expanded")
    test.assert_eq(said_of(section(advanced(false)), "advanced"), "button, Advanced, collapsed")
}

// --- the tooltip

val tip_pause = 600

// **A tip waits, and moving to another control starts the wait again.** A pointer crossing a
// toolbar of eight buttons must not leave eight tips behind it, which is the whole reason the wait
// is per-control rather than a single timer the window keeps.
#[test]
fn a_tip_waits_and_a_move_starts_the_wait_again() {
    var h = controls.no_hover()
    // **Arriving counts nothing**, which is the conservative reading: the pointer got there at some
    // unknown point inside that frame, so the wait starts at zero rather than at a frame's worth.
    h = controls.hovering(h, "save", 200)
    test.assert_eq(h.waited, 0)
    test.assert_false(controls.tip_due(h, tip_pause))
    h = controls.hovering(h, "save", 200)
    h = controls.hovering(h, "save", 200)
    test.assert_false(controls.tip_due(h, tip_pause))
    h = controls.hovering(h, "save", 200)
    test.assert(controls.tip_due(h, tip_pause))
    // Onto the next button: the count starts again, so nothing is showing.
    h = controls.hovering(h, "open", 16)
    test.assert_false(controls.tip_due(h, tip_pause))
    // And off every control: no tip, whatever has been waited.
    h = controls.hovering(h, "", 10000)
    test.assert_false(controls.tip_due(h, tip_pause))
}

// A tree with one icon button -- a label nothing draws -- and one ordinary button, which draws its
// own.
fn two_buttons() -> widget.Laid {
    return widget.layout(
        widget.column_of(4.0, [
            // **A true icon-only button: no label at all**, its name carried by the icon, which
            // is where `announced_name` looks. That is the control a tooltip exists for -- the
            // words are declared and nothing on screen shows them.
            controls.button_widget(
                controls.icon_button_of("save", "", widget.icon_of(dot_icon(), "Save")),
                frame()
            ),
            controls.button_widget(controls.button_of("open", "Open"), frame())
        ]),
        geom.rect_of(0.0, 0.0, 200.0, 80.0),
        metrics()
    )
}

fn dot_icon() -> shape.Path {
    return shape.ellipse_path(geom.rect_of(0.2, 0.2, 0.6, 0.6))
}

// **A tip says what the control declares, and says nothing when the control is already saying it.**
// An icon button's label is the thing a tooltip exists to reveal; an ordinary button's is on its
// face, and a tip repeating it is noise with a delay on it.
#[test]
fn a_tip_names_an_icon_button_and_stays_quiet_over_a_labelled_one() {
    val laid = two_buttons()
    val on_icon = controls.hovering(controls.no_hover(), "save", 1000)
    test.assert_eq(controls.tip_words(on_icon, laid), "Save")
    val on_label = controls.hovering(controls.no_hover(), "open", 1000)
    test.assert_eq(controls.tip_words(on_label, laid), "")
    // Over nothing, and over a name that is not in the tree: no words, not an error.
    test.assert_eq(controls.tip_words(controls.no_hover(), laid), "")
    test.assert_eq(controls.tip_words(controls.hovering(controls.no_hover(), "gone", 1000), laid), "")
}

// **A description beats a label**, which is what makes the number field's range appear over it: the
// field already draws its value, and the words it does not draw are the bounds a user cannot see.
#[test]
fn a_description_is_what_a_tip_prefers() {
    val laid = widget.layout(
        controls.number_field_widget(port_field(), frame()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    test.assert_eq(
        controls.tip_words(controls.hovering(controls.no_hover(), "port", 1000), laid),
        "from 1 to 65535"
    )
}

fn tip_box(over: geom.Rect, within: geom.Rect) -> geom.Rect {
    // Not `box`: that is a module-level val here, and a switch payload cannot shadow one. Fourth
    // time this has cost a compile in this file.
    return switch controls.tip_layer("Save", over, within, frame()).at {
        Some(placed) { placed }
        None { geom.rect_of(0.0, 0.0, 0.0, 0.0) }
    }
}

// **Below the control, and inside the window.** A tip hanging off the right-hand edge is a tip with
// its last word missing -- which is the half it was needed for -- and one below a control at the
// foot of the window is not on screen at all.
#[test]
fn a_tip_sits_below_its_control_and_inside_the_window() {
    val window = geom.rect_of(0.0, 0.0, 300.0, 200.0)
    val middle = tip_box(geom.rect_of(40.0, 50.0, 60.0, 20.0), window)
    test.assert(middle.y > 70.0)
    test.assert_eq(str(middle.x), str(40.0))

    // Against the right-hand edge: pushed back in, so its right side is the window's.
    val right = tip_box(geom.rect_of(290.0, 50.0, 60.0, 20.0), window)
    test.assert(right.x + right.width <= 300.0)
    test.assert(right.x < 290.0)

    // At the foot: flipped above the control rather than drawn off the bottom.
    val low = tip_box(geom.rect_of(40.0, 190.0, 60.0, 20.0), window)
    test.assert(low.y < 190.0)
    test.assert(low.y >= 0.0)
}

// **A tip takes no keys and is not a control.**
//
// Taking the keyboard is the one thing it must never do: a tooltip is a consequence of the pointer
// resting, so a layer that claimed the focus would move it somewhere the user never asked to go.
//
// Its words are in the tree the way any drawn text is -- which is why this asserts "no control"
// rather than "no node". A `Role.Tooltip` would put a second thing in the tree saying the sentence
// the control already says; see `tip_layer`.
#[test]
fn a_tip_is_not_a_control_and_takes_no_keys() {
    val layer = controls.tip_layer(
        "Save",
        geom.rect_of(0.0, 0.0, 40.0, 20.0),
        geom.rect_of(0.0, 0.0, 300.0, 200.0),
        frame()
    )
    test.assert_false(layer.takes_keys)
    val laid = widget.layout(layer.content, geom.rect_of(0.0, 0.0, 100.0, 30.0), metrics())
    test.assert_eq(len(focus.controls(laid)), 0)
    // The window, and the words as static text: nothing claiming to be a control.
    val tree = a11y.tree_of(laid, "Records", "")
    test.assert_eq(len(tree.nodes), 2)
    test.assert_eq(said_of_tree(tree, "@0"), "Save")
}

// --- routing

fn laid_pair() -> widget.Laid {
    val style = theme.plain()
    val row = widget.row_of(
        0.0,
        [
            widget.fixed_of(60.0, 20.0, controls.button_widget(controls.button_of("a", "A"), frame_in(style))),
            widget.fixed_of(60.0, 20.0, controls.button_widget(controls.button_of("b", "B"), frame_in(style)))
        ]
    )
    return widget.layout(row, geom.rect_of(0.0, 0.0, 120.0, 20.0), metrics())
}

#[test]
fn a_key_goes_to_the_focus() {
    test.assert_eq(controls.target(laid_pair(), controls.Input.KeyDown(key(space)), "b", ""), "b")
    test.assert_eq(controls.target(laid_pair(), controls.Input.Text("x"), "b", ""), "b")
}

#[test]
fn a_press_goes_to_what_is_under_the_pointer() {
    test.assert_eq(controls.target(laid_pair(), controls.Input.Press(geom.point_of(70.0, 10.0)), "a", ""), "b")
}

// **A release goes to the focus, not to what is under the pointer**, which looks wrong and is what
// makes a cancelled drag work at all: the press moved the focus to the button, so the release
// reaches that button even though the pointer has left it -- and the button is the only thing that
// can decide the drag was a cancel. Routed by position instead, the release would go nowhere and
// the button would stay drawn pressed for ever.
#[test]
fn a_release_follows_the_focus_so_a_cancelled_drag_still_arrives() {
    val l = laid_pair()
    val focused = controls.target(l, controls.Input.Press(geom.point_of(70.0, 10.0)), "a", "")
    test.assert_eq(focused, "b")
    test.assert_eq(controls.target(l, controls.Input.Release(geom.point_of(300.0, 300.0)), focused, ""), "b")
}

// **The grab, which is what the focus could not stand in for.** A control the keyboard cannot
// reach never becomes the focus, so routing a move to the focus delivered a drag to some control
// elsewhere on screen -- the scroll bar could be grabbed and not dragged, measured in the gallery
// as a thumb that stayed at pixel 126 through a 230-pixel drag. These say the rule from both ends:
// with a grab it wins, without one the focus still does.
#[test]
fn a_move_during_a_press_goes_to_whatever_took_the_press() {
    val l = laid_pair()
    val away = controls.Input.Move(geom.point_of(300.0, 300.0))
    test.assert_eq(controls.target(l, away, "a", "b"), "b")
    test.assert_eq(
        controls.target(l, controls.Input.Release(geom.point_of(300.0, 300.0)), "a", "b"),
        "b"
    )
}

#[test]
fn a_move_with_no_button_down_still_goes_to_the_focus() {
    val l = laid_pair()
    test.assert_eq(controls.target(l, controls.Input.Move(geom.point_of(300.0, 300.0)), "a", ""), "a")
}

// **A release clears the grab even when it lands on nothing**, which is what stops a grabbed bar
// from swallowing every later move in the window.
#[test]
fn the_grab_lasts_exactly_from_the_press_to_the_release() {
    val press = controls.Input.Press(geom.point_of(70.0, 10.0))
    val moved = controls.Input.Move(geom.point_of(300.0, 300.0))
    val gone = controls.Input.Release(geom.point_of(300.0, 300.0))
    test.assert_eq(controls.pressed_after("", press, "bar"), "bar")
    test.assert_eq(controls.pressed_after("bar", moved, ""), "bar")
    test.assert_eq(controls.pressed_after("bar", gone, ""), "")
    // A key or a wheel in the middle of a drag leaves it alone.
    test.assert_eq(controls.pressed_after("bar", controls.Input.Text("x"), ""), "bar")
}

// **A wheel goes to the control under the pointer and ignores the focus**, because that is what a
// user means: scrolling the list they are pointing at, not the one that has the keyboard.
#[test]
fn a_wheel_goes_under_the_pointer_and_not_to_the_focus() {
    val l = laid_pair()
    val over_b = controls.Input.Wheel(controls.Wheel { at: geom.point_of(70.0, 10.0), vertical: 1, horizontal: 0 })
    test.assert_eq(controls.target(l, over_b, "a", ""), "b")
}

// Over nothing a wheel goes nowhere rather than to the focus, which is the same choice and the case
// that proves the focus is not a fallback.
#[test]
fn a_wheel_over_nothing_goes_nowhere() {
    val away = controls.Input.Wheel(controls.Wheel { at: geom.point_of(500.0, 500.0), vertical: 1, horizontal: 0 })
    test.assert_eq(controls.target(laid_pair(), away, "a", ""), "")
}

// **A press on nothing leaves the focus where it was and is delivered to nobody**, which is two
// facts and was one function's answer to both. `target` asked `focus.clicked`, which answers the
// *current focus* for a point over no tab stop -- correct for "where does the focus go" and wrong
// for "who gets this press", so a press on the background, or on a bare scroll bar, was handed to
// whatever happened to be focused elsewhere on screen. In the gallery that meant clicking a
// scroll bar changed the selection in a tree the pointer was nowhere near.
//
// This test used to assert the defect, under a name about focus. Both halves now, from the two
// functions that answer them.
#[test]
fn a_press_on_nothing_goes_nowhere_and_leaves_the_focus_alone() {
    val away = geom.point_of(500.0, 500.0)
    test.assert_eq(controls.target(laid_pair(), controls.Input.Press(away), "a", ""), "")
    test.assert_eq(focus.clicked(laid_pair(), away, "a"), "a")
}

// **A part routes to the control that owns it, not to itself.** A list's rows and a tree's rows
// are controls -- declared so a reader and a click can reach them -- so "the innermost control
// under the pointer" is the *row*, and a router that answered it would leave the list never
// hearing the press. A first attempt at the fix above did exactly that and broke every list,
// tree, tab strip and table in the window at once.
#[test]
fn a_press_on_a_row_routes_to_the_list_and_not_to_the_row() {
    val l = widget.layout(controls.list_widget(five(), frame()), list_box(), metrics())
    // The row is there, and it is a control.
    test.assert(Option.is_Some(widget.node_named(l, controls.row_name(five(), 1))))
    test.assert_eq(controls.target(l, controls.Input.Press(geom.point_of(10.0, 30.0)), "elsewhere", ""), "people")
}

// **A press reaches a control that is not a tab stop.** A scroll bar is the one control in the
// set that a pointer can work and Tab cannot reach, so a router that looked for tab stops would
// leave it dead to the mouse -- and hand its press to someone else.
#[test]
fn a_press_reaches_a_control_the_keyboard_cannot() {
    val bar = widget.layout(
        controls.scroll_bar_widget(bar(), 12.0, 100.0, bar_content, bar_view, 0.0, frame()),
        bar_box,
        metrics()
    )
    test.assert_len(0, focus.controls(bar))
    test.assert_eq(controls.target(bar, controls.Input.Press(geom.point_of(6.0, 50.0)), "elsewhere", ""), "scroll")
}

// --- what a reader is told, which is the reason F275 came first

// What a reader would say about the control named `name` in a tree built from `w`. A sentinel
// rather than a failure for a missing node, because `test.fail` answers nothing and so cannot be a
// switch arm's value -- and a sentinel reads better in the diff anyway.
fn said_of(w: widget.Widget, name: string) -> string {
    val l = widget.layout(w, geom.rect_of(0.0, 0.0, 200.0, 40.0), metrics())
    return switch a11y.node_of(a11y.tree_of(l, "Records", ""), name) {
        Some(one) { a11y.announce(one) }
        None { concat("(no node named ", name, ")") }
    }
}

// The accessible name alone, for the one case that is about the name rather than the whole line.
fn name_of(w: widget.Widget, name: string) -> string {
    val l = widget.layout(w, geom.rect_of(0.0, 0.0, 200.0, 40.0), metrics())
    return switch a11y.node_of(a11y.tree_of(l, "Records", ""), name) {
        Some(one) { one.name }
        None { concat("(no node named ", name, ")") }
    }
}

// **A button built here announces itself correctly with nothing else declared**, which is the whole
// return on F275 being ordered before F277: the role is a field of the widget, so a control cannot
// be built without one.
#[test]
fn a_button_announces_itself_as_a_button() {
    test.assert_eq(
        said_of(controls.button_widget(controls.button_of("save", "Save"), frame()), "save"),
        "button, Save"
    )
}

#[test]
fn a_disabled_button_announces_that_it_is_dimmed() {
    val off = with controls.button_of("save", "Save") { disabled: true }
    test.assert_eq(
        said_of(controls.button_widget(off, frame()), "save"),
        "button, Save, dimmed"
    )
}

// **A check box declares its label rather than taking it from the text inside**, because the text
// inside is the mark as well as the label: without the declaration a reader would say
// "check box, x Notify me".
#[test]
fn a_check_box_does_not_read_its_own_mark_aloud() {
    val on = controls.check_box_of("notify", "Notify me", widget.Toggle.On)
    val style = theme.plain()
    // The name is the label exactly. Were the label not declared, `a11y` would take the name from
    // the text inside -- which is the mark and then the label -- and this would read "x Notify me".
    test.assert_eq(name_of(controls.check_box_widget(on, frame_in(style)), "notify"), "Notify me")
    test.assert_eq(said_of(controls.check_box_widget(on, frame_in(style)), "notify"), "check box, Notify me, checked")

    // The contrast, built by hand around the same children, which is what makes the line above an
    // assertion about the declaration rather than about the fixture: without it, the mark is read.
    val undeclared = widget.Widget.Control(widget.Focusable {
        name: "loud",
        role: widget.Role.CheckBox,
        label: "",
        description: "",
        value: "",
        state: widget.no_state(),
        focus_part: "",
        tab_stop: true,
        child: widget.row_of(2.0, [words("x"), words("Notify me")])
    })
    test.assert_eq(name_of(undeclared, "loud"), "x Notify me")
}

fn words(text: string) -> widget.Widget {
    return widget.label_of(text, 12.0, paint.black())
}

// A held button is a different tree from an unheld one -- the pressed face -- but the *same*
// announcement, because being held is not something a reader says.
#[test]
fn being_held_changes_nothing_a_reader_is_told() {
    val held = press(controls.button_of("save", "Save"), inside()).button
    test.assert(held.held)
    test.assert_eq(
        said_of(controls.button_widget(held, frame()), "save"),
        "button, Save"
    )
}

// --- the input predicate

#[test]
fn only_a_key_or_text_could_change_a_field() {
    test.assert(controls.is_text_input(controls.Input.Text("a")))
    test.assert(controls.is_text_input(controls.Input.KeyDown(key(letter_a))))
    test.assert_false(controls.is_text_input(controls.Input.Press(inside())))
    test.assert_false(controls.is_text_input(controls.Input.KeyUp(key(letter_a))))
}

// --- the text entry

// **What the plain look says these are**, now that they belong to the theme rather than to the
// module -- F293 moved them into `Style.space`, `Style.minimum` and `Style.stroke`. The names are
// kept so that every assertion below still reads as it did, and so that an assertion and the code
// it checks read the same number from the same place.
val bar_thickness = theme.plain().space.m
val divider_line = theme.plain().stroke.line
val divider_thickness = theme.plain().space.m
val min_column = theme.plain().minimum.target
val min_thumb = theme.plain().minimum.thumb
use controls.thumb_height
use controls.thumb_name
use controls.thumb_width
use edit

// Ten units per character, from `metrics()` above, so a caret after three characters sits at 30
// plus the field's left padding.
val char_width = 10.0

fn field() -> controls.Entry {
    return controls.entry_of("email", "Email", "ada@example.org")
}

fn style() -> controls.Style {
    return theme.plain()
}

// The resting frame: the look above, the metrics above, and nothing hovered, pressed or focused.
//
// **Named because it is what nearly every test here wants.** A test that cares about a state says
// so by filling one of the three names in -- `with frame() { hovered: "save" }` -- which is the
// same sentence an application writes.
fn frame() -> controls.Frame {
    return controls.frame_of(style(), metrics())
}

// A resting frame in some other look: the edged style, a density, a look under test.
fn frame_in(s: controls.Style) -> controls.Frame {
    return controls.frame_of(s, metrics())
}

// How tall one row of a list, a tree or a table is **here** -- in this file's metrics and style.
//
// **A function rather than the 20.0 these tests used to be written against.** A row is derived
// from the body text and the space scale now (Q8), so a test that kept the number would be
// asserting against a constant the library no longer has, and would go on passing while a theme
// that changed its type silently stopped fitting its own rows. The metrics here make a line twice
// the point size, so this is 24 + `space.s`.
fn row_tall() -> float {
    return controls.row_height(metrics(), style())
}

// The same for a table's header band: a line of label text and the medium step.
fn header_tall() -> float {
    return controls.header_height(metrics(), style())
}

// A point in the middle of row `n` of a list or a tree, `x` points in.
//
// **The middle of the row rather than a literal y**, which is what these tests meant all along:
// `point_of(10.0, 30.0)` said "row one" only while a row was twenty points tall, and a test that
// kept the literal would be asserting about an edge when what it is about is which row was
// pressed.
fn on_row(n: int, x: float) -> geom.Point {
    return geom.point_of(x, row_tall() * ((n as float) + 0.5))
}

// The same for a table, whose rows start below the header band.
fn in_body(n: int, x: float) -> geom.Point {
    return geom.point_of(x, header_tall() + row_tall() * ((n as float) + 0.5))
}

// Where a list scrolled to reveal row `n` at the bottom of `list_box` comes to rest.
fn creep_to(n: int) -> float {
    return row_tall() * ((n + 1) as float) - list_box().height
}

fn entry_box() -> geom.Rect {
    return geom.rect_of(0.0, 0.0, 300.0, 24.0)
}

fn give(e: controls.Entry, input: controls.Input) -> controls.EntryStep {
    return controls.entry_input(e, input, entry_box(), frame())
}

fn typing(e: controls.Entry, what: string) -> controls.EntryStep {
    return give(e, controls.Input.Text(what))
}

fn pressing(e: controls.Entry, name: string, k: controls.Key, control: bool, shift: bool) -> controls.EntryStep {
    val stroke = controls.Keystroke { key: k, shift: shift, control: control, alt: false, meta: false }
    val _ = name
    return give(e, controls.Input.KeyDown(stroke))
}

val key_left = controls.Key.Left
val key_right = controls.Key.Right
val key_home = controls.Key.Home
val key_backspace = controls.Key.Backspace
val letter_c = controls.Key.Char("c")
val letter_x = controls.Key.Char("x")
val letter_z = controls.Key.Char("z")

#[test]
fn typing_inserts_at_the_caret_and_reports_a_change() {
    val step = typing(controls.entry_of("n", "Name", "ab"), "c")
    test.assert_eq(step.entry.editor.text, "abc")
    test.assert(step.changed)
}

// **A caret move is not a change**, which is what a form watches to know it is dirty: a user who
// pressed an arrow key has not edited anything.
#[test]
fn moving_the_caret_is_not_a_change() {
    val step = pressing(field(), "Left", key_left, false, false)
    test.assert_false(step.changed)
    test.assert_eq(step.entry.editor.caret, 14)
}

#[test]
fn shift_with_an_arrow_selects() {
    val step = pressing(field(), "Left", key_left, false, true)
    test.assert(edit.has_selection(step.entry.editor))
    test.assert_eq(edit.selected_text(step.entry.editor), "g")
}

#[test]
fn control_with_an_arrow_moves_by_word() {
    val at_start = controls.entry_of("n", "Name", "one two")
    val start = with at_start { editor: edit.editor_of("one two") }
    test.assert_eq(pressing(start, "Left", key_left, true, false).entry.editor.caret, 4)
}

#[test]
fn backspace_deletes_and_control_backspace_takes_the_word() {
    test.assert_eq(pressing(field(), "Backspace", key_backspace, false, false).entry.editor.text, "ada@example.or")
    test.assert_eq(pressing(field(), "Backspace", key_backspace, true, false).entry.editor.text, "ada@example.")
}

// --- undo, and the run that makes it useful

// **A run of typed characters is one undo step.** Without this, Ctrl-Z after typing a word steps
// back a letter at a time, which is not what undo means to anyone. The rule is the one editors use:
// consecutive `Text` inserts coalesce and anything else ends the run.
#[test]
fn a_run_of_typing_undoes_as_one_word() {
    var e = controls.entry_of("n", "Name", "")
    e = typing(e, "a").entry
    e = typing(e, "d").entry
    e = typing(e, "a").entry
    test.assert_eq(e.editor.text, "ada")

    val back = pressing(e, "z", letter_z, true, false)
    test.assert_eq(back.entry.editor.text, "")
    test.assert(back.changed)
}

// And a caret move between two typed characters splits the run, which is the other half of the rule
// -- a user who moved the caret and typed again has made two edits, and one undo must not take
// both.
#[test]
fn a_caret_move_splits_a_typing_run() {
    var e = controls.entry_of("n", "Name", "")
    e = typing(e, "a").entry
    e = typing(e, "b").entry
    e = pressing(e, "Home", key_home, false, false).entry
    e = typing(e, "x").entry
    test.assert_eq(e.editor.text, "xab")

    val back = pressing(e, "z", letter_z, true, false)
    test.assert_eq(back.entry.editor.text, "ab")
}

// A paste is one step whatever its length, which is why it is its own input and not a `Text`.
#[test]
fn a_paste_is_one_undo_step() {
    var e = controls.entry_of("n", "Name", "")
    e = give(e, controls.Input.Paste("a long pasted string")).entry
    test.assert_eq(e.editor.text, "a long pasted string")
    test.assert_eq(pressing(e, "z", letter_z, true, false).entry.editor.text, "")
}

#[test]
fn an_undo_with_nothing_recorded_reports_no_change() {
    test.assert_false(pressing(field(), "z", letter_z, true, false).changed)
}

// --- the clipboard, which this layer cannot reach

// **Copy answers the text and changes nothing**: the module has no clipboard and must not pretend
// to, so the text comes out as an output and the application puts it somewhere.
#[test]
fn copy_answers_the_selection_and_changes_nothing() {
    val all = with field() { editor: edit.select_all(field().editor) }
    val step = pressing(all, "c", letter_c, true, false)
    test.assert_eq(step.copied, "ada@example.org")
    test.assert_false(step.changed)
    test.assert_eq(step.entry.editor.text, "ada@example.org")
}

#[test]
fn cut_answers_the_selection_and_removes_it() {
    val all = with field() { editor: edit.select_all(field().editor) }
    val step = pressing(all, "x", letter_x, true, false)
    test.assert_eq(step.copied, "ada@example.org")
    test.assert(step.changed)
    test.assert_eq(step.entry.editor.text, "")
}

// **Cutting from a read-only field is a copy rather than nothing.** The user asked for the text;
// refusing to hand it over is not what read-only means.
#[test]
fn cutting_from_a_read_only_field_still_copies() {
    val locked = with field() { editor: edit.select_all(field().editor), readonly: true }
    val step = pressing(locked, "x", letter_x, true, false)
    test.assert_eq(step.copied, "ada@example.org")
    test.assert_false(step.changed)
    test.assert_eq(step.entry.editor.text, "ada@example.org")
}

#[test]
fn a_read_only_field_moves_its_caret_but_does_not_change() {
    val locked = with field() { readonly: true }
    test.assert_false(typing(locked, "x").changed)
    test.assert_eq(typing(locked, "x").entry.editor.text, "ada@example.org")
    test.assert_eq(pressing(locked, "Left", key_left, false, false).entry.editor.caret, 14)
}

#[test]
fn a_disabled_field_does_nothing_at_all() {
    val off = with field() { disabled: true }
    test.assert_false(typing(off, "x").changed)
    test.assert_eq(give(off, controls.Input.Press(geom.point_of(50.0, 10.0))).entry.editor.caret, 15)
}

// --- the caret and the pointer

// **The nearest boundary, not the character the pixel is inside.** Clicking the left half of a
// character puts the caret before it and the right half after it, which is what a user means by
// clicking between two letters. Taking the character the pixel landed in makes the caret feel one
// place behind the pointer.
#[test]
fn a_click_puts_the_caret_at_the_nearest_boundary() {
    val m = metrics()
    val text = "abcd"
    test.assert_eq(controls.caret_at_x(text, 12.0, m, 0.0), 0)
    // Just inside the first character: still before it.
    test.assert_eq(controls.caret_at_x(text, 12.0, m, char_width * 0.4), 0)
    // Past its middle: after it.
    test.assert_eq(controls.caret_at_x(text, 12.0, m, char_width * 0.6), 1)
    test.assert_eq(controls.caret_at_x(text, 12.0, m, char_width * 2.5), 3)
    // Beyond the end clamps rather than failing.
    test.assert_eq(controls.caret_at_x(text, 12.0, m, 10000.0), 4)
    test.assert_eq(controls.caret_at_x(text, 12.0, m, 0.0 - 50.0), 0)
}

#[test]
fn a_press_places_the_caret_and_a_drag_selects() {
    val e = field()
    val left = style().padding.left
    val placed = give(e, controls.Input.Press(geom.point_of(left + char_width * 3.0, 10.0)))
    test.assert_eq(placed.entry.editor.caret, 3)
    test.assert(placed.entry.dragging)

    val dragged = give(placed.entry, controls.Input.Move(geom.point_of(left + char_width * 6.0, 10.0)))
    test.assert_eq(edit.selected_text(dragged.entry.editor), "@ex")

    val done = give(dragged.entry, controls.Input.Release(geom.point_of(left + char_width * 6.0, 10.0)))
    test.assert_false(done.entry.dragging)
}

// A move with no press before it changes nothing: the pointer crossing a field must not select.
#[test]
fn moving_without_a_press_selects_nothing() {
    val step = give(field(), controls.Input.Move(geom.point_of(50.0, 10.0)))
    test.assert_false(edit.has_selection(step.entry.editor))
}

// --- the caret in the laid-out tree

// Finds the caret's box by the name it carries.
fn caret_x(e: controls.Entry) -> float {
    val w = controls.entry_widget(e, frame())
    val l = widget.layout(w, geom.rect_of(0.0, 0.0, 300.0, 24.0), metrics())
    return found_x(l)
}

fn found_x(l: widget.Laid) -> float {
    if l.name == caret_name {
        return l.bounds.x
    }
    for child in l.children {
        val x = found_x(child)
        if x >= 0.0 {
            return x
        }
    }
    return 0.0 - 1.0
}

// **The caret is placed by the layout, and this is the check that the two directions agree.** The
// widget puts a one-unit box between the text before the caret and the text after it, so the same
// metrics that measure the text place the caret; `caret_at_x` then has to answer the same index
// from that x. Computing a caret's position separately from the text is how a caret ends up half a
// character off in one font and right in another -- and a round trip is the only test that catches
// a disagreement rather than restating one side of it.
#[test]
fn the_drawn_caret_and_the_clicked_caret_agree() {
    val e = field()
    val width = widget.face_at(metrics(), 0).text_width
    var at = 0
    while at <= len(e.editor.text) {
        val placed = with e { editor: edit.place_caret(e.editor, at, false) }
        val x = caret_x(placed)
        // **Exactly where the measured text ends, with no tolerance.** The round trip below is the
        // weaker half of this and on its own it is nearly useless: `caret_at_x` snaps to the
        // nearest boundary, so it answers the right index for anything within half a character --
        // which is precisely the drift this case exists to catch. Adding two units of spacing to
        // the widget's row left the round trip passing and fails this line, which is how that was
        // found.
        test.assert_eq(x, style().padding.left + width(substring(e.editor.text, 0, at), style().text.body.size))
        // And the inverse agrees, which is the direction a click travels.
        test.assert_eq(
            controls.caret_at_x(e.editor.text, style().text.body.size, metrics(), x - style().padding.left),
            at
        )
        at = at + 1
    }
}

#[test]
fn a_selection_is_drawn_instead_of_a_caret() {
    val selected = with field() { editor: edit.select_all(field().editor) }
    val w = controls.entry_widget(selected, frame())
    val l = widget.layout(w, geom.rect_of(0.0, 0.0, 300.0, 24.0), metrics())
    // No caret box at all when there is a selection: the selected run carries a background instead.
    test.assert_eq(found_x(l), 0.0 - 1.0)
}

// --- what a reader is told about a field

// **A field's label is declared and its text is its value**, so a reader says the name and then the
// contents. A field that took its name from the text inside would introduce itself as whatever the
// user last typed.
#[test]
fn a_field_announces_its_label_then_its_value() {
    val l = widget.layout(
        controls.entry_widget(field(), frame()),
        geom.rect_of(0.0, 0.0, 300.0, 24.0),
        metrics()
    )
    val said = switch a11y.node_of(a11y.tree_of(l, "Contacts", ""), "email") {
        Some(one) { a11y.announce(one) }
        None { "(no node)" }
    }
    test.assert_eq(said, "text field, Email, ada@example.org")
}

#[test]
fn a_read_only_field_says_so() {
    val locked = with field() { readonly: true }
    val l = widget.layout(
        controls.entry_widget(locked, frame()),
        geom.rect_of(0.0, 0.0, 300.0, 24.0),
        metrics()
    )
    val said = switch a11y.node_of(a11y.tree_of(l, "Contacts", ""), "email") {
        Some(one) { a11y.announce(one) }
        None { "(no node)" }
    }
    test.assert_eq(said, "text field, Email, ada@example.org, read only")
}

// --- the list

// Five rows in a box 60 tall: two whole rows visible at this density, three below.
fn five() -> controls.List {
    return controls.list_of("people", "People", ["Ada", "Grace", "Alan", "Edsger", "Barbara"])
}

fn list_box() -> geom.Rect {
    return geom.rect_of(0.0, 0.0, 120.0, 60.0)
}

fn to_list(l: controls.List, input: controls.Input) -> controls.ListStep {
    return controls.list_input(l, input, list_box(), frame())
}

fn arrow(l: controls.List, k: controls.Key) -> controls.ListStep {
    return to_list(l, controls.Input.KeyDown(key(k)))
}

val key_down = controls.Key.Down
val key_up = controls.Key.Up
val key_page_down = controls.Key.PageDown
val key_end = controls.Key.End

#[test]
fn a_new_list_selects_its_first_row_and_an_empty_one_selects_nothing() {
    test.assert_eq(five().selected, 0)
    test.assert_eq(controls.list_of("empty", "Nothing", controls.no_values()).selected, 0 - 1)
}

#[test]
fn the_arrows_move_the_selection_and_stop_at_both_ends() {
    val down = arrow(five(), key_down)
    test.assert_eq(down.list.selected, 1)
    test.assert(down.moved)
    // Up from the first row stays, and reports that nothing moved.
    val stuck = arrow(five(), key_up)
    test.assert_eq(stuck.list.selected, 0)
    test.assert_false(stuck.moved)
    test.assert_eq(arrow(with five() { selected: 4 }, key_down).list.selected, 4)
}

// **The view follows the selection by the least that works.** Two whole rows fit in 60, so the
// first arrow moves the selection with the list still at the top, and every one after it scrolls
// by what the row needs rather than by a page.
#[test]
fn arrowing_down_creeps_the_view_rather_than_jumping() {
    var l = five()
    l = arrow(l, key_down).list
    test.assert_eq(l.selected, 1)
    test.assert_eq(l.offset, 0.0)
    l = arrow(l, key_down).list
    test.assert_eq(l.selected, 2)
    test.assert_eq(l.offset, creep_to(2))
    l = arrow(l, key_down).list
    test.assert_eq(l.selected, 3)
    test.assert_eq(l.offset, creep_to(3))
    l = arrow(l, key_down).list
    test.assert_eq(l.selected, 4)
    test.assert_eq(l.offset, creep_to(4))
}

#[test]
fn end_and_page_down_also_bring_the_selection_into_view() {
    val ended = arrow(five(), key_end)
    test.assert_eq(ended.list.selected, 4)
    test.assert_eq(ended.list.offset, creep_to(4))
    // A page is what fits whole, so one PageDown lands two rows down and scrolls to show it.
    val paged = arrow(five(), key_page_down)
    test.assert_eq(paged.list.selected, 2)
    test.assert_eq(paged.list.offset, creep_to(2))
}

// **The wheel scrolls and does not move the selection.** Routing a wheel to whatever has the
// keyboard is the easy mistake: a user scrolling to look further down has not asked to select
// anything, and moving the selection under them loses the row they were about to act on.
#[test]
fn the_wheel_scrolls_without_moving_the_selection() {
    val step = to_list(five(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(10.0, 10.0),
        vertical: 0 - 1,
        horizontal: 0
    }))
    test.assert_eq(step.list.offset, row_tall())
    test.assert_eq(step.list.selected, 0)
    test.assert_false(step.moved)
}

// And it stops at both ends: five rows in a view of 60, so the last row's bottom edge is as far as
// it goes.
#[test]
fn the_wheel_stops_at_both_ends() {
    var l = five()
    var i = 0
    while i < 20 {
        l = to_list(l, controls.Input.Wheel(controls.Wheel {
            at: geom.point_of(10.0, 10.0),
            vertical: 0 - 1,
            horizontal: 0
        })).list
        i = i + 1
    }
    test.assert_eq(l.offset, creep_to(4))
    var j = 0
    while j < 20 {
        l = to_list(l, controls.Input.Wheel(controls.Wheel {
            at: geom.point_of(10.0, 10.0),
            vertical: 1,
            horizontal: 0
        })).list
        j = j + 1
    }
    test.assert_eq(l.offset, 0.0)
}

// A click selects the row under the pointer, **through the scroll offset**: with the list scrolled
// by two rows, the top of the box is row 2.
#[test]
fn a_click_selects_the_row_under_the_pointer_through_the_offset() {
    test.assert_eq(to_list(five(), controls.Input.Press(on_row(1, 10.0))).list.selected, 1)
    val scrolled = with five() { offset: row_tall() * 2.0 }
    test.assert_eq(to_list(scrolled, controls.Input.Press(geom.point_of(10.0, 10.0))).list.selected, 2)
}

#[test]
fn a_click_past_the_last_row_changes_nothing() {
    val step = to_list(with five() { items: [controls.Value.Text("Ada")] }, controls.Input.Press(on_row(1, 10.0)))
    test.assert_eq(step.list.selected, 0)
    test.assert_false(step.moved)
}

// **Selecting a row and opening it are different intentions.** A list that reported them as one
// would open a record on every arrow key.
#[test]
fn enter_activates_and_an_arrow_does_not() {
    test.assert(arrow(five(), enter).activated)
    test.assert_false(arrow(five(), key_down).activated)
    test.assert_false(arrow(five(), enter).moved)
}

#[test]
fn a_disabled_list_ignores_everything() {
    val off = with five() { disabled: true }
    test.assert_eq(arrow(off, key_down).list.selected, 0)
    test.assert_false(to_list(off, controls.Input.Press(geom.point_of(10.0, 30.0))).moved)
}

// --- one tab stop, five nodes

fn laid_list(l: controls.List) -> widget.Laid {
    return widget.layout(controls.list_widget(l, frame()), list_box(), metrics())
}

// **The whole reason `tab_stop` exists.** Tab sees one control; a reader sees the list and every
// row. Before the distinction, a list was either five stops in the tab order or a single node whose
// name was all five rows run together.
#[test]
fn a_list_is_one_tab_stop_and_five_accessibility_nodes() {
    val l = laid_list(five())
    test.assert_len(1, focus.controls(l))
    test.assert_eq(focus.controls(l)[0].name, "people")

    val t = a11y.tree_of(l, "Records", "people")
    // The window, the list, and one node per row.
    test.assert_len(7, t.nodes)
    test.assert_len(1, a11y.reachable(t))
}

#[test]
fn the_selected_row_says_so_and_the_others_do_not() {
    val t = a11y.tree_of(laid_list(with five() { selected: 1 }), "Records", "people")
    test.assert_eq(said_in(t, "people/1"), "list item, Grace, selected")
    test.assert_eq(said_in(t, "people/0"), "list item, Ada")
}

fn said_in(t: a11y.Tree, key: string) -> string {
    return switch a11y.node_of(t, key) {
        Some(one) { a11y.announce(one) }
        None { concat("(no node ", key, ")") }
    }
}

// **A click on a row leaves the focus on the list**, because the row is not a tab stop and focusing
// it would put the focus somewhere Tab could never return to. `focus.control_at` still answers the
// row, which is what tells the list which row was clicked.
#[test]
fn clicking_a_row_focuses_the_list_and_reports_the_row() {
    val l = laid_list(five())
    val at = on_row(1, 10.0)
    test.assert_eq(focus.clicked(l, at, ""), "people")
    test.assert_eq(switch focus.control_at(l, at) {
        Some(one) { one.name }
        None { "(none)" }
    }, "people/1")
}

// A row scrolled out of the list's own viewport cannot be clicked, which is the viewport's rule
// arriving here for free.
#[test]
fn a_row_scrolled_out_of_the_list_cannot_be_clicked() {
    val l = laid_list(with five() { offset: row_tall() * 2.0 })
    // The list is two rows down, so the top of the box is row 2 and row 0 is above it.
    test.assert_eq(switch focus.control_at(l, geom.point_of(10.0, 10.0)) {
        Some(one) { one.name }
        None { "(none)" }
    }, "people/2")
    test.assert(Option.is_None(a11y.node_of(a11y.tree_of(l, "R", ""), "people/9")))
}

// --- menus

fn file_menu() -> controls.Menu {
    return controls.menu_of("file", "File", ["New", "Open", "Save"])
}

val title_box = geom.rect_of(0.0, 0.0, 40.0, 20.0)

fn popup_box() -> geom.Rect {
    return geom.rect_of(0.0, 20.0, 80.0, 60.0)
}

fn to_menu(m: controls.Menu, input: controls.Input) -> controls.MenuStep {
    return controls.menu_input(m, input, title_box, popup_box(), frame())
}

fn menu_key(m: controls.Menu, k: controls.Key) -> controls.MenuStep {
    return to_menu(m, controls.Input.KeyDown(key(k)))
}

val key_escape = controls.Key.Escape

// **A menu bar opens on the way down**, which is what lets a user press and drag onto an item in
// one gesture rather than having to click twice.
#[test]
fn a_press_on_the_title_opens_it_and_lands_on_the_first_item() {
    val step = to_menu(file_menu(), controls.Input.Press(geom.point_of(10.0, 10.0)))
    test.assert(step.menu.open)
    test.assert_eq(step.menu.items.selected, 0)
    test.assert_eq(step.chosen, 0 - 1)
}

#[test]
fn down_opens_it_from_the_keyboard_and_a_press_elsewhere_does_not() {
    test.assert(menu_key(file_menu(), key_down).menu.open)
    test.assert_false(to_menu(file_menu(), controls.Input.Press(geom.point_of(200.0, 200.0))).menu.open)
}

// The arrows inside an open menu are the list's, which is the whole reason a menu holds one.
#[test]
fn the_arrows_move_within_an_open_menu() {
    val open = menu_key(file_menu(), key_down).menu
    val moved = menu_key(open, key_down)
    test.assert_eq(moved.menu.items.selected, 1)
    test.assert(moved.menu.open)
}

#[test]
fn enter_chooses_the_highlighted_item_and_closes() {
    var m = menu_key(file_menu(), key_down).menu
    m = menu_key(m, key_down).menu
    val step = menu_key(m, enter)
    test.assert_eq(step.chosen, 1)
    test.assert_false(step.menu.open)
    test.assert_false(step.dismissed)
}

// **Escape closes without choosing, and a dismissal is not a choice of nothing.** A caller that
// treated them alike would act on the user backing out.
#[test]
fn escape_dismisses_without_choosing() {
    val open = menu_key(file_menu(), key_down).menu
    val step = menu_key(open, key_escape)
    test.assert_false(step.menu.open)
    test.assert(step.dismissed)
    test.assert_eq(step.chosen, 0 - 1)
}

// **A click away from both boxes dismisses it**, which is what a placed layer letting clicks
// through is for: the click reaches whatever was beneath as well, and closing is this module's half.
#[test]
fn a_click_away_from_an_open_menu_dismisses_it() {
    val open = menu_key(file_menu(), key_down).menu
    val step = to_menu(open, controls.Input.Press(geom.point_of(300.0, 300.0)))
    test.assert_false(step.menu.open)
    test.assert(step.dismissed)
}

// And a second press on the title closes it, as every menu bar does.
#[test]
fn a_second_press_on_the_title_closes_it() {
    val open = menu_key(file_menu(), key_down).menu
    val step = to_menu(open, controls.Input.Press(geom.point_of(10.0, 10.0)))
    test.assert_false(step.menu.open)
    test.assert(step.dismissed)
}

#[test]
fn a_click_on_a_row_of_an_open_menu_highlights_it() {
    val open = menu_key(file_menu(), key_down).menu
    val step = to_menu(open, controls.Input.Press(geom.point_of(10.0, 50.0)))
    test.assert(step.menu.open)
    test.assert_eq(step.menu.items.selected, 1)
}

#[test]
fn a_disabled_menu_does_not_open() {
    val off = with file_menu() { disabled: true }
    test.assert_false(to_menu(off, controls.Input.Press(geom.point_of(10.0, 10.0))).menu.open)
    test.assert_false(menu_key(off, key_down).menu.open)
}

// **A menu announces that it is a menu and whether it is open**, which is the state a reader needs
// to tell a user whether pressing Down will do anything.
#[test]
fn a_menu_title_says_whether_it_is_expanded() {
    val style = theme.plain()
    test.assert_eq(said_of(controls.menu_title_widget(file_menu(), frame_in(style)), "file"), "menu, File, collapsed")
    val open = menu_key(file_menu(), key_down).menu
    test.assert_eq(said_of(controls.menu_title_widget(open, frame_in(style)), "file"), "menu, File, expanded")
}

// The popup's rows are menu items and not list items, which is the only thing a menu changed about
// the list it reuses.
#[test]
fn the_popup_rows_are_menu_items() {
    val open = menu_key(file_menu(), key_down).menu
    val l = widget.layout(
        widget.layered_of([widget.base_layer(widget.Widget.Nothing),
            controls.menu_popup_layer(open, popup_box(), frame())]),
        geom.rect_of(0.0, 0.0, 120.0, 100.0),
        metrics()
    )
    val t = a11y.tree_of(l, "Records", "")
    test.assert_eq(said_in(t, "file/items"), "menu, File")
    test.assert_eq(said_in(t, "file/items/0"), "menu item, New, selected")
    test.assert_eq(said_in(t, "file/items/1"), "menu item, Open")
}

// --- dialogs

fn answer(input: controls.Input) -> string {
    return switch controls.dialog_keys(input) {
        Confirm { "confirm" }
        Cancel { "cancel" }
        Nothing { "nothing" }
    }
}

// **Escape cancels and Enter confirms** -- the two keys a dialog owes a user who never reaches for
// the mouse.
#[test]
fn a_dialog_answers_escape_and_enter() {
    test.assert_eq(answer(controls.Input.KeyDown(key(key_escape))), "cancel")
    test.assert_eq(answer(controls.Input.KeyDown(key(enter))), "confirm")
    test.assert_eq(answer(controls.Input.KeyDown(key(letter_a))), "nothing")
    test.assert_eq(answer(controls.Input.Press(inside())), "nothing")
    // On the way down only: a key *up* must not confirm a dialog the keystroke opened.
    test.assert_eq(answer(controls.Input.KeyUp(key(enter))), "nothing")
}

// **A dialog shuts the window out of the keyboard and the pointer both.** The geometry does the
// pointer and `takes_keys` does Tab, and this is the case that holds the pair together.
#[test]
fn a_dialog_traps_the_window_behind_it() {
    val style = theme.plain()
    val behind = controls.button_widget(controls.button_of("save", "Save"), frame_in(style))
    val inside_it = controls.button_widget(controls.button_of("ok", "OK"), frame_in(style))
    val l = widget.layout(
        widget.layered_of([
            widget.base_layer(behind),
            controls.dialog_layer("confirm", "Discard changes?", inside_it, frame_in(style))
        ]),
        geom.rect_of(0.0, 0.0, 200.0, 120.0),
        metrics()
    )
    // Tab holds only what is inside.
    test.assert_len(1, focus.controls(l))
    test.assert_eq(focus.controls(l)[0].name, "ok")
    // And a reader is told the same.
    val t = a11y.tree_of(l, "Records", "ok")
    test.assert(Option.is_None(a11y.node_of(t, "save")))
    test.assert_eq(said_in(t, "confirm"), "dialog, Discard changes?")
}

// ---- a text area
//
// **The whole of multi-line is three keys and a column of lines**, so the cases that matter are the
// ones where a field and an area must differ, and the one where they must not.

fn area(text: string) -> controls.Entry {
    return controls.text_area_of("body", "Body", text, 6)
}

fn press(key: controls.Key) -> controls.Input {
    return controls.Input.KeyDown(controls.keystroke_of(key))
}

val anywhere = geom.rect_of(0.0, 0.0, 200.0, 100.0)

#[test]
fn enter_types_a_newline_in_an_area() {
    val step = controls.entry_input(
        area("ab"),
        press(controls.Key.Enter),
        anywhere,
        frame()
    )
    test.assert_eq("ab\n", step.entry.editor.text)
    test.assert(step.changed)
}

// **A one-line field must leave Enter alone**, because it is the key a default button answers. A
// field that swallowed it would break every form that has one.
#[test]
fn enter_is_untouched_in_a_one_line_field() {
    val step = controls.entry_input(
        controls.entry_of("name", "Name", "ab"),
        press(controls.Key.Enter),
        anywhere,
        frame()
    )
    test.assert_eq("ab", step.entry.editor.text)
    test.assert_false(step.changed)
}

#[test]
fn up_and_down_move_by_line_in_an_area_and_do_nothing_in_a_field() {
    val two = area(concat("abcd", "\n", "efgh"))
    val placed = with two { editor: edit.place_caret(two.editor, 2, false) }
    val down = controls.entry_input(placed, press(controls.Key.Down), anywhere, frame())
    test.assert_eq(7, down.entry.editor.caret)
    val field = controls.entry_of("name", "Name", "abcd")
    val still = controls.entry_input(field, press(controls.Key.Down), anywhere, frame())
    test.assert_eq(field.editor.caret, still.entry.editor.caret)
}

// Home and End are per line for both, which is not a difference between them: it follows from
// `edit.move_home` being line-aware, and for a field with no newline it is what it always was.
#[test]
fn home_is_the_start_of_the_line_not_of_the_text() {
    val a = area(concat("one", "\n", "two"))
    val placed = with a { editor: edit.place_caret(a.editor, 5, false) }
    val home = controls.entry_input(placed, press(controls.Key.Home), anywhere, frame())
    test.assert_eq(4, home.entry.editor.caret)
}

#[test]
fn an_area_announces_itself_as_multiline() {
    val w = controls.entry_widget(area("x"), frame())
    val laid = widget.layout(w, geom.rect_of(0.0, 0.0, 200.0, 100.0), metrics())
    val tree = a11y.tree_of(laid, "form", "body")
    if Some(node) = a11y.node_of(tree, "body") {
        test.assert(node.state.multiline)
    } else {
        test.fail("the area is not in the accessibility tree")
    }
}

// ---- a menu's collapsed text, now that a picker is not one
//
// **The picker moved out on 2026-11-16** (`ComboBox`), so what is left here is the menu's half of
// the pair: a menu shows its title and holds no value. The tests that were here for `choice_of`
// are the combo box's own, further down, and they test more than these could -- a closed picker's
// keyboard did not exist while it was a menu.

#[test]
fn a_menu_shows_its_title() {
    val menu = controls.menu_of("file", "File", ["Open", "Save"])
    test.assert_eq("File", controls.collapsed_text(menu))
}

// **Nothing chosen shows the label, not an empty box.** A picker that rendered blank looks broken
// rather than unset, and -1 is what `combo_box_of` stores for an out-of-range index. The
// accessibility node still publishes "" -- a reader must hear that nothing is chosen, where an eye
// needs something in the box to read.
#[test]
fn a_combo_box_with_nothing_chosen_shows_its_label() {
    val empty = controls.combo_box_of("env", "Environment", ["global"], 0 - 1)
    test.assert_eq("Environment", controls.combo_box_text(empty))
    test.assert_eq("", controls.combo_box_value(empty))
    val past_the_end = controls.combo_box_of("env", "Environment", ["global"], 7)
    test.assert_eq("Environment", controls.combo_box_text(past_the_end))
    test.assert_eq("", controls.combo_box_value(past_the_end))
}

// **Choosing moves the collapsed text with it**, which is the point of reading the value from the
// list's selection rather than storing it: there is no second place to update and so no way for the
// two to disagree.
#[test]
fn choosing_from_a_combo_box_changes_what_it_shows() {
    val open_box = with controls.combo_box_of("env", "Environment", ["global", "staging"], 0) {
        open: true
    }
    val moved = combo_key(open_box, controls.Key.Down, false)
    test.assert_eq(1, moved.combo.items.selected)
    // The collapsed text follows the selection even before the item is chosen, which is what a
    // dropdown does while you arrow through it.
    test.assert_eq("staging", controls.combo_box_text(moved.combo))
    val taken = combo_key(moved.combo, controls.Key.Enter, false)
    test.assert_eq(1, taken.chosen)
    test.assert_eq("staging", controls.combo_box_value(taken.combo))
}

// **Choosing with the mouse**, which was keyboard-only until a real application tried it: a press
// on a row moved the selection and nothing turned that into a choice, so a menu could be opened,
// an item clicked, and the menu would sit there with the item highlighted.
#[test]
fn a_release_over_a_row_chooses_it() {
    val open_menu = with file_menu() { open: true }
    val on_row = geom.point_of(10.0, 50.0)
    val pressed = to_menu(open_menu, controls.Input.Press(on_row))
    // The press selects and does not choose, which is what lets a press-drag-release land elsewhere.
    test.assert_eq(0 - 1, pressed.chosen)
    test.assert(pressed.menu.open)
    val released = to_menu(pressed.menu, controls.Input.Release(on_row))
    test.assert_eq(pressed.menu.items.selected, released.chosen)
    test.assert_false(released.menu.open)
}

// A release outside the popup is not a choice -- which is the case that matters for the press that
// opened the menu in the first place, since its release lands on the title.
#[test]
fn a_release_off_the_popup_chooses_nothing() {
    val open_menu = with file_menu() { open: true }
    val released = to_menu(open_menu, controls.Input.Release(geom.point_of(10.0, 10.0)))
    test.assert_eq(0 - 1, released.chosen)
    test.assert(released.menu.open)
}

// **A text area scrolls itself to keep the caret in view**, which a one-line field has no need of
// and must not do. The case that matters is that *everything* moving the caret scrolls -- naming
// the movement keys is how a text area ends up with a scroll that works for Down and not for typing.
#[test]
fn a_text_area_scrolls_to_follow_its_caret() {
    val view_box = geom.rect_of(0.0, 0.0, 200.0, 40.0)
    val many = concat("a\nb\nc\nd\ne\nf\ng\nh\ni\nj")
    val tall = with area(many) { editor: edit.place_caret(edit.editor_of(many), 0, false) }
    test.assert_eq(0.0, tall.scroll)
    // End of the text: the last line is far below a 40 point box, so the view has to move.
    val toEnd = controls.entry_input(tall, press(controls.Key.End), view_box, frame())
    val down = controls.entry_input(
        with toEnd.entry { editor: edit.place_caret(toEnd.entry.editor, len(many), false) },
        press(controls.Key.Right),
        box,
        frame()
    )
    test.assert(down.entry.scroll > 0.0)
}

#[test]
fn a_one_line_field_never_scrolls() {
    val view_box = geom.rect_of(0.0, 0.0, 200.0, 20.0)
    val field = controls.entry_of("name", "Name", "a long value that will not fit in the box at all")
    val step = controls.entry_input(field, press(controls.Key.End), view_box, frame())
    test.assert_eq(0.0, step.entry.scroll)
}

// Typing moves the view as surely as an arrow does: a run of newlines walks off the bottom.
#[test]
fn typing_scrolls_a_text_area_too() {
    val view_box = geom.rect_of(0.0, 0.0, 200.0, 40.0)
    var a = area("")
    var i = 0
    while i < 12 {
        val step = controls.entry_input(a, press(controls.Key.Enter), view_box, frame())
        a = step.entry
        i = i + 1
    }
    test.assert(a.scroll > 0.0)
}

// ---- the focus ring
//
// **Nothing drew the focus, which a keyboard user needs to see.** Tab moved it, every control took
// its keys, and the window looked identical either way -- so the only way to find out what was
// focused was to type into something. These assert the ring is drawn, is drawn once, and follows
// the focus rather than sitting wherever the first control is.

fn ring_count(scene_now: scene.Scene) -> int {
    var strokes = 0
    for op in scene_now.ops {
        switch op {
            StrokePath(_) { strokes = strokes + 1 }
            Fill(_) { unit }
            Text(_) { unit }
            DrawImage(_) { unit }
            Nested(_) { unit }
        }
    }
    return strokes
}

fn two_fields() -> widget.Laid {
    val style = theme.plain()
    val tree = widget.column_of(4.0, [
        widget.fixed_of(0.0, 20.0, controls.entry_widget(controls.entry_of("one", "One", "a"), frame_in(style))),
        widget.fixed_of(0.0, 20.0, controls.entry_widget(controls.entry_of("two", "Two", "b"), frame_in(style)))
    ])
    return widget.layout(tree, geom.rect_of(0.0, 0.0, 100.0, 60.0), metrics())
}

#[test]
fn the_focus_ring_is_drawn_once_around_the_focused_control() {
    val laid = two_fields()
    test.assert_eq(0, ring_count(widget.paint(laid, metrics())))
    val ringed = widget.paint_focused(laid, metrics(), "two", paint.rgb(0.0, 0.4, 0.9), 2.0)
    test.assert_eq(1, ring_count(ringed))
}

// **A name the tree does not hold draws nothing rather than refusing**, because a focus naming a
// control that is gone is an ordinary moment between two frames: a row was removed, a dialog
// closed. Refusing there would make a repaint fail for a reason the user cannot see.
#[test]
fn an_unknown_focus_draws_no_ring() {
    test.assert_eq(0, ring_count(widget.paint_focused(two_fields(), metrics(), "gone", paint.rgb(0.0, 0.0, 0.0), 2.0)))
}

// The ring has to move with the focus, not merely exist: a ring that always framed the first
// control would pass the count above and tell a user nothing.
#[test]
fn the_ring_follows_the_focus() {
    val laid = two_fields()
    val first = widget.paint_focused(laid, metrics(), "one", paint.rgb(0.0, 0.0, 0.0), 2.0)
    val second = widget.paint_focused(laid, metrics(), "two", paint.rgb(0.0, 0.0, 0.0), 2.0)
    test.assert_false(format("{}", first.ops) == format("{}", second.ops))
}

// **A dialog draws a scrim over the window behind it**, which it did not until an application
// opened one: a modal layer took the keys and drew nothing, so the dialog was text floating on the
// window it was blocking and nothing said which half was live.
#[test]
fn a_dialog_covers_what_it_blocks() {
    val style = theme.plain()
    val dialog = controls.dialog_layer(
        "ask",
        "Are you sure?",
        widget.label_of("yes or no", 12.0, paint.black()),
        frame_in(style)
    )
    val laid = widget.layout(widget.layered_of([
        widget.base_layer(widget.label_of("behind", 12.0, paint.black())),
        dialog
    ]), geom.rect_of(0.0, 0.0, 200.0, 100.0), metrics())
    val painted = widget.paint(laid, metrics())
    // The scrim is a fill the size of the window. Without it the dialog's own face is the only
    // fill, and that is the size of the dialog.
    var full_width_fills = 0
    for op in painted.ops {
        switch op {
            Fill(f) {
                val fill_box = shape.path_bounds(f.path)
                if fill_box.width >= 200.0 && fill_box.height >= 100.0 {
                    full_width_fills = full_width_fills + 1
                }
            }
            StrokePath(_) { unit }
            Text(_) { unit }
            DrawImage(_) { unit }
            Nested(_) { unit }
        }
    }
    test.assert_eq(1, full_width_fills)
}

// **Translucent, not opaque**: a modal dialog should say "this is waiting for you" rather than "the
// window is gone", and a user needs to see what they were doing to decide what to answer.
#[test]
fn the_scrim_is_translucent() {
    test.assert(theme.plain().scrim.alpha > 0.0)
    test.assert(theme.plain().scrim.alpha < 1.0)
}

// --------------------------------------------------------------- the tab strip

fn panes() -> controls.Tabs {
    return with controls.tabs_of("panes", "Panes", ["Response", "History", "Timing"]) {
        tab_width: 50.0
    }
}

val strip_box = geom.rect_of(0.0, 0.0, 300.0, 24.0)

fn to_tabs(t: controls.Tabs, input: controls.Input) -> controls.TabStep {
    return controls.tabs_input(t, input, strip_box)
}

fn tab_arrow(t: controls.Tabs, k: controls.Key) -> controls.TabStep {
    return to_tabs(t, controls.Input.KeyDown(controls.keystroke_of(k)))
}

#[test]
fn a_press_chooses_the_tab_it_landed_on() {
    val step = to_tabs(panes(), controls.Input.Press(geom.point_of(75.0, 10.0)))
    test.assert_eq(1, step.tabs.selected)
    test.assert(step.moved)
}

// `moved` is what the application acts on, so a press on the tab already showing must not report
// one: a pane that reloaded itself every time a user clicked where they already were would do the
// expensive thing on the one gesture that asks for nothing.
#[test]
fn pressing_the_selected_tab_moves_nothing() {
    val step = to_tabs(panes(), controls.Input.Press(geom.point_of(25.0, 10.0)))
    test.assert_eq(0, step.tabs.selected)
    test.assert_false(step.moved)
}

// A strip is usually narrower than the row it sits in, and the space past the last tab belongs to
// nothing. Dividing the whole box by `tab_width` would make that space tab 3, 4 and 5.
#[test]
fn a_press_past_the_last_tab_chooses_nothing() {
    val step = to_tabs(panes(), controls.Input.Press(geom.point_of(280.0, 10.0)))
    test.assert_eq(0, step.tabs.selected)
    test.assert_false(step.moved)
}

#[test]
fn the_arrows_walk_the_strip_and_stop_at_its_ends() {
    test.assert_eq(1, tab_arrow(panes(), controls.Key.Right).tabs.selected)
    test.assert_eq(0, tab_arrow(panes(), controls.Key.Left).tabs.selected)
    test.assert_eq(2, tab_arrow(panes(), controls.Key.End).tabs.selected)
    test.assert_eq(0, tab_arrow(with panes() { selected: 2 }, controls.Key.Home).tabs.selected)
}

// Clamped, not wrapped -- and the clamp has to report `moved: false`, or a Right held down at the
// end of the strip reloads the last pane as fast as the keyboard repeats.
#[test]
fn the_end_of_the_strip_is_a_place_you_can_feel() {
    val step = tab_arrow(with panes() { selected: 2 }, controls.Key.Right)
    test.assert_eq(2, step.tabs.selected)
    test.assert_false(step.moved)
}

// Some toolkits cycle the tabs with the wheel. The result is a user scrolling a page and changing
// what the page is, which is why this one does not.
#[test]
fn a_wheel_over_the_strip_changes_nothing() {
    val step = to_tabs(panes(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(75.0, 10.0),
        vertical: 0 - 1,
        horizontal: 0
    }))
    test.assert_eq(0, step.tabs.selected)
    test.assert_false(step.moved)
}

#[test]
fn a_disabled_strip_ignores_everything() {
    val off = with panes() { disabled: true }
    test.assert_false(to_tabs(off, controls.Input.Press(geom.point_of(75.0, 10.0))).moved)
    test.assert_false(tab_arrow(off, controls.Key.Right).moved)
}

fn laid_strip(t: controls.Tabs) -> widget.Laid {
    return widget.layout(controls.tabs_widget(t, frame()), strip_box, metrics())
}

// **The test this control exists to have.** `tabs_input` divides the strip by `tab_width` and
// `tabs_widget` lays every tab out at `tab_width`: two computations of one layout, which is the
// arrangement that lets a click land on the tab beside the one it looks like it hit. This asserts
// they agree by pressing at the centre of the box the *layout* gave tab 2 and asking the *input*
// which tab that was.
#[test]
fn the_hit_test_and_the_layout_agree_on_where_a_tab_is() {
    val l = laid_strip(panes())
    // Swept rather than sampled once, and stepped by a width that divides neither tab, so the walk
    // crosses both boundaries instead of landing in the middle of the same tab three times.
    var x = 5.0
    var crossed = 0
    while x < 150.0 {
        val at = geom.point_of(x, 10.0)
        val by_layout = switch focus.control_at(l, at) {
            Some(one) { one.name }
            None { "(nothing there)" }
        }
        val chose = to_tabs(panes(), controls.Input.Press(at)).tabs.selected
        test.assert_eq(by_layout, controls.tab_name(panes(), chose))
        crossed = crossed + 1
        x = x + 7.0
    }
    test.assert(crossed > 15)
}

// One stop for Tab, one node per tab for a reader -- the list's bargain, for the same reason.
#[test]
fn a_strip_is_one_tab_stop_and_one_node_per_tab() {
    val l = laid_strip(panes())
    test.assert_len(1, focus.controls(l))
    test.assert_eq(focus.controls(l)[0].name, "panes")

    val t = a11y.tree_of(l, "Records", "panes")
    // The window, the strip, and one node per tab.
    test.assert_len(5, t.nodes)
}

// A reader has to be told which tab is showing, and an index on the container would make every
// adapter work out for itself which child the number meant.
#[test]
fn the_selected_tab_says_so_and_the_others_do_not() {
    val t = a11y.tree_of(laid_strip(with panes() { selected: 1 }), "Records", "panes")
    test.assert_eq(said_of_tree(t, "panes/1"), "tab, History, selected")
    test.assert_eq(said_of_tree(t, "panes/0"), "tab, Response")
}

// The strip itself is a tab list, not a list: "Panes, list" would send a reader looking for rows.
#[test]
fn the_strip_announces_itself_as_a_tab_list() {
    test.assert_eq(said_of_tree(a11y.tree_of(laid_strip(panes()), "Records", ""), "panes"), "tab list, Panes")
}

fn said_of_tree(t: a11y.Tree, name: string) -> string {
    return switch a11y.node_of(t, name) {
        Some(one) { a11y.announce(one) }
        None { concat("(no node named ", name, ")") }
    }
}

// ---------------------------------------------------- the masked field

fn secret() -> controls.Entry {
    return controls.password_of("pass", "Password", "hunter2")
}

val secret_box = geom.rect_of(0.0, 0.0, 200.0, 24.0)

// One bullet per character, so every index into the text is the same index into what is drawn.
#[test]
fn a_masked_field_shows_bullets_and_not_the_text() {
    test.assert_eq(controls.shown_text(secret()), "•••••••")
    test.assert_eq(len(controls.shown_text(secret())), len("hunter2"))
    test.assert_eq(controls.shown_text(controls.entry_of("url", "URL", "hunter2")), "hunter2")
}

// **The secret never enters the accessibility tree**, rather than entering it and being filtered
// downstream -- a reader, a remote bridge and a test dump all read the one published string.
#[test]
fn a_masked_field_publishes_the_mask_and_announces_a_password() {
    val w = controls.entry_widget(secret(), frame())
    test.assert_eq(said_of(w, "pass"), "password text, Password, •••••••")
    test.assert_false(contains(said_of(w, "pass"), "hunter2"))
}

// A click lands on the bullet it was aimed at, which is only true if the thing measured is the
// thing drawn. `metrics()` here gives every character the same width, so a press 2.5 characters in
// must place the caret at 3 -- and it would land somewhere else only if the press measured the
// real text while the widget drew the mask. (It cannot differ under *these* metrics, which is why
// the test below exists as well.)
#[test]
fn a_press_in_a_masked_field_places_the_caret_where_it_looks() {
    val taken = controls.entry_input(
        secret(),
        controls.Input.Press(geom.point_of(secret_box.x + 8.0 + 25.0, 10.0)),
        secret_box,
        frame()
    )
    test.assert_eq(taken.entry.editor.caret, 3)
}

// The real guard on that, in a font where a bullet is **not** the width of the characters it
// hides: measuring the text instead of the mask puts the caret under a different bullet, and only
// metrics that tell the two apart can see it.
#[test]
fn the_caret_follows_the_mask_in_a_font_where_a_bullet_is_wider() {
    val wide_bullet = widget.metrics_of(
        fn(text: string, size: float) -> float {
            var w = 0.0
            for c in chars(text) {
                w = w + (if c == "•" { 20.0 } else { 10.0 })
            }
            return w
        },
        fn(size: float) -> float { return size * 2.0 }
    )
    val taken = controls.entry_input(
        secret(),
        controls.Input.Press(geom.point_of(secret_box.x + 8.0 + 50.0, 10.0)),
        secret_box,
        controls.frame_of(theme.plain(), wide_bullet)
    )
    // 50 points into a run of 20-point bullets is between the second and the third.
    test.assert_eq(taken.entry.editor.caret, 3)
}

// **A masked field will not put its contents on the clipboard.** A control whose whole purpose is
// that its text is not shown cannot be the one that hands it to every other program on the
// machine.
#[test]
fn a_masked_field_copies_nothing() {
    val select_all = controls.Input.KeyDown(with controls.keystroke_of(controls.Key.Char("a")) {
        control: true
    })
    val chosen = controls.entry_input(secret(), select_all, secret_box, frame())
    val copy = controls.Input.KeyDown(with controls.keystroke_of(controls.Key.Char("c")) {
        control: true
    })
    val taken = controls.entry_input(chosen.entry, copy, secret_box, frame())
    test.assert_eq(taken.copied, "")

    // The same gesture on an ordinary field does copy, or the test above would pass on a field
    // that simply never copies anything.
    val plain = controls.entry_of("url", "URL", "hunter2")
    val plain_chosen = controls.entry_input(plain, select_all, secret_box, frame())
    val plain_taken = controls.entry_input(plain_chosen.entry, copy, secret_box, frame())
    test.assert_eq(plain_taken.copied, "hunter2")
}

// **Cutting still deletes.** What is refused is handing the text out, not the editing -- and the
// no-op test has to ask the editor rather than the copied string, which is "" for a masked field
// by design.
#[test]
fn a_masked_field_still_cuts_even_though_it_hands_nothing_out() {
    val select_all = controls.Input.KeyDown(with controls.keystroke_of(controls.Key.Char("a")) {
        control: true
    })
    val chosen = controls.entry_input(secret(), select_all, secret_box, frame())
    val cut = controls.Input.KeyDown(with controls.keystroke_of(controls.Key.Char("x")) {
        control: true
    })
    val taken = controls.entry_input(chosen.entry, cut, secret_box, frame())
    test.assert_eq(taken.copied, "")
    test.assert_eq(taken.entry.editor.text, "")
    test.assert(taken.changed)
}

// A multi-line password is not a thing, and the multi-line widget draws the text -- so `rows`
// cannot be the field that decides, or there is a way to build one that masks in one place and
// not the other.
#[test]
fn a_masked_field_is_one_line_whatever_rows_says() {
    val tall = with secret() { rows: 4 }
    test.assert_eq(
        said_of(controls.entry_widget(tall, frame()), "pass"),
        "password text, Password, •••••••"
    )
}

// --------------------------------------------------------------- the tree

// Two collections, one with a folder in it -- the shape curly's sidebar has, which is the shape
// this control was written for.
//
//   api            0  branch, open
//     auth         1  branch, open
//       login      2
//       refresh    2
//     health       1
//   empty          0  branch, open, and EMPTY -- the case a derived `expandable` gets wrong
//   scratch        0  leaf at the top, so "depth 0" and "branch" are not the same thing
fn forest() -> controls.Tree {
    return controls.tree_of("files", "Collections", [
        controls.tree_branch("api", 0, true),
        controls.tree_branch("auth", 1, true),
        controls.tree_row("login", 2),
        controls.tree_row("refresh", 2),
        controls.tree_row("health", 1),
        controls.tree_branch("empty", 0, true),
        controls.tree_row("scratch", 0)
    ])
}

val tree_box = geom.rect_of(0.0, 0.0, 200.0, 140.0)

fn to_tree(t: controls.Tree, input: controls.Input) -> controls.TreeStep {
    return controls.tree_input(t, input, tree_box, frame())
}

fn tree_key(t: controls.Tree, k: controls.Key) -> controls.TreeStep {
    return to_tree(t, controls.Input.KeyDown(controls.keystroke_of(k)))
}

fn labels_shown(t: controls.Tree) -> [string] {
    val out = mutable_array_new<string>()
    for at in controls.visible_rows(t) {
        push(out, t.rows[at].label)
    }
    return snapshot(out)
}

#[test]
fn everything_is_visible_while_every_branch_is_open() {
    test.assert_eq(
        join(separator: " ", pieces: labels_shown(forest())),
        "api auth login refresh health empty scratch"
    )
}

// **A closed branch hides its whole subtree, not just its children.** Closing `api` has to take
// `login` and `refresh` with it, and a visibility test that only looked one level up would leave
// two rows on screen with nothing above them.
#[test]
fn closing_a_branch_hides_everything_under_it() {
    val shut = to_tree(forest(), controls.Input.Press(on_row(0, 8.0)))
    test.assert(shut.toggled)
    test.assert_eq(join(separator: " ", pieces: labels_shown(shut.tree)), "api empty scratch")
}

// A press on the label selects; a press on the mark opens or closes. The two are a few points
// apart on the same row, which is why the hit test needs the column as well as the row.
#[test]
fn a_press_on_the_label_selects_where_a_press_on_the_mark_toggles() {
    val chose = to_tree(forest(), controls.Input.Press(on_row(1, 60.0)))
    test.assert_false(chose.toggled)
    test.assert_eq(chose.tree.selected, 1)
    test.assert(chose.moved)

    val shut = to_tree(forest(), controls.Input.Press(on_row(1, 20.0)))
    test.assert(shut.toggled)
    test.assert_false(shut.tree.rows[1].expanded)
}

// **A leaf has no mark, so the column it would be in is part of the label.** Pressing there must
// select rather than quietly do nothing, or a third of every leaf row is dead.
#[test]
fn pressing_where_a_leaf_has_no_mark_still_selects_it() {
    val chose = to_tree(forest(), controls.Input.Press(on_row(2, 36.0)))
    test.assert_false(chose.toggled)
    test.assert_eq(chose.tree.selected, 2)
}

// The arrows walk what is on screen, not the array: with `api` closed, Down from it lands on
// `empty` and not on `auth`.
#[test]
fn the_arrows_step_over_what_is_hidden() {
    val shut = to_tree(forest(), controls.Input.Press(on_row(0, 8.0))).tree
    test.assert_eq(tree_key(shut, controls.Key.Down).tree.selected, 5)
    test.assert_eq(t_label(tree_key(shut, controls.Key.Down).tree), "empty")
}

fn t_label(t: controls.Tree) -> string {
    if t.selected < 0 || t.selected >= len(t.rows) {
        return "(none)"
    }
    return t.rows[t.selected].label
}

// **Right opens a closed branch and steps into an open one**, which is what makes Right-Right walk
// downwards instead of stopping on the first folder.
#[test]
fn right_opens_a_branch_then_steps_into_it() {
    val shut = to_tree(forest(), controls.Input.Press(on_row(0, 8.0))).tree
    val opened = tree_key(shut, controls.Key.Right)
    test.assert(opened.toggled)
    test.assert_eq(t_label(opened.tree), "api")
    test.assert_eq(t_label(tree_key(opened.tree, controls.Key.Right).tree), "auth")
}

// **Left closes an open branch and climbs out of a leaf**, which is the move that makes a deep
// tree navigable: without it the only way out of a folder is Up past every sibling.
#[test]
fn left_closes_a_branch_then_climbs_to_the_parent() {
    val on_login = with forest() { selected: 2 }
    val up = tree_key(on_login, controls.Key.Left)
    test.assert_false(up.toggled)
    test.assert_eq(t_label(up.tree), "auth")
    val shut = tree_key(up.tree, controls.Key.Left)
    test.assert(shut.toggled)
    test.assert_eq(t_label(shut.tree), "auth")
    test.assert_false(shut.tree.rows[1].expanded)
}

// Left on a top-level leaf has nowhere to climb to and must not move the selection to row 0 by
// accident -- `parent_of` answers -1 and the key does nothing.
#[test]
fn left_at_the_top_of_the_tree_does_nothing() {
    val on_scratch = with forest() { selected: 6 }
    val step = tree_key(on_scratch, controls.Key.Left)
    test.assert_eq(t_label(step.tree), "scratch")
    test.assert_false(step.moved)
    test.assert_false(step.toggled)
}

// **Opening a branch does not move the selection off it**, or Right-then-Left is not a round trip
// and a user loses their place every time they look inside a folder.
#[test]
fn toggling_leaves_the_selection_where_it_was() {
    val shut = to_tree(forest(), controls.Input.Press(on_row(0, 8.0)))
    test.assert_eq(shut.tree.selected, 0)
    test.assert_false(shut.activated)
}

// An empty branch is still a branch. A tree that worked `expandable` out from the next row's depth
// would draw `empty` as a leaf, and a user could not tell an empty folder from a missing one.
#[test]
fn an_empty_branch_still_opens_and_closes() {
    val shut = to_tree(forest(), controls.Input.Press(on_row(5, 8.0)))
    test.assert(shut.toggled)
    test.assert_eq(shut.tree.selected, 5)
    // Nothing was hidden, because there is nothing under it -- but the state changed, which is
    // what a reader is told.
    test.assert_eq(join(separator: " ", pieces: labels_shown(shut.tree)), "api auth login refresh health empty scratch")
}

#[test]
fn enter_chooses_and_the_arrows_do_not() {
    test.assert(tree_key(forest(), controls.Key.Enter).activated)
    test.assert_false(tree_key(forest(), controls.Key.Down).activated)
}

#[test]
fn a_disabled_tree_ignores_everything() {
    val off = with forest() { disabled: true }
    test.assert_false(to_tree(off, controls.Input.Press(on_row(0, 8.0))).toggled)
    test.assert_false(tree_key(off, controls.Key.Down).moved)
}

fn laid_tree(t: controls.Tree) -> widget.Laid {
    return widget.layout(controls.tree_widget(t, frame()), tree_box, metrics())
}

// One stop for Tab, one node per **visible** row -- a reader should not be told about rows that
// are not on screen any more than a sighted user should see them.
#[test]
fn a_tree_is_one_tab_stop_and_a_node_per_visible_row() {
    val open_tree = a11y.tree_of(laid_tree(forest()), "Records", "files")
    // The window, the tree, and seven rows.
    test.assert_len(9, open_tree.nodes)

    val shut = to_tree(forest(), controls.Input.Press(on_row(0, 8.0))).tree
    val shut_tree = a11y.tree_of(laid_tree(shut), "Records", "files")
    // The window, the tree, and three rows.
    test.assert_len(5, shut_tree.nodes)
    test.assert_len(1, focus.controls(laid_tree(shut)))
}

// **A branch says whether it is open; a leaf says nothing.** `Some(false)` on a leaf publishes
// EXPANDABLE, and a reader would offer to open a thing that cannot be opened.
#[test]
fn a_branch_says_it_is_open_and_a_leaf_says_nothing_about_it() {
    val t = a11y.tree_of(laid_tree(forest()), "Records", "files")
    test.assert_eq(said_of_tree(t, "files/0"), "tree item, api, expanded, selected")
    test.assert_eq(said_of_tree(t, "files/2"), "tree item, login")
    val shut = to_tree(forest(), controls.Input.Press(on_row(0, 8.0))).tree
    test.assert_eq(
        said_of_tree(a11y.tree_of(laid_tree(shut), "Records", "files"), "files/0"),
        "tree item, api, collapsed, selected"
    )
}

#[test]
fn the_tree_announces_itself_as_a_tree() {
    test.assert_eq(said_of_tree(a11y.tree_of(laid_tree(forest()), "Records", ""), "files"), "tree, Collections")
}

// **The hit test and the layout agree on where a row's mark is**, the tab strip's rule again: the
// widget indents by `indent` per level and the press divides by it, so a sweep across the row must
// put the mark exactly where the layout drew the label's left edge minus one indent.
#[test]
fn the_mark_a_press_toggles_is_where_the_layout_drew_it() {
    // `auth` sits at depth 1, so its mark is the second indent-wide column.
    val on_mark = to_tree(forest(), controls.Input.Press(on_row(1, 16.0 + 8.0)))
    test.assert(on_mark.toggled)
    // One indent to the left is `api`'s column, which on this row is empty space, so a press there
    // selects rather than toggling -- the thing that breaks if the two disagree by one level.
    val left_of_it = to_tree(forest(), controls.Input.Press(on_row(1, 8.0)))
    test.assert_false(left_of_it.toggled)
    test.assert_eq(left_of_it.tree.selected, 1)
}

// **A reader asks a node for its children, so the parts have to nest.** The rows are flat and the
// layout is a plain column; if the parts were flat too, a reader would be told that seven things
// exist and nothing about which is inside which -- an indented list, from the one side that
// cannot see the indent. The first version of `tree_widget` was exactly that and every other test
// in this file passed.
#[test]
fn a_branch_is_the_parent_of_what_is_under_it() {
    val t = a11y.tree_of(laid_tree(forest()), "Records", "files")
    test.assert_eq(kids_of(t, "files/0"), "files/1 files/4")
    test.assert_eq(kids_of(t, "files/1"), "files/2 files/3")
    test.assert_eq(kids_of(t, "files/2"), "")
    // The tree itself holds only the top level, not every row.
    test.assert_eq(kids_of(t, "files"), "files/0 files/5 files/6")
}

// Closing a branch takes its children out of the tree a reader walks, not just off the screen.
#[test]
fn a_closed_branch_has_no_children_to_walk() {
    val shut = to_tree(forest(), controls.Input.Press(on_row(0, 8.0))).tree
    val t = a11y.tree_of(laid_tree(shut), "Records", "files")
    test.assert_eq(kids_of(t, "files/0"), "")
    test.assert_eq(kids_of(t, "files"), "files/0 files/5 files/6")
}

fn kids_of(t: a11y.Tree, name: string) -> string {
    return switch a11y.node_of(t, name) {
        Some(one) { join(separator: " ", pieces: named_children(t, one)) }
        None { concat("(no node named ", name, ")") }
    }
}

// The children that are rows of the tree, by name. A part wraps a group, so a node's `children`
// holds the boxes as well -- this is the walk a reader does, which is for the named ones.
fn named_children(t: a11y.Tree, node: a11y.Node) -> [string] {
    val out = mutable_array_new<string>()
    for key in node.children {
        switch a11y.node_of(t, key) {
            Some(child) { if widget.Role.is_TreeItem(child.role) { push(out, key) } }
            None { unit }
        }
    }
    return snapshot(out)
}

// ------------------------------------------------------------- the scroll bar

// The box a named group was laid out in, or a rectangle of -1 when there is none. A sentinel
// rather than an `Option`, for `said_of`'s reason: it reads better in the failure than a `None`.
fn box_named(l: widget.Laid, name: string) -> geom.Rect {
    if l.name == name {
        return l.bounds
    }
    for child in l.children {
        val found = box_named(child, name)
        if found.height >= 0.0 {
            return found
        }
    }
    return geom.rect_of(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0)
}

// A hundred points of content in a forty-point view, so the thumb is two fifths of the track and
// there are sixty points of overhang.
val bar_box = geom.rect_of(0.0, 0.0, 12.0, 100.0)
val bar_content = 250.0
val bar_view = 100.0

fn bar() -> controls.ScrollBar {
    return controls.scroll_bar_of("scroll", 20.0)
}

fn to_bar(b: controls.ScrollBar, input: controls.Input, offset: float) -> controls.ScrollBarStep {
    return controls.scroll_bar_input(b, input, bar_box, bar_content, bar_view, offset, frame())
}

#[test]
fn the_thumb_is_the_views_share_of_the_content() {
    val t = controls.thumb_of(style(), 100.0, 250.0, 100.0, 0.0)
    test.assert_eq(t.length, 40.0)
    test.assert_eq(t.start, 0.0)
    // Scrolled to the end, the thumb sits at the end of the track and not past it.
    val end = controls.thumb_of(style(), 100.0, 250.0, 100.0, 150.0)
    test.assert_eq(end.start, 60.0)
    test.assert_eq(end.start + end.length, 100.0)
}

// **A very long list still leaves something to take hold of.** The share of a thousand rows in a
// five-row view is a thumb too small to aim at, which is why the floor exists -- and the floor
// must not push the thumb past the end of its track.
#[test]
fn a_tiny_thumb_is_floored_and_still_fits() {
    val t = controls.thumb_of(style(), 100.0, 100000.0, 100.0, 100000.0 - 100.0)
    test.assert_eq(t.length, min_thumb)
    test.assert_eq(t.start + t.length, 100.0)
}

// **A track shorter than the floor is the case the floor itself can break.** A bar beside a
// two-row list is fifteen points tall; flooring its thumb at twenty would draw a thumb longer
// than the track it is in, hanging out of the bottom of the bar. Found by mutation: without the
// second clamp every other test here still passed, because they all use a track of a hundred.
#[test]
fn a_thumb_never_outgrows_a_short_track() {
    val t = controls.thumb_of(style(), 15.0, 250.0, 100.0, 0.0)
    test.assert_eq(t.length, 15.0)
    test.assert(t.start + t.length <= 15.0)
}

// Nothing to scroll: a full track and no thumb, rather than a thumb of zero length or a bar that
// disappears and moves the layout.
#[test]
fn a_view_bigger_than_its_content_has_no_thumb() {
    test.assert_false(controls.scrolls(40.0, 100.0))
    test.assert_eq(controls.thumb_of(style(), 100.0, 40.0, 100.0, 0.0).length, 100.0)
}

// A press on the track pages **towards the pointer**, which is what a track click does
// everywhere: above the thumb goes back a viewful, below it goes forward one.
#[test]
fn a_press_on_the_track_pages_towards_the_pointer() {
    val down = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 80.0)), 0.0)
    test.assert_eq(down.offset, 100.0)
    test.assert(down.moved)
    val up = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 5.0)), 150.0)
    test.assert_eq(up.offset, 50.0)
}

// Paging stops at the end rather than running past it, or a user clicking twice at the bottom
// scrolls into empty space.
#[test]
fn paging_stops_at_the_ends() {
    test.assert_eq(to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 95.0)), 120.0).offset, 150.0)
    test.assert_eq(to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 2.0)), 30.0).offset, 0.0)
}

// **A press on the thumb takes hold of it and scrolls nothing**, which is the whole of the
// difference between grabbing and paging -- a press that also jumped would move the content out
// from under the pointer before the drag began.
#[test]
fn a_press_on_the_thumb_grabs_without_moving() {
    val held = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 10.0)), 0.0)
    test.assert_eq(held.offset, 0.0)
    test.assert_false(held.moved)
    test.assert(Option.is_Some(held.bar.grabbed))
}

// **The drag keeps the point the thumb was taken hold of.** Grabbing the middle of the thumb and
// moving ten points must move the content by ten points' worth, not jump the thumb's middle to
// the pointer -- which is the single thing every hand-written scrollbar gets wrong.
#[test]
fn a_drag_keeps_where_the_thumb_was_grabbed() {
    val held = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 20.0)), 0.0).bar
    val moved = to_bar(held, controls.Input.Move(geom.point_of(6.0, 50.0)), 0.0)
    // Grabbed 20 points down a thumb starting at 0, so the thumb's start is now 30 of the 60
    // points of room, which is half the 150 points of overhang.
    test.assert_eq(moved.offset, 75.0)
}

#[test]
fn a_drag_stops_at_the_ends_too() {
    val held = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 20.0)), 0.0).bar
    test.assert_eq(to_bar(held, controls.Input.Move(geom.point_of(6.0, 900.0)), 0.0).offset, 150.0)
    test.assert_eq(to_bar(held, controls.Input.Move(geom.point_of(6.0, 0.0 - 900.0)), 0.0).offset, 0.0)
}

// A move with nothing held is a pointer passing over, not a drag.
#[test]
fn a_move_without_a_grab_scrolls_nothing() {
    val step = to_bar(bar(), controls.Input.Move(geom.point_of(6.0, 90.0)), 0.0)
    test.assert_eq(step.offset, 0.0)
    test.assert_false(step.moved)
}

// **A release lets go wherever it happens**, as a button's does: a thumb still holding on after
// the pointer came up follows it around the window.
#[test]
fn a_release_lets_go_even_off_the_bar() {
    val held = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 20.0)), 0.0).bar
    val let_go = to_bar(held, controls.Input.Release(geom.point_of(500.0, 500.0)), 0.0)
    test.assert_false(Option.is_Some(let_go.bar.grabbed))
}

#[test]
fn the_wheel_moves_by_the_step_it_was_given() {
    test.assert_eq(to_bar(bar(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(6.0, 50.0),
        vertical: 0 - 1,
        horizontal: 0
    }), 40.0).offset, 60.0)
}

#[test]
fn a_disabled_bar_ignores_everything() {
    val off = with bar() { disabled: true }
    test.assert_false(to_bar(off, controls.Input.Press(geom.point_of(6.0, 80.0)), 0.0).moved)
}

fn laid_bar(offset: float) -> widget.Laid {
    return widget.layout(
        controls.scroll_bar_widget(bar(), 12.0, 100.0, bar_content, bar_view, offset, frame()),
        bar_box,
        metrics()
    )
}

// **The thumb the layout draws is the thumb the press reads**, the rule this module keeps
// relearning: a bar drawn by one calculation and dragged by another jumps under the pointer.
#[test]
fn the_drawn_thumb_is_where_the_hit_test_looks_for_it() {
    val drawn = box_named(laid_bar(75.0), thumb_name)
    val figured = controls.thumb_of(style(), 100.0, bar_content, bar_view, 75.0)
    test.assert_eq(drawn.y, figured.start)
    test.assert_eq(drawn.height, figured.length)
    // And a press at the drawn thumb's own middle grabs rather than pages.
    val step = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, drawn.y + drawn.height / 2.0)), 75.0)
    test.assert_eq(step.offset, 75.0)
    test.assert(Option.is_Some(step.bar.grabbed))
}

// Nothing to scroll means no thumb drawn at all, not a thumb filling the track -- the track says
// "there is nothing below" by being empty.
#[test]
fn an_unscrollable_bar_draws_no_thumb() {
    val l = widget.layout(
        controls.scroll_bar_widget(bar(), 12.0, 100.0, 40.0, 100.0, 0.0, frame()),
        bar_box,
        metrics()
    )
    test.assert_eq(box_named(l, thumb_name).height, 0.0 - 1.0)
}

// Not a tab stop: the content takes the focus and its arrows scroll it, so a stop here would be
// one a keyboard user tabs through and cannot use.
#[test]
fn a_scroll_bar_is_not_in_the_tab_order() {
    test.assert_len(0, focus.controls(laid_bar(0.0)))
    test.assert_eq(
        said_of_tree(a11y.tree_of(laid_bar(0.0), "Records", ""), "scroll"),
        "scroll bar"
    )
}

// **Rows that do not start at depth 0, and a skipped level.** Neither is how a sidebar is built,
// which is why neither was tested -- and `tree_widget` dropped them silently: its walk took rows
// while `depth >= level`, and a row *deeper* than the level it was first met at fell into a guard
// that advanced past it without building anything. A tree whose rows all sat at depth 1 drew
// nothing at all. Found by a profiler reporting that a layout benchmark had no work to do.
#[test]
fn every_row_is_drawn_whatever_depth_it_starts_at() {
    val deep = controls.tree_of("files", "Collections", [
        controls.tree_row("one", 1),
        controls.tree_row("two", 1),
        controls.tree_row("three", 1)
    ])
    val t = a11y.tree_of(laid_tree(deep), "Records", "files")
    // The window, the tree, and three rows.
    test.assert_len(5, t.nodes)
    test.assert_eq(kids_of(t, "files"), "files/0 files/1 files/2")
}

// A level skipped in the middle nests under what is above it rather than vanishing.
#[test]
fn a_skipped_level_still_hangs_off_its_parent() {
    val gap = controls.tree_of("files", "Collections", [
        controls.tree_branch("top", 0, true),
        controls.tree_row("deep", 2),
        controls.tree_row("next", 0)
    ])
    val t = a11y.tree_of(laid_tree(gap), "Records", "files")
    test.assert_len(5, t.nodes)
    test.assert_eq(kids_of(t, "files"), "files/0 files/2")
    test.assert_eq(kids_of(t, "files/0"), "files/1")
}

// ---- the bars painted over a laid-out tree

// A viewport 100 tall onto 250 of content, scrolled by 60.
fn scrolled_tree() -> widget.Laid {
    val rows = mutable_array_new<widget.Widget>()
    var i = 0
    while i < 25 {
        push(rows, widget.fixed_of(0.0, 10.0, widget.label_of(concat("row ", str(i)), 8.0, paint.black())))
        i = i + 1
    }
    val w = widget.named_scroll("list", 0.0, 60.0, widget.column_of(0.0, snapshot(rows)))
    return widget.layout(w, geom.rect_of(0.0, 0.0, 80.0, 100.0), metrics())
}

fn bars_over(l: widget.Laid) -> [scene.Op] {
    val empty = scene.scene_of(l.bounds.width, l.bounds.height)
    return controls.paint_scroll_bars(l, empty, frame()).ops
}

// **The pass takes its numbers off the laid tree and nowhere else**, which is the whole reason it
// exists: the view is the viewport's own box, the content is the box its child was placed in, and
// the offset is on the widget. Nothing has to lay the window out twice to learn them.
#[test]
fn a_viewport_gets_a_track_and_a_thumb() {
    val ops = bars_over(scrolled_tree())
    test.assert_len(2, ops)
    val track = fill_box(ops[0])
    val thumb = fill_box(ops[1])
    // Hard against the viewport's right edge, the one width everything that draws or grabs a bar
    // shares.
    test.assert_eq(track.x, 80.0 - bar_thickness)
    test.assert_eq(track.width, bar_thickness)
    test.assert_eq(track.height, 100.0)
    // 100 of 250 visible, so the thumb is two fifths of the track; 60 of the 150 points of
    // overhang, so it sits two fifths of the way down the 60 points of room.
    test.assert_eq(thumb.height, 40.0)
    test.assert_eq(thumb.y, 24.0)
}

// **Nothing to scroll, nothing drawn.** A bar over content that fits is a bar that lies.
#[test]
fn a_viewport_that_fits_gets_no_bar() {
    val w = widget.named_scroll("list", 0.0, 0.0, widget.fixed_of(0.0, 20.0, widget.flex()))
    val l = widget.layout(w, geom.rect_of(0.0, 0.0, 80.0, 100.0), metrics())
    test.assert_len(0, bars_over(l))
}

// The ops already in the scene are kept, because this paints *over* what is there rather than
// instead of it -- and a pass that quietly dropped the window would be a very loud bug.
#[test]
fn the_scene_underneath_is_kept() {
    val l = scrolled_tree()
    val under = scene.with_ops(
        scene.scene_of(80.0, 100.0),
        [scene.fill(shape.rect_path(geom.rect_of(0.0, 0.0, 80.0, 100.0)), paint.Paint.Solid(paint.black()))]
    )
    val after = controls.paint_scroll_bars(l, under, frame())
    test.assert_len(3, after.ops)
    test.assert_eq(fill_box(after.ops[0]).width, 80.0)
}

// Every viewport, not the first one found: a window has a sidebar and a response pane, and the
// walk has to keep going after it has drawn one.
#[test]
fn every_viewport_in_the_tree_gets_one() {
    val two = widget.row_of(0.0, [
        widget.fixed_of(80.0, 0.0, widget.named_scroll("a", 0.0, 10.0, widget.fixed_of(0.0, 400.0, widget.flex()))),
        widget.fixed_of(80.0, 0.0, widget.named_scroll("b", 0.0, 10.0, widget.fixed_of(0.0, 400.0, widget.flex())))
    ])
    val l = widget.layout(two, geom.rect_of(0.0, 0.0, 160.0, 100.0), metrics())
    test.assert_len(4, bars_over(l))
}

// The rectangle a `Fill` covers, which is the only thing these tests look at.
fn fill_box(op: scene.Op) -> geom.Rect {
    return switch op {
        Fill(f) { shape.path_bounds(f.path) }
        StrokePath(_) { geom.rect_of(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0) }
        Text(_) { geom.rect_of(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0) }
        DrawImage(_) { geom.rect_of(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0) }
        Nested(_) { geom.rect_of(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0) }
    }
}

// **A wheel over a list's row has to reach the list, not the row.** `control_at` answers the
// innermost control, which for a list or a tree is a `part_of` -- a thing a click and a reader can
// reach and that no application holds a state for. So a wheel routed that way named a control
// nobody could handle, and was dropped: the wheel had never scrolled a list or a tree in any
// application. Found by painting a scroll bar, which made the absence visible.
#[test]
fn a_wheel_over_a_row_is_routed_to_the_list() {
    val l = laid_list(five())
    val over_a_row = controls.Input.Wheel(controls.Wheel {
        at: on_row(1, 20.0),
        vertical: 0 - 1,
        horizontal: 0
    })
    // The row is what `control_at` finds, and it is *not* what the wheel is for.
    test.assert_eq(switch focus.control_at(l, on_row(1, 20.0)) {
        Some(one) { one.name }
        None { "(nothing)" }
    }, controls.row_name(five(), 1))
    test.assert_eq(controls.target(l, over_a_row, "", ""), "people")
}

// ---- dragging the bar a tree and a list draw

// 25 rows of 20 in a 100-tall box: 500 of content in a 100 view, 400 of overhang.
fn long_tree() -> controls.Tree {
    val rows = mutable_array_new<controls.TreeRow>()
    var i = 0
    while i < 25 {
        push(rows, controls.tree_row(concat("row ", str(i)), 0))
        i = i + 1
    }
    return controls.tree_of("files", "Files", snapshot(rows))
}

val long_box = geom.rect_of(0.0, 0.0, 200.0, 100.0)

fn on_long(t: controls.Tree, input: controls.Input) -> controls.TreeStep {
    return controls.tree_input(t, input, long_box, frame())
}

// **A press in the strip down the right edge takes the bar, not the row behind it.** The row is
// still there -- the bar is painted over the content, not beside it -- so the only thing that
// separates the two gestures is where in the row the press landed.
#[test]
fn a_press_in_the_strip_grabs_the_bar_and_not_the_row() {
    val grabbed = on_long(long_tree(), controls.Input.Press(geom.point_of(196.0, 10.0)))
    test.assert_false(grabbed.moved)
    test.assert_eq(grabbed.tree.selected, 0)
    test.assert(Option.is_Some(grabbed.tree.bar.grabbed))

    // Four points to the left of the strip is the row, and it selects.
    val row = on_long(long_tree(), controls.Input.Press(geom.point_of(200.0 - bar_thickness - 4.0, 30.0)))
    test.assert_eq(row.tree.selected, 1)
    test.assert_false(Option.is_Some(row.tree.bar.grabbed))
}

// **Nothing to scroll, no strip.** A bar that is not drawn must not take a press either, or the
// last few points of every row in a short list are dead.
#[test]
fn a_short_tree_has_no_strip_to_grab() {
    val short = with long_tree() { rows: [controls.tree_row("only", 0)] }
    val step = on_long(short, controls.Input.Press(geom.point_of(196.0, 10.0)))
    test.assert_false(Option.is_Some(step.tree.bar.grabbed))
    test.assert_eq(step.tree.selected, 0)
}

// **The drag keeps the point the thumb was taken hold of, and moves the view.** Twenty-five rows
// of 28 is 700 of content in a 100 view, which gives a thumb at its 20-point floor with 80 points
// of room over 600 of overhang -- so a pointer 20 points further down is 150 further into the
// content.
#[test]
fn dragging_the_bar_scrolls_without_moving_the_selection() {
    val held = on_long(long_tree(), controls.Input.Press(geom.point_of(196.0, 5.0))).tree
    val dragged = on_long(held, controls.Input.Move(geom.point_of(196.0, 25.0)))
    test.assert_eq(dragged.tree.offset, 150.0)
    test.assert_eq(dragged.tree.selected, 0)
    test.assert_false(dragged.moved)
}

// **A drag that wanders off the strip keeps dragging.** The release is routed to the focus rather
// than to what is under the pointer, so a thumb still holding on after the pointer left would
// follow it around the window.
#[test]
fn a_drag_off_the_strip_still_drags_and_still_lets_go() {
    val held = on_long(long_tree(), controls.Input.Press(geom.point_of(196.0, 5.0))).tree
    val away = on_long(held, controls.Input.Move(geom.point_of(10.0, 55.0)))
    test.assert_eq(away.tree.offset, 375.0)
    val let_go = on_long(away.tree, controls.Input.Release(geom.point_of(10.0, 55.0)))
    test.assert_false(Option.is_Some(let_go.tree.bar.grabbed))
    // ...and once it has let go, a press in the rows selects again -- row 13, because the view is
    // 375 points down and the press is 10 into it.
    test.assert_eq(on_long(let_go.tree, controls.Input.Press(geom.point_of(40.0, 10.0))).tree.selected, 13)
}

// A wheel over the strip scrolls the tree the ordinary way rather than being taken for a grab:
// only a press decides, which is what `for_the_bar` tests.
#[test]
fn a_wheel_over_the_strip_is_still_a_wheel() {
    val step = on_long(long_tree(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(196.0, 50.0),
        vertical: 0 - 1,
        horizontal: 0
    }))
    test.assert_eq(step.tree.offset, row_tall())
    test.assert_false(Option.is_Some(step.tree.bar.grabbed))
}

// The list has the same bar, and the same rule about the selection.
#[test]
fn a_list_drags_its_bar_too() {
    val many = mutable_array_new<string>()
    var i = 0
    while i < 25 {
        push(many, concat("row ", str(i)))
        i = i + 1
    }
    val l = controls.list_of("rows", "Rows", snapshot(many))
    val held = controls.list_input(l, controls.Input.Press(geom.point_of(196.0, 5.0)), long_box, frame())
    test.assert(Option.is_Some(held.list.bar.grabbed))
    val dragged = controls.list_input(
        held.list,
        controls.Input.Move(geom.point_of(196.0, 25.0)),
        long_box,
        frame()
    )
    test.assert_eq(dragged.list.offset, 150.0)
    test.assert_eq(dragged.list.selected, 0)
    test.assert_false(dragged.moved)
}

// ---- a field with a composition open

fn composing_field() -> controls.Entry {
    return controls.entry_composing(controls.entry_of("note", "Note", "ab"), "かんじ", 3).entry
}

val note_box = geom.rect_of(0.0, 0.0, 200.0, 24.0)

// What is drawn is the committed text with the composition spliced in; what is *stored* is not.
#[test]
fn a_composing_field_shows_what_is_not_yet_in_it() {
    val e = composing_field()
    test.assert_eq(e.editor.text, "ab")
    test.assert_eq(controls.shown_text(e), "abかんじ")
}

// **Composing is not a change; committing is.** `changed` is what a form watches to know it is
// dirty, and a half-typed composition has changed nothing a save would write.
#[test]
fn composing_is_not_a_change_and_committing_is() {
    val start = controls.entry_of("note", "Note", "ab")
    test.assert_false(controls.entry_composing(start, "か", 1).changed)
    val composing = controls.entry_composing(start, "かんじ", 3).entry
    test.assert(controls.entry_commit(composing, "漢字").changed)
}

#[test]
fn committing_writes_what_the_method_chose() {
    val done = controls.entry_commit(composing_field(), "漢字").entry
    test.assert_eq(done.editor.text, "ab漢字")
    test.assert_false(Option.is_Some(done.preedit))
    test.assert_eq(controls.shown_text(done), "ab漢字")
}

// **An empty commit abandons the composition**: the method says it chose nothing, so the pre-edit
// goes and the text is as it was.
#[test]
fn an_empty_commit_abandons_the_composition() {
    val done = controls.entry_commit(composing_field(), "").entry
    test.assert_eq(done.editor.text, "ab")
    test.assert_false(Option.is_Some(done.preedit))
    test.assert_false(controls.entry_commit(composing_field(), "").changed)
}

// A commit with nothing open is ordinary text, which is what a method sends for a compose
// sequence that never showed a pre-edit -- a dead key followed by a vowel.
#[test]
fn a_commit_with_nothing_open_is_ordinary_text() {
    val typed = controls.entry_commit(controls.entry_of("note", "Note", "ab"), "é").entry
    test.assert_eq(typed.editor.text, "abé")
}

// **The pointer does not move the caret while composing**, and the reason is an index rather than
// a policy: a press is measured against the shown text, which has the composition in it, while
// the caret is placed in the committed text. Placing one from the other puts the caret a
// composition's length from where it was clicked.
#[test]
fn a_press_while_composing_moves_nothing() {
    // **Composed in the middle of the text, not at the end**, which the first version of this
    // test got wrong: with the composition at the end, an index taken from the shown text clamps
    // to the end of the committed text -- which is where the caret already was, so the test
    // passed with the guard removed. Mutation is what said so.
    val mid = with controls.entry_of("note", "Note", "abcdef") {
        editor: edit.place_caret(edit.editor_of("abcdef"), 2, false)
    }
    val e = controls.entry_composing(mid, "XY", 2).entry
    test.assert_eq(controls.shown_text(e), "abXYcdef")
    // Six characters in at ten points each, past the field's padding: an index the committed text
    // can hold, and not the one the caret is at.
    val pressed = controls.entry_input(
        e,
        controls.Input.Press(geom.point_of(theme.plain().padding.left + 62.0, 10.0)),
        note_box,
        frame()
    )
    test.assert_eq(pressed.entry.editor.caret, 2)
    test.assert(Option.is_Some(pressed.entry.preedit))

    // ...and once it is committed, a press places a caret again.
    val done = controls.entry_commit(e, "Z").entry
    val after = controls.entry_input(
        done,
        controls.Input.Press(geom.point_of(5.0, 10.0)),
        note_box,
        frame()
    )
    test.assert_eq(after.entry.editor.caret, 0)
}

// The caret is drawn inside the composition, where the user is typing -- which is only true if
// the widget places it from `edit.shown_caret` rather than from the editor's own caret.
#[test]
fn the_caret_is_drawn_inside_the_composition() {
    val w = controls.entry_widget(composing_field(), frame())
    val l = widget.layout(w, note_box, metrics())
    // Every character is 10 wide under these metrics, so a caret 5 characters in sits at 50 plus
    // the field's left padding.
    test.assert_eq(box_named(l, caret_name).x, 50.0 + theme.plain().padding.left)
}

// **The run being converted is drawn apart from the rest of the composition**, because the two
// say different things: one is "not committed yet" and the other is "this is what your next
// keystroke changes".
#[test]
fn the_converting_run_is_drawn_apart_from_the_composition() {
    val marked = controls.entry_composing_marked(
        controls.entry_of("note", "Note", "ab"),
        "かんじ",
        3,
        1,
        3
    ).entry
    val l = widget.layout(
        controls.entry_widget(marked, frame()),
        note_box,
        metrics()
    )
    // Two points at 10 per character: the composition starts at 2 and the converted run at 3.
    test.assert_eq(box_named(l, "composing").x, 20.0 + theme.plain().padding.left)
    test.assert_eq(box_named(l, "converting").x, 30.0 + theme.plain().padding.left)
    test.assert_eq(box_named(l, "converting").width, 20.0)
}

// A field with no composition draws neither, which is the case every other test in this file is.
#[test]
fn a_field_with_no_composition_draws_no_tint() {
    val l = widget.layout(
        controls.entry_widget(controls.entry_of("note", "Note", "ab"), frame()),
        note_box,
        metrics()
    )
    test.assert_eq(box_named(l, "composing").height, 0.0 - 1.0)
    test.assert_eq(box_named(l, "converting").height, 0.0 - 1.0)
}

// **A password being typed through an input method is still a password.** The composition is
// spliced in so the caret arithmetic holds, and the whole of it is masked so none of it is
// legible -- which is the one combination where the two features meet.
#[test]
fn a_masked_field_masks_the_composition_too() {
    val secret_composing = controls.entry_composing(
        controls.password_of("pass", "Password", "ab"),
        "かんじ",
        3
    ).entry
    test.assert_eq(controls.shown_text(secret_composing), "•••••")
    test.assert_false(contains(controls.shown_text(secret_composing), "か"))
}

// ------------------------------------------------- the look and feel (2026-11-12)

// A style that asks for a shape rather than only a palette: what a second look and feel is.
fn edged_style() -> controls.Style {
    val base = theme.plain()
    // **The edge is on the rows now**, so an edged look edges every state: a border that appeared
    // only at rest would vanish under the pointer.
    val edge = Option<widget.Border>.Some(widget.border_of(paint.black(), 2.0))
    return with base {
        states: controls.States {
            rest: with base.states.rest { border: edge },
            hovered: with base.states.hovered { border: edge },
            pressed: with base.states.pressed { border: edge },
            disabled: with base.states.disabled { border: edge },
            selected: with base.states.selected { border: edge }
        },
        shape: with base.shape { medium: widget.Radius.Points(5.0) }
    }
}

// A check box's face is `shape.medium` since F293, so a test that asks for a particular radius
// says which step it means.
fn asking_for(r: widget.Radius) -> controls.Style {
    val base = edged_style()
    return with base { shape: with base.shape { medium: r } }
}

// And a chosen row is `shape.small`, which is a different step on purpose -- see `Shape`.
fn row_asking_for(r: widget.Radius) -> controls.Style {
    val base = edged_style()
    return with base { shape: with base.shape { small: r } }
}

fn painted(w: widget.Widget) -> [scene.Op] {
    return widget.paint_ops(widget.layout(w, geom.rect_of(0.0, 0.0, 200.0, 40.0), metrics()), metrics())
}

// **Both of these recurse into a `Nested`, and the first versions did not -- which made the list
// test below assert on an empty set.** A list clips its rows, so the whole of it paints as one
// `Nested` group and a counter that walked only the top level saw no fills, no strokes, and
// happily agreed that there was no border. The failing half of that test is the only reason it was
// noticed: `strokes(ops) == 0` had passed for the wrong reason.
fn strokes(ops: [scene.Op]) -> int {
    var n = 0
    for op in ops {
        if StrokePath(_) = op {
            n = n + 1
        }
        if Nested(it) = op {
            n = n + strokes(it.ops)
        }
    }
    return n
}

// **A border is a ring now, not a stroke (2026-11-15), and `EvenOdd` is how you tell.** A face's
// fill is `NonZero` and a ring is the outer contour plus the hole under an even-odd rule, so the
// winding distinguishes the two without a test having to know the geometry. `strokes` stays because
// it must keep reading zero: a border that went back to being stroked would cost 3x per box
// (lib/ui/widget.zm's `paint_surface` carries the measurement) and this is what would catch it.
fn rings(ops: [scene.Op]) -> int {
    var n = 0
    for op in ops {
        if Fill(it) = op {
            if EvenOdd = it.path.winding {
                n = n + 1
            }
        }
        if Nested(group) = op {
            n = n + rings(group.ops)
        }
    }
    return n
}

fn curved_fills(ops: [scene.Op]) -> int {
    var n = 0
    for op in ops {
        if Fill(it) = op {
            for segment in it.path.segments {
                if CubicTo(_) = segment {
                    n = n + 1
                    break
                }
            }
        }
        if Nested(group) = op {
            n = n + curved_fills(group.ops)
        }
    }
    return n
}

fn square_fills(ops: [scene.Op]) -> int {
    var n = 0
    for op in ops {
        if Fill(it) = op {
            var curved = false
            for segment in it.path.segments {
                if CubicTo(_) = segment {
                    curved = true
                }
            }
            if !curved {
                n = n + 1
            }
        }
        if Nested(group) = op {
            n = n + square_fills(group.ops)
        }
    }
    return n
}

// **The default look did not change when the box widened**, which is the property that let this
// ship without re-blessing a single pixel: `default_style` leaves the border absent and the radius
// at zero, so a button paints exactly the one square fill it always did.
#[test]
fn the_default_style_paints_no_border_and_no_curve() {
    val ops = painted(controls.button_widget(controls.button_of("save", "Save"), frame()))
    test.assert_eq(strokes(ops), 0)
    test.assert_eq(rings(ops), 0)
    test.assert_eq(curved_fills(ops), 0)
}

// And a style that asks reaches the control -- which is the whole point of the widening, and the
// thing no amount of palette swapping could do before it.
#[test]
fn an_edged_style_reaches_a_button() {
    val ops = painted(controls.button_widget(controls.button_of("save", "Save"), frame_in(edged_style())))
    test.assert_eq(rings(ops), 1)
    // **Nothing is stroked**, which is the performance claim as an assertion rather than a comment.
    test.assert_eq(strokes(ops), 0)
    // Two curved fills now, not one: the face and the ring, which is curved on its outer contour.
    test.assert_eq(curved_fills(ops), 2)
}

// Every control with a face goes through one helper, so a look and feel reaches all of them rather
// than whichever ones someone remembered. **A control that painted its own fill is the one that
// stays flat when the theme changes**, and that bug looks like one widget out of fifteen being
// wrong.
#[test]
fn an_edged_style_reaches_every_control_that_has_a_face() {
    val style = edged_style()
    test.assert_eq(rings(painted(controls.entry_widget(controls.entry_of("u", "URL", ""), frame_in(style)))), 1)
    test.assert_eq(
        rings(painted(controls.check_box_widget(
            controls.check_box_of("n", "Notify", widget.Toggle.Off),
            frame_in(style)
        ))),
        1
    )
    test.assert_eq(rings(painted(controls.menu_title_widget(controls.menu_of("m", "File", []), frame_in(style)))), 1)
}

// ------------------------------------------------- the combo box (2026-11-16)

// **These are the tests a `Menu` with `Role.ComboBox` could not have passed**, which is why the
// control was split out: a menu's closed half does nothing but open, and a combo box's closed half
// is most of what it is for.

fn combo() -> controls.ComboBox {
    return controls.combo_box_of("method", "Method", ["GET", "POST", "PUT", "PATCH", "DELETE"], 0)
}

val combo_box_at = geom.rect_of(0.0, 0.0, 80.0, 24.0)
val combo_popup_at = geom.rect_of(0.0, 24.0, 80.0, 100.0)

fn combo_key(c: controls.ComboBox, k: controls.Key, alt: bool) -> controls.ComboBoxStep {
    val stroke = controls.Keystroke { key: k, shift: false, control: false, alt: alt, meta: false }
    return controls.combo_box_input(c, controls.Input.KeyDown(stroke), combo_box_at, combo_popup_at, frame())
}

// **Down changes the value without opening the list**, which is the behaviour a menu does not have
// and every platform's combo box does. The old `choice_of` opened on Down, so a keyboard user
// could not step through the values at all.
#[test]
fn a_closed_combo_box_changes_its_value_with_the_arrows() {
    val step = combo_key(combo(), controls.Key.Down, false)
    test.assert_eq(controls.combo_box_value(step.combo), "POST")
    test.assert_false(step.combo.open)
    // and it reports the change, which is what an application stores
    test.assert_eq(step.chosen, 1)
}

#[test]
fn the_arrows_stop_at_the_ends_rather_than_wrapping() {
    // Up from the first stays on the first and reports no change.
    val at_top = combo_key(combo(), controls.Key.Up, false)
    test.assert_eq(controls.combo_box_value(at_top.combo), "GET")
    test.assert_eq(at_top.chosen, 0 - 1)
    // Down from the last stays on the last.
    val last = controls.combo_box_of("m", "M", ["GET", "POST"], 1)
    val at_end = combo_key(last, controls.Key.Down, false)
    test.assert_eq(controls.combo_box_value(at_end.combo), "POST")
    test.assert_eq(at_end.chosen, 0 - 1)
}

#[test]
fn home_and_end_jump_to_the_first_and_last_value() {
    val ended = combo_key(combo(), controls.Key.End, false)
    test.assert_eq(controls.combo_box_value(ended.combo), "DELETE")
    val homed = combo_key(ended.combo, controls.Key.Home, false)
    test.assert_eq(controls.combo_box_value(homed.combo), "GET")
}

// **Type-ahead walks the values that share a letter** rather than sticking on the first, which is
// what makes a long list usable: P, P, P over POST, PUT and PATCH visits all three.
#[test]
fn typing_a_letter_walks_the_values_that_start_with_it() {
    val first = combo_key(combo(), controls.Key.Char("p"), false)
    test.assert_eq(controls.combo_box_value(first.combo), "POST")
    val second = combo_key(first.combo, controls.Key.Char("p"), false)
    test.assert_eq(controls.combo_box_value(second.combo), "PUT")
    val third = combo_key(second.combo, controls.Key.Char("p"), false)
    test.assert_eq(controls.combo_box_value(third.combo), "PATCH")
    // and round again, because a list that stopped at the last match would strand the user
    val again = combo_key(third.combo, controls.Key.Char("p"), false)
    test.assert_eq(controls.combo_box_value(again.combo), "POST")
}

#[test]
fn type_ahead_ignores_case_and_says_nothing_about_a_letter_no_value_starts_with() {
    val upper = combo_key(combo(), controls.Key.Char("D"), false)
    test.assert_eq(controls.combo_box_value(upper.combo), "DELETE")
    val nothing = combo_key(combo(), controls.Key.Char("z"), false)
    test.assert_eq(controls.combo_box_value(nothing.combo), "GET")
    test.assert_eq(nothing.chosen, 0 - 1)
}

// **Alt+Down opens where a bare Down changes the value.** The two gestures are a modifier apart and
// a control that confused them would either never open or never step.
#[test]
fn alt_down_opens_the_list_where_a_bare_down_does_not() {
    val opened = combo_key(combo(), controls.Key.Down, true)
    test.assert(opened.combo.open)
    test.assert_eq(controls.combo_box_value(opened.combo), "GET")
    val stepped = combo_key(combo(), controls.Key.Down, false)
    test.assert_false(stepped.combo.open)
}

#[test]
fn enter_opens_it_and_enter_again_chooses_the_highlight() {
    val opened = combo_key(combo(), controls.Key.Enter, false)
    test.assert(opened.combo.open)
    val moved = combo_key(opened.combo, controls.Key.Down, false)
    val chosen = combo_key(moved.combo, controls.Key.Enter, false)
    test.assert_false(chosen.combo.open)
    test.assert_eq(chosen.chosen, 1)
    test.assert_eq(controls.combo_box_value(chosen.combo), "POST")
}

#[test]
fn escape_closes_the_list_without_choosing() {
    val opened = combo_key(combo(), controls.Key.Enter, false)
    val away = combo_key(opened.combo, controls.Key.Escape, false)
    test.assert_false(away.combo.open)
    test.assert(away.dismissed)
    test.assert_eq(away.chosen, 0 - 1)
    test.assert_eq(controls.combo_box_value(away.combo), "GET")
}

// **It announces its value, not its label twice.** A combo box that published no value would say
// "Method, combo box" and leave the user to open it to find out what it is set to.
#[test]
fn a_combo_box_announces_its_value() {
    val said = said_of(controls.combo_box_widget(combo(), frame()), "method")
    test.assert(contains(said, "Method"))
    test.assert(contains(said, "GET"))
    // and the value it says follows the selection rather than being fixed at build time
    val moved = combo_key(combo(), controls.Key.End, false)
    val after = said_of(controls.combo_box_widget(moved.combo, frame()), "method")
    test.assert(contains(after, "DELETE"))
}

// ------------------------------------------- the caret belongs to the focused field (2026-11-15)

// **A field that does not have the focus draws no caret**, which it did until 2026-11-15: the
// caret box was a widget in the tree with its own ink, so every field in a window painted one at
// once. `curly gui` showed eight at a time with the focus on a tree -- found by looking at the
// running application, which is the only place this was visible, since the caret's *box* is in the
// layout either way and every test asked the layout.
//
// **The box is still laid out when unfocused, and that is deliberate.** It is a layout participant
// one point wide sitting between the runs before and after it, so dropping it would shift the
// field's trailing text by a point and change its natural width -- a visible jump every time the
// focus moved. Laid out always, inked only for the focused control.
fn caret_fills(ops: [scene.Op], at: geom.Rect) -> int {
    var n = 0
    for op in ops {
        if Fill(it) = op {
            val b = shape.path_bounds(it.path)
            if b.x == at.x && b.y == at.y && b.width == at.width {
                n = n + 1
            }
        }
        if Nested(group) = op {
            n = n + caret_fills(group.ops, at)
        }
    }
    return n
}

fn field_laid() -> widget.Laid {
    return widget.layout(
        controls.entry_widget(controls.entry_of("url", "URL", "abc"), frame()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
}

#[test]
fn an_unfocused_field_lays_its_caret_out_and_does_not_paint_it() {
    val laid = field_laid()
    val caret = box_named(laid, caret_name)
    // laid out, whatever the focus
    test.assert(caret.width > 0.0)
    // and not painted, because nothing has the focus here
    test.assert_eq(caret_fills(widget.paint_ops(laid, metrics()), caret), 0)
}

#[test]
fn the_focused_field_paints_exactly_one_caret() {
    val laid = field_laid()
    val caret = box_named(laid, caret_name)
    val scene = widget.paint_focused(laid, metrics(), "url", paint.rgb(0.0, 0.0, 1.0), 2.0)
    test.assert_eq(caret_fills(scene.ops, caret), 1)
}

// The focus naming a *different* control paints no caret in this one -- which is the half that
// makes a window with eight fields show one caret rather than eight.
#[test]
fn a_field_that_is_not_the_focused_one_paints_no_caret() {
    val laid = field_laid()
    val caret = box_named(laid, caret_name)
    val scene = widget.paint_focused(laid, metrics(), "somewhere-else", paint.rgb(0.0, 0.0, 1.0), 2.0)
    test.assert_eq(caret_fills(scene.ops, caret), 0)
}

// **A list's chosen row is rounded but never edged.** A border round each row of a list is a box
// inside a box, and over twenty rows it reads as a table rather than as a selection -- where the
// rounded pill is what a modern look and feel actually draws. That is why `highlight_of` exists
// beside `face_of`.
//
// **They used to share the radius, and since F293 they deliberately do not.** A chosen row reads
// `shape.small` and a control's face reads `shape.medium`, because a selection is a subtler shape
// than a thing you press -- which is the difference a single `corner` token could not say and D1
// made sayable. So this asks for a rounded `small` and still gets no stroke: the step is the part
// that changed, and the border is the part that did not.
#[test]
fn a_chosen_row_takes_its_own_radius_and_never_a_border() {
    val list = with controls.list_of("rows", "Rows", ["one", "two", "three"]) { selected: 1 }
    val ops = painted(controls.list_widget(
        list,
        controls.frame_of(row_asking_for(widget.Radius.Points(4.0)), metrics())
    ))
    test.assert_eq(strokes(ops), 0)
    test.assert(curved_fills(ops) > 0)
    // And the face's own step does not reach it: a rounded `medium` leaves the row square.
    test.assert_eq(
        curved_fills(painted(controls.list_widget(
            list,
            controls.frame_of(asking_for(widget.Radius.Points(6.0)), metrics())
        ))),
        0
    )
}

// **The scrim is never rounded and never edged, whatever the style says.** It covers the whole
// window, so a radius would round the corners of the screen and a border would draw a frame round
// the display -- and both would look like a bug rather than a theme.
#[test]
fn the_scrim_ignores_the_look_and_feel() {
    val layer = controls.dialog_layer("d", "Delete?", widget.flex(), frame_in(edged_style()))
    val ops = widget.paint_ops(
        widget.layout(layer.content, geom.rect_of(0.0, 0.0, 200.0, 120.0), metrics()),
        metrics()
    )
    // The scrim is the first thing painted, behind the panel: square, whatever the style asked.
    test.assert(square_fills(ops) > 0)
}

// The x of the first text in a laid tree, which is where a label actually ended up.
fn text_x(l: widget.Laid) -> float {
    if Text(_) = l.widget {
        return l.bounds.x
    }
    for child in l.children {
        val found = text_x(child)
        if found >= 0.0 {
            return found
        }
    }
    return 0.0 - 1.0
}

// **A button given more room than its text centres its label**, which it did not do before
// alignment existed: it sat against the left padding, and had since F271. Unseen because every
// button in the only application on this layer shrink-wraps -- `curly gui` puts `widget.expand`
// on the field beside them -- so the spare room that shows the bug is zero.
#[test]
fn a_stretched_button_centres_its_label() {
    val button = controls.button_widget(controls.button_of("send", "Send"), frame())
    val laid = widget.layout(button, geom.rect_of(0.0, 0.0, 200.0, 30.0), metrics())
    val at = text_x(laid)
    // "Send" is 4 characters at 10 points each under these metrics, so 40 wide in 200: 80 each side.
    test.assert_eq(at, 80.0)
}

// And a button that is only as wide as its text is unchanged, which is what kept every existing
// window looking the same: the spare room is zero, so every alignment comes to the same place.
#[test]
fn a_shrink_wrapped_button_is_where_it_always_was() {
    val row = widget.row_of(0.0, [
        controls.button_widget(controls.button_of("send", "Send"), frame()),
        widget.flex()
    ])
    val laid = widget.layout(row, geom.rect_of(0.0, 0.0, 200.0, 30.0), metrics())
    test.assert_eq(text_x(laid), 8.0)
}

// The first filled box in a laid tree -- a control's own face, which is what a look and feel
// draws and therefore what has to be the right shape.
fn face_box(l: widget.Laid) -> geom.Rect {
    if Group(it) = l.widget {
        switch it.surface.fill {
            Some(_) { return l.bounds }
            None { unit }
        }
    }
    for child in l.children {
        val found = face_box(child)
        if found.width > 0.0 {
            return found
        }
    }
    return geom.rect_of(0.0, 0.0, 0.0, 0.0)
}

fn a_check_box() -> controls.CheckBox {
    return controls.check_box_of("tls", "Verify TLS", widget.Toggle.On)
}

// **A check box is square**, which it was not: the mark box used to be a stack holding one glyph,
// so it measured one advance wide and one line tall -- 9x22 at the default style. A flat grey
// rectangle hid it; F286's rounded theme drew it as a capsule.
#[test]
fn a_check_box_is_square() {
    val laid = widget.layout(
        controls.check_box_widget(a_check_box(), frame()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    val face = face_box(laid)
    test.assert_eq(face.width, face.height)
}

// **And it is one line square**, which is the side that needs no guess: the mark's own line box is
// a full line tall, and the painter puts a glyph's baseline a line below its box's top -- so any
// smaller square hangs the mark out of the bottom. It also makes the box exactly as tall as the
// label beside it.
#[test]
fn a_check_box_is_one_line_square() {
    val m = metrics()
    val height = widget.face_at(m, 0).line_height
    val laid = widget.layout(
        controls.check_box_widget(a_check_box(), frame()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        m
    )
    test.assert_eq(face_box(laid).height, height(theme.plain().text.label.size))
}

// **A row taller than the control does not stretch the square**, which is the whole reason the
// outer stack asks for `Across.Centre`: a stretched row hands every child its full height, and a
// square that grows with its container is not a square. Laid out in a box twice as tall, so a
// stretch would be visible.
#[test]
fn a_tall_row_leaves_the_check_box_square() {
    val laid = widget.layout(
        controls.check_box_widget(a_check_box(), frame()),
        geom.rect_of(0.0, 0.0, 200.0, 80.0),
        metrics()
    )
    val face = face_box(laid)
    test.assert_eq(face.width, face.height)
}

// The x a rounded box's path starts at is `bounds.x + radius` -- `round_rect_path` moves to the
// end of the top-left arc -- so the radius a control actually used is readable from what it drew.
// The box the first fill covers, for a case that has to compare the radius against the face's own
// shorter side rather than against a number the test knew in advance.
fn first_fill_bounds(ops: [scene.Op]) -> geom.Rect {
    for op in ops {
        if Fill(it) = op {
            return shape.path_bounds(it.path)
        }
        if Nested(group) = op {
            val found = first_fill_bounds(group.ops)
            if found.width > 0.0 {
                return found
            }
        }
    }
    return geom.empty_rect()
}

fn first_fill_radius(ops: [scene.Op], left: float) -> float {
    for op in ops {
        if Fill(it) = op {
            for segment in it.path.segments {
                if MoveTo(at) = segment {
                    return at.x - left
                }
            }
        }
        if Nested(group) = op {
            val found = first_fill_radius(group.ops, left)
            if found >= 0.0 {
                return found
            }
        }
    }
    return 0.0 - 1.0
}

// **A theme's radius is chosen for a button, and a check box is a sixth of its width.** At
// `Points(6)` a 16-point square comes out nearly circular, so a quarter of the shorter side is
// what `Points` means -- applied to whatever box is painted rather than by a cap the check box
// carries itself, which is what this was until 2026-11-14. Read back off the path it drew.
#[test]
fn a_check_box_caps_the_radius_its_size_cannot_carry() {
    val m = metrics()
    val height = widget.face_at(m, 0).line_height
    val side = height(theme.plain().text.label.size)
    // A radius the square cannot carry: 10 against a side of 24, where the cap is 6.
    val asking = asking_for(widget.Radius.Points(10.0))
    val laid = widget.layout(
        controls.check_box_widget(a_check_box(), frame_in(asking)),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    val face = face_box(laid)
    val ops = widget.paint_ops(laid, metrics())
    test.assert_eq(face.width, side)
    test.assert_eq(first_fill_radius(ops, face.x), side * 0.25)
}

// And a control big enough keeps what the theme asked for, which is what makes the cap a cap
// rather than a different radius.
#[test]
fn a_button_keeps_the_radius_the_theme_asked_for() {
    val laid = widget.layout(
        controls.button_widget(controls.button_of("save", "Save"), frame_in(edged_style())),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    val ops = widget.paint_ops(laid, metrics())
    test.assert_eq(first_fill_radius(ops, 0.0), 5.0)
}

// **And a radius the square can carry is kept**, which is what makes this a cap rather than a
// different radius for check boxes. Without this, "always use the cap" passes every other test.
#[test]
fn a_check_box_keeps_a_radius_that_fits() {
    val asking = asking_for(widget.Radius.Points(2.0))
    val laid = widget.layout(
        controls.check_box_widget(a_check_box(), frame_in(asking)),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    val ops = widget.paint_ops(laid, metrics())
    test.assert_eq(first_fill_radius(ops, face_box(laid).x), 2.0)
}

// **A capsule is sayable, which the old per-control cap made impossible.** `Fraction(0.5)` is half
// the shorter side at every size, so a theme can ask for pill-shaped controls and get them on the
// check box too -- where a cap at a quarter would have quietly answered a rounded square.
#[test]
fn a_fraction_is_a_capsule_at_any_size() {
    val m = metrics()
    val height = widget.face_at(m, 0).line_height
    val side = height(theme.plain().text.label.size)
    val asking = asking_for(widget.Radius.Fraction(0.5))
    val checked = widget.layout(
        controls.check_box_widget(a_check_box(), frame_in(asking)),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    val ops = widget.paint_ops(checked, metrics())
    test.assert_eq(first_fill_radius(ops, face_box(checked).x), side * 0.5)
    // And on a button, whose face is wider than it is tall: half of the *shorter* side.
    val laid = widget.layout(
        controls.button_widget(controls.button_of("save", "Save"), frame_in(asking)),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    val painted = widget.paint_ops(laid, metrics())
    val face = first_fill_bounds(painted)
    val shorter = if face.width < face.height { face.width } else { face.height }
    test.assert_eq(first_fill_radius(painted, 0.0), shorter * 0.5)
}

// ---- an icon on a button

// A tick in the unit box `widget.Icon` wants: the shape is a caller's, the box is the contract.
fn tick() -> shape.Path {
    val b = shape.path_builder()
    shape.move_to(b, geom.point_of(0.1, 0.5))
    shape.line_to(b, geom.point_of(0.4, 0.8))
    shape.line_to(b, geom.point_of(0.9, 0.2))
    return shape.built(b, shape.Winding.NonZero)
}

fn laid_button(b: controls.Button, within: geom.Rect) -> widget.Laid {
    return widget.layout(controls.button_widget(b, frame()), within, metrics())
}

// **An icon has no size of its own: it is an em square from the control's text.** That is the rule
// the whole type rests on -- one unit-box drawing serves a 12-point button and a 40-point one --
// and it is the first thing to break if someone gives `Icon` a width.
#[test]
fn an_icon_is_a_square_the_size_of_the_text() {
    val style = theme.plain()
    val wide = geom.rect_of(0.0, 0.0, 200.0, 40.0)
    val row = laid_button(controls.icon_button_of("save", "Save", widget.icon_of(tick(), "save")), wide).children[0]
    test.assert_len(2, row.children)
    val mark = row.children[0]
    test.assert_eq(mark.bounds.width, style.text.label.size)
    test.assert_eq(mark.bounds.height, style.text.label.size)
    // And it grows with the text rather than with the padding.
    val bigger = with style { text: with style.text { label: with style.text.label { size: 24.0 } } }
    val big = widget.layout(
        controls.button_widget(
            controls.icon_button_of("save", "Save", widget.icon_of(tick(), "save")),
            frame_in(bigger)
        ),
        wide,
        metrics()
    ).children[0]
    test.assert_eq(big.children[0].bounds.width, 24.0)
}

// **The gap is `Style.icon_gap` and comes from the stack's spacing**, not from a widget between
// the two: an empty label would measure zero and still be a child a reader walks into.
#[test]
fn the_icon_sits_beside_the_label_on_the_side_it_names() {
    val style = theme.plain()
    val wide = geom.rect_of(0.0, 0.0, 200.0, 40.0)

    val leading = laid_button(
        controls.icon_button_of("save", "Save", widget.icon_of(tick(), "save")),
        wide
    ).children[0]
    val mark = leading.children[0]
    val label = leading.children[1]
    test.assert(mark.bounds.x < label.bounds.x)
    test.assert_eq(label.bounds.x - (mark.bounds.x + mark.bounds.width), style.icon_gap)

    val trailing = laid_button(
        with controls.button_of("more", "More") {
            icon: Option<widget.Icon>.Some(widget.trailing_icon(tick(), "more"))
        },
        wide
    ).children[0]
    val words = trailing.children[0]
    val after = trailing.children[1]
    test.assert(words.bounds.x < after.bounds.x)
    test.assert_eq(after.bounds.x - (words.bounds.x + words.bounds.width), style.icon_gap)

    // Both are centred in the room the button was given, together rather than each on its own.
    val content = (label.bounds.x + label.bounds.width) - mark.bounds.x
    test.assert_eq(mark.bounds.x, (200.0 - content) / 2.0)
}

// A button with no words is the icon and nothing else: no gap, and no empty child.
#[test]
fn an_icon_only_button_is_just_the_icon() {
    val row = laid_button(
        controls.icon_button_of("delete", "", widget.icon_of(tick(), "delete")),
        geom.rect_of(0.0, 0.0, 200.0, 40.0)
    ).children[0]
    test.assert_len(1, row.children)
    test.assert_eq(row.children[0].bounds.width, theme.plain().text.label.size)
}

// **The accessibility half of the icon decision**, and it falls out of two rules rather than a
// third: `a11y` prefers a declared label over gathered text, and a `Drawing` has no text to
// gather. So a button with words says its words and the icon is silent; a button with only a mark
// would be nameless and says the icon's name instead.
#[test]
fn an_icon_is_silent_beside_a_label_and_speaks_without_one() {
    val wide = geom.rect_of(0.0, 0.0, 200.0, 40.0)
    val with_words = laid_button(
        controls.icon_button_of("save", "Save", widget.icon_of(tick(), "save")),
        wide
    )
    test.assert_eq(named(a11y.tree_of(with_words, "demo", ""), "save"), "Save")

    val wordless = laid_button(
        controls.icon_button_of("delete", "", widget.icon_of(tick(), "delete")),
        wide
    )
    test.assert_eq(named(a11y.tree_of(wordless, "demo", ""), "delete"), "delete")

    // And an icon-less button is unchanged by any of this.
    val plain = laid_button(controls.button_of("plain", "Plain"), wide)
    test.assert_eq(named(a11y.tree_of(plain, "demo", ""), "plain"), "Plain")
}

fn named(tree: a11y.Tree, key: string) -> string {
    for node in tree.nodes {
        if node.key == key {
            return node.name
        }
    }
    return "<no such node>"
}

// The icon is inked with the label, so a disabled button's mark greys with its words rather than
// staying bright beside them.
#[test]
fn an_icon_takes_the_controls_own_ink() {
    val style = theme.plain()
    val wide = geom.rect_of(0.0, 0.0, 200.0, 40.0)
    val off = with controls.icon_button_of("save", "Save", widget.icon_of(tick(), "save")) {
        disabled: true
    }
    val ops = widget.paint(laid_button(off, wide), metrics()).ops
    var marks = 0
    for op in ops {
        switch op {
            Fill(f) {
                switch f.fill {
                    Solid(colour) {
                        val faint = style.states.disabled.ink
                        if colour.red == faint.red && colour.green == faint.green {
                            marks = marks + 1
                        }
                    }
                    LinearGradient(_) {}
                    RadialGradient(_) {}
                    Pattern(_) {}
                }
            }
            StrokePath(_) {}
            Text(_) {}
            DrawImage(_) {}
            Nested(_) {}
        }
    }
    // The tick is drawn as a fill in the disabled ink; a bright icon beside grey words would be
    // zero here.
    test.assert(marks > 0)
}

// **A glyph icon comes from the face the theme names**, which is what multi-font support was for:
// an icon font's private-use character is text, and until a `Label` could name a second face
// there was nowhere to draw it from.
#[test]
fn a_glyph_icon_is_drawn_in_the_styles_icon_face() {
    val m = widget.metrics_of_faces([
        widget.face_metrics_of(
            fn(text: string, size: float) -> float { return (len(text) as float) * 10.0 },
            fn(size: float) -> float { return size * 2.0 }
        ),
        widget.face_metrics_of(
            fn(text: string, size: float) -> float { return (len(text) as float) * 30.0 },
            fn(size: float) -> float { return size * 2.0 }
        )
    ])
    val style = with theme.plain() { icon_font: 1 }
    val b = controls.icon_button_of("done", "Done", widget.glyph_icon("A", "done"))
    val laid = widget.layout(controls.button_widget(b, frame_in(style)), geom.rect_of(0.0, 0.0, 400.0, 60.0), m)

    // The glyph's run names the icon face and the label's names the text face: one button, two
    // fonts, and no control that had to know.
    var icon_face = 0 - 1
    var label_face = 0 - 1
    for op in widget.paint(laid, m).ops {
        if Text(run) = op {
            if run.text == "A" {
                icon_face = run.font
            }
            if run.text == "Done" {
                label_face = run.font
            }
        }
    }
    test.assert_eq(icon_face, 1)
    test.assert_eq(label_face, 0)

    // **And it is still an em square**, not the glyph's own advance: an icon font whose characters
    // are not square must not make the button a different height than its words.
    val row = laid.children[0]
    test.assert_eq(row.children[0].bounds.width, style.text.label.size)
    test.assert_eq(row.children[0].bounds.height, style.text.label.size)

    // **A reader says the label and not the private-use character.** This is the case that forced
    // `announced_name`: a drawn icon is silent by itself because a `Drawing` has no text, and a
    // glyph icon is text, so this button announced itself as "A Done" until the control started
    // declaring its own name instead of letting one be gathered.
    test.assert_eq(named(a11y.tree_of(laid, "demo", ""), "done"), "Done")
}

// With no words, the glyph button is announced by the icon's name rather than by the character.
#[test]
fn a_wordless_glyph_button_says_its_name_and_not_its_character() {
    val m = metrics()
    val style = with theme.plain() { icon_font: 0 }
    val b = controls.icon_button_of("close", "", widget.glyph_icon("x", "close"))
    val laid = widget.layout(controls.button_widget(b, frame_in(style)), geom.rect_of(0.0, 0.0, 400.0, 60.0), m)
    test.assert_eq(named(a11y.tree_of(laid, "demo", ""), "close"), "close")
}

// **A dialog's panel is not the colour of a control on it.** It was, and so the buttons in the
// first dialog anyone opened were invisible -- text floating on a panel, with no fill or edge to
// say it could be pressed. Nothing in the layout or the accessibility tree could say so: the
// buttons were there, in the right boxes, with the right roles, painted in a colour
// indistinguishable from what they sat on. The third defect of this shape, after the divider.
#[test]
fn a_dialogs_panel_is_not_the_colour_of_a_control_on_it() {
    val style = theme.plain()
    val layer = controls.dialog_layer(
        "ask",
        "Delete this?",
        controls.button_widget(controls.button_of("yes", "Delete it"), frame_in(style)),
        frame_in(style)
    )
    val laid = widget.layout(layer.content, geom.rect_of(0.0, 0.0, 400.0, 300.0), metrics())
    // The panel is the first fill the dialog node paints; the button's face is the first fill the
    // button paints. Two fills, and the whole test is that they are two colours.
    test.assert(fill_red_at(laid, "ask") != fill_red_at(laid, "yes"))
}

// The red channel of the first solid fill the node called `name` paints, or a negative for no such
// node. **The red channel alone**, because the question is only whether two colours differ and no
// two greys in `default_style` share one.
fn fill_red_at(l: widget.Laid, name: string) -> float {
    switch widget.node_named(l, name) {
        Some(node) {
            for op in widget.paint_ops(node, metrics()) {
                if Fill(f) = op {
                    switch f.fill {
                        Solid(c) { return c.red }
                        LinearGradient(_) { return 0.0 - 1.0 }
                        RadialGradient(_) { return 0.0 - 1.0 }
                        Pattern(_) { return 0.0 - 1.0 }
                    }
                }
            }
            return 0.0 - 1.0
        }
        None { return 0.0 - 2.0 }
    }
}

// ---------------------------------------------------- coloured runs

val ink_box = geom.rect_of(0.0, 0.0, 400.0, 60.0)

// "val x = 1" with `val` in one colour and `1` in another: two spans, in order, not touching.
fn keyword_ink() -> paint.Color {
    return paint.rgb(0.1, 0.2, 0.9)
}

fn literal_ink() -> paint.Color {
    return paint.rgb(0.2, 0.6, 0.3)
}

fn inked_field() -> controls.Entry {
    return with controls.entry_of("code", "Code", "val x = 1") {
        inks: [
            controls.Ink { from: 0, to: 3, colour: keyword_ink() },
            controls.Ink { from: 8, to: 9, colour: literal_ink() }
        ]
    }
}

// Every string the field drew, with the red channel of the colour it was drawn in.
fn ink_named(c: paint.Color) -> string {
    if same_colour(c, style().states.rest.ink) {
        return "ink"
    }
    if same_colour(c, keyword_ink()) {
        return "keyword"
    }
    if same_colour(c, literal_ink()) {
        return "literal"
    }
    return str(c.red)
}

fn runs_of(e: controls.Entry) -> [string] {
    val laid = widget.layout(
        controls.entry_widget(e, frame()),
        ink_box,
        metrics()
    )
    val out = mutable_array_new<string>()
    for op in widget.paint_ops(laid, metrics()) {
        if Text(t) = op {
            // **Empty runs are dropped**, because a field always has one: the text either side of
            // the caret is two runs and one of them is "" wherever the caret sits. They draw
            // nothing, and counting them would make every assertion here about the caret.
            if len(t.text) > 0 {
                switch t.fill {
                    // **Named against the look rather than printed as a channel.** These used to
                    // read `@0.1` -- plain's ink before F295 derived it from a ramp -- so every
                    // one of them had to be rewritten the first time a look's colours moved. A
                    // name cannot rot that way.
                    Solid(c) { push(out, concat(t.text, "@", ink_named(c))) }
                    LinearGradient(_) { push(out, "?") }
                    RadialGradient(_) { push(out, "?") }
                    Pattern(_) { push(out, "?") }
                }
            }
        }
    }
    return snapshot(out)
}

// **A field with no inks draws exactly what it always drew**, which is the claim that lets this
// be added to `Entry` at all rather than beside it: one run of text in one colour, not a group of
// one. Everything else in this file depends on it being true.
#[test]
fn a_field_with_no_inks_draws_one_run() {
    test.assert_len(1, runs_of(controls.entry_of("plain", "Plain", "val x = 1")))
    test.assert_eq(runs_of(controls.entry_of("plain", "Plain", "val x = 1"))[0], "val x = 1@ink")
}

// Four runs: the keyword, the gap, the literal, and nothing after it -- so the text comes back in
// order and only the spans are recoloured.
#[test]
fn an_inked_field_draws_a_run_per_span() {
    val runs = runs_of(inked_field())
    test.assert_len(3, runs)
    test.assert_eq(runs[0], "val@keyword")
    test.assert_eq(runs[1], " x = @ink")
    test.assert_eq(runs[2], "1@literal")
}

// **A masked field ignores its inks**, because the indices count characters of the text and a
// masked field draws bullets: a span would colour the wrong ones, and there is nothing in a
// password worth colouring.
#[test]
fn a_masked_field_ignores_its_inks() {
    val secret = with controls.password_of("pw", "Password", "val x = 1") {
        inks: [controls.Ink { from: 0, to: 3, colour: paint.rgb(0.1, 0.2, 0.9) }]
    }
    test.assert_len(1, runs_of(secret))
}

// A span reaching past the end of the text is clipped rather than refused: a colourer that ran on
// text the field has since had typed into it should draw something sensible, not raise.
#[test]
fn a_span_past_the_end_is_clipped() {
    val over = with controls.entry_of("code", "Code", "val") {
        inks: [controls.Ink { from: 0, to: 99, colour: keyword_ink() }]
    }
    test.assert_len(1, runs_of(over))
    test.assert_eq(runs_of(over)[0], "val@keyword")
}

// **A control drawn in a named face draws its text in that face**, which it did not: every label
// went out through `widget.label_of`, which names face 0, while `entry_input` placed the caret
// using the field now called `style.text.body.face`. A theme that set it got a caret positioned by one face's
// metrics over glyphs from another, drifting further apart along the line -- and only on a window
// that had loaded a second face, which is why nothing had met it. The gallery's monospaced code
// pane was the first caller ever to set it.
#[test]
fn a_control_draws_its_text_in_the_face_its_style_names() {
    val base = theme.plain()
    val style = with base { text: with base.text { label: with base.text.label { face: 1 } } }
    val laid = widget.layout(
        controls.button_widget(controls.button_of("go", "Send"), frame_in(style)),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    var faces = 0
    for op in widget.paint_ops(laid, metrics()) {
        if Text(t) = op {
            test.assert_eq(t.font, 1)
            faces = faces + 1
        }
    }
    test.assert_eq(faces, 1)
    // And face 0 is still what an untouched style draws in.
    val plain = widget.layout(
        controls.button_widget(controls.button_of("go", "Send"), frame()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    for op in widget.paint_ops(plain, metrics()) {
        if Text(t) = op {
            test.assert_eq(t.font, 0)
        }
    }
}

// ---------------------------------------------------- the split pane

// Three hundred points of room, a divider six points wide, and panes that refuse to be squeezed
// below forty and fifty. So the divider may sit anywhere in [40, 244] and starts at 100.
val pane_box = geom.rect_of(0.0, 0.0, 300.0, 100.0)
val pane_extent = 300.0

fn pane() -> controls.SplitPane {
    return with controls.split_pane_of("sidebar", "", widget.Direction.Row, 100.0) {
        first_min: 40.0,
        second_min: 50.0
    }
}

fn to_pane(s: controls.SplitPane, input: controls.Input) -> controls.SplitStep {
    return controls.split_pane_input(s, input, pane_box, frame())
}

// A pane with a name a layout probe can find, and nothing in it.
fn blank_pane(name: string) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: widget.stretched(),
        children: [],
        name: name
    })
}

fn laid_pane(s: controls.SplitPane, extent: float) -> widget.Laid {
    return widget.layout(
        controls.split_pane_widget(s, extent, blank_pane("left"), blank_pane("right"), frame()),
        geom.rect_of(0.0, 0.0, extent, 100.0),
        metrics()
    )
}

#[test]
fn a_divider_stays_inside_both_minimums() {
    test.assert_eq(controls.split_at(pane(), style(), pane_extent), 100.0)
    test.assert_eq(controls.split_at(with pane() { position: 5.0 }, style(), pane_extent), 40.0)
    test.assert_eq(controls.split_at(with pane() { position: 290.0 }, style(), pane_extent), 242.0)
}

// **The case where the minimums contradict the box**, which is the one a wide window never shows.
// Sixty-two points cannot give forty to one pane and fifty to the other, so neither gets what it
// asked for and the room is shared in the ratio -- and, the part that matters, the divider is still
// inside the box rather than hanging out of the end of it.
//
// **Sixty-two rather than sixty since F293**, which widened the divider from six points to eight:
// the extent is chosen so that the shared room is a whole twenty-four, because a test whose
// expected value is 23.111111111111 teaches a reader nothing about the ratio it is checking.
#[test]
fn minimums_that_cannot_both_be_met_share_the_room() {
    val at = controls.split_at(pane(), style(), 62.0)
    test.assert_eq(at, 24.0)
    test.assert(at + divider_thickness <= 62.0)
}

// **A squeezed window does not cost the user the position they chose.** The clamp is on the way
// out, so the stored number survives a window too narrow to honour it and comes back when the
// window does. A control that clamped on the way in would have forgotten 100 the moment the
// window passed through 60 points, which is `JSplitPane`'s `lastDividerLocation` complaint.
#[test]
fn a_narrow_window_does_not_overwrite_the_chosen_position() {
    val s = pane()
    test.assert_eq(controls.split_at(s, style(), 62.0), 24.0)
    test.assert_eq(s.position, 100.0)
    test.assert_eq(controls.split_at(s, style(), pane_extent), 100.0)
}

// The one-function rule, as the scroll bar's thumb has it: the divider the layout draws is the
// divider the press reads.
#[test]
fn the_drawn_divider_is_where_the_hit_test_looks_for_it() {
    val drawn = box_named(laid_pane(pane(), pane_extent), controls.divider_name(pane()))
    test.assert_eq(drawn.x, controls.split_at(pane(), style(), pane_extent))
    test.assert_eq(drawn.width, divider_thickness)
    test.assert_eq(drawn.height, 100.0)
    test.assert(widget.contains(controls.divider_rect(pane(), style(), pane_box), geom.point_of(drawn.x + 1.0, 50.0)))
}

// **A press takes hold of the divider where it was pressed, and a drag moves it by how far the
// pointer went.** Without the grab offset the divider jumps so its start meets the pointer, which
// moves it the moment it is touched -- three points here, and three points is enough to see.
#[test]
fn a_drag_moves_the_divider_by_the_pointers_own_travel() {
    val held = to_pane(pane(), controls.Input.Press(geom.point_of(103.0, 50.0)))
    test.assert(Option.is_Some(held.split.grabbed))
    test.assert_false(held.moved)
    val dragged = to_pane(held.split, controls.Input.Move(geom.point_of(153.0, 50.0)))
    test.assert(dragged.moved)
    test.assert_eq(controls.split_at(dragged.split, style(), pane_extent), 150.0)
}

// A drag that keeps going stops at the minimum rather than past it, and a drag that is already
// there reports nothing moved.
#[test]
fn a_drag_stops_at_the_minimum() {
    val held = to_pane(pane(), controls.Input.Press(geom.point_of(103.0, 50.0)))
    val far = to_pane(held.split, controls.Input.Move(geom.point_of(0.0 - 500.0, 50.0)))
    test.assert_eq(controls.split_at(far.split, style(), pane_extent), 40.0)
    test.assert_false(to_pane(far.split, controls.Input.Move(geom.point_of(0.0 - 900.0, 50.0))).moved)
}

// **A drag stores what the user achieved, not what they asked for**, which is the other half of
// the clamp rule and the half no other test here can see: every assertion above reads through
// `split_at`, so storing the raw pointer position looks identical until the window changes size.
// Drag hard against the end at three hundred points and the divider stops at 242; widen the window
// to six hundred and it must still be at 242, not out at the 997 the pointer was asking for.
// Found by mutation -- storing `want` instead of the clamped number passed all fourteen.
#[test]
fn a_drag_stores_where_the_divider_stopped_and_not_where_the_pointer_went() {
    val held = to_pane(pane(), controls.Input.Press(geom.point_of(103.0, 50.0)))
    val shoved = to_pane(held.split, controls.Input.Move(geom.point_of(1000.0, 50.0)))
    test.assert_eq(shoved.split.position, 242.0)
    test.assert_eq(controls.split_at(shoved.split, style(), 600.0), 242.0)
}

#[test]
fn a_release_lets_go_wherever_it_happens() {
    val held = to_pane(pane(), controls.Input.Press(geom.point_of(103.0, 50.0)))
    val gone = to_pane(held.split, controls.Input.Release(geom.point_of(900.0, 900.0)))
    test.assert(Option.is_None(gone.split.grabbed))
}

// A press inside a pane is not this control's business: `target` has already decided it belongs to
// whatever is in there, and a split pane that grabbed it would resize when a user clicked a row.
#[test]
fn a_press_off_the_divider_does_nothing() {
    val miss = to_pane(pane(), controls.Input.Press(geom.point_of(50.0, 50.0)))
    test.assert(Option.is_None(miss.split.grabbed))
    test.assert_false(miss.moved)
    test.assert_false(to_pane(pane(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(103.0, 50.0),
        vertical: 0 - 1,
        horizontal: 0
    })).moved)
}

// **The arrows that move it are the ones along the stack.** The other pair is left alone: a
// divider that moved sideways on Down would be saying this control does not know which way it is
// facing, and it is the mistake `JSplitPane.HORIZONTAL_SPLIT` invites.
#[test]
fn the_arrows_along_the_stack_move_the_divider_and_the_others_do_not() {
    test.assert_eq(
        controls.split_at(to_pane(pane(), controls.Input.KeyDown(key(controls.Key.Right))).split, style(), pane_extent),
        110.0
    )
    test.assert_eq(
        controls.split_at(to_pane(pane(), controls.Input.KeyDown(key(controls.Key.Left))).split, style(), pane_extent),
        90.0
    )
    test.assert_false(to_pane(pane(), controls.Input.KeyDown(key(controls.Key.Down))).moved)
    test.assert_false(to_pane(pane(), controls.Input.KeyDown(key(controls.Key.Up))).moved)
}

// Home and End ask for 0 and for the whole box and let the clamp answer, so neither needs to know
// what the minimums are.
#[test]
fn home_and_end_go_as_far_as_the_minimums_allow() {
    test.assert_eq(
        controls.split_at(to_pane(pane(), controls.Input.KeyDown(key(controls.Key.Home))).split, style(), pane_extent),
        40.0
    )
    test.assert_eq(
        controls.split_at(to_pane(pane(), controls.Input.KeyDown(key(controls.Key.End))).split, style(), pane_extent),
        242.0
    )
}

// A column pane stacks its panes vertically, so its divider is a wide thin bar and its keys are Up
// and Down. **Both halves of the direction in one test**, because getting one right and the other
// backwards is the failure mode here.
#[test]
fn a_column_pane_divides_the_other_way() {
    val s = with controls.split_pane_of("rows", "", widget.Direction.Column, 30.0) { second_min: 20.0 }
    val d = controls.divider_rect(s, style(), geom.rect_of(0.0, 0.0, 300.0, 100.0))
    test.assert_eq(d.y, 30.0)
    test.assert_eq(d.x, 0.0)
    test.assert_eq(d.width, 300.0)
    test.assert_eq(d.height, divider_thickness)
    val down = controls.split_pane_input(
        s,
        controls.Input.KeyDown(key(controls.Key.Down)),
        geom.rect_of(0.0, 0.0, 300.0, 100.0),
        frame()
    )
    test.assert_eq(controls.split_at(down.split, style(), 100.0), 40.0)
    test.assert_false(controls.split_pane_input(
        s,
        controls.Input.KeyDown(key(controls.Key.Right)),
        geom.rect_of(0.0, 0.0, 300.0, 100.0),
        frame()
    ).moved)
}

// **The second pane takes what is left, so there is no seam.** Two fixed sizes that did not add up
// to the box would leave a line of background showing between the panes on some window widths and
// not others -- the kind of defect that is invisible until someone resizes.
#[test]
fn the_panes_and_the_divider_fill_the_box_exactly() {
    val l = laid_pane(pane(), pane_extent)
    val left = box_named(l, "left")
    val right = box_named(l, "right")
    test.assert_eq(left.x, 0.0)
    test.assert_eq(left.width, 100.0)
    test.assert_eq(right.x, 108.0)
    test.assert_eq(left.width + divider_thickness + right.width, pane_extent)
}

// **Only the divider is a tab stop.** A pane that was one would be a stop in front of whatever is
// inside it, so Tab would reach the split before reaching the tree in its first half -- and the
// thing a keyboard user wants to move is the divider.
#[test]
fn the_divider_takes_the_focus_and_the_pane_does_not() {
    val l = laid_pane(pane(), pane_extent)
    test.assert_len(1, focus.controls(l))
    test.assert_eq(focus.controls(l)[0].name, controls.divider_name(pane()))
    val tree = a11y.tree_of(l, "Records", "")
    test.assert_eq(said_of_tree(tree, "sidebar"), "split pane")
}

// **What is drawn is a line; what can be grabbed is the whole six points.** The first version
// filled the grab area with `style.face` and was invisible in the first application that used it,
// because the control on at least one side of a divider is drawn in `style.face` too. Nothing in
// the layout or the accessibility tree could have shown that -- the box was the right box -- so
// this test asserts the one thing that was wrong: the ink is narrower than the target.
#[test]
fn the_divider_draws_a_line_narrower_than_the_grab_area() {
    val l = laid_pane(pane(), pane_extent)
    test.assert_eq(box_named(l, controls.divider_name(pane())).width, divider_thickness)
    val fills = mutable_array_new<geom.Rect>()
    for op in widget.paint_ops(l, metrics()) {
        if Fill(f) = op {
            push(fills, shape.path_bounds(f.path))
        }
    }
    // The panes are empty and paint nothing, so the divider's line is the only fill in the tree.
    test.assert_len(1, snapshot(fills))
    test.assert_eq(fills[0].width, divider_line)
    // Centred in the grab area: two points of line with two either side of it.
    test.assert_eq(fills[0].x, 100.0 + (divider_thickness - divider_line) / 2.0)
}

#[test]
fn a_disabled_pane_ignores_everything() {
    val off = with pane() { disabled: true }
    test.assert_false(to_pane(off, controls.Input.Press(geom.point_of(103.0, 50.0))).moved)
    test.assert(Option.is_None(to_pane(off, controls.Input.Press(geom.point_of(103.0, 50.0))).split.grabbed))
    test.assert_false(to_pane(off, controls.Input.KeyDown(key(controls.Key.Right))).moved)
}

// -------------------------------------------------------- the table

// Three columns 100, 60 and 80 wide -- 240 in all -- and six rows of twenty points, in a box two
// hundred wide and a hundred tall with a twenty-two point header. **So the body is 78 points
// tall, not 100, and the columns are 40 points wider than the box**: every number below that
// differs from the naive one differs because of one of those two facts.
val table_box = geom.rect_of(0.0, 0.0, 200.0, 100.0)

fn table_columns() -> [controls.Column] {
    return [
        controls.column_of("Medicine", 100.0),
        controls.numeric_column_of("Dose", 60.0),
        controls.column_of("When", 80.0)
    ]
}

fn table() -> controls.Table {
    return controls.table_of("meds", "", table_columns(), [
        ["Aspirin", "100mg", "daily"],
        ["Ibuprofen", "400mg", "as needed"],
        ["Metformin", "500mg", "twice daily"],
        ["Ramipril", "5mg", "daily"],
        ["Simvastatin", "20mg", "at night"],
        // **A short row**, which a table built from a query gets sooner or later.
        ["Vitamin D"]
    ])
}

fn to_table(t: controls.Table, input: controls.Input) -> controls.TableStep {
    return controls.table_input(t, input, table_box, frame())
}

fn laid_table(t: controls.Table) -> widget.Laid {
    return widget.layout(controls.table_widget(t, frame()), table_box, metrics())
}

// The sideways offset a named viewport is scrolled by, or -1 for no such viewport.
fn offset_x_named(l: widget.Laid, name: string) -> float {
    if Scroll(v) = l.widget {
        if v.name == name {
            return v.offset_x
        }
    }
    for child in l.children {
        val found = offset_x_named(child, name)
        if found >= 0.0 {
            return found
        }
    }
    return 0.0 - 1.0
}

#[test]
fn a_cell_past_the_end_of_its_row_is_empty_rather_than_an_error() {
    test.assert_eq(controls.cell_at(table(), 0, 0), "Aspirin")
    test.assert_eq(controls.cell_at(table(), 5, 0), "Vitamin D")
    test.assert_eq(controls.cell_at(table(), 5, 2), "")
    test.assert_eq(controls.cell_at(table(), 99, 0), "")
    test.assert_eq(controls.cell_at(table(), 0, 99), "")
}

// **A reader hears the columns, not the row's length.** A short row read as "Vitamin D" and
// stopped there would tell the user there are no more columns, where the screen shows two empty
// cells.
#[test]
fn a_row_is_read_as_its_columns_in_order() {
    test.assert_eq(controls.row_label(table(), 0), "Aspirin, 100mg, daily")
    test.assert_eq(controls.row_label(table(), 5), "Vitamin D, , ")
}

#[test]
fn a_columns_start_is_the_widths_before_it() {
    test.assert_eq(controls.column_x(table(), 0), 0.0)
    test.assert_eq(controls.column_x(table(), 1), 100.0)
    test.assert_eq(controls.column_x(table(), 2), 160.0)
    // Defined one past the end, where it is the width of them all -- which is what makes
    // `column_x(t, i + 1)` the trailing edge of column i.
    test.assert_eq(controls.column_x(table(), 3), 240.0)
    test.assert_eq(controls.columns_width(table()), 240.0)
}

// **The header is not part of the view the rows scroll in**, and this is what proves it: a
// hundred-point box less a header band holds two whole rows, not the three and a half its own box
// would.
#[test]
fn the_body_is_the_box_without_the_header() {
    val body = controls.table_body(table(), style(), table_box, metrics())
    test.assert_eq(body.y, header_tall())
    test.assert_eq(body.height, table_box.height - header_tall())
    // A table with no header is all body, which is the grid-in-a-dialog case.
    val bare = with table() { headers: false }
    test.assert_eq(controls.table_body(bare, style(), table_box, metrics()).height, 100.0)
    test.assert_eq(controls.table_body(bare, style(), table_box, metrics()).y, 0.0)
}

// **A press picks the row under the pointer, measured from the body.** `in_body` counts from under
// the header band, which is the whole point: a table that measured from its own box would select
// the row after the one pressed, and the error is exactly one header tall -- invisible on a tall
// row and wrong on every one.
#[test]
fn a_press_picks_the_row_under_it_and_not_one_header_lower() {
    test.assert_eq(to_table(table(), controls.Input.Press(in_body(0, 20.0))).table.selected, 0)
    test.assert_eq(to_table(table(), controls.Input.Press(in_body(1, 20.0))).table.selected, 1)
    // Scrolled down by a row, the same point is the row after.
    val down = with table() { offset: row_tall() }
    test.assert_eq(to_table(down, controls.Input.Press(in_body(0, 20.0))).table.selected, 1)
}

// A press on the header selects nothing: there is no row there. (It is where a sort will go, which
// is why the headers are already nodes of their own.)
#[test]
fn a_press_on_the_header_selects_nothing() {
    val hit = to_table(with table() { selected: 2 }, controls.Input.Press(geom.point_of(20.0, 10.0)))
    test.assert_eq(hit.table.selected, 2)
    test.assert_false(hit.moved)
    // **And a press in the header where the scroll bar's strip is, is not a bar drag.** This one
    // holds for two reasons and so survives a mutation of either -- `table_for_the_bar` checks the
    // press is in the body, and `scroll_bar_input` bounds-checks it again. It is here as the
    // statement of what must be true, not as cover for one line.
    val strip = to_table(table(), controls.Input.Press(geom.point_of(196.0, 10.0)))
    test.assert(Option.is_None(strip.table.bar.grabbed))
    test.assert_eq(strip.table.offset, 0.0)
    // And a press below the last row leaves the selection alone rather than clearing it.
    val short = controls.table_of("meds", "", table_columns(), [["one", "1", "now"]])
    test.assert_eq(to_table(short, controls.Input.Press(geom.point_of(20.0, 90.0))).table.selected, 0)
}

// A column is dragged by its trailing edge in the header, and **the width follows where the edge
// would land rather than how far the pointer moved**, so a drag that leaves the window and comes
// back has nothing to accumulate.
#[test]
fn a_column_is_resized_by_dragging_its_edge() {
    // **Pressed two points to the right of the edge, on purpose.** Pressing exactly on it would
    // make the grab offset zero and leave the whole point of `grabbed` untested -- a column that
    // jumped two points wider the instant it was touched would pass.
    val held = to_table(table(), controls.Input.Press(geom.point_of(102.0, 10.0)))
    test.assert_eq(held.table.resizing, 0)
    test.assert(Option.is_Some(held.table.grabbed))
    val wider = to_table(held.table, controls.Input.Move(geom.point_of(140.0, 10.0)))
    test.assert(wider.resized)
    test.assert_eq(wider.table.columns[0].width, 138.0)
    // The other columns are untouched: a resize moves one boundary, not every one after it.
    test.assert_eq(wider.table.columns[1].width, 60.0)
    val gone = to_table(wider.table, controls.Input.Release(geom.point_of(900.0, 900.0)))
    test.assert(Option.is_None(gone.table.grabbed))
    test.assert_eq(gone.table.resizing, 0 - 1)
}

// **A column cannot be dragged away to nothing.** A zero-wide column is one a user cannot find
// again to drag back, so the floor is the one thing that keeps a resize reversible.
#[test]
fn a_column_stops_at_its_minimum_width() {
    val held = to_table(table(), controls.Input.Press(geom.point_of(100.0, 10.0)))
    val squashed = to_table(held.table, controls.Input.Move(geom.point_of(0.0 - 50.0, 10.0)))
    test.assert_eq(squashed.table.columns[0].width, min_column)
}

// **The grip is in the header and nowhere else.** Four points from a column boundary in the middle
// of the data is a selection in every table ever written, and a resize there would make clicking a
// row a gamble. The last column's edge is not a grip either -- there is nothing to its right to
// give the points to.
#[test]
fn the_resize_grip_is_only_on_a_header_and_never_on_the_last_column() {
    test.assert_eq(controls.edge_at(table(), style(), table_box, geom.point_of(100.0, 10.0), metrics()), 0)
    test.assert_eq(controls.edge_at(table(), style(), table_box, geom.point_of(160.0, 10.0), metrics()), 1)
    test.assert_eq(controls.edge_at(table(), style(), table_box, geom.point_of(240.0, 10.0), metrics()), 0 - 1)
    test.assert_eq(controls.edge_at(table(), style(), table_box, geom.point_of(100.0, 40.0), metrics()), 0 - 1)
    test.assert_eq(controls.edge_at(table(), style(), table_box, geom.point_of(130.0, 10.0), metrics()), 0 - 1)
    // So a press two points from a boundary in the body is a row selection.
    val hit = to_table(table(), controls.Input.Press(in_body(1, 99.0)))
    test.assert_eq(hit.table.selected, 1)
    test.assert_eq(hit.table.resizing, 0 - 1)
    // And a header with no header height has no grips at all.
    test.assert_eq(
        controls.edge_at(with table() { headers: false }, style(), table_box, geom.point_of(100.0, 2.0), metrics()),
        0 - 1
    )
}

// **A grip moves with its column once the table is scrolled sideways.** The edge is drawn at
// `column_x` minus the sideways offset, and a hit test that forgot the offset would put the grip
// forty points from the line it belongs to -- which is the bug a screenshot cannot show because
// the line is drawn in the right place.
#[test]
fn a_grip_follows_its_column_sideways() {
    val across = with table() { offset_x: 40.0 }
    test.assert_eq(controls.edge_at(across, style(), table_box, geom.point_of(60.0, 10.0), metrics()), 0)
    test.assert_eq(controls.edge_at(across, style(), table_box, geom.point_of(100.0, 10.0), metrics()), 0 - 1)
}

// Paging and revealing use the body's height, so PageDown moves by what fits under the header and
// not by what fits in the box.
#[test]
fn a_page_is_what_fits_in_the_body() {
    val paged = to_table(table(), controls.Input.KeyDown(key(controls.Key.PageDown)))
    test.assert_eq(paged.table.selected, 2)
    test.assert_eq(to_table(table(), controls.Input.KeyDown(key(controls.Key.End))).table.selected, 5)
    test.assert_eq(
        to_table(with table() { selected: 5 }, controls.Input.KeyDown(key(controls.Key.Home))).table.selected,
        0
    )
    // Arrowing to the last row scrolls it into view by the least that works: six rows of content
    // in a body of what is left under the header, so the end of it sits exactly there.
    test.assert_eq(
        to_table(table(), controls.Input.KeyDown(key(controls.Key.End))).table.offset,
        row_tall() * 6.0 - (table_box.height - header_tall())
    )
}

// **The columns scroll sideways and the rows do not come with them.** The sideways offset is
// clamped against the columns' own width, so a table narrower than its columns can reach the last
// one and no further: 240 of columns in a 200-point body stops at 40.
#[test]
fn the_columns_scroll_sideways_within_their_own_width() {
    val right = to_table(table(), controls.Input.KeyDown(key(controls.Key.Right)))
    test.assert_eq(right.table.offset_x, row_tall())
    test.assert_eq(right.table.offset, 0.0)
    test.assert_eq(
        to_table(with table() { offset_x: 30.0 }, controls.Input.KeyDown(key(controls.Key.Right))).table.offset_x,
        40.0
    )
    test.assert_eq(to_table(table(), controls.Input.KeyDown(key(controls.Key.Left))).table.offset_x, 0.0)
    // A sideways wheel does the same, and is answered before the vertical component of the same
    // event -- a trackpad sends both on a diagonal flick.
    val flicked = to_table(table(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(20.0, 50.0),
        vertical: 0 - 1,
        horizontal: 1
    }))
    test.assert_eq(flicked.table.offset_x, row_tall())
    test.assert_eq(flicked.table.offset, 0.0)
}

// **Sideways still works on a table with no rows**, which is why the arrows are answered before
// the empty check: a table waiting for a query still has columns, and a user should be able to
// look at them.
#[test]
fn an_empty_table_still_scrolls_sideways() {
    // Typed, because an empty literal cannot choose between a table of values and a table of
    // strings -- which is the overload working, not failing.
    val no_rows: [[string]] = []
    val empty = controls.table_of("meds", "", table_columns(), no_rows)
    test.assert_eq(empty.selected, 0 - 1)
    test.assert_eq(to_table(empty, controls.Input.KeyDown(key(controls.Key.Right))).table.offset_x, row_tall())
    test.assert_false(to_table(empty, controls.Input.KeyDown(key(controls.Key.Down))).moved)
}

// The wheel scrolls and never moves the selection, for `list_input`'s reason: a user looking
// further down the table has not asked to select what they are looking at.
#[test]
fn the_wheel_scrolls_the_rows_and_leaves_the_selection() {
    val rolled = to_table(table(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(20.0, 50.0),
        vertical: 0 - 1,
        horizontal: 0
    }))
    test.assert_eq(rolled.table.offset, row_tall())
    test.assert_eq(rolled.table.selected, 0)
    test.assert_false(rolled.moved)
}

#[test]
fn enter_activates_the_selected_row() {
    test.assert(to_table(table(), controls.Input.KeyDown(key(enter))).activated)
    test.assert_false(to_table(table(), controls.Input.KeyDown(key(enter))).moved)
    val none = with table() { selected: 0 - 1 }
    test.assert_false(to_table(none, controls.Input.KeyDown(key(enter))).activated)
}

// **The header and the body are scrolled by one number.** Two offsets would be a header that
// drifts from its columns, and it drifts only after a sideways scroll -- so a screenshot of a
// freshly opened table shows nothing wrong.
#[test]
fn the_header_scrolls_sideways_with_the_body_and_not_down_with_it() {
    val l = laid_table(with table() { offset_x: 40.0, offset: 20.0 })
    test.assert_eq(offset_x_named(l, "meds/header"), 40.0)
    test.assert_eq(offset_x_named(l, "meds/body"), 40.0)
    // The header's box stays at the top whatever the rows do.
    test.assert_eq(box_named(l, "meds/column/0").y, 0.0)
}

// One tab stop for the whole table, as a list has one: the rows and the headers are parts, which
// a click and a reader reach and Tab does not.
#[test]
fn a_table_is_one_tab_stop_and_its_rows_are_parts() {
    val l = laid_table(table())
    test.assert_len(1, focus.controls(l))
    test.assert_eq(focus.controls(l)[0].name, "meds")
    val tree = a11y.tree_of(l, "Records", "")
    test.assert_eq(said_of_tree(tree, "meds"), "table")
    test.assert_eq(named(tree, controls.table_row_name(table(), 0)), "Aspirin, 100mg, daily")
    test.assert_eq(named(tree, controls.column_header_name(table(), 1)), "Dose")
}

// **The header band is as wide as the table, not as wide as its columns.** A viewport lays its
// child out at the child's natural size, so a header built only of cells measures exactly the
// columns -- and a table narrower than its pane drew a grey band that stopped in the middle of the
// window while the rows below it ran to the edge. Found by putting the table in a gallery and
// looking at it; every assertion about boxes and roles passed throughout, because the band is a
// surface and a surface is not a node.
#[test]
fn the_header_band_spans_the_table_and_not_just_its_columns() {
    // 200 points of table and 240 of columns is the scrolled case; 400 of table is the case that
    // was wrong, where there is more pane than there are columns.
    val wide = geom.rect_of(0.0, 0.0, 400.0, 100.0)
    val l = widget.layout(controls.table_widget(table(), frame()), wide, metrics())
    var band = 0.0 - 1.0
    for op in widget.paint_ops(l, metrics()) {
        if Fill(f) = op {
            val filled = shape.path_bounds(f.path)
            if filled.y == 0.0 && filled.height == header_tall() {
                band = filled.width
            }
        }
    }
    test.assert_eq(band, 400.0)
    // **And the titles are still in it**, which the band alone does not say: a `Scroll` measures
    // as nothing, so the first attempt at a full-width band laid the viewport out zero points
    // wide and drew a perfect empty band with every column header inside it collapsed to a
    // sliver. The band was right and the header was gone.
    test.assert_eq(box_named(l, controls.column_header_name(table(), 0)).width, 100.0)
    test.assert_eq(box_named(l, controls.column_header_name(table(), 2)).x, 160.0)
}

#[test]
fn a_disabled_table_ignores_everything() {
    val off = with table() { disabled: true, selected: 2 }
    test.assert_eq(to_table(off, controls.Input.Press(geom.point_of(20.0, 45.0))).table.selected, 2)
    test.assert_false(to_table(off, controls.Input.KeyDown(key(controls.Key.Down))).moved)
    test.assert_eq(to_table(off, controls.Input.Press(geom.point_of(100.0, 10.0))).table.resizing, 0 - 1)
}

// ---------------------------------------------------- the radio group

// Taller than the four options need, so that "below the last option" is a place a press can
// actually land: four 24-point rows end at 96.
val radio_box = geom.rect_of(0.0, 0.0, 200.0, 120.0)

fn radios() -> controls.Radios {
    return controls.radios_of("how-often", "How often", ["Never", "Daily", "Weekly", "Monthly"], 1)
}

fn to_radios(r: controls.Radios, input: controls.Input) -> controls.RadioStep {
    return controls.radios_input(r, input, radio_box, frame())
}

// **The arrows select, they do not merely move.** A radio group has no state between "looking at"
// and "chosen", so a group that needed Space after an arrow would leave a keyboard user with a
// selection the screen disagrees with. This is the opposite of a list and the same as a tab strip.
#[test]
fn an_arrow_chooses_rather_than_only_moving() {
    val down = to_radios(radios(), controls.Input.KeyDown(key(controls.Key.Down)))
    test.assert_eq(down.radios.selected, 2)
    test.assert(down.moved)
    test.assert_eq(to_radios(radios(), controls.Input.KeyDown(key(controls.Key.Up))).radios.selected, 0)
}

// Both pairs, because a column of options is navigated with Up and Down by everyone who reads it
// as a list and with Left and Right by everyone who learned radios on a form where they sat in a
// row.
#[test]
fn both_pairs_of_arrows_move_the_choice() {
    test.assert_eq(to_radios(radios(), controls.Input.KeyDown(key(controls.Key.Right))).radios.selected, 2)
    test.assert_eq(to_radios(radios(), controls.Input.KeyDown(key(controls.Key.Left))).radios.selected, 0)
}

// **From the first option when nothing is chosen, whichever arrow it was.** A group with no
// selection has no "next", and a user pressing Down expects the top rather than the bottom.
#[test]
fn an_empty_group_starts_at_the_first_option() {
    val none = with radios() { selected: 0 - 1 }
    test.assert_eq(to_radios(none, controls.Input.KeyDown(key(controls.Key.Down))).radios.selected, 0)
    test.assert_eq(to_radios(none, controls.Input.KeyDown(key(controls.Key.Up))).radios.selected, 0)
}

#[test]
fn the_choice_stops_at_both_ends() {
    val first = with radios() { selected: 0 }
    test.assert_eq(to_radios(first, controls.Input.KeyDown(key(controls.Key.Up))).radios.selected, 0)
    test.assert_false(to_radios(first, controls.Input.KeyDown(key(controls.Key.Up))).moved)
    val last = with radios() { selected: 3 }
    test.assert_eq(to_radios(last, controls.Input.KeyDown(key(controls.Key.Down))).radios.selected, 3)
    test.assert_eq(to_radios(radios(), controls.Input.KeyDown(key(controls.Key.End))).radios.selected, 3)
    test.assert_eq(to_radios(radios(), controls.Input.KeyDown(key(controls.Key.Home))).radios.selected, 0)
}

#[test]
fn a_press_chooses_the_option_under_it() {
    test.assert_eq(to_radios(radios(), controls.Input.Press(geom.point_of(20.0, 10.0))).radios.selected, 0)
    test.assert_eq(to_radios(radios(), controls.Input.Press(geom.point_of(20.0, 60.0))).radios.selected, 2)
    // Below the last option is not a choice, and neither is outside the group.
    test.assert_false(to_radios(radios(), controls.Input.Press(geom.point_of(20.0, 110.0))).moved)
    test.assert_false(to_radios(radios(), controls.Input.Press(geom.point_of(400.0, 10.0))).moved)
}

// **A wheel over a group chooses nothing.** A user scrolling a form past a set of options has not
// asked to change their answer, and a form that fills itself in wrong as you read it is worse
// than one that does nothing.
#[test]
fn a_wheel_does_not_change_the_choice() {
    test.assert_false(to_radios(radios(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(20.0, 40.0),
        vertical: 0 - 1,
        horizontal: 0
    })).moved)
}

// One tab stop for the group, the options as parts, and the group announced as a group -- it is
// not itself a radio button, and a reader announcing it as one would be describing a control that
// cannot be operated.
#[test]
fn a_group_is_one_tab_stop_whose_options_carry_the_state() {
    val l = widget.layout(
        controls.radios_widget(radios(), frame()),
        radio_box,
        metrics()
    )
    test.assert_len(1, focus.controls(l))
    val tree = a11y.tree_of(l, "Form", "")
    test.assert_eq(said_of_tree(tree, "how-often"), "group, How often")
    test.assert_eq(said_of_tree(tree, controls.radio_name(radios(), 1)), "radio button, Daily, checked")
    test.assert_eq(said_of_tree(tree, controls.radio_name(radios(), 0)), "radio button, Never, unchecked")
}

#[test]
fn a_disabled_group_ignores_everything() {
    val off = with radios() { disabled: true }
    test.assert_false(to_radios(off, controls.Input.KeyDown(key(controls.Key.Down))).moved)
    test.assert_false(to_radios(off, controls.Input.Press(geom.point_of(20.0, 10.0))).moved)
}

// ---------------------------------------------------- the slider

val slider_box = geom.rect_of(0.0, 0.0, 114.0, 24.0)

// A hundred points of travel: the box is 114 wide and the thumb 14, so a value of 50 sits the
// thumb's left edge at 50.
fn slider() -> controls.Slider {
    return controls.slider_of("volume", "Volume", 0.0, 100.0, 50.0)
}

fn to_slider(s: controls.Slider, input: controls.Input) -> controls.SliderStep {
    return controls.slider_input(s, input, slider_box)
}

#[test]
fn a_value_is_clamped_and_snapped() {
    test.assert_eq(controls.snapped_value(0.0, 100.0, 1.0, 50.4), 50.0)
    test.assert_eq(controls.snapped_value(0.0, 100.0, 1.0, 50.6), 51.0)
    test.assert_eq(controls.snapped_value(0.0, 100.0, 1.0, 0.0 - 20.0), 0.0)
    test.assert_eq(controls.snapped_value(0.0, 100.0, 1.0, 900.0), 100.0)
    // A step of 25 lands on a quarter and never past the end.
    test.assert_eq(controls.snapped_value(0.0, 100.0, 25.0, 60.0), 50.0)
    test.assert_eq(controls.snapped_value(0.0, 100.0, 25.0, 99.0), 100.0)
    // **A range that is not a whole number of steps**, which is where the last clamp earns its
    // place: 0 to 10 by 4 snaps 10 to the nearest multiple, which is 12, which is off the end of
    // the slider. Found by mutation -- every other case here has a range the step divides, so
    // removing the clamp passed all of them.
    test.assert_eq(controls.snapped_value(0.0, 10.0, 4.0, 10.0), 10.0)
    test.assert_eq(controls.snapped_value(0.0, 10.0, 4.0, 7.0), 8.0)
    // **No step is a real slider**, and it keeps the value it was given.
    test.assert_eq(controls.snapped_value(0.0, 1.0, 0.0, 0.3333), 0.3333)
}

// **A press takes the value under it**, rather than paging towards it as a scroll bar does: a
// slider *is* the value, and a user pressing at the three-quarter mark is asking for three
// quarters. And it takes hold at the same time, so a press and a drag are one gesture.
#[test]
fn a_press_takes_the_value_under_it_and_grabs() {
    val taken = to_slider(slider(), controls.Input.Press(geom.point_of(82.0, 12.0)))
    test.assert_eq(taken.slider.value, 75.0)
    test.assert(Option.is_Some(taken.slider.grabbed))
    test.assert(taken.moved)
    val dragged = to_slider(taken.slider, controls.Input.Move(geom.point_of(7.0, 12.0)))
    test.assert_eq(dragged.slider.value, 0.0)
    test.assert(Option.is_None(to_slider(
        dragged.slider,
        controls.Input.Release(geom.point_of(7.0, 12.0))
    ).slider.grabbed))
}

// **Dragging the thumb resumes from where it is**, which is the half a flag cannot carry: taking
// hold two points into the thumb and moving ten points moves the thumb ten, not twelve, and the
// thumb does not jump under the hand at the moment it is grabbed. Reported from the gallery as
// "the slider does not resume from the current value when dragged".
#[test]
fn taking_hold_of_the_thumb_does_not_move_it() {
    // The thumb is at 50 and fourteen wide, so 52 is two points into it.
    val held = to_slider(slider(), controls.Input.Press(geom.point_of(52.0, 12.0)))
    test.assert_eq(held.slider.value, 50.0)
    test.assert_false(held.moved)
    // Ten points to the right moves it ten, keeping those two points of grip.
    test.assert_eq(to_slider(held.slider, controls.Input.Move(geom.point_of(62.0, 12.0))).slider.value, 60.0)
}

// A move with nothing held does nothing: the pointer crossing a slider on its way elsewhere is
// not a gesture.
#[test]
fn a_move_without_a_grab_changes_nothing() {
    test.assert_false(to_slider(slider(), controls.Input.Move(geom.point_of(7.0, 12.0))).moved)
}

#[test]
fn the_keys_move_by_a_step_a_page_and_to_the_ends() {
    test.assert_eq(to_slider(slider(), controls.Input.KeyDown(key(controls.Key.Right))).slider.value, 51.0)
    test.assert_eq(to_slider(slider(), controls.Input.KeyDown(key(controls.Key.Left))).slider.value, 49.0)
    test.assert_eq(to_slider(slider(), controls.Input.KeyDown(key(controls.Key.PageUp))).slider.value, 60.0)
    test.assert_eq(to_slider(slider(), controls.Input.KeyDown(key(controls.Key.PageDown))).slider.value, 40.0)
    test.assert_eq(to_slider(slider(), controls.Input.KeyDown(key(controls.Key.Home))).slider.value, 0.0)
    test.assert_eq(to_slider(slider(), controls.Input.KeyDown(key(controls.Key.End))).slider.value, 100.0)
}

// **A continuous slider is still usable from the keyboard**, which is what the fallback step is
// for: without it an arrow key on a slider with no step would move it by nothing.
#[test]
fn a_continuous_slider_still_moves_by_keyboard() {
    val smooth = with controls.slider_of("hue", "Hue", 0.0, 1.0, 0.5) { step: 0.0 }
    test.assert(to_slider(smooth, controls.Input.KeyDown(key(controls.Key.Right))).slider.value > 0.5)
}

// The one-function rule again: the thumb the layout draws is the thumb the press reads.
#[test]
fn the_drawn_thumb_is_where_the_value_says() {
    test.assert_eq(controls.slider_at(slider(), 114.0), 50.0)
    test.assert_eq(controls.slider_at(with slider() { value: 0.0 }, 114.0), 0.0)
    test.assert_eq(controls.slider_at(with slider() { value: 100.0 }, 114.0), 100.0)
    // And a press at the drawn thumb's own middle asks for the value it is already at.
    val middle = controls.slider_at(slider(), 114.0) + thumb_width / 2.0
    test.assert_eq(to_slider(slider(), controls.Input.Press(geom.point_of(middle, 12.0))).slider.value, 50.0)
}

// A reader that said "Volume, slider" and stopped would have told the user nothing they could not
// have guessed.
#[test]
fn a_slider_announces_its_value() {
    val l = widget.layout(
        controls.slider_widget(slider(), frame()),
        slider_box,
        metrics()
    )
    test.assert_eq(said_of_tree(a11y.tree_of(l, "Settings", ""), "volume"), "slider, Volume, 50")
    test.assert_len(1, focus.controls(l))
}

#[test]
fn a_disabled_slider_ignores_everything() {
    val off = with slider() { disabled: true }
    test.assert_false(to_slider(off, controls.Input.KeyDown(key(controls.Key.Right))).moved)
    test.assert(Option.is_None(to_slider(off, controls.Input.Press(geom.point_of(82.0, 12.0))).slider.grabbed))
}

// **The thumb is drawn, where the value says, at a size of its own.** The first version put it in
// a layer whose rectangle was `thumb_width` wide and *zero* tall -- a box `layer_at` honoured
// exactly -- so a slider drew a track and nothing to drag. The layout was right, the hit test was
// right, every assertion above passed, and there was nothing on screen to take hold of. It is a
// row of [gap, thumb, the rest] now, so the only number the control states is the one it knows.
#[test]
fn the_thumb_is_drawn_where_the_value_says() {
    val laid = widget.layout(
        controls.slider_widget(slider(), frame()),
        geom.rect_of(0.0, 0.0, 114.0, 30.0),
        metrics()
    )
    var thumb_x = 0.0 - 1.0
    var thumb_h = 0.0 - 1.0
    for op in widget.paint_ops(laid, metrics()) {
        if Fill(f) = op {
            val painted = shape.path_bounds(f.path)
            if painted.width == thumb_width {
                thumb_x = painted.x
                thumb_h = painted.height
            }
        }
    }
    test.assert_eq(thumb_x, controls.slider_at(slider(), 114.0))
    test.assert_eq(thumb_h, thumb_height)
}

// **The thumb lands where the press looks for it in a box nobody stated.** `slider_widget` used to
// take a width and place the thumb from it, while `slider_input` computed the same position from
// the bounds the layout actually gave -- so the two agreed only while a caller passed the width it
// then laid the slider out in. The gallery put one inside a `widget.expand` and the drawn thumb
// and the hit-tested one were hundreds of points apart: grabbing the thumb you could see was a
// press on the track, and the slider jumped. The widget is placed by weights now, so there is no
// second number to get wrong.
#[test]
fn the_thumb_lands_where_the_press_looks_for_it_at_any_width() {
    for width in [60.0, 114.0, 300.0, 801.0] {
        val box_of = geom.rect_of(0.0, 0.0, width, 30.0)
        val laid = widget.layout(
            controls.slider_widget(slider(), frame()),
            box_of,
            metrics()
        )
        var drawn = 0.0 - 1.0
        for op in widget.paint_ops(laid, metrics()) {
            if Fill(f) = op {
                val painted = shape.path_bounds(f.path)
                if painted.width == thumb_width {
                    drawn = painted.x
                }
            }
        }
        // Where the layout drew it, and where the gesture believes it is, for this box.
        test.assert_eq(drawn, controls.slider_at(slider(), width))
        // And a press at the drawn thumb's own middle grabs rather than jumping.
        val held = controls.slider_input(
            slider(),
            controls.Input.Press(geom.point_of(drawn + thumb_width / 2.0, 15.0)),
            box_of
        )
        test.assert_eq(held.slider.value, 50.0)
        test.assert_false(held.moved)
    }
}

// ---------------------------------------------------- the link

fn a_link() -> controls.Link {
    return controls.link_of("docs", "Read the syntax guide", "https://ziman.dev/syntax")
}

// A link is a button underneath, so it inherits the rule that matters: a press that drags off and
// releases elsewhere is not a follow.
#[test]
fn a_link_is_followed_by_a_press_and_not_by_a_drag_away() {
    val held = controls.link_input(a_link(), controls.Input.Press(inside()), box)
    test.assert(held.link.held)
    test.assert_false(held.followed)
    test.assert(controls.link_input(held.link, controls.Input.Release(inside()), box).followed)
    test.assert_false(controls.link_input(held.link, controls.Input.Release(outside()), box).followed)
    test.assert(controls.link_input(a_link(), controls.Input.KeyDown(key(enter)), box).followed)
    // **Enter follows on the way down and Space on the way up**, which is the button's rule and
    // every platform's: Space is a press, and a press is not over until it is released.
    val spaced = controls.link_input(a_link(), controls.Input.KeyDown(key(space)), box)
    test.assert_false(spaced.followed)
    test.assert(spaced.link.held)
    test.assert(controls.link_input(spaced.link, controls.Input.KeyUp(key(space)), box).followed)
}

// **The destination is carried and not announced.** A reader reading every URL aloud would be
// unusable on a page of links; what a user needs is where it goes in words, which is the label.
#[test]
fn a_link_says_what_it_is_and_not_where_it_goes() {
    val l = widget.layout(controls.link_widget(a_link(), frame()), box, metrics())
    test.assert_eq(said_of_tree(a11y.tree_of(l, "Docs", ""), "docs"), "link, Read the syntax guide")
    test.assert_eq(a_link().href, "https://ziman.dev/syntax")
    test.assert_len(1, focus.controls(l))
}

// **The underline is under the words, not under the padding.** A stretched column hands every
// child its own full width and the column's width is its widest child, which is the text -- so
// the rule matches the label rather than the control's box.
#[test]
fn the_underline_is_as_wide_as_the_text() {
    val style = theme.plain()
    val l = widget.layout(
        controls.link_widget(a_link(), frame_in(style)),
        geom.rect_of(0.0, 0.0, 600.0, 40.0),
        metrics()
    )
    var rule = 0.0 - 1.0
    for op in widget.paint_ops(l, metrics()) {
        if Fill(f) = op {
            val painted = shape.path_bounds(f.path)
            if painted.height == 1.0 {
                rule = painted.width
            }
        }
    }
    // The fake metrics are ten points a character, and the label is 21 characters.
    test.assert_eq(rule, 210.0)
}

// ---------------------------------------------------- what the pointer is over

// **The shape and the gesture read one function.** A cursor is a promise that a drag will do
// something, so it has to come from the same arithmetic the drag does -- an application that
// computed the divider's position a second time to decide a cursor would show arrows a few points
// from the line they belong to.
#[test]
fn the_pointer_is_a_resize_over_a_divider_and_an_arrow_elsewhere() {
    val at = controls.split_at(pane(), style(), pane_extent)
    test.assert(widget.Cursor.is_ResizeAcross(
        controls.split_pane_cursor(pane(), style(), pane_box, geom.point_of(at + 2.0, 50.0))
    ))
    test.assert(widget.Cursor.is_Arrow(
        controls.split_pane_cursor(pane(), style(), pane_box, geom.point_of(at + 40.0, 50.0))
    ))
    // A column pane resizes the other way, and says so.
    val down = with controls.split_pane_of("rows", "", widget.Direction.Column, 30.0) { second_min: 20.0 }
    val tall = geom.rect_of(0.0, 0.0, 300.0, 100.0)
    test.assert(widget.Cursor.is_ResizeDown(controls.split_pane_cursor(down, style(), tall, geom.point_of(50.0, 32.0))))
    // And a pane nobody can drag promises nothing.
    test.assert(widget.Cursor.is_Arrow(
        controls.split_pane_cursor(with pane() { disabled: true }, style(), pane_box, geom.point_of(at + 2.0, 50.0))
    ))
}

// The same rule for a column's edge: `edge_at` answers both the cursor and the press, so the
// pointer cannot show arrows where a drag would select a row.
#[test]
fn the_pointer_is_a_resize_over_a_column_edge_only_in_the_header() {
    test.assert(widget.Cursor.is_ResizeAcross(
        controls.table_cursor(table(), style(), table_box, geom.point_of(100.0, 10.0), metrics())
    ))
    // The same x, in the body.
    test.assert(widget.Cursor.is_Arrow(controls.table_cursor(
        table(),
        style(),
        table_box,
        geom.point_of(100.0, 45.0),
        metrics()
    )))
    // The last column has no edge to drag, so no promise is made over it.
    test.assert(widget.Cursor.is_Arrow(controls.table_cursor(
        table(),
        style(),
        table_box,
        geom.point_of(240.0, 10.0),
        metrics()
    )))
}

// **A collapsed combo box says it opens.** Drawn as a plain filled rectangle it is a disabled
// text field to anyone who has not been told otherwise: the mark at the trailing edge is the only
// thing on screen that says this one can be opened, and it was missing.
#[test]
fn a_collapsed_combo_box_draws_its_mark() {
    val style = theme.plain()
    val laid = widget.layout(
        controls.combo_box_widget(combo(), frame_in(style)),
        geom.rect_of(0.0, 0.0, 200.0, 30.0),
        metrics()
    )
    // **The mark is a drawn path now, not a character.** It was `style.expanded_mark`, a string
    // holding a triangle, and a face without that code point drew `.notdef` -- which is what
    // Liberation Sans does, so on a machine where that is the first font found every combo box in
    // the window drew a hollow box. The claim this test makes is unchanged; what carries it is a
    // fill rather than a glyph. See `controls.chevron`.
    var value_x = 0.0
    for op in widget.paint_ops(laid, metrics()) {
        if Text(t) = op {
            if t.text == controls.combo_box_value(combo()) {
                value_x = t.at.x
            }
        }
    }
    // Every small fill right of the value: the face is the whole box, so the mark is the only one.
    var marks = 0
    var mark_x = 0.0
    for op in widget.paint_ops(laid, metrics()) {
        if Fill(f) = op {
            val b = shape.path_bounds(f.path)
            if b.x > value_x && b.width < 30.0 {
                marks = marks + 1
                mark_x = b.x
            }
        }
    }
    test.assert_eq(marks, 1)
    // At the trailing edge, which is what makes it a combo box and not a label with a mark in it.
    test.assert(mark_x > value_x)
}

// **A tree's mark is clear of its own focus ring.** With no left inset a row at depth zero put its
// arrow at the very first point of the control -- under the ring, which paints after the rows and
// so over them. The arrow was there and the ring was on top of it.
#[test]
fn a_tree_row_is_inset_from_its_own_edge() {
    val laid = widget.layout(
        controls.tree_widget(forest(), frame()),
        geom.rect_of(0.0, 0.0, 200.0, 200.0),
        metrics()
    )
    // **The arrow too, which is now a fill rather than a glyph** -- and it is the leftmost thing
    // in a row, so a test that looked only at text would have stopped covering the very thing this
    // was written for.
    var leftmost = 1000.0
    for op in widget.paint_ops(laid, metrics()) {
        if Text(t) = op {
            if t.at.x < leftmost {
                leftmost = t.at.x
            }
        }
        if Fill(f) = op {
            val b = shape.path_bounds(f.path)
            // The row's own band is the full width; the arrow is the small one.
            if b.width < 30.0 && b.x < leftmost {
                leftmost = b.x
            }
        }
    }
    // Two points is the ring's width; the inset has to clear it.
    test.assert(leftmost >= 2.0)
}

// ---------------------------------------------------- a press in a text area

// The metrics here make a character ten points wide and a line twenty-four tall, so every number
// below is arithmetic rather than a measurement of a real face.
fn area() -> controls.Entry {
    return controls.text_area_of("notes", "Notes", "alpha\nbeta\ngamma", 3)
}

fn area_box() -> geom.Rect {
    return geom.rect_of(0.0, 0.0, 300.0, 120.0)
}

fn caret_after_press(e: controls.Entry, x: float, y: float) -> int {
    val got = controls.entry_input(
        e,
        controls.Input.Press(geom.point_of(x, y)),
        area_box(),
        frame()
    )
    return got.entry.editor.caret
}

// **`y` decided nothing at all**: a press put the caret with `caret_at_x` over the whole text, so
// a click on the third line landed in the first and typing appeared where nobody had clicked.
#[test]
fn a_press_in_a_text_area_lands_on_the_line_it_was_aimed_at() {
    val style = theme.plain()
    val line = controls.line_for(metrics(), style.text.body)
    val top = style.padding.top
    val left = style.padding.left
    // The first character of each line: "alpha" is 0, "beta" is 6, "gamma" is 11.
    test.assert_eq(caret_after_press(area(), left, top + line * 0.5), 0)
    test.assert_eq(caret_after_press(area(), left, top + line * 1.5), 6)
    test.assert_eq(caret_after_press(area(), left, top + line * 2.5), 11)
}

#[test]
fn a_press_in_a_text_area_lands_on_the_column_it_was_aimed_at() {
    val style = theme.plain()
    val line = controls.line_for(metrics(), style.text.body)
    // Two characters into the second line, which is index 6 + 2.
    test.assert_eq(
        caret_after_press(area(), style.padding.left + 20.0, style.padding.top + line * 1.5),
        8
    )
}

// Above the first line and below the last are the nearest line, not a refusal and not an index
// outside the text: a press is a gesture and a gesture near the edge means the edge.
#[test]
fn a_press_outside_the_lines_clamps_to_the_nearest_one() {
    val style = theme.plain()
    test.assert_eq(caret_after_press(area(), style.padding.left, -400.0), 0)
    test.assert_eq(caret_after_press(area(), style.padding.left, 4000.0), 11)
}

// A one-line field is unchanged, which is the half that was already right -- and a masked field
// takes the one-line path whatever `rows` says, exactly as `entry_widget` builds it.
#[test]
fn a_one_line_field_still_ignores_the_y_it_is_given() {
    val e = controls.entry_of("email", "Email", "abcdef")
    val style = theme.plain()
    val high = caret_after_press(e, style.padding.left + 20.0, 2.0)
    val low = caret_after_press(e, style.padding.left + 20.0, 90.0)
    test.assert_eq(high, low)
    test.assert_eq(high, 2)
}

// ---------------------------------------------------- where the focus ring goes

fn ring_box(l: widget.Laid, focused: string) -> geom.Rect {
    val painted = widget.paint_focused(l, metrics(), focused, paint.rgb(0.0, 0.0, 1.0), 2.0)
    var found = geom.rect_of(0.0, 0.0, 0.0, 0.0)
    for op in painted.ops {
        if StrokePath(st) = op {
            found = shape.path_bounds(st.path)
        }
    }
    return found
}

fn four_tabs() -> controls.Tabs {
    return with controls.tabs_of("views", "Views", ["One", "Two", "Three", "Four"]) {
        selected: 2
    }
}

fn laid_tabs(t: controls.Tabs) -> widget.Laid {
    return widget.layout(
        controls.tabs_widget(t, frame()),
        geom.rect_of(0.0, 0.0, 400.0, 40.0),
        metrics()
    )
}

// **A ring round the whole strip says every tab is focused.** One control takes the focus and Left
// and Right move along it, so the ring was as wide as all four tabs together -- which is what a
// user reads as "all of them are highlighted". ARIA's tab pattern puts the focus on the active
// tab, and this is the same fact drawn.
#[test]
fn a_focused_tab_strip_rings_the_chosen_tab_and_not_the_strip() {
    val t = four_tabs()
    val l = laid_tabs(t)
    val ring = ring_box(l, t.name)
    // One tab wide, where it used to be four: the whole of the complaint.
    test.assert(ring.width < t.tab_width + 2.0)
    // And over the tab that is actually selected -- the third of four, so two widths along --
    // rather than at the strip's own corner.
    test.assert(ring.x > t.tab_width * 2.0 - 3.0)
    test.assert(ring.x < t.tab_width * 2.0 + 3.0)
}

#[test]
fn the_ring_follows_the_selection_as_it_moves() {
    val first = ring_box(laid_tabs(with four_tabs() { selected: 0 }), "views")
    val last = ring_box(laid_tabs(with four_tabs() { selected: 3 }), "views")
    test.assert(last.x > first.x)
}

// **A list is focused as a whole and shows its selection by highlighting a row**, which is what
// every platform does -- so the opt-in is a field on the control rather than a rule about any
// control with a selected part.
#[test]
fn a_focused_list_still_rings_the_whole_list() {
    val l = widget.layout(controls.list_widget(five(), frame()), list_box(), metrics())
    val ring = ring_box(l, "people")
    val whole = l.bounds
    test.assert(ring.width > whole.width * 0.9)
}

// ---------------------------------------------------- the pointer's shape

fn cursor_word(c: widget.Cursor) -> string {
    return switch c {
        Arrow { "arrow" }
        ResizeAcross { "across" }
        ResizeDown { "down" }
        Text { "text" }
        Hand { "hand" }
    }
}

fn cursor_over(l: widget.Laid, x: float, y: float) -> string {
    return cursor_word(controls.cursor_at(l, geom.point_of(x, y)))
}

// **A divider's whole affordance is the cursor**: a line you cannot tell is draggable until you
// are already dragging it. The gallery showed an arrow over its own for as long as it had one.
#[test]
fn a_vertical_divider_asks_for_the_sideways_resize() {
    val l = laid_pane(pane(), pane_extent)
    test.assert_eq(cursor_over(l, 100.0 + divider_thickness * 0.5, 50.0), "across")
}

// **The direction comes from the divider's own box**, not from a second field that could disagree
// with it: one between two rows is wide and short, and moves the other way.
#[test]
fn a_horizontal_divider_asks_for_the_up_and_down_resize() {
    val down = with controls.split_pane_of("rows", "", widget.Direction.Column, 30.0) {
        first_min: 10.0,
        second_min: 10.0
    }
    val l = widget.layout(
        controls.split_pane_widget(down, 100.0, blank_pane("a"), blank_pane("b"), frame()),
        geom.rect_of(0.0, 0.0, 200.0, 100.0),
        metrics()
    )
    test.assert_eq(cursor_over(l, 100.0, 30.0 + divider_thickness * 0.5), "down")
}

#[test]
fn a_text_field_asks_for_the_text_cursor_and_a_button_does_not() {
    val field = widget.layout(
        controls.entry_widget(controls.entry_of("email", "Email", "a@b"), frame()),
        geom.rect_of(0.0, 0.0, 200.0, 30.0),
        metrics()
    )
    test.assert_eq(cursor_over(field, 100.0, 15.0), "text")
    val go = widget.layout(
        controls.button_widget(controls.button_of("go", "Go"), frame()),
        geom.rect_of(0.0, 0.0, 80.0, 30.0),
        metrics()
    )
    test.assert_eq(cursor_over(go, 40.0, 15.0), "arrow")
}

// **A pointer that keeps the text shape over a button says the button is not one.** A number
// field's steppers are buttons by look and behaviour but deliberately not `Control` nodes, so
// `cursor_at`'s role table called the whole field a `SpinButton` and handed back the I-beam over
// the arrows as well.
//
// **The points are the ones `a_press_on_a_stepper_steps_it` presses**, which is the assertion
// that matters: the shape and the gesture are worked out by different code -- the cursor from the
// steppers' laid boxes, the press from `up_box` arithmetic -- and this is what pins them to the
// same two places. A cursor that changed shape a few points away from where the click lands is
// the bug `split_pane_cursor` exists to avoid.
#[test]
fn the_pointer_is_an_arrow_over_a_stepper_and_text_in_the_field() {
    val l = widget.layout(controls.number_field_widget(port_field(), frame()), number_box, metrics())
    val right = number_box.x + number_box.width - 2.0
    test.assert_eq(cursor_over(l, right, 2.0), "arrow")
    test.assert_eq(cursor_over(l, right, number_box.height - 2.0), "arrow")
    // The text box keeps the I-beam, which is the half of this the role table already had right.
    test.assert_eq(cursor_over(l, 20.0, number_box.height * 0.5), "text")
}

#[test]
fn over_nothing_is_an_ordinary_arrow() {
    val l = laid_pane(pane(), pane_extent)
    test.assert_eq(cursor_over(l, 900.0, 900.0), "arrow")
}

// ---------------------------------------------------- the hover overlay

// The colour of the fill painted at a box, or black if nothing fills it: what a control is
// actually drawn as, which is the only question a state row answers.
fn face_at(ops: [scene.Op], want: geom.Rect) -> paint.Color {
    for op in ops {
        if Fill(it) = op {
            val at = shape.path_bounds(it.path)
            if at.x == want.x && at.y == want.y && at.width == want.width && at.height == want.height {
                if Solid(colour) = it.fill {
                    return colour
                }
            }
        }
        if Nested(group) = op {
            val inside = face_at(group.ops, box)
            if inside.alpha > 0.0 {
                return inside
            }
        }
    }
    return paint.rgba(0.0, 0.0, 0.0, 0.0)
}

// How many fills a tree paints in exactly this colour. **Counted rather than located**, because
// what a row's band is drawn at is the list's business and what it is drawn *in* is the look's.
fn fills_of(ops: [scene.Op], colour: paint.Color) -> int {
    var n = 0
    for op in ops {
        if Fill(it) = op {
            if Solid(c) = it.fill {
                if same_colour(c, colour) {
                    n = n + 1
                }
            }
        }
        if Nested(group) = op {
            n = n + fills_of(group.ops, colour)
        }
    }
    return n
}

fn same_colour(a: paint.Color, b: paint.Color) -> bool {
    return a.red == b.red && a.green == b.green && a.blue == b.blue && a.alpha == b.alpha
}

fn laid_button(f: controls.Frame) -> widget.Laid {
    return widget.layout(
        controls.button_widget(controls.button_of("go", "Send"), f),
        geom.rect_of(10.0, 20.0, 120.0, 30.0),
        metrics()
    )
}

fn button_face(f: controls.Frame) -> paint.Color {
    val l = laid_button(f)
    return face_at(widget.paint(l, metrics()).ops, geom.rect_of(10.0, 20.0, 120.0, 30.0))
}

// **Hover is painted from one name, not stored in the tree.** A `hovered` flag on every control
// would mean enter and leave events to deliver and a control left lit after the pointer had gone;
// the name the window holds reaches the paint function in the frame, and the control selects its
// own row from it.
//
// **This replaced a translucent veil painted over the finished scene** (`widget.paint_hovered`),
// which could darken a fill and nothing else: not an edge, not a corner, and not a word. A menu
// item whose face goes to the accent and whose text goes to `on_accent` -- the commonest hover
// there is -- was not expressible until the row was.
#[test]
fn a_hovered_control_is_drawn_in_the_hovered_row() {
    val resting = button_face(frame())
    val hovered = button_face(with frame() { hovered: "go" })
    test.assert(same_colour(resting, paint.flat_of(style().states.rest.face)))
    test.assert(same_colour(hovered, paint.flat_of(style().states.hovered.face)))
    test.assert(!same_colour(resting, hovered))
}

// A press outranks a hover, and being disabled outranks both. See `mood_of`, which is the one
// place that order lives.
#[test]
fn the_rows_are_ranked_disabled_then_pressed_then_hovered() {
    val held = with controls.button_of("go", "Send") { held: true }
    val off = with controls.button_of("go", "Send") { disabled: true }
    val hovering = with frame() { hovered: "go" }
    val pressed_box = widget.layout(
        controls.button_widget(held, hovering),
        geom.rect_of(10.0, 20.0, 120.0, 30.0),
        metrics()
    )
    val off_box = widget.layout(controls.button_widget(off, hovering), geom.rect_of(10.0, 20.0, 120.0, 30.0), metrics())
    val want = geom.rect_of(10.0, 20.0, 120.0, 30.0)
    test.assert(same_colour(
        face_at(widget.paint(pressed_box, metrics()).ops, want),
        paint.flat_of(style().states.pressed.face)
    ))
    test.assert(same_colour(
        face_at(widget.paint(off_box, metrics()).ops, want),
        paint.flat_of(style().states.disabled.face)
    ))
}

// **A part is a control too**, which is what lights a list's row and a menu's item: the name an
// application reads from `focus.control_at` is the innermost one under the pointer, and a row has
// one.
#[test]
fn a_row_can_be_hovered_as_well_as_its_list() {
    val hovering = with frame() { hovered: controls.row_name(five(), 1) }
    val l = widget.layout(controls.list_widget(five(), hovering), list_box(), metrics())
    val ops = widget.paint(l, metrics()).ops
    // One row lights and **the others do not**, which is the half that used to be an accident of
    // where the pointer was rather than a property of the tree. Three at rest, not four: the box
    // shows four of the five rows.
    test.assert_eq(1, fills_of(ops, paint.flat_of(style().states.hovered.face)))
    test.assert_eq(3, fills_of(ops, paint.flat_of(style().states.rest.face)))
}

// A name this tree does not hold draws nothing different rather than refusing: a pointer naming a
// control that has gone is an ordinary moment between two frames.
#[test]
fn an_unknown_or_empty_hover_changes_nothing() {
    val resting = button_face(frame())
    test.assert(same_colour(button_face(with frame() { hovered: "nobody" }), resting))
    test.assert(same_colour(button_face(with frame() { hovered: "" }), resting))
}

// **What is under the pointer is not what the pointer is on.** Over the empty part of a list that
// is the list, which is a perfectly good answer to the first question and a nonsensical one to the
// second -- and the gallery once painted a six per cent veil across its whole window because of
// it, measured as the background going from 246,247,249 to 231,232,234 and staying there.
//
// **It cannot happen now, and not because of a test**: a control that holds controls never asks
// about the pointer. `list_widget` passes `false` for hovered and its rows ask for themselves, so
// there is no code path that could light a container.
#[test]
fn a_control_that_holds_controls_is_not_hovered() {
    val hovering = with frame() { hovered: "people" }
    val l = widget.layout(controls.list_widget(five(), hovering), list_box(), metrics())
    val ops = widget.paint(l, metrics()).ops
    test.assert_eq(0, fills_of(ops, paint.flat_of(style().states.hovered.face)))
}

// The words a tree draws in exactly this colour. **A face and a word out of two different rows is
// the half-implemented state the five rows exist to prevent**, so the ink is worth counting too.
fn words_in(ops: [scene.Op], colour: paint.Color) -> int {
    var n = 0
    for op in ops {
        if Text(run) = op {
            if Solid(c) = run.fill {
                if same_colour(c, colour) {
                    n = n + 1
                }
            }
        }
        if Nested(group) = op {
            n = n + words_in(group.ops, colour)
        }
    }
    return n
}

// A look whose chosen row is the accent, which is what every real look does and what neither
// shipped look happens to do: `selection` is a grey in `plain` and a pale blue in `modern`, so the
// ink of a selected row is the same ink either way and a control reading the wrong one looks right.
fn accented_style() -> controls.Style {
    val base = theme.plain()
    return with base {
        states: with base.states {
            selected: with base.states.selected { face: paint.Paint.Solid(base.accent), ink: base.on_accent }
        }
    }
}

// **A row's words come from the row its face came from.** This is the defect the rows were supposed
// to remove and it survived the first pass: a list, a tab strip, a table and a radio group all drew
// their bands from the row and their labels from the *control*, which is invisible in both shipped
// looks and white-on-pale-blue in the first look that accents a selection.
#[test]
fn a_chosen_row_draws_its_words_in_its_own_ink() {
    val look = accented_style()
    val f = controls.frame_of(look, metrics())
    val chosen = with five() { selected: 1 }
    val ops = widget.paint(widget.layout(controls.list_widget(chosen, f), list_box(), metrics()), metrics()).ops
    // The chosen row's band is the accent and its label is `on_accent`; the rest are not.
    test.assert_eq(1, fills_of(ops, look.accent))
    test.assert_eq(1, words_in(ops, look.on_accent))
}

#[test]
fn a_chosen_tab_and_a_chosen_radio_do_the_same() {
    val look = accented_style()
    val f = controls.frame_of(look, metrics())
    val tabs = widget.layout(controls.tabs_widget(panes(), f), geom.rect_of(0.0, 0.0, 300.0, 30.0), metrics())
    // A chosen tab wears the panel rather than the selection -- deliberately, see `tab_face_of` --
    // but its ink is still the selected row's, which is the part that has to follow.
    test.assert_eq(1, words_in(widget.paint(tabs, metrics()).ops, look.on_accent))
    val group = widget.layout(controls.radios_widget(radios(), f), geom.rect_of(0.0, 0.0, 200.0, 80.0), metrics())
    test.assert_eq(1, words_in(widget.paint(group, metrics()).ops, look.on_accent))
}

// ------------------------------------------- the expansion invariant (F294)

// A look whose every row expands, which no shipped look does: the invariant has to hold for the
// look that exercises it, not only for the two that happen not to.
fn expanding_style() -> controls.Style {
    val base = theme.plain()
    return with base {
        states: controls.States {
            rest: base.states.rest,
            hovered: with base.states.hovered { expansion: 2.0 },
            pressed: with base.states.pressed { expansion: 3.0 },
            disabled: base.states.disabled,
            selected: with base.states.selected { expansion: 1.0 }
        }
    }
}

// **No state may change a control's bounds.** `expansion` is a paint-time outset and is never an
// input to layout or to a hit test -- which is the one thing in F294 that could go wrong quietly,
// because the symptom is not a wrong colour but a control that answers to the pointer at a pixel
// its layout never claimed, and two neighbours that both claim the boundary between them.
//
// egui concedes the same wart in its own documentation -- its `expansion` "makes hovered things
// misaligned" -- and gets away with it by laying out every frame, which this does not.
#[test]
fn no_state_moves_a_control_s_own_box() {
    val b = controls.button_of("go", "Send")
    val held = with b { held: true }
    val off = with b { disabled: true }
    val at = geom.rect_of(10.0, 20.0, 120.0, 30.0)
    val look = expanding_style()
    val resting = controls.frame_of(look, metrics())
    val boxes = [
        widget.layout(controls.button_widget(b, resting), at, metrics()).bounds,
        widget.layout(controls.button_widget(b, with resting { hovered: "go" }), at, metrics()).bounds,
        widget.layout(controls.button_widget(held, with resting { hovered: "go" }), at, metrics()).bounds,
        widget.layout(controls.button_widget(off, resting), at, metrics()).bounds
    ]
    for one in boxes {
        test.assert_eq(one.x, boxes[0].x)
        test.assert_eq(one.y, boxes[0].y)
        test.assert_eq(one.width, boxes[0].width)
        test.assert_eq(one.height, boxes[0].height)
    }
}

// And the hit test agrees with the layout in every state, which is the half a reader cares about:
// a button that looks bigger must not *be* bigger.
#[test]
fn a_hit_test_answers_the_same_in_every_state() {
    val look = expanding_style()
    val resting = controls.frame_of(look, metrics())
    val at = geom.rect_of(0.0, 0.0, 120.0, 30.0)
    val corner = geom.point_of(1.0, 1.0)
    val taken = controls.button_input(
        controls.button_of("go", "Send"),
        controls.Input.Press(corner),
        at
    )
    val hovered_take = controls.button_input(
        with controls.button_of("go", "Send") { held: true },
        controls.Input.Press(corner),
        at
    )
    // Both presses land, because the box is the box whatever the frame is drawn at.
    test.assert(taken.button.held)
    test.assert(hovered_take.button.held)
}

// **The frame grows and the box does not**, which is what the reserve buys: a hovered fill is
// drawn larger than a resting one inside the same bounds.
#[test]
fn an_expanding_state_draws_a_larger_frame_in_the_same_box() {
    val look = expanding_style()
    val resting = controls.frame_of(look, metrics())
    val at = geom.rect_of(0.0, 0.0, 120.0, 30.0)
    val rest_ops = widget.paint(
        widget.layout(controls.button_widget(controls.button_of("go", "Send"), resting), at, metrics()),
        metrics()
    )
    val over_ops = widget.paint(
        widget.layout(
            controls.button_widget(controls.button_of("go", "Send"), with resting { hovered: "go" }),
            at,
            metrics()
        ),
        metrics()
    )
    val resting_frame = frame_box(rest_ops.ops, paint.flat_of(look.states.rest.face))
    val hovered_frame = frame_box(over_ops.ops, paint.flat_of(look.states.hovered.face))
    test.assert(hovered_frame.width > resting_frame.width)
    // ...and still inside the box the layout claimed.
    test.assert(hovered_frame.width < at.width + 0.001)
}

fn frame_box(ops: [scene.Op], colour: paint.Color) -> geom.Rect {
    for op in ops {
        if Fill(it) = op {
            if Solid(c) = it.fill {
                if same_colour(c, colour) {
                    return shape.path_bounds(it.path)
                }
            }
        }
        if Nested(group) = op {
            val inside = frame_box(group.ops, colour)
            if inside.width > 0.0 {
                return inside
            }
        }
    }
    return geom.rect_of(0.0, 0.0, 0.0, 0.0)
}

// ---------------------------------------------------- the marks are drawn

fn drawings_in(l: widget.Laid) -> [geom.Rect] {
    val out = mutable_array_new<geom.Rect>()
    gather_drawings(l, out)
    return snapshot(out)
}

fn gather_drawings(l: widget.Laid, out: MutableArray<geom.Rect>) {
    if Drawing(_) = l.widget {
        push(out, l.bounds)
    }
    for child in l.children {
        gather_drawings(child, out)
    }
}

fn laid_check(t: widget.Toggle) -> widget.Laid {
    return widget.layout(
        controls.check_box_widget(
            controls.check_box_of("notify", "Notify me", t),
            frame()
        ),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
}

// **A mark is a path, not a glyph, and that is two fixes.** As a glyph it was placed on a
// baseline -- a font puts its ink between the baseline and the x-height and leaves the descender
// empty, so a tick centred as a *box* sat visibly low in a square. And a glyph has to exist: a
// face without the character draws `.notdef`, which is why every application here replaces the
// tree's marks with ASCII before it opens a window.
#[test]
fn a_checked_box_draws_a_mark_with_a_box_of_its_own() {
    val marks = drawings_in(laid_check(widget.Toggle.On))
    test.assert_len(1, marks)
    // **Square and not empty**, which is the half a `Drawing` cannot provide for itself: it
    // measures nothing on purpose, so a mark handed to a stack that centres rather than stretches
    // is laid out zero by zero and draws nothing at all.
    test.assert(marks[0].width > 0.0)
    test.assert_eq(marks[0].width, marks[0].height)
    test.assert_len(1, drawings_in(laid_check(widget.Toggle.Mixed)))
}

// An unchecked box draws no mark at all rather than an empty one: `Nothing` is the honest answer
// for "there is no mark here".
#[test]
fn an_unchecked_box_draws_no_mark() {
    test.assert_len(0, drawings_in(laid_check(widget.Toggle.Off)))
}

// A radio's dot is the same story, and a group draws exactly one of them.
#[test]
fn a_radio_group_draws_one_dot() {
    val l = widget.layout(
        controls.radios_widget(radios(), frame()),
        radio_box,
        metrics()
    )
    test.assert_len(1, drawings_in(l))
}

// ---- density, measured on what gets laid out

// **The floor, asserted on ink rather than on tokens.** `theme_test` checks that `at_density` does
// not touch `minimum`; this checks the thing that actually matters, which is that a control laid
// out at the tightest density is still big enough to hit. The two are different claims: a token
// could be left alone while a control shrank past it anyway, because what a control measures comes
// from its padding and its text as well as from the floor.
//
// 24 points is WCAG 2.2 SC 2.5.8. A check box is one line square, which at this file's fake
// metrics is exactly 24 -- so this test sits on the boundary deliberately, where an off-by-a-hair
// in the scale would show.
#[test]
fn a_tight_density_still_leaves_a_target_you_can_hit() {
    for d in theme.densities() {
        val s = theme.at_density(theme.plain(), d)
        val within = geom.rect_of(0.0, 0.0, 300.0, 200.0)

        // **The target is the control, not its ornament.** The first draft of this test measured
        // `face_box`, which is the check box's little square -- and at Compact that square is 21.6
        // points, because `at_density` tightens the leading and the square is one line tall. It
        // read as a failure and it is not one: what a pointer has to hit is the control's own node,
        // which `check_box_input` is handed and which includes the label beside the square. A
        // 15-point square inside a 30-point row is how every platform draws a check box.
        val check = widget.layout(controls.check_box_widget(a_check_box(), frame_in(s)), within, metrics())
        test.assert(box_named(check, "tls").height >= s.minimum.target)

        val button = widget.layout(
            controls.button_widget(controls.button_of("go", "Go"), frame_in(s)),
            within,
            metrics()
        )
        test.assert(face_box(button).height >= s.minimum.target)

        // A radio group's row is the floor by construction, so this is the cheap end of the claim
        // -- but it is the one that would break first if `at_density` ever reached `minimum`.
        val group = widget.layout(controls.radios_widget(radios(), frame_in(s)), within, metrics())
        test.assert(box_named(group, controls.radio_name(radios(), 0)).height >= s.minimum.target)
    }
}

// --- a table of values

fn typed_columns() -> [controls.Column] {
    return [
        controls.column_of("Name", 80.0),
        controls.numeric_column_of("Dose", 60.0),
        controls.column_of("Taken", 50.0),
        controls.column_of("Since", 90.0)
    ]
}

fn taken_on() -> time.LocalDate {
    return switch time.localdate_of(2026, 11, 19) {
        Ok(d) { d }
        Err(_) { time.localdate_from_epoch_day(0) }
    }
}

fn typed_table(l: Locale) -> controls.Table {
    return controls.table_of("meds", "Medicines", typed_columns(), [
        [
            controls.Value.Text("Aspirin"),
            controls.Value.Number(1234.5),
            controls.Value.Flag(widget.Toggle.On),
            controls.Value.Date(taken_on())
        ],
        [controls.Value.Text("Ibuprofen"), controls.Value.Whole(400), controls.Value.Flag(widget.Toggle.Off)]
    ], l)
}

// **A column of numbers held as text cannot be formatted for a locale.** Holding the value and
// writing it late is what lets the same table read correctly in two of them -- which is
// `TableModel.getColumnClass` plus a `NumberFormat`, decided by a switch instead of by
// reflection.
#[test]
fn a_number_cell_is_written_in_its_tables_own_locale() {
    val british = typed_table(locale.of("en_GB.UTF-8"))
    val german = typed_table(locale.of("de_DE.UTF-8"))
    test.assert_eq(controls.cell_at(british, 0, 1), "1,234.5")
    test.assert_eq(controls.cell_at(german, 0, 1), "1.234,5")
    // And a whole number takes the same separators without a decimal point appearing.
    test.assert_eq(controls.cell_at(german, 1, 1), "400")
}

// **A flag reads as a reader would say it**, from `a11y.toggle_word` rather than from a second
// vocabulary here: a cell saying "checked" while a check box beside it says "on" would be the
// library disagreeing with itself in two places a user meets together.
#[test]
fn a_flag_cell_reads_as_a_check_box_does() {
    val t = typed_table(locale.of("en_GB.UTF-8"))
    test.assert_eq(controls.cell_at(t, 0, 2), "checked")
    test.assert_eq(controls.cell_at(t, 1, 2), "unchecked")
}

// **`Blank` is not the empty string.** A missing measurement and a measurement of "" are
// different facts; a short row has the first and a reader should hear the column anyway.
#[test]
fn a_short_row_is_blank_past_its_end_and_still_read() {
    val t = typed_table(locale.of("en_GB.UTF-8"))
    test.assert(controls.Value.is_Blank(controls.value_at(t, 1, 3)))
    test.assert_eq(controls.cell_at(t, 1, 3), "")
    // The row is still read as four columns, so the empty one is heard as empty rather than
    // dropped.
    test.assert_eq(controls.row_label(t, 1), "Ibuprofen, 400, unchecked, ")
}

// A date takes its table's locale too, and the whole row reads as a reader hears it.
#[test]
fn a_row_reads_its_values_as_they_are_written() {
    val t = typed_table(locale.of("en_GB.UTF-8"))
    test.assert_eq(controls.row_label(t, 0), "Aspirin, 1,234.5, checked, 2026-11-19")
}

// **Every caller written before `Value` existed still compiles**, which is what the string
// overload is for: a table of words says nothing about types.
#[test]
fn a_table_of_plain_strings_still_works() {
    val plain = controls.table_of("plain", "", typed_columns(), [["a", "b"]])
    test.assert_eq(controls.cell_at(plain, 0, 0), "a")
    test.assert(controls.Value.is_Text(controls.value_at(plain, 0, 1)))
}

// **A year is not a quantity, and neither is a port or a status code.** Written as one it comes
// out "1,766" -- which is how this variant was found: by rendering the gallery's table and
// reading it. `Code` is never grouped and never localised.
#[test]
fn a_code_is_written_plainly_where_a_quantity_is_grouped() {
    val german = typed_table(locale.of("de_DE.UTF-8"))
    val coded = controls.table_of("codes", "", typed_columns(), [
        [controls.Value.Code(1766), controls.Value.Whole(1766)]
    ], locale.of("de_DE.UTF-8"))
    test.assert_eq(controls.cell_at(coded, 0, 0), "1766")
    test.assert_eq(controls.cell_at(coded, 0, 1), "1.766")
    test.assert_eq(controls.cell_at(german, 0, 1), "1.234,5")
}

fn pennies() -> decimal {
    return switch parse_decimal("0.1") {
        Ok(d) { d }
        Err(_) { 0.0d }
    }
}

// **A column of money held as `Number` is the oldest arithmetic bug there is, printed into a
// table.** `Number` is a float; `Exact` is a decimal and keeps every digit it was given.
#[test]
fn an_exact_cell_keeps_the_digits_a_float_would_lose() {
    val l = locale.of("en_GB.UTF-8")
    val exact = controls.table_of("till", "", typed_columns(), [
        [controls.Value.Exact(pennies() + pennies() + pennies())]
    ], l)
    test.assert_eq(controls.cell_at(exact, 0, 0), "0.3")
    // Held as a float, the same sum is not the same number.
    test.assert(0.1 + 0.1 + 0.1 != 0.3)
}

// A decimal and a bigint are grouped like any other quantity, in the table's own locale.
#[test]
fn exact_and_big_cells_take_the_locales_separators() {
    val german = locale.of("de_DE.UTF-8")
    val big = switch parse_bigint("123456789012345678901234567890") {
        Ok(b) { b }
        Err(_) { 0n }
    }
    val t = controls.table_of("big", "", typed_columns(), [
        [controls.Value.Exact(1234.5d), controls.Value.Big(big)]
    ], german)
    test.assert_eq(controls.cell_at(t, 0, 0), "1.234,5")
    test.assert_eq(controls.cell_at(t, 0, 1), "123.456.789.012.345.678.901.234.567.890")
}

// **`Blank` is already the `None` case**, so `value_or_blank` is a convenience and not a second
// way to say it: a nullable column maps straight through without a switch at every cell.
#[test]
fn an_absent_value_becomes_a_blank_cell() {
    val here = controls.value_or_blank(Option<float>.Some(2.5))
    val gone = controls.value_or_blank(Option<float>.None)
    test.assert(controls.Value.is_Number(here))
    test.assert(controls.Value.is_Blank(gone))
    test.assert(controls.Value.is_Blank(controls.value_or_blank(Option<string>.None)))
    test.assert(controls.Value.is_Text(controls.value_or_blank(Option<string>.Some("x"))))
    test.assert(controls.Value.is_Exact(controls.value_or_blank(Option<decimal>.Some(1.0d))))
}

// --- the autocomplete

val suggest_box = geom.rect_of(0.0, 0.0, 200.0, 24.0)
val suggest_popup = geom.rect_of(0.0, 24.0, 200.0, 120.0)

fn drugs() -> controls.Autocomplete {
    return controls.autocomplete_of("drug", "Medication", [
        "Aspirin",
        "Ibuprofen",
        "Co-amoxiclav",
        "Paracetamol",
        "Amoxicillin"
    ])
}

fn auto_step(a: controls.Autocomplete, input: controls.Input) -> controls.AutocompleteStep {
    return controls.autocomplete_input(a, input, suggest_box, suggest_popup, frame())
}

fn auto_typed(a: controls.Autocomplete, text: string) -> controls.Autocomplete {
    var now = a
    for ch in chars(text) {
        now = auto_step(now, controls.Input.Text(ch)).field
    }
    return now
}

fn matched(a: controls.Autocomplete) -> string {
    return join(Option<string>.None, Option<string>.None, Option<string>.Some(","), controls.autocomplete_matches(a))
}

// **Typing filters and opens**, and the match is a substring rather than a prefix: medical names
// are long and the part a user remembers is often in the middle -- "amox" finds Co-amoxiclav as
// well as Amoxicillin.
#[test]
fn typing_filters_by_substring_and_opens_the_suggestions() {
    val typed = auto_typed(drugs(), "amox")
    test.assert(typed.open)
    test.assert_eq(matched(typed), "Co-amoxiclav,Amoxicillin")
    // Case-insensitively, by the locale-free fold: see `autocomplete_matches`.
    test.assert_eq(matched(auto_typed(drugs(), "ASPIR")), "Aspirin")
    // And an empty field offers everything rather than nothing.
    test.assert_eq(len(controls.autocomplete_matches(drugs())), 5)
}

// **The arrows do not write into the field.** Filling the entry as the highlight moves reads
// well and destroys the typing of a user who arrows past their answer: moving the highlight is
// looking, Enter is choosing.
#[test]
fn the_arrows_move_the_highlight_without_touching_the_text() {
    val typed = auto_typed(drugs(), "a")
    val moved = auto_step(typed, controls.Input.KeyDown(key(controls.Key.Down))).field
    test.assert_eq(controls.autocomplete_text(moved), "a")
    test.assert(controls.autocomplete_highlighted(moved) != "")
    test.assert_eq(controls.autocomplete_text(typed), controls.autocomplete_text(moved))
}

// **The popup stays open when nothing matches, and says so.** One that vanished would be
// indistinguishable from one that broke, and the user would not know whether to keep typing.
#[test]
fn nothing_matching_leaves_the_popup_open_and_says_so() {
    val none = auto_typed(drugs(), "zzz")
    test.assert(none.open)
    test.assert_eq(matched(none), "")
    test.assert_eq(controls.autocomplete_said(none), "no suggestions")
}

// **This is the half every home-grown autocomplete leaves out.** A list that silently goes from a
// hundred rows to three has told a sighted user something and a blind user nothing.
#[test]
fn a_reader_is_told_how_far_the_list_has_narrowed() {
    test.assert_eq(controls.autocomplete_said(auto_typed(drugs(), "amox")), "2 of 5 suggestions")
    // Four of the five hold an "a" -- Ibuprofen does not.
    test.assert_eq(controls.autocomplete_said(auto_typed(drugs(), "a")), "4 of 5 suggestions")
    // When everything still matches it says so plainly rather than "5 of 5", which reads as a
    // filter that has done something.
    val all_open = auto_step(drugs(), controls.Input.KeyDown(key(controls.Key.Down))).field
    test.assert_eq(controls.autocomplete_said(all_open), "5 suggestions")
    // Shut, it says nothing -- there is no list to describe.
    test.assert_eq(controls.autocomplete_said(drugs()), "")
}

// **Enter with nothing highlighted does not take the first match**, which is how a form ends up
// holding a diagnosis nobody chose. A field that allows free text keeps what was typed; one that
// does not gives it up.
#[test]
fn enter_with_no_highlight_never_guesses() {
    val typed = auto_typed(drugs(), "amox")
    val strict = auto_step(typed, controls.Input.KeyDown(key(enter)))
    test.assert_eq(strict.chosen, "")
    test.assert_eq(controls.autocomplete_text(strict.field), "")
    test.assert_false(strict.field.open)

    val loose = auto_step(with typed { free_text: true }, controls.Input.KeyDown(key(enter)))
    test.assert_eq(loose.chosen, "amox")
    test.assert(loose.changed)

    // With a highlight, Enter takes it.
    val onto = auto_step(typed, controls.Input.KeyDown(key(controls.Key.Down))).field
    val picked = auto_step(onto, controls.Input.KeyDown(key(enter)))
    test.assert_eq(picked.chosen, "Co-amoxiclav")
    test.assert_eq(controls.autocomplete_text(picked.field), "Co-amoxiclav")
}

// **Escape shuts the popup and keeps the typing; a second Escape gives it up.** One key, one step
// -- which is what the calendar's Escape does between its views.
#[test]
fn escape_shuts_the_popup_before_it_gives_up_the_typing() {
    val typed = auto_typed(drugs(), "amox")
    val shut = auto_step(typed, controls.Input.KeyDown(key(controls.Key.Escape))).field
    test.assert_false(shut.open)
    test.assert_eq(controls.autocomplete_text(shut), "amox")

    val given_up = auto_step(shut, controls.Input.KeyDown(key(controls.Key.Escape))).field
    test.assert_eq(controls.autocomplete_text(given_up), "")
}

// **A value already committed is what the text reverts to**, not the empty string: abandoning a
// half-typed replacement must not clear a field that already held something.
#[test]
fn abandoning_a_change_puts_the_committed_value_back() {
    val typed = auto_typed(drugs(), "amox")
    val onto = auto_step(typed, controls.Input.KeyDown(key(controls.Key.Down))).field
    val held = auto_step(onto, controls.Input.KeyDown(key(enter))).field
    test.assert_eq(controls.autocomplete_text(held), "Co-amoxiclav")

    val retyped = auto_typed(held, "zz")
    val gone = auto_step(
        auto_step(retyped, controls.Input.KeyDown(key(controls.Key.Escape))).field,
        controls.Input.KeyDown(key(controls.Key.Escape))
    ).field
    test.assert_eq(controls.autocomplete_text(gone), "Co-amoxiclav")
}

// A shut field opens on Down with everything in it, which is the combo box's gesture and what a
// user with no idea what the field accepts will try first.
#[test]
fn down_opens_a_shut_field_on_the_whole_set() {
    val opened = auto_step(drugs(), controls.Input.KeyDown(key(controls.Key.Down))).field
    test.assert(opened.open)
    test.assert_eq(len(controls.autocomplete_matches(opened)), 5)
}

// **It is a combo box to a reader**, which is what ARIA says a text input with a list is -- and
// the count rides on the description, which is where it can go until there is a live region.
#[test]
fn an_autocomplete_announces_itself_as_a_combo_box_with_a_count() {
    val typed = auto_typed(drugs(), "amox")
    test.assert_eq(
        said_of(controls.autocomplete_widget(typed, frame()), "drug"),
        "combo box, Medication, amox, expanded, 2 of 5 suggestions"
    )
}

// --- sorting a table

fn sortable() -> controls.Table {
    return controls.table_of("sorted", "Readings", typed_columns(), [
        [controls.Value.Text("Beta"), controls.Value.Whole(9), controls.Value.Flag(widget.Toggle.On)],
        [controls.Value.Text("Alpha"), controls.Value.Whole(10), controls.Value.Flag(widget.Toggle.Off)],
        [controls.Value.Text("Gamma"), controls.Value.Blank, controls.Value.Flag(widget.Toggle.Mixed)]
    ], locale.of("en_GB.UTF-8"))
}

fn order_of(t: controls.Table) -> string {
    val out = mutable_array_new<string>()
    for row in controls.sorted_order(t) {
        push(out, controls.cell_at(t, row, 0))
    }
    return join(Option<string>.None, Option<string>.None, Option<string>.Some(","), snapshot(out))
}

// **This is what F321 was for.** A column of text sorts "10" before "9", which makes a sorted
// table worse than an unsorted one: the user believes an order that is not there.
#[test]
fn a_number_column_sorts_as_numbers_and_not_as_text() {
    val by_number = controls.sorted_on(sortable(), 1)
    test.assert_eq(order_of(by_number), "Beta,Alpha,Gamma")
    // 9 before 10, which string comparison gets backwards.
    test.assert_eq(controls.cell_at(by_number, controls.sorted_order(by_number)[0], 1), "9")
}

// **A `Blank` sorts to the end whichever way the column points.** A missing measurement is not
// smaller than every number and larger than none; it is absent, and flipping it with the rest
// would make reversing a column look like data moving.
#[test]
fn a_blank_stays_at_the_end_in_both_directions() {
    val up = controls.sorted_on(sortable(), 1)
    val down = controls.sorted_on(up, 1)
    test.assert_false(up.ascending == down.ascending)
    test.assert_eq(order_of(up), "Beta,Alpha,Gamma")
    test.assert_eq(order_of(down), "Alpha,Beta,Gamma")
}

// **Three states, not two.** The order a caller gave is meaningful -- a query already ordered by
// date -- and a header that could only toggle between two sorts would throw it away the moment
// somebody touched it.
#[test]
fn a_third_press_puts_the_given_order_back() {
    val once = controls.sorted_on(sortable(), 0)
    val twice = controls.sorted_on(once, 0)
    val thrice = controls.sorted_on(twice, 0)
    test.assert_eq(order_of(once), "Alpha,Beta,Gamma")
    test.assert_eq(order_of(twice), "Gamma,Beta,Alpha")
    test.assert_eq(thrice.sorted_by, 0 - 1)
    test.assert_eq(order_of(thrice), "Beta,Alpha,Gamma")
}

// **The selection follows the record and not the row it was sitting on.** `selected` is an index
// into `rows`, so sorting the data itself would silently move it to a different record -- which
// is why the order is a projection.
#[test]
fn sorting_keeps_the_selection_on_the_same_record() {
    val t = with sortable() { selected: 0 }
    test.assert_eq(controls.cell_at(t, t.selected, 0), "Beta")
    val sorted = controls.sorted_on(t, 0)
    test.assert_eq(controls.cell_at(sorted, sorted.selected, 0), "Beta")
    // And it has moved on screen, from the first row to the second.
    test.assert_eq(controls.display_at(t, 0), 0)
    test.assert_eq(controls.display_at(sorted, 0), 1)
}

// **The two index spaces have to agree**: a position on screen maps to a record and back. This is
// the calendar's twenty-two points in another costume -- a control that confused them would
// select a different record from the one under the pointer.
#[test]
fn a_position_and_a_record_round_trip_through_each_other() {
    val sorted = controls.sorted_on(sortable(), 0)
    var at = 0
    while at < 3 {
        test.assert_eq(controls.display_at(sorted, controls.row_shown_at(sorted, at)), at)
        at = at + 1
    }
    // Off the end is -1 rather than a wrong row.
    test.assert_eq(controls.row_shown_at(sorted, 3), 0 - 1)
    test.assert_eq(controls.display_at(sorted, 9), 0 - 1)
}

// A flag column orders off, then partly, then on -- the order the three states are declared in.
#[test]
fn a_flag_column_orders_by_what_the_toggle_means() {
    test.assert_eq(order_of(controls.sorted_on(sortable(), 2)), "Alpha,Gamma,Beta")
}

// **The header says which way it is pointing**, because `a11y` has no live region: there is
// nowhere to announce the change as it happens, so a reader has to hear it on arrival.
#[test]
fn a_sorted_column_tells_a_reader_which_way() {
    val sorted = controls.sorted_on(sortable(), 0)
    test.assert_eq(
        said_of(controls.table_widget(sorted, frame()), controls.column_header_name(sorted, 0)),
        "column header, Name, ascending"
    )
}

// --- a panel that is waiting

fn records() -> widget.Widget {
    return controls.button_widget(controls.button_of("panel-edit", "Edit"), frame())
}

fn panel() -> controls.Panel {
    return controls.panel_of("meds", "Medications", "No medications recorded")
}

fn panel_laid(p: controls.Panel, content: widget.Widget) -> widget.Laid {
    return widget.layout(
        controls.panel_widget(p, content, frame()),
        geom.rect_of(0.0, 0.0, 200.0, 120.0),
        metrics()
    )
}

fn panel_says(p: controls.Panel, content: widget.Widget) -> string {
    return switch a11y.node_of(a11y.tree_of(panel_laid(p, content), "x", ""), "meds/state") {
        Some(n) { n.name }
        None { "(absent)" }
    }
}

// **A Tab cannot land in a form that is still being fetched**, because there is no form there
// yet. This is the expander's rule and here it is what makes the keyboard behave: a panel that
// drew a spinner *over* its content would leave every control underneath reachable, focusable and
// editable -- which is how a user edits a record that is about to be replaced by the one still
// arriving.
#[test]
fn a_waiting_panel_holds_nothing_a_tab_can_reach() {
    test.assert_eq(len(focus.controls(panel_laid(controls.panel_ready(panel()), records()))), 1)
    test.assert_eq(len(focus.controls(panel_laid(controls.panel_loading(panel()), records()))), 0)
    test.assert_eq(len(focus.controls(panel_laid(panel(), records()))), 0)
    test.assert_eq(
        len(focus.controls(panel_laid(controls.panel_failed(panel(), "Could not load"), records()))),
        0
    )
}

// **A loading flag is not enough**, which is why this is an enum: a panel that is empty and one
// that is still fetching look the same to a boolean and must not look the same to a user. "No
// medications recorded" while a query is still running is a statement that is not true yet.
#[test]
fn an_empty_panel_and_a_waiting_one_do_not_say_the_same_thing() {
    test.assert_eq(panel_says(controls.panel_loading(panel()), records()), "Medications: loading")
    test.assert_eq(
        panel_says(controls.panel_ready(panel()), widget.Widget.Nothing),
        "Medications: No medications recorded"
    )
    test.assert_eq(panel_says(controls.panel_ready(panel()), records()), "Medications: ready")
    // Nothing has been asked for yet, so there is nothing to say.
    test.assert_eq(panel_says(panel(), records()), "")
}

// **A failure interrupts and the rest waits its turn.** A panel that finished is news the user can
// hear when the reader reaches it; a panel that could not is news they are about to act without.
#[test]
fn only_a_failure_interrupts_the_reader() {
    val failed = controls.panel_failed(panel(), "Could not load")
    test.assert(controls.waiting_is_urgent(failed))
    test.assert_false(controls.waiting_is_urgent(controls.panel_loading(panel())))
    test.assert_eq(panel_says(failed, records()), "Medications: Could not load")
    // Which is the role the region carries, and so the politeness it is spoken with.
    switch a11y.node_of(a11y.tree_of(panel_laid(failed, records()), "x", ""), "meds/state") {
        Some(n) { test.assert(widget.Role.is_Alert(n.role)) }
        None { test.assert(false) }
    }
}

// **A panel that finished while the user was looking elsewhere says so**, which is what F329 was
// built for and the half this task could not have met an hour before it.
#[test]
fn finishing_is_announced_rather_than_waited_to_be_found() {
    val before = a11y.tree_of(panel_laid(controls.panel_loading(panel()), records()), "x", "")
    val after = a11y.tree_of(panel_laid(controls.panel_ready(panel()), records()), "x", "")
    val said = a11y.announcements(before, after)
    test.assert_eq(len(said), 1)
    test.assert_eq(said[0].text, "Medications: ready")
    test.assert_false(said[0].assertive)
    // And a panel that is still loading on the next frame says nothing at all.
    test.assert_eq(len(a11y.announcements(before, before)), 0)
}

// --- the search field

val search_box = geom.rect_of(0.0, 0.0, 200.0, 26.0)

fn finder() -> controls.Search {
    return controls.search_of("find", "Search medications")
}

fn search_step(s: controls.Search, input: controls.Input) -> controls.SearchStep {
    return controls.search_input(s, input, search_box, frame())
}

fn search_typed(s: controls.Search, text: string) -> controls.Search {
    var now = s
    for ch in chars(text) {
        now = search_step(now, controls.Input.Text(ch)).search
    }
    return now
}

fn search_laid(s: controls.Search) -> widget.Laid {
    return widget.layout(controls.search_widget(s, frame()), search_box, metrics())
}

// **The clear mark must not be a second tab stop.** A search box that put it in the tab order
// would make Tab out of a search field take two presses, in every form that has one.
#[test]
fn a_search_field_is_one_tab_stop_even_with_something_to_clear() {
    test.assert_eq(len(focus.controls(search_laid(finder()))), 1)
    test.assert_eq(len(focus.controls(search_laid(search_typed(finder(), "asp")))), 1)
}

// **The mark appears only when there is something to clear**, because a button that does nothing
// is worse than no button: the pointer changes over it and promises otherwise.
#[test]
fn the_clear_mark_is_absent_until_there_is_something_to_clear() {
    test.assert_false(holds_named(search_laid(finder()), controls.search_clear_name(finder())))
    test.assert(holds_named(
        search_laid(search_typed(finder(), "asp")),
        controls.search_clear_name(finder())
    ))
}

// A press on the mark clears the field, and the focus is not taken: the next thing a user does
// after clearing a search is type another one.
#[test]
fn pressing_the_mark_clears_the_field() {
    val typed = search_typed(finder(), "asp")
    test.assert_eq(controls.search_text(typed), "asp")
    val at = centre_in(search_laid(typed), controls.search_clear_name(typed))
    val step = search_step(typed, controls.Input.Press(at))
    test.assert_eq(controls.search_text(step.search), "")
    test.assert(step.changed)
}

// **Escape clears it**, which is what every search box does and why the key is worth spending
// here: a user who wants their list back should not have to select the text first.
#[test]
fn escape_clears_the_search() {
    val typed = search_typed(finder(), "asp")
    val step = search_step(typed, controls.Input.KeyDown(key(controls.Key.Escape)))
    test.assert_eq(controls.search_text(step.search), "")
    test.assert(step.changed)
    // On an empty field it changes nothing, so a caller can let Escape fall through to a dialog.
    test.assert_false(search_step(finder(), controls.Input.KeyDown(key(controls.Key.Escape))).changed)
}

// **A reader hears the label, not a placeholder**: this field has none, deliberately, because a
// hint inside the box disappears the moment somebody types.
#[test]
fn a_search_field_announces_what_it_searches() {
    test.assert_eq(
        said_of(controls.search_widget(search_typed(finder(), "asp"), frame()), "find"),
        "text field, Search medications, asp"
    )
}

// --- the badge

fn badged(n: int) -> controls.Button {
    return with controls.button_of("meds", "Medications") { badge: controls.count_badge_of(n) }
}

// **One phrase and not two nodes**, which is the whole point of the arrangement: a reader saying
// "Medications" and then, separately, "3" has read the user two facts where there is one.
#[test]
fn a_badge_is_part_of_what_its_control_says() {
    test.assert_eq(said_of(controls.button_widget(badged(3), frame()), "meds"), "button, Medications, 3")
    test.assert_eq(said_of(controls.button_widget(badged(0), frame()), "meds"), "button, Medications")
}

// And it is not a node of its own, so a reader walking the tree does not meet it twice: the
// button with a badge is visited exactly as often as the button without one.
#[test]
fn a_badge_adds_nothing_a_reader_visits() {
    test.assert_eq(len(badge_reachable(3)), len(badge_reachable(0)))
    test.assert_eq(len(badge_reachable(3)), 1)
}

fn badge_reachable(n: int) -> [a11y.Node] {
    return a11y.reachable(a11y.tree_of(
        widget.layout(
            controls.button_widget(badged(n), frame()),
            geom.rect_of(0.0, 0.0, 200.0, 30.0),
            metrics()
        ),
        "x",
        ""
    ))
}

// **Zero is not a badge at all.** A count of nothing is nothing to say, and a badge showing "0" is
// a dot that means "no news" in a place a user has learnt means "news".
#[test]
fn a_count_of_nothing_is_not_shown() {
    test.assert(Option.is_None(controls.count_badge_of(0)))
    test.assert(Option.is_None(controls.count_badge_of(0 - 4)))
    test.assert(Option.is_Some(controls.count_badge_of(1)))
}

// **The cap lives here and not in twelve callers**: "99+" is a convention, and twelve applications
// each choosing where to cut off would give one window three different answers.
#[test]
fn a_large_count_is_capped_in_one_place() {
    test.assert_eq(badge_words(controls.count_badge_of(99)), "99")
    test.assert_eq(badge_words(controls.count_badge_of(100)), "99+")
    test.assert_eq(badge_words(controls.count_badge_of(4821)), "99+")
}

fn badge_words(b: Option<controls.Badge>) -> string {
    return switch b {
        Some(it) { it.text }
        None { "" }
    }
}

// **A search field is exactly as tall as an ordinary field.** It stands next to ordinary fields in
// every form the port has, so any difference reads as a mistake -- and the first version was a
// padding taller, two ways at once: it sized its marks by adding the field's *horizontal* padding
// to a *vertical* measurement, and it wrapped `entry_inside`, which brought a second surface and a
// second padding with it. Both passed every test there was, because no test asked how tall it was.
#[test]
fn a_search_field_is_the_height_of_an_ordinary_field() {
    val plain = widget.measure(controls.entry_widget(controls.entry_of("e", "Name", ""), frame()), metrics())
    val empty = widget.measure(controls.search_widget(finder(), frame()), metrics())
    val full = widget.measure(controls.search_widget(search_typed(finder(), "asp"), frame()), metrics())
    test.assert_eq(empty.height, plain.height)
    // And the mark appearing must not change it either.
    test.assert_eq(full.height, plain.height)
}

// The clear mark is where it is drawn, which is the invariant the calendar cost 22 points by not
// having: hit-testing and drawing must ask the same function.
#[test]
fn the_clear_mark_is_hit_where_it_is_drawn() {
    val typed = search_typed(finder(), "asp")
    val laid = search_laid(typed)
    val drawn = box_named(laid, controls.search_clear_name(typed))
    val step = search_step(typed, controls.Input.Press(geom.point_of(
        drawn.x + drawn.width * 0.5,
        drawn.y + drawn.height * 0.5
    )))
    test.assert_eq(controls.search_text(step.search), "")
    // A press just outside it lands in the text, not on the mark.
    test.assert_eq(
        controls.search_text(search_step(typed, controls.Input.Press(geom.point_of(
            drawn.x - 2.0,
            drawn.y + drawn.height * 0.5
        ))).search),
        "asp"
    )
}

// --- a list of values

fn dated() -> controls.List {
    return controls.list_of(
        "when",
        "Taken",
        [
            controls.Value.Date(day_of(2026, 3, 9)),
            controls.Value.Date(day_of(2026, 11, 20))
        ],
        locale.of("de-DE")
    )
}

// **A list holds values, not their spelling**, which is `JList`'s `ListModel` and this library's
// `Value` meeting where the `Table` already does. A list of amounts held as strings has already
// chosen a format, in whatever locale the code that built it happened to assume.
#[test]
fn a_list_spells_its_values_in_its_own_locale() {
    val amounts = [controls.Value.Exact(2.5d), controls.Value.Exact(1250.75d)]
    val german = controls.list_of("dose", "Dose", amounts, locale.of("de-DE"))
    test.assert_eq(controls.list_text_at(german, 0), "2,5")
    test.assert_eq(controls.list_text_at(german, 1), "1.250,75")
    test.assert_eq(controls.list_text_at(with german { locale: locale.of("en-GB") }, 1), "1,250.75")
    // Out of range is "", which an untouched selection and an empty list both make real.
    test.assert_eq(controls.list_text_at(german, 7), "")
    test.assert_eq(controls.list_text_at(german, 0 - 1), "")
}

// **Dates are ISO everywhere in this library, and `date_text` says why**: there is a source for
// each locale's month and weekday *names* and none for its date *pattern*, and guessing one in a
// format whose whole job is to be read correctly is worse than being unambiguous. What matters
// here is that a list agrees with the date field standing next to it, which this pins.
#[test]
fn a_date_in_a_list_is_spelled_as_the_date_field_spells_it() {
    val when = controls.list_of("when", "Taken", [controls.Value.Date(day_of(2026, 3, 9))], locale.of("de-DE"))
    test.assert_eq(controls.list_text_at(when, 0), "2026-03-09")
    test.assert_eq(
        controls.list_text_at(with when { locale: locale.of("en-GB") }, 0),
        controls.date_text(controls.date_field_of("d", "D", day_of(2026, 3, 9), locale.of("en-GB")))
    )
}

// And what it draws is what it says, rather than two spellings of one row.
#[test]
fn a_list_draws_and_announces_the_same_words() {
    val german = controls.list_of("dose", "Dose", [controls.Value.Exact(1250.75d)], locale.of("de-DE"))
    val laid = widget.layout(
        controls.list_widget(german, frame()),
        geom.rect_of(0.0, 0.0, 200.0, 90.0),
        metrics()
    )
    val said = switch a11y.node_of(a11y.tree_of(laid, "x", ""), "dose/0") {
        Some(n) { n.name }
        None { "(absent)" }
    }
    test.assert(contains(said, "1.250,75"))
}

// **The text door still works**, which is the whole reason it is an overload: every caller written
// before this still compiles, and a list of words says nothing about types.
#[test]
fn a_list_of_words_still_takes_words() {
    val plain = controls.list_of("l", "Names", ["Ada", "Grace"])
    test.assert_eq(controls.list_text_at(plain, 1), "Grace")
}

// **A combo box has a value and a spelling, and they stopped being the same thing.** An
// application that read the text back and parsed it would be undoing the formatting it just asked
// for, in the locale it asked for it in.
#[test]
fn a_combo_box_gives_back_the_value_not_its_spelling() {
    val c = controls.combo_box_of(
        "dose",
        "Dose",
        [controls.Value.Exact(2.5d), controls.Value.Exact(5.0d)],
        0,
        locale.of("de-DE")
    )
    test.assert_eq(controls.combo_box_value(c), "2,5")
    if Exact(d) = controls.combo_box_chosen(c) {
        test.assert_eq(d, 2.5d)
    } else {
        test.assert(false)
    }
    // Nothing chosen is `Blank`, which is not the empty string: see `Value`.
    val none = with c { items: with c.items { selected: 0 - 1 } }
    test.assert(controls.Value.is_Blank(controls.combo_box_chosen(none)))
    test.assert_eq(controls.combo_box_value(none), "")
}

fn day_of(y: int, m: int, d: int) -> time.LocalDate {
    return switch time.localdate_of(y, m, d) {
        Ok(one) { one }
        Err(_) { time.localdate_from_epoch_day(0) }
    }
}

// **Type-ahead matches what the user can see**, not an underlying spelling they cannot. A picker
// of German amounts whose type-ahead matched `2.5` would be answering a question nobody asked:
// the row on screen says `2,5`.
#[test]
fn combo_type_ahead_matches_the_spelling_on_screen() {
    val c = controls.combo_box_of(
        "dose",
        "Dose",
        [controls.Value.Exact(1250.5d), controls.Value.Exact(2.5d)],
        0,
        locale.of("de-DE")
    )
    val step = controls.combo_box_input(
        with c { items: with c.items { selected: 0 } },
        controls.Input.Text("2"),
        geom.rect_of(0.0, 0.0, 120.0, 26.0),
        geom.rect_of(0.0, 26.0, 120.0, 52.0),
        frame()
    )
    // "2,5" begins with 2; "1.250,5" does not.
    test.assert_eq(step.chosen, 1)
}

// **The text door still works**, which is why it is an overload and not a replacement: every
// picker written before `Value` existed still compiles and still says the same thing.
#[test]
fn a_combo_box_of_words_still_takes_words() {
    val c = controls.combo_box_of("env", "Environment", ["local", "staging"], 1)
    test.assert_eq(controls.combo_box_value(c), "staging")
    test.assert_eq(controls.combo_box_text(c), "staging")
    if Text(it) = controls.combo_box_chosen(c) {
        test.assert_eq(it, "staging")
    } else {
        test.assert(false)
    }
}
