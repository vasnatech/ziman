// `lib/ui/controls`: what an input does to a control.
//
// **These are the cases a rendered frame cannot show.** A button that fires when the user drags off
// it, a check box that clears a mixed state, a wheel event that goes to the focused list instead of
// the one under the pointer -- all three draw identically to the correct thing, every frame, and
// are only visible in what the state becomes.
use a11y
use controls
use focus
use geom
use paint
use scene
use shape
use test
use widget

fn metrics() -> widget.Metrics {
    return widget.metrics_of(
        fn(text: string, size: float) -> float { return (len(text) as float) * 10.0 },
        fn(size: float) -> float { return size * 2.0 }
    )
}

// A button's bounds, for the rules that need to know where it is.
val box = geom.rect_of(0.0, 0.0, 40.0, 20.0)

fn inside() -> geom.Point {
    return geom.point_of(10.0, 10.0)
}

fn outside() -> geom.Point {
    return geom.point_of(100.0, 10.0)
}

// Keys are named now rather than numbered -- `controls.Key.Left` where this used to say 65361 --
// which is the point of the control set owning its own vocabulary: a test reads as the gesture it
// describes, and a mistyped name is a compile error instead of a key that silently never arrives.
fn key(k: controls.Key) -> controls.Keystroke {
    return controls.keystroke_of(k)
}

val space = controls.Key.Space
val enter = controls.Key.Enter
val letter_a = controls.Key.Char("a")

fn press(b: controls.Button, p: geom.Point) -> controls.ButtonStep {
    return controls.button_input(b, controls.Input.Press(p), box)
}

fn release(b: controls.Button, p: geom.Point) -> controls.ButtonStep {
    return controls.button_input(b, controls.Input.Release(p), box)
}

// --- the button

#[test]
fn a_press_holds_it_and_a_release_inside_fires_it() {
    val held = press(controls.button_of("save", "Save"), inside())
    test.assert(held.button.held)
    test.assert_false(held.activated)

    val fired = release(held.button, inside())
    test.assert(fired.activated)
    test.assert_false(fired.button.held)
}

// **A press inside and a release outside does not fire**, which is every toolkit's behaviour and
// the reason `held` is state rather than the button simply reporting each click: a user who presses
// a button, thinks again and drags off it has cancelled, and a button that fired anyway would be
// the kind of defect a person does not report because they assume they misclicked.
#[test]
fn dragging_off_a_button_cancels_it() {
    val held = press(controls.button_of("save", "Save"), inside())
    val gone = release(held.button, outside())
    test.assert_false(gone.activated)
    test.assert_false(gone.button.held)
}

// And a release with no press before it fires nothing: a button under the pointer when the mouse
// comes up over it, having been pressed somewhere else, must not activate.
#[test]
fn a_release_without_a_press_fires_nothing() {
    val step = release(controls.button_of("save", "Save"), inside())
    test.assert_false(step.activated)
}

// A press that lands outside does not hold it either, which matters because `target` routes by hit
// test and a caller may still hand an input to the wrong control.
#[test]
fn a_press_outside_does_not_hold_it() {
    test.assert_false(press(controls.button_of("save", "Save"), outside()).button.held)
}

// **Space mirrors the pointer and Enter does not.** Space arms on the way down and fires on the way
// up, so it can be cancelled the way a drag can; Enter fires at once, because it is the key a
// default button answers and the user has already decided. Both are the platforms' own behaviour.
#[test]
fn space_fires_on_the_way_up_and_enter_on_the_way_down() {
    val b = controls.button_of("save", "Save")
    val armed = controls.button_input(b, controls.Input.KeyDown(key(space)), box)
    test.assert(armed.button.held)
    test.assert_false(armed.activated)
    test.assert(controls.button_input(armed.button, controls.Input.KeyUp(key(space)), box).activated)

    test.assert(controls.button_input(b, controls.Input.KeyDown(key(enter)), box).activated)
}

#[test]
fn an_ordinary_letter_does_nothing_to_a_button() {
    val b = controls.button_of("save", "Save")
    val step = controls.button_input(b, controls.Input.KeyDown(key(letter_a)), box)
    test.assert_false(step.activated)
    test.assert_false(step.button.held)
}

// A key up with nothing armed fires nothing -- the keyboard's version of a release without a press.
#[test]
fn a_space_release_with_nothing_armed_fires_nothing() {
    val b = controls.button_of("save", "Save")
    test.assert_false(controls.button_input(b, controls.Input.KeyUp(key(space)), box).activated)
}

// **A disabled button takes no input at all, and a disabled button is released.** The second half
// is the one worth a test: a button held down and then disabled must not still be held when it is
// enabled again, or it is drawn pressed by a frame nobody pressed.
#[test]
fn a_disabled_button_neither_fires_nor_stays_held() {
    val held = press(controls.button_of("save", "Save"), inside())
    val off = with held.button { disabled: true }
    val step = release(off, inside())
    test.assert_false(step.activated)
    test.assert_false(step.button.held)
    test.assert_false(press(off, inside()).button.held)
}

// --- the check box

fn click(c: controls.CheckBox) -> controls.CheckStep {
    val held = controls.check_box_input(c, controls.Input.Press(inside()), box)
    return controls.check_box_input(held.check_box, controls.Input.Release(inside()), box)
}

#[test]
fn a_click_toggles_an_unchecked_box_on_and_a_checked_box_off() {
    val off = controls.check_box_of("notify", "Notify me", widget.Toggle.Off)
    val on = click(off)
    test.assert(on.toggled)
    test.assert_eq(
        said_of(controls.check_box_widget(on.check_box, controls.default_style(), metrics()), "notify"),
        "check box, Notify me, checked"
    )

    val back = click(on.check_box)
    test.assert(back.toggled)
    test.assert_eq(
        said_of(controls.check_box_widget(back.check_box, controls.default_style(), metrics()), "notify"),
        "check box, Notify me, unchecked"
    )
}

// **A mixed box becomes checked, never unchecked.** "Toggle" suggests otherwise, and every platform
// does this: a mixed box means some of the things under it are on, and a user clicking it is asking
// for all of them. Going to unchecked would throw away choices that were already made.
#[test]
fn a_mixed_box_becomes_checked() {
    val mixed = controls.check_box_of("all", "Select all", widget.Toggle.Mixed)
    val after = click(mixed)
    test.assert(after.toggled)
    test.assert_eq(
        said_of(controls.check_box_widget(after.check_box, controls.default_style(), metrics()), "all"),
        "check box, Select all, checked"
    )
}

// The button's cancel rule applies to it, because it is the button's rule and not a copy of it.
#[test]
fn dragging_off_a_check_box_leaves_it_alone() {
    val mixed = controls.check_box_of("all", "Select all", widget.Toggle.Mixed)
    val held = controls.check_box_input(mixed, controls.Input.Press(inside()), box)
    val gone = controls.check_box_input(held.check_box, controls.Input.Release(outside()), box)
    test.assert_false(gone.toggled)
    test.assert_false(gone.check_box.held)
}

#[test]
fn a_disabled_check_box_does_not_toggle() {
    val off = with controls.check_box_of("notify", "Notify me", widget.Toggle.Off) { disabled: true }
    test.assert_false(click(off).toggled)
}

// --- routing

fn laid_pair() -> widget.Laid {
    val style = controls.default_style()
    val row = widget.row_of(
        0.0,
        [
            widget.fixed_of(60.0, 20.0, controls.button_widget(controls.button_of("a", "A"), style)),
            widget.fixed_of(60.0, 20.0, controls.button_widget(controls.button_of("b", "B"), style))
        ]
    )
    return widget.layout(row, geom.rect_of(0.0, 0.0, 120.0, 20.0), metrics())
}

#[test]
fn a_key_goes_to_the_focus() {
    test.assert_eq(controls.target(laid_pair(), controls.Input.KeyDown(key(space)), "b"), "b")
    test.assert_eq(controls.target(laid_pair(), controls.Input.Text("x"), "b"), "b")
}

#[test]
fn a_press_goes_to_what_is_under_the_pointer() {
    test.assert_eq(controls.target(laid_pair(), controls.Input.Press(geom.point_of(70.0, 10.0)), "a"), "b")
}

// **A release goes to the focus, not to what is under the pointer**, which looks wrong and is what
// makes a cancelled drag work at all: the press moved the focus to the button, so the release
// reaches that button even though the pointer has left it -- and the button is the only thing that
// can decide the drag was a cancel. Routed by position instead, the release would go nowhere and
// the button would stay drawn pressed for ever.
#[test]
fn a_release_follows_the_focus_so_a_cancelled_drag_still_arrives() {
    val l = laid_pair()
    val focused = controls.target(l, controls.Input.Press(geom.point_of(70.0, 10.0)), "a")
    test.assert_eq(focused, "b")
    test.assert_eq(controls.target(l, controls.Input.Release(geom.point_of(300.0, 300.0)), focused), "b")
}

// **A wheel goes to the control under the pointer and ignores the focus**, because that is what a
// user means: scrolling the list they are pointing at, not the one that has the keyboard.
#[test]
fn a_wheel_goes_under_the_pointer_and_not_to_the_focus() {
    val l = laid_pair()
    val over_b = controls.Input.Wheel(controls.Wheel { at: geom.point_of(70.0, 10.0), vertical: 1, horizontal: 0 })
    test.assert_eq(controls.target(l, over_b, "a"), "b")
}

// Over nothing a wheel goes nowhere rather than to the focus, which is the same choice and the case
// that proves the focus is not a fallback.
#[test]
fn a_wheel_over_nothing_goes_nowhere() {
    val away = controls.Input.Wheel(controls.Wheel { at: geom.point_of(500.0, 500.0), vertical: 1, horizontal: 0 })
    test.assert_eq(controls.target(laid_pair(), away, "a"), "")
}

#[test]
fn a_press_on_nothing_leaves_the_focus_where_it_was() {
    test.assert_eq(controls.target(laid_pair(), controls.Input.Press(geom.point_of(500.0, 500.0)), "a"), "a")
}

// --- what a reader is told, which is the reason F275 came first

// What a reader would say about the control named `name` in a tree built from `w`. A sentinel
// rather than a failure for a missing node, because `test.fail` answers nothing and so cannot be a
// switch arm's value -- and a sentinel reads better in the diff anyway.
fn said_of(w: widget.Widget, name: string) -> string {
    val l = widget.layout(w, geom.rect_of(0.0, 0.0, 200.0, 40.0), metrics())
    return switch a11y.node_of(a11y.tree_of(l, "Records", ""), name) {
        Some(one) { a11y.announce(one) }
        None { concat("(no node named ", name, ")") }
    }
}

// The accessible name alone, for the one case that is about the name rather than the whole line.
fn name_of(w: widget.Widget, name: string) -> string {
    val l = widget.layout(w, geom.rect_of(0.0, 0.0, 200.0, 40.0), metrics())
    return switch a11y.node_of(a11y.tree_of(l, "Records", ""), name) {
        Some(one) { one.name }
        None { concat("(no node named ", name, ")") }
    }
}

// **A button built here announces itself correctly with nothing else declared**, which is the whole
// return on F275 being ordered before F277: the role is a field of the widget, so a control cannot
// be built without one.
#[test]
fn a_button_announces_itself_as_a_button() {
    test.assert_eq(
        said_of(controls.button_widget(controls.button_of("save", "Save"), controls.default_style()), "save"),
        "button, Save"
    )
}

#[test]
fn a_disabled_button_announces_that_it_is_dimmed() {
    val off = with controls.button_of("save", "Save") { disabled: true }
    test.assert_eq(
        said_of(controls.button_widget(off, controls.default_style()), "save"),
        "button, Save, dimmed"
    )
}

// **A check box declares its label rather than taking it from the text inside**, because the text
// inside is the mark as well as the label: without the declaration a reader would say
// "check box, x Notify me".
#[test]
fn a_check_box_does_not_read_its_own_mark_aloud() {
    val on = controls.check_box_of("notify", "Notify me", widget.Toggle.On)
    val style = controls.default_style()
    // The name is the label exactly. Were the label not declared, `a11y` would take the name from
    // the text inside -- which is the mark and then the label -- and this would read "x Notify me".
    test.assert_eq(name_of(controls.check_box_widget(on, style, metrics()), "notify"), "Notify me")
    test.assert_eq(said_of(controls.check_box_widget(on, style, metrics()), "notify"), "check box, Notify me, checked")

    // The contrast, built by hand around the same children, which is what makes the line above an
    // assertion about the declaration rather than about the fixture: without it, the mark is read.
    val undeclared = widget.Widget.Control(widget.Focusable {
        name: "loud",
        role: widget.Role.CheckBox,
        label: "",
        description: "",
        value: "",
        state: widget.no_state(),
        tab_stop: true,
        child: widget.row_of(2.0, [words("x"), words("Notify me")])
    })
    test.assert_eq(name_of(undeclared, "loud"), "x Notify me")
}

fn words(text: string) -> widget.Widget {
    return widget.label_of(text, 12.0, paint.black())
}

// A held button is a different tree from an unheld one -- the pressed face -- but the *same*
// announcement, because being held is not something a reader says.
#[test]
fn being_held_changes_nothing_a_reader_is_told() {
    val held = press(controls.button_of("save", "Save"), inside()).button
    test.assert(held.held)
    test.assert_eq(
        said_of(controls.button_widget(held, controls.default_style()), "save"),
        "button, Save"
    )
}

// --- the input predicate

#[test]
fn only_a_key_or_text_could_change_a_field() {
    test.assert(controls.is_text_input(controls.Input.Text("a")))
    test.assert(controls.is_text_input(controls.Input.KeyDown(key(letter_a))))
    test.assert_false(controls.is_text_input(controls.Input.Press(inside())))
    test.assert_false(controls.is_text_input(controls.Input.KeyUp(key(letter_a))))
}

// --- the text entry

use controls.bar_thickness
use controls.caret_name
use controls.min_thumb
use controls.thumb_name
use edit

// Ten units per character, from `metrics()` above, so a caret after three characters sits at 30
// plus the field's left padding.
val char_width = 10.0

fn field() -> controls.Entry {
    return controls.entry_of("email", "Email", "ada@example.org")
}

fn style() -> controls.Style {
    return controls.default_style()
}

fn entry_box() -> geom.Rect {
    return geom.rect_of(0.0, 0.0, 300.0, 24.0)
}

fn give(e: controls.Entry, input: controls.Input) -> controls.EntryStep {
    return controls.entry_input(e, input, entry_box(), style(), metrics())
}

fn typing(e: controls.Entry, what: string) -> controls.EntryStep {
    return give(e, controls.Input.Text(what))
}

fn pressing(e: controls.Entry, name: string, k: controls.Key, control: bool, shift: bool) -> controls.EntryStep {
    val stroke = controls.Keystroke { key: k, shift: shift, control: control, alt: false, meta: false }
    val _ = name
    return give(e, controls.Input.KeyDown(stroke))
}

val key_left = controls.Key.Left
val key_right = controls.Key.Right
val key_home = controls.Key.Home
val key_backspace = controls.Key.Backspace
val letter_c = controls.Key.Char("c")
val letter_x = controls.Key.Char("x")
val letter_z = controls.Key.Char("z")

#[test]
fn typing_inserts_at_the_caret_and_reports_a_change() {
    val step = typing(controls.entry_of("n", "Name", "ab"), "c")
    test.assert_eq(step.entry.editor.text, "abc")
    test.assert(step.changed)
}

// **A caret move is not a change**, which is what a form watches to know it is dirty: a user who
// pressed an arrow key has not edited anything.
#[test]
fn moving_the_caret_is_not_a_change() {
    val step = pressing(field(), "Left", key_left, false, false)
    test.assert_false(step.changed)
    test.assert_eq(step.entry.editor.caret, 14)
}

#[test]
fn shift_with_an_arrow_selects() {
    val step = pressing(field(), "Left", key_left, false, true)
    test.assert(edit.has_selection(step.entry.editor))
    test.assert_eq(edit.selected_text(step.entry.editor), "g")
}

#[test]
fn control_with_an_arrow_moves_by_word() {
    val at_start = controls.entry_of("n", "Name", "one two")
    val start = with at_start { editor: edit.editor_of("one two") }
    test.assert_eq(pressing(start, "Left", key_left, true, false).entry.editor.caret, 4)
}

#[test]
fn backspace_deletes_and_control_backspace_takes_the_word() {
    test.assert_eq(pressing(field(), "Backspace", key_backspace, false, false).entry.editor.text, "ada@example.or")
    test.assert_eq(pressing(field(), "Backspace", key_backspace, true, false).entry.editor.text, "ada@example.")
}

// --- undo, and the run that makes it useful

// **A run of typed characters is one undo step.** Without this, Ctrl-Z after typing a word steps
// back a letter at a time, which is not what undo means to anyone. The rule is the one editors use:
// consecutive `Text` inserts coalesce and anything else ends the run.
#[test]
fn a_run_of_typing_undoes_as_one_word() {
    var e = controls.entry_of("n", "Name", "")
    e = typing(e, "a").entry
    e = typing(e, "d").entry
    e = typing(e, "a").entry
    test.assert_eq(e.editor.text, "ada")

    val back = pressing(e, "z", letter_z, true, false)
    test.assert_eq(back.entry.editor.text, "")
    test.assert(back.changed)
}

// And a caret move between two typed characters splits the run, which is the other half of the rule
// -- a user who moved the caret and typed again has made two edits, and one undo must not take
// both.
#[test]
fn a_caret_move_splits_a_typing_run() {
    var e = controls.entry_of("n", "Name", "")
    e = typing(e, "a").entry
    e = typing(e, "b").entry
    e = pressing(e, "Home", key_home, false, false).entry
    e = typing(e, "x").entry
    test.assert_eq(e.editor.text, "xab")

    val back = pressing(e, "z", letter_z, true, false)
    test.assert_eq(back.entry.editor.text, "ab")
}

// A paste is one step whatever its length, which is why it is its own input and not a `Text`.
#[test]
fn a_paste_is_one_undo_step() {
    var e = controls.entry_of("n", "Name", "")
    e = give(e, controls.Input.Paste("a long pasted string")).entry
    test.assert_eq(e.editor.text, "a long pasted string")
    test.assert_eq(pressing(e, "z", letter_z, true, false).entry.editor.text, "")
}

#[test]
fn an_undo_with_nothing_recorded_reports_no_change() {
    test.assert_false(pressing(field(), "z", letter_z, true, false).changed)
}

// --- the clipboard, which this layer cannot reach

// **Copy answers the text and changes nothing**: the module has no clipboard and must not pretend
// to, so the text comes out as an output and the application puts it somewhere.
#[test]
fn copy_answers_the_selection_and_changes_nothing() {
    val all = with field() { editor: edit.select_all(field().editor) }
    val step = pressing(all, "c", letter_c, true, false)
    test.assert_eq(step.copied, "ada@example.org")
    test.assert_false(step.changed)
    test.assert_eq(step.entry.editor.text, "ada@example.org")
}

#[test]
fn cut_answers_the_selection_and_removes_it() {
    val all = with field() { editor: edit.select_all(field().editor) }
    val step = pressing(all, "x", letter_x, true, false)
    test.assert_eq(step.copied, "ada@example.org")
    test.assert(step.changed)
    test.assert_eq(step.entry.editor.text, "")
}

// **Cutting from a read-only field is a copy rather than nothing.** The user asked for the text;
// refusing to hand it over is not what read-only means.
#[test]
fn cutting_from_a_read_only_field_still_copies() {
    val locked = with field() { editor: edit.select_all(field().editor), readonly: true }
    val step = pressing(locked, "x", letter_x, true, false)
    test.assert_eq(step.copied, "ada@example.org")
    test.assert_false(step.changed)
    test.assert_eq(step.entry.editor.text, "ada@example.org")
}

#[test]
fn a_read_only_field_moves_its_caret_but_does_not_change() {
    val locked = with field() { readonly: true }
    test.assert_false(typing(locked, "x").changed)
    test.assert_eq(typing(locked, "x").entry.editor.text, "ada@example.org")
    test.assert_eq(pressing(locked, "Left", key_left, false, false).entry.editor.caret, 14)
}

#[test]
fn a_disabled_field_does_nothing_at_all() {
    val off = with field() { disabled: true }
    test.assert_false(typing(off, "x").changed)
    test.assert_eq(give(off, controls.Input.Press(geom.point_of(50.0, 10.0))).entry.editor.caret, 15)
}

// --- the caret and the pointer

// **The nearest boundary, not the character the pixel is inside.** Clicking the left half of a
// character puts the caret before it and the right half after it, which is what a user means by
// clicking between two letters. Taking the character the pixel landed in makes the caret feel one
// place behind the pointer.
#[test]
fn a_click_puts_the_caret_at_the_nearest_boundary() {
    val m = metrics()
    val text = "abcd"
    test.assert_eq(controls.caret_at_x(text, 12.0, m, 0.0), 0)
    // Just inside the first character: still before it.
    test.assert_eq(controls.caret_at_x(text, 12.0, m, char_width * 0.4), 0)
    // Past its middle: after it.
    test.assert_eq(controls.caret_at_x(text, 12.0, m, char_width * 0.6), 1)
    test.assert_eq(controls.caret_at_x(text, 12.0, m, char_width * 2.5), 3)
    // Beyond the end clamps rather than failing.
    test.assert_eq(controls.caret_at_x(text, 12.0, m, 10000.0), 4)
    test.assert_eq(controls.caret_at_x(text, 12.0, m, 0.0 - 50.0), 0)
}

#[test]
fn a_press_places_the_caret_and_a_drag_selects() {
    val e = field()
    val left = style().padding.left
    val placed = give(e, controls.Input.Press(geom.point_of(left + char_width * 3.0, 10.0)))
    test.assert_eq(placed.entry.editor.caret, 3)
    test.assert(placed.entry.dragging)

    val dragged = give(placed.entry, controls.Input.Move(geom.point_of(left + char_width * 6.0, 10.0)))
    test.assert_eq(edit.selected_text(dragged.entry.editor), "@ex")

    val done = give(dragged.entry, controls.Input.Release(geom.point_of(left + char_width * 6.0, 10.0)))
    test.assert_false(done.entry.dragging)
}

// A move with no press before it changes nothing: the pointer crossing a field must not select.
#[test]
fn moving_without_a_press_selects_nothing() {
    val step = give(field(), controls.Input.Move(geom.point_of(50.0, 10.0)))
    test.assert_false(edit.has_selection(step.entry.editor))
}

// --- the caret in the laid-out tree

// Finds the caret's box by the name it carries.
fn caret_x(e: controls.Entry) -> float {
    val w = controls.entry_widget(e, style(), metrics())
    val l = widget.layout(w, geom.rect_of(0.0, 0.0, 300.0, 24.0), metrics())
    return found_x(l)
}

fn found_x(l: widget.Laid) -> float {
    if l.name == caret_name {
        return l.bounds.x
    }
    for child in l.children {
        val x = found_x(child)
        if x >= 0.0 {
            return x
        }
    }
    return 0.0 - 1.0
}

// **The caret is placed by the layout, and this is the check that the two directions agree.** The
// widget puts a one-unit box between the text before the caret and the text after it, so the same
// metrics that measure the text place the caret; `caret_at_x` then has to answer the same index
// from that x. Computing a caret's position separately from the text is how a caret ends up half a
// character off in one font and right in another -- and a round trip is the only test that catches
// a disagreement rather than restating one side of it.
#[test]
fn the_drawn_caret_and_the_clicked_caret_agree() {
    val e = field()
    val width = metrics().text_width
    var at = 0
    while at <= len(e.editor.text) {
        val placed = with e { editor: edit.place_caret(e.editor, at, false) }
        val x = caret_x(placed)
        // **Exactly where the measured text ends, with no tolerance.** The round trip below is the
        // weaker half of this and on its own it is nearly useless: `caret_at_x` snaps to the
        // nearest boundary, so it answers the right index for anything within half a character --
        // which is precisely the drift this case exists to catch. Adding two units of spacing to
        // the widget's row left the round trip passing and fails this line, which is how that was
        // found.
        test.assert_eq(x, style().padding.left + width(substring(e.editor.text, 0, at), style().text_size))
        // And the inverse agrees, which is the direction a click travels.
        test.assert_eq(controls.caret_at_x(e.editor.text, style().text_size, metrics(), x - style().padding.left), at)
        at = at + 1
    }
}

#[test]
fn a_selection_is_drawn_instead_of_a_caret() {
    val selected = with field() { editor: edit.select_all(field().editor) }
    val w = controls.entry_widget(selected, style(), metrics())
    val l = widget.layout(w, geom.rect_of(0.0, 0.0, 300.0, 24.0), metrics())
    // No caret box at all when there is a selection: the selected run carries a background instead.
    test.assert_eq(found_x(l), 0.0 - 1.0)
}

// --- what a reader is told about a field

// **A field's label is declared and its text is its value**, so a reader says the name and then the
// contents. A field that took its name from the text inside would introduce itself as whatever the
// user last typed.
#[test]
fn a_field_announces_its_label_then_its_value() {
    val l = widget.layout(
        controls.entry_widget(field(), style(), metrics()),
        geom.rect_of(0.0, 0.0, 300.0, 24.0),
        metrics()
    )
    val said = switch a11y.node_of(a11y.tree_of(l, "Contacts", ""), "email") {
        Some(one) { a11y.announce(one) }
        None { "(no node)" }
    }
    test.assert_eq(said, "text field, Email, ada@example.org")
}

#[test]
fn a_read_only_field_says_so() {
    val locked = with field() { readonly: true }
    val l = widget.layout(
        controls.entry_widget(locked, style(), metrics()),
        geom.rect_of(0.0, 0.0, 300.0, 24.0),
        metrics()
    )
    val said = switch a11y.node_of(a11y.tree_of(l, "Contacts", ""), "email") {
        Some(one) { a11y.announce(one) }
        None { "(no node)" }
    }
    test.assert_eq(said, "text field, Email, ada@example.org, read only")
}

// --- the list

// Five rows of 20 in a box 60 tall: three rows visible, two below.
fn five() -> controls.List {
    return controls.list_of("people", "People", ["Ada", "Grace", "Alan", "Edsger", "Barbara"])
}

fn list_box() -> geom.Rect {
    return geom.rect_of(0.0, 0.0, 120.0, 60.0)
}

fn to_list(l: controls.List, input: controls.Input) -> controls.ListStep {
    return controls.list_input(l, input, list_box())
}

fn arrow(l: controls.List, k: controls.Key) -> controls.ListStep {
    return to_list(l, controls.Input.KeyDown(key(k)))
}

val key_down = controls.Key.Down
val key_up = controls.Key.Up
val key_page_down = controls.Key.PageDown
val key_end = controls.Key.End

#[test]
fn a_new_list_selects_its_first_row_and_an_empty_one_selects_nothing() {
    test.assert_eq(five().selected, 0)
    test.assert_eq(controls.list_of("empty", "Nothing", []).selected, 0 - 1)
}

#[test]
fn the_arrows_move_the_selection_and_stop_at_both_ends() {
    val down = arrow(five(), key_down)
    test.assert_eq(down.list.selected, 1)
    test.assert(down.moved)
    // Up from the first row stays, and reports that nothing moved.
    val stuck = arrow(five(), key_up)
    test.assert_eq(stuck.list.selected, 0)
    test.assert_false(stuck.moved)
    test.assert_eq(arrow(with five() { selected: 4 }, key_down).list.selected, 4)
}

// **The view follows the selection by the least that works.** Three rows of 20 fit in 60, so the
// first three arrows move the selection with the list still at the top, and only the fourth scrolls
// -- by one row, not by a page.
#[test]
fn arrowing_down_creeps_the_view_rather_than_jumping() {
    var l = five()
    l = arrow(l, key_down).list
    l = arrow(l, key_down).list
    test.assert_eq(l.selected, 2)
    test.assert_eq(l.offset, 0.0)
    l = arrow(l, key_down).list
    test.assert_eq(l.selected, 3)
    test.assert_eq(l.offset, 20.0)
    l = arrow(l, key_down).list
    test.assert_eq(l.selected, 4)
    test.assert_eq(l.offset, 40.0)
}

#[test]
fn end_and_page_down_also_bring_the_selection_into_view() {
    val ended = arrow(five(), key_end)
    test.assert_eq(ended.list.selected, 4)
    test.assert_eq(ended.list.offset, 40.0)
    // A page is three rows here, so one PageDown lands on row 3 and scrolls by one.
    val paged = arrow(five(), key_page_down)
    test.assert_eq(paged.list.selected, 3)
    test.assert_eq(paged.list.offset, 20.0)
}

// **The wheel scrolls and does not move the selection.** Routing a wheel to whatever has the
// keyboard is the easy mistake: a user scrolling to look further down has not asked to select
// anything, and moving the selection under them loses the row they were about to act on.
#[test]
fn the_wheel_scrolls_without_moving_the_selection() {
    val step = to_list(five(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(10.0, 10.0),
        vertical: 0 - 1,
        horizontal: 0
    }))
    test.assert_eq(step.list.offset, 20.0)
    test.assert_eq(step.list.selected, 0)
    test.assert_false(step.moved)
}

// And it stops at both ends: 5 rows of 20 is 100, in a view of 60, so 40 is as far as it goes.
#[test]
fn the_wheel_stops_at_both_ends() {
    var l = five()
    var i = 0
    while i < 20 {
        l = to_list(l, controls.Input.Wheel(controls.Wheel {
            at: geom.point_of(10.0, 10.0),
            vertical: 0 - 1,
            horizontal: 0
        })).list
        i = i + 1
    }
    test.assert_eq(l.offset, 40.0)
    var j = 0
    while j < 20 {
        l = to_list(l, controls.Input.Wheel(controls.Wheel {
            at: geom.point_of(10.0, 10.0),
            vertical: 1,
            horizontal: 0
        })).list
        j = j + 1
    }
    test.assert_eq(l.offset, 0.0)
}

// A click selects the row under the pointer, **through the scroll offset**: with the list scrolled
// by two rows, the top of the box is row 2.
#[test]
fn a_click_selects_the_row_under_the_pointer_through_the_offset() {
    test.assert_eq(to_list(five(), controls.Input.Press(geom.point_of(10.0, 30.0))).list.selected, 1)
    val scrolled = with five() { offset: 40.0 }
    test.assert_eq(to_list(scrolled, controls.Input.Press(geom.point_of(10.0, 10.0))).list.selected, 2)
}

#[test]
fn a_click_past_the_last_row_changes_nothing() {
    val step = to_list(with five() { items: ["Ada"] }, controls.Input.Press(geom.point_of(10.0, 50.0)))
    test.assert_eq(step.list.selected, 0)
    test.assert_false(step.moved)
}

// **Selecting a row and opening it are different intentions.** A list that reported them as one
// would open a record on every arrow key.
#[test]
fn enter_activates_and_an_arrow_does_not() {
    test.assert(arrow(five(), enter).activated)
    test.assert_false(arrow(five(), key_down).activated)
    test.assert_false(arrow(five(), enter).moved)
}

#[test]
fn a_disabled_list_ignores_everything() {
    val off = with five() { disabled: true }
    test.assert_eq(arrow(off, key_down).list.selected, 0)
    test.assert_false(to_list(off, controls.Input.Press(geom.point_of(10.0, 30.0))).moved)
}

// --- one tab stop, five nodes

fn laid_list(l: controls.List) -> widget.Laid {
    return widget.layout(controls.list_widget(l, controls.default_style()), list_box(), metrics())
}

// **The whole reason `tab_stop` exists.** Tab sees one control; a reader sees the list and every
// row. Before the distinction, a list was either five stops in the tab order or a single node whose
// name was all five rows run together.
#[test]
fn a_list_is_one_tab_stop_and_five_accessibility_nodes() {
    val l = laid_list(five())
    test.assert_len(1, focus.controls(l))
    test.assert_eq(focus.controls(l)[0].name, "people")

    val t = a11y.tree_of(l, "Records", "people")
    // The window, the list, and one node per row.
    test.assert_len(7, t.nodes)
    test.assert_len(1, a11y.reachable(t))
}

#[test]
fn the_selected_row_says_so_and_the_others_do_not() {
    val t = a11y.tree_of(laid_list(with five() { selected: 1 }), "Records", "people")
    test.assert_eq(said_in(t, "people/1"), "list item, Grace, selected")
    test.assert_eq(said_in(t, "people/0"), "list item, Ada")
}

fn said_in(t: a11y.Tree, key: string) -> string {
    return switch a11y.node_of(t, key) {
        Some(one) { a11y.announce(one) }
        None { concat("(no node ", key, ")") }
    }
}

// **A click on a row leaves the focus on the list**, because the row is not a tab stop and focusing
// it would put the focus somewhere Tab could never return to. `focus.control_at` still answers the
// row, which is what tells the list which row was clicked.
#[test]
fn clicking_a_row_focuses_the_list_and_reports_the_row() {
    val l = laid_list(five())
    val at = geom.point_of(10.0, 30.0)
    test.assert_eq(focus.clicked(l, at, ""), "people")
    test.assert_eq(switch focus.control_at(l, at) {
        Some(one) { one.name }
        None { "(none)" }
    }, "people/1")
}

// A row scrolled out of the list's own viewport cannot be clicked, which is the viewport's rule
// arriving here for free.
#[test]
fn a_row_scrolled_out_of_the_list_cannot_be_clicked() {
    val l = laid_list(with five() { offset: 40.0 })
    // Rows 2, 3 and 4 are visible; row 0 is two rows above the top.
    test.assert_eq(switch focus.control_at(l, geom.point_of(10.0, 10.0)) {
        Some(one) { one.name }
        None { "(none)" }
    }, "people/2")
    test.assert(Option.is_None(a11y.node_of(a11y.tree_of(l, "R", ""), "people/9")))
}

// --- menus

fn file_menu() -> controls.Menu {
    return controls.menu_of("file", "File", ["New", "Open", "Save"])
}

val title_box = geom.rect_of(0.0, 0.0, 40.0, 20.0)

fn popup_box() -> geom.Rect {
    return geom.rect_of(0.0, 20.0, 80.0, 60.0)
}

fn to_menu(m: controls.Menu, input: controls.Input) -> controls.MenuStep {
    return controls.menu_input(m, input, title_box, popup_box())
}

fn menu_key(m: controls.Menu, k: controls.Key) -> controls.MenuStep {
    return to_menu(m, controls.Input.KeyDown(key(k)))
}

val key_escape = controls.Key.Escape

// **A menu bar opens on the way down**, which is what lets a user press and drag onto an item in
// one gesture rather than having to click twice.
#[test]
fn a_press_on_the_title_opens_it_and_lands_on_the_first_item() {
    val step = to_menu(file_menu(), controls.Input.Press(geom.point_of(10.0, 10.0)))
    test.assert(step.menu.open)
    test.assert_eq(step.menu.items.selected, 0)
    test.assert_eq(step.chosen, 0 - 1)
}

#[test]
fn down_opens_it_from_the_keyboard_and_a_press_elsewhere_does_not() {
    test.assert(menu_key(file_menu(), key_down).menu.open)
    test.assert_false(to_menu(file_menu(), controls.Input.Press(geom.point_of(200.0, 200.0))).menu.open)
}

// The arrows inside an open menu are the list's, which is the whole reason a menu holds one.
#[test]
fn the_arrows_move_within_an_open_menu() {
    val open = menu_key(file_menu(), key_down).menu
    val moved = menu_key(open, key_down)
    test.assert_eq(moved.menu.items.selected, 1)
    test.assert(moved.menu.open)
}

#[test]
fn enter_chooses_the_highlighted_item_and_closes() {
    var m = menu_key(file_menu(), key_down).menu
    m = menu_key(m, key_down).menu
    val step = menu_key(m, enter)
    test.assert_eq(step.chosen, 1)
    test.assert_false(step.menu.open)
    test.assert_false(step.dismissed)
}

// **Escape closes without choosing, and a dismissal is not a choice of nothing.** A caller that
// treated them alike would act on the user backing out.
#[test]
fn escape_dismisses_without_choosing() {
    val open = menu_key(file_menu(), key_down).menu
    val step = menu_key(open, key_escape)
    test.assert_false(step.menu.open)
    test.assert(step.dismissed)
    test.assert_eq(step.chosen, 0 - 1)
}

// **A click away from both boxes dismisses it**, which is what a placed layer letting clicks
// through is for: the click reaches whatever was beneath as well, and closing is this module's half.
#[test]
fn a_click_away_from_an_open_menu_dismisses_it() {
    val open = menu_key(file_menu(), key_down).menu
    val step = to_menu(open, controls.Input.Press(geom.point_of(300.0, 300.0)))
    test.assert_false(step.menu.open)
    test.assert(step.dismissed)
}

// And a second press on the title closes it, as every menu bar does.
#[test]
fn a_second_press_on_the_title_closes_it() {
    val open = menu_key(file_menu(), key_down).menu
    val step = to_menu(open, controls.Input.Press(geom.point_of(10.0, 10.0)))
    test.assert_false(step.menu.open)
    test.assert(step.dismissed)
}

#[test]
fn a_click_on_a_row_of_an_open_menu_highlights_it() {
    val open = menu_key(file_menu(), key_down).menu
    val step = to_menu(open, controls.Input.Press(geom.point_of(10.0, 50.0)))
    test.assert(step.menu.open)
    test.assert_eq(step.menu.items.selected, 1)
}

#[test]
fn a_disabled_menu_does_not_open() {
    val off = with file_menu() { disabled: true }
    test.assert_false(to_menu(off, controls.Input.Press(geom.point_of(10.0, 10.0))).menu.open)
    test.assert_false(menu_key(off, key_down).menu.open)
}

// **A menu announces that it is a menu and whether it is open**, which is the state a reader needs
// to tell a user whether pressing Down will do anything.
#[test]
fn a_menu_title_says_whether_it_is_expanded() {
    val style = controls.default_style()
    test.assert_eq(said_of(controls.menu_title_widget(file_menu(), style), "file"), "menu, File, collapsed")
    val open = menu_key(file_menu(), key_down).menu
    test.assert_eq(said_of(controls.menu_title_widget(open, style), "file"), "menu, File, expanded")
}

// The popup's rows are menu items and not list items, which is the only thing a menu changed about
// the list it reuses.
#[test]
fn the_popup_rows_are_menu_items() {
    val open = menu_key(file_menu(), key_down).menu
    val l = widget.layout(
        widget.layered_of([widget.base_layer(widget.Widget.Nothing),
            controls.menu_popup_layer(open, controls.default_style(), popup_box())]),
        geom.rect_of(0.0, 0.0, 120.0, 100.0),
        metrics()
    )
    val t = a11y.tree_of(l, "Records", "")
    test.assert_eq(said_in(t, "file/items"), "menu, File")
    test.assert_eq(said_in(t, "file/items/0"), "menu item, New, selected")
    test.assert_eq(said_in(t, "file/items/1"), "menu item, Open")
}

// --- dialogs

fn answer(input: controls.Input) -> string {
    return switch controls.dialog_keys(input) {
        Confirm { "confirm" }
        Cancel { "cancel" }
        Nothing { "nothing" }
    }
}

// **Escape cancels and Enter confirms** -- the two keys a dialog owes a user who never reaches for
// the mouse.
#[test]
fn a_dialog_answers_escape_and_enter() {
    test.assert_eq(answer(controls.Input.KeyDown(key(key_escape))), "cancel")
    test.assert_eq(answer(controls.Input.KeyDown(key(enter))), "confirm")
    test.assert_eq(answer(controls.Input.KeyDown(key(letter_a))), "nothing")
    test.assert_eq(answer(controls.Input.Press(inside())), "nothing")
    // On the way down only: a key *up* must not confirm a dialog the keystroke opened.
    test.assert_eq(answer(controls.Input.KeyUp(key(enter))), "nothing")
}

// **A dialog shuts the window out of the keyboard and the pointer both.** The geometry does the
// pointer and `takes_keys` does Tab, and this is the case that holds the pair together.
#[test]
fn a_dialog_traps_the_window_behind_it() {
    val style = controls.default_style()
    val behind = controls.button_widget(controls.button_of("save", "Save"), style)
    val inside_it = controls.button_widget(controls.button_of("ok", "OK"), style)
    val l = widget.layout(
        widget.layered_of([
            widget.base_layer(behind),
            controls.dialog_layer("confirm", "Discard changes?", inside_it, style)
        ]),
        geom.rect_of(0.0, 0.0, 200.0, 120.0),
        metrics()
    )
    // Tab holds only what is inside.
    test.assert_len(1, focus.controls(l))
    test.assert_eq(focus.controls(l)[0].name, "ok")
    // And a reader is told the same.
    val t = a11y.tree_of(l, "Records", "ok")
    test.assert(Option.is_None(a11y.node_of(t, "save")))
    test.assert_eq(said_in(t, "confirm"), "dialog, Discard changes?")
}

// ---- a text area
//
// **The whole of multi-line is three keys and a column of lines**, so the cases that matter are the
// ones where a field and an area must differ, and the one where they must not.

fn area(text: string) -> controls.Entry {
    return controls.text_area_of("body", "Body", text, 6)
}

fn press(key: controls.Key) -> controls.Input {
    return controls.Input.KeyDown(controls.keystroke_of(key))
}

val anywhere = geom.rect_of(0.0, 0.0, 200.0, 100.0)

#[test]
fn enter_types_a_newline_in_an_area() {
    val step = controls.entry_input(
        area("ab"),
        press(controls.Key.Enter),
        anywhere,
        controls.default_style(),
        metrics()
    )
    test.assert_eq("ab\n", step.entry.editor.text)
    test.assert(step.changed)
}

// **A one-line field must leave Enter alone**, because it is the key a default button answers. A
// field that swallowed it would break every form that has one.
#[test]
fn enter_is_untouched_in_a_one_line_field() {
    val step = controls.entry_input(
        controls.entry_of("name", "Name", "ab"),
        press(controls.Key.Enter),
        anywhere,
        controls.default_style(),
        metrics()
    )
    test.assert_eq("ab", step.entry.editor.text)
    test.assert_false(step.changed)
}

#[test]
fn up_and_down_move_by_line_in_an_area_and_do_nothing_in_a_field() {
    val two = area(concat("abcd", "\n", "efgh"))
    val placed = with two { editor: edit.place_caret(two.editor, 2, false) }
    val down = controls.entry_input(placed, press(controls.Key.Down), anywhere, controls.default_style(), metrics())
    test.assert_eq(7, down.entry.editor.caret)
    val field = controls.entry_of("name", "Name", "abcd")
    val still = controls.entry_input(field, press(controls.Key.Down), anywhere, controls.default_style(), metrics())
    test.assert_eq(field.editor.caret, still.entry.editor.caret)
}

// Home and End are per line for both, which is not a difference between them: it follows from
// `edit.move_home` being line-aware, and for a field with no newline it is what it always was.
#[test]
fn home_is_the_start_of_the_line_not_of_the_text() {
    val a = area(concat("one", "\n", "two"))
    val placed = with a { editor: edit.place_caret(a.editor, 5, false) }
    val home = controls.entry_input(placed, press(controls.Key.Home), anywhere, controls.default_style(), metrics())
    test.assert_eq(4, home.entry.editor.caret)
}

#[test]
fn an_area_announces_itself_as_multiline() {
    val w = controls.entry_widget(area("x"), controls.default_style(), metrics())
    val laid = widget.layout(w, geom.rect_of(0.0, 0.0, 200.0, 100.0), metrics())
    val tree = a11y.tree_of(laid, "form", "body")
    if Some(node) = a11y.node_of(tree, "body") {
        test.assert(node.state.multiline)
    } else {
        test.fail("the area is not in the accessibility tree")
    }
}

// ---- a choice
//
// **A choice is a menu that announces itself as a value rather than a command**, and the cases that
// matter are the ones where the two must differ. The popup, the keyboard and the dismissal are the
// same code and are already covered by the menu tests above.

#[test]
fn a_choice_shows_what_is_chosen_and_a_menu_shows_its_title() {
    val choice = controls.choice_of("env", "Environment", ["global", "staging"], 1)
    test.assert_eq("staging", controls.collapsed_text(choice))
    test.assert_eq("staging", controls.chosen_value(choice))
    val menu = controls.menu_of("file", "File", ["Open", "Save"])
    test.assert_eq("File", controls.collapsed_text(menu))
    // A menu holds no value, and saying it held its title would make a reader announce a command
    // list as though something were selected in it.
    test.assert_eq("", controls.chosen_value(menu))
}

// **Nothing chosen shows the label, not an empty box.** A picker that rendered blank looks broken
// rather than unset, and -1 is what `choice_of` stores for an out-of-range index.
#[test]
fn a_choice_with_nothing_chosen_shows_its_label() {
    val choice = controls.choice_of("env", "Environment", ["global"], 0 - 1)
    test.assert_eq("Environment", controls.collapsed_text(choice))
    test.assert_eq("", controls.chosen_value(choice))
    val past_the_end = controls.choice_of("env", "Environment", ["global"], 7)
    test.assert_eq("Environment", controls.collapsed_text(past_the_end))
}

#[test]
fn a_choice_announces_itself_as_a_combo_box_holding_its_value() {
    val choice = controls.choice_of("env", "Environment", ["global", "staging"], 1)
    val laid = widget.layout(
        controls.menu_title_widget(choice, controls.default_style()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    val tree = a11y.tree_of(laid, "window", "env")
    if Some(node) = a11y.node_of(tree, "env") {
        // The label is the fixed name and the value is what is chosen: a control that introduced
        // itself as its own current value would say "staging, combo box, staging".
        test.assert_eq("Environment", node.name)
        test.assert_eq("staging", node.value)
        // Role first, then the name, then the value, then the state -- `a11y.announce`'s own order.
        test.assert_eq("combo box, Environment, staging, collapsed", a11y.announce(node))
    } else {
        test.fail("the choice is not in the accessibility tree")
    }
}

// **Choosing moves the collapsed text with it**, which is the point of reading the value from the
// list's selection rather than storing it: there is no second place to update and so no way for the
// two to disagree.
#[test]
fn choosing_from_a_choice_changes_what_it_shows() {
    val choice = with controls.choice_of("env", "Environment", ["global", "staging"], 0) { open: true }
    val moved = to_menu(choice, controls.Input.KeyDown(key(key_down)))
    test.assert_eq(1, moved.menu.items.selected)
    // The collapsed text follows the selection even before the item is chosen, which is what a
    // dropdown does while you arrow through it.
    test.assert_eq("staging", controls.collapsed_text(moved.menu))
    val taken = to_menu(moved.menu, controls.Input.KeyDown(key(controls.Key.Enter)))
    test.assert_eq(1, taken.chosen)
    test.assert_eq("staging", controls.chosen_value(taken.menu))
}

// **Choosing with the mouse**, which was keyboard-only until a real application tried it: a press
// on a row moved the selection and nothing turned that into a choice, so a menu could be opened,
// an item clicked, and the menu would sit there with the item highlighted.
#[test]
fn a_release_over_a_row_chooses_it() {
    val open_menu = with file_menu() { open: true }
    val on_row = geom.point_of(10.0, 50.0)
    val pressed = to_menu(open_menu, controls.Input.Press(on_row))
    // The press selects and does not choose, which is what lets a press-drag-release land elsewhere.
    test.assert_eq(0 - 1, pressed.chosen)
    test.assert(pressed.menu.open)
    val released = to_menu(pressed.menu, controls.Input.Release(on_row))
    test.assert_eq(pressed.menu.items.selected, released.chosen)
    test.assert_false(released.menu.open)
}

// A release outside the popup is not a choice -- which is the case that matters for the press that
// opened the menu in the first place, since its release lands on the title.
#[test]
fn a_release_off_the_popup_chooses_nothing() {
    val open_menu = with file_menu() { open: true }
    val released = to_menu(open_menu, controls.Input.Release(geom.point_of(10.0, 10.0)))
    test.assert_eq(0 - 1, released.chosen)
    test.assert(released.menu.open)
}

// **A text area scrolls itself to keep the caret in view**, which a one-line field has no need of
// and must not do. The case that matters is that *everything* moving the caret scrolls -- naming
// the movement keys is how a text area ends up with a scroll that works for Down and not for typing.
#[test]
fn a_text_area_scrolls_to_follow_its_caret() {
    val view_box = geom.rect_of(0.0, 0.0, 200.0, 40.0)
    val many = concat("a\nb\nc\nd\ne\nf\ng\nh\ni\nj")
    val tall = with area(many) { editor: edit.place_caret(edit.editor_of(many), 0, false) }
    test.assert_eq(0.0, tall.scroll)
    // End of the text: the last line is far below a 40 point box, so the view has to move.
    val toEnd = controls.entry_input(tall, press(controls.Key.End), view_box, controls.default_style(), metrics())
    val down = controls.entry_input(
        with toEnd.entry { editor: edit.place_caret(toEnd.entry.editor, len(many), false) },
        press(controls.Key.Right),
        box,
        controls.default_style(),
        metrics()
    )
    test.assert(down.entry.scroll > 0.0)
}

#[test]
fn a_one_line_field_never_scrolls() {
    val view_box = geom.rect_of(0.0, 0.0, 200.0, 20.0)
    val field = controls.entry_of("name", "Name", "a long value that will not fit in the box at all")
    val step = controls.entry_input(field, press(controls.Key.End), view_box, controls.default_style(), metrics())
    test.assert_eq(0.0, step.entry.scroll)
}

// Typing moves the view as surely as an arrow does: a run of newlines walks off the bottom.
#[test]
fn typing_scrolls_a_text_area_too() {
    val view_box = geom.rect_of(0.0, 0.0, 200.0, 40.0)
    var a = area("")
    var i = 0
    while i < 12 {
        val step = controls.entry_input(a, press(controls.Key.Enter), view_box, controls.default_style(), metrics())
        a = step.entry
        i = i + 1
    }
    test.assert(a.scroll > 0.0)
}

// ---- the focus ring
//
// **Nothing drew the focus, which a keyboard user needs to see.** Tab moved it, every control took
// its keys, and the window looked identical either way -- so the only way to find out what was
// focused was to type into something. These assert the ring is drawn, is drawn once, and follows
// the focus rather than sitting wherever the first control is.

fn ring_count(scene_now: scene.Scene) -> int {
    var strokes = 0
    for op in scene_now.ops {
        switch op {
            StrokePath(_) { strokes = strokes + 1 }
            Fill(_) { unit }
            Text(_) { unit }
            DrawImage(_) { unit }
            Nested(_) { unit }
        }
    }
    return strokes
}

fn two_fields() -> widget.Laid {
    val style = controls.default_style()
    val tree = widget.column_of(4.0, [
        widget.fixed_of(0.0, 20.0, controls.entry_widget(controls.entry_of("one", "One", "a"), style, metrics())),
        widget.fixed_of(0.0, 20.0, controls.entry_widget(controls.entry_of("two", "Two", "b"), style, metrics()))
    ])
    return widget.layout(tree, geom.rect_of(0.0, 0.0, 100.0, 60.0), metrics())
}

#[test]
fn the_focus_ring_is_drawn_once_around_the_focused_control() {
    val laid = two_fields()
    test.assert_eq(0, ring_count(widget.paint(laid, metrics())))
    val ringed = widget.paint_focused(laid, metrics(), "two", paint.rgb(0.0, 0.4, 0.9), 2.0)
    test.assert_eq(1, ring_count(ringed))
}

// **A name the tree does not hold draws nothing rather than refusing**, because a focus naming a
// control that is gone is an ordinary moment between two frames: a row was removed, a dialog
// closed. Refusing there would make a repaint fail for a reason the user cannot see.
#[test]
fn an_unknown_focus_draws_no_ring() {
    test.assert_eq(0, ring_count(widget.paint_focused(two_fields(), metrics(), "gone", paint.rgb(0.0, 0.0, 0.0), 2.0)))
}

// The ring has to move with the focus, not merely exist: a ring that always framed the first
// control would pass the count above and tell a user nothing.
#[test]
fn the_ring_follows_the_focus() {
    val laid = two_fields()
    val first = widget.paint_focused(laid, metrics(), "one", paint.rgb(0.0, 0.0, 0.0), 2.0)
    val second = widget.paint_focused(laid, metrics(), "two", paint.rgb(0.0, 0.0, 0.0), 2.0)
    test.assert_false(format("{}", first.ops) == format("{}", second.ops))
}

// **A dialog draws a scrim over the window behind it**, which it did not until an application
// opened one: a modal layer took the keys and drew nothing, so the dialog was text floating on the
// window it was blocking and nothing said which half was live.
#[test]
fn a_dialog_covers_what_it_blocks() {
    val style = controls.default_style()
    val dialog = controls.dialog_layer("ask", "Are you sure?", widget.label_of("yes or no", 12.0, paint.black()), style)
    val laid = widget.layout(widget.layered_of([
        widget.base_layer(widget.label_of("behind", 12.0, paint.black())),
        dialog
    ]), geom.rect_of(0.0, 0.0, 200.0, 100.0), metrics())
    val painted = widget.paint(laid, metrics())
    // The scrim is a fill the size of the window. Without it the dialog's own face is the only
    // fill, and that is the size of the dialog.
    var full_width_fills = 0
    for op in painted.ops {
        switch op {
            Fill(f) {
                val fill_box = shape.path_bounds(f.path)
                if fill_box.width >= 200.0 && fill_box.height >= 100.0 {
                    full_width_fills = full_width_fills + 1
                }
            }
            StrokePath(_) { unit }
            Text(_) { unit }
            DrawImage(_) { unit }
            Nested(_) { unit }
        }
    }
    test.assert_eq(1, full_width_fills)
}

// **Translucent, not opaque**: a modal dialog should say "this is waiting for you" rather than "the
// window is gone", and a user needs to see what they were doing to decide what to answer.
#[test]
fn the_scrim_is_translucent() {
    test.assert(controls.default_style().scrim.alpha > 0.0)
    test.assert(controls.default_style().scrim.alpha < 1.0)
}

// --------------------------------------------------------------- the tab strip

fn panes() -> controls.Tabs {
    return with controls.tabs_of("panes", "Panes", ["Response", "History", "Timing"]) {
        tab_width: 50.0
    }
}

val strip_box = geom.rect_of(0.0, 0.0, 300.0, 24.0)

fn to_tabs(t: controls.Tabs, input: controls.Input) -> controls.TabStep {
    return controls.tabs_input(t, input, strip_box)
}

fn tab_arrow(t: controls.Tabs, k: controls.Key) -> controls.TabStep {
    return to_tabs(t, controls.Input.KeyDown(controls.keystroke_of(k)))
}

#[test]
fn a_press_chooses_the_tab_it_landed_on() {
    val step = to_tabs(panes(), controls.Input.Press(geom.point_of(75.0, 10.0)))
    test.assert_eq(1, step.tabs.selected)
    test.assert(step.moved)
}

// `moved` is what the application acts on, so a press on the tab already showing must not report
// one: a pane that reloaded itself every time a user clicked where they already were would do the
// expensive thing on the one gesture that asks for nothing.
#[test]
fn pressing_the_selected_tab_moves_nothing() {
    val step = to_tabs(panes(), controls.Input.Press(geom.point_of(25.0, 10.0)))
    test.assert_eq(0, step.tabs.selected)
    test.assert_false(step.moved)
}

// A strip is usually narrower than the row it sits in, and the space past the last tab belongs to
// nothing. Dividing the whole box by `tab_width` would make that space tab 3, 4 and 5.
#[test]
fn a_press_past_the_last_tab_chooses_nothing() {
    val step = to_tabs(panes(), controls.Input.Press(geom.point_of(280.0, 10.0)))
    test.assert_eq(0, step.tabs.selected)
    test.assert_false(step.moved)
}

#[test]
fn the_arrows_walk_the_strip_and_stop_at_its_ends() {
    test.assert_eq(1, tab_arrow(panes(), controls.Key.Right).tabs.selected)
    test.assert_eq(0, tab_arrow(panes(), controls.Key.Left).tabs.selected)
    test.assert_eq(2, tab_arrow(panes(), controls.Key.End).tabs.selected)
    test.assert_eq(0, tab_arrow(with panes() { selected: 2 }, controls.Key.Home).tabs.selected)
}

// Clamped, not wrapped -- and the clamp has to report `moved: false`, or a Right held down at the
// end of the strip reloads the last pane as fast as the keyboard repeats.
#[test]
fn the_end_of_the_strip_is_a_place_you_can_feel() {
    val step = tab_arrow(with panes() { selected: 2 }, controls.Key.Right)
    test.assert_eq(2, step.tabs.selected)
    test.assert_false(step.moved)
}

// Some toolkits cycle the tabs with the wheel. The result is a user scrolling a page and changing
// what the page is, which is why this one does not.
#[test]
fn a_wheel_over_the_strip_changes_nothing() {
    val step = to_tabs(panes(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(75.0, 10.0),
        vertical: 0 - 1,
        horizontal: 0
    }))
    test.assert_eq(0, step.tabs.selected)
    test.assert_false(step.moved)
}

#[test]
fn a_disabled_strip_ignores_everything() {
    val off = with panes() { disabled: true }
    test.assert_false(to_tabs(off, controls.Input.Press(geom.point_of(75.0, 10.0))).moved)
    test.assert_false(tab_arrow(off, controls.Key.Right).moved)
}

fn laid_strip(t: controls.Tabs) -> widget.Laid {
    return widget.layout(controls.tabs_widget(t, controls.default_style()), strip_box, metrics())
}

// **The test this control exists to have.** `tabs_input` divides the strip by `tab_width` and
// `tabs_widget` lays every tab out at `tab_width`: two computations of one layout, which is the
// arrangement that lets a click land on the tab beside the one it looks like it hit. This asserts
// they agree by pressing at the centre of the box the *layout* gave tab 2 and asking the *input*
// which tab that was.
#[test]
fn the_hit_test_and_the_layout_agree_on_where_a_tab_is() {
    val l = laid_strip(panes())
    // Swept rather than sampled once, and stepped by a width that divides neither tab, so the walk
    // crosses both boundaries instead of landing in the middle of the same tab three times.
    var x = 5.0
    var crossed = 0
    while x < 150.0 {
        val at = geom.point_of(x, 10.0)
        val by_layout = switch focus.control_at(l, at) {
            Some(one) { one.name }
            None { "(nothing there)" }
        }
        val chose = to_tabs(panes(), controls.Input.Press(at)).tabs.selected
        test.assert_eq(by_layout, controls.tab_name(panes(), chose))
        crossed = crossed + 1
        x = x + 7.0
    }
    test.assert(crossed > 15)
}

// One stop for Tab, one node per tab for a reader -- the list's bargain, for the same reason.
#[test]
fn a_strip_is_one_tab_stop_and_one_node_per_tab() {
    val l = laid_strip(panes())
    test.assert_len(1, focus.controls(l))
    test.assert_eq(focus.controls(l)[0].name, "panes")

    val t = a11y.tree_of(l, "Records", "panes")
    // The window, the strip, and one node per tab.
    test.assert_len(5, t.nodes)
}

// A reader has to be told which tab is showing, and an index on the container would make every
// adapter work out for itself which child the number meant.
#[test]
fn the_selected_tab_says_so_and_the_others_do_not() {
    val t = a11y.tree_of(laid_strip(with panes() { selected: 1 }), "Records", "panes")
    test.assert_eq(said_of_tree(t, "panes/1"), "tab, History, selected")
    test.assert_eq(said_of_tree(t, "panes/0"), "tab, Response")
}

// The strip itself is a tab list, not a list: "Panes, list" would send a reader looking for rows.
#[test]
fn the_strip_announces_itself_as_a_tab_list() {
    test.assert_eq(said_of_tree(a11y.tree_of(laid_strip(panes()), "Records", ""), "panes"), "tab list, Panes")
}

fn said_of_tree(t: a11y.Tree, name: string) -> string {
    return switch a11y.node_of(t, name) {
        Some(one) { a11y.announce(one) }
        None { concat("(no node named ", name, ")") }
    }
}

// ---------------------------------------------------- the masked field

fn secret() -> controls.Entry {
    return controls.password_of("pass", "Password", "hunter2")
}

val secret_box = geom.rect_of(0.0, 0.0, 200.0, 24.0)

// One bullet per character, so every index into the text is the same index into what is drawn.
#[test]
fn a_masked_field_shows_bullets_and_not_the_text() {
    test.assert_eq(controls.shown_text(secret()), "•••••••")
    test.assert_eq(len(controls.shown_text(secret())), len("hunter2"))
    test.assert_eq(controls.shown_text(controls.entry_of("url", "URL", "hunter2")), "hunter2")
}

// **The secret never enters the accessibility tree**, rather than entering it and being filtered
// downstream -- a reader, a remote bridge and a test dump all read the one published string.
#[test]
fn a_masked_field_publishes_the_mask_and_announces_a_password() {
    val w = controls.entry_widget(secret(), controls.default_style(), metrics())
    test.assert_eq(said_of(w, "pass"), "password text, Password, •••••••")
    test.assert_false(contains(said_of(w, "pass"), "hunter2"))
}

// A click lands on the bullet it was aimed at, which is only true if the thing measured is the
// thing drawn. `metrics()` here gives every character the same width, so a press 2.5 characters in
// must place the caret at 3 -- and it would land somewhere else only if the press measured the
// real text while the widget drew the mask. (It cannot differ under *these* metrics, which is why
// the test below exists as well.)
#[test]
fn a_press_in_a_masked_field_places_the_caret_where_it_looks() {
    val taken = controls.entry_input(
        secret(),
        controls.Input.Press(geom.point_of(secret_box.x + 8.0 + 25.0, 10.0)),
        secret_box,
        controls.default_style(),
        metrics()
    )
    test.assert_eq(taken.entry.editor.caret, 3)
}

// The real guard on that, in a font where a bullet is **not** the width of the characters it
// hides: measuring the text instead of the mask puts the caret under a different bullet, and only
// metrics that tell the two apart can see it.
#[test]
fn the_caret_follows_the_mask_in_a_font_where_a_bullet_is_wider() {
    val wide_bullet = widget.metrics_of(
        fn(text: string, size: float) -> float {
            var w = 0.0
            for c in chars(text) {
                w = w + (if c == "•" { 20.0 } else { 10.0 })
            }
            return w
        },
        fn(size: float) -> float { return size * 2.0 }
    )
    val taken = controls.entry_input(
        secret(),
        controls.Input.Press(geom.point_of(secret_box.x + 8.0 + 50.0, 10.0)),
        secret_box,
        controls.default_style(),
        wide_bullet
    )
    // 50 points into a run of 20-point bullets is between the second and the third.
    test.assert_eq(taken.entry.editor.caret, 3)
}

// **A masked field will not put its contents on the clipboard.** A control whose whole purpose is
// that its text is not shown cannot be the one that hands it to every other program on the
// machine.
#[test]
fn a_masked_field_copies_nothing() {
    val select_all = controls.Input.KeyDown(with controls.keystroke_of(controls.Key.Char("a")) {
        control: true
    })
    val chosen = controls.entry_input(secret(), select_all, secret_box, controls.default_style(), metrics())
    val copy = controls.Input.KeyDown(with controls.keystroke_of(controls.Key.Char("c")) {
        control: true
    })
    val taken = controls.entry_input(chosen.entry, copy, secret_box, controls.default_style(), metrics())
    test.assert_eq(taken.copied, "")

    // The same gesture on an ordinary field does copy, or the test above would pass on a field
    // that simply never copies anything.
    val plain = controls.entry_of("url", "URL", "hunter2")
    val plain_chosen = controls.entry_input(plain, select_all, secret_box, controls.default_style(), metrics())
    val plain_taken = controls.entry_input(plain_chosen.entry, copy, secret_box, controls.default_style(), metrics())
    test.assert_eq(plain_taken.copied, "hunter2")
}

// **Cutting still deletes.** What is refused is handing the text out, not the editing -- and the
// no-op test has to ask the editor rather than the copied string, which is "" for a masked field
// by design.
#[test]
fn a_masked_field_still_cuts_even_though_it_hands_nothing_out() {
    val select_all = controls.Input.KeyDown(with controls.keystroke_of(controls.Key.Char("a")) {
        control: true
    })
    val chosen = controls.entry_input(secret(), select_all, secret_box, controls.default_style(), metrics())
    val cut = controls.Input.KeyDown(with controls.keystroke_of(controls.Key.Char("x")) {
        control: true
    })
    val taken = controls.entry_input(chosen.entry, cut, secret_box, controls.default_style(), metrics())
    test.assert_eq(taken.copied, "")
    test.assert_eq(taken.entry.editor.text, "")
    test.assert(taken.changed)
}

// A multi-line password is not a thing, and the multi-line widget draws the text -- so `rows`
// cannot be the field that decides, or there is a way to build one that masks in one place and
// not the other.
#[test]
fn a_masked_field_is_one_line_whatever_rows_says() {
    val tall = with secret() { rows: 4 }
    test.assert_eq(
        said_of(controls.entry_widget(tall, controls.default_style(), metrics()), "pass"),
        "password text, Password, •••••••"
    )
}

// --------------------------------------------------------------- the tree

// Two collections, one with a folder in it -- the shape curly's sidebar has, which is the shape
// this control was written for.
//
//   api            0  branch, open
//     auth         1  branch, open
//       login      2
//       refresh    2
//     health       1
//   empty          0  branch, open, and EMPTY -- the case a derived `expandable` gets wrong
//   scratch        0  leaf at the top, so "depth 0" and "branch" are not the same thing
fn forest() -> controls.Tree {
    return with controls.tree_of("files", "Collections", [
        controls.tree_branch("api", 0, true),
        controls.tree_branch("auth", 1, true),
        controls.tree_row("login", 2),
        controls.tree_row("refresh", 2),
        controls.tree_row("health", 1),
        controls.tree_branch("empty", 0, true),
        controls.tree_row("scratch", 0)
    ]) { row_height: 20.0, indent: 16.0 }
}

val tree_box = geom.rect_of(0.0, 0.0, 200.0, 140.0)

fn to_tree(t: controls.Tree, input: controls.Input) -> controls.TreeStep {
    return controls.tree_input(t, input, tree_box)
}

fn tree_key(t: controls.Tree, k: controls.Key) -> controls.TreeStep {
    return to_tree(t, controls.Input.KeyDown(controls.keystroke_of(k)))
}

fn labels_shown(t: controls.Tree) -> [string] {
    val out = mutable_array_new<string>()
    for at in controls.visible_rows(t) {
        push(out, t.rows[at].label)
    }
    return snapshot(out)
}

#[test]
fn everything_is_visible_while_every_branch_is_open() {
    test.assert_eq(
        join(separator: " ", pieces: labels_shown(forest())),
        "api auth login refresh health empty scratch"
    )
}

// **A closed branch hides its whole subtree, not just its children.** Closing `api` has to take
// `login` and `refresh` with it, and a visibility test that only looked one level up would leave
// two rows on screen with nothing above them.
#[test]
fn closing_a_branch_hides_everything_under_it() {
    val shut = to_tree(forest(), controls.Input.Press(geom.point_of(8.0, 10.0)))
    test.assert(shut.toggled)
    test.assert_eq(join(separator: " ", pieces: labels_shown(shut.tree)), "api empty scratch")
}

// A press on the label selects; a press on the mark opens or closes. The two are a few points
// apart on the same row, which is why the hit test needs the column as well as the row.
#[test]
fn a_press_on_the_label_selects_where_a_press_on_the_mark_toggles() {
    val chose = to_tree(forest(), controls.Input.Press(geom.point_of(60.0, 30.0)))
    test.assert_false(chose.toggled)
    test.assert_eq(chose.tree.selected, 1)
    test.assert(chose.moved)

    val shut = to_tree(forest(), controls.Input.Press(geom.point_of(20.0, 30.0)))
    test.assert(shut.toggled)
    test.assert_false(shut.tree.rows[1].expanded)
}

// **A leaf has no mark, so the column it would be in is part of the label.** Pressing there must
// select rather than quietly do nothing, or a third of every leaf row is dead.
#[test]
fn pressing_where_a_leaf_has_no_mark_still_selects_it() {
    val chose = to_tree(forest(), controls.Input.Press(geom.point_of(36.0, 50.0)))
    test.assert_false(chose.toggled)
    test.assert_eq(chose.tree.selected, 2)
}

// The arrows walk what is on screen, not the array: with `api` closed, Down from it lands on
// `empty` and not on `auth`.
#[test]
fn the_arrows_step_over_what_is_hidden() {
    val shut = to_tree(forest(), controls.Input.Press(geom.point_of(8.0, 10.0))).tree
    test.assert_eq(tree_key(shut, controls.Key.Down).tree.selected, 5)
    test.assert_eq(t_label(tree_key(shut, controls.Key.Down).tree), "empty")
}

fn t_label(t: controls.Tree) -> string {
    if t.selected < 0 || t.selected >= len(t.rows) {
        return "(none)"
    }
    return t.rows[t.selected].label
}

// **Right opens a closed branch and steps into an open one**, which is what makes Right-Right walk
// downwards instead of stopping on the first folder.
#[test]
fn right_opens_a_branch_then_steps_into_it() {
    val shut = to_tree(forest(), controls.Input.Press(geom.point_of(8.0, 10.0))).tree
    val opened = tree_key(shut, controls.Key.Right)
    test.assert(opened.toggled)
    test.assert_eq(t_label(opened.tree), "api")
    test.assert_eq(t_label(tree_key(opened.tree, controls.Key.Right).tree), "auth")
}

// **Left closes an open branch and climbs out of a leaf**, which is the move that makes a deep
// tree navigable: without it the only way out of a folder is Up past every sibling.
#[test]
fn left_closes_a_branch_then_climbs_to_the_parent() {
    val on_login = with forest() { selected: 2 }
    val up = tree_key(on_login, controls.Key.Left)
    test.assert_false(up.toggled)
    test.assert_eq(t_label(up.tree), "auth")
    val shut = tree_key(up.tree, controls.Key.Left)
    test.assert(shut.toggled)
    test.assert_eq(t_label(shut.tree), "auth")
    test.assert_false(shut.tree.rows[1].expanded)
}

// Left on a top-level leaf has nowhere to climb to and must not move the selection to row 0 by
// accident -- `parent_of` answers -1 and the key does nothing.
#[test]
fn left_at_the_top_of_the_tree_does_nothing() {
    val on_scratch = with forest() { selected: 6 }
    val step = tree_key(on_scratch, controls.Key.Left)
    test.assert_eq(t_label(step.tree), "scratch")
    test.assert_false(step.moved)
    test.assert_false(step.toggled)
}

// **Opening a branch does not move the selection off it**, or Right-then-Left is not a round trip
// and a user loses their place every time they look inside a folder.
#[test]
fn toggling_leaves_the_selection_where_it_was() {
    val shut = to_tree(forest(), controls.Input.Press(geom.point_of(8.0, 10.0)))
    test.assert_eq(shut.tree.selected, 0)
    test.assert_false(shut.activated)
}

// An empty branch is still a branch. A tree that worked `expandable` out from the next row's depth
// would draw `empty` as a leaf, and a user could not tell an empty folder from a missing one.
#[test]
fn an_empty_branch_still_opens_and_closes() {
    val shut = to_tree(forest(), controls.Input.Press(geom.point_of(8.0, 110.0)))
    test.assert(shut.toggled)
    test.assert_eq(shut.tree.selected, 5)
    // Nothing was hidden, because there is nothing under it -- but the state changed, which is
    // what a reader is told.
    test.assert_eq(join(separator: " ", pieces: labels_shown(shut.tree)), "api auth login refresh health empty scratch")
}

#[test]
fn enter_chooses_and_the_arrows_do_not() {
    test.assert(tree_key(forest(), controls.Key.Enter).activated)
    test.assert_false(tree_key(forest(), controls.Key.Down).activated)
}

#[test]
fn a_disabled_tree_ignores_everything() {
    val off = with forest() { disabled: true }
    test.assert_false(to_tree(off, controls.Input.Press(geom.point_of(8.0, 10.0))).toggled)
    test.assert_false(tree_key(off, controls.Key.Down).moved)
}

fn laid_tree(t: controls.Tree) -> widget.Laid {
    return widget.layout(controls.tree_widget(t, controls.default_style()), tree_box, metrics())
}

// One stop for Tab, one node per **visible** row -- a reader should not be told about rows that
// are not on screen any more than a sighted user should see them.
#[test]
fn a_tree_is_one_tab_stop_and_a_node_per_visible_row() {
    val open_tree = a11y.tree_of(laid_tree(forest()), "Records", "files")
    // The window, the tree, and seven rows.
    test.assert_len(9, open_tree.nodes)

    val shut = to_tree(forest(), controls.Input.Press(geom.point_of(8.0, 10.0))).tree
    val shut_tree = a11y.tree_of(laid_tree(shut), "Records", "files")
    // The window, the tree, and three rows.
    test.assert_len(5, shut_tree.nodes)
    test.assert_len(1, focus.controls(laid_tree(shut)))
}

// **A branch says whether it is open; a leaf says nothing.** `Some(false)` on a leaf publishes
// EXPANDABLE, and a reader would offer to open a thing that cannot be opened.
#[test]
fn a_branch_says_it_is_open_and_a_leaf_says_nothing_about_it() {
    val t = a11y.tree_of(laid_tree(forest()), "Records", "files")
    test.assert_eq(said_of_tree(t, "files/0"), "tree item, api, expanded, selected")
    test.assert_eq(said_of_tree(t, "files/2"), "tree item, login")
    val shut = to_tree(forest(), controls.Input.Press(geom.point_of(8.0, 10.0))).tree
    test.assert_eq(
        said_of_tree(a11y.tree_of(laid_tree(shut), "Records", "files"), "files/0"),
        "tree item, api, collapsed, selected"
    )
}

#[test]
fn the_tree_announces_itself_as_a_tree() {
    test.assert_eq(said_of_tree(a11y.tree_of(laid_tree(forest()), "Records", ""), "files"), "tree, Collections")
}

// **The hit test and the layout agree on where a row's mark is**, the tab strip's rule again: the
// widget indents by `indent` per level and the press divides by it, so a sweep across the row must
// put the mark exactly where the layout drew the label's left edge minus one indent.
#[test]
fn the_mark_a_press_toggles_is_where_the_layout_drew_it() {
    // `auth` sits at depth 1, so its mark is the second indent-wide column.
    val on_mark = to_tree(forest(), controls.Input.Press(geom.point_of(16.0 + 8.0, 30.0)))
    test.assert(on_mark.toggled)
    // One indent to the left is `api`'s column, which on this row is empty space, so a press there
    // selects rather than toggling -- the thing that breaks if the two disagree by one level.
    val left_of_it = to_tree(forest(), controls.Input.Press(geom.point_of(8.0, 30.0)))
    test.assert_false(left_of_it.toggled)
    test.assert_eq(left_of_it.tree.selected, 1)
}

// **A reader asks a node for its children, so the parts have to nest.** The rows are flat and the
// layout is a plain column; if the parts were flat too, a reader would be told that seven things
// exist and nothing about which is inside which -- an indented list, from the one side that
// cannot see the indent. The first version of `tree_widget` was exactly that and every other test
// in this file passed.
#[test]
fn a_branch_is_the_parent_of_what_is_under_it() {
    val t = a11y.tree_of(laid_tree(forest()), "Records", "files")
    test.assert_eq(kids_of(t, "files/0"), "files/1 files/4")
    test.assert_eq(kids_of(t, "files/1"), "files/2 files/3")
    test.assert_eq(kids_of(t, "files/2"), "")
    // The tree itself holds only the top level, not every row.
    test.assert_eq(kids_of(t, "files"), "files/0 files/5 files/6")
}

// Closing a branch takes its children out of the tree a reader walks, not just off the screen.
#[test]
fn a_closed_branch_has_no_children_to_walk() {
    val shut = to_tree(forest(), controls.Input.Press(geom.point_of(8.0, 10.0))).tree
    val t = a11y.tree_of(laid_tree(shut), "Records", "files")
    test.assert_eq(kids_of(t, "files/0"), "")
    test.assert_eq(kids_of(t, "files"), "files/0 files/5 files/6")
}

fn kids_of(t: a11y.Tree, name: string) -> string {
    return switch a11y.node_of(t, name) {
        Some(one) { join(separator: " ", pieces: named_children(t, one)) }
        None { concat("(no node named ", name, ")") }
    }
}

// The children that are rows of the tree, by name. A part wraps a group, so a node's `children`
// holds the boxes as well -- this is the walk a reader does, which is for the named ones.
fn named_children(t: a11y.Tree, node: a11y.Node) -> [string] {
    val out = mutable_array_new<string>()
    for key in node.children {
        switch a11y.node_of(t, key) {
            Some(child) { if widget.Role.is_TreeItem(child.role) { push(out, key) } }
            None { unit }
        }
    }
    return snapshot(out)
}

// ------------------------------------------------------------- the scroll bar

// The box a named group was laid out in, or a rectangle of -1 when there is none. A sentinel
// rather than an `Option`, for `said_of`'s reason: it reads better in the failure than a `None`.
fn box_named(l: widget.Laid, name: string) -> geom.Rect {
    if l.name == name {
        return l.bounds
    }
    for child in l.children {
        val found = box_named(child, name)
        if found.height >= 0.0 {
            return found
        }
    }
    return geom.rect_of(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0)
}

// A hundred points of content in a forty-point view, so the thumb is two fifths of the track and
// there are sixty points of overhang.
val bar_box = geom.rect_of(0.0, 0.0, 12.0, 100.0)
val bar_content = 250.0
val bar_view = 100.0

fn bar() -> controls.ScrollBar {
    return controls.scroll_bar_of("scroll", 20.0)
}

fn to_bar(b: controls.ScrollBar, input: controls.Input, offset: float) -> controls.ScrollBarStep {
    return controls.scroll_bar_input(b, input, bar_box, bar_content, bar_view, offset)
}

#[test]
fn the_thumb_is_the_views_share_of_the_content() {
    val t = controls.thumb_of(100.0, 250.0, 100.0, 0.0)
    test.assert_eq(t.length, 40.0)
    test.assert_eq(t.start, 0.0)
    // Scrolled to the end, the thumb sits at the end of the track and not past it.
    val end = controls.thumb_of(100.0, 250.0, 100.0, 150.0)
    test.assert_eq(end.start, 60.0)
    test.assert_eq(end.start + end.length, 100.0)
}

// **A very long list still leaves something to take hold of.** The share of a thousand rows in a
// five-row view is a thumb too small to aim at, which is why the floor exists -- and the floor
// must not push the thumb past the end of its track.
#[test]
fn a_tiny_thumb_is_floored_and_still_fits() {
    val t = controls.thumb_of(100.0, 100000.0, 100.0, 100000.0 - 100.0)
    test.assert_eq(t.length, min_thumb)
    test.assert_eq(t.start + t.length, 100.0)
}

// **A track shorter than the floor is the case the floor itself can break.** A bar beside a
// two-row list is fifteen points tall; flooring its thumb at twenty would draw a thumb longer
// than the track it is in, hanging out of the bottom of the bar. Found by mutation: without the
// second clamp every other test here still passed, because they all use a track of a hundred.
#[test]
fn a_thumb_never_outgrows_a_short_track() {
    val t = controls.thumb_of(15.0, 250.0, 100.0, 0.0)
    test.assert_eq(t.length, 15.0)
    test.assert(t.start + t.length <= 15.0)
}

// Nothing to scroll: a full track and no thumb, rather than a thumb of zero length or a bar that
// disappears and moves the layout.
#[test]
fn a_view_bigger_than_its_content_has_no_thumb() {
    test.assert_false(controls.scrolls(40.0, 100.0))
    test.assert_eq(controls.thumb_of(100.0, 40.0, 100.0, 0.0).length, 100.0)
}

// A press on the track pages **towards the pointer**, which is what a track click does
// everywhere: above the thumb goes back a viewful, below it goes forward one.
#[test]
fn a_press_on_the_track_pages_towards_the_pointer() {
    val down = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 80.0)), 0.0)
    test.assert_eq(down.offset, 100.0)
    test.assert(down.moved)
    val up = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 5.0)), 150.0)
    test.assert_eq(up.offset, 50.0)
}

// Paging stops at the end rather than running past it, or a user clicking twice at the bottom
// scrolls into empty space.
#[test]
fn paging_stops_at_the_ends() {
    test.assert_eq(to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 95.0)), 120.0).offset, 150.0)
    test.assert_eq(to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 2.0)), 30.0).offset, 0.0)
}

// **A press on the thumb takes hold of it and scrolls nothing**, which is the whole of the
// difference between grabbing and paging -- a press that also jumped would move the content out
// from under the pointer before the drag began.
#[test]
fn a_press_on_the_thumb_grabs_without_moving() {
    val held = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 10.0)), 0.0)
    test.assert_eq(held.offset, 0.0)
    test.assert_false(held.moved)
    test.assert(Option.is_Some(held.bar.grabbed))
}

// **The drag keeps the point the thumb was taken hold of.** Grabbing the middle of the thumb and
// moving ten points must move the content by ten points' worth, not jump the thumb's middle to
// the pointer -- which is the single thing every hand-written scrollbar gets wrong.
#[test]
fn a_drag_keeps_where_the_thumb_was_grabbed() {
    val held = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 20.0)), 0.0).bar
    val moved = to_bar(held, controls.Input.Move(geom.point_of(6.0, 50.0)), 0.0)
    // Grabbed 20 points down a thumb starting at 0, so the thumb's start is now 30 of the 60
    // points of room, which is half the 150 points of overhang.
    test.assert_eq(moved.offset, 75.0)
}

#[test]
fn a_drag_stops_at_the_ends_too() {
    val held = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 20.0)), 0.0).bar
    test.assert_eq(to_bar(held, controls.Input.Move(geom.point_of(6.0, 900.0)), 0.0).offset, 150.0)
    test.assert_eq(to_bar(held, controls.Input.Move(geom.point_of(6.0, 0.0 - 900.0)), 0.0).offset, 0.0)
}

// A move with nothing held is a pointer passing over, not a drag.
#[test]
fn a_move_without_a_grab_scrolls_nothing() {
    val step = to_bar(bar(), controls.Input.Move(geom.point_of(6.0, 90.0)), 0.0)
    test.assert_eq(step.offset, 0.0)
    test.assert_false(step.moved)
}

// **A release lets go wherever it happens**, as a button's does: a thumb still holding on after
// the pointer came up follows it around the window.
#[test]
fn a_release_lets_go_even_off_the_bar() {
    val held = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, 20.0)), 0.0).bar
    val let_go = to_bar(held, controls.Input.Release(geom.point_of(500.0, 500.0)), 0.0)
    test.assert_false(Option.is_Some(let_go.bar.grabbed))
}

#[test]
fn the_wheel_moves_by_the_step_it_was_given() {
    test.assert_eq(to_bar(bar(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(6.0, 50.0),
        vertical: 0 - 1,
        horizontal: 0
    }), 40.0).offset, 60.0)
}

#[test]
fn a_disabled_bar_ignores_everything() {
    val off = with bar() { disabled: true }
    test.assert_false(to_bar(off, controls.Input.Press(geom.point_of(6.0, 80.0)), 0.0).moved)
}

fn laid_bar(offset: float) -> widget.Laid {
    return widget.layout(
        controls.scroll_bar_widget(bar(), controls.default_style(), 12.0, 100.0, bar_content, bar_view, offset),
        bar_box,
        metrics()
    )
}

// **The thumb the layout draws is the thumb the press reads**, the rule this module keeps
// relearning: a bar drawn by one calculation and dragged by another jumps under the pointer.
#[test]
fn the_drawn_thumb_is_where_the_hit_test_looks_for_it() {
    val drawn = box_named(laid_bar(75.0), thumb_name)
    val figured = controls.thumb_of(100.0, bar_content, bar_view, 75.0)
    test.assert_eq(drawn.y, figured.start)
    test.assert_eq(drawn.height, figured.length)
    // And a press at the drawn thumb's own middle grabs rather than pages.
    val step = to_bar(bar(), controls.Input.Press(geom.point_of(6.0, drawn.y + drawn.height / 2.0)), 75.0)
    test.assert_eq(step.offset, 75.0)
    test.assert(Option.is_Some(step.bar.grabbed))
}

// Nothing to scroll means no thumb drawn at all, not a thumb filling the track -- the track says
// "there is nothing below" by being empty.
#[test]
fn an_unscrollable_bar_draws_no_thumb() {
    val l = widget.layout(
        controls.scroll_bar_widget(bar(), controls.default_style(), 12.0, 100.0, 40.0, 100.0, 0.0),
        bar_box,
        metrics()
    )
    test.assert_eq(box_named(l, thumb_name).height, 0.0 - 1.0)
}

// Not a tab stop: the content takes the focus and its arrows scroll it, so a stop here would be
// one a keyboard user tabs through and cannot use.
#[test]
fn a_scroll_bar_is_not_in_the_tab_order() {
    test.assert_len(0, focus.controls(laid_bar(0.0)))
    test.assert_eq(
        said_of_tree(a11y.tree_of(laid_bar(0.0), "Records", ""), "scroll"),
        "scroll bar"
    )
}

// **Rows that do not start at depth 0, and a skipped level.** Neither is how a sidebar is built,
// which is why neither was tested -- and `tree_widget` dropped them silently: its walk took rows
// while `depth >= level`, and a row *deeper* than the level it was first met at fell into a guard
// that advanced past it without building anything. A tree whose rows all sat at depth 1 drew
// nothing at all. Found by a profiler reporting that a layout benchmark had no work to do.
#[test]
fn every_row_is_drawn_whatever_depth_it_starts_at() {
    val deep = controls.tree_of("files", "Collections", [
        controls.tree_row("one", 1),
        controls.tree_row("two", 1),
        controls.tree_row("three", 1)
    ])
    val t = a11y.tree_of(laid_tree(deep), "Records", "files")
    // The window, the tree, and three rows.
    test.assert_len(5, t.nodes)
    test.assert_eq(kids_of(t, "files"), "files/0 files/1 files/2")
}

// A level skipped in the middle nests under what is above it rather than vanishing.
#[test]
fn a_skipped_level_still_hangs_off_its_parent() {
    val gap = controls.tree_of("files", "Collections", [
        controls.tree_branch("top", 0, true),
        controls.tree_row("deep", 2),
        controls.tree_row("next", 0)
    ])
    val t = a11y.tree_of(laid_tree(gap), "Records", "files")
    test.assert_len(5, t.nodes)
    test.assert_eq(kids_of(t, "files"), "files/0 files/2")
    test.assert_eq(kids_of(t, "files/0"), "files/1")
}

// ---- the bars painted over a laid-out tree

// A viewport 100 tall onto 250 of content, scrolled by 60.
fn scrolled_tree() -> widget.Laid {
    val rows = mutable_array_new<widget.Widget>()
    var i = 0
    while i < 25 {
        push(rows, widget.fixed_of(0.0, 10.0, widget.label_of(concat("row ", str(i)), 8.0, paint.black())))
        i = i + 1
    }
    val w = widget.named_scroll("list", 0.0, 60.0, widget.column_of(0.0, snapshot(rows)))
    return widget.layout(w, geom.rect_of(0.0, 0.0, 80.0, 100.0), metrics())
}

fn bars_over(l: widget.Laid) -> [scene.Op] {
    val empty = scene.scene_of(l.bounds.width, l.bounds.height)
    return controls.paint_scroll_bars(l, empty, controls.default_style()).ops
}

// **The pass takes its numbers off the laid tree and nowhere else**, which is the whole reason it
// exists: the view is the viewport's own box, the content is the box its child was placed in, and
// the offset is on the widget. Nothing has to lay the window out twice to learn them.
#[test]
fn a_viewport_gets_a_track_and_a_thumb() {
    val ops = bars_over(scrolled_tree())
    test.assert_len(2, ops)
    val track = fill_box(ops[0])
    val thumb = fill_box(ops[1])
    // Hard against the viewport's right edge, the one width everything that draws or grabs a bar
    // shares.
    test.assert_eq(track.x, 80.0 - bar_thickness)
    test.assert_eq(track.width, bar_thickness)
    test.assert_eq(track.height, 100.0)
    // 100 of 250 visible, so the thumb is two fifths of the track; 60 of the 150 points of
    // overhang, so it sits two fifths of the way down the 60 points of room.
    test.assert_eq(thumb.height, 40.0)
    test.assert_eq(thumb.y, 24.0)
}

// **Nothing to scroll, nothing drawn.** A bar over content that fits is a bar that lies.
#[test]
fn a_viewport_that_fits_gets_no_bar() {
    val w = widget.named_scroll("list", 0.0, 0.0, widget.fixed_of(0.0, 20.0, widget.flex()))
    val l = widget.layout(w, geom.rect_of(0.0, 0.0, 80.0, 100.0), metrics())
    test.assert_len(0, bars_over(l))
}

// The ops already in the scene are kept, because this paints *over* what is there rather than
// instead of it -- and a pass that quietly dropped the window would be a very loud bug.
#[test]
fn the_scene_underneath_is_kept() {
    val l = scrolled_tree()
    val under = scene.with_ops(
        scene.scene_of(80.0, 100.0),
        [scene.fill(shape.rect_path(geom.rect_of(0.0, 0.0, 80.0, 100.0)), paint.Paint.Solid(paint.black()))]
    )
    val after = controls.paint_scroll_bars(l, under, controls.default_style())
    test.assert_len(3, after.ops)
    test.assert_eq(fill_box(after.ops[0]).width, 80.0)
}

// Every viewport, not the first one found: a window has a sidebar and a response pane, and the
// walk has to keep going after it has drawn one.
#[test]
fn every_viewport_in_the_tree_gets_one() {
    val two = widget.row_of(0.0, [
        widget.fixed_of(80.0, 0.0, widget.named_scroll("a", 0.0, 10.0, widget.fixed_of(0.0, 400.0, widget.flex()))),
        widget.fixed_of(80.0, 0.0, widget.named_scroll("b", 0.0, 10.0, widget.fixed_of(0.0, 400.0, widget.flex())))
    ])
    val l = widget.layout(two, geom.rect_of(0.0, 0.0, 160.0, 100.0), metrics())
    test.assert_len(4, bars_over(l))
}

// The rectangle a `Fill` covers, which is the only thing these tests look at.
fn fill_box(op: scene.Op) -> geom.Rect {
    return switch op {
        Fill(f) { shape.path_bounds(f.path) }
        StrokePath(_) { geom.rect_of(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0) }
        Text(_) { geom.rect_of(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0) }
        DrawImage(_) { geom.rect_of(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0) }
        Nested(_) { geom.rect_of(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0) }
    }
}

// **A wheel over a list's row has to reach the list, not the row.** `control_at` answers the
// innermost control, which for a list or a tree is a `part_of` -- a thing a click and a reader can
// reach and that no application holds a state for. So a wheel routed that way named a control
// nobody could handle, and was dropped: the wheel had never scrolled a list or a tree in any
// application. Found by painting a scroll bar, which made the absence visible.
#[test]
fn a_wheel_over_a_row_is_routed_to_the_list() {
    val l = laid_list(five())
    val over_a_row = controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(20.0, 30.0),
        vertical: 0 - 1,
        horizontal: 0
    })
    // The row is what `control_at` finds, and it is *not* what the wheel is for.
    test.assert_eq(switch focus.control_at(l, geom.point_of(20.0, 30.0)) {
        Some(one) { one.name }
        None { "(nothing)" }
    }, controls.row_name(five(), 1))
    test.assert_eq(controls.target(l, over_a_row, ""), "people")
}

// ---- dragging the bar a tree and a list draw

// 25 rows of 20 in a 100-tall box: 500 of content in a 100 view, 400 of overhang.
fn long_tree() -> controls.Tree {
    val rows = mutable_array_new<controls.TreeRow>()
    var i = 0
    while i < 25 {
        push(rows, controls.tree_row(concat("row ", str(i)), 0))
        i = i + 1
    }
    return controls.tree_of("files", "Files", snapshot(rows))
}

val long_box = geom.rect_of(0.0, 0.0, 200.0, 100.0)

fn on_long(t: controls.Tree, input: controls.Input) -> controls.TreeStep {
    return controls.tree_input(t, input, long_box)
}

// **A press in the strip down the right edge takes the bar, not the row behind it.** The row is
// still there -- the bar is painted over the content, not beside it -- so the only thing that
// separates the two gestures is where in the row the press landed.
#[test]
fn a_press_in_the_strip_grabs_the_bar_and_not_the_row() {
    val grabbed = on_long(long_tree(), controls.Input.Press(geom.point_of(196.0, 10.0)))
    test.assert_false(grabbed.moved)
    test.assert_eq(grabbed.tree.selected, 0)
    test.assert(Option.is_Some(grabbed.tree.bar.grabbed))

    // Four points to the left of the strip is the row, and it selects.
    val row = on_long(long_tree(), controls.Input.Press(geom.point_of(200.0 - bar_thickness - 4.0, 30.0)))
    test.assert_eq(row.tree.selected, 1)
    test.assert_false(Option.is_Some(row.tree.bar.grabbed))
}

// **Nothing to scroll, no strip.** A bar that is not drawn must not take a press either, or the
// last few points of every row in a short list are dead.
#[test]
fn a_short_tree_has_no_strip_to_grab() {
    val short = with long_tree() { rows: [controls.tree_row("only", 0)] }
    val step = on_long(short, controls.Input.Press(geom.point_of(196.0, 10.0)))
    test.assert_false(Option.is_Some(step.tree.bar.grabbed))
    test.assert_eq(step.tree.selected, 0)
}

// **The drag keeps the point the thumb was taken hold of, and moves the view.** 500 of content in
// a 100 view gives a 20-point thumb with 80 points of room over 400 of overhang, so a pointer 20
// points further down is 100 further into the content.
#[test]
fn dragging_the_bar_scrolls_without_moving_the_selection() {
    val held = on_long(long_tree(), controls.Input.Press(geom.point_of(196.0, 5.0))).tree
    val dragged = on_long(held, controls.Input.Move(geom.point_of(196.0, 25.0)))
    test.assert_eq(dragged.tree.offset, 100.0)
    test.assert_eq(dragged.tree.selected, 0)
    test.assert_false(dragged.moved)
}

// **A drag that wanders off the strip keeps dragging.** The release is routed to the focus rather
// than to what is under the pointer, so a thumb still holding on after the pointer left would
// follow it around the window.
#[test]
fn a_drag_off_the_strip_still_drags_and_still_lets_go() {
    val held = on_long(long_tree(), controls.Input.Press(geom.point_of(196.0, 5.0))).tree
    val away = on_long(held, controls.Input.Move(geom.point_of(10.0, 55.0)))
    test.assert_eq(away.tree.offset, 250.0)
    val let_go = on_long(away.tree, controls.Input.Release(geom.point_of(10.0, 55.0)))
    test.assert_false(Option.is_Some(let_go.tree.bar.grabbed))
    // ...and once it has let go, a press in the rows selects again -- row 13, because the view is
    // 250 points down and the press is 10 into it.
    test.assert_eq(on_long(let_go.tree, controls.Input.Press(geom.point_of(40.0, 10.0))).tree.selected, 13)
}

// A wheel over the strip scrolls the tree the ordinary way rather than being taken for a grab:
// only a press decides, which is what `for_the_bar` tests.
#[test]
fn a_wheel_over_the_strip_is_still_a_wheel() {
    val step = on_long(long_tree(), controls.Input.Wheel(controls.Wheel {
        at: geom.point_of(196.0, 50.0),
        vertical: 0 - 1,
        horizontal: 0
    }))
    test.assert_eq(step.tree.offset, 20.0)
    test.assert_false(Option.is_Some(step.tree.bar.grabbed))
}

// The list has the same bar, and the same rule about the selection.
#[test]
fn a_list_drags_its_bar_too() {
    val many = mutable_array_new<string>()
    var i = 0
    while i < 25 {
        push(many, concat("row ", str(i)))
        i = i + 1
    }
    val l = controls.list_of("rows", "Rows", snapshot(many))
    val held = controls.list_input(l, controls.Input.Press(geom.point_of(196.0, 5.0)), long_box)
    test.assert(Option.is_Some(held.list.bar.grabbed))
    val dragged = controls.list_input(held.list, controls.Input.Move(geom.point_of(196.0, 25.0)), long_box)
    test.assert_eq(dragged.list.offset, 100.0)
    test.assert_eq(dragged.list.selected, 0)
    test.assert_false(dragged.moved)
}

// ---- a field with a composition open

fn composing_field() -> controls.Entry {
    return controls.entry_composing(controls.entry_of("note", "Note", "ab"), "かんじ", 3).entry
}

val note_box = geom.rect_of(0.0, 0.0, 200.0, 24.0)

// What is drawn is the committed text with the composition spliced in; what is *stored* is not.
#[test]
fn a_composing_field_shows_what_is_not_yet_in_it() {
    val e = composing_field()
    test.assert_eq(e.editor.text, "ab")
    test.assert_eq(controls.shown_text(e), "abかんじ")
}

// **Composing is not a change; committing is.** `changed` is what a form watches to know it is
// dirty, and a half-typed composition has changed nothing a save would write.
#[test]
fn composing_is_not_a_change_and_committing_is() {
    val start = controls.entry_of("note", "Note", "ab")
    test.assert_false(controls.entry_composing(start, "か", 1).changed)
    val composing = controls.entry_composing(start, "かんじ", 3).entry
    test.assert(controls.entry_commit(composing, "漢字").changed)
}

#[test]
fn committing_writes_what_the_method_chose() {
    val done = controls.entry_commit(composing_field(), "漢字").entry
    test.assert_eq(done.editor.text, "ab漢字")
    test.assert_false(Option.is_Some(done.preedit))
    test.assert_eq(controls.shown_text(done), "ab漢字")
}

// **An empty commit abandons the composition**: the method says it chose nothing, so the pre-edit
// goes and the text is as it was.
#[test]
fn an_empty_commit_abandons_the_composition() {
    val done = controls.entry_commit(composing_field(), "").entry
    test.assert_eq(done.editor.text, "ab")
    test.assert_false(Option.is_Some(done.preedit))
    test.assert_false(controls.entry_commit(composing_field(), "").changed)
}

// A commit with nothing open is ordinary text, which is what a method sends for a compose
// sequence that never showed a pre-edit -- a dead key followed by a vowel.
#[test]
fn a_commit_with_nothing_open_is_ordinary_text() {
    val typed = controls.entry_commit(controls.entry_of("note", "Note", "ab"), "é").entry
    test.assert_eq(typed.editor.text, "abé")
}

// **The pointer does not move the caret while composing**, and the reason is an index rather than
// a policy: a press is measured against the shown text, which has the composition in it, while
// the caret is placed in the committed text. Placing one from the other puts the caret a
// composition's length from where it was clicked.
#[test]
fn a_press_while_composing_moves_nothing() {
    // **Composed in the middle of the text, not at the end**, which the first version of this
    // test got wrong: with the composition at the end, an index taken from the shown text clamps
    // to the end of the committed text -- which is where the caret already was, so the test
    // passed with the guard removed. Mutation is what said so.
    val mid = with controls.entry_of("note", "Note", "abcdef") {
        editor: edit.place_caret(edit.editor_of("abcdef"), 2, false)
    }
    val e = controls.entry_composing(mid, "XY", 2).entry
    test.assert_eq(controls.shown_text(e), "abXYcdef")
    // Six characters in at ten points each, past the field's padding: an index the committed text
    // can hold, and not the one the caret is at.
    val pressed = controls.entry_input(
        e,
        controls.Input.Press(geom.point_of(controls.default_style().padding.left + 62.0, 10.0)),
        note_box,
        controls.default_style(),
        metrics()
    )
    test.assert_eq(pressed.entry.editor.caret, 2)
    test.assert(Option.is_Some(pressed.entry.preedit))

    // ...and once it is committed, a press places a caret again.
    val done = controls.entry_commit(e, "Z").entry
    val after = controls.entry_input(
        done,
        controls.Input.Press(geom.point_of(5.0, 10.0)),
        note_box,
        controls.default_style(),
        metrics()
    )
    test.assert_eq(after.entry.editor.caret, 0)
}

// The caret is drawn inside the composition, where the user is typing -- which is only true if
// the widget places it from `edit.shown_caret` rather than from the editor's own caret.
#[test]
fn the_caret_is_drawn_inside_the_composition() {
    val w = controls.entry_widget(composing_field(), controls.default_style(), metrics())
    val l = widget.layout(w, note_box, metrics())
    // Every character is 10 wide under these metrics, so a caret 5 characters in sits at 50 plus
    // the field's left padding.
    test.assert_eq(box_named(l, caret_name).x, 50.0 + controls.default_style().padding.left)
}

// **The run being converted is drawn apart from the rest of the composition**, because the two
// say different things: one is "not committed yet" and the other is "this is what your next
// keystroke changes".
#[test]
fn the_converting_run_is_drawn_apart_from_the_composition() {
    val marked = controls.entry_composing_marked(
        controls.entry_of("note", "Note", "ab"),
        "かんじ",
        3,
        1,
        3
    ).entry
    val l = widget.layout(
        controls.entry_widget(marked, controls.default_style(), metrics()),
        note_box,
        metrics()
    )
    // Two points at 10 per character: the composition starts at 2 and the converted run at 3.
    test.assert_eq(box_named(l, "composing").x, 20.0 + controls.default_style().padding.left)
    test.assert_eq(box_named(l, "converting").x, 30.0 + controls.default_style().padding.left)
    test.assert_eq(box_named(l, "converting").width, 20.0)
}

// A field with no composition draws neither, which is the case every other test in this file is.
#[test]
fn a_field_with_no_composition_draws_no_tint() {
    val l = widget.layout(
        controls.entry_widget(controls.entry_of("note", "Note", "ab"), controls.default_style(), metrics()),
        note_box,
        metrics()
    )
    test.assert_eq(box_named(l, "composing").height, 0.0 - 1.0)
    test.assert_eq(box_named(l, "converting").height, 0.0 - 1.0)
}

// **A password being typed through an input method is still a password.** The composition is
// spliced in so the caret arithmetic holds, and the whole of it is masked so none of it is
// legible -- which is the one combination where the two features meet.
#[test]
fn a_masked_field_masks_the_composition_too() {
    val secret_composing = controls.entry_composing(
        controls.password_of("pass", "Password", "ab"),
        "かんじ",
        3
    ).entry
    test.assert_eq(controls.shown_text(secret_composing), "•••••")
    test.assert_false(contains(controls.shown_text(secret_composing), "か"))
}

// ------------------------------------------------- the look and feel (2026-11-12)

// A style that asks for a shape rather than only a palette: what a second look and feel is.
fn edged_style() -> controls.Style {
    return with controls.default_style() {
        face_border: Option<widget.Border>.Some(widget.border_of(paint.black(), 2.0)),
        corner_radius: 5.0
    }
}

fn painted(w: widget.Widget) -> [scene.Op] {
    return widget.paint_ops(widget.layout(w, geom.rect_of(0.0, 0.0, 200.0, 40.0), metrics()), metrics())
}

// **Both of these recurse into a `Nested`, and the first versions did not -- which made the list
// test below assert on an empty set.** A list clips its rows, so the whole of it paints as one
// `Nested` group and a counter that walked only the top level saw no fills, no strokes, and
// happily agreed that there was no border. The failing half of that test is the only reason it was
// noticed: `strokes(ops) == 0` had passed for the wrong reason.
fn strokes(ops: [scene.Op]) -> int {
    var n = 0
    for op in ops {
        if StrokePath(_) = op {
            n = n + 1
        }
        if Nested(it) = op {
            n = n + strokes(it.ops)
        }
    }
    return n
}

fn curved_fills(ops: [scene.Op]) -> int {
    var n = 0
    for op in ops {
        if Fill(it) = op {
            for segment in it.path.segments {
                if CubicTo(_) = segment {
                    n = n + 1
                    break
                }
            }
        }
        if Nested(group) = op {
            n = n + curved_fills(group.ops)
        }
    }
    return n
}

fn square_fills(ops: [scene.Op]) -> int {
    var n = 0
    for op in ops {
        if Fill(it) = op {
            var curved = false
            for segment in it.path.segments {
                if CubicTo(_) = segment {
                    curved = true
                }
            }
            if !curved {
                n = n + 1
            }
        }
        if Nested(group) = op {
            n = n + square_fills(group.ops)
        }
    }
    return n
}

// **The default look did not change when the box widened**, which is the property that let this
// ship without re-blessing a single pixel: `default_style` leaves the border absent and the radius
// at zero, so a button paints exactly the one square fill it always did.
#[test]
fn the_default_style_paints_no_border_and_no_curve() {
    val ops = painted(controls.button_widget(controls.button_of("save", "Save"), controls.default_style()))
    test.assert_eq(strokes(ops), 0)
    test.assert_eq(curved_fills(ops), 0)
}

// And a style that asks reaches the control -- which is the whole point of the widening, and the
// thing no amount of palette swapping could do before it.
#[test]
fn an_edged_style_reaches_a_button() {
    val ops = painted(controls.button_widget(controls.button_of("save", "Save"), edged_style()))
    test.assert_eq(strokes(ops), 1)
    test.assert_eq(curved_fills(ops), 1)
}

// Every control with a face goes through one helper, so a look and feel reaches all of them rather
// than whichever ones someone remembered. **A control that painted its own fill is the one that
// stays flat when the theme changes**, and that bug looks like one widget out of fifteen being
// wrong.
#[test]
fn an_edged_style_reaches_every_control_that_has_a_face() {
    val style = edged_style()
    test.assert_eq(strokes(painted(controls.entry_widget(controls.entry_of("u", "URL", ""), style, metrics()))), 1)
    test.assert_eq(
        strokes(painted(controls.check_box_widget(
            controls.check_box_of("n", "Notify", widget.Toggle.Off),
            style,
            metrics()
        ))),
        1
    )
    test.assert_eq(strokes(painted(controls.menu_title_widget(controls.menu_of("m", "File", []), style))), 1)
}

// **A list's selected row is rounded but never edged.** A border round each row of a list is a box
// inside a box, and over twenty rows it reads as a table rather than as a selection -- where the
// rounded pill is what a modern look and feel actually draws. The two share the radius and part
// company over the border, which is why `highlight_of` exists beside `face_of`.
#[test]
fn a_selected_row_takes_the_radius_but_not_the_border() {
    val list = with controls.list_of("rows", "Rows", ["one", "two", "three"]) { selected: 1 }
    val ops = painted(controls.list_widget(list, edged_style()))
    test.assert_eq(strokes(ops), 0)
    test.assert(curved_fills(ops) > 0)
}

// **The scrim is never rounded and never edged, whatever the style says.** It covers the whole
// window, so a radius would round the corners of the screen and a border would draw a frame round
// the display -- and both would look like a bug rather than a theme.
#[test]
fn the_scrim_ignores_the_look_and_feel() {
    val layer = controls.dialog_layer("d", "Delete?", widget.flex(), edged_style())
    val ops = widget.paint_ops(
        widget.layout(layer.content, geom.rect_of(0.0, 0.0, 200.0, 120.0), metrics()),
        metrics()
    )
    // The scrim is the first thing painted, behind the panel: square, whatever the style asked.
    test.assert(square_fills(ops) > 0)
}

// The x of the first text in a laid tree, which is where a label actually ended up.
fn text_x(l: widget.Laid) -> float {
    if Text(_) = l.widget {
        return l.bounds.x
    }
    for child in l.children {
        val found = text_x(child)
        if found >= 0.0 {
            return found
        }
    }
    return 0.0 - 1.0
}

// **A button given more room than its text centres its label**, which it did not do before
// alignment existed: it sat against the left padding, and had since F271. Unseen because every
// button in the only application on this layer shrink-wraps -- `curly gui` puts `widget.expand`
// on the field beside them -- so the spare room that shows the bug is zero.
#[test]
fn a_stretched_button_centres_its_label() {
    val button = controls.button_widget(controls.button_of("send", "Send"), controls.default_style())
    val laid = widget.layout(button, geom.rect_of(0.0, 0.0, 200.0, 30.0), metrics())
    val at = text_x(laid)
    // "Send" is 4 characters at 10 points each under these metrics, so 40 wide in 200: 80 each side.
    test.assert_eq(at, 80.0)
}

// And a button that is only as wide as its text is unchanged, which is what kept every existing
// window looking the same: the spare room is zero, so every alignment comes to the same place.
#[test]
fn a_shrink_wrapped_button_is_where_it_always_was() {
    val row = widget.row_of(0.0, [
        controls.button_widget(controls.button_of("send", "Send"), controls.default_style()),
        widget.flex()
    ])
    val laid = widget.layout(row, geom.rect_of(0.0, 0.0, 200.0, 30.0), metrics())
    test.assert_eq(text_x(laid), 8.0)
}

// The first filled box in a laid tree -- a control's own face, which is what a look and feel
// draws and therefore what has to be the right shape.
fn face_box(l: widget.Laid) -> geom.Rect {
    if Group(it) = l.widget {
        switch it.surface.fill {
            Some(_) { return l.bounds }
            None { unit }
        }
    }
    for child in l.children {
        val found = face_box(child)
        if found.width > 0.0 {
            return found
        }
    }
    return geom.rect_of(0.0, 0.0, 0.0, 0.0)
}

fn a_check_box() -> controls.CheckBox {
    return controls.check_box_of("tls", "Verify TLS", widget.Toggle.On)
}

// **A check box is square**, which it was not: the mark box used to be a stack holding one glyph,
// so it measured one advance wide and one line tall -- 9x22 at the default style. A flat grey
// rectangle hid it; F286's rounded theme drew it as a capsule.
#[test]
fn a_check_box_is_square() {
    val laid = widget.layout(
        controls.check_box_widget(a_check_box(), controls.default_style(), metrics()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    val face = face_box(laid)
    test.assert_eq(face.width, face.height)
}

// **And it is one line square**, which is the side that needs no guess: the mark's own line box is
// a full line tall, and the painter puts a glyph's baseline a line below its box's top -- so any
// smaller square hangs the mark out of the bottom. It also makes the box exactly as tall as the
// label beside it.
#[test]
fn a_check_box_is_one_line_square() {
    val m = metrics()
    val height = m.line_height
    val laid = widget.layout(
        controls.check_box_widget(a_check_box(), controls.default_style(), metrics()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        m
    )
    test.assert_eq(face_box(laid).height, height(controls.default_style().text_size))
}

// **A row taller than the control does not stretch the square**, which is the whole reason the
// outer stack asks for `Across.Centre`: a stretched row hands every child its full height, and a
// square that grows with its container is not a square. Laid out in a box twice as tall, so a
// stretch would be visible.
#[test]
fn a_tall_row_leaves_the_check_box_square() {
    val laid = widget.layout(
        controls.check_box_widget(a_check_box(), controls.default_style(), metrics()),
        geom.rect_of(0.0, 0.0, 200.0, 80.0),
        metrics()
    )
    val face = face_box(laid)
    test.assert_eq(face.width, face.height)
}

// The x a rounded box's path starts at is `bounds.x + radius` -- `round_rect_path` moves to the
// end of the top-left arc -- so the radius a control actually used is readable from what it drew.
fn first_fill_radius(ops: [scene.Op], left: float) -> float {
    for op in ops {
        if Fill(it) = op {
            for segment in it.path.segments {
                if MoveTo(at) = segment {
                    return at.x - left
                }
            }
        }
        if Nested(group) = op {
            val found = first_fill_radius(group.ops, left)
            if found >= 0.0 {
                return found
            }
        }
    }
    return 0.0 - 1.0
}

// **A theme's radius is chosen for a button, and a check box is a sixth of its width.** At
// `corner_radius: 6` a 16-point square comes out nearly circular, so the check box caps its own
// corners at a quarter of its side. Read back off the path it drew.
#[test]
fn a_check_box_caps_the_radius_its_size_cannot_carry() {
    val m = metrics()
    val height = m.line_height
    val side = height(controls.default_style().text_size)
    // A radius the square cannot carry: 10 against a side of 24, where the cap is 6.
    val asking = with edged_style() { corner_radius: 10.0 }
    val laid = widget.layout(
        controls.check_box_widget(a_check_box(), asking, metrics()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    val face = face_box(laid)
    val ops = widget.paint_ops(laid, metrics())
    test.assert_eq(face.width, side)
    test.assert_eq(first_fill_radius(ops, face.x), side * 0.25)
}

// And a control big enough keeps what the theme asked for, which is what makes the cap a cap
// rather than a different radius.
#[test]
fn a_button_keeps_the_radius_the_theme_asked_for() {
    val laid = widget.layout(
        controls.button_widget(controls.button_of("save", "Save"), edged_style()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    val ops = widget.paint_ops(laid, metrics())
    test.assert_eq(first_fill_radius(ops, 0.0), 5.0)
}

// **And a radius the square can carry is kept**, which is what makes this a cap rather than a
// different radius for check boxes. Without this, "always use the cap" passes every other test.
#[test]
fn a_check_box_keeps_a_radius_that_fits() {
    val asking = with edged_style() { corner_radius: 2.0 }
    val laid = widget.layout(
        controls.check_box_widget(a_check_box(), asking, metrics()),
        geom.rect_of(0.0, 0.0, 200.0, 40.0),
        metrics()
    )
    val ops = widget.paint_ops(laid, metrics())
    test.assert_eq(first_fill_radius(ops, face_box(laid).x), 2.0)
}
