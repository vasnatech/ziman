// Unit tests for `xml`.
//
// The security cases are the point of this file, not an afterthought at the end of it. An XML
// reader is the classic place where a parser written to be helpful becomes a way to read
// /etc/passwd or to turn a kilobyte of input into gigabytes of memory, and `xml` answers both by
// not having a DTD at all rather than by defaulting a flag to off. `doctype_is_refused` and
// `billion_laughs_cannot_even_be_expressed` are what hold that line: if someone ever adds entity
// support "just for internal entities", these fail.
//
// The round-trip tests are the other half. A tree that cannot be written back as the text it was
// read from is a one-way street, and mixed content and CDATA are exactly where that breaks.

use test
use xml

fn parse(s: string) -> xml.Document {
    return test.assert_ok(xml.parse(s))
}

fn round_trip(s: string) -> string {
    return test.assert_ok(xml.format(parse(s)))
}

// `xml.format` always writes a declaration and a trailing newline, so a fragment written
// without one comes back with one. This is what the input would have had to be to come back
// unchanged.
fn with_declaration(s: string) -> string {
    return concat("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n", s, "\n")
}

// ------------------------------------------------------------------ the shape of a document

#[test]
fn a_simple_document_parses() {
    val doc = parse("<note><to>Ann</to><from>Ben</from></note>")
    test.assert_eq("note", doc.root.name.local)
    test.assert_len(2, xml.children(doc.root))
    test.assert_eq("Ann", xml.text_of(test.assert_some(xml.child(doc.root, "to"))))
}

#[test]
fn mixed_content_keeps_its_order() {
    // The reason this module does not parse into a `Json` tree: text and elements interleave,
    // and the order between them is the content.
    val doc = parse("<p>Take <b>2</b> tablets <i>daily</i>.</p>")
    test.assert_len(5, doc.root.children)
    test.assert_eq("Take 2 tablets daily.", xml.text_of(doc.root))
    val text = "<p>Take <b>2</b> tablets <i>daily</i>.</p>"
    test.assert_eq(with_declaration(text), round_trip(text))
}

#[test]
fn attributes_keep_their_order_and_are_not_children() {
    val doc = parse("<dose value=\"2\" unit=\"tablet\"/>")
    test.assert_len(2, doc.root.attributes)
    test.assert_eq("value", doc.root.attributes[0].name.local)
    test.assert_eq("unit", doc.root.attributes[1].name.local)
    test.assert_empty(doc.root.children)
    test.assert_eq("2", test.assert_some(xml.attr(doc.root, "value")))
    test.assert_eq("mg", xml.attr_or(doc.root, "missing", "mg"))
}

#[test]
fn an_attribute_cannot_appear_twice() {
    test.assert_err(xml.parse("<a x=\"1\" x=\"2\"/>"))
}

#[test]
fn an_empty_element_round_trips_as_self_closing() {
    test.assert_eq("<a/>", test.assert_ok(xml.format(xml.empty("a"))))
    test.assert_eq("<a/>", test.assert_ok(xml.format(parse("<a></a>").root)))
}

// ------------------------------------------------------------------ no DTD, and what that buys

#[test]
fn doctype_is_refused() {
    // Not "external entities are disabled" -- there is no DTD at all, so there is no flag to
    // turn off and no default for a later change to get wrong.
    val e = test.assert_err(xml.parse("<!DOCTYPE note><note/>"))
    test.assert_contains(e, "DOCTYPE")
}

#[test]
fn billion_laughs_cannot_even_be_expressed() {
    // Without the DOCTYPE there is nowhere to declare `&lol1;`, so the attack needs a feature
    // that does not exist. Both halves fail: the declaration, and the reference on its own.
    val bomb = concat(
        "<?xml version=\"1.0\"?>",
        "<!DOCTYPE lolz [",
        "  <!ENTITY lol \"lol\">",
        "  <!ENTITY lol1 \"&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;\">",
        "  <!ENTITY lol2 \"&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;\">",
        "]>",
        "<lolz>&lol2;</lolz>"
    )
    test.assert_err(xml.parse(bomb))
    test.assert_err(xml.parse("<lolz>&lol2;</lolz>"))
}

#[test]
fn an_external_entity_has_nowhere_to_be_declared() {
    val xxe = concat(
        "<!DOCTYPE foo [<!ENTITY xxe SYSTEM \"file:///etc/passwd\">]>",
        "<foo>&xxe;</foo>"
    )
    test.assert_err(xml.parse(xxe))
    // And the reference alone names the reason rather than silently leaving the text in place.
    val e = test.assert_err(xml.parse("<foo>&xxe;</foo>"))
    test.assert_contains(e, "undefined entity")
}

#[test]
fn the_five_predefined_entities_and_numeric_references_still_work() {
    val doc = parse("<a>&lt;&gt;&amp;&quot;&apos; &#65;&#x42;</a>")
    test.assert_eq("<>&\"' AB", xml.text_of(doc.root))
}

#[test]
fn a_character_reference_to_something_unrepresentable_is_refused() {
    test.assert_err(xml.parse("<a>&#0;</a>"))        // NUL: XML 1.0 has no escape for it
    test.assert_err(xml.parse("<a>&#xD800;</a>"))    // a surrogate is not a character
    test.assert_err(xml.parse("<a>&#x110000;</a>"))  // past the last code point
}

// ------------------------------------------------------------------ the other limits

#[test]
fn nesting_deeper_than_the_limit_is_refused() {
    // A byte cap would not catch this: the input below is small and fifty levels deep.
    var deep = ""
    var i = 0
    while i < 60 {
        deep = concat(deep, "<a>")
        i = i + 1
    }
    i = 0
    while i < 60 {
        deep = concat(deep, "</a>")
        i = i + 1
    }
    test.assert_ok(xml.parse(deep))
    val shallow = xml.XmlLimits { max_bytes: 1048576, max_depth: 10, max_attributes: 64 }
    val e = test.assert_err(xml.parse(deep, shallow))
    test.assert_contains(e, "deeper than 10")
}

#[test]
fn a_document_over_the_byte_limit_is_refused_before_parsing() {
    val small = xml.XmlLimits { max_bytes: 16, max_depth: 512, max_attributes: 64 }
    val e = test.assert_err(xml.parse("<note><to>Ann</to></note>", small))
    test.assert_contains(e, "over the 16-byte limit")
    test.assert_ok(xml.parse("<a/>", small))
}

#[test]
fn too_many_attributes_on_one_element_is_refused() {
    val few = xml.XmlLimits { max_bytes: 1048576, max_depth: 512, max_attributes: 3 }
    test.assert_ok(xml.parse("<a x=\"1\" y=\"2\" z=\"3\"/>", few))
    test.assert_err(xml.parse("<a x=\"1\" y=\"2\" z=\"3\" w=\"4\"/>", few))
}

// ------------------------------------------------------------------ namespaces

#[test]
fn a_default_namespace_covers_elements() {
    val doc = parse("<root xmlns=\"urn:hl7-org:v3\"><section/></root>")
    test.assert_eq("urn:hl7-org:v3", test.assert_some(doc.root.name.namespace))
    val section = test.assert_some(xml.child(doc.root, "section"))
    test.assert_eq("urn:hl7-org:v3", test.assert_some(section.name.namespace))
}

#[test]
fn a_default_namespace_does_not_cover_attributes() {
    // The namespace rule people get wrong most often, and the reason `attr` looks for a name in
    // no namespace rather than in the element's.
    val doc = parse("<root xmlns=\"urn:hl7-org:v3\" code=\"x\"/>")
    var found = false
    for a in doc.root.attributes {
        if a.name.local == "code" {
            test.assert_none(a.name.namespace)
            found = true
        }
    }
    test.assert(found)
    test.assert_eq("x", test.assert_some(xml.attr(doc.root, "code")))
}

#[test]
fn a_prefix_resolves_to_its_uri_and_the_prefix_itself_does_not_matter() {
    val a = parse("<p:root xmlns:p=\"urn:x\"><p:kid/></p:root>")
    val b = parse("<q:root xmlns:q=\"urn:x\"><q:kid/></q:root>")
    test.assert(xml.same_name(a.root.name, b.root.name))
    test.assert_eq("urn:x", test.assert_some(a.root.name.namespace))
    test.assert_eq("p", test.assert_some(a.root.name.prefix))
    test.assert_eq("q", test.assert_some(b.root.name.prefix))
}

#[test]
fn an_undeclared_prefix_is_refused() {
    val e = test.assert_err(xml.parse("<p:root/>"))
    test.assert_contains(e, "undeclared namespace prefix 'p'")
}

#[test]
fn an_inner_declaration_applies_only_inside() {
    val doc = parse("<root xmlns=\"urn:a\"><kid xmlns=\"urn:b\"><grandkid/></kid><other/></root>")
    val kid = test.assert_some(xml.child(doc.root, "kid"))
    val other = test.assert_some(xml.child(doc.root, "other"))
    test.assert_eq("urn:b", test.assert_some(kid.name.namespace))
    test.assert_eq("urn:b", test.assert_some(test.assert_some(xml.child(kid, "grandkid")).name.namespace))
    test.assert_eq("urn:a", test.assert_some(other.name.namespace))
}

#[test]
fn xmlns_declarations_survive_a_round_trip() {
    val text = "<root xmlns=\"urn:a\" xmlns:p=\"urn:b\"><p:kid/></root>"
    test.assert_eq(with_declaration(text), round_trip(text))
}

// ------------------------------------------------------------------ find

#[test]
fn find_walks_child_steps() {
    val doc = parse(concat(
        "<record><component><section><entry id=\"1\"/><entry id=\"2\"/></section>",
        "<section><entry id=\"3\"/></section></component></record>"
    ))
    val entries = xml.find(doc.root, "component/section/entry")
    test.assert_len(3, entries)
    test.assert_eq("1", test.assert_some(xml.attr(entries[0], "id")))
    test.assert_eq("3", test.assert_some(xml.attr(entries[2], "id")))
    test.assert_eq(
        "1",
        test.assert_some(xml.attr(test.assert_some(xml.find_first(doc.root, "component/section/entry")), "id"))
    )
}

#[test]
fn find_ignores_namespaces_but_find_ns_does_not() {
    val doc = parse("<root xmlns=\"urn:a\"><kid/><other xmlns=\"urn:b\"><kid/></other></root>")
    test.assert_len(1, xml.find(doc.root, "kid"))
    test.assert_len(1, xml.find_ns(doc.root, "urn:a", "kid"))
    test.assert_empty(xml.find_ns(doc.root, "urn:b", "kid"))
    test.assert_len(1, xml.find_ns(doc.root, "urn:b", "other/kid"))
}

#[test]
fn a_star_step_matches_any_element() {
    val doc = parse("<r><a><x/></a><b><x/></b></r>")
    test.assert_len(2, xml.find(doc.root, "*/x"))
}

#[test]
fn a_path_that_matches_nothing_is_empty_rather_than_an_error() {
    val doc = parse("<r><a/></r>")
    test.assert_empty(xml.find(doc.root, "nope/at/all"))
    test.assert_none(xml.find_first(doc.root, "nope"))
    test.assert_len(1, xml.find(doc.root, ""))
}

// ------------------------------------------------------------------ CDATA, comments, PIs

#[test]
fn cdata_stays_cdata_so_the_document_round_trips() {
    val text = "<a><![CDATA[<not markup> & co]]></a>"
    test.assert_eq(with_declaration(text), round_trip(text))
    test.assert_eq("<not markup> & co", xml.text_of(parse(text).root))
}

#[test]
fn comments_and_processing_instructions_round_trip() {
    val text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!--before-->\n<a><?target some data?><!--inside--></a>\n"
    test.assert_eq(text, round_trip(text))
}

#[test]
fn malformed_comments_and_cdata_are_refused() {
    test.assert_err(xml.parse("<a><!-- no -- double dashes --></a>"))
    test.assert_err(xml.parse("<a><!-- never closed </a>"))
    test.assert_err(xml.parse("<a><![CDATA[never closed</a>"))
    test.assert_err(xml.parse("<a>]]> bare</a>"))
}

// ------------------------------------------------------------------ what XML cannot carry

#[test]
fn a_control_character_is_refused_on_the_way_in() {
    // NUL never reaches this module: `bytes_to_string` refuses it, so a Ziman `string` cannot
    // hold one in the first place. The other C0 controls can, and are refused here.
    test.assert_err(bytes_to_string([0 as byte]))
    test.assert_err(xml.parse(concat("<a>x", str_of_byte(7), "y</a>")))
    test.assert_err(xml.parse(concat("<a>x", str_of_byte(27), "y</a>")))
    test.assert_err(xml.parse(concat("<a note=\"x", str_of_byte(7), "\"/>")))
    // tab, newline and return are the three that are legal
    test.assert_ok(xml.parse("<a>x\ty\nz\rw</a>"))
}

#[test]
fn a_control_character_is_refused_on_the_way_out() {
    // The asymmetry with `json.format`, which is infallible: JSON can write `\u0000` and XML
    // has nothing at all to write, so the only honest answer is to refuse.
    val bad = xml.document(xml.text_element("note", concat("before", str_of_byte(7), "after")))
    val e = test.assert_err(xml.format(bad))
    test.assert_contains(e, "cannot represent")
}

#[test]
fn an_illegal_name_is_refused_on_the_way_out() {
    test.assert_err(xml.format(xml.empty("2bad")))
    test.assert_err(xml.format(xml.empty("has space")))
    test.assert_err(xml.format(xml.empty("")))
    test.assert_ok(xml.format(xml.empty("_ok-1.2")))
}

#[test]
fn a_newline_in_an_attribute_survives_as_a_character_reference() {
    // Written raw it would come back as a space: a reader normalises whitespace in attribute
    // values. This is the one place where escaping more than the minimum is load-bearing.
    val e = xml.element(xml.name("a"), [xml.attribute("note", "two\nlines")], [])
    val text = test.assert_ok(xml.format(e))
    test.assert_contains(text, "&#10;")
    val back = parse(concat(text))
    test.assert_eq("two\nlines", test.assert_some(xml.attr(back.root, "note")))
}

// ------------------------------------------------------------------ building a record

#[test]
fn optional_fields_are_left_out_rather_than_written_empty() {
    // The shape almost every exported field has: present ones appear, absent ones leave no
    // trace, and a required one stands in the same list without being wrapped by hand.
    val e = xml.element(xml.name("patient"), [], filter_present<xml.Node>(
        xml.req_element("id", "7"),
        xml.opt_element("firstName", Option<string>.Some("Ann")),
        xml.opt_element("gender", Option<string>.None),
        xml.opt_element("notes", Option<string>.Some("rest & fluids"))
    ))
    test.assert_eq(
        "<patient><id>7</id><firstName>Ann</firstName><notes>rest &amp; fluids</notes></patient>",
        test.assert_ok(xml.format(e))
    )
}

#[test]
fn an_element_whose_fields_are_all_absent_is_empty() {
    val e = xml.element(xml.name("patient"), [], filter_present<xml.Node>(
        xml.opt_element("firstName", Option<string>.None),
        xml.opt_element("gender", Option<string>.None)
    ))
    test.assert_eq("<patient/>", test.assert_ok(xml.format(e)))
}

#[test]
fn an_optional_field_that_is_present_but_empty_is_still_written() {
    // Absent and empty are different things, and an exporter that confuses them loses the
    // difference between "no allergies recorded" and "allergies: none": the empty one is
    // written as an element, the absent one leaves nothing behind.
    val empty = xml.element(xml.name("a"), [], filter_present<xml.Node>(
        xml.opt_element("note", Option<string>.Some(""))
    ))
    val absent = xml.element(xml.name("a"), [], filter_present<xml.Node>(
        xml.opt_element("note", Option<string>.None)
    ))
    test.assert_eq("<a><note/></a>", test.assert_ok(xml.format(empty)))
    test.assert_eq("<a/>", test.assert_ok(xml.format(absent)))
}

#[test]
fn a_built_tree_equals_the_same_tree_parsed_back() {
    // `text_element(x, "")` used to hold an empty `Text` child that reading `<x></x>` never
    // produces, so the two were unequal for the same document.
    val built = xml.document(xml.element(xml.name("r"), [], filter_present<xml.Node>(
        xml.req_element("full", "text"),
        xml.req_element("empty", "")
    )))
    val text = test.assert_ok(xml.format(built))
    val parsed = test.assert_ok(xml.parse(text))
    test.assert_eq("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<r><full>text</full><empty/></r>\n", text)
    test.assert(built.root == parsed.root)
}

// ------------------------------------------------------------------ the declaration

#[test]
fn a_document_with_no_declaration_gets_one_when_written() {
    val out = test.assert_ok(xml.format(xml.document(xml.empty("a"))))
    test.assert_eq("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<a/>\n", out)
}

#[test]
fn a_non_utf8_encoding_is_refused_rather_than_guessed() {
    val e = test.assert_err(xml.parse("<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?><a/>"))
    test.assert_contains(e, "ISO-8859-1")
}

#[test]
fn a_later_xml_version_is_refused() {
    test.assert_err(xml.parse("<?xml version=\"1.1\"?><a/>"))
}

#[test]
fn standalone_round_trips() {
    val text = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n<a/>\n"
    test.assert_eq(text, round_trip(text))
}

// ------------------------------------------------------------------ malformed documents

#[test]
fn mismatched_and_unclosed_tags_are_refused() {
    val e = test.assert_err(xml.parse("<a></b>"))
    test.assert_contains(e, "</b> closes <a>")
    test.assert_err(xml.parse("<a>"))
    test.assert_err(xml.parse("</a>"))
    test.assert_err(xml.parse("<a><b></a></b>"))
}

#[test]
fn a_document_must_have_exactly_one_root() {
    test.assert_err(xml.parse(""))
    test.assert_err(xml.parse("   "))
    test.assert_err(xml.parse("<a/><b/>"))
    test.assert_err(xml.parse("text before <a/>"))
    test.assert_err(xml.parse("<a/> text after"))
    test.assert_ok(xml.parse("  <a/>  "))
}

#[test]
fn broken_tags_are_refused() {
    test.assert_err(xml.parse("<a x/>"))
    test.assert_err(xml.parse("<a x=1/>"))
    test.assert_err(xml.parse("<a x=\"unterminated/>"))
    test.assert_err(xml.parse("<a x=\"<\"/>"))
    test.assert_err(xml.parse("<>"))
}

// ------------------------------------------------------------------ writing

#[test]
fn pretty_printing_indents_elements() {
    val doc = parse("<r><a><b/></a><c/></r>")
    val out = test.assert_ok(xml.format(doc, "  "))
    test.assert_contains(out, "\n  <a>")
    test.assert_contains(out, "\n    <b/>")
    test.assert_contains(out, "\n  <c/>")
}

#[test]
fn pretty_printing_never_touches_mixed_content() {
    // Indenting inside `<p>Take <b>2</b></p>` would change the text the document carries, so an
    // element holding any text at all stays on one line however deep it sits -- and its text is
    // the same text after a read back.
    val doc = parse("<r><p>Take <b>2</b> daily</p></r>")
    val out = test.assert_ok(xml.format(doc, "  "))
    test.assert_contains(out, "<p>Take <b>2</b> daily</p>")
    val back = test.assert_ok(xml.parse(out))
    test.assert_eq("Take 2 daily", xml.text_of(test.assert_some(xml.child(back.root, "p"))))
}

#[test]
fn pretty_printing_is_not_round_trip_safe_and_that_is_inherent() {
    // The indentation between elements is itself text, and nothing in XML says whether it
    // matters -- only a schema the parser does not have could say. So `xml.format` is the
    // one to use when the bytes must come back the same, and `xml.format` is for a
    // human reading the output. Pinned here so the difference is a decision, not a surprise.
    val doc = parse("<r><a/></r>")
    val compact = test.assert_ok(xml.format(doc))
    val pretty = test.assert_ok(xml.format(doc, "  "))
    test.assert(compact != pretty)
    test.assert_eq("", xml.text_of(doc.root))
    test.assert(xml.text_of(test.assert_ok(xml.parse(pretty)).root) != "")
    // the compact form, by contrast, is a fixed point
    test.assert_eq(compact, test.assert_ok(xml.format(test.assert_ok(xml.parse(compact)))))
}

#[test]
fn a_parsed_document_writes_back_as_the_text_it_came_from() {
    val text = concat(
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n",
        "<record xmlns=\"urn:hl7-org:v3\" xmlns:x=\"urn:x\">",
        "<title>Notes &amp; results</title>",
        "<body>Take <em>2</em> &lt;tablets&gt;</body>",
        "<x:code value=\"a&quot;b\"/>",
        "<![CDATA[raw <stuff>]]>",
        "</record>\n"
    )
    test.assert_eq(text, round_trip(text))
    // and reading the written text again gives the same text a third time
    test.assert_eq(text, round_trip(round_trip(text)))
}

#[test]
fn bytes_in_and_bytes_out() {
    val doc = test.assert_ok(xml.parse(to_bytes("<a>héllo</a>")))
    test.assert_eq("héllo", xml.text_of(doc.root))
    val out = test.assert_ok(xml.xml_to_bytes(doc))
    test.assert_contains(test.assert_ok(bytes_to_string(out)), "héllo")
}

#[test]
fn invalid_utf8_bytes_are_refused() {
    val bad: [byte] = [60 as byte, 97 as byte, 62 as byte, 255 as byte, 60 as byte, 47 as byte, 97 as byte, 62 as byte]
    test.assert_err(xml.parse(bad))
}

#[test]
fn a_byte_order_mark_is_not_content() {
    val bom_bytes: [byte] = [239 as byte, 187 as byte, 191 as byte]
    val bom = test.assert_ok(bytes_to_string(bom_bytes))
    val doc = test.assert_ok(xml.parse(concat(bom, "<a>x</a>")))
    test.assert_eq("x", xml.text_of(doc.root))
}

#[test]
fn windows_line_endings_normalise() {
    val doc = parse("<a>one\r\ntwo\rthree</a>")
    test.assert_eq("one\ntwo\nthree", xml.text_of(doc.root))
}

// ------------------------------------------------------------------ the reserved namespace names

// "Namespaces in XML" fences off two prefixes and two namespace names with six separate MUST
// NOTs, and this parser enforced none of them: all six documents below parsed. A tree where
// `xmlns` is itself a namespace prefix, or where `xml:lang` has been rebound to something that
// is not the language namespace, is one nobody can mean.
#[test]
fn the_xmlns_prefix_cannot_be_declared() {
    test.assert_contains(
        test.assert_err(xml.parse("<a xmlns:xmlns=\"urn:x\"/>")),
        "must not be declared"
    )
    // and an *element* may not carry it either ("Element names MUST NOT have the prefix xmlns")
    test.assert_err(xml.parse("<xmlns:a xmlns:xmlns=\"urn:x\"/>"))
    // while an element simply *named* xmlns is unremarkable: only the prefix is reserved
    test.assert_ok(xml.parse("<xmlns/>"))
}

#[test]
fn the_declaration_namespace_cannot_be_declared() {
    // "Other prefixes MUST NOT be bound to this namespace name, and it MUST NOT be declared as
    // the default namespace."
    test.assert_err(xml.parse("<a xmlns=\"http://www.w3.org/2000/xmlns/\"/>"))
    test.assert_err(xml.parse("<a xmlns:p=\"http://www.w3.org/2000/xmlns/\"/>"))
}

#[test]
fn the_xml_prefix_stays_where_it_belongs() {
    // "MUST NOT be bound to any other namespace name"
    test.assert_err(xml.parse("<a xmlns:xml=\"urn:wrong\"/>"))
    // the same sentence for its namespace name: no other prefix, and not as the default
    test.assert_err(xml.parse("<a xmlns:p=\"http://www.w3.org/XML/1998/namespace\"/>"))
    test.assert_err(xml.parse("<a xmlns=\"http://www.w3.org/XML/1998/namespace\"/>"))
    // but it MAY be declared, to exactly that name -- and needs no declaration at all
    test.assert_ok(xml.parse("<a xmlns:xml=\"http://www.w3.org/XML/1998/namespace\"/>"))
    val doc = parse("<a xml:lang=\"en\"/>")
    test.assert_eq("en", test.assert_some(xml.attr_ns(doc.root, "http://www.w3.org/XML/1998/namespace", "lang")))
}

// A prefixed declaration's "attribute value MUST NOT be empty", while a default one "MAY be
// empty" -- so the two cases cannot share a check. Undeclaring a prefix is a Namespaces 1.1
// feature and this reader is 1.0.
#[test]
fn only_the_default_namespace_may_be_undeclared() {
    test.assert_err(xml.parse("<a xmlns:p=\"urn:x\"><b xmlns:p=\"\"/></a>"))
    val doc = parse("<a xmlns=\"urn:x\"><b xmlns=\"\"/></a>")
    val inner = test.assert_some(xml.child(doc.root, "b"))
    test.assert_none(inner.name.namespace)
    test.assert_eq("urn:x", test.assert_some(doc.root.name.namespace))
}

// "no element have two attributes with the same expanded name" -- which was caught, but the
// message named `q:id` as appearing twice when it appears once. The collision is between two
// differently *written* names, and that is the thing a reader cannot see for themselves.
#[test]
fn two_prefixes_one_namespace_is_one_attribute_twice() {
    val e = test.assert_err(xml.parse("<a xmlns:p=\"urn:x\" xmlns:q=\"urn:x\" p:id=\"1\" q:id=\"2\"/>"))
    test.assert_contains(e, "'p:id' and 'q:id'")
    test.assert_contains(e, "namespace 'urn:x'")
    // the same local name in two different namespaces is two attributes, and fine
    test.assert_ok(xml.parse("<a xmlns:p=\"urn:x\" xmlns:q=\"urn:y\" p:id=\"1\" q:id=\"2\"/>"))
    // and a plain repeat still reports as a plain repeat
    test.assert_contains(test.assert_err(xml.parse("<a id=\"1\" id=\"2\"/>")), "'id' appears twice")
}

// `Comment ::= '<!--' ((Char - '-') | ('-' (Char - '-')))* '-->'`, so the content cannot end with
// a dash. **The writer already refused this and the reader did not**, so `<!-- a --->` parsed into
// a tree that could not be written back -- which is the one thing a reader must never produce.
#[test]
fn a_comment_cannot_end_with_a_dash() {
    test.assert_err(xml.parse("<a><!-- a ---></a>"))
    test.assert_err(xml.parse("<a><!-- a -- b --></a>"))
    // the legal neighbours: a dash anywhere else, and an empty comment
    test.assert_contains(round_trip("<a><!-- -a- --></a>"), "<a><!-- -a- --></a>")
    test.assert_ok(xml.parse("<a><!----></a>"))
}

// Everything that parses must write back, which is the invariant the comment bug broke. Nothing
// here asserts a particular text -- only that the writer accepts what the reader produced.
#[test]
fn whatever_parses_can_be_written() {
    val documents = [
        "<a/>", "<a>x</a>", "<p>Take <b>2</b> tablets</p>", "<a><![CDATA[<raw> & ]]></a>",
        "<a><!-- note --><?pi data?></a>", "<a xmlns=\"urn:x\"><b/></a>",
        "<p:a xmlns:p=\"urn:x\"><p:b c=\"1\"/></p:a>", "<a id=\"x&#10;y\"/>",
        "<a>&lt;&gt;&amp;&quot;&apos;</a>", "<a>&#65;&#x41;</a>", "<a xml:lang=\"en\"/>",
        "<!-- top --><a/>", "<?xml version=\"1.0\" standalone=\"yes\"?><a/>"
    ]
    for text in documents {
        val doc = test.assert_ok(xml.parse(text))
        val written = test.assert_ok(xml.format(doc))
        // and the written form reads back to a tree that writes the same text
        test.assert_eq(written, test.assert_ok(xml.format(test.assert_ok(xml.parse(written)))))
    }
}

fn str_of_byte(b: int) -> string {
    val arr: [byte] = [b as byte]
    return unwrap(bytes_to_string(arr))
}
