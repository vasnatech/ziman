// `charset`: text and bytes across the encodings a program meets at a boundary.
//
// The cases below are the edges six modules had each half-handled before this module existed --
// the four-byte boundary, surrogate pairs, a lone surrogate, the CP1252 block that is the whole
// difference between WinAnsi and Latin-1.
use charset
use charset.bom
use charset.bom_text
use charset.replacement_text
use test

// **`Result` generates no `is_Err`, on purpose** -- `lib/prelude/result.zm` says so: an error you
// cannot name is an error you cannot act on, so the language makes you open it. These two exist
// only for the cases below that care *that* something was refused and not *why*.
fn refused_text(r: Result<string, charset.Refusal>) -> bool {
    return switch r {
        Ok(_) { false }
        Err(_) { true }
    }
}

fn refused_bytes(r: Result<[byte], charset.Refusal>) -> bool {
    return switch r {
        Ok(_) { false }
        Err(_) { true }
    }
}

// ---- code points

#[test]
fn the_ends_of_the_range_are_characters_and_past_them_is_not() {
    test.assert(charset.is_code_point(0))
    test.assert(charset.is_code_point(65))
    test.assert(charset.is_code_point(1114111))
    test.assert_false(charset.is_code_point(1114112))
    test.assert_false(charset.is_code_point(0 - 1))
}

// **A surrogate is not a code point**, which is the rule that keeps UTF-16 honest: D800..DFFF
// exist only as the halves of an encoded astral character, and one on its own is text no reader
// can agree on.
#[test]
fn a_surrogate_is_not_a_character() {
    test.assert_false(charset.is_code_point(55296))
    test.assert_false(charset.is_code_point(57343))
    // ...and the code points either side of the block are.
    test.assert(charset.is_code_point(55295))
    test.assert(charset.is_code_point(57344))
}

#[test]
fn a_surrogate_pair_and_its_character_agree_both_ways() {
    // U+1F600, the one every emoji bug is reported with.
    switch charset.surrogates(128512) {
        Some(pair) {
            test.assert_eq(pair[0], 55357)
            test.assert_eq(pair[1], 56832)
            switch charset.paired(pair[0], pair[1]) {
                Some(cp) { test.assert_eq(cp, 128512) }
                None { test.fail("the pair did not come back") }
            }
        }
        None { test.fail("no pair for an astral character") }
    }
    // The ends of the astral range round-trip too.
    for cp in [65536, 1114111] {
        switch charset.surrogates(cp) {
            Some(pair) {
                switch charset.paired(pair[0], pair[1]) {
                    Some(back) { test.assert_eq(back, cp) }
                    None { test.fail("the pair did not come back") }
                }
            }
            None { test.fail("no pair") }
        }
    }
}

// Inside the basic plane there is no pair: the character is written as itself, and saying so
// with `None` is what stops a caller encoding a two-unit sequence for a one-unit character.
#[test]
fn the_basic_plane_needs_no_pair() {
    test.assert(Option.is_None(charset.surrogates(65)))
    test.assert(Option.is_None(charset.surrogates(65535)))
    test.assert(Option.is_Some(charset.surrogates(65536)))
}

#[test]
fn two_halves_that_are_not_a_pair_are_refused() {
    test.assert(Option.is_None(charset.paired(65, 66)))
    // Two highs, or a low then a high: ordered pairs only.
    test.assert(Option.is_None(charset.paired(55357, 55357)))
    test.assert(Option.is_None(charset.paired(56832, 55357)))
}

// ---- UTF-8

fn utf8_or_fail(cp: int) -> string {
    return switch charset.utf8_text(cp) {
        Ok(s) { s }
        Err(r) {
            test.fail(charset.describe(r))
            ""
        }
    }
}

// One case per length, and both sides of every boundary: this is the arithmetic four modules
// wrote separately, and one of them had no four-byte branch at all.
#[test]
fn utf8_covers_every_length_and_its_boundaries() {
    test.assert_eq(utf8_or_fail(65), "A")
    // U+007F is DEL and has no literal to compare against -- ziman has no `\u` escape -- so the
    // top of the one-byte range is asserted on its bytes instead.
    switch charset.utf8_bytes(127) {
        Ok(b) {
            test.assert_len(1, b)
            test.assert_eq(b[0] as int, 127)
        }
        Err(r) { test.fail(charset.describe(r)) }
    }
    // U+0080 is a C1 control and has no literal either, so the bottom of the two-byte range is
    // asserted on its bytes: C2 80.
    switch charset.utf8_bytes(128) {
        Ok(b) {
            test.assert_len(2, b)
            test.assert_eq(b[0] as int, 194)
            test.assert_eq(b[1] as int, 128)
        }
        Err(r) { test.fail(charset.describe(r)) }
    }
    test.assert_eq(utf8_or_fail(233), "é")
    test.assert_eq(utf8_or_fail(2047), "߿")
    test.assert_eq(utf8_or_fail(2048), "ࠀ")
    test.assert_eq(utf8_or_fail(65535), "￿")
    test.assert_eq(utf8_or_fail(65536), "𐀀")
    test.assert_eq(utf8_or_fail(128512), "😀")
    test.assert_eq(utf8_or_fail(1114111), "􏿿")
}

#[test]
fn utf8_lengths_match_what_it_writes() {
    test.assert_eq(charset.utf8_length(65), 1)
    test.assert_eq(charset.utf8_length(233), 2)
    test.assert_eq(charset.utf8_length(20013), 3)
    test.assert_eq(charset.utf8_length(128512), 4)
    // Not a character, so there is no length to give.
    test.assert_eq(charset.utf8_length(55296), 0)
}

#[test]
fn utf8_refuses_what_is_not_a_character() {
    test.assert(refused_text(charset.utf8_text(55296)))
    test.assert(refused_text(charset.utf8_text(1114112)))
    test.assert(refused_bytes(charset.utf8_bytes(0 - 1)))
}

#[test]
fn a_character_and_its_code_point_agree() {
    for cp in [65, 233, 2047, 2048, 20013, 65536, 128512, 1114111] {
        test.assert_eq(charset.code_point_of(utf8_or_fail(cp)), cp)
    }
    test.assert_eq(charset.code_point_of(""), 0 - 1)
}

#[test]
fn a_string_becomes_its_code_points() {
    val points = charset.code_points_of("Aé😀")
    test.assert_len(3, points)
    test.assert_eq(points[0], 65)
    test.assert_eq(points[1], 233)
    test.assert_eq(points[2], 128512)
}

// ---- UTF-16

#[test]
fn utf16_gives_one_unit_inside_the_basic_plane_and_two_above_it() {
    switch charset.utf16_units(65) {
        Ok(units) { test.assert_len(1, units) }
        Err(r) { test.fail(charset.describe(r)) }
    }
    switch charset.utf16_units(128512) {
        Ok(units) {
            test.assert_len(2, units)
            test.assert_eq(units[0], 55357)
        }
        Err(r) { test.fail(charset.describe(r)) }
    }
}

// **Surrogate pairs are joined on the way back**, which is what the one caller of this before
// the module existed did not do: `truetype` read a font's name table and wrote a question mark
// per half, on the argument that a name outside the basic plane does not happen.
#[test]
fn utf16be_round_trips_including_astral_characters() {
    for text in ["", "A", "Aé中", "😀", "a😀b"] {
        val none: [byte] = []
        val bytes = switch charset.utf16be_bytes(text) {
            Ok(b) { b }
            Err(r) {
                test.fail(charset.describe(r))
                none
            }
        }
        switch charset.utf16be_text(bytes) {
            Ok(back) { test.assert_eq(back, text) }
            Err(r) { test.fail(charset.describe(r)) }
        }
    }
}

#[test]
fn utf16be_refuses_a_broken_stream() {
    // A high surrogate with nothing after it.
    test.assert(refused_text(charset.utf16be_text([216b, 61b])))
    // A low surrogate with nothing before it.
    test.assert(refused_text(charset.utf16be_text([222b, 0b])))
    // A high surrogate followed by something that is not a low one.
    test.assert(refused_text(charset.utf16be_text([216b, 61b, 0b, 65b])))
    // An odd number of bytes.
    test.assert(refused_text(charset.utf16be_text([0b, 65b, 0b])))
}

// ---- the single-byte sets

// Decoding Latin-1 cannot fail, which is the property that makes it the fallback every other
// single-byte set is compared against.
#[test]
fn latin1_reads_every_byte_and_writes_back_what_it_can() {
    switch charset.latin1_text([65b, 233b, 255b]) {
        Ok(text) { test.assert_eq(text, "Aéÿ") }
        Err(r) { test.fail(charset.describe(r)) }
    }
    switch charset.latin1_bytes("Aéÿ") {
        Ok(b) {
            test.assert_len(3, b)
            test.assert_eq(b[1] as int, 233)
        }
        Err(r) { test.fail(charset.describe(r)) }
    }
}

#[test]
fn latin1_refuses_what_it_has_no_byte_for() {
    switch charset.latin1_bytes("şeker") {
        Ok(_) { test.fail("Latin-1 has no s-cedilla") }
        Err(r) {
            test.assert_eq(r.charset, charset.Charset.Latin1)
            test.assert_eq(r.code_point, 351)
            // It says *where*, so a caller can point at the character.
            test.assert_eq(r.at, 0)
        }
    }
}

// **The 0x80 to 0x9F block is the whole difference between WinAnsi and Latin-1**, and it is why
// a PDF can write a curly quote and an en dash without embedding a font.
#[test]
fn win_ansi_carries_the_block_latin1_does_not() {
    test.assert_eq(charset.win_ansi_byte(8364), 128)
    test.assert_eq(charset.win_ansi_byte(8212), 151)
    test.assert_eq(charset.win_ansi_byte(8220), 147)
    switch charset.win_ansi_text([128b, 151b]) {
        Ok(text) { test.assert_eq(text, "€—") }
        Err(r) { test.fail(charset.describe(r)) }
    }
    switch charset.win_ansi_bytes("€—") {
        Ok(b) {
            test.assert_eq(b[0] as int, 128)
            test.assert_eq(b[1] as int, 151)
        }
        Err(r) { test.fail(charset.describe(r)) }
    }
}

#[test]
fn win_ansi_refuses_what_it_has_no_byte_for() {
    switch charset.win_ansi_bytes("aş") {
        Ok(_) { test.fail("WinAnsi has no s-cedilla") }
        Err(r) {
            test.assert_eq(r.charset, charset.Charset.WinAnsi)
            test.assert_eq(r.code_point, 351)
            test.assert_eq(r.at, 1)
        }
    }
}

// ---- what a refusal says

// **Generic, because the caller has the advice.** `pdf` adds "an embedded font is needed for
// this text"; this layer only knows which set refused which character.
#[test]
fn a_refusal_names_the_set_and_the_character() {
    switch charset.win_ansi_bytes("ş") {
        Ok(_) { test.fail("expected a refusal") }
        Err(r) { test.assert_eq(charset.describe(r), "WinAnsi cannot represent U+015F at 0") }
    }
}

#[test]
fn hex_is_four_digits_or_as_many_as_it_takes() {
    test.assert_eq(charset.hex_of(0), "0000")
    test.assert_eq(charset.hex_of(351), "015F")
    test.assert_eq(charset.hex_of(65535), "FFFF")
    test.assert_eq(charset.hex_of(128512), "1F600")
    test.assert_eq(charset.hex_of(1114111), "10FFFF")
}

// ---- reading UTF-8 back

#[test]
fn a_lead_byte_says_how_long_its_character_is() {
    test.assert_eq(charset.utf8_sequence_length(65b), 1)
    test.assert_eq(charset.utf8_sequence_length(195b), 2)
    test.assert_eq(charset.utf8_sequence_length(226b), 3)
    test.assert_eq(charset.utf8_sequence_length(240b), 4)
    // A continuation byte begins nothing, and neither do the five values above the lead range.
    test.assert_eq(charset.utf8_sequence_length(128b), 0)
    test.assert_eq(charset.utf8_sequence_length(191b), 0)
    test.assert_eq(charset.utf8_sequence_length(248b), 0)
    test.assert_eq(charset.utf8_sequence_length(255b), 0)
}

#[test]
fn utf8_round_trips_through_bytes() {
    for text in ["", "A", "Aé中😀", "a\tb\nc"] {
        switch charset.utf8_text(charset.utf8_bytes(text)) {
            Ok(back) { test.assert_eq(back, text) }
            Err(r) { test.fail(charset.describe(r)) }
        }
        test.assert(charset.is_utf8(charset.utf8_bytes(text)))
    }
}

// Each of these is a byte sequence a lenient decoder accepts and a correct one does not, and
// each has been a security advisory somewhere.
#[test]
fn utf8_refuses_every_way_of_being_not_quite_utf8() {
    // A continuation byte with no lead.
    test.assert_false(charset.is_utf8([128b]))
    // A lead byte with no continuation.
    test.assert_false(charset.is_utf8([195b]))
    // A lead byte followed by another lead byte.
    test.assert_false(charset.is_utf8([195b, 65b]))
    // **The overlong slash**: C0 AF is U+002F written in two bytes, which is how a `/` used to
    // get past a filter that was looking for the one-byte spelling.
    test.assert_false(charset.is_utf8([192b, 175b]))
    // An overlong NUL, the other half of that trick.
    test.assert_false(charset.is_utf8([192b, 128b]))
    // **A surrogate encoded in three bytes**: U+D800 as ED A0 80, which is CESU-8 and Java's
    // modified UTF-8, and is not UTF-8.
    test.assert_false(charset.is_utf8([237b, 160b, 128b]))
    // U+110000, one past the last code point, in four bytes.
    test.assert_false(charset.is_utf8([244b, 144b, 128b, 128b]))
    // A five-byte sequence, which UTF-8 has not had since 2003.
    test.assert_false(charset.is_utf8([248b, 136b, 128b, 128b, 128b]))
}

#[test]
fn a_refusal_from_bytes_says_where_and_why() {
    switch charset.utf8_text([65b, 66b, 192b, 175b]) {
        Ok(_) { test.fail("an overlong sequence was accepted") }
        Err(r) {
            test.assert_eq(r.charset, charset.Charset.Utf8)
            // Bytes rather than text, so there is no code point to name.
            test.assert_eq(r.code_point, 0 - 1)
            test.assert_eq(r.at, 2)
            test.assert_eq(
                charset.describe(r),
                "UTF-8: a character written in more bytes than it needs at 2"
            )
        }
    }
}

// ---- the other byte orders

#[test]
fn utf16_round_trips_in_both_orders_and_they_differ() {
    for text in ["", "A", "Aé中", "😀", "a😀b"] {
        val none: [byte] = []
        val le = switch charset.utf16le_bytes(text) {
            Ok(b) { b }
            Err(r) {
                test.fail(charset.describe(r))
                none
            }
        }
        switch charset.utf16le_text(le) {
            Ok(back) { test.assert_eq(back, text) }
            Err(r) { test.fail(charset.describe(r)) }
        }
    }
    // The same character, the two orders: 00 41 one way and 41 00 the other.
    switch charset.utf16be_bytes("A") {
        Ok(b) {
            test.assert_eq(b[0] as int, 0)
            test.assert_eq(b[1] as int, 65)
        }
        Err(r) { test.fail(charset.describe(r)) }
    }
    switch charset.utf16le_bytes("A") {
        Ok(b) {
            test.assert_eq(b[0] as int, 65)
            test.assert_eq(b[1] as int, 0)
        }
        Err(r) { test.fail(charset.describe(r)) }
    }
}

#[test]
fn utf32_round_trips_in_both_orders() {
    for text in ["", "A", "Aé中😀"] {
        switch charset.utf32be_text(charset.utf32be_bytes(text)) {
            Ok(back) { test.assert_eq(back, text) }
            Err(r) { test.fail(charset.describe(r)) }
        }
        switch charset.utf32le_text(charset.utf32le_bytes(text)) {
            Ok(back) { test.assert_eq(back, text) }
            Err(r) { test.fail(charset.describe(r)) }
        }
    }
    // Four bytes hold far more than there are characters, so this format is the one that can
    // carry a number which is not text at all.
    test.assert(refused_text(charset.utf32be_text([0b, 17b, 0b, 0b])))
    test.assert(refused_text(charset.utf32be_text([0b, 0b, 216b, 0b])))
    // A length that is not a multiple of four.
    test.assert(refused_text(charset.utf32be_text([0b, 0b, 0b])))
}

// ---- ASCII

#[test]
fn ascii_carries_the_plain_half_and_refuses_the_rest() {
    switch charset.ascii_bytes("GET /") {
        Ok(b) { test.assert_len(5, b) }
        Err(r) { test.fail(charset.describe(r)) }
    }
    switch charset.ascii_bytes("é") {
        Ok(_) { test.fail("ASCII has no e-acute") }
        Err(r) {
            test.assert_eq(r.charset, charset.Charset.Ascii)
            test.assert_eq(r.code_point, 233)
        }
    }
    switch charset.ascii_text([104b, 105b]) {
        Ok(s) { test.assert_eq(s, "hi") }
        Err(r) { test.fail(charset.describe(r)) }
    }
    // Unlike Latin-1, decoding can fail: a high byte is not an ASCII character.
    test.assert(refused_text(charset.ascii_text([104b, 233b])))
}

// ---- a set as a value

// **A refusal carries the set and not a spelling of it**, so the one place a name is written is
// `name_of` -- which is what this asserts alongside the value.
#[test]
fn a_refusal_carries_the_set_itself() {
    switch charset.ascii_bytes("é") {
        Ok(_) { test.fail("ASCII has no e-acute") }
        Err(r) {
            test.assert_eq(r.charset, charset.Charset.Ascii)
            test.assert_eq(charset.name_of(r.charset), "ASCII")
        }
    }
}

#[test]
fn a_name_finds_its_set_however_it_is_spelled() {
    for spelling in ["utf-8", "UTF8", "utf_8", "UTF-8", " utf.8 "] {
        switch charset.charset_named(spelling) {
            Some(e) { test.assert_eq(charset.name_of(e), "UTF-8") }
            None { test.fail(concat("no set for ", spelling)) }
        }
    }
    for spelling in ["cp1252", "windows-1252", "WinAnsiEncoding"] {
        switch charset.charset_named(spelling) {
            Some(e) { test.assert_eq(charset.name_of(e), "WinAnsi") }
            None { test.fail(concat("no set for ", spelling)) }
        }
    }
    switch charset.charset_named("iso-8859-1") {
        Some(e) { test.assert_eq(charset.name_of(e), "Latin-1") }
        None { test.fail("no set for iso-8859-1") }
    }
    // Bare UTF-16 is the little-endian order, which is what writes the files.
    switch charset.charset_named("UTF-16") {
        Some(e) { test.assert_eq(charset.name_of(e), "UTF-16LE") }
        None { test.fail("no set for UTF-16") }
    }
    test.assert(Option.is_None(charset.charset_named("Shift_JIS")))
    test.assert(Option.is_None(charset.charset_named("")))
}

#[test]
fn every_set_encodes_and_decodes_through_the_enum() {
    val sets = [
        charset.Charset.Utf8,
        charset.Charset.Utf16be,
        charset.Charset.Utf16le,
        charset.Charset.Utf32be,
        charset.Charset.Utf32le,
        charset.Charset.Latin1,
        charset.Charset.WinAnsi,
        charset.Charset.Ascii
    ]
    // Text every one of them can carry, so one loop covers them all.
    for e in sets {
        val none: [byte] = []
        val bytes = switch charset.encode("Hi!", e) {
            Ok(b) { b }
            Err(r) {
                test.fail(charset.describe(r))
                none
            }
        }
        switch charset.decode(bytes, e) {
            Ok(back) { test.assert_eq(back, "Hi!") }
            Err(r) { test.fail(charset.describe(r)) }
        }
    }
    // And the ones that cannot: ASCII has no e-acute, Latin-1 no euro.
    test.assert(refused_bytes(charset.encode("é", charset.Charset.Ascii)))
    test.assert(refused_bytes(charset.encode("€", charset.Charset.Latin1)))
    switch charset.encode("€", charset.Charset.WinAnsi) {
        Ok(b) { test.assert_eq(b[0] as int, 128) }
        Err(r) { test.fail(charset.describe(r)) }
    }
}

// **A mark is not text**: `encode` writes none and `decode` drops one, so neither direction
// leaves an invisible character in the string.
#[test]
fn a_mark_announces_the_set_and_is_not_part_of_the_text() {
    switch charset.sniff([239b, 187b, 191b, 65b]) {
        Some(e) { test.assert_eq(charset.name_of(e), "UTF-8") }
        None { test.fail("no set sniffed from a UTF-8 mark") }
    }
    switch charset.sniff([254b, 255b, 0b, 65b]) {
        Some(e) { test.assert_eq(charset.name_of(e), "UTF-16BE") }
        None { test.fail("no set sniffed from a UTF-16BE mark") }
    }
    // **UTF-32LE begins with UTF-16LE's mark**, so the order of the tests is what tells them
    // apart: FF FE 00 00 is UTF-32LE, FF FE is UTF-16LE.
    switch charset.sniff([255b, 254b, 0b, 0b]) {
        Some(e) { test.assert_eq(charset.name_of(e), "UTF-32LE") }
        None { test.fail("no set sniffed from a UTF-32LE mark") }
    }
    switch charset.sniff([255b, 254b, 65b, 0b]) {
        Some(e) { test.assert_eq(charset.name_of(e), "UTF-16LE") }
        None { test.fail("no set sniffed from a UTF-16LE mark") }
    }
    // Most files have no mark, which is not the same as not being text.
    test.assert(Option.is_None(charset.sniff([65b, 66b])))
    test.assert(Option.is_None(charset.sniff([])))

    // A single-byte set has no order and so no mark.
    test.assert_len(0, charset.mark_of(charset.Charset.Latin1))
    test.assert_len(3, charset.mark_of(charset.Charset.Utf8))

    // Encoding writes no mark...
    switch charset.encode("A", charset.Charset.Utf8) {
        Ok(b) { test.assert_len(1, b) }
        Err(r) { test.fail(charset.describe(r)) }
    }
    // ...and decoding drops one that is there.
    switch charset.decode([239b, 187b, 191b, 65b], charset.Charset.Utf8) {
        Ok(s) { test.assert_eq(s, "A") }
        Err(r) { test.fail(charset.describe(r)) }
    }
    switch charset.decode([254b, 255b, 0b, 65b], charset.Charset.Utf16be) {
        Ok(s) { test.assert_eq(s, "A") }
        Err(r) { test.fail(charset.describe(r)) }
    }
    // A mark for another set is not dropped -- read as Latin-1, those bytes are its characters.
    switch charset.decode([239b, 187b, 191b, 65b], charset.Charset.Latin1) {
        Ok(s) { test.assert_len(4, chars(s)) }
        Err(r) { test.fail(charset.describe(r)) }
    }
}

// **A PDF `/ToUnicode` destination is a UTF-16BE encoding, not a number.** The two spellings of
// U+1F600 differ, and writing the second where the first belongs is a file that extracts as
// private-use characters.
#[test]
fn utf16be_hex_writes_units_and_hex_of_writes_the_number() {
    test.assert_eq(charset.utf16be_hex(65), "0041")
    test.assert_eq(charset.utf16be_hex(351), "015F")
    test.assert_eq(charset.utf16be_hex(65535), "FFFF")
    test.assert_eq(charset.utf16be_hex(65536), "D800DC00")
    test.assert_eq(charset.utf16be_hex(128512), "D83DDE00")
    test.assert_eq(charset.utf16be_hex(1114111), "DBFFDFFF")
    test.assert_eq(charset.hex_of(128512), "1F600")
    // Not characters: a surrogate on its own, and past the end of the range.
    test.assert_eq(charset.utf16be_hex(55296), "FFFD")
    test.assert_eq(charset.utf16be_hex(1114112), "FFFD")
    test.assert_eq(charset.utf16be_hex(0 - 1), "FFFD")
}

// ---- reading what is not quite right

// **One mark per ill-formed sequence, not per byte**, which is the rule the Unicode standard
// calls the maximal subpart: `E1 80 41` is one bad character followed by a good one.
#[test]
fn a_lossy_read_keeps_what_is_well_formed() {
    test.assert_eq(charset.utf8_lossy([65b, 66b]), "AB")
    test.assert_eq(charset.utf8_lossy([]), "")
    // A good character, a bad one, a good one.
    test.assert_eq(
        charset.utf8_lossy([65b, 255b, 66b]),
        concat("A", replacement_text, "B")
    )
    // E1 80 41: a three-byte lead, one continuation, then an A. One mark, then the A.
    test.assert_eq(
        charset.utf8_lossy([225b, 128b, 65b]),
        concat(replacement_text, "A")
    )
    // A truncated character at the very end is one mark.
    test.assert_eq(
        charset.utf8_lossy([65b, 225b, 128b]),
        concat("A", replacement_text)
    )
    // An overlong slash is ill-formed, and reads as a mark rather than as a slash -- which is
    // the whole reason a lossy decoder must not simply take the value it computed.
    test.assert_eq(charset.utf8_lossy([192b, 175b]), replacement_text)
    // Well-formed text is untouched, however astral.
    test.assert_eq(charset.utf8_lossy(charset.utf8_bytes("Aé中😀")), "Aé中😀")
}

#[test]
fn a_lossy_utf16_read_marks_the_unit_that_was_wrong() {
    switch charset.utf16be_bytes("A😀b") {
        Ok(b) { test.assert_eq(charset.utf16be_lossy(b), "A😀b") }
        Err(r) { test.fail(charset.describe(r)) }
    }
    // A high surrogate on its own, between two characters: one mark for the one bad unit.
    test.assert_eq(
        charset.utf16be_lossy([0b, 65b, 216b, 61b, 0b, 66b]),
        concat("A", replacement_text, "B")
    )
    // A low surrogate with nothing before it.
    test.assert_eq(charset.utf16be_lossy([222b, 0b]), replacement_text)
    // Half a unit at the end.
    test.assert_eq(
        charset.utf16be_lossy([0b, 65b, 0b]),
        concat("A", replacement_text)
    )
    // The same bytes the other way round are the other order's text.
    test.assert_eq(charset.utf16le_lossy([65b, 0b, 66b, 0b]), "AB")
}

// The lossy read through the enum, including the sets that cannot fail and the one whose
// ill-formed input is a single byte.
#[test]
fn a_lossy_read_through_the_enum_covers_every_set() {
    test.assert_eq(
        charset.decode_lossy([65b, 255b], charset.Charset.Utf8),
        concat("A", replacement_text)
    )
    test.assert_eq(
        charset.decode_lossy([65b, 233b], charset.Charset.Ascii),
        concat("A", replacement_text)
    )
    // Latin-1 reads every byte, so nothing is ever marked.
    test.assert_eq(charset.decode_lossy([65b, 233b], charset.Charset.Latin1), "Aé")
    // **A NUL is the one byte Latin-1 cannot decode**, because a ziman string cannot hold one --
    // and it used to come back as `?`, silently, under a comment saying it could not happen.
    test.assert(refused_text(charset.latin1_text([65b, 0b])))
    switch charset.latin1_text([65b, 0b]) {
        Ok(_) { test.fail("a NUL decoded into a string") }
        Err(r) {
            test.assert_eq(r.at, 1)
            test.assert_eq(charset.describe(r), "Latin-1: a NUL byte, which a ziman string cannot hold at 1")
        }
    }
    // Lossy, it is the replacement character like anything else unwritable.
    test.assert_eq(
        charset.decode_lossy([65b, 0b], charset.Charset.Latin1),
        concat("A", replacement_text)
    )
    // Four bytes that are not a character, and a tail that is not four bytes.
    test.assert_eq(
        charset.decode_lossy([0b, 17b, 0b, 0b], charset.Charset.Utf32be),
        replacement_text
    )
    test.assert_eq(
        charset.decode_lossy([0b, 0b, 0b, 65b, 0b], charset.Charset.Utf32be),
        concat("A", replacement_text)
    )
    // A mark is still dropped on the way in.
    test.assert_eq(charset.decode_lossy([239b, 187b, 191b, 65b], charset.Charset.Utf8), "A")
}

// ---- where to cut a chunk

// **The question a chunked reader asks and a decoder cannot answer**: a read that ends in the
// middle of a character is unfinished, not malformed, and the rest arrives next time.
#[test]
fn a_chunk_is_cut_where_no_character_is_left_half_written() {
    // Nothing held back: every character is whole.
    test.assert_eq(charset.utf8_complete_prefix([]), 0)
    test.assert_eq(charset.utf8_complete_prefix([65b, 66b]), 2)
    test.assert_eq(charset.utf8_complete_prefix(charset.utf8_bytes("Aé中😀")), 10)

    // One character, cut at every point inside it: the prefix stops before the lead byte.
    val emoji = charset.utf8_bytes("😀")
    test.assert_len(4, emoji)
    test.assert_eq(charset.utf8_complete_prefix(slice(emoji, 0, 1)), 0)
    test.assert_eq(charset.utf8_complete_prefix(slice(emoji, 0, 2)), 0)
    test.assert_eq(charset.utf8_complete_prefix(slice(emoji, 0, 3)), 0)
    test.assert_eq(charset.utf8_complete_prefix(emoji), 4)

    // A whole character followed by part of the next one keeps the first.
    val mixed = concat(charset.utf8_bytes("A"), slice(emoji, 0, 2))
    test.assert_eq(charset.utf8_complete_prefix(mixed), 1)

    // **A byte that cannot lead stays inside the prefix**, because refusing it is the decoder's
    // answer to give: cutting before it would turn "not UTF-8" into "unfinished" and the reader
    // would wait for bytes that mean nothing.
    test.assert_eq(charset.utf8_complete_prefix([255b]), 1)
    test.assert_eq(charset.utf8_complete_prefix([65b, 255b]), 2)
    // Four continuation bytes with no lead: more than a character can be short by, so there is
    // nothing to wait for and the decoder gets them all.
    test.assert_eq(charset.utf8_complete_prefix([128b, 128b, 128b, 128b]), 4)
}

#[test]
fn a_continuation_byte_continues_and_never_begins() {
    test.assert(charset.is_continuation(128b))
    test.assert(charset.is_continuation(191b))
    test.assert_false(charset.is_continuation(127b))
    test.assert_false(charset.is_continuation(192b))
    // The two answers agree by construction: a byte that continues cannot begin.
    test.assert_eq(charset.utf8_sequence_length(128b), 0)
    test.assert_eq(charset.utf8_sequence_length(191b), 0)
}

// The mark as a character rather than as bytes, which is how a caller meets it once the bytes
// are decoded -- `csv` strips one off a spreadsheet's first heading.
#[test]
fn the_mark_is_also_a_character() {
    test.assert_len(1, chars(bom_text))
    test.assert_eq(charset.code_point_of(bom_text), bom)
    test.assert_eq(charset.utf8_bytes(bom_text), charset.mark_of(charset.Charset.Utf8))
}

// **Where to cut a chunk, per set** -- the question `io.text_in` asks and the reason `Charset`
// is a value rather than eight function names.
#[test]
fn every_set_says_where_a_chunk_may_be_cut() {
    // A single-byte set never holds anything back: every byte is a whole character.
    test.assert_eq(charset.complete_prefix([65b, 233b, 255b], charset.Charset.Latin1), 3)
    test.assert_eq(charset.complete_prefix([128b], charset.Charset.WinAnsi), 1)
    test.assert_eq(charset.complete_prefix([65b, 66b], charset.Charset.Ascii), 2)

    // UTF-8 holds back the start of a character the chunk ended inside.
    val emoji = charset.utf8_bytes("😀")
    test.assert_eq(charset.complete_prefix(slice(emoji, 0, 3), charset.Charset.Utf8), 0)
    test.assert_eq(charset.complete_prefix(emoji, charset.Charset.Utf8), 4)

    // UTF-16 holds back an odd byte...
    test.assert_eq(charset.complete_prefix([0b, 65b, 0b], charset.Charset.Utf16be), 2)
    test.assert_eq(charset.complete_prefix([65b, 0b, 66b], charset.Charset.Utf16le), 2)
    // ...**and a high surrogate whose low half has not arrived**, which is a whole unit and half
    // a character. D83D is the first half of U+1F600.
    test.assert_eq(charset.complete_prefix([0b, 65b, 216b, 61b], charset.Charset.Utf16be), 2)
    // With the low half present, all four bytes are whole.
    test.assert_eq(charset.complete_prefix([216b, 61b, 222b, 0b], charset.Charset.Utf16be), 4)
    // A lone low surrogate is not held back: it is ill-formed, not unfinished, and refusing it
    // is the decoder's business.
    test.assert_eq(charset.complete_prefix([222b, 0b], charset.Charset.Utf16be), 2)

    // UTF-32 holds back anything short of four bytes.
    test.assert_eq(charset.complete_prefix([0b, 0b, 0b, 65b, 0b, 0b], charset.Charset.Utf32be), 4)
    test.assert_eq(charset.complete_prefix([65b, 0b, 0b], charset.Charset.Utf32le), 0)
    test.assert_eq(charset.complete_prefix([], charset.Charset.Utf32be), 0)
}

// **The encoder's half of the lossy bargain**, which the module did not have until the reader's
// half was pointed at: a lossy decoder beside a strict encoder is a position nobody chose.
#[test]
fn a_lossy_write_substitutes_rather_than_refusing() {
    // What the set can carry is unchanged.
    test.assert_eq(charset.encode_lossy("Hi!", charset.Charset.Ascii), to_bytes("Hi!"))
    // What it cannot becomes `?`, one per character and not one per byte.
    test.assert_eq(charset.encode_lossy("şeker", charset.Charset.Ascii), to_bytes("?eker"))
    test.assert_eq(charset.encode_lossy("a😀b", charset.Charset.Latin1), to_bytes("a?b"))
    // WinAnsi has the euro and Latin-1 does not, which is the one block between them.
    test.assert_eq(charset.encode_lossy("€", charset.Charset.WinAnsi), [128b])
    test.assert_eq(charset.encode_lossy("€", charset.Charset.Latin1), to_bytes("?"))
    // A set that can carry everything substitutes nothing, whatever the text.
    test.assert_eq(charset.encode_lossy("Aé中😀", charset.Charset.Utf8), to_bytes("Aé中😀"))
    // And the strict encoder still refuses the same text, which is the point of having both.
    test.assert(refused_bytes(charset.encode("şeker", charset.Charset.Ascii)))
}

// ---- the single-byte family

// **Every shipped set, held to one promise: what it can carry, it round-trips.** The tables are
// generated, so this is not checking arithmetic -- it is checking that the three arrays per set
// agree with each other, which is the one thing a generator can get wrong and a reader cannot see.
#[test]
fn every_single_byte_set_round_trips_every_byte_it_has() {
    var sets = 0
    var characters = 0
    for set in charset.single_byte_sets() {
        sets = sets + 1
        var b = 0
        while b < 256 {
            val data = [b as byte]
            switch charset.decode(data, set) {
                Ok(text) {
                    characters = characters + 1
                    // The character it decoded to must encode back to the same byte.
                    switch charset.encode(text, set) {
                        Ok(back) {
                            test.assert_len(1, back)
                            test.assert_eq(back[0] as int, b)
                        }
                        Err(r) { test.fail(concat("did not encode back: ", charset.describe(r))) }
                    }
                }
                // A hole in the table is a refusal, which ISO-8859-3 and -6 both have.
                Err(_) {}
            }
            b = b + 1
        }
    }
    test.assert_eq(sets, 25)
    // Every set carries at least the 128 ASCII characters, so this is a floor and not a figure.
    test.assert(characters > 25 * 128)
}

// A handful of characters nobody can get wrong by accident, as a check that the tables are the
// sets they claim to be rather than copies of one another.
#[test]
fn each_set_is_the_set_it_says_it_is() {
    // ISO-8859-2 has s-caron where Latin-1 has s-acute's byte; 0xB9 is the one.
    test.assert_eq(charset.decode_lossy([185b], charset.iso_8859_2()), "š")
    // ISO-8859-5 is Cyrillic: 0xE0 is the small er.
    test.assert_eq(charset.decode_lossy([224b], charset.iso_8859_5()), "р")
    // ISO-8859-7 is Greek: 0xE1 is alpha.
    test.assert_eq(charset.decode_lossy([225b], charset.iso_8859_7()), "α")
    // ISO-8859-9 is Latin-1 with the Turkish letters, and 0xFD is the dotless i.
    test.assert_eq(charset.decode_lossy([253b], charset.iso_8859_9()), "ı")
    // ISO-8859-15 is Latin-1 with the euro, at 0xA4 where Latin-1 has the currency sign.
    test.assert_eq(charset.decode_lossy([164b], charset.iso_8859_15()), "€")
    test.assert_eq(charset.decode_lossy([164b], charset.Charset.Latin1), "¤")
    // KOI8-R puts Cyrillic in a different order again: 0xC1 is small a.
    test.assert_eq(charset.decode_lossy([193b], charset.koi8_r()), "а")
    // Mac Roman's 0xA5 is a bullet, which is what made `truetype`'s Latin-1 reading an
    // approximation -- Latin-1 has the yen sign there.
    test.assert_eq(charset.decode_lossy([165b], charset.mac_roman()), "•")
    test.assert_eq(charset.decode_lossy([165b], charset.Charset.Latin1), "¥")
}

// **A hole in a table is a refusal, not a guess.** ISO-8859-3 has no character for 0xA5.
#[test]
fn a_byte_a_set_has_no_character_for_is_refused() {
    test.assert(refused_text(charset.decode([165b], charset.iso_8859_3())))
    test.assert_eq(charset.decode_lossy([165b], charset.iso_8859_3()), replacement_text)
    // And the set says which set it was.
    switch charset.decode([165b], charset.iso_8859_3()) {
        Ok(_) { test.fail("a hole was read as a character") }
        Err(r) { test.assert_eq(charset.name_of(r.charset), "ISO-8859-3") }
    }
}

// A name resolves to the set, however it is spelled -- and the hand-written sets still win,
// so `iso-8859-1` is `Latin1` and not a table of itself.
#[test]
fn a_single_byte_set_is_found_by_name() {
    for spelling in ["iso-8859-2", "ISO8859-2", "latin2", "l2"] {
        switch charset.charset_named(spelling) {
            Some(set) { test.assert_eq(charset.name_of(set), "ISO-8859-2") }
            None { test.fail(concat("no set for ", spelling)) }
        }
    }
    for spelling in ["windows-1251", "cp1251"] {
        switch charset.charset_named(spelling) {
            Some(set) { test.assert_eq(charset.name_of(set), "windows-1251") }
            None { test.fail(concat("no set for ", spelling)) }
        }
    }
    // The hand-written ones are unchanged by the tables arriving.
    switch charset.charset_named("iso-8859-1") {
        Some(set) { test.assert_eq(charset.name_of(set), "Latin-1") }
        None { test.fail("no set for iso-8859-1") }
    }
    switch charset.charset_named("macintosh") {
        Some(set) { test.assert_eq(charset.name_of(set), "Mac Roman") }
        None { test.fail("no set for macintosh") }
    }
}

// **An application's own set, from its own table** -- the resource-file route, with the
// filesystem in the caller rather than under every text boundary in the library.
#[test]
fn a_caller_can_bring_its_own_table() {
    // A set where the upper half is nothing but one character, to prove the table is used and
    // the reverse direction is derived from it.
    val upper = mutable_array_new<int>()
    var i = 0
    while i < 128 {
        push(upper, if i == 0 { 9731 } else { 0 - 1 })
        i = i + 1
    }
    switch charset.single_byte("Snowman-1", prelude.snapshot(upper)) {
        Ok(set) {
            test.assert_eq(charset.name_of(set), "Snowman-1")
            test.assert_eq(charset.decode_lossy([128b], set), "☃")
            switch charset.encode("A☃", set) {
                Ok(bytes) {
                    test.assert_len(2, bytes)
                    test.assert_eq(bytes[0] as int, 65)
                    test.assert_eq(bytes[1] as int, 128)
                }
                Err(r) { test.fail(charset.describe(r)) }
            }
            // Every other high byte is a hole.
            test.assert(refused_text(charset.decode([129b], set)))
        }
        Err(r) { test.fail(charset.describe(r)) }
    }
    // A table of the wrong size is refused rather than padded.
    test.assert(switch charset.single_byte("Short", [1, 2, 3]) {
        Ok(_) { false }
        Err(_) { true }
    })
}

// **The generated tables, against mappings nobody here produced.**
//
// `lib/core/charset/tables.zm` comes from Python's codec data and `charsets-check` regenerates it
// and diffs -- so a wrong generator would reproduce its wrong answer and the gate would pass. On
// 2026-11-19 all 3,027 high-byte mappings in the 25 generated tables were compared against
// **iconv**, an implementation that did not produce them: 3,025 agreed exactly.
//
// The two that differ are both `macintosh`, and both are the known split between Apple's Mac OS
// Roman -- which Unicode's own Apple mapping file and Python's codec follow, and which these
// tables follow -- and glibc's older MACINTOSH: 0xC6 is INCREMENT here and GREEK CAPITAL DELTA
// there, 0xF0 is Apple's private-use logo here and a different private-use point there. Asserted
// below so the choice is a decision on the record rather than an accident.
//
// A handful of mappings, not all 3,027: this is a spot check that the table is wired up and says
// what the standards say, where the full cross-check is a one-off against an external tool.
#[test]
fn the_generated_tables_say_what_the_standards_say() {
    said_is("iso-8859-2", [177b], "ą")
    // 0xE0 is р and not а: in ISO-8859-5 the capitals run 0xB0-0xCF and the lower case follows,
    // so this is sixteen past the start of the lower case. Checked against iconv, which caught the
    // first version of this line.
    said_is("iso-8859-5", [224b], "р")
    said_is("windows-1251", [192b], "А")
    said_is("windows-1253", [193b], "Α")
    said_is("koi8-r", [193b], "а")
    said_is("iso-8859-15", [164b], "€")
    // Apple's Mac OS Roman, not glibc's MACINTOSH: INCREMENT rather than GREEK CAPITAL DELTA.
    said_is("macintosh", [198b], "∆")
}

fn said_is(name: string, data: [byte], want: string) {
    switch charset.charset_named(name) {
        Some(set) {
            switch charset.decode(data, set) {
                Ok(text) { test.assert_eq(text, want) }
                Err(_) { test.fail(concat(name, " refused a byte it defines")) }
            }
        }
        None { test.fail(concat("no set for ", name)) }
    }
}
