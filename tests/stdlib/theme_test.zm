// `lib/ui/theme`: the looks the control set ships with.
//
// **These are a gate on the colours, not a snapshot of them.** A test that asserted what grey a
// face is would fail every time anyone improved one and would catch nothing -- the thing worth
// holding a look to is whether it can be *read*, which is a ratio between two of its own tokens
// and stays true however the colours move. WCAG AA asks 4.5 for body text and 3.0 for a large
// one or a control's edge; `paint.contrast_ratio` has the formula.
//
// **Every look in `all` is checked, so adding one to the register opts it in.** That is the whole
// reason the register exists as a list rather than as a switch in `named`: a look that is only
// reachable by calling its own function is a look nothing tests and no application offers.
use controls
use paint
use paint.Color
use test
use theme
use theme.step_solid
use widget

// ---- the register

#[test]
fn the_register_names_every_look_once() {
    val seen = mutable_map_new<string, bool>()
    for one in theme.all() {
        test.assert(!contains(seen, one.name))
        set(seen, one.name, true)
    }
    test.assert(len(theme.all()) >= 4)
}

#[test]
fn every_name_in_the_register_is_findable() {
    for one in theme.all() {
        test.assert(switch theme.named(one.name) {
            Some(_) { true }
            None { false }
        })
    }
}

#[test]
fn a_name_that_is_not_a_look_is_nothing_rather_than_the_default() {
    // A near-match would be a guess. An application with a stale stored preference should fall
    // back deliberately rather than be handed something close to what it asked for.
    test.assert(switch theme.named("plain") {
        Some(_) { false }
        None { true }
    })
    test.assert(switch theme.named("Solarized") {
        Some(_) { false }
        None { true }
    })
}

#[test]
fn the_default_is_plain() {
    test.assert(same_colour(theme.default_style().face, theme.plain().face))
    test.assert(same_colour(theme.default_style().window, theme.plain().window))
}

// ---- every shipped look is legible

#[test]
fn body_text_reads_on_every_surface_of_every_look() {
    for one in theme.all() {
        val s = one.style
        // The four surfaces `ink` is drawn on. A look that passes on a face and fails on a
        // selected row is a look whose list is unreadable exactly while you are using it.
        test.assert(paint.contrast_ratio(s.ink, s.face) >= 4.5)
        test.assert(paint.contrast_ratio(s.ink, s.panel) >= 4.5)
        test.assert(paint.contrast_ratio(s.ink, s.window) >= 4.5)
        // **Every live row, against its own ink**, which is what the rows made possible: before
        // them a state was a fill with no text colour of its own, so there was nothing to hold to
        // a ratio. `disabled` is exempt and that is WCAG's own exemption (SC 1.4.3) -- greyed text
        // is how a control says it is unavailable, and holding it to 4.5 would forbid saying so.
        test.assert(reads_on_every_stop(s.states.rest))
        test.assert(reads_on_every_stop(s.states.hovered))
        test.assert(reads_on_every_stop(s.states.pressed))
        test.assert(reads_on_every_stop(s.states.selected))
    }
}

#[test]
fn a_primary_surface_reads_in_its_own_text_colour() {
    // **Both ends of the pair**, which is the one a dark look gets wrong by inheriting: a dark
    // theme wants a lighter accent so it shows against the window, and white text stops reading
    // on it well before the accent stops looking right.
    for one in theme.all() {
        test.assert(paint.contrast_ratio(one.style.on_accent, one.style.accent) >= 4.5)
    }
}

#[test]
fn an_accent_and_a_grid_line_show_against_the_surfaces_they_mark() {
    // 3.0 rather than 4.5: a focus ring and a rule are large-scale graphics, which is the lower
    // of WCAG's two thresholds and the right one for a line.
    for one in theme.all() {
        test.assert(paint.contrast_ratio(one.style.accent, one.style.face) >= 3.0)
        test.assert(paint.contrast_ratio(one.style.grid, one.style.face) >= 1.1)
    }
}

#[test]
fn a_selected_row_is_visibly_not_an_unselected_one() {
    // Low on purpose: a selection is a tint, not a contrast. This catches a look that forgot to
    // set it and left it equal to the face, which is the failure that makes a list look broken.
    for one in theme.all() {
        test.assert(paint.contrast_ratio(paint.flat_of(one.style.states.selected.face), one.style.face) >= 1.08)
    }
}

#[test]
fn ink_contrast_is_the_ratio_it_says_it_is() {
    for one in theme.all() {
        test.assert(
            theme.ink_contrast(one.style) ==
                paint.contrast_ratio(one.style.ink, one.style.face)
        )
    }
}

// ---- what makes a dark look dark

#[test]
fn a_dark_look_is_darker_than_its_light_one_everywhere_it_counts() {
    test.assert(
        paint.relative_luminance(theme.plain_dark().window) <
        paint.relative_luminance(theme.plain().window)
    )
    test.assert(
        paint.relative_luminance(theme.modern_dark().window) <
        paint.relative_luminance(theme.modern().window)
    )
    // The ink goes the other way, which is the half an inversion gets right.
    test.assert(
        paint.relative_luminance(theme.plain().ink) <
        paint.relative_luminance(theme.plain_dark().ink)
    )
}

#[test]
fn a_dark_look_lights_its_hover_rather_than_darkening_it() {
    // **The trap this module's header names.** The veil is mixed into the face, and a tenth of
    // black over a dark grey is invisible -- the state layer has to come from the other end. A
    // dark look whose hover veil is black is a dark look with no hover at all.
    for one in theme.all() {
        val dark = paint.relative_luminance(one.style.window) < 0.2
        val rest = paint.relative_luminance(paint.flat_of(one.style.states.rest.face))
        val hovered = paint.relative_luminance(paint.flat_of(one.style.states.hovered.face))
        // **The outcome rather than the ingredient.** This used to assert that a dark look's
        // `hover_tint` was light, which was a test of what the veil was made of; the veil is
        // resolved into the row when the look is built now, so the thing to assert is what a user
        // sees: a hovered face moves *away* from the window it sits on, which on a dark look means
        // lighter and on a light one means darker.
        if dark {
            test.assert(hovered > rest)
        } else {
            test.assert(hovered < rest)
        }
    }
}

#[test]
fn a_dark_look_raises_its_surfaces_instead_of_sinking_them() {
    // On white a control is paler than its surround; flipping that literally would put a
    // near-black control on a dark grey window. Every dark theme worth copying does the opposite:
    // the further forward a thing is, the lighter it gets.
    for one in theme.all() {
        if paint.relative_luminance(one.style.window) < 0.2 {
            test.assert(
                paint.relative_luminance(one.style.window) <
                paint.relative_luminance(one.style.face)
            )
            test.assert(
                paint.relative_luminance(one.style.window) <=
                    paint.relative_luminance(one.style.panel)
            )
        }
    }
}

#[test]
fn a_dark_look_casts_a_deeper_shadow_than_its_light_one() {
    // Depth is read as a darkening and there is less room to darken below a dark window, so the
    // same geometry at the same opacity reads as nothing.
    test.assert(shadow_opacity(theme.plain_dark()) > shadow_opacity(theme.plain()))
    test.assert(shadow_opacity(theme.modern_dark()) > shadow_opacity(theme.modern()))
}

// ---- a variation keeps its own look's shape

#[test]
fn a_dark_variation_varies_the_surround_and_not_the_shape() {
    // **What stops a dark look from being a second design.** `modern_dark` is built from `modern`
    // and not from `plain_dark`, so it keeps the radius, the padding and the shadow geometry that
    // make it the modern look at all -- and `plain_dark` stays square for the same reason.
    test.assert(same_corner(theme.modern_dark().shape.medium, theme.modern().shape.medium))
    test.assert(same_corner(theme.plain_dark().shape.medium, theme.plain().shape.medium))
    test.assert(theme.modern_dark().padding.left == theme.modern().padding.left)
    test.assert(edged(theme.modern_dark()))
    test.assert(!edged(theme.plain_dark()))
}

// ---- helpers

fn same_colour(a: Color, b: Color) -> bool {
    return a.red == b.red && a.green == b.green && a.blue == b.blue && a.alpha == b.alpha
}

fn shadow_opacity(s: controls.Style) -> float {
    return switch s.raised {
        Some(cast) { cast.opacity }
        None { 0.0 }
    }
}

// **A row's ink against every stop of its face, not against a representative colour.**
//
// This is what D10 bought by making a face a span of *ramp steps* rather than an arbitrary
// gradient: §12 worried that a gradient face has no luminance for a gate to check and that we
// would end up picking "a representative colour", which is a gate going vague. A face is two known
// steps, so the honest check is both ends -- a gradient passes only if its text reads at the top
// and at the bottom. A flat face has one stop and this is the check it always was.
fn reads_on_every_stop(p: controls.Parts) -> bool {
    for stop in stops_of(p.face) {
        if paint.contrast_ratio(p.ink, stop) < 4.5 {
            return false
        }
    }
    return true
}

fn stops_of(p: paint.Paint) -> [Color] {
    return switch p {
        Solid(c) { [c] }
        LinearGradient(g) { colours_of(g.stops) }
        RadialGradient(g) { colours_of(g.stops) }
        Pattern(_) { [] }
    }
}

fn colours_of(stops: [paint.Stop]) -> [Color] {
    val out = mutable_array_new<Color>()
    for one in stops {
        push(out, one.color)
    }
    return snapshot(out)
}

fn edged(s: controls.Style) -> bool {
    return switch s.states.rest.border {
        Some(_) { true }
        None { false }
    }
}

fn corner_points(c: widget.Radius) -> float {
    return switch c {
        Square { 0.0 }
        Points(r) { r }
        Fraction(f) { -f }
    }
}

fn same_corner(a: widget.Radius, b: widget.Radius) -> bool {
    return corner_points(a) == corner_points(b)
}

// ---- density, which is an axis over a look rather than a look

#[test]
fn a_density_moves_the_scale_and_leaves_the_floors_alone() {
    // **The assertion that matters is the one about what does NOT move.** 24 points is WCAG 2.2's
    // minimum target size (SC 2.5.8), so a compact window must not buy its tightness by handing a
    // user a smaller thing to hit -- which is exactly what a single scale covering everything would
    // have done, and the reason D6 split `minimum` out as its own group.
    for d in theme.densities() {
        for look in theme.all() {
            val dense = theme.at_density(look.style, d)
            test.assert_eq(dense.minimum.target, look.style.minimum.target)
            test.assert_eq(dense.minimum.thumb, look.style.minimum.thumb)
            // A hairline is a hairline at every density.
            test.assert_eq(dense.stroke.hair, look.style.stroke.hair)
            test.assert_eq(dense.stroke.line, look.style.stroke.line)
            // Colour and shape are not density's business either.
            test.assert(same_colour(dense.window, look.style.window))
            test.assert(same_corner(dense.shape.medium, look.style.shape.medium))
            // **The letters do not change size, only how far apart their lines sit.** A density
            // that shrank the text would be a zoom, and the one change a reader with low vision
            // cannot undo from their own settings.
            test.assert_eq(dense.text.body.size, look.style.text.body.size)
            test.assert_eq(dense.text.heading.size, look.style.text.heading.size)
            test.assert_eq(dense.text.caption.size, look.style.text.caption.size)
        }
    }
}

#[test]
fn the_scale_stays_a_scale_at_every_density() {
    // A step out of order is the defect a per-density hand-written scale invites: `xs` larger than
    // `s` in one of three places, with nothing to say so. Factors cannot do that, and this says it.
    for d in theme.densities() {
        for look in theme.all() {
            val s = theme.at_density(look.style, d).space
            test.assert(s.none <= s.xs)
            test.assert(s.xs <= s.s)
            test.assert(s.s <= s.m)
            test.assert(s.m <= s.l)
            test.assert(s.l <= s.xl)
        }
    }
}

#[test]
fn compact_is_tighter_and_spacious_is_looser() {
    val look = theme.plain()
    val tight = theme.at_density(look, theme.Density.Compact)
    val loose = theme.at_density(look, theme.Density.Spacious)
    test.assert(tight.space.m < look.space.m)
    test.assert(loose.space.m > look.space.m)
    test.assert(tight.padding.left < look.padding.left)
    test.assert(loose.padding.left > look.padding.left)
    // Comfortable is the look exactly as written, so an application that never asks gets what the
    // look says.
    test.assert_eq(theme.at_density(look, theme.Density.Comfortable).space.m, look.space.m)
    test.assert_eq(theme.at_density(look, theme.Density.Comfortable).padding.top, look.padding.top)
}

#[test]
fn a_density_moves_the_leading_but_gently() {
    val look = theme.plain()
    val tight = theme.at_density(look, theme.Density.Compact)
    val loose = theme.at_density(look, theme.Density.Spacious)
    test.assert(tight.text.body.line < look.text.body.line)
    test.assert(loose.text.body.line > look.text.body.line)
    // **Gentler than the space factor**, because `line` multiplies the font's own line height:
    // three quarters of that overlaps one line's descenders with the next line's ascenders.
    test.assert(tight.text.body.line > 0.8)
    test.assert(loose.text.body.line < 1.25)
}

// ------------------------------------------------------- the ramps (F295, D8)

fn blue() -> Color {
    return paint.rgb(0.15, 0.4, 0.85)
}

fn grey() -> Color {
    return paint.rgb(0.5, 0.5, 0.52)
}

fn lightness_of(c: Color) -> float {
    return paint.to_oklch(c).lightness
}

// **A scale is monotone or it is a palette.** The step number is only a role if the steps run one
// way: a ramp that wandered would make 4 "hovered" and 5 "active" mean nothing, and the rows that
// index them would stop being derivable.
#[test]
fn every_ramp_runs_one_way() {
    for one in [ramp_of_seed(blue(), theme.Scheme.Light), ramp_of_seed(grey(), theme.Scheme.Light)] {
        var i = 1
        while i < len(one) {
            test.assert(lightness_of(one[i]) < lightness_of(one[i - 1]))
            i = i + 1
        }
    }
    for one in [ramp_of_seed(blue(), theme.Scheme.Dark), ramp_of_seed(grey(), theme.Scheme.Dark)] {
        var i = 1
        while i < len(one) {
            test.assert(lightness_of(one[i]) > lightness_of(one[i - 1]))
            i = i + 1
        }
    }
}

fn ramp_of_seed(seed: Color, s: theme.Scheme) -> [Color] {
    return theme.ramp(seed, s)
}

// **The guarantee §11.2 quotes, in the units this library gates on.** Radix states steps 11 and 12
// against step 2 in APCA; `paint.contrast_ratio` is WCAG 2, which is what EN 301 549 and Section
// 508 reference and therefore what this library claims. So the claim is re-checked here rather
// than inherited: 12 is text and 11 is the quieter text, both on the subtle background.
#[test]
fn the_text_steps_read_on_the_subtle_background() {
    for s in [theme.Scheme.Light, theme.Scheme.Dark] {
        val n = theme.ramp(grey(), s)
        test.assert(paint.contrast_ratio(n[11], n[1]) >= 4.5)
        test.assert(paint.contrast_ratio(n[10], n[1]) >= 4.5)
    }
}

// A dark ramp is the light one read from the other end: the two share a seed and end up at
// opposite ends of the same axis. **This is what makes dark a parameter rather than a second look**
// -- see `Scheme`, which lists the four things `plain_dark` had to get right by hand.
#[test]
fn dark_is_the_same_scale_from_the_other_end() {
    val light = theme.ramp(grey(), theme.Scheme.Light)
    val dark = theme.ramp(grey(), theme.Scheme.Dark)
    test.assert(lightness_of(light[0]) > 0.9)
    test.assert(lightness_of(dark[0]) < 0.25)
    test.assert(lightness_of(light[11]) < 0.3)
    test.assert(lightness_of(dark[11]) > 0.9)
}

// **A seed gives its hue away and keeps nothing else.** The ramp is the roles; the seed says which
// hue they are in, which is why one blue and one grey produce scales of the same shape.
#[test]
fn a_ramp_keeps_its_seed_s_hue() {
    val n = theme.ramp(blue(), theme.Scheme.Light)
    val want = paint.to_oklch(blue()).hue
    for step in n {
        val got = paint.to_oklch(step)
        if got.chroma > 0.004 {
            test.assert(got.hue - want < 1.0)
            test.assert(want - got.hue < 1.0)
        }
    }
}

// **The accent ramp cannot share the neutral curve, and this is the test that says why.** At the
// neutral table's step 9 a blue accent is too light for white text to sit on -- 3.41:1, under AA --
// so step 9 of an accent ramp sits lower. A look's `on_accent` is derived from this, so if it ever
// stops holding, every derived look loses its primary button's words rather than one test.
#[test]
fn a_solid_accent_step_can_carry_text() {
    for s in [theme.Scheme.Light, theme.Scheme.Dark] {
        val a = theme.accent_ramp(blue(), s)
        val solid = a[step_solid - 1]
        val pale = a[0]
        val deep = a[11]
        val best = if paint.contrast_ratio(pale, solid) < paint.contrast_ratio(deep, solid) {
            paint.contrast_ratio(deep, solid)
        } else {
            paint.contrast_ratio(pale, solid)
        }
        test.assert(best >= 4.5)
    }
}

// **The register is looks times schemes, so the gate cannot shrink.** A family states two seeds and
// the register produces both its rows -- which is what stops a better mechanism from quietly
// halving what `every_look_in_the_register_is_legible` tests.
#[test]
fn every_family_contributes_both_its_schemes() {
    var light = 0
    var dark = 0
    for one in theme.all() {
        switch one.scheme {
            Light { light = light + 1 }
            Dark { dark = dark + 1 }
        }
    }
    test.assert_eq(light, dark)
    test.assert(light >= 2)
    test.assert_eq(len(theme.all()), light + dark)
}

// A dark row says so in the register rather than in its name. **This is what an application asks**
// when it has a desktop preference to follow, and matching on the word "dark" would be a look
// called "Midnight" away from being wrong.
#[test]
fn the_register_says_which_scheme_a_row_is() {
    for one in theme.all() {
        val window = paint.relative_luminance(one.style.window)
        switch one.scheme {
            Light { test.assert(window > 0.5) }
            Dark { test.assert(window < 0.2) }
        }
    }
}

// **Every hue is legible, not just the two the shipped looks happen to use.** One lightness per
// step cannot serve every hue -- two colours of equal OKLab lightness do not carry equal relative
// luminance, which is what WCAG 2 measures -- so a green accent at the same step as a blue one was
// 4.32:1 against its own text while the blue was 5.16:1. `derive` darkens the solid step until
// something reads on it.
//
// **Found by dragging a slider**, which is the theme designer earning its keep: nothing in the
// register goes near those hues, so no shipped look would ever have shown it.
#[test]
fn a_look_of_any_hue_can_carry_text_on_its_accent() {
    var hue = 0.0
    while hue < 360.0 {
        for s in [theme.Scheme.Light, theme.Scheme.Dark] {
            val look = theme.derive(
                theme.Seeds {
                    neutral: paint.oklch(0.5, 0.012, hue),
                    accent: paint.oklch(0.55, 0.215, hue),
                    surfaces: theme.Toward.Away,
                    edged: true
                },
                s
            )
            test.assert(paint.contrast_ratio(look.on_accent, look.accent) >= 4.5)
            test.assert(reads_on_every_stop(look.states.rest))
            test.assert(reads_on_every_stop(look.states.selected))
        }
        hue = hue + 15.0
    }
}
