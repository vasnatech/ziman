// `lib/ui/widget`: a widget tree, its layout and its painting, with no window and no font.
//
// **That it needs neither is the point of F271**, not a convenience: a graphical application whose
// layout can only be checked by looking at it has no layout tests, and every toolkit that went
// that way has a folder of screenshots nobody can review. Everything here is a pure function over
// immutable values, so a wrong box is a wrong number.
//
// The metrics are a **fake** with numbers chosen to make arithmetic visible: ten units of width per
// character and a line height of twice the em size. A real face would make every expected value
// below depend on which face it was, and on nothing about the layout.
use geom
use paint
use scene
use shape
use test
use widget

fn fake_metrics() -> widget.Metrics {
    return widget.metrics_of(
        fn(text: string, size: float) -> float { return (len(text) as float) * 10.0 },
        fn(size: float) -> float { return size * 2.0 }
    )
}

fn black() -> paint.Color {
    return paint.black()
}

fn a_label(text: string) -> widget.Widget {
    return widget.label_of(text, 10.0, black())
}

fn box(w: float, h: float) -> widget.Widget {
    return widget.fixed_of(w, h, widget.Widget.Nothing)
}

fn rect_text(r: geom.Rect) -> string {
    return prelude.format("{},{} {}x{}", str(r.x), str(r.y), str(r.width), str(r.height))
}

// --- measurement

#[test]
fn a_label_measures_its_text_and_line_height() {
    val s = widget.measure(a_label("abcd"), fake_metrics())
    test.assert_eq(s.width, 40.0)
    test.assert_eq(s.height, 20.0)
}

#[test]
fn nothing_and_flex_measure_zero() {
    test.assert_eq(widget.measure(widget.Widget.Nothing, fake_metrics()).width, 0.0)
    // **A flex has no natural size, and that is what makes it flexible**: everything it is given is
    // leftover space, so a measurement of anything else would reserve room twice.
    test.assert_eq(widget.measure(widget.flex(), fake_metrics()).width, 0.0)
    test.assert_eq(widget.measure(widget.flex_of(5.0), fake_metrics()).height, 0.0)
}

#[test]
fn a_fixed_box_measures_what_it_was_given() {
    val s = widget.measure(box(33.0, 7.0), fake_metrics())
    test.assert_eq(s.width, 33.0)
    test.assert_eq(s.height, 7.0)
}

// A row is the sum along and the maximum across. The two labels are 40 and 20 wide and both 20
// tall, with one 6-unit gap: 66 by 20.
#[test]
fn a_row_sums_along_and_maxes_across() {
    val r = widget.row_of(6.0, [a_label("abcd"), a_label("ef")])
    val s = widget.measure(r, fake_metrics())
    test.assert_eq(s.width, 66.0)
    test.assert_eq(s.height, 20.0)
}

#[test]
fn a_column_sums_the_other_way() {
    val c = widget.column_of(6.0, [a_label("abcd"), a_label("ef")])
    val s = widget.measure(c, fake_metrics())
    test.assert_eq(s.width, 40.0)
    test.assert_eq(s.height, 46.0)
}

// **Spacing goes between children, so three children have two gaps.** An unguarded
// `count * spacing` is wrong by a whole gap on every container, and by a gap on an empty one --
// which is the case worth asserting, because it is the one a reader does not think of.
#[test]
fn spacing_is_between_children_not_after_them() {
    val two = widget.row_of(10.0, [box(5.0, 5.0), box(5.0, 5.0)])
    val three = widget.row_of(10.0, [box(5.0, 5.0), box(5.0, 5.0), box(5.0, 5.0)])
    test.assert_eq(widget.measure(two, fake_metrics()).width, 20.0)
    test.assert_eq(widget.measure(three, fake_metrics()).width, 35.0)
}

#[test]
fn an_empty_container_has_no_gaps() {
    val empty: [widget.Widget] = []
    test.assert_eq(widget.measure(widget.row_of(10.0, empty), fake_metrics()).width, 0.0)
}

// --- layout

fn laid(w: widget.Widget, width: float, height: float) -> widget.Laid {
    return widget.layout(w, geom.rect_of(0.0, 0.0, width, height), fake_metrics())
}

#[test]
fn the_root_fills_what_it_was_given() {
    val l = laid(a_label("hi"), 100.0, 50.0)
    test.assert_eq(rect_text(l.bounds), "0.0,0.0 100.0x50.0")
}

// A row of two fixed boxes and the spacer between them: the boxes keep their widths and the
// spacer takes everything left over.
#[test]
fn a_flex_takes_the_leftover_space() {
    val r = widget.row_of(0.0, [box(20.0, 10.0), widget.flex(), box(30.0, 10.0)])
    val l = laid(r, 100.0, 10.0)
    test.assert_len(3, l.children)
    test.assert_eq(rect_text(l.children[0].bounds), "0.0,0.0 20.0x10.0")
    test.assert_eq(rect_text(l.children[1].bounds), "20.0,0.0 50.0x10.0")
    test.assert_eq(rect_text(l.children[2].bounds), "70.0,0.0 30.0x10.0")
}

// **Two spacers share in proportion to their weights**, which is the whole reason a weight exists
// rather than a bool. 1 and 3 over 80 spare units is 20 and 60.
#[test]
fn two_flexes_share_by_weight() {
    val r = widget.row_of(0.0, [widget.flex_of(1.0), box(20.0, 10.0), widget.flex_of(3.0)])
    val l = laid(r, 100.0, 10.0)
    test.assert_eq(rect_text(l.children[0].bounds), "0.0,0.0 20.0x10.0")
    test.assert_eq(rect_text(l.children[1].bounds), "20.0,0.0 20.0x10.0")
    test.assert_eq(rect_text(l.children[2].bounds), "40.0,0.0 60.0x10.0")
}

// A weight of zero takes nothing, which is how a spacer is switched off without being removed from
// the tree -- and removing it from the tree is what would move every sibling's path.
#[test]
fn a_zero_weight_flex_takes_nothing() {
    val r = widget.row_of(0.0, [widget.flex_of(0.0), widget.flex_of(1.0)])
    val l = laid(r, 60.0, 10.0)
    test.assert_eq(rect_text(l.children[0].bounds), "0.0,0.0 0.0x10.0")
    test.assert_eq(rect_text(l.children[1].bounds), "0.0,0.0 60.0x10.0")
}

// **An over-full container overflows; it does not shrink its children.** Silently shrinking would
// hide the mistake, and clipping is a scroll container's decision rather than every container's.
#[test]
fn children_wider_than_the_room_overflow_rather_than_shrink() {
    val r = widget.row_of(0.0, [box(80.0, 10.0), box(80.0, 10.0)])
    val l = laid(r, 100.0, 10.0)
    test.assert_eq(rect_text(l.children[0].bounds), "0.0,0.0 80.0x10.0")
    test.assert_eq(rect_text(l.children[1].bounds), "80.0,0.0 80.0x10.0")
}

#[test]
fn a_flex_in_an_over_full_container_takes_nothing() {
    val r = widget.row_of(0.0, [box(120.0, 10.0), widget.flex()])
    val l = laid(r, 100.0, 10.0)
    test.assert_eq(rect_text(l.children[1].bounds), "120.0,0.0 0.0x10.0")
}

// Padding insets the children and the container keeps its own bounds, which is what lets a
// background paint the padded area rather than only the part the children reached.
#[test]
fn padding_insets_the_children_only() {
    val inner = box(100.0, 20.0)
    val padded = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.insets_all(5.0),
        surface: widget.no_surface(),
        align: widget.stretched(),
        children: [inner],
        name: ""
    })
    val l = laid(padded, 40.0, 30.0)
    test.assert_eq(rect_text(l.bounds), "0.0,0.0 40.0x30.0")
    test.assert_eq(rect_text(l.children[0].bounds), "5.0,5.0 30.0x20.0")
}

// **`Expand` is what lets flexibility cross a container.** A `Flex` has no children and a `Group`
// takes its natural size, so without this the commonest layout there is -- a bar of its own height
// above a content area filling the rest -- has no spelling. The first draft of this module had no
// `Expand`, and the test above is what found it: a column holding only a spacer measured zero and
// collapsed.
#[test]
fn an_expand_makes_a_subtree_take_the_leftover_space() {
    val bar = box(100.0, 20.0)
    val content = widget.expand(widget.column_of(0.0, [a_label("body")]))
    val l = laid(widget.column_of(0.0, [bar, content]), 100.0, 90.0)
    test.assert_eq(rect_text(l.children[0].bounds), "0.0,0.0 100.0x20.0")
    test.assert_eq(rect_text(l.children[1].bounds), "0.0,20.0 100.0x70.0")
    // And the expanded subtree's own child gets the whole share, not its natural size.
    test.assert_eq(rect_text(l.children[1].children[0].bounds), "0.0,20.0 100.0x70.0")
}

// Two expands share by weight exactly as two spacers do, because they are the same mechanism.
#[test]
fn two_expands_share_by_weight() {
    val l = laid(
        widget.column_of(0.0, [
            widget.expand_of(1.0, a_label("a")),
            widget.expand_of(2.0, a_label("b"))
        ]),
        50.0,
        60.0
    )
    test.assert_eq(rect_text(l.children[0].bounds), "0.0,0.0 50.0x20.0")
    test.assert_eq(rect_text(l.children[1].bounds), "0.0,20.0 50.0x40.0")
}

// An expand still measures its child, so the axis its parent does *not* distribute along is the
// child's own -- a row of expands is as tall as its tallest child, not as tall as nothing.
#[test]
fn an_expand_measures_its_child_across_the_other_axis() {
    val s = widget.measure(widget.expand(a_label("abcd")), fake_metrics())
    test.assert_eq(s.width, 40.0)
    test.assert_eq(s.height, 20.0)
}

// --- identity

// A position says where a node is; a name says what it is. **Focus follows the name**, because a
// position changes when a sibling is inserted above it and focus that moved because an unrelated
// widget appeared is a bug a user notices and a test does not.
//
// **Each node carries its own index and nothing joins them here.** It was the whole path as a
// string until the layout profile showed that building it for every node of every layout cost
// 9.7% of a pass; `a11y` joins the indices while it walks, and the paths that come out are
// asserted where they are used -- `a11y_test` keys an unnamed node by one.
#[test]
fn children_are_numbered_in_order() {
    val r = widget.row_of(0.0, [a_label("a"), widget.column_of(0.0, [a_label("b"), a_label("c")])])
    val l = laid(r, 100.0, 20.0)
    test.assert_eq(l.index, 0 - 1)
    test.assert_eq(l.children[0].index, 0)
    test.assert_eq(l.children[1].index, 1)
    test.assert_eq(l.children[1].children[1].index, 1)
}

#[test]
fn a_name_is_carried_onto_the_laid_node() {
    val l = laid(widget.named_label("Save", 10.0, black(), "save-button"), 50.0, 20.0)
    test.assert_eq(l.name, "save-button")
}

// **A name is inherited by descendants that have none**, which is what makes a click on a
// button's label report the button: a control wraps a group that wraps a label, and the nodes a
// pointer actually lands on are the inner ones. The first version passed the name down only one
// level, and a two-level nesting answered "" -- found by a hit test, not by reading it.
#[test]
fn a_name_is_inherited_through_intermediate_nodes() {
    val deep = widget.focusable_of(
        "save",
        widget.fixed_of(40.0, 20.0, widget.row_of(0.0, [a_label("Save")]))
    )
    val l = laid(deep, 40.0, 20.0)
    test.assert_eq(l.name, "save")
    test.assert_eq(l.children[0].name, "save")
    test.assert_eq(l.children[0].children[0].name, "save")
    test.assert_eq(l.children[0].children[0].children[0].name, "save")
}

// A descendant with a name of its own overrides the inherited one, so a control inside a named
// panel still answers for itself.
#[test]
fn a_nested_name_overrides_the_inherited_one() {
    val l = laid(
        widget.focusable_of("panel", widget.row_of(0.0, [widget.focusable_of("inner", a_label("x"))])),
        40.0,
        20.0
    )
    test.assert_eq(l.name, "panel")
    // `children[0]` is the row, which inherits "panel"; its child is the inner control.
    test.assert_eq(l.children[0].name, "panel")
    test.assert_eq(l.children[0].children[0].name, "inner")
}

#[test]
fn a_widget_with_no_name_has_an_empty_one() {
    test.assert_eq(laid(a_label("x"), 10.0, 10.0).name, "")
}

// --- painting

#[test]
fn a_label_paints_one_text_op() {
    val ops = widget.paint_ops(laid(a_label("hi"), 100.0, 20.0), fake_metrics())
    test.assert_len(1, ops)
}

#[test]
fn nothing_and_flex_paint_nothing() {
    test.assert_len(0, widget.paint_ops(laid(widget.Widget.Nothing, 10.0, 10.0), fake_metrics()))
    test.assert_len(0, widget.paint_ops(laid(widget.flex(), 10.0, 10.0), fake_metrics()))
}

// A background is one fill, before the children, so it sits behind them. Asserted by *order*: a
// background painted after its children hides them, and the op count alone cannot tell.
#[test]
fn a_background_paints_before_its_children() {
    val filled = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.filled(paint.white()),
        align: widget.stretched(),
        children: [a_label("hi")],
        name: ""
    })
    val ops = widget.paint_ops(laid(filled, 100.0, 20.0), fake_metrics())
    test.assert_len(2, ops)
    test.assert(scene.Op.is_Fill(ops[0]))
    test.assert(scene.Op.is_Text(ops[1]))
}

// A container with no background paints nothing of its own, which is what keeps a UI from
// overdrawing every pixel once per nesting level.
#[test]
fn a_container_without_a_background_paints_nothing_itself() {
    val ops = widget.paint_ops(laid(widget.row_of(0.0, [a_label("hi")]), 100.0, 20.0), fake_metrics())
    test.assert_len(1, ops)
}

// --- the scroll viewport

use focus

// Four rows of 50, inside a viewport 50 tall: one row visible at a time.
fn rows() -> widget.Widget {
    return widget.column_of(
        0.0,
        [
            widget.focusable_of("r0", box(80.0, 50.0)),
            widget.focusable_of("r1", box(80.0, 50.0)),
            widget.focusable_of("r2", box(80.0, 50.0)),
            widget.focusable_of("r3", box(80.0, 50.0))
        ]
    )
}

fn scrolled(offset: float) -> widget.Laid {
    return widget.layout(
        widget.scroll_of(offset, rows()),
        geom.rect_of(0.0, 0.0, 80.0, 50.0),
        fake_metrics()
    )
}

// **A viewport measures nothing**, so it must be given its size. Answering the content's size
// instead would make a viewport in a column exactly as tall as its content, and a viewport that
// cannot scroll looks right in every screenshot.
#[test]
fn a_viewport_has_no_natural_size() {
    val size = widget.measure(widget.scroll_of(0.0, rows()), fake_metrics())
    test.assert_eq(size.width, 0.0)
    test.assert_eq(size.height, 0.0)
}

// The content is laid out at its full height and shifted up by the offset, so every box inside it
// is in the same coordinates as everything else on screen.
#[test]
fn the_content_is_laid_out_whole_and_shifted() {
    val l = scrolled(100.0)
    test.assert_eq(rect_text(l.bounds), "0.0,0.0 80.0x50.0")
    val content = l.children[0]
    test.assert_eq(rect_text(content.bounds), "0.0,-100.0 80.0x200.0")
}

// **A row scrolled out of sight is not hit, and nothing had to be taught about clipping.** `at`
// rejects the viewport before it ever looks at a row, because the viewport's own bounds do not
// contain the point -- so hit testing agrees with the clip for free. This is the case that says the
// coordinate choice above was the right one.
#[test]
fn a_row_scrolled_out_of_sight_cannot_be_clicked() {
    val l = scrolled(100.0)
    // Row 2 occupies 0..50 after the shift, which is exactly the visible window.
    test.assert_eq(hit_name(l, 10.0, 25.0), "r2")
    // Row 3 sits at 50..100 -- inside the content, outside the viewport.
    test.assert_eq(hit_name(l, 10.0, 75.0), "(none)")
    // Rows 0 and 1 are above it, at negative y, which no click can reach.
    test.assert_eq(hit_name(l, 10.0, 0.0 - 25.0), "(none)")
}

// --- the focus ring follows the control's own outline

fn curves_in(path: shape.Path) -> int {
    var n = 0
    for seg in path.segments {
        switch seg {
            QuadTo(_) { n = n + 1 }
            CubicTo(_) { n = n + 1 }
            MoveTo(_) { unit }
            LineTo(_) { unit }
            Close { unit }
        }
    }
    return n
}

// The ring is the last thing `paint_focused` pushes, so it is the last op.
fn ring_of(l: widget.Laid) -> shape.Path {
    val ops = widget.paint_focused(l, fake_metrics(), "it", black(), 2.0).ops
    test.assert(len(ops) > 0)
    return fill_path(ops[len(ops) - 1])
}

fn focusable_with(radius: float) -> widget.Laid {
    return laid(
        widget.focusable_of("it", widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Row,
            spacing: 0.0,
            padding: widget.no_insets(),
            surface: widget.rounded(black(), radius),
            align: widget.stretched(),
            children: [a_label("x")],
            name: ""
        })),
        60.0,
        24.0
    )
}

// **A square ring across the corners of a rounded button**, which is what this drew until
// 2026-11-13. It was indistinguishable from right while `default_style` left `corner_radius` at
// zero, and wrong from the moment F286 made a rounded look possible.
#[test]
fn the_focus_ring_curves_when_the_control_does() {
    test.assert(curves_in(ring_of(focusable_with(8.0))) > 0)
}

// And a square control keeps a square ring, which is the half that must not move: the default
// style asks for no radius, so every window that exists today draws exactly what it did.
#[test]
fn the_focus_ring_stays_square_when_the_control_is() {
    test.assert_eq(curves_in(ring_of(focusable_with(0.0))), 0)
}

// **The radius is the control's, not a theme's**, which is the case a themed number gets wrong:
// `controls` caps a check box's radius against its own side, so a style saying 8 on a box whose
// side only carries 4 would ring it at 8 and miss the outline the control actually drew. Taken
// from the box, the two cannot disagree.
//
// Asserted on where the outline *starts*, which is exactly a radius along the top edge from the
// corner: the ring is inset by half the stroke and its radius shrinks by the same half, so on a
// box at the origin with a 2-point stroke the start lands at the radius itself. Worked out from
// the inputs rather than read back from the path.
#[test]
fn the_ring_is_drawn_at_the_radius_the_control_used() {
    test.assert_eq(start_x(ring_of(focusable_with(8.0))), 8.0)
    test.assert_eq(start_x(ring_of(focusable_with(2.0))), 2.0)
    // A square control starts at the inset corner, with no radius to walk along first.
    test.assert_eq(start_x(ring_of(focusable_with(0.0))), 1.0)
}

// Where the outline begins, which `round_rect_path` puts a radius along the top edge.
fn start_x(path: shape.Path) -> float {
    for seg in path.segments {
        switch seg {
            MoveTo(p) { return p.x }
            LineTo(_) { unit }
            QuadTo(_) { unit }
            CubicTo(_) { unit }
            Close { unit }
        }
    }
    return 0.0 - 1.0
}

// --- finding a node by its name

fn named_box(l: widget.Laid, name: string) -> string {
    return switch widget.node_named(l, name) {
        Some(one) { rect_text(one.bounds) }
        None { "(none)" }
    }
}

// **The case `focus.node_of` cannot answer, which is why this exists.** A name belongs to any
// widget with a slot for one, and the two callers that wanted this wanted exactly the ones that
// are not controls: a caret's box, which an input method is told the position of, and a canvas,
// which a builder recognises a press on. `focus` walks controls only and answers `None` for both.
#[test]
fn a_named_group_is_found_and_focus_cannot_find_it() {
    val l = laid(
        widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Column,
            spacing: 0.0,
            padding: widget.no_insets(),
            surface: widget.no_surface(),
            align: widget.stretched(),
            children: [a_label("x")],
            name: "canvas"
        }),
        40.0,
        20.0
    )
    test.assert_eq(named_box(l, "canvas"), "0.0,0.0 40.0x20.0")
    test.assert(Option.is_None(focus.node_of(l, "canvas")))
}

// A control answers the same way it always did, so this is one walk and not a second rule.
#[test]
fn a_control_is_found_by_the_same_walk() {
    val l = laid(widget.focusable_of("save", widget.fixed_of(40.0, 20.0, a_label("Save"))), 40.0, 20.0)
    test.assert_eq(named_box(l, "save"), "0.0,0.0 40.0x20.0")
}

// **The outermost, not the innermost.** A name is inherited by every child that has none of its
// own, so the node wanted is at the top of the subtree carrying it -- and the box an inner label
// happens to occupy is not the box of the thing that was named.
#[test]
fn the_outermost_node_carrying_the_name_is_the_one() {
    val l = laid(
        widget.focusable_of("panel", widget.padded_of(widget.insets_all(4.0), a_label("x"))),
        40.0,
        20.0
    )
    test.assert_eq(named_box(l, "panel"), "0.0,0.0 40.0x20.0")
}

#[test]
fn a_name_nothing_carries_is_none() {
    val l = laid(a_label("x"), 10.0, 10.0)
    test.assert_eq(named_box(l, "nobody"), "(none)")
    // And the empty name is nobody rather than everybody, which is what an unnamed node has.
    test.assert_eq(named_box(l, ""), "(none)")
}

// --- the chain under a point

fn chain_names(l: widget.Laid, x: float, y: float) -> string {
    val out = mutable_array_new<string>()
    for one in widget.chain_at(l, geom.point_of(x, y)) {
        push(out, if one.name == "" { "-" } else { one.name })
    }
    return join(separator: " ", pieces: snapshot(out))
}

// **The chain ends where `at` stops**, and that is the property worth holding: two walks that
// disagree about which branch they took would make a builder select one thing and the window
// route the click to another.
#[test]
fn the_chain_ends_at_the_node_at_would_return() {
    val l = laid(
        widget.focusable_of("panel", widget.row_of(0.0, [widget.focusable_of("inner", a_label("x"))])),
        40.0,
        20.0
    )
    val deepest = switch widget.at(l, geom.point_of(5.0, 5.0)) {
        Some(one) { one.name }
        None { "(none)" }
    }
    val chain = widget.chain_at(l, geom.point_of(5.0, 5.0))
    test.assert_eq(chain[len(chain) - 1].name, deepest)
}

// **The outer name is still reachable**, which is the whole reason this exists: a click inside a
// control made by `controls` reports that control, and whoever placed the panel it sits in has no
// other way back to its own node.
#[test]
fn the_chain_keeps_the_names_above_the_deepest() {
    val l = laid(
        widget.focusable_of("panel", widget.row_of(0.0, [widget.focusable_of("inner", a_label("x"))])),
        40.0,
        20.0
    )
    test.assert_eq(chain_names(l, 5.0, 5.0), "panel panel inner inner")
}

// Every box in the chain contains the point, it starts at the root, and it ends where `at` ends.
//
// **It is not "each box contains the next", which is what this test asserted first.** A viewport
// lays its content out whole and shifts it, so the content is routinely *taller than the
// viewport* -- 80x200 inside 80x50 here -- and a containment check on the boxes fails on the
// first scrollable thing it meets. What `walk_at` actually promises is about the point, not about
// the boxes, and the clip is already handled by refusing to descend into a box the point is
// outside of.
#[test]
fn every_box_in_the_chain_contains_the_point() {
    val l = scrolled(0.0)
    val p = geom.point_of(10.0, 25.0)
    val chain = widget.chain_at(l, p)
    test.assert(len(chain) > 1)
    for one in chain {
        test.assert(widget.contains(one.bounds, p))
    }
    test.assert_eq(rect_text(chain[0].bounds), rect_text(l.bounds))
    test.assert_eq(chain[len(chain) - 1].name, "r0")
}

// The case that made the invariant above the right one: the content of a viewport is bigger than
// the viewport, and both are in the chain.
#[test]
fn a_viewports_content_is_bigger_than_the_viewport_and_both_are_in_the_chain() {
    val chain = widget.chain_at(scrolled(0.0), geom.point_of(10.0, 25.0))
    test.assert_eq(rect_text(chain[0].bounds), "0.0,0.0 80.0x50.0")
    test.assert_eq(rect_text(chain[1].bounds), "0.0,0.0 80.0x200.0")
}

// A point outside the tree is an empty chain, not a chain of one.
#[test]
fn a_point_outside_the_tree_has_no_chain() {
    val l = scrolled(0.0)
    test.assert_len(0, widget.chain_at(l, geom.point_of(0.0 - 1.0, 10.0)))
    test.assert_len(0, widget.chain_at(l, geom.point_of(10.0, 400.0)))
}

// The clip agrees, the same way it does for `at`: a row shifted out of the viewport is not in the
// chain, because the viewport is rejected before its rows are looked at.
#[test]
fn a_row_scrolled_out_of_sight_is_not_in_the_chain() {
    val l = scrolled(100.0)
    test.assert_eq(chain_names(l, 10.0, 75.0), "")
}

fn hit_name(l: widget.Laid, x: float, y: float) -> string {
    return switch focus.control_at(l, geom.point_of(x, y)) {
        Some(one) { one.name }
        None { "(none)" }
    }
}

// **Tab still reaches a row the window is not showing**, which is deliberate and is why the
// children stay in the tree: a keyboard user arrows into a row, and the application scrolls to it.
// A viewport that pruned what it could not show would strand the keyboard at the bottom edge.
#[test]
fn every_row_is_still_reachable_by_name() {
    val l = scrolled(100.0)
    test.assert_len(4, focus.controls(l))
    test.assert_eq(focus.first(l), "r0")
    test.assert(focus.holds(l, "r0"))
    test.assert(focus.holds(l, "r3"))
}

// --- scrolling arithmetic

// **Scrolls by the least that works, and not at all when the target is already visible**, which is
// what makes arrowing through a list creep by one row instead of re-centring and jumping.
#[test]
fn revealing_a_target_scrolls_the_least_that_works() {
    // View 50 tall, offset 0, target the row at 50..100: just past the bottom edge.
    test.assert_eq(widget.scroll_to_reveal(50.0, 0.0, 50.0, 50.0), 50.0)
    // Already visible: unchanged.
    test.assert_eq(widget.scroll_to_reveal(50.0, 0.0, 0.0, 50.0), 0.0)
    test.assert_eq(widget.scroll_to_reveal(50.0, 50.0, 60.0, 20.0), 50.0)
    // Above the view: align to its start.
    test.assert_eq(widget.scroll_to_reveal(50.0, 100.0, 50.0, 50.0), 50.0)
    // Taller than the view: show its top, since no offset shows all of it.
    test.assert_eq(widget.scroll_to_reveal(50.0, 0.0, 20.0, 200.0), 20.0)
}

#[test]
fn an_offset_cannot_pass_either_end() {
    // Content 200 in a view of 50: the furthest is 150.
    test.assert_eq(widget.clamp_offset(400.0, 50.0, 200.0), 150.0)
    test.assert_eq(widget.clamp_offset(0.0 - 10.0, 50.0, 200.0), 0.0)
    test.assert_eq(widget.clamp_offset(75.0, 50.0, 200.0), 75.0)
    // **Content smaller than its view clamps to zero, not to a negative.** Without the zero floor
    // a short list would scroll upward off the top of its own box.
    test.assert_eq(widget.clamp_offset(30.0, 200.0, 50.0), 0.0)
}

// --- painting

// **The viewport's children are painted inside a clip**, which is the one thing adding this case
// did not force: the seven switches over `Widget` all refused to compile until it was handled, but
// `collect` tests its cases with `if`, so a viewport that forgot to clip would have drawn its
// content straight across the window and compiled cleanly.
#[test]
fn a_viewport_paints_its_content_inside_a_clip() {
    val s = widget.paint(scrolled(100.0), fake_metrics())
    test.assert_len(1, s.ops)
    test.assert(is_clipped(s.ops[0]))
}

fn is_clipped(op: scene.Op) -> bool {
    return switch op {
        Nested(g) { !Option.is_None(g.clip) }
        Fill(_) { false }
        StrokePath(_) { false }
        Text(_) { false }
        DrawImage(_) { false }
    }
}

// --- the density, and which input wins

fn source_name(r: widget.Resolved) -> string {
    return switch r.from {
        UserSetting { "user" }
        Display { "display" }
        Default { "default" }
    }
}

// **The user wins, because they are the one looking at it.** A display's reported density is a
// guess about a person's eyes and desk from the number of pixels on a panel: right often enough to
// be the default, wrong often enough that overriding it has to be possible.
#[test]
fn a_user_setting_outranks_the_display() {
    val r = widget.resolve_density(Option<float>.Some(1.25), Option<float>.Some(2.0))
    test.assert_eq(r.density.px_per_pt, 1.25)
    test.assert_eq(source_name(r), "user")
}

#[test]
fn the_display_decides_when_the_user_has_not() {
    val r = widget.resolve_density(Option<float>.None, Option<float>.Some(1.5))
    test.assert_eq(r.density.px_per_pt, 1.5)
    test.assert_eq(source_name(r), "display")
}

#[test]
fn a_point_is_a_pixel_when_nothing_says_otherwise() {
    val r = widget.resolve_density(Option<float>.None, Option<float>.None)
    test.assert_eq(r.density.px_per_pt, 1.0)
    test.assert_eq(source_name(r), "default")
}

// **A mistyped setting is dropped rather than refused**, so the UI still renders -- and `from` is
// what makes the dropping visible. Without it the only symptom is a window of the wrong size for a
// reason nothing explains.
#[test]
fn a_nonsense_setting_falls_through_and_says_so() {
    val zero = widget.resolve_density(Option<float>.Some(0.0), Option<float>.Some(2.0))
    test.assert_eq(zero.density.px_per_pt, 2.0)
    test.assert_eq(source_name(zero), "display")

    val enormous = widget.resolve_density(Option<float>.Some(500.0), Option<float>.None)
    test.assert_eq(enormous.density.px_per_pt, 1.0)
    test.assert_eq(source_name(enormous), "default")

    val negative = widget.resolve_density(Option<float>.Some(0.0 - 2.0), Option<float>.Some(0.0))
    test.assert_eq(negative.density.px_per_pt, 1.0)
    test.assert_eq(source_name(negative), "default")
}

// **Whatever this answers, the renderer must accept**, which is why the bound here is the bound
// `raster` refuses at. A resolver that could produce a density the renderer rejects would turn a
// bad setting into a failed render instead of a fallback.
#[test]
fn a_resolved_density_is_always_one_the_renderer_takes() {
    val widest = widget.resolve_density(Option<float>.Some(64.0), Option<float>.None)
    test.assert_eq(widest.density.px_per_pt, 64.0)
    test.assert_eq(source_name(widest), "user")
    val past = widget.resolve_density(Option<float>.Some(64.1), Option<float>.None)
    test.assert_eq(source_name(past), "default")
}

// The two edges: a size goes out in pixels, a pointer comes in as points.
#[test]
fn the_two_conversions_are_inverses() {
    val d = widget.density_of(1.5)
    test.assert_eq(widget.to_px(d, 100.0), 150.0)
    test.assert_eq(widget.to_pt(d, 150.0), 100.0)
    val p = widget.point_in_pt(d, 30.0, 60.0)
    test.assert_eq(p.x, 20.0)
    test.assert_eq(p.y, 40.0)
}

// --- overlays: a popup and a dialog

use a11y

fn behind() -> widget.Widget {
    return widget.row_of(
        0.0,
        [widget.focusable_of("open", box(40.0, 20.0)), widget.focusable_of("other", box(40.0, 20.0))]
    )
}

fn dialog_content() -> widget.Widget {
    return widget.column_of(
        0.0,
        [widget.focusable_of("ok", box(30.0, 10.0)), widget.focusable_of("cancel", box(30.0, 10.0))]
    )
}

fn with_dialog() -> widget.Laid {
    return widget.layout(
        widget.layered_of([widget.base_layer(behind()), widget.modal_layer(dialog_content())]),
        geom.rect_of(0.0, 0.0, 80.0, 40.0),
        fake_metrics()
    )
}

// A popup placed at a rect, not covering the window: the menu bar beneath stays reachable.
fn with_popup() -> widget.Laid {
    return widget.layout(
        widget.layered_of([
            widget.base_layer(behind()),
            widget.layer_at(geom.rect_of(0.0, 20.0, 40.0, 20.0), true, widget.focusable_of("item", box(40.0, 20.0)))
        ]),
        geom.rect_of(0.0, 0.0, 80.0, 40.0),
        fake_metrics()
    )
}

// **Pointer capture is geometry.** A layer given the whole box is the last sibling containing any
// point, so a click beside the dialog's buttons lands on the layer, finds no control, and goes
// nowhere. No flag says so; the rectangle does.
#[test]
fn a_full_box_layer_swallows_clicks_that_miss_it() {
    val l = with_dialog()
    // On the dialog's first button.
    test.assert_eq(hit_name(l, 5.0, 5.0), "ok")
    // Beside the buttons but inside the window: the layer covers it, and nothing there is a control.
    test.assert_eq(hit_name(l, 70.0, 35.0), "(none)")
}

// **And a layer with a rect does not.** A click above the popup reaches the menu bar under it,
// which is what makes a menu dismissible by clicking away from it.
#[test]
fn a_placed_layer_lets_clicks_past_it() {
    val l = with_popup()
    // Inside the popup.
    test.assert_eq(hit_name(l, 10.0, 30.0), "item")
    // Above it, where the row behind is.
    test.assert_eq(hit_name(l, 10.0, 5.0), "open")
    test.assert_eq(hit_name(l, 50.0, 5.0), "other")
}

// **Keyboard capture is declared, because no rectangle says where Tab may go.** The dialog's layer
// claims it, so Tab sees two controls and not four.
#[test]
fn a_layer_that_claims_the_keyboard_traps_tab() {
    val l = with_dialog()
    test.assert_eq(names_in(l), "ok cancel")
    test.assert_eq(focus.first(l), "ok")
    test.assert_eq(focus.next(l, "cancel"), "ok")
    test.assert_false(focus.holds(l, "open"))
}

fn names_in(l: widget.Laid) -> string {
    val out = mutable_array_new<string>()
    for one in focus.controls(l) {
        push(out, one.name)
    }
    return join(separator: " ", pieces: snapshot(out))
}

// A layer that does not claim it leaves the whole window in the tab order -- a tooltip must not
// steal the keyboard.
#[test]
fn a_layer_that_does_not_claim_the_keyboard_leaves_tab_alone() {
    val l = widget.layout(
        widget.layered_of([
            widget.base_layer(behind()),
            widget.layer_at(geom.rect_of(0.0, 20.0, 40.0, 20.0), false, widget.focusable_of("tip", box(40.0, 20.0)))
        ]),
        geom.rect_of(0.0, 0.0, 80.0, 40.0),
        fake_metrics()
    )
    test.assert_eq(names_in(l), "open other tip")
}

// **The reader is trapped by the same rule Tab is, from the same function.** A dialog that caught
// Tab while a screen reader still described the window behind it would be worse than one that
// caught neither, because the sighted user would see it working.
#[test]
fn a_modal_layer_hides_the_window_from_a_reader_too() {
    val t = a11y.tree_of(with_dialog(), "Records", "ok")
    val keys = mutable_array_new<string>()
    for one in t.nodes {
        push(keys, one.key)
    }
    test.assert_eq(join(separator: " ", pieces: snapshot(keys)), "@ ok cancel")
    test.assert_len(2, a11y.reachable(t))
}

// Later layers paint over earlier ones, which is the whole point of the order.
#[test]
fn layers_paint_in_order() {
    val over = widget.layout(
        widget.layered_of([
            widget.base_layer(widget.Widget.Group(widget.Stack {
                direction: widget.Direction.Row,
                spacing: 0.0,
                padding: widget.no_insets(),
                surface: widget.filled(black()),
                align: widget.stretched(),
                children: [],
                name: "under"
            })),
            widget.base_layer(widget.Widget.Group(widget.Stack {
                direction: widget.Direction.Row,
                spacing: 0.0,
                padding: widget.no_insets(),
                surface: widget.filled(black()),
                align: widget.stretched(),
                children: [],
                name: "over"
            }))
        ]),
        geom.rect_of(0.0, 0.0, 10.0, 10.0),
        fake_metrics()
    )
    val s = widget.paint(over, fake_metrics())
    test.assert_len(2, s.ops)
    test.assert_eq(over.children[0].name, "under")
    test.assert_eq(over.children[1].name, "over")
}

// **A layered node does not clip**, which is the opposite of a viewport: a layer keeps the rect it
// was given even where that exceeds its parent, so a popup can overhang.
//
// And the limit of that, which this case exists to state: **painting past an ancestor is not the
// same as being clickable past one.** `widget.at` rejects a node whose bounds exclude the point
// before it looks at any child, so a layer hanging outside the group that holds it draws and cannot
// be hit. The first version of this case asserted the opposite and failed, which is how the rule
// got written down -- and it is why an overlay belongs in the *root's* layer list rather than beside
// the thing it is anchored to.
#[test]
fn a_layer_keeps_a_rect_that_overhangs_its_parent() {
    val inner = widget.layered_of([
        widget.base_layer(behind()),
        widget.layer_at(geom.rect_of(0.0, 10.0, 40.0, 40.0), true, widget.focusable_of("tall", box(40.0, 40.0)))
    ])
    val l = widget.layout(
        widget.column_of(0.0, [widget.fixed_of(80.0, 20.0, inner)]),
        geom.rect_of(0.0, 0.0, 80.0, 60.0),
        fake_metrics()
    )
    val layered = l.children[0].children[0]
    // The layer kept its rect, 30 units past the 20-tall box holding it.
    test.assert_eq(rect_text(layered.children[1].bounds), "0.0,10.0 40.0x40.0")
    // Inside both: reachable.
    test.assert_eq(hit_name(l, 10.0, 15.0), "tall")
    // Past the holding box, inside the window: painted there, and not reachable.
    test.assert_eq(hit_name(l, 10.0, 40.0), "(none)")
}

// ------------------------------------------------------- the surface (2026-11-12)

fn surfaced(s: widget.Surface) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: s,
        align: widget.stretched(),
        children: [],
        name: ""
    })
}

fn ops_of(s: widget.Surface) -> [scene.Op] {
    return widget.paint_ops(laid(surfaced(s), 100.0, 40.0), fake_metrics())
}

// Whether a path curves. **This is how "rounded" is asserted**, and it is the honest question: a
// square corner is two lines meeting and a round one is a cubic, so a path with no cubic in it has
// no rounded corner whatever its numbers said.
fn has_curve(p: shape.Path) -> bool {
    for segment in p.segments {
        if CubicTo(_) = segment {
            return true
        }
        if QuadTo(_) = segment {
            return true
        }
    }
    return false
}

fn first_point(p: shape.Path) -> geom.Point {
    for segment in p.segments {
        if MoveTo(at) = segment {
            return at
        }
    }
    test.fail("a path with no MoveTo")
    return geom.point_of(0.0, 0.0)
}

fn fill_path(op: scene.Op) -> shape.Path {
    switch op {
        Fill(it) { return it.path }
        StrokePath(it) { return it.path }
        Text(_) { test.fail("expected a fill or a stroke, got text") }
        DrawImage(_) { test.fail("expected a fill or a stroke, got an image") }
        Nested(_) { test.fail("expected a fill or a stroke, got a group") }
    }
    return shape.rect_path(geom.rect_of(0.0, 0.0, 0.0, 0.0))
}

#[test]
fn a_surface_that_asks_for_nothing_paints_nothing() {
    test.assert_len(0, ops_of(widget.no_surface()))
}

#[test]
fn a_filled_surface_is_one_square_fill() {
    val ops = ops_of(widget.filled(paint.white()))
    test.assert_len(1, ops)
    test.assert(scene.Op.is_Fill(ops[0]))
    test.assert_false(has_curve(fill_path(ops[0])))
}

// **A radius of zero is a rectangle, not four degenerate arcs**, which almost every container in
// any look and feel relies on. The guarantee is `shape.round_rect_path`'s own -- it answers a plain
// rectangle at or below zero -- and this pins it from here because that is where it is depended on:
// `paint_surface` used to repeat the check itself, and mutation testing found the repeat by leaving
// the mutant alive.
#[test]
fn a_zero_radius_builds_a_rectangle_rather_than_arcs() {
    val square = widget.Surface {
        fill: Option<paint.Color>.Some(paint.white()),
        border: Option<widget.Border>.None,
        corner_radius: 0.0
    }
    val ops = ops_of(square)
    test.assert_len(1, ops)
    test.assert_false(has_curve(fill_path(ops[0])))
}

#[test]
fn a_corner_radius_rounds_the_fill() {
    val rounded = widget.Surface {
        fill: Option<paint.Color>.Some(paint.white()),
        border: Option<widget.Border>.None,
        corner_radius: 6.0
    }
    val ops = ops_of(rounded)
    test.assert_len(1, ops)
    test.assert(has_curve(fill_path(ops[0])))
}

// A border is its own op, and **after** the fill: a border painted first is a border behind the
// thing it outlines, and half of it disappears under the fill.
#[test]
fn a_border_strokes_after_the_fill() {
    val edged = widget.Surface {
        fill: Option<paint.Color>.Some(paint.white()),
        border: Option<widget.Border>.Some(widget.border_of(paint.black(), 2.0)),
        corner_radius: 0.0
    }
    val ops = ops_of(edged)
    test.assert_len(2, ops)
    test.assert(scene.Op.is_Fill(ops[0]))
    test.assert(scene.Op.is_StrokePath(ops[1]))
}

#[test]
fn a_border_without_a_fill_is_just_the_stroke() {
    val outline = widget.Surface {
        fill: Option<paint.Color>.None,
        border: Option<widget.Border>.Some(widget.border_of(paint.black(), 2.0)),
        corner_radius: 0.0
    }
    val ops = ops_of(outline)
    test.assert_len(1, ops)
    test.assert(scene.Op.is_StrokePath(ops[0]))
}

// **The border lands inside the box**, which is the one piece of arithmetic here: a stroke
// straddles the path it follows, so a width-4 border along the bounds would hang two points over
// the edge and into whatever is beside it. The path is inset by half the width, so the first point
// of it is at 2.0 rather than 0.0 -- the same bargain `paint_focused`'s ring makes.
#[test]
fn a_border_is_stroked_inside_the_bounds() {
    val edged = widget.Surface {
        fill: Option<paint.Color>.None,
        border: Option<widget.Border>.Some(widget.border_of(paint.black(), 4.0)),
        corner_radius: 0.0
    }
    val ops = ops_of(edged)
    test.assert_len(1, ops)
    val at = first_point(fill_path(ops[0]))
    test.assert_eq(at.x, 2.0)
    test.assert_eq(at.y, 2.0)
}

#[test]
fn a_border_keeps_the_width_it_was_given() {
    val edged = widget.Surface {
        fill: Option<paint.Color>.None,
        border: Option<widget.Border>.Some(widget.border_of(paint.black(), 3.0)),
        corner_radius: 0.0
    }
    val ops = ops_of(edged)
    switch ops[0] {
        StrokePath(it) { test.assert_eq(it.stroke.width, 3.0) }
        Fill(_) { test.fail("wrong op") }
        Text(_) { test.fail("wrong op") }
        DrawImage(_) { test.fail("wrong op") }
        Nested(_) { test.fail("wrong op") }
    }
}

#[test]
fn a_rounded_border_curves_too() {
    val edged = widget.Surface {
        fill: Option<paint.Color>.None,
        border: Option<widget.Border>.Some(widget.border_of(paint.black(), 2.0)),
        corner_radius: 8.0
    }
    val ops = ops_of(edged)
    test.assert(has_curve(fill_path(ops[0])))
}

// **A thick border on a small radius squares off rather than inverting.** The border's path shrinks
// its radius by half the stroke width so the curve stays concentric with the fill's, and a 1-point
// radius under a 6-point border asks for -2 -- which `shape.round_rect_path` answers as a
// rectangle. Delegated rather than clamped twice.
#[test]
fn a_border_thicker_than_the_radius_squares_off_rather_than_inverting() {
    val edged = widget.Surface {
        fill: Option<paint.Color>.None,
        border: Option<widget.Border>.Some(widget.border_of(paint.black(), 6.0)),
        corner_radius: 1.0
    }
    val ops = ops_of(edged)
    test.assert_len(1, ops)
    test.assert_false(has_curve(fill_path(ops[0])))
}

// The fill keeps its own radius when the border squares off -- the clamp is the border's, not the
// surface's.
#[test]
fn the_clamp_is_the_borders_and_not_the_fills() {
    val edged = widget.Surface {
        fill: Option<paint.Color>.Some(paint.white()),
        border: Option<widget.Border>.Some(widget.border_of(paint.black(), 6.0)),
        corner_radius: 1.0
    }
    val ops = ops_of(edged)
    test.assert_len(2, ops)
    test.assert(has_curve(fill_path(ops[0])))
    test.assert_false(has_curve(fill_path(ops[1])))
}

// ----------------------------------------------------- alignment (2026-11-12)

fn aligned_row(a: widget.Alignment, children: [widget.Widget]) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: a,
        children: children,
        name: ""
    })
}

fn aligned_column(a: widget.Alignment, children: [widget.Widget]) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: a,
        children: children,
        name: ""
    })
}

fn of(across: widget.Across, along: widget.Along) -> widget.Alignment {
    return widget.Alignment { across: across, along: along }
}

// A 20x10 box, so that "stretched" and "its natural size" are different numbers.
fn small() -> widget.Widget {
    return widget.fixed_of(20.0, 10.0, widget.Widget.Nothing)
}

fn child_box(w: widget.Widget, width: float, height: float) -> geom.Rect {
    return widget.layout(w, geom.rect_of(0.0, 0.0, width, height), fake_metrics()).children[0].bounds
}

// **The default is what this layer always did**, and the whole change rests on it: a stack hands
// each child the parent's full extent across its direction. Everything existing keeps its layout
// because `stretched()` is what every literal was given.
#[test]
fn the_default_stretches_across_and_packs_from_the_start() {
    val box = child_box(aligned_row(widget.stretched(), [small()]), 100.0, 40.0)
    test.assert_eq(box.x, 0.0)
    test.assert_eq(box.y, 0.0)
    test.assert_eq(box.height, 40.0)
}

#[test]
fn across_start_gives_a_child_its_natural_size() {
    val box = child_box(aligned_row(of(widget.Across.Start, widget.Along.Start), [small()]), 100.0, 40.0)
    test.assert_eq(box.y, 0.0)
    test.assert_eq(box.height, 10.0)
}

#[test]
fn across_centre_halves_the_room_left_over() {
    val box = child_box(aligned_row(of(widget.Across.Centre, widget.Along.Start), [small()]), 100.0, 40.0)
    test.assert_eq(box.height, 10.0)
    test.assert_eq(box.y, 15.0)
}

#[test]
fn across_end_puts_the_child_against_the_far_side() {
    val box = child_box(aligned_row(of(widget.Across.End, widget.Along.Start), [small()]), 100.0, 40.0)
    test.assert_eq(box.y, 30.0)
}

// A column aligns across its *width*, which is the axis a row does not. Both directions, because
// one `switch` getting them the wrong way round is the obvious bug here and it would pass every
// row-only test.
#[test]
fn a_column_aligns_across_its_width() {
    val box = child_box(aligned_column(of(widget.Across.Centre, widget.Along.Start), [small()]), 100.0, 40.0)
    test.assert_eq(box.width, 20.0)
    test.assert_eq(box.x, 40.0)
}

#[test]
fn along_centre_shifts_the_first_child_by_half_the_spare() {
    val box = child_box(aligned_row(of(widget.Across.Stretch, widget.Along.Centre), [small()]), 100.0, 40.0)
    test.assert_eq(box.x, 40.0)
}

#[test]
fn along_end_packs_the_children_against_the_end() {
    val box = child_box(aligned_row(of(widget.Across.Stretch, widget.Along.End), [small()]), 100.0, 40.0)
    test.assert_eq(box.x, 80.0)
}

// **Several children keep their gaps and move together.** Aligning along the direction shifts
// where the run starts; it does not redistribute the space between them, which is a different
// feature (`space-between`) and not one anything has asked for.
#[test]
fn along_centre_moves_the_whole_run_and_not_the_gaps() {
    val row = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 10.0,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: of(widget.Across.Stretch, widget.Along.Centre),
        children: [small(), small()],
        name: ""
    })
    val laid = widget.layout(row, geom.rect_of(0.0, 0.0, 100.0, 40.0), fake_metrics())
    // 20 + 10 + 20 = 50 of content in 100, so 25 of spare before the first.
    test.assert_eq(laid.children[0].bounds.x, 25.0)
    test.assert_eq(laid.children[1].bounds.x, 55.0)
}

// **A flexible child eats the spare room, so aligning along the direction does nothing** -- and
// that falls out of the arithmetic rather than being a case anyone has to remember. Asserted
// because the obvious implementation adds the shift unconditionally and pushes the content off
// the end of a container it exactly fills.
#[test]
fn a_flexible_child_leaves_no_spare_to_align_into() {
    val row = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: of(widget.Across.Stretch, widget.Along.End),
        children: [small(), widget.flex()],
        name: ""
    })
    val laid = widget.layout(row, geom.rect_of(0.0, 0.0, 100.0, 40.0), fake_metrics())
    test.assert_eq(laid.children[0].bounds.x, 0.0)
}

// A child bigger than its room overflows at the end rather than being centred off the near side,
// which is what an unclamped `(room - natural) / 2` would do: a negative shift puts a child above
// the top of its own parent.
#[test]
fn a_child_too_big_to_align_is_not_pushed_backwards() {
    val big = widget.fixed_of(20.0, 80.0, widget.Widget.Nothing)
    val box = child_box(aligned_row(of(widget.Across.Centre, widget.Along.Start), [big]), 100.0, 40.0)
    test.assert_eq(box.y, 0.0)
    test.assert_eq(box.height, 40.0)
}

#[test]
fn padding_is_taken_off_before_anything_is_aligned() {
    val row = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.insets_all(10.0),
        surface: widget.no_surface(),
        align: of(widget.Across.Centre, widget.Along.Centre),
        children: [small()],
        name: ""
    })
    val box = widget.layout(row, geom.rect_of(0.0, 0.0, 100.0, 40.0), fake_metrics()).children[0].bounds
    // 80 of inner width for 20 of child, so 30 each side, plus the 10 of padding.
    test.assert_eq(box.x, 40.0)
    // 20 of inner height for 10 of child, so 5 each side, plus the 10.
    test.assert_eq(box.y, 15.0)
}

// ------------------------------------------------------- padding (2026-11-13)

#[test]
fn padding_adds_itself_to_what_the_child_measured() {
    val child = widget.fixed_of(40.0, 20.0, widget.Widget.Nothing)
    val bare = widget.measure(child, fake_metrics())
    val padded = widget.measure(widget.padded_of(widget.insets_all(6.0), child), fake_metrics())
    test.assert_eq(padded.width, bare.width + 12.0)
    test.assert_eq(padded.height, bare.height + 12.0)
}

#[test]
fn padding_moves_the_child_inside_it() {
    val child = widget.fixed_of(40.0, 20.0, widget.Widget.Nothing)
    val laid = widget.layout(
        widget.padded_of(widget.insets_of(5.0, 7.0, 0.0, 0.0), child),
        geom.rect_of(0.0, 0.0, 100.0, 50.0),
        fake_metrics()
    )
    test.assert_eq(laid.children[0].bounds.x, 5.0)
    test.assert_eq(laid.children[0].bounds.y, 7.0)
}

// **No insets is not the same as no wrapper, and it should be.** A design file that pads nothing
// still writes the call, so the node has to be transparent when its insets are zero.
#[test]
fn no_padding_leaves_the_child_where_it_was() {
    val child = widget.fixed_of(40.0, 20.0, widget.Widget.Nothing)
    val laid = widget.layout(
        widget.padded_of(widget.no_insets(), child),
        geom.rect_of(0.0, 0.0, 100.0, 50.0),
        fake_metrics()
    )
    test.assert_eq(laid.children[0].bounds.x, 0.0)
    test.assert_eq(laid.children[0].bounds.y, 0.0)
    test.assert_eq(
        widget.measure(widget.padded_of(widget.no_insets(), child), fake_metrics()).width,
        widget.measure(child, fake_metrics()).width
    )
}

#[test]
fn a_rounded_surface_fills_and_curves_but_does_not_edge() {
    val ops = ops_of(widget.rounded(paint.white(), 6.0))
    test.assert_len(1, ops)
    test.assert(scene.Op.is_Fill(ops[0]))
    test.assert(has_curve(fill_path(ops[0])))
}

// **Nothing behind it**, which is the whole point of an outline: a ghost panel shows what is
// under it. A fill of any colour, including a transparent one, would be an op that paints.
#[test]
fn an_outlined_surface_paints_no_fill_at_all() {
    val ops = ops_of(widget.outlined(paint.black(), 2.0, 4.0))
    test.assert_len(1, ops)
    test.assert(scene.Op.is_StrokePath(ops[0]))
}

#[test]
fn an_edged_surface_does_both_in_order() {
    val ops = ops_of(widget.edged(paint.white(), paint.black(), 2.0, 5.0))
    test.assert_len(2, ops)
    test.assert(scene.Op.is_Fill(ops[0]))
    test.assert(scene.Op.is_StrokePath(ops[1]))
    test.assert(has_curve(fill_path(ops[0])))
}
