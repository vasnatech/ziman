// What each kind of paint costs, against the solid fill beside it.
//
// **Written because the ui_frame benchmark could not see this.** Every fill there is a solid
// colour, which goes through `composite_row_flat`; a gradient is evaluated per covered pixel -- an
// inverse transform, a search through the stops, a lerp -- so the two paths had diverged by a
// factor nobody was measuring. A full-canvas solid fill of 1280x800 took 47 ms and the same fill
// with a linear gradient took 2625 ms: 56x for a scene that looks no more complicated.
//
// Measured history, interleaved two binaries in the same minute (the only method this machine's
// timings support -- see tests/bench/ui_frame.zm):
//
//   | 1280x800, full canvas | per-pixel | native | ratio |
//   | --------------------- | --------- | ------ | ----- |
//   | linear gradient       | 2524 ms   | 67 ms  | 37.6x |
//   | radial gradient       | 2481 ms   | 52 ms  | 47.7x |
//   | tiled pattern         | 2871 ms   | 55 ms  | 52.2x |
//   | placed image          | 2632 ms   | 54 ms  | 48.7x |
//   | solid, for comparison | 51 ms     | 47 ms  | 1.0x  |
//
// The solid column is why it is here as well as the gradients: a fast path for one ink must not
// cost the other anything, and the once-per-fill spec call that decides which path to take was
// measured at about 1% of a ui_frame frame and nothing on fills alone.
//
// The `x20` cases say whether the cost is per fill or per pixel: twenty bands covering the same
// canvas cost the same as one, so it is per pixel, which is what a row-level native can fix.
//
// Run: `./ziman tests/bench/paint_fill.zm` (from the repository root).
use clock
use geom
use image
use paint
use raster
use scene
use shape

fn bench(label: string, s: scene.Scene, o: raster.Options) {
    val t0 = clock.monotonic_millis()
    switch raster.render(s, o) {
        Ok(img) {
            printf("{}  {} ops  {} ms\n", label, str(scene.op_count(s)), str(clock.monotonic_millis() - t0))
            val _ = img
        }
        Err(why) { print(concat("refused: ", why)) }
    }
}

// A small RGBA tile with varying alpha, so the premultiply path is exercised.
fn tile(n: int) -> image.Image {
    val c = unwrap(image.canvas(n, n, image.Pixels.Rgba8))
    for y in 0..n {
        for x in 0..n {
            val _ = image.set(c, x, y, paint.rgba(
                (x as float) / (n as float),
                (y as float) / (n as float),
                0.5,
                if (x + y) % 2 == 0 { 1.0 } else { 0.5 }
            ))
        }
    }
    return image.snapshot_image(c)
}

fn panels(width: float, height: float, ink: paint.Paint, count: int) -> scene.Scene {
    val ops = mutable_array_new<scene.Op>()
    for i in 0..count {
        val y = (i as float) * (height / (count as float))
        push(ops, scene.fill(shape.rect_path(geom.rect_of(0.0, y, width, height / (count as float))), ink))
    }
    return scene.with_ops(scene.scene_of(width, height), snapshot(ops))
}

fn main() {
    val solid = paint.Paint.Solid(paint.rgb(0.2, 0.45, 0.85))
    val linear = paint.Paint.LinearGradient(paint.Linear {
        from: geom.point_of(0.0, 0.0),
        to: geom.point_of(1280.0, 800.0),
        stops: [
            paint.stop_of(0.0, paint.rgb(0.9, 0.2, 0.1)),
            paint.stop_of(0.5, paint.rgb(0.1, 0.8, 0.3)),
            paint.stop_of(1.0, paint.rgb(0.1, 0.2, 0.9))
        ]
    })
    val radial = paint.Paint.RadialGradient(paint.Radial {
        centre: geom.point_of(640.0, 400.0),
        radius: 500.0,
        stops: [
            paint.stop_of(0.0, paint.rgb(1.0, 1.0, 0.4)),
            paint.stop_of(1.0, paint.rgb(0.2, 0.1, 0.5))
        ]
    })
    val o = with raster.options() { samples: 4, background: Option<paint.Color>.Some(paint.white()) }
    // One full-canvas fill of each, so the comparison is per-pixel paint evaluation and nothing else.
    bench("1280x800 solid   ", panels(1280.0, 800.0, solid, 1), o)
    bench("1280x800 linear  ", panels(1280.0, 800.0, linear, 1), o)
    bench("1280x800 radial  ", panels(1280.0, 800.0, radial, 1), o)
    bench("1280x800 solid x20 ", panels(1280.0, 800.0, solid, 20), o)
    bench("1280x800 linear x20", panels(1280.0, 800.0, linear, 20), o)
    // The two image inks, which need an image in `Options`.
    val with_image = with o { images: [tile(16)] }
    bench("1280x800 pattern ", panels(1280.0, 800.0, paint.Paint.Pattern(paint.Tiled {
        image: 0,
        transform: geom.identity()
    }), 1), with_image)
    bench("1280x800 placed  ", scene.with_ops(scene.scene_of(1280.0, 800.0), [
        scene.image(0, geom.rect_of(0.0, 0.0, 1280.0, 800.0))
    ]), with_image)
}
