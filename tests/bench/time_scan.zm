// **What a formatted timestamp costs to read and to write**, which is where the North Star's
// Apple Health import spends about 8% of itself (`time::parse_fields_prefix` 4.6%,
// `time::format_fields` 3.6% of a 20,000-record profile) -- one parse and one format per record.
//
// The pattern is Apple Health's own, `yyyy-MM-dd HH:mm:ss Z`, which is thirteen parts: six numeric
// fields, six literals and a basic-form offset. Both directions walk `fmt.parts` and do a little
// interpreted work per part, so the cost is the part count rather than the string length.
//
// **What a `switch` cost per arm, and what fixing it was worth (F268, 2026-11-04).** A `switch` is
// lowered to a chain of `if EnumName.is_V($sw)` tests, and `eval_enum_access` used to redo, on
// every one of those tests, work that belongs to the node: `find_enum` is a linear scan with a
// `strcmp` over every enum the module declares, and the constructor test then compares
// `member_name` against every variant before the `is_`/`unwrap_` prefixes are looked at. A
// fourteen-arm switch paid all of it per arm it passed over.
//
//     a parse    25 us -> 18 us (arms reordered) -> 16-17 us (the node resolves once)
//     a format   20 us -> 14 us                  -> 11-12 us
//
// **A third off a parse and over 40% off a format**, on three passes with the machine otherwise
// idle. The arm reorder came first and was the evidence: moving `Literal`, which is six of this
// pattern's thirteen parts, from fourteenth place to first was worth 18% of a format by itself.
// That reorder is **gone again** -- with the node resolving once, arm order is worth 6-8% rather
// than 28-30%, and a library should not carry a fragile ordering to suit the interpreter's
// dispatch. The figures above are with the arms back in declaration order.
//
// **And it does not measurably move either real workload**, which belongs here next to the win.
// The North Star's import, where these two functions are 4.6% and 3.6% of a profile: 21.8-23.0 s
// over three passes at 20,000 records, against 22.6-23.4 s before -- overlapping, because 40% of
// 8% is 3% and this machine's spread is larger than that. `tests/bench/server_load.sh` likewise.
// What the change is worth is spread thinly across every `switch` in every program, which is where
// the `Option` and `Result` matches live, and no single workload will show it.
use clock
use math
use os
use time

val apple = time.datetime_format_of("yyyy-MM-dd HH:mm:ss Z")

fn parse_ms(texts: [string], n: int) -> int {
    val started = clock.monotonic_millis()
    var ok_count = 0
    for i in 0..n {
        switch time.parse_instant(texts[i % len(texts)], apple) {
            Ok(v) { ok_count = ok_count + 1 }
            Err(e) { printf("  PARSE FAILED: {}\n", e) return 0 - 1 }
        }
    }
    if ok_count != n {
        print("  FAIL: not every parse succeeded")
    }
    return clock.monotonic_millis() - started
}

fn format_ms(instants: [time.Instant], n: int) -> int {
    val started = clock.monotonic_millis()
    for i in 0..n {
        val text = time.format(instants[i % len(instants)], time.zoneoffset_utc(), apple)
        if len(text) == 0 {
            print("  FAIL: empty")
        }
    }
    return clock.monotonic_millis() - started
}

fn main() {
    val n = 200000
    // Twenty distinct values, so neither direction can be answered from one cached result and the
    // numbers are not a single input measured many times.
    val texts = mutable_array_new<string>()
    val instants = mutable_array_new<time.Instant>()
    for i in 0..20 {
        val at = time.instant_of(1700000000 + i * 3607, 0)
        push(instants, at)
        push(texts, time.format(at, time.zoneoffset_utc(), apple))
    }
    val t = snapshot(texts)
    val v = snapshot(instants)
    printf("sample: '{}'\n", t[0])
    val pm = parse_ms(t, n)
    val fm = format_ms(v, n)
    printf("{} parses in {} ms ({} us each)\n", n, pm, pm * 1000 / math.max(n, 1))
    printf("{} formats in {} ms ({} us each)\n", n, fm, fm * 1000 / math.max(n, 1))
    var bad = false
    // Generous ceilings: what these catch is a change of cost class, not a slow machine. Measured
    // 2026-11-04 at 16-17 us a parse and 11-12 us a format, down from 25 and 20.
    if pm > n / 10 {
        printf("FAIL: a parse costs more than 100 us\n")
        bad = true
    }
    if fm > n / 10 {
        printf("FAIL: a format costs more than 100 us\n")
        bad = true
    }
    if bad {
        os.exit(1)
    }
    print("ok   both directions are within their ceilings")
}
