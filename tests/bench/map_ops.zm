// Per-operation cost of `Map`, `Set`, `MutableMap` and `MutableSet` against a 100,000-entry
// container, which is the table in docs/ROADMAP.md's "Make `Map`/`Set` operations faster" entry.
//
// That table was measured ad hoc on 2026-10-05 and had no checked-in source, so it could not be
// retaken -- and three changes that bear on exactly this workload landed after it: the per-arena
// sorted block index (F56), the scaled `ZIMAN_GC_TRIGGER_BYTES`, and `Value.type` as a pointer.
// This file exists so the next person does not have to reconstruct it.
//
// Two key types, because they are not the same question. With int keys CPython is at its very
// best: `hash(i) == i` for a small int and the slot is `hash & mask`, so keys 0..n-1 land one per
// slot with no collisions and no hashing cost at all. Ziman deliberately does the opposite --
// `map_hash` (mapobj.c) runs a murmur3 finalizer over the identity hash precisely so that
// consecutive keys do not pile into one subtrie of a 32-way trie -- so it pays ~5 arithmetic ops
// the other side skips. String keys move the comparison the other way in one respect and not in
// another: both sides hash the bytes, but a CPython `str` caches its hash on the object while a
// Ziman string is a {ptr,len,term} view with nowhere to keep one, so FNV-1a runs per lookup.
//
// Loop overhead is measured and subtracted. `ops` and `report` are a pair: ns/op is
// millis * 1e6 / ops, so changing one means changing the other.
//
// It was 1,000,000, which made elapsed milliseconds read directly as ns/op -- neat, but once the
// cheap rows got fast enough it stopped being able to resolve them: `len` reported **-15 ns/op**
// once, because the subtracted baseline itself moves 60-80ms between runs and the row being
// measured was smaller than that movement. Five million samples puts the baseline's own noise
// five times further below each row. A negative figure here still means the same thing it meant
// then: the row is at or below the measurement floor, not that it costs less than nothing. Compare against tests/bench/map_ops.py, which is the same workload on `dict`.
//
// Every measured loop is a baseline loop *plus exactly the operation* -- and there are **two**
// baselines, because there are two loop shapes. A row whose builtin returns a value folds it into
// `acc` (an expression); a row whose builtin returns a bool has to branch on it, and
// `if cond { acc = acc + 1 }` costs **32-33 ns/op on its own**. Subtracting the expression
// baseline from an if-shaped row is what made `contains` look 20ns slower than `get_or` for
// most of a day, when in truth it is faster: one `mapobj_get` and a bool, against one `mapobj_get`
// plus a third argument expression. Each row now subtracts the baseline matching its own shape.
//
// This is the third time this file's subtraction has been wrong in the same way, so: a measured
// loop must differ from its baseline by the operation and *nothing else*. The earlier two were
// skipping the key and the accumulate in the `len` and store rows (which reported `dict len` at
// -5 ns/op), and a sample count too low to resolve the cheap rows (`len` at -15 ns/op).
use clock

val size = 100000
val ops = 5000000

fn report(label: string, millis: int, base: int) {
    // ns/op is millis * 1e6 / ops, which at ops == 5,000,000 is millis / 5.
    printf("  {}  {} ns/op\n", label, (millis - base) / 5)
}

fn main() {
    val mb = mutable_map_new<int, int>()
    for i in 0..size {
        set<int, int>(mb, i, i)
    }
    val m = snapshot(mb)
    printf("Map/MutableMap over {} entries, {} ops each, loop overhead subtracted\n", size, ops)

    var acc = 0
    var t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
    }
    val base = clock.monotonic_millis() - t
    printf("  (loop overhead {} ns/op, subtracted from the value-returning rows)\n", base / 5)

    // The second shape: a bool-returning builtin has to be branched on, and the branch is not free.
    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        if k >= 0 {
            acc = acc + 1
        }
    }
    val base_if = clock.monotonic_millis() - t
    printf("  (if-shaped overhead {} ns/op, subtracted from the bool-returning rows)\n", base_if / 5)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        if Some(v) = get(m, k) {
            acc = acc + v
        }
    }
    report("Map         get        ", clock.monotonic_millis() - t, base)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k + get_or(m, k, 0)
    }
    report("Map         get_or     ", clock.monotonic_millis() - t, base)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        if contains(m, k) {
            acc = acc + 1
        }
    }
    report("Map         contains       ", clock.monotonic_millis() - t, base_if)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k + len(m)
    }
    report("Map         len            ", clock.monotonic_millis() - t, base)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k + len(set(m, k, i))
    }
    report("Map         set (persist)  ", clock.monotonic_millis() - t, base)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k + len(remove(m, k))
    }
    report("Map         remove (persist)", clock.monotonic_millis() - t, base)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        if Some(v) = get<int, int>(mb, k) {
            acc = acc + v
        }
    }
    report("MutableMap  get            ", clock.monotonic_millis() - t, base)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k + get_or(mb, k, 0)
    }
    report("MutableMap  get_or         ", clock.monotonic_millis() - t, base)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        if contains(mb, k) {
            acc = acc + 1
        }
    }
    report("MutableMap  contains       ", clock.monotonic_millis() - t, base_if)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k + len(mb)
    }
    report("MutableMap  len            ", clock.monotonic_millis() - t, base)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        set<int, int>(mb, k, i)
    }
    report("MutableMap  set            ", clock.monotonic_millis() - t, base)

    // remove then put back, so the container stays the same size across the measurement.
    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        remove<int, int>(mb, k)
        set<int, int>(mb, k, k)
    }
    report("MutableMap  remove+set     ", clock.monotonic_millis() - t, base)

    printf("  (checksum {}, entries {})\n", acc, len(mb))

    // ---- the same questions with string keys ----
    val kb = mutable_array_new<string>(capacity: size)
    for i in 0..size {
        push(kb, concat("key-", str(i)))
    }
    val keys = snapshot(kb)
    val smb = mutable_map_new<string, int>()
    for i in 0..size {
        set<string, int>(smb, keys[i], i)
    }
    val sm = snapshot(smb)
    printf("\nSame over {} string keys (pre-built, so no key construction is measured)\n", size)

    // The baseline indexes the key array and reads the key's length, exactly as each row below
    // does, so only the map operation is left after subtraction.
    t = clock.monotonic_millis()
    for i in 0..ops {
        val j = i % size
        val k = keys[j]
        acc = acc + len(k)
    }
    val sbase = clock.monotonic_millis() - t
    printf("  (loop overhead {} ns/op, subtracted from the value-returning rows)\n", sbase / 5)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val j = i % size
        val k = keys[j]
        acc = acc + len(k)
        if j >= 0 {
            acc = acc + 1
        }
    }
    val sbase_if = clock.monotonic_millis() - t
    printf("  (if-shaped overhead {} ns/op, subtracted from the bool-returning rows)\n", sbase_if / 5)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val j = i % size
        val k = keys[j]
        acc = acc + len(k) + get_or(sm, k, 0)
    }
    report("Map         get_or     ", clock.monotonic_millis() - t, sbase)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val j = i % size
        val k = keys[j]
        acc = acc + len(k)
        if contains(sm, k) {
            acc = acc + 1
        }
    }
    report("Map         contains       ", clock.monotonic_millis() - t, sbase_if)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val j = i % size
        val k = keys[j]
        acc = acc + len(k) + get_or(smb, k, 0)
    }
    report("MutableMap  get_or         ", clock.monotonic_millis() - t, sbase)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val j = i % size
        val k = keys[j]
        acc = acc + len(k)
        set<string, int>(smb, k, j)
    }
    report("MutableMap  set            ", clock.monotonic_millis() - t, sbase)

    printf("  (checksum {}, entries {})\n", acc, len(smb))

    // ---- Set and MutableSet, the same questions a set can answer ----
    //
    // `MutableSet` shares its storage with `MutableMap` (the same MutableMapBuf over the same
    // MapTable), so the flat-table work applies to it unchanged -- these rows exist to show that
    // rather than assume it. `Set` keeps the persistent trie for the same reason `Map` does: it is
    // a value, and `add(s, x)` must leave the old set intact.
    //
    // There is no `discard` row and no need for one: `remove` already answers with a
    // `bool`, where `remove` answered with an `Option<V>` -- which is exactly the cost
    // `discard` was added to avoid.
    val setb = mutable_set_new<int>()
    for i in 0..size {
        add<int>(setb, i)
    }
    val st = snapshot(setb)
    printf("\nSet/MutableSet over {} items, {} ops each\n", size, ops)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
    }
    val setbase = clock.monotonic_millis() - t
    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        if k >= 0 {
            acc = acc + 1
        }
    }
    val setbase_if = clock.monotonic_millis() - t
    printf("  (loop overhead {} ns/op value-returning, {} ns/op if-shaped)\n", setbase / 5, setbase_if / 5)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        if contains(st, k) {
            acc = acc + 1
        }
    }
    report("Set         contains       ", clock.monotonic_millis() - t, setbase_if)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k + len(st)
    }
    report("Set         len            ", clock.monotonic_millis() - t, setbase)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k + len(add(st, size + k))
    }
    report("Set         insert (persist)", clock.monotonic_millis() - t, setbase)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        if contains(setb, k) {
            acc = acc + 1
        }
    }
    report("MutableSet  contains       ", clock.monotonic_millis() - t, setbase_if)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k + len(setb)
    }
    report("MutableSet  len            ", clock.monotonic_millis() - t, setbase)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        if add<int>(setb, k) {
            acc = acc + 1
        }
    }
    report("MutableSet  add (present)  ", clock.monotonic_millis() - t, setbase_if)

    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        acc = acc + k
        if remove<int>(setb, k) {
            acc = acc + 1
        }
        add<int>(setb, k)
    }
    report("MutableSet  remove+add     ", clock.monotonic_millis() - t, setbase_if)

    printf("  (checksum {}, items {} {})\n", acc, len(setb), len(st))

    // ---- the composite, the one row that compares across languages ----
    //
    // One read-modify-write workload timed whole: no baseline, nothing subtracted. Every other row
    // in this file subtracts a baseline loop, which is sound here and in map_ops.py (a tree-walker
    // and a bytecode VM neither reorder nor eliminate across a loop) and is *not* sound in
    // map_ops.java, where a JIT optimises the baseline harder than the measurement -- see that
    // file's header for the two ways it went wrong. This row has no second loop to get wrong, so
    // it is the one to quote between languages. All three print the same checksum.
    val cm = mutable_map_new<int, int>()
    for i in 0..size {
        set<int, int>(cm, i, 0)
    }
    t = clock.monotonic_millis()
    for i in 0..ops {
        val k = i % size
        set<int, int>(cm, k, get_or(cm, k, 0) + 1)
    }
    val cms = clock.monotonic_millis() - t
    printf(
        "\nCOMPOSITE read-modify-write, no subtraction: {} ns/op  (checksum {})\n",
        cms * 1000 / (ops / 1000),
        get_or(cm, 7, -1)
    )
}
