// A million-element [int], [float] and [bool]: build with a builder, sum, sort, compare.

fn main() {
    val n = 1000000
    val ints = mutable_array_new<int>()
    val floats = mutable_array_new<float>()
    val flags = mutable_array_new<bool>()
    for i in 0..n {
        push<int>(ints, (i * 7919) % 100003)
        push<float>(floats, (i % 1000) as float / 8.0)
        push<bool>(flags, i % 3 == 0)
    }
    val a = snapshot(ints)
    val f = snapshot(floats)
    val b = snapshot(flags)
    var sum = 0
    var fsum = 0.0
    var trues = 0
    for i in 0..n {
        sum = sum + a[i]
        fsum = fsum + f[i]
        if b[i] {
            trues = trues + 1
        }
    }
    print(sum)
    print(fsum)
    print(trues)
    val sorted = sort(slice<int>(a, 0, 200000))
    print(sorted[0])
    print(sorted[199999])
    print(a == slice<int>(a, 0, n))
}
