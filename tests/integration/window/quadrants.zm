// Presents four flat quadrants, reports every event it is sent, and holds the window while the
// harness screenshots it and synthesises input.
//
// **The pattern is red/green/blue/white and not a picture, because channel order is the bug this
// case exists to catch.** `src/native_window.c` repacks RGBA into whatever the visual's masks say,
// and a 32-bit TrueColor visual on a little-endian machine wants B, G, R, X in memory -- so the
// obvious implementation shows blue where red should be, on every machine, and no amount of reading
// the code makes that as obvious as a screenshot does.
//
// Prints the window id for the harness, then reports every event it receives until it is asked to
// close or its deadline passes.
//
// **The event lines are the other half of the gate.** The pixels prove `present` reaches the
// screen; nothing in Ziman can prove that a real key press becomes a `KeyDown`, because no Ziman
// code can press a key -- so `tests/tools/x11_inject.c` presses them through the X server and these
// lines are what the harness reads back. A `Close` is obeyed rather than counted, which is also the
// check that `with_window` gives the window back when its body returns normally.
//
// **Both present paths are gated here, chosen by `WINDOW_PRESENT_MODE`.** `present` takes
// premultiplied floats and `present_bytes` takes bytes, and the harness runs this program once for
// each and asserts the *same* four sRGB triples -- which is the only way to check the claim in
// `native_window.c` that the two agree. Presenting floats was added for the repaint loop, where it
// removes a 4 MB conversion and a 4 MB copy per frame; without a case like this it would have had
// its own pixel path and no screenshot of it, which is how a renderer gets a channel order wrong in
// one of two functions and passes.
//
// The floats are built premultiplied *by hand* rather than by `lib/graphics`, deliberately: this
// file tests `window`, and reaching for the renderer to produce its input would make a window
// failure and a rasteriser failure look the same. Every quadrant here is opaque, so premultiplied
// and straight are the same numbers -- which is the normal case for a window and the one the fast
// path in the native takes.
use clock
use desktop
use geom
use os
use paint
use raster
use scene
use shape
use window

val width = 320
val height = 240

fn quadrants() -> [byte] {
    val out = mutable_array_new<byte>()
    for y in 0..height {
        for x in 0..width {
            val left = x < width / 2
            val top = y < height / 2
            if top && left {
                push(out, 255b)
                push(out, 0b)
                push(out, 0b)
            } else {
                if top {
                    push(out, 0b)
                    push(out, 255b)
                    push(out, 0b)
                } else {
                    if left {
                        push(out, 0b)
                        push(out, 0b)
                        push(out, 255b)
                    } else {
                        push(out, 255b)
                        push(out, 255b)
                        push(out, 255b)
                    }
                }
            }
            push(out, 255b)
        }
    }
    return snapshot(out)
}

// One line per event, in a shape the harness greps: the name, then whatever the event carries that
// could be wrong. Positions and modifier flags are printed rather than summarised, because a
// pointer event at the wrong coordinates and a modifier that never arrives are exactly the
// mistakes this exists to catch.
fn report(e: window.Event) {
    switch e {
        KeyDown(k) {
            printf(
                "event KeyDown {} shift={} control={} alt={}\n",
                window.key_name(k),
                str(k.shift),
                str(k.control),
                str(k.alt)
            )
        }
        KeyUp(k) { printf("event KeyUp {}\n", window.key_name(k)) }
        Char(text) { printf("event Char [{}]\n", text) }
        PointerDown(p) { printf("event PointerDown button={} at {},{}\n", str(p.button), str(p.x), str(p.y)) }
        PointerUp(p) { printf("event PointerUp button={} at {},{}\n", str(p.button), str(p.x), str(p.y)) }
        PointerMove(p) { printf("event PointerMove {},{}\n", str(p.x), str(p.y)) }
        Scroll(s) {
            printf(
                "event Scroll vertical={} horizontal={} at {},{}\n",
                str(s.vertical),
                str(s.horizontal),
                str(s.x),
                str(s.y)
            )
        }
        Resize(size) { printf("event Resize {}x{}\n", str(size.width), str(size.height)) }
        Close { print("event Close") }
        FocusIn { print("event FocusIn") }
        FocusOut { print("event FocusOut") }
        Exposed { print("event Exposed") }
    }
}

// Whether the window manager -- or the harness standing in for it -- asked this window to go away.
// Written out arm by arm because this language has no wildcard arm for a variant, which is the
// trade for a switch that fails to compile when a case is added to `Event`.
// **`Exposed` is the event a damage-driven loop cannot ignore.** A compositor may show a window
// before its first contents arrive, or lose them later, and in neither case has the *scene* changed
// -- so `desktop.repaint` would correctly answer "nothing to do" and the window would stay blank.
// The first version of the repaint mode here did exactly that and the harness read four black
// pixels. `desktop.forget` is the answer, and this is the event that calls for it.
fn is_exposed(e: window.Event) -> bool {
    return switch e {
        Exposed { true }
        Close { false }
        KeyDown(_) { false }
        KeyUp(_) { false }
        Char(_) { false }
        PointerDown(_) { false }
        PointerUp(_) { false }
        PointerMove(_) { false }
        Scroll(_) { false }
        Resize(_) { false }
        FocusIn { false }
        FocusOut { false }
    }
}

fn is_close(e: window.Event) -> bool {
    return switch e {
        Close { true }
        KeyDown(_) { false }
        KeyUp(_) { false }
        Char(_) { false }
        PointerDown(_) { false }
        PointerUp(_) { false }
        PointerMove(_) { false }
        Scroll(_) { false }
        Resize(_) { false }
        FocusIn { false }
        FocusOut { false }
        Exposed { false }
    }
}

fn quadrant_floats() -> MutableArray<float> {
    val out = mutable_array_new<float>()
    for y in 0..height {
        for x in 0..width {
            val left = x < width / 2
            val top = y < height / 2
            if top && left {
                push(out, 1.0)
                push(out, 0.0)
                push(out, 0.0)
            } else {
                if top {
                    push(out, 0.0)
                    push(out, 1.0)
                    push(out, 0.0)
                } else {
                    if left {
                        push(out, 0.0)
                        push(out, 0.0)
                        push(out, 1.0)
                    } else {
                        push(out, 1.0)
                        push(out, 1.0)
                        push(out, 1.0)
                    }
                }
            }
            push(out, 1.0)
        }
    }
    return out
}

// Paints the whole float buffer one colour, for the regional-present case below.
fn flood(buffer: MutableArray<float>, r: float, g: float, b: float) {
    var i = 0
    while i < len(buffer) {
        buffer[i] = r
        buffer[i + 1] = g
        buffer[i + 2] = b
        buffer[i + 3] = 1.0
        i = i + 4
    }
}

// **The same pattern as a `Scene`, for the damage-driven repaint path.**
//
// `desktop.repaint` is the join between the renderer and the window: it asks what changed since the
// scene it last showed, redraws that rectangle and sends that rectangle. Testing it needs a real
// window, so it is tested here rather than in `tests/lang`, and it is tested on *this* pattern
// because the four quadrants are exactly what the harness already knows how to read -- the
// boundaries sit on whole pixels at 320x240, so the fills are flat and the colours are exact rather
// than anti-aliased.
fn quadrant_scene(label: int) -> scene.Scene {
    val w = width as float
    val h = height as float
    val half_w = w * 0.5
    val half_h = h * 0.5
    val ops = mutable_array_new<scene.Op>()
    // The fourth quadrant's colour is the one that moves, so a second scene differs in one corner
    // and the damage should be that corner alone.
    val fourth = if label == 0 { paint.rgb(1.0, 1.0, 1.0) } else { paint.rgb(1.0, 1.0, 0.0) }
    push(
        ops,
        scene.fill(shape.rect_path(geom.rect_of(0.0, 0.0, half_w, half_h)), paint.Paint.Solid(paint.rgb(1.0, 0.0, 0.0)))
    )
    push(
        ops,
        scene.fill(
            shape.rect_path(geom.rect_of(half_w, 0.0, half_w, half_h)),
            paint.Paint.Solid(paint.rgb(0.0, 1.0, 0.0))
        )
    )
    push(
        ops,
        scene.fill(
            shape.rect_path(geom.rect_of(0.0, half_h, half_w, half_h)),
            paint.Paint.Solid(paint.rgb(0.0, 0.0, 1.0))
        )
    )
    push(ops, scene.fill(shape.rect_path(geom.rect_of(half_w, half_h, half_w, half_h)), paint.Paint.Solid(fourth)))
    return scene.with_ops(scene.scene_of(w, h), snapshot(ops))
}

fn repaint_options() -> raster.Options {
    return with raster.options() {
        samples: 1,
        background: Option<paint.Color>.Some(paint.white()),
        max_pixels: 200000
    }
}

// Which `present` to exercise. Defaults to the float one, because that is the path a repaint uses.
fn use_floats() -> bool {
    return switch os.get_env("WINDOW_PRESENT_MODE") {
        Some(mode) { mode != "bytes" }
        None { true }
    }
}

fn use_region() -> bool {
    return switch os.get_env("WINDOW_PRESENT_MODE") {
        Some(mode) { mode == "region" }
        None { false }
    }
}

fn use_repaint() -> bool {
    return switch os.get_env("WINDOW_PRESENT_MODE") {
        Some(mode) { mode == "repaint" }
        None { false }
    }
}

// Drives `desktop.repaint` through the three cases a loop actually meets, reporting each so the
// harness can read them: a first frame that must draw everything, a second with the same scene that
// must draw **nothing at all**, and a changed scene whose damage must be the one quadrant that
// differs rather than the window.
fn drive_repaint(w: window.Window) -> Result<desktop.Painter, string> {
    val o = repaint_options()
    var painter = try desktop.painter_of(width as float, height as float, 1.0)

    val first = try desktop.repaint(painter, w, quadrant_scene(0), o)
    painter = first.next
    switch first.region {
        Some(r) { printf("repaint first {}x{}\n", str(r.width), str(r.height)) }
        None { print("repaint first painted nothing, which it must not") }
    }

    val again = try desktop.repaint(painter, w, quadrant_scene(0), o)
    painter = again.next
    switch again.region {
        Some(r) { printf("repaint unchanged painted {}x{}, which it must not\n", str(r.width), str(r.height)) }
        None { print("repaint unchanged painted nothing") }
    }

    // `forget` is what an `Exposed` event needs: the scene has not changed, so without it the
    // window would stay as the compositor left it.
    val forced = try desktop.repaint(desktop.forget(painter), w, quadrant_scene(0), o)
    painter = forced.next
    switch forced.region {
        Some(r) { printf("repaint after forget {}x{}\n", str(r.width), str(r.height)) }
        None { print("repaint after forget painted nothing, which it must not") }
    }

    val changed = try desktop.repaint(painter, w, quadrant_scene(1), o)
    switch changed.region {
        Some(r) { printf("repaint one quadrant {}x{} at {},{}\n", str(r.width), str(r.height), str(r.x), str(r.y)) }
        None { print("repaint of a changed scene painted nothing, which it must not") }
    }
    return ok(changed.next)
}

fn paint_window(w: window.Window, floats: bool) -> Result<unit, string> {
    if floats {
        return window.present(w, quadrant_floats(), width, height)
    }
    return window.present_bytes(w, quadrants(), width, height)
}

// **The regional present, asserted in both directions at once.** The quadrants go up as a whole
// frame; then the entire buffer is flooded magenta and only a 40x40 square at the quadrant meeting
// point is presented. So the window must show magenta *there* and the original four colours
// everywhere else -- and the buffer being wholly magenta is what makes the second half mean
// something, because a region that pushed more than it was asked to would turn a quadrant centre
// magenta too.
val region_x = 140
val region_y = 100
val region_size = 40

fn magenta_region(w: window.Window) -> Result<unit, string> {
    val buffer = quadrant_floats()
    flood(buffer, 1.0, 0.0, 1.0)
    return window.present_region(w, buffer, width, height, window.Region {
        x: region_x,
        y: region_y,
        width: region_size,
        height: region_size
    })
}

fn paint_region(w: window.Window) -> Result<unit, string> {
    try window.present(w, quadrant_floats(), width, height)
    return magenta_region(w)
}

fn main() {
    val outcome = window.with_window<unit>(
        "ziman window test",
        width,
        height,
        fn(w: window.Window) -> Result<unit, string> {
            val id = try window.id(w)
            val size = try window.size(w)
            printf("window-id {}\n", str(id))
            printf("size {}x{}\n", str(size.width), str(size.height))
            // **Not printed here, and the reason is the whole point of the function.** A window
            // that has just been mapped has not been placed yet: asked at this line it answers
            // 0,0 under a reparenting window manager, and a little later it answers where the
            // user can see it. So the gate asks for it at a moment it can also ask the server,
            // which is after the first event arrives.
            val floats = use_floats()
            val regional = use_region()
            val driven = use_repaint()
            var painter = Option<desktop.Painter>.None
            if driven {
                painter = Option<desktop.Painter>.Some(try drive_repaint(w))
            } else {
                if regional {
                    try paint_region(w)
                } else {
                    try paint_window(w, floats)
                }
            }
            printf(
                "presented {}\n",
                if driven {
                    "repaint"
                } else {
                    if regional { "region" } else { if floats { "floats" } else { "bytes" } }
                }
            )
            // **Re-presented every pass, not once.** A compositor can show the window before its
            // first contents arrive, and a screenshot taken in that gap reads black -- which is
            // what the harness saw the first time it ran under a loaded `make check-fast`. Painting
            // every pass costs nothing here and means any capture after "presented" sees the
            // pattern. A real application does this too: it is what an `Exposed` event asks for.
            // Rebuilt once, outside the loop, as the byte version was.
            // **A backstop, not a duration.** The run ends when the harness sends a close, which
            // is the last thing it does; this only bounds a run where that never arrives, so a
            // failing case cannot hang `make check`.
            val deadline = clock.monotonic_millis() + 30000
            var closing = false
            var told = false
            while !closing && clock.monotonic_millis() < deadline {
                for one in try window.poll(w) {
                    report(one)
                    // Where the window is, once, at the first event -- by which time the window
                    // manager has placed it. **Once and not per event**, because asking is a
                    // round trip to the server and this loop is also what keeps the window
                    // painted: the pixel checks here already race a compositor that can show a
                    // window before its contents arrive, and there is no reason to lengthen a
                    // pass for a number that does not change.
                    if !told {
                        told = true
                        val at = try window.origin(w)
                        printf("origin {},{}\n", str(at.x), str(at.y))
                    }
                    // Repaint on Exposed, which is what the event means: the window's contents are
                    // gone and the scene cannot tell us so.
                    if driven && is_exposed(one) {
                        if Some(held) = painter {
                            val redrawn = try desktop.repaint(
                                desktop.forget(held),
                                w,
                                quadrant_scene(1),
                                repaint_options()
                            )
                            painter = Option<desktop.Painter>.Some(redrawn.next)
                        }
                    }
                    if is_close(one) {
                        closing = true
                    }
                }
                if driven {
                    // **Nothing to do.** The scene has not changed, so `desktop.repaint` would
                    // correctly draw nothing -- which is the behaviour under test, and re-calling it
                    // here would only assert it a second time. The window keeps what the last
                    // `drive_repaint` left on it.
                    unit
                } else {
                    if regional {
                        // **Only the region, not the whole frame.** Re-presenting everything each
                        // pass as the other modes do left the window alternating between the
                        // quadrants and the magenta square, and the harness screenshotted the wrong
                        // half of that cycle -- a flake entirely of this file's own making. The
                        // pixels outside the region are painted once, before "presented", and then
                        // left alone, which is also a truer picture of what a repaint loop does.
                        try magenta_region(w)
                    } else {
                        try paint_window(w, floats)
                    }
                }
                clock.sleep_millis(50)
            }
            return ok(unit)
        }
    )
    switch outcome {
        Ok(_) { print("closed") }
        Err(why) { printf("failed: {}\n", why) }
    }
}
