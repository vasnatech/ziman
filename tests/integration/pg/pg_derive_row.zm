use datasource
use db.DbError
use db.Row
use db.SqlValue
use db.db_error_message
use db.row_get
use db.sql_as_bool
use db.sql_as_float
use db.sql_as_int
use db.sql_as_text
use fs
use pg
use time.Instant
use time.LocalDate
use time.instant_now
use time.parse_localdate
use time.to_instant
use time.to_localdate
use time.to_sql
use uuid.Uuid
use uuid.uuid_from_sql
use uuid.uuid_new
use uuid.uuid_to_sql

val drivers = datasource.registry([pg.driver()])

// The same struct and the same SQL as the SQLite fixture -- the point:
// repository code doesn't change between backends.
#[derive(Row)]
pub struct Person {
    id: Uuid
    name: string
    nickname: Option<string>
    born: LocalDate
    age_hint: Option<int>
    active: bool
    score: float
    created_at: Instant
}

fn main() {
    val conn = unwrap(datasource.open(drivers, trim(unwrap(fs.read_text("tests/integration/pg/.url")))))
    unwrap(datasource.execute(conn, "DROP TABLE IF EXISTS people"))
    unwrap(datasource.execute(
        conn,
        "CREATE TABLE people (id TEXT PRIMARY KEY, name TEXT NOT NULL, nickname TEXT, born TEXT NOT NULL, age_hint INTEGER, active INTEGER NOT NULL, score REAL NOT NULL, created_at TEXT NOT NULL)"
    ))
    val p1 = Person {
        id: uuid_new(),
        name: "Ada",
        nickname: Option<string>.Some("A"),
        born: unwrap(parse_localdate("1815-12-10")),
        age_hint: Option<int>.None,
        active: true,
        score: 0.1,
        created_at: instant_now()
    }
    val p2 = Person {
        id: uuid_new(),
        name: "Bob",
        nickname: Option<string>.None,
        born: unwrap(parse_localdate("1990-01-01")),
        age_hint: Option<int>.Some(30),
        active: false,
        score: 2.5,
        created_at: instant_now()
    }
    val ins = "INSERT INTO people (id, name, nickname, born, age_hint, active, score, created_at) VALUES ($1, $2, $3, $4, $5, $6, $7, $8)"
    unwrap(datasource.execute(conn, ins, person_to_params(p1)))
    unwrap(datasource.execute(conn, ins, person_to_params(p2)))
    val rows = unwrap(datasource.query(conn, "SELECT * FROM people ORDER BY name"))
    val a = unwrap(person_from_row(rows[0]))
    val b = unwrap(person_from_row(rows[1]))
    print(a.id == p1.id)
    print(a.name)
    print(Option.unwrap_Some(a.nickname))
    print(a.born == p1.born)
    print(Option.is_Some(a.age_hint))
    print(a.active)
    print(a.score)
    print(a.created_at == p1.created_at)
    print(Option.is_Some(b.nickname))
    print(Option.unwrap_Some(b.age_hint))
    print(b.active)
    print(db_error_message(unwrap_err(datasource.execute(conn, ins, person_to_params(p1)))))
    unwrap(datasource.execute(conn, "DROP TABLE people"))
    datasource.close(conn)
}
