use datasource
use db.SqlValue
use db.row_get
use db.sql_as_int
use fs

// Ten threads share one connection and each insert 20 rows. The owner
// thread serialises the wire protocol, so nothing interleaves.
fn worker(conn: datasource.Connection, base: int, done: Channel<int>) {
    var i = 0
    var ok = 0
    while i < 20 {
        if is_ok(datasource.execute(
            conn,
            "INSERT INTO pg_c (id, who) VALUES ($1, $2)",
            SqlValue.Int(base + i),
            SqlValue.Int(base)
        )) {
            ok = ok + 1
        }
        i = i + 1
    }
    send(done, ok)
}

fn main() {
    val conn = unwrap(datasource.open(trim(unwrap(fs.read_text("tests/integration/pg/.url")))))
    unwrap(datasource.execute(conn, "DROP TABLE IF EXISTS pg_c"))
    unwrap(datasource.execute(conn, "CREATE TABLE pg_c (id INTEGER PRIMARY KEY, who INTEGER NOT NULL)"))
    val done: Channel<int> = channel_new()
    var t = 0
    while t < 10 {
        spawn worker(conn, t * 1000, done)
        t = t + 1
    }
    var total = 0
    var i = 0
    while i < 10 {
        total = total + receive(done)
        i = i + 1
    }
    print(total)
    val rows = unwrap(datasource.query(conn, "SELECT count(*) AS n FROM pg_c"))
    print(unwrap(sql_as_int(unwrap(row_get(rows[0], "n")))))
    unwrap(datasource.execute(conn, "DROP TABLE pg_c"))
    datasource.close(conn)
}
