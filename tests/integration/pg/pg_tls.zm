use datasource
use db.DbError
use db.Row
use db.SqlValue
use db.db_error_message
use db.row_get
use db.sql_as_bool
use db.sql_as_int
use fs
use net
use number

// The Postgres server here has TLS enabled with a self-signed certificate
// valid for localhost and 127.0.0.1; it is its own CA.
fn base() -> string {
    return "postgres://ziman:secret@127.0.0.1:55432/zimandb"
}

fn root() -> string {
    return "sslrootcert=tests/integration/pg/.certs/server.crt"
}

// Does the server say this very connection is encrypted?
fn encrypted(label: string, url: string) {
    val c = datasource.open(url)
    if !is_ok(c) {
        val msg = db_error_message(unwrap_err(c))
        if contains(msg, "self-signed") {
            printf("{}: FAIL untrusted certificate\n", label)
        } else if contains(msg, "cannot load trusted certificates") {
            printf("{}: FAIL bad CA file\n", label)
        } else {
            printf("{}: FAIL {}\n", label, msg)
        }
    } else {
        val rows = unwrap(datasource.query(unwrap(c), "SELECT ssl FROM pg_stat_ssl WHERE pid = pg_backend_pid()"))
        printf("{}: ssl={}\n", label, unwrap(sql_as_bool(unwrap(row_get(rows[0], "ssl")))))
        datasource.close(unwrap(c))
    }
}

// A server that answers the SSLRequest with 'N' (no TLS). The first
// client is then dropped; the second gets as far as the plaintext startup
// message, which it answers with an ErrorResponse -- proving `prefer`
// really carried on over plaintext after the 'N'.
fn no_tls_server(l: net.Listener) {
    val first = unwrap(net.accept(l))
    unwrap(net.read_exact(first, 8))
    unwrap(net.write_text(first, "N"))
    net.close(first)

    val second = unwrap(net.accept(l))
    unwrap(net.read_exact(second, 8))
    unwrap(net.write_text(second, "N"))
    val header = unwrap(net.read_exact(second, 4))
    unwrap(net.read_exact(second, number.u32_from_bytes(header, 0) - 4))
    val body = concat(
        to_bytes("S"),
        to_bytes("FATAL"),
        [0b],
        to_bytes("C28000"),
        [0b],
        to_bytes("Mplaintext startup reached"),
        [0b, 0b]
    )
    unwrap(net.write(second, concat(to_bytes("E"), number.u32_to_bytes(len(body) + 4), body)))
    net.close(second)
}

fn main() {
    encrypted("default (disable)", base())
    encrypted("sslmode=prefer", concat(base(), "?sslmode=prefer"))
    encrypted("sslmode=require", concat(base(), "?sslmode=require"))
    encrypted("verify-ca + root cert", format("{}?sslmode=verify-ca&{}", base(), root()))
    encrypted("verify-full + root cert", format("{}?sslmode=verify-full&{}", base(), root()))
    encrypted("verify-full, system CAs", concat(base(), "?sslmode=verify-full"))
    encrypted("verify-ca, missing root cert file", concat(base(), "?sslmode=verify-ca&sslrootcert=/nonexistent.pem"))

    // ordinary work over an encrypted connection, including concurrent callers
    val conn = unwrap(datasource.open(format("{}?sslmode=verify-full&{}", base(), root())))
    defer datasource.close(conn)
    unwrap(datasource.execute(conn, "DROP TABLE IF EXISTS pg_tls_t"))
    unwrap(datasource.execute(conn, "CREATE TABLE pg_tls_t (id INTEGER PRIMARY KEY, note TEXT)"))
    unwrap(datasource.execute(
        conn,
        "INSERT INTO pg_tls_t (id, note) SELECT g, 'row ' || g FROM generate_series(1, 300) AS g"
    ))
    val rows = unwrap(datasource.query(conn, "SELECT * FROM pg_tls_t ORDER BY id"))
    print(len(rows))
    print(unwrap(sql_as_int(unwrap(row_get(rows[299], "id")))))
    unwrap(datasource.execute(conn, "DROP TABLE pg_tls_t"))

    // a server with no TLS: `require` refuses, `prefer` falls back to plaintext
    val l = unwrap(net.listen("127.0.0.1", 0))
    spawn no_tls_server(l)
    val port = net.listener_port(l)
    val required = datasource.open(format("postgres://u:p@127.0.0.1:{}/d?sslmode=require", port))
    print(db_error_message(unwrap_err(required)))
    val preferred = datasource.open(format("postgres://u:p@127.0.0.1:{}/d?sslmode=prefer", port))
    print(db_error_message(unwrap_err(preferred)))
    net.close(l)
}
