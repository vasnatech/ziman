use datasource
use db.DbError
use db.db_error_message
use fs

fn show(r: Result<datasource.Connection, DbError>) {
    print(is_ok(r))
    print(db_error_message(unwrap_err(r)))
}

// For a user MySQL has never heard of, the server picks a plugin to
// challenge with deterministically from the username (so a client can't
// tell a wrong password from a nonexistent user by timing), and that pick
// isn't stable across server restarts. Depending on it lands on an immediate
// "access denied", on a plugin-rejection message (a plugin this driver does not
// support), or on caching_sha2's "needs the full authentication exchange"
// refusal (the driver will not send a password in the clear without TLS) --
// all real, correct rejections of the same login, so this test only checks that
// one happens.
fn show_unknown_user(r: Result<datasource.Connection, DbError>) {
    print(is_ok(r))
    val message = db_error_message(unwrap_err(r))
    if contains(message, "Access denied") || contains(message, "authentication plugin") ||
        contains(message, "full authentication exchange") {
        print("database connection error: login rejected")
    } else {
        print(message)
    }
}

fn main() {
    val hp = trim(unwrap(fs.read_text("tests/integration/mysql/.hostport")))
    // unknown user, unknown database
    show_unknown_user(datasource.open(format("mysql://nobody:secret@{}/zimandb", hp)))
    show(datasource.open(format("mysql://nat_user:natpw@{}/no_such_db", hp)))
    // nothing listening
    show(datasource.open("mysql://root:secret@127.0.0.1:1/zimandb"))
    // unsupported sslmode values are refused, not guessed at
    show(datasource.open(format("mysql://nat_user:natpw@{}/zimandb?sslmode=allow", hp)))
    // malformed URLs
    show(datasource.open("mysql://@127.0.0.1/db"))
    show(datasource.open("mysql://u:p@127.0.0.1:notaport/db"))
    // percent-encoded credentials decode ("nat%70w" == "natpw")
    val ok = datasource.open(format("mysql://nat_user:nat%70w@{}/zimandb", hp))
    print(is_ok(ok))
    if is_ok(ok) {
        datasource.close(unwrap(ok))
    }
}
