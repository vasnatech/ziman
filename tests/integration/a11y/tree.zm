// Publishes an accessibility tree and holds it there while the harness reads it off the bus.
//
// **The assertion is made by another process**, which is the only way to make one that means
// anything here: a check inside this program could only confirm that `publish` returned `Ok`, and
// what F275 is about is whether a *reader* can see the tree. `tests/tools/atspi_dump.c` connects to
// the session's accessibility bus the way Orca does and prints what it finds.
//
// The controls are chosen for their roles rather than to look like an application: a button, a text
// field and a combo box map to three different AT-SPI roles, and the last one is the role added the
// same day a value picker needed it. The password field is here for the opposite reason -- not to
// check that something arrives, but that something does **not**.
use a11y
use atspi
use clock
use controls
use geom
use paint
use widget

val app_name = "ziman a11y fixture"

fn metrics() -> widget.Metrics {
    return widget.metrics_of(
        fn(text: string, size: float) -> float { return (len(text) as float) * 7.0 },
        fn(size: float) -> float { return size * 1.4 }
    )
}

fn labelled(name: string, role: widget.Role, text: string) -> widget.Widget {
    return widget.control_of(name, role, widget.fixed_of(160.0, 20.0, widget.label_of(text, 11.0, paint.black())))
}

fn main() {
    val form = widget.column_of(4.0, [
        labelled("send", widget.Role.Button, "Send"),
        labelled("url", widget.Role.TextField, "http://example.test"),
        // **A real choice, not a label claiming to be one.** `control_of` takes a node's name from
        // the text inside it and leaves the value empty, so a stand-in would assert the role and
        // nothing about the value -- which is the half this fixture exists to cover now.
        controls.menu_title_widget(
            controls.choice_of("env", "Environment", ["(global)", "staging"], 1),
            controls.default_style()
        ),
        // **A real text area, not a label claiming to be one.** A reader that thinks a multi-line
        // field is single-line reads it as one line, so the state has to be published -- and it is
        // only asserted here because the control genuinely sets it.
        controls.entry_widget(controls.text_area_of("body", "Body", "a\nb", 4), controls.default_style(), metrics()),
        // **A value that is not ASCII, because AT-SPI offsets are characters and C strings are
        // bytes.** Every other value here is ASCII, where the two are the same number -- so a text
        // interface measuring bytes passed every check and would hand a reader a cut-in-half
        // character the first time anyone typed an accent.
        controls.entry_widget(
            controls.entry_of("note", "Note", "café ☕"),
            controls.default_style(),
            metrics()
        ),
        // **A password, because the one thing this control promises is that its text does not
        // leave the process -- and the accessibility bus is the way out nobody looks at.** A
        // masked field that drew bullets and published its contents would look right in every
        // screenshot and read the secret out loud.
        controls.entry_widget(
            controls.password_of("pass", "Password", "hunter2"),
            controls.default_style(),
            metrics()
        ),
        // **A disabled control, because "cannot be used" is a fact a reader must be told.** Without
        // one here, publishing every node as enabled passed every check -- the absence of a state
        // is invisible to a test that only looks at nodes which have it.
        widget.Widget.Control(widget.Focusable {
            name: "revert",
            role: widget.Role.Button,
            label: "Revert",
            description: "nothing to undo yet",
            value: "",
            state: with widget.no_state() { disabled: true },
            tab_stop: true,
            child: widget.fixed_of(60.0, 20.0, widget.label_of("Revert", 11.0, paint.black()))
        }),
        // **A real list, not two labels standing in for one.** `control_of` sets no state, so a
        // hand-built list asserts the roles and nothing about the selection -- and a reader that
        // cannot tell which row is selected tells a user nothing as they arrow through it.
        controls.list_widget(
            with controls.list_of("rows", "Rows", ["first", "second"]) { selected: 1 },
            controls.default_style()
        )
    ])
    val laid = widget.layout(form, geom.rect_of(0.0, 0.0, 300.0, 200.0), metrics())
    val tree = a11y.tree_of(laid, app_name, "url")
    switch atspi.publish(tree, app_name) {
        Ok(_) { print("published") }
        Err(why) {
            printf("publish failed: {}\n", why)
            return
        }
    }
    // Held open while the harness reads, pumping so the bridge can answer. A backstop rather than a
    // duration: the harness kills this when it is done, and this only bounds a run where that never
    // happens, so a failing case cannot hang `make test`.
    val deadline = clock.monotonic_millis() + 30000
    while clock.monotonic_millis() < deadline {
        atspi.pump()
        clock.sleep_millis(50)
    }
}
