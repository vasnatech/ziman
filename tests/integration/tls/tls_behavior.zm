use net
use net.NetError
use net.TlsVerify

// Everything here talks to `openssl s_server -www` on 127.0.0.1:55443
// (started by tests/run_tls_tests.sh) or to a plain listener started
// below.
fn ca() -> Option<string> {
    return Option<string>.Some("tests/integration/tls/.certs/a.pem")
}

fn request() -> [byte] {
    return concat(to_bytes("GET / HTTP/1.0"), [13b, 10b, 13b, 10b])
}

// A plain (non-TLS) server that says hello and hangs up.
fn plain_server(l: net.Listener) {
    val c = unwrap(net.accept(l))
    val _ = net.write_text(c, "hello, no TLS here")
    net.close(c)
}

fn main() {
    // A whole page arrives over several TLS records, then the server
    // closes: reading to the end yields the bytes, then Err(Closed).
    val s = unwrap(net.connect_tls("127.0.0.1", 55443, TlsVerify.Full, ca()))
    unwrap(net.write(s, request()))
    var total = 0
    var reading = true
    var ended_closed = false
    while reading {
        val r = net.read(s, 512)
        if is_ok(r) {
            total = total + len(unwrap(r))
        } else {
            ended_closed = NetError.is_Closed(unwrap_err(r))
            reading = false
        }
    }
    print(total > 1000)
    print(ended_closed)
    net.close(s)

    // read_exact works across TLS record boundaries
    val s2 = unwrap(net.connect_tls("127.0.0.1", 55443, TlsVerify.Full, ca()))
    unwrap(net.write(s2, request()))
    print(len(unwrap(net.read_exact(s2, 700))))
    net.close(s2)

    // a receive timeout surfaces as Timeout over TLS, not a TLS error
    val s3 = unwrap(net.connect_tls("127.0.0.1", 55443, TlsVerify.Full, ca()))
    unwrap(net.set_timeout(s3, 200))
    val slow = net.read(s3, 10)
    print(NetError.is_Timeout(unwrap_err(slow)))
    net.close(s3)

    // upgrading twice is an error, not a crash
    val s4 = unwrap(net.connect("127.0.0.1", 55443))
    unwrap(net.start_tls(s4, "127.0.0.1", TlsVerify.Full, ca()))
    val again = net.start_tls(s4, "127.0.0.1", TlsVerify.Full, ca())
    print(NetError.is_Tls(unwrap_err(again)))
    net.close(s4)

    // a TLS handshake against a server that isn't speaking TLS fails
    // cleanly, and connect_tls closes the socket it opened
    val l = unwrap(net.listen("127.0.0.1", 0))
    spawn plain_server(l)
    val bad = net.connect_tls("127.0.0.1", net.listener_port(l), TlsVerify.Off, Option<string>.None)
    print(is_ok(bad))
    print(NetError.is_Tls(unwrap_err(bad)))
    net.close(l)

    // a closed port is still ConnectionRefused, not a TLS error
    val refused = net.connect_tls("127.0.0.1", 1)
    print(NetError.is_ConnectionRefused(unwrap_err(refused)))
}
