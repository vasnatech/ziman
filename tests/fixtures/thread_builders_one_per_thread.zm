fn work(id: int, out: Channel<string>) {
    val sb = mutable_string_new()
    for i in 0..3 {
        mutable_string_append(sb, str(id), ":", str(i), " ")
    }
    val ab = mutable_array_new<int>()
    mutable_array_push<int>(ab, id)
    send(out, snapshot(sb))
}

fn main() {
    val out: Channel<string> = channel_new()
    for id in 0..4 {
        spawn work(id, out)
    }
    var total = 0
    for _ in 0..4 {
        total = total + len(receive(out))
    }
    print(total)
    val sb = mutable_string_new()
    mutable_string_append(sb, "main ok")
    print(snapshot(sb))
}
