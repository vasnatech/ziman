// F53: `f(args...)` is a Rust/JS/Python habit, and it used to fail as `expected ')', found '..'` --
// the token rather than the fix. It matters because the answer is that nothing is missing: a
// variadic parameter takes an array directly. Found writing the reference backend's first Ziman
// test, where I believed the old error and wrote the same call out four times to work around a
// limitation that does not exist. See variadic_takes_an_array for the form that works.
fn total(ns: int...) -> int {
    var sum = 0
    for n in ns {
        sum = sum + n
    }
    return sum
}

fn main() {
    val args = [1, 2, 3]
    print(total(args...))
}
