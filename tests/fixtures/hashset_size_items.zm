fn sum(xs: [int]) -> int {
    var total = 0
    for x in xs {
        total = total + x
    }
    return total
}

fn main() {
    var s = Set<int> {}
    print(len(s))

    s = insert(s, 1)
    s = insert(s, 2)
    s = insert(s, 3)
    s = insert(s, 2) // duplicate, no-op
    print(len(s))
    print(sum(set_items(s)))

    s = remove(s, 2)
    print(len(s))
    print(sum(set_items(s)))

    s = remove(s, 99) // no-op
    print(len(s))
}
