use crypto
use number

fn b(s: string) -> [byte] {
    return string_to_bytes(s)
}

fn hex(x: [byte]) -> string {
    return number.bytes_to_hex(x)
}

fn main() {
    print(hex(crypto.hmac_sha256(b("Jefe"), b("what do ya want for nothing?"))))
    print(hex(crypto.hmac_sha256(b("key"), b("The quick brown fox jumps over the lazy dog"))))
    // key longer than the 64-byte block gets hashed first
    print(hex(crypto.hmac_sha256(b("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"),
        b("Test Using Larger Than Block-Size Key - Hash Key First"))))
    print(hex(crypto.pbkdf2_hmac_sha256(b("passwd"), b("salt"), 1, 64)))
    print(hex(crypto.pbkdf2_hmac_sha256(b("password"), b("salt"), 4096, 32)))
    print(hex(crypto.pbkdf2_hmac_sha256(b("pencil"), b("W22ZaJ0SNY7soEsUEjb6gQ=="), 4096, 32)))
    print(crypto.base64_encode(b("")))
    print(crypto.base64_encode(b("f")))
    print(crypto.base64_encode(b("fo")))
    print(crypto.base64_encode(b("foo")))
    print(crypto.base64_encode(b("foobar")))
    print(unwrap(bytes_to_string(unwrap(crypto.base64_decode("Zm9vYmE=")))))
    print(unwrap(bytes_to_string(unwrap(crypto.base64_decode("Zg==")))))
    print(is_ok(crypto.base64_decode("Zm9")))
    print(is_ok(crypto.base64_decode("Zm9v!A==")))
    print(hex(crypto.bytes_xor([1b, 2b, 255b], [3b, 2b, 15b])))
}
