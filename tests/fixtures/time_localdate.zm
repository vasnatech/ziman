use time.localdate_of
use time.localdate_to_string
use time.localdate_add_days
use time.localdate_add_months
use time.localdate_add_years
use time.localdate_diff_days
use time.localdate_compare
use time.localdate_to_epoch_day
use time.localdate_from_epoch_day
use time.localdate_is_leap_year

fn main() {
    val d = unwrap(localdate_of(1970, 1, 1))
    print(localdate_to_string(d))
    print(localdate_to_epoch_day(d))

    val d2 = unwrap(localdate_of(2024, 2, 29))
    print(localdate_to_string(d2))
    print(localdate_is_leap_year(2024))
    print(localdate_is_leap_year(1900))
    print(localdate_is_leap_year(2000))

    val d3 = localdate_add_days(d2, 1)
    print(localdate_to_string(d3))

    val d4 = localdate_add_months(unwrap(localdate_of(2024, 1, 31)), 1)
    print(localdate_to_string(d4))

    val d5 = localdate_add_years(d2, 1)
    print(localdate_to_string(d5))

    print(localdate_diff_days(d3, d2))
    print(localdate_compare(d2, d3))
    print(localdate_compare(d3, d2))
    print(localdate_compare(d2, d2))

    print(localdate_to_string(localdate_from_epoch_day(0)))
    print(localdate_to_string(localdate_from_epoch_day(-1)))

    val bad = localdate_of(2023, 2, 29)
    print(is_ok(bad))
}
