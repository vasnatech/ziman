use net
use httpclient
use http.HttpMethod

// An echo server that works on raw bytes, so a body may hold 0 bytes.
fn find_head_end(buf: [byte]) -> int {
    var i = 0
    while i + 3 < len(buf) {
        if buf[i] == 13b && buf[i + 1] == 10b && buf[i + 2] == 13b && buf[i + 3] == 10b {
            return i + 4
        }
        i = i + 1
    }
    return -1
}

fn handle(s: net.Socket) {
    defer net.close(s)
    unwrap(net.set_timeout(s, 2000))
    var buf: [byte] = []
    var end = find_head_end(buf)
    while end < 0 {
        buf = bytes_concat(buf, unwrap(net.read(s, 4096)))
        end = find_head_end(buf)
    }
    val head = to_lower(unwrap(bytes_to_string(slice<byte>(buf, 0, end))))
    var want = 0
    if contains(head, "content-length: ") {
        want = unwrap(parse_int(trim(split(split(head, "content-length: ")[1], "\r\n")[0])))
    }
    var body = slice<byte>(buf, end, len(buf))
    if want > len(body) {
        body = bytes_concat(body, unwrap(net.read_exact(s, want - len(body))))
    }
    if contains(head, "get /bin ") {
        body = [104b, 0b, 105b]
    }
    unwrap(net.write_text(s, format("HTTP/1.1 200 OK\r\nContent-Length: {}\r\n\r\n", len(body))))
    if len(body) > 0 {
        unwrap(net.write(s, body))
    }
}

fn accept_loop(l: net.Listener) {
    while true {
        val c = net.accept(l)
        if !is_ok(c) {
            return
        }
        spawn handle(unwrap(c))
    }
}

fn main() {
    val l = unwrap(net.listen("127.0.0.1", 0))
    val url = format("http://127.0.0.1:{}/", net.listener_port(l))
    spawn accept_loop(l)

    val payload = [1b, 0b, 255b, 10b, 0b]
    val r = httpclient.request_bytes(method: HttpMethod.Post, url: url, body: payload)
    val resp = unwrap(r)
    print(resp.status)
    print(resp.body == payload)
    print(len(resp.body))

    val empty = unwrap(httpclient.request_bytes(method: HttpMethod.Get, url: url))
    print(len(empty.body))

    val text = httpclient.request(method: HttpMethod.Post, url: url, body: "plain text")
    print(unwrap(text).body)

    val bin_url = format("{}bin", url)
    print(unwrap(httpclient.request_bytes(method: HttpMethod.Get, url: bin_url)).body == [104b, 0b, 105b])
    val as_text = httpclient.get(bin_url)
    print(is_ok(as_text))
    print(httpclient.error_message(unwrap_err(as_text)))
    net.close_listener(l)
}
