use crypto
use number.bytes_to_hex

fn main() {
    // bcrypt: known answers from the crypt_blowfish (Openwall) test suite
    print(crypto.bcrypt_verify("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"))
    print(crypto.bcrypt_verify("U*U*", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.VGOzA784oUp/Z0DY336zx7pLYAy0lwK"))
    print(crypto.bcrypt_verify("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.VGOzA784oUp/Z0DY336zx7pLYAy0lwK"))
    print(crypto.bcrypt_verify("x", "not a hash"))
    print(crypto.bcrypt_verify("x", ""))
    // a fresh hash: 60 characters, $2b$, verifies only its own password, and salts differ
    val h = unwrap(crypto.bcrypt_hash(password: "secret", cost: 4))
    print(len(h))
    print(starts_with(h, "$2b$04$"))
    print(crypto.bcrypt_verify("secret", h))
    print(crypto.bcrypt_verify("Secret", h))
    print(h != unwrap(crypto.bcrypt_hash(password: "secret", cost: 4)))
    print(is_ok(crypto.bcrypt_hash(password: "x", cost: 3)))

    // Argon2id: raw output against OpenSSL's own KDF (openssl kdf ... ARGON2ID) for two parameter sets
    val salt = string_to_bytes("somesaltsomesalt")
    print(bytes_to_hex(unwrap(crypto.argon2id_raw(string_to_bytes("password"), salt, 19456, 2, 1, 32))))
    print(bytes_to_hex(unwrap(crypto.argon2id_raw(string_to_bytes("password"), salt, 32, 3, 4, 24))))
    print(is_ok(crypto.argon2id_raw(string_to_bytes("password"), string_to_bytes("short"), 32, 3, 4, 24)))
    // ... and a PHC string built from the first
    val phc = "$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHRzb21lc2FsdA$K13EBUiG7JV+9ZxztmHFTdb7J0WQsnj2V8bZaqyPptE"
    print(crypto.argon2id_verify("password", phc))
    print(crypto.argon2id_verify("Password", phc))
    print(crypto.argon2id_verify("password", "$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHRzb21lc2FsdA"))
    print(crypto.argon2id_verify("password", "garbage"))
    // a fresh one
    val a = unwrap(crypto.argon2id_hash(password: "secret"))
    print(starts_with(a, "$argon2id$v=19$m=19456,t=2,p=1$"))
    print(crypto.argon2id_verify("secret", a))
    print(crypto.argon2id_verify("nope", a))

    // password_hash / password_verify / password_needs_rehash read the scheme from the text
    val stored = unwrap(crypto.password_hash("hunter2"))
    print(crypto.password_verify("hunter2", stored))
    print(crypto.password_verify("hunter3", stored))
    print(crypto.password_verify("secret", h))
    print(crypto.password_needs_rehash(stored))
    print(crypto.password_needs_rehash(h))
    print(crypto.password_needs_rehash(phc))
    val weak = unwrap(crypto.argon2id_hash(password: "x", memory_kib: 1024, iterations: 1, parallelism: 1))
    print(crypto.password_needs_rehash(weak))
}
