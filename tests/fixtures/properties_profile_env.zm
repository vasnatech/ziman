use properties

fn main() {
    val loaded = properties.load("tests/fixtures/props_conf/application")
    if !is_ok(loaded) {
        print(unwrap_err(loaded))
        return
    }
    val props = unwrap(loaded)
    print(unwrap(properties.get_int(props, "server.port")))
    print(unwrap(properties.get_bool(props, "server.log-requests")))
    print(unwrap(properties.get_string(props, "datasource.url")))
    print(unwrap(properties.get_int(props, "datasource.pool-size")))
    print(properties.report(props, "server.port", "server.extra", "datasource.url", "datasource.pool-size"))
    print(properties.load("tests/fixtures/props_conf/missing"))
}
