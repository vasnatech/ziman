use collections

struct P {
    name: string
    age: int
}

fn label(n: int) -> string {
    return concat("#", str(n))
}

fn is_big(n: int) -> bool {
    return n > 10
}

fn add(acc: int, n: int) -> int {
    return acc + n
}

fn longer(acc: string, s: string) -> string {
    if len(s) > len(acc) {
        return s
    }
    return acc
}

fn show(n: int) {
    print(concat("item ", str(n)))
}

fn by_age_then_name(a: P, b: P) -> int {
    if a.age != b.age {
        return a.age - b.age
    }
    return compare(a.name, b.name)
}

fn main() {
    val xs = [5, 12, 30, 7]
    print(array_map<int, string>(xs, label))
    print(array_filter<int>(xs, is_big))
    print(array_fold<int, int>(xs, 0, add))
    print(array_fold<string, string>(["aa", "bbbb", "c"], "", longer))
    print(array_any<int>(xs, is_big))
    print(array_all<int>(xs, is_big))
    print(array_find<int>(xs, is_big))
    print(array_find<int>([1, 2], is_big))
    array_for_each<int>([1, 2], show)
    val people = [P { name: "zed", age: 30 }, P { name: "amy", age: 30 }, P { name: "bob", age: 25 }]
    for p in array_sort_with<P>(people, by_age_then_name) {
        print(concat(p.name, str(p.age)))
    }
    val empty: [int] = []
    print(array_map<int, string>(empty, label))
}
