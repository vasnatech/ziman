// The seven bare array helpers, used with no `use` line at all -- which is the point of them:
// `Map` and `Set` have had bare `map_*`/`set_*` helpers all along, and arrays were the one
// collection whose helpers needed an import. `collections.map`/`filter`/`flat_map`/`reverse`/
// `sort`/`sort_desc`/`sort_with` are wrappers over these and still work; these are canonical.

struct P {
    key: int
    tag: string
}

// Only `key` is compared, so two entries with the same key are genuine ties and a stable sort
// has to keep them in input order -- in both directions, which is not the same as reversing.
fn p_compare(a: P, b: P) -> int {
    return compare(a.key, b.key)
}

fn tags(ps: [P]) -> string {
    val out = sb_new()
    for p in ps {
        sb_append(out, str(p.key), p.tag, " ")
    }
    return trim(sb_to_string(out))
}

fn main() {
    val ns = [5, 2, 9, 1, 5]
    print(array_map<int, int>(ns, fn(n) { n * 2 }))
    print(array_filter<int>(ns, fn(n) { n > 2 }))
    print(array_flat_map<int, int>([1, 2, 3], fn(n) { [n, n] }))
    print(array_reverse<int>(ns))

    print(array_sort<int>(ns))
    print(array_sort_desc<int>(ns))
    print(array_sort<string>(["pear", "fig", "apple"]))
    print(array_sort_with<int>(ns, fn(a: int, b: int) -> int { return compare(b, a) }))

    val empty: [int] = []
    print(array_sort<int>(empty))

    // The non-scalar path, through `compare` rather than the packed natives.
    val ps = [P { key: 2, tag: "a" }, P { key: 1, tag: "b" }, P { key: 2, tag: "c" }, P { key: 1, tag: "d" }]
    print(tags(ps))
    print(tags(array_sort<P>(ps)))
    print(tags(array_sort_desc<P>(ps)))
    print(tags(array_sort_with<P>(ps, fn(a: P, b: P) -> int { return compare(a.key, b.key) })))
}
