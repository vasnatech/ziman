use bits

fn main() {
    var bs = bits.bitset_new()
    bs = bits.bitset_set(bs, 0)
    bs = bits.bitset_set(bs, 3)
    bs = bits.bitset_set(bs, 5)
    bs = bits.bitset_set(bs, 63)
    print(bits.bitset_to_string(bs))       // {0, 3, 5, 63}
    print(bits.bitset_cardinality(bs))     // 4
    print(bits.bitset_length(bs))          // 64
    print(bits.bitset_get(bs, 3))          // true
    print(bits.bitset_get(bs, 4))          // false
    print(bits.bitset_is_empty(bs))        // false
    print(bits.bitset_is_empty(bits.bitset_new())) // true

    bs = bits.bitset_clear(bs, 3)
    print(bits.bitset_to_string(bs))       // {0, 5, 63}
    bs = bits.bitset_flip(bs, 3)           // adds 3 back
    bs = bits.bitset_flip(bs, 0)           // removes 0
    print(bits.bitset_to_string(bs))       // {3, 5, 63}

    val a = bits.bitset_set(bits.bitset_set(bits.bitset_new(), 1), 2)  // {1, 2}
    val b = bits.bitset_set(bits.bitset_set(bits.bitset_new(), 2), 3)  // {2, 3}
    print(bits.bitset_to_string(bits.bitset_and(a, b)))      // {2}
    print(bits.bitset_to_string(bits.bitset_or(a, b)))       // {1, 2, 3}
    print(bits.bitset_to_string(bits.bitset_xor(a, b)))      // {1, 3}
    print(bits.bitset_to_string(bits.bitset_and_not(a, b)))  // {1}

    print(bits.bitset_to_int(bits.bitset_of_int(42)))        // 42
}
