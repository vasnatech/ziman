use collections

// The _ctx forms thread an explicit value through to the function on every
// call -- how a function value gets at something it can't capture.
struct Route {
    method: string
    pattern: string
}

fn matches(want: string, r: Route) -> bool {
    return r.method == want
}

fn label(prefix: string, r: Route) -> string {
    return concat(prefix, concat(r.method, r.pattern))
}

fn above(threshold: int, n: int) -> bool {
    return n > threshold
}

fn main() {
    val routes = [Route { method: "GET", pattern: "/a" }, Route { method: "POST", pattern: "/b" }, Route { method: "GET", pattern: "/c" }]
    val first_post = collections.find_ctx<string, Route>(routes, "POST", matches)
    print(Option.unwrap_Some(first_post).pattern)
    print(Option.is_Some(collections.find_ctx<string, Route>(routes, "DELETE", matches)))
    print(len(collections.filter_ctx<string, Route>(routes, "GET", matches)))
    print(collections.map_ctx<string, Route, string>(routes, "> ", label))
    print(collections.filter_ctx<int, int>([1, 5, 9, 12], 4, above))
}
