use time.LocalDate
use time.localdate_of
use time.localdate_format
use time.localdate_from_string
use time.localdate_parse_pattern
use time.LocalTime
use time.localtime_of
use time.localtime_format
use time.localtime_from_string
use time.LocalDateTime
use time.localdatetime_of
use time.localdatetime_format
use time.localdatetime_from_string
use time.Instant
use time.instant_of
use time.instant_format
use time.instant_from_string
use time.instant_parse_pattern
use time.zoneoffset_utc
use time.zoneoffset_of_hours_minutes
use time.zoneoffset_from_string
use time.zoneoffset_to_string
use time.zoneid_from_string
use time.Duration
use time.duration_of_seconds
use time.duration_from_string
use time.duration_to_string
use time.iso_date_format
use time.iso_datetime_format
use time.datetime_format_of

fn main() {
    // Custom (non-ISO) pattern formatting and parsing -- compiled once
    // via datetime_format_of, then reused for both calls.
    val custom_fmt = datetime_format_of("dd/MM/yyyy")
    val d = unwrap(localdate_of(2024, 1, 31))
    print(localdate_format(d, custom_fmt))
    print(unwrap(localdate_parse_pattern("31/01/2024", custom_fmt)) == d)

    // ISO parse/format round trip.
    print(unwrap(localdate_from_string("2024-01-31")) == d)
    print(localdate_format(d, iso_date_format))

    val t = unwrap(localtime_of(9, 5, 3, 0))
    print(unwrap(localtime_from_string("09:05:03")) == t)
    val t2 = unwrap(localtime_of(9, 5, 3, 123000000))
    print(unwrap(localtime_from_string("09:05:03.123000000")) == t2)

    val dt = localdatetime_of(d, t)
    print(localdatetime_format(dt, iso_datetime_format))
    print(unwrap(localdatetime_from_string("2024-01-31T09:05:03")) == dt)

    // Instant round trip via UTC.
    val i = instant_of(0, 0)
    print(unwrap(instant_from_string("1970-01-01T00:00:00Z")) == i)

    // Instant with a real (non-UTC) offset -- formatted, then parsed
    // back to the same absolute instant.
    val plus5 = unwrap(zoneoffset_of_hours_minutes(5, 0))
    val formatted = instant_format(i, plus5, iso_datetime_format)
    print(formatted)
    print(unwrap(instant_parse_pattern(formatted, iso_datetime_format)) == i)

    // Duration round trip, including the negative-with-fraction
    // magnitude transform (the fiddliest inverse in this module).
    val neg = duration_of_seconds(0, -500000000)
    print(duration_to_string(neg))
    print(unwrap(duration_from_string(duration_to_string(neg))) == neg)
    val pos = duration_of_seconds(90061, 500000000)
    print(unwrap(duration_from_string(duration_to_string(pos))) == pos)

    // ZoneOffset/ZoneId round trip.
    print(unwrap(zoneoffset_from_string("Z")) == zoneoffset_utc())
    print(unwrap(zoneoffset_from_string(zoneoffset_to_string(plus5))) == plus5)
    print(is_ok(zoneid_from_string("UTC")))
    print(is_ok(zoneid_from_string("America/New_York")))
}
