use datasource
use db.DbError
use db.SqlValue
use db.row_get
use db.sql_as_int

// The motivating case: begin a transaction, `defer` the rollback, and
// every way out of the function -- an error propagated by `?`, or
// success -- leaves the connection with no transaction open. After a
// successful commit the deferred rollback finds nothing to roll back;
// its error result is discarded, which is the point of the shape.
fn insert_two(conn: datasource.Connection, a: int, b: int) -> Result<int, DbError> {
    try datasource.begin(conn)
    defer datasource.rollback(conn)
    try datasource.execute(conn, "INSERT INTO t (id) VALUES ($1)", SqlValue.Int(a))
    try datasource.execute(conn, "INSERT INTO t (id) VALUES ($1)", SqlValue.Int(b))
    try datasource.commit(conn)
    return 0
}

fn count(conn: datasource.Connection) -> int {
    val rows = unwrap(datasource.query(conn, "SELECT count(*) AS n FROM t"))
    return unwrap(sql_as_int(unwrap(row_get(rows[0], "n"))))
}

fn main() {
    val conn = unwrap(datasource.open("sqlite::memory:"))
    unwrap(datasource.execute(conn, "CREATE TABLE t (id INTEGER PRIMARY KEY)"))
    print(is_ok(insert_two(conn, 1, 2)))
    print(count(conn))
    // the second insert violates the primary key: `?` returns early, the
    // deferred rollback undoes the first insert too
    print(is_ok(insert_two(conn, 3, 3)))
    print(count(conn))
    // and the connection is not left inside a transaction: a fresh one begins fine
    print(is_ok(insert_two(conn, 4, 5)))
    print(count(conn))
}
