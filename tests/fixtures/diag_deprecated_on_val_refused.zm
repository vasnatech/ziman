// F58: `#[deprecated]` works on a function, a struct and an enum, but not on a val -- and the
// message now says what that would take rather than only that it is unsupported. A module-level
// val becomes a plain binding in the global scope (typecheck.c's check_global_vals), so a
// reference to it is an identifier lookup with no link back to this declaration, unlike a struct
// literal or an enum access which resolve through find_struct/find_enum.
#[deprecated("use limit instead")]
pub val old_limit = 10

fn main() {
    print(old_limit)
}
