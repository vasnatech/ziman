
// compare functions may return ANY integer: only the sign counts.
struct Score {
    name: string
    points: int
}

fn score_compare(a: Score, b: Score) -> int {
    return a.points - b.points
}

struct Grade {
    letter: string
}

fn grade_compare(a: Grade, b: Grade) -> int {
    if a.letter == b.letter {
        return 0
    }
    if a.letter < b.letter {
        return -1000
    }
    return 999999
}

#[derive(Ord)]
struct Row {
    score: Score
    grade: Grade
}

fn main() {
    val scores = [Score { name: "c", points: 50 }, Score { name: "a", points: 10 }, Score { name: "b", points: 30 }, Score { name: "d", points: 10 }]
    for s in array_sort<Score>(scores) {
        print(concat(s.name, str(s.points)))
    }
    for s in array_sort_desc<Score>(scores) {
        print(concat(s.name, str(s.points)))
    }
    print(array_is_sorted<Score>(array_sort<Score>(scores)))
    val sorted = array_sort<Score>(scores)
    print(array_binary_search<Score>(sorted, Score { name: "?", points: 30 }))
    // the builtin agrees on the sign, whatever the magnitude
    print(compare(scores[0], scores[1]) > 0)
    print(compare(scores[1], scores[0]) < 0)
    print(compare(scores[1], scores[3]) == 0)
    // a derived compare over fields with large-magnitude results, nested in Option and an array
    val rows = [Row { score: scores[0], grade: Grade { letter: "b" } }, Row { score: scores[1], grade: Grade { letter: "z" } }, Row { score: scores[1], grade: Grade { letter: "a" } }]
    for r in array_sort<Row>(rows) {
        print(concat(r.score.name, r.grade.letter))
    }
    val opts = [Option<Grade>.Some(Grade { letter: "z" }), Option<Grade>.None, Option<Grade>.Some(Grade { letter: "a" })]
    for o in array_sort<Option<Grade>>(opts) {
        print(o)
    }
    print(compare([Grade { letter: "a" }], [Grade { letter: "b" }]) < 0)
}
