use os

fn main() {
    val s = "hello world"
    val a = substring(s, 0, 5)
    val b = substring(s, 6, 11)
    print(a)
    print(b)
    print(len(a) + len(b))
    print(a == "hello")
    print(b == "world")
    print(hash(a) == hash("hello"))

    // a slice of a slice
    print(substring(substring("0123456789", 2, 8), 1, 4))

    // slices that are NOT at the end of their parent must never leak the
    // bytes after them into a C-string consumer
    print(unwrap(parse_int(substring("12345", 1, 3))))
    print(unwrap(parse_float(substring("1.5e3xyz", 0, 5))))
    print(unwrap(parse_int(split("k=42", "=")[1])))
    print(is_ok(parse_int(substring("12abc", 0, 4))))

    // an environment lookup through a slice (the variable name is embedded)
    print(Option.unwrap_Some(os.getenv(substring("aaZIMAN_SLICEbb", 2, 13))))

    // split, trim, join, replace, index_of on slices
    val parts = split("a,b,,c", ",")
    print(len(parts))
    print(join(separator: "-", pieces: parts))
    print(trim("   padded   ") == "padded")
    print(len(trim("   padded   ")))
    print(replace(substring("xxabcxx", 2, 5), "b", "B"))
    print(index_of(substring("xxabcxx", 2, 5), "c", 0))
    print(starts_with(substring("xxabcxx", 2, 5), "ab"))
    print(ends_with(substring("xxabcxx", 2, 5), "bc"))
    print(contains(substring("xxabcxx", 2, 5), "abc"))
    print(contains(substring("xxabcxx", 2, 5), "x"))
    print(concat(substring("xxabcxx", 2, 4), substring("yyabcyy", 4, 6)))
    print(format("[{}|{}]", char_at("hello", 1), substring("hello", 1, 4)))
    print(to_upper(substring("hello", 1, 4)))
    print(last_index_of(substring("a.b.c.d", 0, 5), "."))

    // char_at is a one-byte slice
    val c = char_at("xyz", 2)
    print(c == "z")
    print(len(c))
    print(is_char_at("xyz", 1, "y"))
}
