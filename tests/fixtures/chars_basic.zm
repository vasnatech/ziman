fn main() {
    val s = "héllo, wörld"
    print(len(s))          // byte length: 14 (é and ö are each 2 bytes)
    print(char_count(s))   // character count: 12
    print(chars(s))
    print(truncate_chars(s, 5))    // "héllo" -- never splits é
    print(truncate_chars(s, 0))
    print(is_empty(truncate_chars(s, 0)))
    print(truncate_chars(s, 100))  // longer than the string: unchanged

    print(chars(""))
    print(char_count(""))
    print(truncate_chars("", 5))

    // ASCII-only text: chars/char_count agree with the byte-based functions
    val ascii = "hello"
    print(len(ascii) == char_count(ascii))
    print(chars(ascii))
}
