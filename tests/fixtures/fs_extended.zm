use fs

fn main() {
    val d = "/tmp/ziman_fixture_fs_extended"
    val _ = fs.remove(fs.path_join(d, "a", "b", "f.bin"))
    val _ = fs.remove(fs.path_join(d, "a", "b"))
    val _ = fs.remove(fs.path_join(d, "a"))
    val _ = fs.remove(fs.path_join(d, "copy.bin"))
    val _ = fs.remove(fs.path_join(d, "atomic.txt"))
    val _ = fs.remove(d)
    print(fs.make_dirs(fs.path_join(d, "a", "b")))
    print(fs.make_dirs(fs.path_join(d, "a", "b")))
    print(fs.is_dir(fs.path_join(d, "a", "b")))
    val f = fs.path_join(d, "a", "b", "f.bin")
    print(fs.write_bytes(f, [0b, 1b, 255b, 0b, 65b]))
    print(fs.append_bytes(f, [10b]))
    print(fs.read_bytes(f))
    print(is_ok(fs.read_text(f)))
    print(fs.is_file(f))
    print(fs.is_file(d))
    print(fs.size(f))
    val c = fs.path_join(d, "copy.bin")
    print(fs.copy_file(f, c))
    print(fs.read_bytes(c))
    print(fs.write_text_atomic(fs.path_join(d, "atomic.txt"), "hello"))
    print(fs.write_text_atomic(fs.path_join(d, "atomic.txt"), "second"))
    print(unwrap(fs.read_text(fs.path_join(d, "atomic.txt"))))
    print(fs.list_dir(d))
    print(unwrap(fs.modified_seconds(f)) > 1600000000)
    print(is_ok(fs.modified_seconds(fs.path_join(d, "missing"))))
    print(is_ok(fs.read_bytes("/nonexistent_dir/x")))
    print(is_ok(fs.write_bytes("/nonexistent_dir/x", [1b])))
    print(is_ok(fs.copy_file("/nonexistent_dir/x", c)))
    print(fs.write_text_atomic("/nonexistent_dir/x", "y"))
    print(fs.remove(f))
    print(fs.remove(fs.path_join(d, "a", "b")))
    print(fs.remove(fs.path_join(d, "a")))
    print(fs.remove(c))
    print(fs.remove(fs.path_join(d, "atomic.txt")))
    print(fs.remove(d))
    print(fs.path_join("a/", "/b", "c.txt"))
    print(fs.path_join("/", "x"))
    print(fs.path_join("a", "", "b"))
    print(fs.file_name("a/b/c.txt"))
    print(fs.file_name("a/b/"))
    print(fs.file_name("plain"))
    print(fs.parent_dir("a/b/c.txt"))
    print(fs.parent_dir("plain"))
    print(fs.parent_dir("/top"))
    print(fs.extension("a/b.tar.gz"))
    print(fs.extension(".bashrc"))
    print(fs.extension("a/b"))
}
