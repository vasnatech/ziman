// The `from` constructors take either world -- the immutable value or another handle -- which is
// what keeps the conversion matrix from being two functions per shape. There is no union type in
// the language and these need none: they are hand-checked builtins, exactly as their immutable
// twins (`set_from_array`, `map_merge`, ...) already were.
//
// Two properties worth pinning. From an immutable source, the handle is independent: the last block
// writes 999 through the handle and the source Map still reads 1. From a handle, `from` *is* clone,
// which is the reason it accepts both -- `mutable_map_from(snapshot(m))` would copy twice.
//
// `mutable_set_from_array` is a separate name rather than another source for `mutable_set_from`
// because it deduplicates: [1, 2, 1, 3, 2] becomes three elements, and a reader of
// `mutable_set_from(xs)` would have no reason to expect that.
fn main() {
    // from an immutable value
    val xs = mutable_array_from([3, 1, 2])
    print(snapshot(xs))
    mutable_array_push(xs, 4)
    print(snapshot(xs))

    val m = mutable_map_from(Map<string, int> { "a": 1, "b": 2 })
    print(mutable_map_values(m))
    mutable_map_set(m, "c", 3)
    print(mutable_map_keys(m))

    val s = mutable_set_from(Set<int> { 7, 3 })
    print(mutable_set_items(s))

    val d = mutable_set_from_array([1, 2, 1, 3, 2])
    print(mutable_set_items(d))

    // from another handle -- which is clone
    val clone = mutable_array_from(xs)
    mutable_array_push(clone, 99)
    print(snapshot(xs))
    print(snapshot(clone))

    val mclone = mutable_map_from(m)
    mutable_map_set(mclone, "z", 26)
    print(mutable_map_keys(m))
    print(mutable_map_keys(mclone))

    val sclone = mutable_set_from(s)
    print(mutable_set_add(sclone, 5))
    print(mutable_set_items(s))
    print(mutable_set_items(sclone))

    val dfromhandle = mutable_set_from_array(xs)
    print(mutable_set_items(dfromhandle))

    // the source value is untouched
    val source = Map<string, int> { "k": 1 }
    val h = mutable_map_from(source)
    mutable_map_set(h, "k", 999)
    print(map_get(source, "k"))
    print(mutable_map_get(h, "k"))
}
