use number

fn main() {
    // shortest text that reads back exactly
    print(number.float_to_text(0.1))
    print(number.float_to_text(1234567.891))
    print(number.float_to_text(150.0))
    print(number.float_to_text(0.1 + 0.2))
    print(number.float_to_text(-0.000001))
    print(number.float_to_text(100000000000000000000.0))
    print(number.float_to_text(1000000000000000000000.0))
    print(number.float_to_text(0.0000001))
    print(number.float_to_text(0.00000001))
    print(number.float_to_text(12345678901234567890123.0))
    print(number.float_to_text(0.0))
    print(number.float_to_text(unwrap(parse_float("nan"))))
    print(number.float_to_text(unwrap(parse_float("1e300"))))
    print(number.float_to_text(-2.5))
    print(number.format_float(1234567.891, number.parse_pattern("#,###.00")))
    print(number.format_float(0.5, number.number_format_plain()))
    // hex
    print(number.int_to_hex(255))
    print(number.int_to_hex(0))
    print(number.int_to_hex(-1))
    print(number.int_to_hex(-255))
    print(number.int_from_hex("ff"))
    print(number.int_from_hex("FFFFFFFFFFFFFFFF"))
    print(number.int_from_hex("7fffffffffffffff"))
    print(unwrap_err(number.int_from_hex("")))
    print(unwrap_err(number.int_from_hex("12345678901234567")))
    print(unwrap_err(number.int_from_hex("xyz")))
    print(number.byte_to_hex(0b))
    print(number.byte_to_hex(171b))
    print(number.byte_from_hex("Ab"))
    print(unwrap_err(number.byte_from_hex("abc")))
    print(unwrap_err(number.byte_from_hex("g1")))
    // big-endian integers
    print(number.u16_to_bytes(0))
    print(number.u16_to_bytes(65535))
    print(number.u32_to_bytes(305419896))
    print(number.u32_to_bytes(4294967295))
    print(number.u16_from_bytes([0b, 1b, 2b, 3b], 1))
    print(number.u32_from_bytes([0b, 1b, 2b, 3b, 4b], 1))
}
