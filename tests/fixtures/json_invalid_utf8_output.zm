// JSON is defined over Unicode text, so a document containing a byte that is not valid UTF-8 is not
// JSON. `substring`, `char_at` and `index_of` work on byte positions by design, so splitting a
// multi-byte character is a documented possibility and the result is an ordinary string that flows
// anywhere a string does -- including into `#[derive(Json)]` output. Before this was fixed the
// encoder copied those bytes through, producing a document Python's `json` refused to decode while
// this module's own `parse_json` accepted it: every test written in Ziman passed and the client
// failed. The encoder now substitutes U+FFFD, so what leaves is always valid UTF-8.
use json

#[derive(Json)]
struct Note {
    text: string
}

fn main() {
    // valid text of every width passes through untouched
    print(json.json_to_string(json.Json.JString("café 日本語")))

    // control characters are still escaped, not replaced
    print(json.json_to_string(json.Json.JString("a\tb\nc")))

    // a three-byte character truncated at each point, then whole
    val three = "日x"
    print(json.json_to_string(json.Json.JString(substring(three, 0, 1))))
    print(json.json_to_string(json.Json.JString(substring(three, 0, 2))))
    print(json.json_to_string(json.Json.JString(substring(three, 0, 3))))

    // a four-byte character (an emoji), built from its bytes since the lexer has no \U escape
    switch bytes_to_string([240b, 159b, 152b, 128b, 120b]) {
        Ok(four) {
            print(json.json_to_string(json.Json.JString(substring(four, 0, 2))))
            print(json.json_to_string(json.Json.JString(substring(four, 0, 4))))
        }
        Err(e) { printf("could not build the 4-byte character: {}\n", e) }
    }

    // and through a derived encoder, which is how it reaches a real client
    print(json.json_to_string(note_to_json(Note { text: substring("café au lait", 0, 4) })))

    // bytes_to_string, by contrast, refuses invalid input outright rather than substituting
    switch bytes_to_string([99b, 195b]) {
        Ok(v) { printf("unexpectedly accepted: {}\n", v) }
        Err(e) { printf("bytes_to_string: {}\n", e) }
    }
}
