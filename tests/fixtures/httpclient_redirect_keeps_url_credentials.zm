// D20: credentials given in the URL (`https://user:pass@host/`) vanished on every redirect,
// including a plain `/login` -> `/home` on the same host. `resolve_location` rebuilds the URL from
// scheme + host:port + path and has nowhere to put `userinfo`, and the request headers are rebuilt
// from the current URL on each hop -- so the second request arrived with no `Authorization` at all
// and the caller got a 401 from a server it had given a password to.
//
// The documented rule is that an `Authorization` header is not sent to a *different* host, and the
// header a caller passes in was always carried correctly across a same-host hop. This is the URL
// form only. The cross-host case is checked here too, because the fix must not widen the rule.
use client
use http
use net

fn put(s: net.Socket, text: string) {
    unwrap(net.write_text(s, text))
}

fn read_head(s: net.Socket) -> string {
    var acc = ""
    while !contains(acc, "\r\n\r\n") {
        acc = concat(acc, unwrap(net.read_text(s, 4096)))
    }
    return acc
}

fn authorization_of(head: string) -> string {
    for line in split(head, "\r\n") {
        if starts_with(to_lower(line), "authorization: ") {
            return trim(substring(line, 15, len(line)))
        }
    }
    return "(none)"
}

fn handle(s: net.Socket) {
    defer net.close(s)
    unwrap(net.set_timeout(s, 2000))
    val head = read_head(s)
    val path = split(split(head, "\r\n")[0], " ")[1]
    if path == "/login" {
        put(s, "HTTP/1.1 302 Found\r\nLocation: /home\r\nContent-Length: 0\r\n\r\n")
    } else {
        val seen = authorization_of(head)
        put(s, format("HTTP/1.1 200 OK\r\nContent-Length: {}\r\n\r\n{}", len(seen), seen))
    }
}

fn serve(l: net.Listener, rounds: int) {
    for i in 0..rounds {
        if Ok(s) = net.accept(l) {
            handle(s)
        }
    }
}

fn main() {
    val l = unwrap(net.listen("127.0.0.1", 0))
    val port = net.listener_port(l)
    spawn serve(l, 4) on_error fn(message: string) {
        print(concat("server: ", message))
    }
    val base = format("http://ada:secret@127.0.0.1:{}", port)
    val redirected = unwrap(client.get(concat(base, "/login")))
    print(format("after a same-host redirect: {}", unwrap(bytes_to_string(redirected.body))))
    val direct = unwrap(client.get(concat(base, "/home")))
    print(format("without a redirect:         {}", unwrap(bytes_to_string(direct.body))))
    net.close_listener(l)
}
