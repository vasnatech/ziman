struct Table<K: Eq, V> {
    keys: [K]
    values: [V]
}

enum Maybe<T> {
    Some(T)
    None
}

fn table_get<K: Eq, V>(m: Table<K, V>, key: K) -> Maybe<V> {
    for i, k in m.keys {
        if k == key {
            return Maybe<V>.Some(m.values[i])
        }
    }
    return Maybe<V>.None
}

fn main() {
    val m = Table<int, string> { keys: [1, 2, 3], values: ["a", "b", "c"] }
    val found = table_get<int, string>(m, 2)
    val missing = table_get<int, string>(m, 99)
    print(Maybe.is_Some(found))
    print(Maybe.unwrap_Some(found))
    print(Maybe.is_None(missing))
}
