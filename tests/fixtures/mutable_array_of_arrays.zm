// Regression test: MutableArray<T> where T is itself an array type
// (exactly what array_zm's new_buckets_of_size builds) -- each
// individual mutable_array_push call passes exactly one [int] element, the
// genuinely ambiguous single-trailing-argument shape (see
// variadic_array_element_type.zm).
fn main() {
    val ab = mutable_array_new<[int]>()
    val empty: [int] = []
    var i = 0
    while i < 5 {
        mutable_array_push<[int]>(ab, empty)
        i = i + 1
    }
    print(len(ab))
    print(len(snapshot(ab)))
}
