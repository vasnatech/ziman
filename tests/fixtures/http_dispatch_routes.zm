use http
use server
use http.HttpMethod

// What `server.routes` + `server.dispatch` promise: the first endpoint in the table whose method and pattern
// match wins (so order decides between a `{param}` and a literal), a trailing slash is ignored, captures are
// percent-decoded, an empty segment never fills a `{param}`, and a path that exists under other methods is a 405
// naming them, in table order, while an unknown path is a 404.

struct Ctx {
    tag: string
}

fn fault(status: int, message: string) -> http.Response {
    return server.text_response(status, message)
}

fn says(name: string) -> fn(Ctx, http.Request, server.Params) -> http.Response {
    return fn(ctx: Ctx, req: http.Request, params: server.Params) -> http.Response {
        return server.text_response(200, name)
    }
}

fn param_id(ctx: Ctx, req: http.Request, params: server.Params) -> http.Response {
    return server.text_response(200, concat("id=", server.param(params, "id")))
}

fn two(ctx: Ctx, req: http.Request, params: server.Params) -> http.Response {
    return server.text_response(200, format("{}/{}", server.param(params, "a"), server.param(params, "b")))
}

fn request(method: HttpMethod, path: string) -> http.Request {
    return http.Request {
        method: method,
        target: path,
        path: path,
        query: "",
        version: "HTTP/1.1",
        headers: [],
        body: []
    }
}

fn show(table: server.Routes<Ctx>, method: HttpMethod, path: string) {
    val r = server.dispatch<Ctx>(table, Ctx { tag: "t" }, request(method, path), fault)
    val allow = http.header_value(r.headers, "Allow")
    val allowed = if Option.is_Some(allow) { concat("  Allow: ", Option.unwrap_Some(allow)) } else { "" }
    print(format("{} {} -> {} {}{}", http.method_name(method), path, r.status, unwrap(bytes_to_string(r.body)), allowed))
}

fn main() {
    val table = server.routes<Ctx>([
        server.Endpoint<Ctx> { method: HttpMethod.Get, pattern: "/", handler: says("root") },
        server.Endpoint<Ctx> { method: HttpMethod.Get, pattern: "/items/{id}", handler: param_id },
        server.Endpoint<Ctx> { method: HttpMethod.Get, pattern: "/items/new", handler: says("literal new") },
        server.Endpoint<Ctx> { method: HttpMethod.Post, pattern: "/items", handler: says("create") },
        server.Endpoint<Ctx> { method: HttpMethod.Delete, pattern: "/items/{id}", handler: says("delete") },
        server.Endpoint<Ctx> { method: HttpMethod.Put, pattern: "/items/{id}", handler: says("put") },
        server.Endpoint<Ctx> { method: HttpMethod.Get, pattern: "/pairs/{a}/{b}", handler: two },
        server.Endpoint<Ctx> { method: HttpMethod.Get, pattern: "/health/", handler: says("health") }
    ])

    // The root, and a trailing slash on the request or the pattern.
    show(table, HttpMethod.Get, "/")
    show(table, HttpMethod.Get, "/health")
    show(table, HttpMethod.Get, "/health/")
    show(table, HttpMethod.Get, "/items/7/")

    // Table order decides: `/items/{id}` comes before `/items/new`, so `new` is an id.
    show(table, HttpMethod.Get, "/items/new")

    // Captures are percent-decoded; an empty segment fills no `{param}`; bad encoding is no match.
    show(table, HttpMethod.Get, "/items/a%20b")
    show(table, HttpMethod.Get, "/pairs/x%2Fy/z")
    show(table, HttpMethod.Get, "/items//")
    show(table, HttpMethod.Get, "/pairs//z")
    show(table, HttpMethod.Get, "/items/%zz")

    // Same path, other methods: 405 listing what does exist, in table order. Nothing there: 404.
    show(table, HttpMethod.Patch, "/items/7")
    show(table, HttpMethod.Get, "/items")
    show(table, HttpMethod.Post, "/items/7")
    show(table, HttpMethod.Get, "/nope")
    show(table, HttpMethod.Get, "/items/7/extra")
    show(table, HttpMethod.Get, "/pairs/only")
    show(table, HttpMethod.Head, "/")
}
