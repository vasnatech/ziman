use json.parse_json
use json.json_to_string
use json.Json

// `\r` is a string escape now, which also lets JSON handle CRLF.
fn main() {
    val crlf = "a\r\nb"
    print(len(crlf))
    print(substring(crlf, 1, 2) == "\r")
    // CR as structural whitespace between JSON tokens
    val j = unwrap(parse_json("{\r\n  \"k\": \"v\"\r\n}"))
    print(json_to_string(j))
    // a \r escape inside a JSON string round-trips
    val s = unwrap(parse_json("\"x\\ry\""))
    print(len(Json.unwrap_JString(s)))
    print(json_to_string(s))
}
