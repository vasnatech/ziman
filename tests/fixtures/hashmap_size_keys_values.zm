use collections.HashMap
use collections.hashmap_new
use collections.hashmap_set
use collections.hashmap_remove
use collections.hashmap_size
use collections.hashmap_keys
use collections.hashmap_values

fn sum(xs: [int]) -> int {
    var total = 0
    for x in xs {
        total = total + x
    }
    return total
}

fn main() {
    var m: HashMap<string, int> = hashmap_new<string, int>()
    print(hashmap_size<string, int>(m))

    m = hashmap_set<string, int>(m, "a", 1)
    m = hashmap_set<string, int>(m, "b", 2)
    m = hashmap_set<string, int>(m, "c", 3)
    print(hashmap_size<string, int>(m))
    print(sum(hashmap_values<string, int>(m)))
    print(len(hashmap_keys<string, int>(m)))

    m = hashmap_set<string, int>(m, "a", 10) // overwrite, not a new entry
    print(hashmap_size<string, int>(m))
    print(sum(hashmap_values<string, int>(m)))

    m = hashmap_remove<string, int>(m, "b")
    print(hashmap_size<string, int>(m))

    m = hashmap_remove<string, int>(m, "does-not-exist") // no-op
    print(hashmap_size<string, int>(m))
}
