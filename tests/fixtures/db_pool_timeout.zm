use db.db_error_message
use sql

fn main() {
    val url = "sqlite:/tmp/ziman_fixture_pool_timeout.db"
    val pool = unwrap(sql.open_pool(url, 2))
    val a = unwrap(sql.acquire_timeout(pool, 50))
    val b = unwrap(sql.acquire_timeout(pool, 0))
    val none = sql.acquire_timeout(pool, 40)
    print(is_ok(none))
    print(db_error_message(unwrap_err(none)))
    print(is_ok(sql.acquire_timeout(pool, 0)))
    sql.release(pool, a)
    val again = sql.acquire_timeout(pool, 40)
    print(is_ok(again))
    sql.release(pool, unwrap(again))
    sql.release(pool, b)
    // discard puts a fresh connection back
    val c = unwrap(sql.acquire(pool))
    sql.discard(pool, c)
    val d = unwrap(sql.acquire_timeout(pool, 0))
    print(is_ok(sql.query(d, "SELECT 1 AS n", [])))
    sql.release(pool, d)
    // on a plain connection both are no-ops
    val plain = unwrap(sql.open("sqlite::memory:"))
    val same = unwrap(sql.acquire_timeout(plain, 10))
    sql.discard(plain, same)
    print(is_ok(sql.query(plain, "SELECT 1 AS n", [])))
    sql.close(pool)
    sql.close(plain)
}
