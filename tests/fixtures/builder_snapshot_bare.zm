// `snapshot` is one name for the four conversions out of a builder -- `snapshot`,
// `snapshot`, `snapshot`, `snapshot` -- and the result type follows the argument's:
// an `[T]`, a `string`, a `Map<K, V>` or a `Set<T>`. Nothing about the copy changes, which is
// the half worth pinning: the builder stays usable and a later change does not touch a snapshot
// already taken.
use collections

fn main() {
    val ab = mutable_array_new<int>()
    mutable_array_push(ab, 3, 1, 2)
    val xs = snapshot(ab)
    print(xs)
    print(snapshot(ab))
    // A real `[int]`, not an array of nothing: indexing, arithmetic and `len` all work on it.
    print(len(xs))
    print(xs[0] + xs[1])

    val sb = mutable_string_new()
    mutable_string_append(sb, "hel", "lo")
    print(snapshot(sb))
    print(concat(snapshot(sb), "!"))

    val mb = mutable_map_new<string, int>()
    mutable_map_set(mb, "a", 1)
    mutable_map_set(mb, "b", 2)
    val m = snapshot(mb)
    print(m)
    print(map_get(m, "a"))
    print(map_keys(m))

    val st = mutable_set_new<string>()
    mutable_set_add(st, "x")
    print(snapshot(st))
    print(contains(snapshot(st), "x"))

    // The snapshot does not move when the builder changes afterwards.
    mutable_array_push(ab, 99)
    print(xs)
    print(snapshot(ab))

    // A non-scalar element type comes back with its real type, so this type-checks and sorts.
    val strs = mutable_array_new<string>()
    mutable_array_push(strs, "q", "p")
    print(collections.sort<string>(snapshot(strs)))
}
