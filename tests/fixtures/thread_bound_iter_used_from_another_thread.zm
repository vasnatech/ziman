// As thread_bound_used_from_another_thread, for an Iter rather than a builder: the lambda captures it
// and `spawn` now refuses that at compile time (A14, 2026-10-06) rather than letting the receiving
// thread trip the run-time owner check in src/iter.c, which remains as a backstop.
use fs

fn run(job: fn(), done: Channel<int>) {
    job()
    send(done, 1)
}

fn main() {
    unwrap(fs.write_text("/tmp/ziman_iter_thread.txt", "one\ntwo\n"))
    val lines = unwrap(fs.lines("/tmp/ziman_iter_thread.txt"))
    val done: Channel<int> = channel_new()
    spawn run(fn() { print(iter_next<Result<string, string>>(lines)) }, done)
    print(receive(done))
}
