use datasource
use db
use db.DbError
use db.Row
use db.SqlValue
use db.db_error_message

struct Transfer {
    from: int
    to: int
    amount: int
}

fn setup(conn: datasource.Connection) -> Result<int, DbError> {
    datasource.execute(conn,
        "CREATE TABLE acct (id INTEGER PRIMARY KEY, balance INTEGER NOT NULL CHECK (balance >= 0))")?
    datasource.execute(conn, "INSERT INTO acct (id, balance) VALUES (1, 100), (2, 50)")?
    return ok(0)
}

fn transfer(tx: datasource.Connection, t: Transfer) -> Result<int, DbError> {
    datasource.execute(tx, "UPDATE acct SET balance = balance - $1 WHERE id = $2",
        SqlValue.Int(t.amount), SqlValue.Int(t.from))?
    datasource.execute(tx, "UPDATE acct SET balance = balance + $1 WHERE id = $2",
        SqlValue.Int(t.amount), SqlValue.Int(t.to))?
    return ok(t.amount)
}

fn just_fail(tx: datasource.Connection) -> Result<int, DbError> {
    datasource.execute(tx, "UPDATE acct SET balance = 0 WHERE id = 1")?
    return err(DbError.Sql("changed my mind"))
}

fn count_rich(tx: datasource.Connection) -> Result<int, DbError> {
    val rows = datasource.query(tx, "SELECT id FROM acct WHERE balance > 60")?
    return ok(len(rows))
}

fn balances(conn: datasource.Connection) -> string {
    val rows = unwrap(datasource.query(conn, "SELECT balance FROM acct ORDER BY id"))
    return format("{}", len(rows))
}

fn total(conn: datasource.Connection, id: int) -> int {
    val rows = unwrap(datasource.query(conn, "SELECT balance FROM acct WHERE id = $1", SqlValue.Int(id)))
    return unwrap(sql_as_int_of(rows[0]))
}

fn sql_as_int_of(row: Row) -> Result<int, DbError> {
    return db.sql_as_int(unwrap(db.row_get(row, "balance")))
}

fn main() {
    val conn = unwrap(datasource.open("sqlite::memory:"))
    unwrap(setup(conn))
    val first = Transfer { from: 1, to: 2, amount: 30 }
    val too_much = Transfer { from: 1, to: 2, amount: 500 }
    // success commits
    print(unwrap(datasource.with_transaction<int>(conn,
        fn(tx: datasource.Connection) -> Result<int, DbError> { return transfer(tx, first) })))
    print(total(conn, 1))
    print(total(conn, 2))
    // an Err from work rolls back: the UPDATE inside it is undone
    val failed = datasource.with_transaction<int>(conn, just_fail)
    print(is_ok(failed))
    print(db_error_message(unwrap_err(failed)))
    print(total(conn, 1))
    // a constraint violation midway rolls the first UPDATE back too
    val overdraw = datasource.with_transaction<int>(conn,
        fn(tx: datasource.Connection) -> Result<int, DbError> { return transfer(tx, too_much) })
    print(is_ok(overdraw))
    print(total(conn, 1))
    print(total(conn, 2))
    // read-only work returns its value
    print(unwrap(datasource.with_transaction<int>(conn, count_rich)))
    datasource.close(conn)
}
