// F96: a MutableArray can be read and written in place, and iterated. Before this it was append-only, so a
// loop that needed what it had already appended had to call `snapshot` -- a full copy per call, which in
// a loop is the quadratic cost a builder exists to avoid (`--lint` flags that shape, and its message now
// names `mutable_array_get`). MutableMap and MutableSet have had `get`/`contains`/`len` from the start; this is the
// same thing for the one builder that did not.
fn main() {
    val ab = mutable_array_new<int>()
    mutable_array_push(ab, 10, 20, 30)
    print(mutable_array_get(ab, 0))
    print(mutable_array_get(ab, len(ab) - 1))

    // Overwriting what is there, which is not appending: the length does not change.
    mutable_array_set(ab, 1, 99)
    print(snapshot(ab))
    print(len(ab))

    // Both loop shapes an array takes, over the builder itself -- nothing is copied.
    for i, x in ab {
        printf("{}={} ", i, x)
    }
    print("")
    var total = 0
    for x in ab {
        total = total + x
    }
    print(total)

    // The boxed path: an element type that is not byte/bool/int/float keeps Values rather than packing.
    val names = mutable_array_new<string>()
    mutable_array_push(names, "ada", "grace")
    print(mutable_array_get(names, 1))
    for n in names {
        print(n)
    }

    // A body that appends sees its own additions, as it would in the array this is becoming, and the loop
    // still ends: each pass reads the length as it is then.
    val growing = mutable_array_new<int>()
    mutable_array_push(growing, 1)
    for x in growing {
        if x < 4 {
            mutable_array_push(growing, x + 1)
        }
    }
    print(snapshot(growing))

    // And a body that empties it ends the loop rather than reading past the end.
    val emptied = mutable_array_new<int>()
    mutable_array_push(emptied, 1, 2, 3)
    var seen = 0
    for _ in emptied {
        seen = seen + 1
        clear(emptied)
    }
    print(seen)
    print(len(emptied))

    // Clearing keeps the buffer, so the builder is reusable.
    mutable_array_push(emptied, 5, 6)
    print(snapshot(emptied))
}
