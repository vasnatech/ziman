use json
use json.Json
use json.Number

// How parse_json reads a number: an Int that fits 64 bits, a Bigint past that (exact, never a float that has lost its low
// digits), a Float for a fraction or an exponent -- and, for parse_json_exact, a Decimal that keeps every digit and the scale.

fn kind(j: Json) -> string {
    val n = Json.unwrap_JNumber(j)
    switch n {
        Int(i) { return format("Int {}", i) }
        Float(f) { return format("Float {}", f) }
        Bigint(b) { return format("Bigint {}", b) }
        Decimal(d) { return format("Decimal {}", d) }
    }
}

fn show(text: string) {
    val r = json.parse_json(text)
    if is_ok(r) {
        print(format("{} -> {}", text, kind(unwrap(r))))
    } else {
        print(format("{} -> error: {}", text, unwrap_err(r)))
    }
}

fn show_exact(text: string) {
    val r = json.parse_json_exact(text)
    if is_ok(r) {
        print(format("{} -> {} -> {}", text, kind(unwrap(r)), json.json_to_string(unwrap(r))))
    } else {
        print(format("{} -> error: {}", text, unwrap_err(r)))
    }
}

fn digits(n: int) -> string {
    val sb = sb_new()
    for i in 0..n {
        sb_append(sb, "7")
    }
    return sb_to_string(sb)
}

fn main() {
    // the default parse
    show("0")
    show("-0")
    show("42")
    show("-9223372036854775808")
    show("9223372036854775807")
    show("9223372036854775808")
    show("-9223372036854775809")
    show("12345678901234567890")
    show("100000000000000000000")
    show("1.5")
    show("2e2")
    show("0.1")
    show("1E+2")
    show("-1.25e-3")

    // JSON's grammar: no leading zeros, no plus, no bare or trailing point, a complete exponent
    show("01")
    show("-01")
    show("00")
    show("[1, 01]")
    show("+1")
    show(".5")
    show("5.")
    show("1e")
    show("-")
    show("0.5")
    show("-0.5")
    show("0e0")

    // what a big integer writes back as: its digits, not a float
    print(json.json_to_string(unwrap(json.parse_json("[12345678901234567890, 1.5, 3]"))))

    // the readers decide what is lossless
    val big = unwrap(json.parse_json("12345678901234567890"))
    print(json.int_from_json(big))
    print(json.bigint_from_json(big))
    print(json.float_from_json(big))
    print(json.decimal_from_json(big))
    val whole = unwrap(json.parse_json("3.0"))
    print(json.int_from_json(whole))
    print(json.bigint_from_json(whole))
    val frac = unwrap(json.parse_json("3.5"))
    print(json.int_from_json(frac))
    print(json.bigint_from_json(frac))
    print(json.decimal_from_json(frac))
    print(json.int_from_json(json.bigint_to_json(9223372036854775807n)))
    print(json.int_from_json(json.bigint_to_json(9223372036854775808n)))
    print(json.int_from_json(json.string_to_json("5")))

    // a huge integer is refused, not turned into work: 1000 digits is the limit
    print(is_ok(json.parse_json(digits(1000))))
    print(unwrap_err(json.parse_json(digits(1001))))

    // parse_json_exact: a fraction or exponent is a Decimal with every digit and its scale
    show_exact("19.90")
    show_exact("0.1234567890123456789012345")
    show_exact("1.5e3")
    show_exact("1e-3")
    show_exact("0.5e2")
    show_exact("-0.0")
    show_exact("2e2")
    show_exact("12345678901234567890")
    show_exact("7")
    show_exact("01")
    show_exact("1e100000")
    show_exact("1e100001")
    print(is_ok(json.parse_json_exact(concat("0.", digits(999)))))
    print(unwrap_err(json.parse_json_exact(concat("0.", digits(1000)))))
    print(json.decimal_from_json(unwrap(json.parse_json_exact("19.90"))))
    print(json.float_from_json(unwrap(json.parse_json_exact("19.90"))))
    print(json.int_from_json(unwrap(json.parse_json_exact("3.00"))))
    print(json.int_from_json(unwrap(json.parse_json_exact("3.5"))))
    print(json.bigint_from_json(unwrap(json.parse_json_exact("300e1"))))

    // writing: a decimal keeps its scale, the default parse would have lost it
    print(json.json_to_string(json.decimal_to_json(19.90d)))
    print(json.json_to_string(json.decimal_to_json(0.5d)))
    print(json.json_to_string(json.decimal_to_json(-3d)))
    print(json.json_to_string(json.decimal_to_json(1.000000000000000000001d)))
    print(json.json_to_string(json.bigint_to_json(-123456789012345678901234567890n)))
    print(json.json_to_string(unwrap(json.parse_json("19.90"))))
}
