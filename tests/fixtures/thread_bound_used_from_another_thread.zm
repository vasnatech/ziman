// A lambda capturing a MutableString and handed to `spawn`. This used to type-check and fail on the
// receiving thread, at the builder's own run-time owner check; since A14 (2026-10-06) the capture is
// recorded on the lambda's type, so it is refused where it is written instead. The runtime check in
// src/prelude.c stays as a backstop for any route the type checker cannot see -- what this fixture
// pins now is that the common case never gets that far.
fn run(job: fn(), done: Channel<int>) {
    job()
    send(done, 1)
}

fn main() {
    val sb = mutable_string_new()
    mutable_string_append(sb, "main ")
    val done: Channel<int> = channel_new()
    spawn run(fn() { mutable_string_append(sb, "thread") }, done)
    print(receive(done))
    print(snapshot(sb))
}
