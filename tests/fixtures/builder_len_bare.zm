// `len` works on all four builders, not just on an array, string, map or set -- so asking a
// builder its size no longer needs a per-type name, and never needs a conversion. The per-type
// functions still work and must agree, which is what the pairs below check.

fn main() {
    val ab = ab_new<int>()
    ab_append(ab, 1, 2, 3)
    print(len(ab))
    print(ab_len(ab))

    val sb = sb_new()
    sb_append(sb, "hello")
    print(len(sb))
    print(sb_len(sb))

    val mb = mapb_new<string, int>()
    mapb_set(mb, "a", 1)
    mapb_set(mb, "b", 2)
    print(len(mb))
    print(mapb_len(mb))

    val st = setb_new<int>()
    setb_add(st, 7)
    setb_add(st, 7)
    print(len(st))
    print(setb_len(st))

    // Live, like every other read on a builder: an append and a clear both show up.
    ab_append(ab, 4)
    print(len(ab))
    ab_clear(ab)
    print(len(ab))

    val empty = sb_new()
    print(len(empty))
}
