fn main() {
    var m = Map<int, string> {}
    for i in 0..50 {
        m = set(m, i, concat("v", str(i)))
    }
    var ok = true
    for i in 0..50 {
        val v = option_unwrap_or<string>(map_get(m, i), "MISSING")
        if v != concat("v", str(i)) {
            ok = false
        }
    }
    print(ok)
    print(contains(m, 49))
    print(contains(m, 50))

    var s = Set<int> {}
    for i in 0..50 {
        s = insert(s, i)
    }
    var all_present = true
    for i in 0..50 {
        if !contains(s, i) {
            all_present = false
        }
    }
    print(all_present)
    print(contains(s, 50))
}
