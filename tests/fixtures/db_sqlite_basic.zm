use datasource
use db.DbError
use db.Row
use db.SqlValue
use db.db_error_message
use db.row_get
use db.sql_as_bool
use db.sql_as_float
use db.sql_as_int
use db.sql_as_text

fn main() {
    val conn = unwrap(datasource.open("sqlite::memory:"))
    print(unwrap(datasource.execute(conn,
        "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT NOT NULL, score REAL, ok INTEGER, note TEXT); CREATE TABLE u (id INTEGER PRIMARY KEY, t_id INTEGER NOT NULL REFERENCES t(id))",
        [])))
    val ins = datasource.execute(conn, "INSERT INTO t (id, name, score, ok, note) VALUES ($1, $2, $3, $4, $5)",
        [SqlValue.Int(1), SqlValue.Text("Ada | 'x'"), SqlValue.Float(0.1), SqlValue.Bool(true), SqlValue.Null])
    print(is_ok(ins))
    print(is_ok(datasource.execute(conn, "INSERT INTO t (id, name) VALUES (?1, ?2)",
        [SqlValue.Int(2), SqlValue.Text("Bob")])))
    val rows = unwrap(datasource.query(conn, "SELECT * FROM t ORDER BY id", []))
    print(len(rows))
    val r = rows[0]
    print(unwrap(sql_as_text(unwrap(row_get(r, "name")))))
    print(unwrap(sql_as_float(unwrap(row_get(r, "score")))))
    print(unwrap(sql_as_bool(unwrap(row_get(r, "ok")))))
    print(SqlValue.is_Null(unwrap(row_get(r, "note"))))
    print(SqlValue.is_Null(unwrap(row_get(rows[1], "score"))))
    val dup = datasource.execute(conn, "INSERT INTO t (id, name) VALUES (1, 'dup')", [])
    print(db_error_message(unwrap_err(dup)))
    val fk = datasource.execute(conn, "INSERT INTO u (id, t_id) VALUES (1, 99)", [])
    print(db_error_message(unwrap_err(fk)))
    print(db_error_message(unwrap_err(datasource.query(conn, "SELEKT 1", []))))
    print(db_error_message(unwrap_err(datasource.query(conn, "SELECT * FROM t WHERE id = $1", []))))
    print(len(unwrap(datasource.query(conn, "SELECT * FROM t WHERE id = $1", [SqlValue.Int(99)]))))
    print(is_ok(datasource.begin(conn)))
    print(is_ok(datasource.execute(conn, "DELETE FROM t", [])))
    print(is_ok(datasource.rollback(conn)))
    print(len(unwrap(datasource.query(conn, "SELECT * FROM t", []))))
    val blob = unwrap(datasource.execute(conn, "CREATE TABLE b (x BLOB)", []))
    print(is_ok(datasource.execute(conn, "INSERT INTO b VALUES ($1)", [SqlValue.Bytes([1b, 255b])])))
    val br = unwrap(datasource.query(conn, "SELECT x FROM b", []))
    print(len(SqlValue.unwrap_Bytes(unwrap(row_get(br[0], "x")))))
    print(db_error_message(unwrap_err(datasource.open("oracle://x"))))
}
