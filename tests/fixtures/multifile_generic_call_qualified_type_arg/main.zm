use models

// Regression test: `mutable_array_new<models.Point>()` -- a generic call whose
// explicit type argument is a *qualified* (cross-module) type
// reference -- used to be misparsed, since next_looks_like_generic_call
// only recognized an uppercase identifier or a primitive keyword right
// after `<`, not `lowercase_qualifier.Type`. Found via
// #[derive(Json)]-generated code needing exactly this shape for an
// array field whose element type lives in another module.
fn main() {
    val ab = mutable_array_new<models.Point>()
    mutable_array_push<models.Point>(ab, models.Point { x: 1 })
    mutable_array_push<models.Point>(ab, models.Point { x: 2 })
    val arr = snapshot(ab)
    print(len(arr))
    print(arr[0].x)
    print(arr[1].x)

    // The genuinely ambiguous case this fix must not disturb: a bare
    // `lowercase_ident < lowercase_ident` real comparison, with no dot
    // at all -- still resolved as `<`, never mistaken for a generic
    // call's opening bracket.
    val a = 1
    val b = 2
    if a < b {
        print("less")
    }
}
