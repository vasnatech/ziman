fn innermost(x: int) -> int {
    return 1 / x
}

fn worker(out: Channel<int>) {
    send(out, innermost(0))
}

// No `on_error` handler: the trace goes straight to stderr and the thread ends without
// stopping the program. main's own receive then has nothing left that could ever send to it,
// which since A12 (2026-10-06) is detected and reported as a deadlock rather than waited out, so this
// exits 1 promptly instead of relying on the test harness's timeout.
fn main() {
    val out: Channel<int> = channel_new()
    spawn worker(out)
    print(receive(out))
}
