fn innermost(x: int) -> int {
    return 1 / x
}

fn worker(out: Channel<int>) {
    send(out, innermost(0))
}

// No `on_error` handler: the trace goes straight to stderr and the thread ends without
// stopping the program -- main's own receive never wakes up, same as
// stack_depth_spawned_thread's own no-handler case, so this relies on the test
// harness's timeout for a non-zero exit.
fn main() {
    val out: Channel<int> = channel_new()
    spawn worker(out)
    print(receive(out))
}
