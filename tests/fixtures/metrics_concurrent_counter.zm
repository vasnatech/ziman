use metrics

// Eight threads incrementing one counter 5,000 times each. The total is the test: the lock-free
// update is a compare-exchange on the double's bits, and a lost update -- a CAS loop that seeds
// itself with a stale or torn read -- shows up here as a number below 40000. The read that seeds
// the loop was a plain, non-atomic one until 2026-10-08, which TSan reported as a data race
// (docs/reviews/tasks.md A19); it was also undefined for a second reason, since the bits were
// reached by casting `double *` to `unsigned long long *`, so the value is now stored as bits.
fn worker(n: int, done: Channel<int>) {
    for i in 0..n { metrics.add("hits", 1.0) }
    send(done, 1)
}

fn main() {
    val declared = metrics.counter("hits", "total hits")
    print(declared)
    val done: Channel<int> = channel_new()
    for t in 0..8 { spawn worker(5000, done) }
    var finished = 0
    for k in 0..8 { finished = finished + receive(done) }
    print(finished)
    for line in split(metrics.render(), "\n") {
        if starts_with(line, "hits ") { print(line) }
    }
}
