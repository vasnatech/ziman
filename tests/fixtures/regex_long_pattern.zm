use regex

// A long pattern used to be a segfault rather than an error, and the two limits already in the
// engine could not see it: `gen` descended one C frame per atom of the concatenation *before*
// emitting a single instruction, so MAX_INSTRUCTIONS never got the chance to refuse and the
// post-compile memory budget was unreachable because the process was already dead. 20,000
// characters died on a 1 MB stack, and a spawned worker at ZIMAN_THREAD_STACK_MB=1 took the whole
// process with it (docs/reviews/tasks.md A25). `gen` and `free_node` now walk the chain in a loop,
// so recursion is bounded by the pattern's *nesting*, which the parser caps at 200.
//
// Run on a 1 MB stack deliberately: that is the size src/stack.c picks by itself for a spawned
// thread on a small machine, and it is where this crashed.
fn repeated(unit: string, times: int) -> string {
    var s = ""
    for i in 0..times { s = concat(s, unit) }
    return s
}

fn show(label: string, pattern: string, subject: string) {
    val r = regex.compile(pattern)
    if is_ok(r) {
        printf("{} -> compiled, matches: {}\n", label, str(regex.is_match(unwrap(r), subject)))
    } else {
        printf("{} -> refused: {}\n", label, unwrap_err(r))
    }
}

fn main() {
    // Long and legal: 3,000 atoms is well past the old crash threshold for this stack.
    show("3,000 atoms  ", repeated("a", 3000), repeated("a", 3000))
    // Long enough that the instruction limit refuses it -- an error, which is the point.
    show("20,000 atoms ", repeated("a", 20000), "a")
    // The same depth reached through a group and an alternation rather than a bare chain.
    show("group of 3,000", concat(concat("(", repeated("ab", 1500)), ")"), repeated("ab", 1500))
    show("alt of 3,000  ", concat(concat(repeated("a", 1500), "|"), repeated("b", 1500)), repeated("b", 1500))
}
