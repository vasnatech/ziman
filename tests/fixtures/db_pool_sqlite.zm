use clock
use datasource
use db.DbError
use db.SqlValue
use db.db_error_message
use db.row_get
use db.sql_as_int

// A pool over a SQLite *file* (several real connections to it), driven by
// more threads than connections.

fn count(conn: datasource.Connection, table: string) -> int {
    val rows = unwrap(datasource.query(conn, concat("SELECT count(*) AS n FROM ", table)))
    return unwrap(sql_as_int(unwrap(row_get(rows[0], "n"))))
}

// Per-statement borrows, then one exclusive borrow held long enough for
// the other workers to overlap with it.
fn worker(pool: datasource.Connection, id: int, handles: Channel<int>, done: Channel<int>) {
    var i = 0
    while i < 5 {
        unwrap(datasource.execute(pool, "INSERT INTO events (worker, n) VALUES ($1, $2)",
            SqlValue.Int(id), SqlValue.Int(i)))
        i = i + 1
    }
    val tx = unwrap(datasource.acquire(pool))
    defer datasource.release(pool, tx)
    send(handles, datasource.Connection.unwrap_Sqlite(tx).handle)
    clock.sleep_millis(20)
    send(done, 1)
}

// A read-modify-write transaction on a shared counter. BEGIN IMMEDIATE
// takes SQLite's write lock up front (a deferred BEGIN that reads then
// writes can deadlock two connections against each other).
fn incrementer(pool: datasource.Connection, done: Channel<int>) {
    var i = 0
    while i < 10 {
        val tx = unwrap(datasource.acquire(pool))
        defer datasource.release(pool, tx)
        unwrap(datasource.execute(tx, "BEGIN IMMEDIATE"))
        defer datasource.rollback(tx)
        val rows = unwrap(datasource.query(tx, "SELECT n FROM counter"))
        val n = unwrap(sql_as_int(unwrap(row_get(rows[0], "n"))))
        unwrap(datasource.execute(tx, "UPDATE counter SET n = $1", SqlValue.Int(n + 1)))
        unwrap(datasource.commit(tx))
        i = i + 1
    }
    send(done, 1)
}

// Bails out early with `?`; the deferred release must still give the
// connection back, or the next acquire on a pool of one would hang.
fn fails_early(pool: datasource.Connection) -> Result<int, DbError> {
    val tx = try datasource.acquire(pool)
    defer datasource.release(pool, tx)
    try datasource.execute(tx, "SELEKT 1")
    return 0
}

fn insert_from_thread(pool: datasource.Connection, done: Channel<int>) {
    unwrap(datasource.execute(pool, "INSERT INTO shared (v) VALUES (42)"))
    send(done, 1)
}

fn main() {
    val url = "sqlite:/tmp/ziman_pool_test.db"
    val setup = unwrap(datasource.open(url))
    unwrap(datasource.execute(setup, "DROP TABLE IF EXISTS events; DROP TABLE IF EXISTS counter"))
    unwrap(datasource.execute(setup,
        "CREATE TABLE events (worker INTEGER, n INTEGER); CREATE TABLE counter (n INTEGER); INSERT INTO counter VALUES (0)"))
    datasource.close(setup)

    val pool = unwrap(datasource.open_pool(url, 3))
    val handles: Channel<int> = channel_new()
    val done: Channel<int> = channel_new()
    var w = 0
    while w < 10 {
        spawn worker(pool, w, handles, done)
        w = w + 1
    }
    var i = 0
    var seen: [int] = []
    while i < 10 {
        receive(done)
        seen = push(seen, receive(handles))
        i = i + 1
    }
    print(count(pool, "events"))
    val distinct = len(set_from_array(seen))
    print(distinct <= 3)
    print(distinct >= 2)

    // no lost updates: 8 threads x 10 increments
    val finished: Channel<int> = channel_new()
    var t = 0
    while t < 8 {
        spawn incrementer(pool, finished)
        t = t + 1
    }
    var f = 0
    while f < 8 {
        receive(finished)
        f = f + 1
    }
    val rows = unwrap(datasource.query(pool, "SELECT n FROM counter"))
    print(unwrap(sql_as_int(unwrap(row_get(rows[0], "n")))))
    datasource.close(pool)

    // a pool of ONE: an early return still releases, so this doesn't hang
    val one = unwrap(datasource.open_pool(url, 1))
    print(is_ok(fails_early(one)))
    print(is_ok(fails_early(one)))
    print(count(one, "events"))
    datasource.close(one)

    // transactions on the pool itself are refused (each statement would
    // borrow a different connection); the pool stays usable
    val p2 = unwrap(datasource.open_pool(url, 2))
    print(db_error_message(unwrap_err(datasource.begin(p2))))
    print(count(p2, "counter"))
    datasource.close(p2)

    // on a plain connection, acquire returns it and release is a no-op
    val plain = unwrap(datasource.open(url))
    val same = unwrap(datasource.acquire(plain))
    datasource.release(plain, same)
    print(count(same, "counter"))
    datasource.close(plain)

    // a pool over :memory: is a single connection (every in-memory
    // connection is a private database), so all threads share one database
    val mem = unwrap(datasource.open_pool("sqlite::memory:", 5))
    unwrap(datasource.execute(mem, "CREATE TABLE shared (v INTEGER)"))
    val d2: Channel<int> = channel_new()
    spawn insert_from_thread(mem, d2)
    receive(d2)
    print(count(mem, "shared"))
    datasource.close(mem)

    print(is_ok(datasource.open_pool(url, 0)))
    print(db_error_message(unwrap_err(datasource.open_pool(url, 0))))
}
