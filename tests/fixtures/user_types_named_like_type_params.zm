struct T {
    x: int
}

struct K {
    n: string
}

enum V {
    Small
    Big
}

fn main() {
    val items = ab_new<T>()
    ab_append<T>(items, T { x: 1 })
    ab_append<T>(items, T { x: 2 })
    val all = ab_to_array<T>(items)
    print(len(all))
    val m = mapb_new<string, K>()
    mapb_set<string, K>(m, "a", K { n: "k" })
    print(len(mapb_to_map<string, K>(m)))
    val o = Option<V>.Some(V.Big)
    print(is_Some(o))
    val arr = push<T>(all, T { x: 3 })
    print(arr[2].x)
}
