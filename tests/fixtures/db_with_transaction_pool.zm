use db.DbError
use db.SqlValue
use sql

// with_transaction on a pool borrows one connection for the whole unit of work
// and returns it on every way out: after a commit and after a rollback the
// pool is whole again (a second transaction must not block).
fn add(tx: sql.Connection, n: int) -> Result<int, DbError> {
    sql.execute(tx, "INSERT INTO t (n) VALUES ($1)", [SqlValue.Int(n)])?
    return ok(n)
}

fn boom(tx: sql.Connection) -> Result<int, DbError> {
    sql.execute(tx, "INSERT INTO t (n) VALUES (99)", [])?
    return err(DbError.Sql("nope"))
}

fn count(conn: sql.Connection) -> int {
    return len(unwrap(sql.query(conn, "SELECT n FROM t", [])))
}

fn main() {
    val pool = unwrap(sql.open_pool("sqlite:/tmp/ziman_fixture_txpool.db", 3))
    unwrap(sql.execute(pool, "DROP TABLE IF EXISTS t", []))
    unwrap(sql.execute(pool, "CREATE TABLE t (n INTEGER)", []))
    print(unwrap(sql.with_transaction<int>(pool, fn(tx: sql.Connection) -> Result<int, DbError> { return add(tx, 1) })))
    print(is_ok(sql.with_transaction<int>(pool, boom)))
    print(unwrap(sql.with_transaction<int>(pool, fn(tx: sql.Connection) -> Result<int, DbError> { return add(tx, 2) })))
    print(unwrap(sql.with_transaction<int>(pool, fn(tx: sql.Connection) -> Result<int, DbError> { return add(tx, 3) })))
    print(count(pool))
    sql.close(pool)
}
