// derive(Json) for 'P'
pub fn p_to_json(v: P) -> Json {
    val field_x_json = Json.JInt(v.x)
    return Json.JObject(Map<string, Json> {
        "x": field_x_json
    })
}

// derive(Json) for 'P'
pub fn p_from_json(j: Json) -> Result<P, string> {
    if !Json.is_JObject(j) { return err("expected a JSON object for P") }
    val field_x_raw = json_require_field(j, "x")?
    val field_x = int_from_json(field_x_raw)?
    return P {
        x: field_x
    }
}

