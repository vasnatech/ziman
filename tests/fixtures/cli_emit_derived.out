// derive(Json) for 'P'
pub fn p_to_json(v: P) -> Json {
    val field_x_json = int_to_json(v.x)
    return Json.JObject(Map<string, Json> {
        "x": field_x_json
    })
}

// derive(Json) for 'P'
pub fn p_from_json(j: Json) -> Result<P, string> {
    if !Json.is_JObject(j) { return err("expected a JSON object for P") }
    val field_x_raw = try json_require_field(j, "x")
    val field_x = switch int_from_json(field_x_raw) {
        Ok(__derive_ok_0) { __derive_ok_0 }
        Err(__derive_err_1) { return err(concat("x: ", __derive_err_1)) }
    }
    return P {
        x: field_x
    }
}

pub fn p_from_json_all(j: Json) -> Result<P, [string]> {
    if !Json.is_JObject(j) { return err(["expected a JSON object for P"]) }
    val problems = mutable_array_new<string>()
    val get_x = fn() -> Result<int, string> {
    val field_x_raw = try json_require_field(j, "x")
    val field_x = try int_from_json(field_x_raw)
    return ok(field_x)
    }
    val got_x = get_x()
    if Err(problem_x) = got_x { mutable_array_push(problems, concat("x: ", problem_x)) }
    if len(problems) > 0 { return err(snapshot(problems)) }
    return ok(P {
        x: unwrap(got_x)
    })
}

