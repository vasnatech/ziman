// derive(Json) for 'P'
pub fn p_to_json(v: P) -> Json {
    val field_x_json = Json.JNumber(v.x as float)
    return Json.JObject([
        JField { key: "x", value: field_x_json }
    ])
}

// derive(Json) for 'P'
pub fn p_from_json(j: Json) -> Result<P, string> {
    if !Json.is_JObject(j) { return err("expected a JSON object for P") }
    val field_x_raw = json_require_field(j, "x")?
    if !Json.is_JNumber(field_x_raw) { return err("expected a number") }
    val field_x = Json.unwrap_JNumber(field_x_raw) as int
    return P {
        x: field_x
    }
}

