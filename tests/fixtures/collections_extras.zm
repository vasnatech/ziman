use collections

struct Item {
    name: string
    qty: int
}

fn qty(i: Item) -> int {
    return i.qty
}

fn name_of(i: Item) -> string {
    return i.name
}

fn expand(n: int) -> [int] {
    if n == 2 {
        return []
    }
    return [n, n * 10]
}

fn main() {
    val sorted = [1, 3, 3, 3, 5, 8]
    print(collections.lower_bound<int>(sorted, 3))
    print(collections.upper_bound<int>(sorted, 3))
    print(collections.lower_bound<int>(sorted, 0))
    print(collections.lower_bound<int>(sorted, 9))
    print(collections.upper_bound<int>(sorted, 4))
    print(collections.binary_search<int>(sorted, 3))
    print(collections.binary_search<int>(sorted, 4))
    print(collections.binary_search<string>(["a", "c", "e"], "c"))

    val items = [Item { name: "pen", qty: 3 }, Item { name: "cup", qty: 9 }, Item { name: "ink", qty: 3 }]
    print(collections.first<Item>(items))
    print(collections.last<int>([1, 2, 3]))
    print(collections.first<int>([]))
    print(collections.min_by<Item, int>(items, qty))
    print(collections.max_by<Item, int>(items, qty))
    print(collections.min_by<Item, string>(items, name_of))
    print(collections.max_by<int, int>([], fn(x) { x }))

    print(collections.count<int>([1, 2, 3, 4, 5], fn(n) { n % 2 == 1 }))
    print(collections.flat_map<int, int>([1, 2, 3], expand))
    print(collections.distinct<int>([3, 1, 3, 2, 1]))
    print(collections.distinct<string>(["b", "a", "b"]))
    print(collections.group_by<Item, int>(items, qty))
    print(len(collections.group_by<int, int>([], fn(x) { x })))

    // map / filter / flat_map / reverse keep packed element kinds and handle empty arrays
    print(collections.map<int, float>([1, 2, 3], fn(x) { x as float / 2.0 }))
    print(collections.map<int, bool>([1, 2, 3], fn(x) { x > 1 }))
    print(collections.map<int, string>([1, 2], fn(x) { concat("n", str(x)) }))
    print(collections.map<string, int>(["a", "bcd"], fn(s) { len(s) }))
    print(collections.filter<float>([0.5, 1.5, 2.5], fn(x) { x > 1.0 }))
    print(collections.filter<string>(["a", "bb", "c"], fn(s) { len(s) == 1 }))
    print(collections.filter<int>([1, 2, 3], fn(x) { x > 9 }))
    print(collections.reverse<string>(["a", "b", "c"]))
    print(collections.reverse<byte>([1b, 2b, 3b]))
    print(collections.reverse<int>([]))
    print(collections.map<int, int>([], fn(x) { x }))
    print(collections.flat_map<int, string>([1, 2], fn(x) { ["a", "b"] }))
    print(collections.flat_map<int, int>([], expand))

    // the native scalar sort and the generic merge sort agree, ties included
    print(collections.sort<int>([5, -2, 9, 5, 0]))
    print(collections.sort_desc<int>([5, -2, 9, 5, 0]))
    print(collections.sort<float>([2.5, -1.0, 0.0, 9.75]))
    print(collections.sort<string>(["pear", "fig", "apple", "fig", ""]))
    print(collections.sort<byte>([200b, 3b, 90b]))
    print(collections.sort_indices_desc<int>([5, 9, 5, 1]))
    print(collections.sort_indices<string>(["b", "a", "b", "a"]))
    print(collections.sort_by_keys<string, int>(["a", "b", "c", "d"], [2, 1, 2, 1]))
    print(collections.sort_by_keys_desc<string, int>(["a", "b", "c", "d"], [2, 1, 2, 1]))
    var big: [int] = []
    for i in 0..300 {
        big = push(big, (i * 7919) % 101)
    }
    val fast = collections.sort<int>(big)
    val generic = collections.sort_with<int>(big, fn(a, b) { compare(a, b) })
    print(fast == generic)
    print(collections.is_sorted<int>(fast))
    print(collections.sort_desc<int>(big) == collections.reverse<int>(fast))
    print(collections.sort<int>([]))
    print(collections.sort<int>([7]))
}
