pub struct User {
    id: int
    name: string
}

pub fn greet(u: User) -> string {
    return format("hello, {} (id={})", u.name, u.id)
}

// No `pub` -- only callable from within this module.
fn is_valid_name(name: string) -> bool {
    return name != ""
}

pub fn rename(u: User, new_name: string) -> User {
    if !is_valid_name(new_name) {
        return u
    }
    return with u { name: new_name }
}
