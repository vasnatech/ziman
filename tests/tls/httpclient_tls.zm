use httpclient
use http.HttpMethod
use http

// `openssl s_server -www` on 127.0.0.1:55443 answers GET with an HTTP/1.0 status page and closes.
fn main() {
    val ok = httpclient.request(method: HttpMethod.Get, url: "https://127.0.0.1:55443/", ca_file: "tests/tls/.certs/a.pem")
    if is_ok(ok) {
        print(unwrap(ok).status)
        print(contains(unwrap(ok).body, "s_server"))
    } else {
        print(httpclient.error_message(unwrap_err(ok)))
    }

    val untrusted = httpclient.get("https://127.0.0.1:55443/")
    print(is_ok(untrusted))
    print(contains(httpclient.error_message(unwrap_err(untrusted)), "TLS error"))

    val mismatch = httpclient.request(method: HttpMethod.Get, url: "https://127.0.0.1:55444/", ca_file: "tests/tls/.certs/b.pem")
    print(is_ok(mismatch))
}
