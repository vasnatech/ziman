use net
use net.NetError
use net.TlsVerify
use server

// A TLS *listener* (net.listen_tls) served by this same program and reached with the TLS client.
// Certificates come from tests/run_tls_tests.sh.

fn ca() -> Option<string> {
    return Option<string>.Some("tests/tls/.certs/a.pem")
}

// Accepts three connections: the first two are echoed, the third answers one HTTP request.
fn serve(l: net.Listener, done: Channel<int>) {
    var handled = 0
    while handled < 3 {
        val c = net.accept(l)
        if !is_ok(c) {
            // a client that did not speak TLS: the handshake failed, keep accepting
            send(done, 100)
        } else {
            val s = unwrap(c)
            if handled < 2 {
                val got = unwrap(net.read(s, 100))
                unwrap(net.write(s, got))
            } else {
                val ex = unwrap(server.read_request(server.open_session(s)))
                unwrap(server.write_response(
                    s,
                    ex.request,
                    server.text_response(200, concat("hello ", ex.request.path))
                ))
            }
            net.close(s)
            handled = handled + 1
        }
    }
    send(done, 1)
}

fn main() {
    val l = unwrap(net.listen_tls("127.0.0.1", 0, "tests/tls/.certs/a.pem", "tests/tls/.certs/a.key"))
    val port = net.listener_port(l)
    val done: Channel<int> = channel_new()
    spawn serve(l, done)

    // TLS with full verification: the certificate names 127.0.0.1
    val s = unwrap(net.connect_tls_with("127.0.0.1", port, TlsVerify.Full, ca()))
    unwrap(net.write(s, [104b, 105b]))
    print(unwrap(net.read(s, 10)))
    net.close(s)

    // a client that does not speak TLS makes the handshake fail, and the listener carries on
    val plain = unwrap(net.connect("127.0.0.1", port))
    unwrap(net.write_text(plain, "GET / HTTP/1.0\r\n\r\n"))
    net.close(plain)
    print(receive(done))

    val s2 = unwrap(net.connect_tls_with("127.0.0.1", port, TlsVerify.Full, ca()))
    unwrap(net.write(s2, [111b, 107b]))
    print(unwrap(net.read(s2, 10)))
    net.close(s2)

    // HTTP over the TLS listener
    val s3 = unwrap(net.connect_tls_with("127.0.0.1", port, TlsVerify.Full, ca()))
    unwrap(net.write_text(s3, "GET /secure HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
    var text = ""
    var reading = true
    while reading {
        val r = net.read_text(s3, 4096)
        if is_ok(r) {
            text = concat(text, unwrap(r))
        } else {
            reading = false
        }
    }
    print(starts_with(text, "HTTP/1.1 200 OK"))
    print(contains(text, "hello /secure"))
    net.close(s3)
    print(receive(done))

    // an unusable certificate or key is an Err from listen_tls
    print(is_ok(net.listen_tls("127.0.0.1", 0, "tests/tls/.certs/nope.pem", "tests/tls/.certs/a.key")))
    print(is_ok(net.listen_tls("127.0.0.1", 0, "tests/tls/.certs/a.pem", "tests/tls/.certs/b.key")))
    net.close_listener(l)
}
