use fs
use db
use sql.SqlValue
use sql.DbError

fn add(tx: db.Connection, n: int) -> Result<int, DbError> {
    db.execute(tx, "INSERT INTO pg_tx (n) VALUES ($1)", [SqlValue.Int(n)])?
    return ok(n)
}

fn boom(tx: db.Connection) -> Result<int, DbError> {
    db.execute(tx, "INSERT INTO pg_tx (n) VALUES (99)", [])?
    return err(DbError.Sql("nope"))
}

fn duplicate(tx: db.Connection, n: int) -> Result<int, DbError> {
    db.execute(tx, "INSERT INTO pg_tx (n) VALUES ($1)", [SqlValue.Int(n)])?
    db.execute(tx, "INSERT INTO pg_tx (n) VALUES ($1)", [SqlValue.Int(n)])?
    return ok(n)
}

fn count(conn: db.Connection) -> int {
    return len(unwrap(db.query(conn, "SELECT n FROM pg_tx", [])))
}

fn main() {
    val url = trim(unwrap(fs.read_text("tests/pg/.url")))
    val pool = unwrap(db.open_pool(url, 3))
    unwrap(db.execute(pool, "DROP TABLE IF EXISTS pg_tx", []))
    unwrap(db.execute(pool, "CREATE TABLE pg_tx (n INTEGER PRIMARY KEY)", []))
    print(unwrap(db.with_transaction_ctx<int, int>(pool, 1, add)))
    print(is_ok(db.with_transaction<int>(pool, boom)))
    print(count(pool))
    // the second insert violates the primary key: the first is rolled back too
    val dup = db.with_transaction_ctx<int, int>(pool, 7, duplicate)
    print(is_ok(dup))
    print(DbError.is_Constraint(unwrap_err(dup)))
    print(count(pool))
    // every borrowed connection came back: three more transactions do not block
    print(unwrap(db.with_transaction_ctx<int, int>(pool, 2, add)))
    print(unwrap(db.with_transaction_ctx<int, int>(pool, 3, add)))
    print(unwrap(db.with_transaction_ctx<int, int>(pool, 4, add)))
    print(count(pool))
    unwrap(db.execute(pool, "DROP TABLE pg_tx", []))
    db.close(pool)
}
