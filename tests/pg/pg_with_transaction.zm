use datasource
use db.DbError
use db.SqlValue
use fs

fn add(tx: datasource.Connection, n: int) -> Result<int, DbError> {
    datasource.execute(tx, "INSERT INTO pg_tx (n) VALUES ($1)", [SqlValue.Int(n)])?
    return ok(n)
}

fn boom(tx: datasource.Connection) -> Result<int, DbError> {
    datasource.execute(tx, "INSERT INTO pg_tx (n) VALUES (99)", [])?
    return err(DbError.Sql("nope"))
}

fn duplicate(tx: datasource.Connection, n: int) -> Result<int, DbError> {
    datasource.execute(tx, "INSERT INTO pg_tx (n) VALUES ($1)", [SqlValue.Int(n)])?
    datasource.execute(tx, "INSERT INTO pg_tx (n) VALUES ($1)", [SqlValue.Int(n)])?
    return ok(n)
}

fn count(conn: datasource.Connection) -> int {
    return len(unwrap(datasource.query(conn, "SELECT n FROM pg_tx", [])))
}

fn main() {
    val url = trim(unwrap(fs.read_text("tests/pg/.url")))
    val pool = unwrap(datasource.open_pool(url, 3))
    unwrap(datasource.execute(pool, "DROP TABLE IF EXISTS pg_tx", []))
    unwrap(datasource.execute(pool, "CREATE TABLE pg_tx (n INTEGER PRIMARY KEY)", []))
    print(unwrap(datasource.with_transaction<int>(pool,
        fn(tx: datasource.Connection) -> Result<int, DbError> { return add(tx, 1) })))
    print(is_ok(datasource.with_transaction<int>(pool, boom)))
    print(count(pool))
    // the second insert violates the primary key: the first is rolled back too
    val dup = datasource.with_transaction<int>(pool,
        fn(tx: datasource.Connection) -> Result<int, DbError> { return duplicate(tx, 7) })
    print(is_ok(dup))
    print(DbError.is_Constraint(unwrap_err(dup)))
    print(count(pool))
    // every borrowed connection came back: three more transactions do not block
    print(unwrap(datasource.with_transaction<int>(pool,
        fn(tx: datasource.Connection) -> Result<int, DbError> { return add(tx, 2) })))
    print(unwrap(datasource.with_transaction<int>(pool,
        fn(tx: datasource.Connection) -> Result<int, DbError> { return add(tx, 3) })))
    print(unwrap(datasource.with_transaction<int>(pool,
        fn(tx: datasource.Connection) -> Result<int, DbError> { return add(tx, 4) })))
    print(count(pool))
    unwrap(datasource.execute(pool, "DROP TABLE pg_tx", []))
    datasource.close(pool)
}
