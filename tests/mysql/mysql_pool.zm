use fs
use db
use sql.SqlValue
use sql.row_get
use sql.sql_as_int
use sql.db_error_message

fn writer(pool: db.Connection, base: int, done: Channel<int>) {
    var ok = 0
    for i in 0..25 {
        if is_ok(db.execute(pool, "INSERT INTO my_p (id, who) VALUES ($1, $2)", [SqlValue.Int(base + i), SqlValue.Int(base)])) {
            ok = ok + 1
        }
    }
    send(done, ok)
}

fn main() {
    val hp = trim(unwrap(fs.read_text("tests/mysql/.hostport")))
    val pool = unwrap(db.open_pool(format("mysql://nat_user:natpw@{}/zimandb", hp), 3))
    unwrap(db.execute(pool, "DROP TABLE IF EXISTS my_p", []))
    unwrap(db.execute(pool, "CREATE TABLE my_p (id INT PRIMARY KEY, who INT NOT NULL) ENGINE=InnoDB", []))

    // eight threads borrow from a pool of three
    val done: Channel<int> = channel_new()
    for t in 0..8 {
        spawn writer(pool, t * 1000, done)
    }
    var total = 0
    for t in 0..8 {
        total = total + receive(done)
    }
    print(total)
    print(unwrap(sql_as_int(unwrap(row_get(unwrap(db.query(pool, "SELECT COUNT(*) AS n FROM my_p", []))[0], "n")))))

    // a transaction on one borrowed connection commits or rolls back as a unit
    val tx = unwrap(db.acquire(pool))
    unwrap(db.begin(tx))
    unwrap(db.execute(tx, "INSERT INTO my_p (id, who) VALUES (900000, 1)", []))
    unwrap(db.rollback(tx))
    db.release(pool, tx)
    print(len(unwrap(db.query(pool, "SELECT * FROM my_p WHERE id = 900000", []))))
    val tx2 = unwrap(db.acquire(pool))
    unwrap(db.begin(tx2))
    unwrap(db.execute(tx2, "INSERT INTO my_p (id, who) VALUES (900000, 1)", []))
    unwrap(db.commit(tx2))
    db.release(pool, tx2)
    print(len(unwrap(db.query(pool, "SELECT * FROM my_p WHERE id = 900000", []))))

    // a transaction needs an exclusive connection
    print(db_error_message(unwrap_err(db.begin(pool))))

    unwrap(db.execute(pool, "DROP TABLE my_p", []))
    db.close(pool)
}
