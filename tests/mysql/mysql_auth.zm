use io
use db
use sql.row_get
use sql.sql_as_text
use sql.db_error_message

// One server, three logins: nat_user (mysql_native_password), sha2_user
// (caching_sha2_password) and root (also caching_sha2). caching_sha2's
// first login of a user needs the full exchange, which the driver only does
// over TLS; once the server has cached the login, a plain connection works
// through the fast path.
fn whoami(url: string) {
    val conn = db.open(url)
    if !is_ok(conn) {
        val message = db_error_message(unwrap_err(conn))
        if contains(message, "Access denied") {
            print("database connection error: access denied")
        } else {
            print(message)
        }
    } else {
        val rows = unwrap(db.query(unwrap(conn), "SELECT SUBSTRING_INDEX(CURRENT_USER(), '@', 1) AS u", []))
        print(unwrap(sql_as_text(unwrap(row_get(rows[0], "u")))))
        db.close(unwrap(conn))
    }
}

fn main() {
    val hp = trim(unwrap(io.read_file("tests/mysql/.hostport")))
    // mysql_native_password, no TLS
    whoami(format("mysql://nat_user:natpw@{}/zimandb", hp))
    // wrong password
    whoami(format("mysql://nat_user:wrongpw@{}/zimandb", hp))
    // caching_sha2, first login, no TLS: refused with an explanation
    whoami(format("mysql://sha2_user:sha2pw@{}/zimandb", hp))
    // the same over TLS: full authentication, the server caches the login
    whoami(format("mysql://sha2_user:sha2pw@{}/zimandb?sslmode=require", hp))
    // now cached: a plain connection takes the fast path
    whoami(format("mysql://sha2_user:sha2pw@{}/zimandb", hp))
    // wrong password over TLS
    whoami(format("mysql://sha2_user:wrongpw@{}/zimandb?sslmode=require", hp))
    // sslmode=prefer uses TLS when the server has it
    whoami(format("mysql://root:secret@{}/zimandb?sslmode=prefer", hp))
    // verifying the (self-signed) certificate fails without a trusted root
    val strict = db.open(format("mysql://root:secret@{}/zimandb?sslmode=verify-full", hp))
    print(is_ok(strict))
}
