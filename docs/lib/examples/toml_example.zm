use json
use json.Json
use toml

// A TOML document becomes a Json tree, so the json helpers read it. Parsing, reading a required
// key and writing back all answer a plain string on failure, so one `try` chain covers the lot.
fn demo() -> Result<unit, string> {
    val config = try toml.parse("""
        title = "demo"

        [server]
        port = 8080
        hosts = ["a.example", "b.example"]

        [[job]]
        name = "backup"

        [[job]]
        name = "report"
        """)

    val server = try json.require(config, "server")
    print(try json.require_int(server, "port"))
    print(json.format(try json.require(config, "job")))

    // An error says where the text went wrong.
    print(is_ok(toml.parse("port = ")))
    print(trim(try toml.format(server)))
    return unit
}

fn main() {
    if Err(e) = demo() {
        printf("toml example failed: {}\n", e)
    }
}
