use db
use db.DbError
use db.Row
use db.SqlValue
use db.db_error_message
use db.row_get
use db.sql_as_bool
use db.sql_as_int
use db.sql_as_text

// What the database modules share: a value, a row, the error type, and the URL parser. Reading a
// column and reading its type are both fallible, so both answer Result and `try` chains them.
fn demo() -> Result<unit, DbError> {
    val row = Row {
        columns: ["id", "name", "active"],
        values: [SqlValue.Int(1), SqlValue.Text("Ada"), SqlValue.Int(1)]
    }

    print(try sql_as_int(try row_get(row, "id")))
    print(try sql_as_text(try row_get(row, "name")))
    // SQLite has no boolean type, so a 0 or 1 integer reads as one.
    print(try sql_as_bool(try row_get(row, "active")))

    // Asking for the wrong type, or a column that is not there, is a DbError. These two are meant
    // to fail, so they are consumed where they happen instead of propagating.
    if Err(e) = sql_as_int(SqlValue.Text("x")) {
        print(db_error_message(e))
    }
    if Err(e) = row_get(row, "email") {
        print(db_error_message(e))
    }

    // A database URL, with its credentials decoded (`%40` is `@`); a missing port takes the default.
    val u = try db.parse_url("postgres://ada:p%40ss@db.example:6543/health?sslmode=require", ["postgres://"], 5432)
    print(u.user)
    print(u.password)
    print(u.host)
    print(u.port)
    print(u.database)
    print(db.url_param(u, "sslmode"))
    val local = try db.parse_url("postgres://ada@localhost/health", ["postgres://"], 5432)
    print(local.port)
    print(is_ok(db.parse_url("mysql://x@h/d", ["postgres://"], 5432)))
    return unit
}

fn main() {
    if Err(e) = demo() {
        printf("db example failed: {}\n", db_error_message(e))
    }
}
