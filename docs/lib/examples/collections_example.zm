use collections

// Sorting, searching, and the array helpers. Type arguments are written out at the call.
fn main() {
    val words = ["pear", "fig", "apple", "kiwi"]

    print(array_sort<string>(words))
    print(array_sort_desc<int>([3, 1, 2]))

    // Sort by a computed key without writing a comparator.
    val by_length = array_sort_by_keys<string, int>(
        words,
        array_map<string, int>(words, fn(w) { len(w) })
    )
    print(by_length)

    print(array_map<int, int>([1, 2, 3], fn(n) { n * n }))
    print(array_filter<int>([1, 2, 3, 4], fn(n) { n % 2 == 0 }))
    print(array_fold<int, int>([1, 2, 3, 4], 0, fn(sum, n) { sum + n }))

    // Search a sorted array in O(log n).
    val sorted = array_sort<int>([40, 10, 30, 20])
    print(array_binary_search<int>(sorted, 30))
    print(array_lower_bound<int>(sorted, 25))

    print(array_distinct<int>([3, 1, 3, 2, 1]))
    print(array_group_by<string, int>(words, fn(w) { len(w) }))

    // Counting, indexing, and a map's entries as an array.
    print(array_frequencies<string>(["a", "b", "a", "c", "a"]))
    print(array_index_by<string, int>(words, fn(w) { len(w) }))
    val stock = Map<string, int> { "apple": 4, "fig": 9 }
    print(map_entries<string, int>(stock)[1].key)
    print(map_map_values<string, int, string>(stock, fn(n) { format("{} units", n) }))
}
