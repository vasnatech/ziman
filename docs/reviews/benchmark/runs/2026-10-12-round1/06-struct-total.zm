struct Item {
    name: string,
    price: int,
}

fn main() {
    let items = [
        Item { name: "pen", price: 150 },
        Item { name: "notebook", price: 320 },
        Item { name: "eraser", price: 95 },
    ];

    let mut total: int = 0;

    for item in items {
        print("{}: {}", item.name, item.price);
        total = total + item.price;
    }

    print("total: {}", total);
}
