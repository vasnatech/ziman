fn is_unreserved(c: String) -> Bool {
    let safe = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~";
    let mut i = 0;
    while i < len(safe) {
        if safe[i] == c {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn hex_value(c: String) -> Int {
    let upper = "0123456789ABCDEF";
    let lower = "0123456789abcdef";
    let mut i = 0;
    while i < 16 {
        if upper[i] == c {
            return i;
        }
        if lower[i] == c {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

fn url_encode(s: String) -> String {
    let hex = "0123456789ABCDEF";
    let mut out = "";
    let mut i = 0;
    while i < len(s) {
        let c = s[i];
        if c == " " {
            out = out + "+";
        } else if is_unreserved(c) {
            out = out + c;
        } else {
            let code = ord(c);
            out = out + "%" + hex[code / 16] + hex[code % 16];
        }
        i = i + 1;
    }
    return out;
}

fn url_decode(s: String) -> String {
    let mut out = "";
    let mut i = 0;
    while i < len(s) {
        let c = s[i];
        if c == "+" {
            out = out + " ";
            i = i + 1;
        } else if c == "%" && i + 2 < len(s) {
            let hi = hex_value(s[i + 1]);
            let lo = hex_value(s[i + 2]);
            out = out + chr(hi * 16 + lo);
            i = i + 3;
        } else {
            out = out + c;
            i = i + 1;
        }
    }
    return out;
}

fn main() {
    let original = "name=Ada Lovelace&role=pioneer";
    let encoded = url_encode(original);
    println(encoded);
    let decoded = url_decode(encoded);
    println(decoded);
}
