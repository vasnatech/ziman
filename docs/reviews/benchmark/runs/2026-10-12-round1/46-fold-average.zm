fn main() {
    let values = [4, 8, 15, 16, 23, 42]

    let total = values.fold(0, |acc, x| acc + x)
    let mean = total as float / values.len() as float

    print(mean)

    let above = values.fold(0, |acc, x| {
        if (x as float) > mean {
            acc + 1
        } else {
            acc
        }
    })

    print(above)
}
