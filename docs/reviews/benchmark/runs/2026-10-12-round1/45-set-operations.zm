fn contains(xs: [Int], v: Int) -> Bool {
    for x in xs {
        if x == v {
            return true
        }
    }
    return false
}

fn select(xs: [Int], other: [Int], want: Bool) -> String {
    var out = ""
    var first = true
    for x in xs {
        if contains(other, x) == want {
            if first {
                out = out + str(x)
                first = false
            } else {
                out = out + ", " + str(x)
            }
        }
    }
    return out
}

fn main() {
    let a = [1, 2, 3, 4, 5]
    let b = [4, 5, 6, 7]

    print("both: " + select(a, b, true))
    print("only first: " + select(a, b, false))
    print("only second: " + select(b, a, false))
}
