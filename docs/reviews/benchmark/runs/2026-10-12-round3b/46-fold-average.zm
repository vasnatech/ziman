use collections
use number

fn main() {
    val values = [4, 8, 15, 16, 23, 42]

    val total = collections.fold(values, 0.0, fn(acc: float, x: int) -> float {
        acc + (x as float)
    })
    val mean = total / (len(values) as float)

    print(number.float_to_text(mean))

    val above = collections.count(values, fn(x: int) -> bool {
        (x as float) > mean
    })
    print(above)
}
