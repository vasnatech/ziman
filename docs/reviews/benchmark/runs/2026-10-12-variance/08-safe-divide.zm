// Divide two ints, returning no value when the divisor is zero.
fn safe_divide(a: int, b: int) -> Option<int> {
  if b == 0 {
    return None
  }
  return Some(a / b)
}

// Print the quotient, or `undefined` when there is none.
fn show(a: int, b: int) {
  val result = safe_divide(a, b)
  switch result {
    Some(value) {
      print(value)
    }
    None {
      print("undefined")
    }
  }
}

fn main() {
  show(10, 2)
  show(7, 3)
  show(5, 0)
}
