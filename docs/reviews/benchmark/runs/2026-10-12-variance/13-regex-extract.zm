fn main() {
    val s = "order 12 has 3 items costing 450"
    val a = chars(s)
    val n = len(a)
    var i = 0
    var cur = ""
    while i < n {
        val c = a[i]
        if c >= "0" && c <= "9" {
            cur = concat(cur, c)
        } else {
            if len(cur) > 0 {
                print(cur)
                cur = ""
            }
        }
        i = i + 1
    }
    if len(cur) > 0 {
        print(cur)
    }
}
