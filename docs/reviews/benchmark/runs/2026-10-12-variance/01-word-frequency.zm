fn count_of(m: Map<string, int>, w: string) -> int {
    switch map_get(m, w) {
        Some(v) { return v }
        None { return 0 }
    }
}

fn ranks_before(m: Map<string, int>, a: string, b: string) -> bool {
    val ca = count_of(m, a)
    val cb = count_of(m, b)
    if ca > cb {
        return true
    }
    if ca < cb {
        return false
    }
    return a < b
}

fn main() {
    val text = "the quick brown fox jumps over the lazy dog the fox"
    val words = split(text, " ")

    var counts = Map<string, int> { }
    for w in words {
        counts = set(counts, w, count_of(counts, w) + 1)
    }

    var seen = Set<string> { }
    var distinct = words
    var n = 0
    for w in words {
        if !contains(seen, w) {
            seen = insert(seen, w)
            distinct = set(distinct, n, w)
            n = n + 1
        }
    }

    var i = 0
    while i < n {
        var best = i
        var j = i + 1
        while j < n {
            if ranks_before(counts, distinct[j], distinct[best]) {
                best = j
            }
            j = j + 1
        }
        val tmp = distinct[i]
        distinct = set(distinct, i, distinct[best])
        distinct = set(distinct, best, tmp)
        i = i + 1
    }

    var k = 0
    while k < n {
        val w = distinct[k]
        print(concat(concat(w, ": "), str(count_of(counts, w))))
        k = k + 1
    }
}
