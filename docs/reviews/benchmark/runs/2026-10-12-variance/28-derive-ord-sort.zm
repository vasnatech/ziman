use collections

// `points` comes first, so the derived ordering sorts by score and
// only falls back to the player's name to break ties.
#[derive(Ord)]
struct Score {
    points: int
    player: string
}

fn main() {
    val scores = [
        Score { points: 40, player: "Ada" },
        Score { points: 55, player: "Alan" },
        Score { points: 55, player: "Grace" },
        Score { points: 10, player: "Bob" },
        Score { points: 70, player: "Eve" }
    ]

    val ranked = collections.sort<Score>(scores)

    for score in ranked {
        print(score.player)
    }
}
