use json

#[derive(Json)]
struct User {
    id: int
    name: string
    active: bool
}

fn main() {
    val u = User { id: 7, name: "Ada", active: true }

    val text = json.json_to_string(user_to_json(u))
    print(text)

    switch json.parse_json(text) {
        Ok(j) {
            switch user_from_json(j) {
                Ok(back) {
                    print(back.name)
                }
                Err(e) {
                    print(e)
                }
            }
        }
        Err(e) {
            print(e)
        }
    }
}
