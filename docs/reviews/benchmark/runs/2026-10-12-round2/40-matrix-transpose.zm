fn main() {
    val m = [[1, 2, 3], [4, 5, 6]]
    val rows = len(m)
    val cols = len(m[0])

    var t: [[int]] = []
    for j in 0..cols {
        var row: [int] = []
        for i in 0..rows {
            push(row, m[i][j])
        }
        push(t, row)
    }

    for j in 0..len(t) {
        var line = ""
        for i in 0..len(t[j]) {
            if i > 0 {
                line = concat(line, " ")
            }
            line = concat(line, str(t[j][i]))
        }
        print(line)
    }
}
