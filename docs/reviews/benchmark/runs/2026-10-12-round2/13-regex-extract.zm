// Find every number in a string and print them one per line,
// in the order they appear.

fn is_digit(c: string) -> bool {
    return c >= "0" && c <= "9"
}

fn main() {
    val text = "order 12 has 3 items costing 450"
    var current = ""
    for c in chars(text) {
        if is_digit(c) {
            current = concat(current, c)
        } else if len(current) != 0 {
            print(current)
            current = ""
        }
    }
    if len(current) != 0 {
        print(current)
    }
}
