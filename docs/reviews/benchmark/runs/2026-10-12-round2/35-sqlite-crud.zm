use sqlite
use db

fn render(v: db.SqlValue) -> string {
    switch v {
        Null { return "NULL" }
        Int(i) { return str(i) }
        Float(f) { return str(f) }
        Text(t) { return t }
        Bool(b) { return str(b) }
        Bytes(b) { return "<bytes>" }
    }
}

fn run() -> Result<int, db.DbError> {
    val conn = try sqlite.open("/tmp/ziman_bench_35.db")

    try sqlite.execute(conn, "DROP TABLE IF EXISTS task")
    try sqlite.execute(conn, "CREATE TABLE task (id INTEGER, title TEXT)")

    try sqlite.execute(conn, "INSERT INTO task (id, title) VALUES (1, 'write')")
    try sqlite.execute(conn, "INSERT INTO task (id, title) VALUES (2, 'review')")
    try sqlite.execute(conn, "INSERT INTO task (id, title) VALUES (3, 'ship')")

    val rows = try sqlite.query(conn, "SELECT id, title FROM task ORDER BY id")
    for row in rows {
        print(format("{}: {}", render(row.values[0]), render(row.values[1])))
    }

    sqlite.close(conn)
    return ok(0)
}

fn main() {
    switch run() {
        Ok(n) { }
        Err(e) { print("database error") }
    }
}
