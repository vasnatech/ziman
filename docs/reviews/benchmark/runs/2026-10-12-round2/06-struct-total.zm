struct Item {
    name: string
    price: int
}

fn main() {
    val items = [
        Item { name: "pen", price: 150 },
        Item { name: "notebook", price: 320 },
        Item { name: "eraser", price: 95 }
    ]

    var total = 0
    for item in items {
        print(format("{}: {}", item.name, item.price))
        total = total + item.price
    }

    print(format("total: {}", total))
}
