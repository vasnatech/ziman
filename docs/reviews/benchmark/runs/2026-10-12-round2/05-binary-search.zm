fn binary_search(xs: [int], target: int) -> int {
    var lo = 0
    var hi = len(xs) - 1
    while lo <= hi {
        val mid = lo + (hi - lo) / 2
        if xs[mid] == target {
            return mid
        } else if xs[mid] < target {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return -1
}

fn main() {
    val xs = [2, 3, 5, 7, 11, 13, 17, 19, 23]
    print(binary_search(xs, 2))
    print(binary_search(xs, 11))
    print(binary_search(xs, 23))
    print(binary_search(xs, 4))
}
