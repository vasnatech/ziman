struct Config {
    host: string
    port: int
    debug: bool
}

fn describe(c: Config) -> string {
    return format("{}:{} {}", c.host, c.port, c.debug)
}

fn main() {
    val default_config = Config { host: "localhost", port: 80, debug: false }
    val secure_config = with default_config { port: 8443, debug: true }

    print(describe(default_config))
    print(describe(secure_config))
}
