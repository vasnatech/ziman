struct Registration {
    name: string
    age: int
    email: string
}

fn problems_of(r: Registration) -> [string] {
    val found = mutable_array_new<string>()
    if len(r.name) == 0 {
        push(found, "name must not be empty")
    }
    if r.age < 18 || r.age > 120 {
        push(found, "age must be between 18 and 120")
    }
    if !contains(r.email, "@") {
        push(found, "email must contain @")
    }
    return snapshot(found)
}

fn main() {
    val found = problems_of(Registration { name: "", age: 15, email: "nope" })
    for p in found {
        print(p)
    }
    printf("problems: {}\n", str(len(found)))
}
