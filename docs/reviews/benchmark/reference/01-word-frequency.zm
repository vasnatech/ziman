fn main() {
    val text = "the quick brown fox jumps over the lazy dog the fox"
    val counts = mutable_map_new<string, int>()
    for w in split(text, " ") {
        set(counts, w, get_or<string, int>(counts, w, 0) + 1)
    }
    val m = snapshot(counts)
    val words = sort_with<string>(keys(m), fn(a: string, b: string) -> int {
        val ca = switch get(m, a) { Some(n) { n } None { 0 } }
        val cb = switch get(m, b) { Some(n) { n } None { 0 } }
        return if ca != cb { compare(cb, ca) } else { compare(a, b) }
    })
    for w in words {
        printf("{}: {}\n", w, str(switch get(m, w) { Some(n) { n } None { 0 } }))
    }
}
