fn is_palindrome(text: string) -> bool {
    val cleaned = to_lower(replace(text, " ", ""))
    var i = 0
    var j = len(cleaned) - 1
    while i < j {
        if char_at(cleaned, i) != char_at(cleaned, j) {
            return false
        }
        i = i + 1
        j = j - 1
    }
    return true
}

fn main() {
    for text in ["racecar", "A man a plan a canal Panama", "ziman"] {
        printf("{}: {}\n", text, if is_palindrome(text) { "yes" } else { "no" })
    }
}
