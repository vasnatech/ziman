use collections

fn show(label: string, values: [int]) {
    val parts = mutable_array_new<string>()
    for v in collections.sort<int>(values) {
        mutable_array_push(parts, str(v))
    }
    printf("{}: {}\n", label, join(separator: ", ", pieces: snapshot(parts)))
}

fn main() {
    val first = [1, 2, 3, 4, 5]
    val second = [4, 5, 6, 7]
    val in_second = Set<int> { 4, 5, 6, 7 }
    val in_first = Set<int> { 1, 2, 3, 4, 5 }
    val both = mutable_array_new<int>()
    val only_first = mutable_array_new<int>()
    val only_second = mutable_array_new<int>()
    for v in first {
        if contains(in_second, v) { mutable_array_push(both, v) } else { mutable_array_push(only_first, v) }
    }
    for v in second {
        if !contains(in_first, v) { mutable_array_push(only_second, v) }
    }
    show("both", snapshot(both))
    show("only first", snapshot(only_first))
    show("only second", snapshot(only_second))
}
