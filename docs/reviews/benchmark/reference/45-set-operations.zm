use collections

fn show(label: string, values: [int]) {
    val parts = ab_new<string>()
    for v in collections.sort<int>(values) {
        ab_append(parts, str(v))
    }
    printf("{}: {}\n", label, join(separator: ", ", pieces: ab_to_array(parts)))
}

fn main() {
    val first = [1, 2, 3, 4, 5]
    val second = [4, 5, 6, 7]
    val in_second = Set<int> { 4, 5, 6, 7 }
    val in_first = Set<int> { 1, 2, 3, 4, 5 }
    val both = ab_new<int>()
    val only_first = ab_new<int>()
    val only_second = ab_new<int>()
    for v in first {
        if contains(in_second, v) { ab_append(both, v) } else { ab_append(only_first, v) }
    }
    for v in second {
        if !contains(in_first, v) { ab_append(only_second, v) }
    }
    show("both", ab_to_array(both))
    show("only first", ab_to_array(only_first))
    show("only second", ab_to_array(only_second))
}
