use json

fn main() {
    val doc = unwrap(json.parse("{\"name\": \"Ada\", \"age\": 36, \"address\": {\"city\": \"London\"}}"))
    print(unwrap(json.require_string(doc, "name")))
    print(unwrap(json.require_int(doc, "age")))
    val address = unwrap(json.require(doc, "address"))
    print(unwrap(json.require_string(address, "city")))
}
