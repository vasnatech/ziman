fn main() {
    val m = [[1, 2, 3], [4, 5, 6]]
    val rows = len(m)
    val cols = len(m[0])
    var c = 0
    while c < cols {
        val out = ab_new<string>()
        var r = 0
        while r < rows {
            ab_append(out, str(m[r][c]))
            r = r + 1
        }
        print(join(separator: " ", pieces: ab_to_array(out)))
        c = c + 1
    }
}
