fn main() {
    val m = [[1, 2, 3], [4, 5, 6]]
    val rows = len(m)
    val cols = len(m[0])
    var c = 0
    while c < cols {
        val out = mutable_array_new<string>()
        var r = 0
        while r < rows {
            mutable_array_push(out, str(m[r][c]))
            r = r + 1
        }
        print(join(separator: " ", pieces: snapshot(out)))
        c = c + 1
    }
}
