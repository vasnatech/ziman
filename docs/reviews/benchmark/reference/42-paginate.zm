fn main() {
    val items = mutable_array_new<int>()
    for i in 1..11 {
        push(items, i)
    }
    val all = snapshot(items)
    val size = 3
    var page = 1
    var start = 0
    while start < len(all) {
        val stop = if start + size < len(all) { start + size } else { len(all) }
        val names = mutable_array_new<string>()
        for v in slice<int>(all, start, stop) {
            push(names, str(v))
        }
        printf("page {}: {}\n", str(page), join(separator: ", ", pieces: snapshot(names)))
        page = page + 1
        start = start + size
    }
}
