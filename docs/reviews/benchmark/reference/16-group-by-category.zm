struct Product {
    name: string
    category: string
}

fn main() {
    val products = [
        Product { name: "apple", category: "fruit" },
        Product { name: "carrot", category: "veg" },
        Product { name: "banana", category: "fruit" },
        Product { name: "leek", category: "veg" },
        Product { name: "cherry", category: "fruit" }
    ]
    val groups = mutable_map_new<string, [string]>()
    for p in products {
        val so_far: [string] = switch get<string, [string]>(groups, p.category) {
            Some(xs) { xs }
            None { [] }
        }
        set(groups, p.category, push(so_far, p.name))
    }
    val m = snapshot(groups)
    for cat in sort<string>(items(keys(m))) {
        val names: [string] = switch get(m, cat) {
            Some(xs) { xs }
            None { [] }
        }
        printf("{}: {}\n", cat, join(separator: ", ", pieces: names))
    }
}
