fn label(text: string, width: Option<int>) -> string {
    val target = switch width {
        Some(w) { w }
        None { byte_len(text) }
    }
    val sb = mutable_string_new()
    append(sb, text)
    while byte_len(sb) < target {
        append(sb, ".")
    }
    return snapshot(sb)
}

fn main() {
    print(label(text: "ok", width: 6))
    print(label(text: "ok"))
}
