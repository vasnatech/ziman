fn label(text: string, width: Option<int>) -> string {
    val target = switch width {
        Some(w) { w }
        None { len(text) }
    }
    val sb = sb_new()
    sb_append(sb, text)
    while sb_len(sb) < target {
        sb_append(sb, ".")
    }
    return sb_to_string(sb)
}

fn main() {
    print(label(text: "ok", width: 6))
    print(label(text: "ok"))
}
