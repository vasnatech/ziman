fn encode(text: string) -> string {
    val sb = mutable_string_new()
    var i = 0
    while i < byte_len(text) {
        val ch = char_at(text, i)
        var run = 1
        while i + run < byte_len(text) && char_at(text, i + run) == ch {
            run = run + 1
        }
        append(sb, ch, str(run))
        i = i + run
    }
    return snapshot(sb)
}

fn decode(text: string) -> string {
    val sb = mutable_string_new()
    var i = 0
    while i < byte_len(text) {
        val ch = char_at(text, i)
        var j = i + 1
        val digits = mutable_string_new()
        while j < byte_len(text) && char_at(text, j) >= "0" && char_at(text, j) <= "9" {
            append(digits, char_at(text, j))
            j = j + 1
        }
        var k = 0
        val count = unwrap(parse_int(snapshot(digits)))
        while k < count {
            append(sb, ch)
            k = k + 1
        }
        i = j
    }
    return snapshot(sb)
}

fn main() {
    val encoded = encode("aaabccddddbbb")
    print(encoded)
    print(decode(encoded))
}
