use collections

fn square(n: int, out: Channel<int>) {
    send(out, n * n)
}

fn main() {
    val results: Channel<int> = channel_new()
    for n in [2, 3, 4] {
        spawn square(n, results)
    }
    val got = mutable_array_new<int>()
    var i = 0
    while i < 3 {
        mutable_array_push(got, receive(results))
        i = i + 1
    }
    for v in array_sort<int>(snapshot(got)) {
        print(v)
    }
}
