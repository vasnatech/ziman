struct Config {
    host: string
    port: int
    debug: bool
}

fn show(c: Config) {
    printf("{}:{} {}\n", c.host, str(c.port), str(c.debug))
}

fn main() {
    val base = Config { host: "localhost", port: 80, debug: false }
    val secure = with base {
        port: 8443,
        debug: true
    }
    show(base)
    show(secure)
}
