// collections.zm -- Box<T>, HashMap<K, V>, HashSet<T>, written in
// ordinary Ziman, no native/C code -- the concrete payoff of the
// generics work (see ../../docs/ROADMAP.md's "Generics" and
// "Collections module" entries). `Option<T>` used to live here too;
// moved to corelib/prelude.zm since it's needed everywhere HashMap/
// HashSet aren't, so it's now always available bare, no `use` needed --
// see docs/DESIGN.md's "Prelude" entry.
//
// HashMap/HashSet use real bucket-array storage (separate chaining) so
// get/add/contains are O(1) average case via hash(key) % bucket_count,
// not a linear Eq-only scan. The bucket count is fixed at creation --
// no resizing/rehashing yet, so this degrades toward O(n) if the entry
// count grows much past the fixed bucket count. Eq + Hash together
// restrict a HashMap/HashSet key to int/float/bool/string for now: Hash has no
// derived form for a struct or enum (see docs/SYNTAX.md "Generics").
//
// `Entry`/`buckets` are implementation details, not part of the
// intended public API -- use the functions below, not direct field
// access, even though Ziman has no per-field privacy to enforce that.

pub struct Box<T> {
    value: T
}

struct Entry<K, V> {
    key: K
    value: V
}

pub struct HashMap<K: Eq + Hash, V> {
    buckets: [[Entry<K, V>]]
}

pub fn hashmap_new<K: Eq + Hash, V>() -> HashMap<K, V> {
    val empty_bucket: [Entry<K, V>] = []
    var buckets: [[Entry<K, V>]] = []
    for i in 0..16 {
        buckets = push(buckets, empty_bucket)
    }
    return HashMap<K, V> { buckets: buckets }
}

pub fn hashmap_get<K: Eq + Hash, V>(m: HashMap<K, V>, key: K) -> Option<V> {
    val idx = hash(key) % len(m.buckets)
    val bucket = m.buckets[idx]
    for entry in bucket {
        if entry.key == key {
            return Option<V>.Some(entry.value)
        }
    }
    return Option<V>.None
}

pub fn hashmap_has<K: Eq + Hash, V>(m: HashMap<K, V>, key: K) -> bool {
    return Option.is_Some(hashmap_get<K, V>(m, key))
}

pub fn hashmap_set<K: Eq + Hash, V>(m: HashMap<K, V>, key: K, value: V) -> HashMap<K, V> {
    val idx = hash(key) % len(m.buckets)
    val old_bucket = m.buckets[idx]
    var new_bucket: [Entry<K, V>] = []
    var replaced = false
    for entry in old_bucket {
        if entry.key == key {
            new_bucket = push(new_bucket, Entry<K, V> { key: key, value: value })
            replaced = true
        } else {
            new_bucket = push(new_bucket, entry)
        }
    }
    if !replaced {
        new_bucket = push(new_bucket, Entry<K, V> { key: key, value: value })
    }
    val new_buckets = set(m.buckets, idx, new_bucket)
    return HashMap<K, V> { buckets: new_buckets }
}

pub fn hashmap_remove<K: Eq + Hash, V>(m: HashMap<K, V>, key: K) -> HashMap<K, V> {
    val idx = hash(key) % len(m.buckets)
    val old_bucket = m.buckets[idx]
    var new_bucket: [Entry<K, V>] = []
    for entry in old_bucket {
        if entry.key != key {
            new_bucket = push(new_bucket, entry)
        }
    }
    val new_buckets = set(m.buckets, idx, new_bucket)
    return HashMap<K, V> { buckets: new_buckets }
}

pub struct HashSet<T: Eq + Hash> {
    buckets: [[T]]
}

pub fn hashset_new<T: Eq + Hash>() -> HashSet<T> {
    val empty_bucket: [T] = []
    var buckets: [[T]] = []
    for i in 0..16 {
        buckets = push(buckets, empty_bucket)
    }
    return HashSet<T> { buckets: buckets }
}

pub fn hashset_contains<T: Eq + Hash>(s: HashSet<T>, item: T) -> bool {
    val idx = hash(item) % len(s.buckets)
    val bucket = s.buckets[idx]
    for x in bucket {
        if x == item {
            return true
        }
    }
    return false
}

pub fn hashset_add<T: Eq + Hash>(s: HashSet<T>, item: T) -> HashSet<T> {
    if hashset_contains<T>(s, item) {
        return s
    }
    val idx = hash(item) % len(s.buckets)
    val new_bucket = push(s.buckets[idx], item)
    val new_buckets = set(s.buckets, idx, new_bucket)
    return HashSet<T> { buckets: new_buckets }
}

pub fn hashset_remove<T: Eq + Hash>(s: HashSet<T>, item: T) -> HashSet<T> {
    val idx = hash(item) % len(s.buckets)
    val old_bucket = s.buckets[idx]
    var new_bucket: [T] = []
    for x in old_bucket {
        if x != item {
            new_bucket = push(new_bucket, x)
        }
    }
    val new_buckets = set(s.buckets, idx, new_bucket)
    return HashSet<T> { buckets: new_buckets }
}
