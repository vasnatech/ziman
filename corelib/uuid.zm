// uuid.zm -- UUID v4 (RFC 4122), written in ordinary Ziman on top of
// the `random` core module's one native function. Version/variant bits
// are set with plain integer arithmetic (div/mod/mul/add on a byte's
// int value), not bitwise operators -- Ziman has none -- since clearing
// or setting a nibble of an unsigned byte via div/mod by a power of two
// is exactly equivalent to masking it: `(b % 16) + 64` clears the top
// nibble and sets it to 4, the same effect as `(b & 0x0F) | 0x40`.
//
// `Uuid` satisfies `Eq` (structural equality on `[byte]`, which works
// since `byte` is scalar) but not `Hash` (hashing has no derived form
// for a struct -- see docs/SYNTAX.md "Generics") -- fine for using a
// `Uuid` as a struct field compared with `==`, not yet enough to use
// one as a `HashMap` key. `bytes` is an implementation detail Ziman has
// no per-field privacy to actually hide (same as `HashMap`'s own
// `buckets`) -- documented as "don't," not enforced.

use random.random_bytes
use number.byte_to_hex
use number.byte_from_hex
use json.Json
use sql.SqlValue
use sql.DbError
use sql.sql_as_text
use sql.sql_lift

pub struct Uuid {
    bytes: [byte]
}

pub fn uuid_new() -> Uuid {
    var bytes = random_bytes(16)
    val version_nibble = (bytes[6] as int) % 16
    bytes = set(bytes, 6, (version_nibble + 64) as byte) // version 4
    val variant_bits = (bytes[8] as int) % 64
    bytes = set(bytes, 8, (variant_bits + 128) as byte) // variant 1 (RFC 4122)
    return Uuid { bytes: bytes }
}

// Built on the prelude's StringBuilder rather than the concat-in-a-loop
// this originally was -- that accumulated a brand new string on every
// one of ~20 concat calls per Uuid stringified, each one immediately
// abandoned (Ziman never frees a Value -- see docs/DESIGN.md's memory-
// reclamation entry), a real, repeated cost given Uuid is Patient's own
// id in health-record-backend-ziman. One shared, amortized-growth native
// buffer plus one final snapshot copy replaces all of that.
pub fn uuid_to_string(u: Uuid) -> string {
    val sb = sb_new()
    for i in 0..16 {
        sb_append(sb, byte_to_hex(u.bytes[i]))
        if i == 3 || i == 5 || i == 7 || i == 9 {
            sb_append(sb, "-")
        }
    }
    return sb_to_string(sb)
}

// The inverse of uuid_to_string -- needed the moment any real caller
// gets a UUID back as a string (a JSON response field, a URL path
// segment) and has to turn it back into a usable Uuid for a follow-up
// call, exactly the "parse an id out of a response, then look it up"
// round trip health-record-backend-ziman's own response side needed.
// Requires the canonical, lowercase, dashed form uuid_to_string itself
// always produces (8-4-4-4-12 hex digits) -- not a general parser for
// every UUID variant's textual quirks (braces, uppercase, no dashes),
// none of which anything in this codebase ever produces or needs to
// accept.
pub fn uuid_from_string(s: string) -> Result<Uuid, string> {
    if len(s) != 36 {
        return err(format("invalid UUID '{}': expected 36 characters, found {}", s, len(s)))
    }
    if substring(s, 8, 9) != "-" || substring(s, 13, 14) != "-" || substring(s, 18, 19) != "-" || substring(s, 23, 24) != "-" {
        return err(format("invalid UUID '{}': expected '-' at positions 8, 13, 18, 23", s))
    }
    val bytes = ab_new<byte>()
    var i = 0
    while i < 36 {
        if i == 8 || i == 13 || i == 18 || i == 23 {
            i = i + 1
        } else {
            val b = byte_from_hex(substring(s, i, i + 2))?
            ab_append<byte>(bytes, b)
            i = i + 2
        }
    }
    return Uuid { bytes: ab_to_array<byte>(bytes) }
}

// Thin wrappers over uuid_to_string/uuid_from_string, named to match
// #[derive(Json)]'s own <type>_to_json/<type>_from_json naming
// convention (src/derive.c's pascal_to_snake) -- so a struct field of
// type Uuid resolves here automatically, the same as it would for a
// hand-written or derived struct/enum field. See docs/DESIGN.md's
// "Attributes and derive" entry for the full priority order this
// implements (a domain type's own _to_string/_from_string pair, wrapped
// in a JSON string, one level of indirection under the same _to_json/
// _from_json name every other field type is looked up by).
pub fn uuid_to_json(u: Uuid) -> Json {
    return Json.JString(uuid_to_string(u))
}

pub fn uuid_from_json(j: Json) -> Result<Uuid, string> {
    if !Json.is_JString(j) {
        return err("expected a JSON string for Uuid")
    }
    return uuid_from_string(Json.unwrap_JString(j))
}

// SQL mapping, for #[derive(Row)] (see src/derive.c): a Uuid is a TEXT
// column, in the canonical dashed form -- SQLite has no UUID type and
// Postgres's `uuid` column reads and writes the same text.
pub fn uuid_to_sql(u: Uuid) -> SqlValue {
    return SqlValue.Text(uuid_to_string(u))
}

pub fn uuid_from_sql(v: SqlValue) -> Result<Uuid, DbError> {
    val text = sql_as_text(v)?
    return sql_lift<Uuid>(uuid_from_string(text), "Uuid")
}
