// prelude.zm -- every type/function/val declared here is merged bare,
// unqualified, into every Ziman program, no `use` required (see
// docs/DESIGN.md's "Prelude" entry). Deliberately *not* a `use`-able
// core module despite living in corelib/ alongside ones that are: its
// generated header is still produced by the ordinary corelib Makefile
// rule (real .zm source, no hand-escaped C string, same as every other
// bundled module), but it's never added to corelib.c's CORE_MODULES
// table, so `use prelude` doesn't resolve to it -- there would be no
// reason to `use` something already available everywhere, and doing so
// would just parse this file a second time under a redundant qualifier.
//
// `pub` is meaningless here and never written -- privacy is enforced by
// the loader's cross-module resolution (loader.c's resolve_named_imports/
// resolve_cross_refs), which this file's contents never go through at
// all (see loader.c's load_module_graph: parsed once, merged directly,
// no self-qualify pass, same treatment the entry module's own bare
// names get).
//
// One native fn declaration per line, no body -- exactly the shape
// io.zm uses for a real native module. Their C implementations are
// registered by prelude_register() in src/prelude.c.
native fn parse_int(s: string) -> Result<int, string>
native fn parse_float(s: string) -> Result<float, string>
native fn parse_bigint(s: string) -> Result<bigint, string>
native fn parse_decimal(s: string) -> Result<decimal, string>
native fn floor(x: float) -> int
native fn ceil(x: float) -> int
native fn round(x: float) -> int
native fn decimal_round(d: decimal, scale: int) -> decimal
native fn concat(a: string, b: string) -> string
native fn substring(s: string, start: int, end: int) -> string
native fn split(s: string, sep: string) -> [string]
native fn trim(s: string) -> string
native fn to_upper(s: string) -> string
native fn to_lower(s: string) -> string
// A single-pass, O(N) join of however many strings the caller writes out
// individually (`join(pieces: "a", "b", "c")`) or hands over as one
// already-built array (`join(pieces: arr)`) -- see docs/DESIGN.md's
// "join"/variadic parameters entry for why this needed to be native (a
// pure-Ziman version accumulating via repeated `concat` would just
// reintroduce the same O(N^2) pattern this exists to replace) and why a
// variadic parameter, not an ordinary `[string]` one, was worth adding
// to the language for it. `prefix`/`suffix`/`separator` are each
// Option<string> specifically so the common case -- none of them --
// can be left out of a named call entirely (`join(pieces: arr)`) rather
// than spelled out as `Option<string>.None` three times; give any of
// them to wrap the whole thing (`join(prefix: Option<string>.Some("["),
// suffix: Option<string>.Some("]"), separator: Option<string>.Some(", "),
// pieces: arr)` -- or the equivalent, shorter bare-string form,
// `join(prefix: "[", suffix: "]", separator: ", ", pieces: arr)`,
// auto-wrapped to Some(...) the same way any other Option<T> argument
// is). A positional call still works too, with every one of the four
// parameters given explicitly and in order, exactly like calling any
// other function positionally always has.
native fn join(prefix: Option<string>, suffix: Option<string>, separator: Option<string>, pieces: string...) -> string

// `Option<T>` -- moved here from collections.zm so it needs no `use
// collections` (or a per-name import of it) anywhere it's used, the
// same way `Result<T, E>` needs none despite also being a two-variant
// generic outcome type; unlike `Result`, this stays ordinary Ziman
// source (an enum + one helper function), not a hardcoded language
// primitive, since nothing about it needs native code or a dedicated
// TypeKind.
enum Option<T> {
    Some(T)
    None
}

fn option_unwrap_or<T>(o: Option<T>, default_value: T) -> T {
    if Option.is_Some(o) {
        return Option.unwrap_Some(o)
    }
    return default_value
}

// A mutable string-accumulation handle -- the general-purpose fix for
// the O(N^2)-allocation, O(N)-leaked-garbage pattern every prior
// accumulate-via-concat/push loop in this codebase's own corelib hit
// (uuid_to_string, json_to_string, hashmap_keys/values, hashset_items;
// see docs/DESIGN.md's "StringBuilder" entry), built once so no future
// occurrence needs its own bespoke native function. `handle` is an
// opaque index into a native-side table of real, growable C buffers
// (src/prelude.c) -- not a new built-in type or TypeKind the way
// `Channel<T>` is, since StringBuilder needs no generic type parameter
// or thread-safe queue semantics, just in-place mutation, so an
// ordinary struct wrapping an int is enough. Like `Uuid.bytes`, `handle`
// has no enforced privacy: don't construct or edit it directly, only
// through sb_new/the sb_* functions below. Not documented as safe to
// share across threads -- each StringBuilder is meant to be built up by
// one thread at a time, same as Java's own (unsynchronized) StringBuilder.
struct StringBuilder {
    handle: int
}

// `capacity` (bytes to pre-allocate) and `grow_factor` (the multiplier
// applied to capacity, geometrically, whenever an append would overflow
// it) both have ordinary, rarely-overridden defaults -- the whole reason
// they're Option<T> rather than plain required parameters is so the
// common case, `sb_new()`, doesn't have to spell out either one.
native fn sb_new(capacity: Option<int> = 20, grow_factor: Option<float> = 2.0) -> StringBuilder
// Appends however many pieces the call site writes out individually or
// hands over as one already-built array -- the same variadic shape
// `join` itself uses, for the same reason (see ast.h's Param comment).
// No return value: `sb` mutates in place (the same handle, not a new
// one), so there is nothing new to hand back -- mirrors `send`'s own
// void return on `Channel<T>`, Ziman's only other mutable, identity-
// based value.
native fn sb_append(sb: StringBuilder, pieces: string...)
// Snapshots whatever has been appended so far into an ordinary,
// immutable Ziman string -- `str(sb)` can't do this itself (it would
// just print the struct's own literal fields, `StringBuilder { handle:
// N }`, since Ziman has no per-type custom-formatting hook), so this is
// the only way to read a StringBuilder's contents. Safe to call more
// than once, and to keep appending afterward -- each call is an
// independent copy, not a one-time "finish".
native fn sb_to_string(sb: StringBuilder) -> string
// The number of bytes appended so far (always >= 0), without needing to
// materialize the string itself via sb_to_string first.
native fn sb_len(sb: StringBuilder) -> int

// StringBuilder's generic counterpart -- the same fix for `push` in a
// loop (hashmap_keys/values, hashset_items still do exactly this) that
// StringBuilder is for `concat` in a loop: `push` copies the *entire*
// existing array on every call, since Ziman's arrays are immutable
// value types, so an accumulate-via-push loop is the same O(N^2)-
// allocation, O(N)-leaked-garbage pattern StringBuilder already fixed
// for strings. Needed `native fn` to accept type parameters first (see
// docs/DESIGN.md's "Generic native fns" entry) -- ArrayBuilder<T> is
// its first real use. Same "plain struct wrapping an opaque handle, not
// a new TypeKind" shape as StringBuilder, for the same reason: no
// thread-safe queue semantics needed, just in-place mutation, so
// Channel<T>'s own heavier integration buys nothing here either.
struct ArrayBuilder<T> {
    handle: int
}

// Same capacity/grow_factor defaults, same reasoning, as sb_new.
native fn ab_new<T>(capacity: Option<int> = 20, grow_factor: Option<float> = 2.0) -> ArrayBuilder<T>
// Appends however many pieces the call site writes out individually or
// hands over as one already-built array -- same variadic shape as
// sb_append/join, same void return (ab mutates in place) as sb_append.
native fn ab_append<T>(ab: ArrayBuilder<T>, pieces: T...)
// Snapshots whatever has been appended so far into an ordinary,
// immutable Ziman array -- safe to call more than once, and to keep
// appending afterward, same as sb_to_string.
native fn ab_to_array<T>(ab: ArrayBuilder<T>) -> [T]
// The number of elements appended so far (always >= 0).
native fn ab_len<T>(ab: ArrayBuilder<T>) -> int
