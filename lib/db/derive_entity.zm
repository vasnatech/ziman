// `#[derive(Entity)]`, written in Ziman: the column list an entity's queries name, and -- when
// the attribute carries a table -- the table name and the `eql.Entity` metamodel beside it.
//
// **The last of the five, and the first to read a derive argument and a field attribute.** Everything
// it needs that the other four did not is what steps 3 of docs/design/meta.md added: the string
// in `#[derive(Entity("medications"))]`, and `#[pk]` as an entry in a field's `attrs`.
//
// What it emits only what the compiler already knows for certain. In particular it does **not**
// guess the table name from the type: of the North Star's eighteen entities, three break every
// pluralisation rule (`FamilyHistory` is stored in `family_history`, `MedicalHistory` in
// `medical_histories`, `UserNotificationPreference` in `user_notification_prefs`), and a wrong
// guess generates SQL against a table that does not exist.
//
// The entity *name* is the struct's, not the table's: `eql` matches what a query writes
// (`FROM Patient p`) against it, and taking it from the table would make `FROM patients p` the
// spelling -- SQL leaking back through the layer whose job is to hide it.
#![experimental]
#![generator(Entity)]

use meta
use template

// Everything this generator writes. For `#[derive(Row, Entity("notes"))] struct Note { #[pk] id: Uuid  body: string }`:
//
//     pub val note_columns: [string] = ["id", "body"]
//
//     pub val note_table: string = "notes"
//
//     pub val note_meta: eql.Entity = eql.keyed_entity("Note", "notes", note_columns, ["id"])
//
// Written bare -- `#[derive(Entity)]` with no table -- only the column list is emitted, which is
// what an entity whose table is decided elsewhere still wants.
val sheet = template.must_parse("""
@template columns
pub val @{snake}_columns: [string] = [@{columns}]

@end

@template table
pub val @{snake}_table: string = "@{table}"

@end

@template meta
@if keyed && mapped
pub val @{snake}_meta: eql.Entity = eql.keyed_entity("@{name}", "@{table}", @{snake}_columns, [@{keys}], [@{fields}])
@elif keyed
pub val @{snake}_meta: eql.Entity = eql.keyed_entity("@{name}", "@{table}", @{snake}_columns, [@{keys}])
@elif mapped
pub val @{snake}_meta: eql.Entity = eql.entity("@{name}", "@{table}", @{snake}_columns, [@{fields}])
@else
pub val @{snake}_meta: eql.Entity = eql.entity("@{name}", "@{table}", @{snake}_columns)
@end

@end
""")
// **The two attributes the entity layer owns.** `#[pk]` marks a key column and `#[column]`
// overrides a column name; `derive_row` and `eql` read them too, and they are declared here
// because this is the generator the metamodel comes from. The compiler holds no list of field
// attributes and asks every loaded generator for one (docs/design/user-generators.md §5a).
pub fn attributes() -> [meta.AttrSpec] {
    return [
        meta.attr_spec("pk", ""),
        meta.attr_spec("column", "name:string")
    ]
}

// The column a field is stored in: `#[column(name: "start_date")]`'s argument, or the field's own
// name -- the overwhelmingly common case, and the one `eql` calls an identity "by construction".
//
// **The SQL meaning of the attribute lives in the SQL generators**, not in `meta`, which models a
// declaration and knows nothing about columns. Two generators need it and the function is one
// line, so it is written in each rather than exported from one to the other.
fn column_of(f: meta.Field) -> string {
    return get_or(meta.attr_value(f, "column", "name"), f.name)
}

// `"id", "body"` -- a list the generated source spells inline, so it is joined here rather than
// repeated by a `@for`: a directive owns its whole line and cannot build an inline list
// (docs/design/templates.md §16).
fn quoted(names: [string]) -> string {
    val out = mutable_array_new<string>()
    for n in names {
        push(out, concat("\"", n, "\""))
    }
    return join(separator: ", ", pieces: snapshot(out))
}

pub fn generate(d: meta.Decl) -> Result<string, string> {
    switch d.body {
        Struct(fields) { return entity(d, fields) }
        // `src/derive.c` refuses `derive(Entity)` on an enum before this runs. The arm is here
        // because the `switch` requires one, which is what makes the refusal unforgettable.
        Enum(_) {
            return err(concat("derive(Entity) does not support an enum ('", d.name, "')"))
        }
    }
}

fn entity(d: meta.Decl, fields: [meta.Field]) -> Result<string, string> {
    val names = mutable_array_new<string>()
    val field_names = mutable_array_new<string>()
    val keys = mutable_array_new<string>()
    // **`keys` are column names**, because `eql` puts them straight into SQL and compares them
    // against `columns` -- see `update_one`. A `#[pk]` field with an override is keyed on its
    // column, not on the name the struct spells it.
    var overridden = false
    for f in fields {
        val column = column_of(f)
        push(names, column)
        push(field_names, f.name)
        if column != f.name {
            overridden = true
        }
        if meta.has_attr(f, "pk") {
            push(keys, column)
        }
    }
    val columns = try template.render(sheet, "columns", [
        template.text("snake", d.snake_name),
        template.text("columns", quoted(snapshot(names)))
    ])
    // Written bare, the column list is the whole output: there is no table to name and no
    // metamodel to build without one.
    // **The table has to be written as a string.** A bare word reads like a type name --
    // `Entity(patients)` could plausibly mean a struct called `patients` -- and `src/parser.c`
    // refused it until 2026-10-30, when a target's arguments became the generic kind-carrying
    // list every field attribute uses. The refusal belongs here now: the parser has no opinion
    // about what `Entity` means.
    if Some(one) = meta.decl_attr_arg(d, "value") {
        if one.kind != "string" {
            return err(prelude.format(
                "derive(Entity) names a table with a string, and '{}' is written as a {} -- " \
                    "derive(Entity(\"{}\")) is the table, where derive(Entity({})) reads like a type",
                one.value,
                one.kind,
                one.value,
                one.value
            ))
        }
    }
    if None = meta.decl_arg(d) {
        return ok(columns)
    }
    val table = unwrap(meta.decl_arg(d))
    // `keyed_entity` when any field carries `#[pk]` and `entity` when none does, so an entity
    // with no key says so in the call rather than carrying an empty list that reads like an
    // oversight. More than one `#[pk]` is a compound key, in field order.
    return ok(concat(
        columns,
        try template.render(sheet, "table", [
            template.text("snake", d.snake_name),
            template.text("table", table)
        ]),
        try template.render(sheet, "meta", [
            template.text("snake", d.snake_name),
            template.text("name", d.name),
            template.text("table", table),
            template.flag("keyed", prelude.len(keys) > 0),
            template.text("keys", quoted(snapshot(keys))),
            // **The pairing is passed only when a field overrides its column.** Where none does,
            // the call is the one every entity has written until now, byte for byte -- which is
            // what keeps the North Star's generated text unmoved and says in the output itself
            // that field and column are the same list here.
            template.flag("mapped", overridden),
            template.text("fields", quoted(snapshot(field_names)))
        ])
    ))
}
