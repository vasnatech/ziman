// migrate.zm -- versioned schema migrations: a directory of plain `.sql` files, applied in order, once each.
//
// A migration is a file named `V<version>__<name>.sql` (`V001__create_users.sql`): the version is a whole number, the
// name says what it does, and the versions of a directory run 1, 2, 3, ... with no gap and no repeat. The file holds
// ordinary SQL, one or more statements separated by `;` (a `;` inside a quoted string, an identifier, a `--` or
// `/* */` comment or a `$$ ... $$` body does not end one). Files in the directory that do not end in `.sql` are
// ignored; a `.sql` file that does not fit the name is an error, so a typo cannot silently skip a migration.
//
//     val applied = try migrate.run(conn, "migrations")
//
// SQL that has to differ by engine comes in two sizes, and they have different answers.
//
// A whole migration that differs -- `ALTER TABLE ... ADD CONSTRAINT`, which SQLite lacks, or a data conversion one
// engine needs and another does not -- goes in a subdirectory named for the engine, `migrations/postgres/`,
// `migrations/sqlite/` or `migrations/mysql/`. `run` applies the files of the directory and of the subdirectory of
// the engine the connection is on, as one list: each version is in the shared directory or in the engine's, never
// both, so every engine's database has 1, 2, 3, ... and a version whose SQL differs has one file per engine.
//
// A migration that differs only in a *column type* -- a key that is `uuid` on PostgreSQL and `TEXT` on SQLite --
// does not need two files. Write `{{uuid}}` and `load_for` substitutes the engine's spelling; see "engine type
// tokens" below. Two files for one column type is how a schema drifts, and the drift is not hypothetical: the
// health-record backend kept nine such pairs, 342 duplicated lines, and the duplication caused a two-commit
// PostgreSQL outage before anything ran both engines.
//
// `run` keeps a table, `schema_migrations`, with a row per applied migration: its version, name, a checksum of its
// text and when it ran. Each start it:
//
//   - refuses a database that has a migration the directory does not (the database is newer than the program);
//   - refuses one whose stored checksum differs from the file's, because an applied migration has been edited: a
//     database built from the edited file would differ from one that ran the original, and nothing would say so. To
//     change a schema, add a migration; never edit one that has run somewhere;
//   - applies the pending ones, in version order.
//
// All the pending migrations and their `schema_migrations` rows go in one transaction, so a failure leaves the
// database as it was (on SQLite and PostgreSQL; MySQL commits DDL statement by statement, so there a failure in the
// middle leaves the earlier statements done). On PostgreSQL the run also takes an advisory lock for the length of
// the transaction, so several servers starting at once migrate one after the other, not all at once.
//
// There are no down migrations: a mistake is fixed by the next migration.

use crypto
use datasource
use datasource.Connection
use db.DbError
use db.SqlValue
use db.row_get
use db.sql_as_int
use db.sql_as_text
use fs
use os
use time

// One migration: its `version`, its `name`, the `file` it came from (for messages), its `sql` text and the
// `checksum` of that text.
pub struct Migration {
    version: int
    name: string
    file: string
    sql: string
    checksum: string
}

// The number `pg_advisory_xact_lock` is asked for: any fixed number, the same in every program that uses this module.
val lock_key = 727364

fn problem(message: string) -> DbError {
    return DbError.Sql(concat("migration: ", message))
}

// The checksum of a migration's text: SHA-256, base64, over the text with its line endings normalised, so a file
// checked out with CRLF on another machine has the same checksum.
pub fn checksum(sql: string) -> string {
    return crypto.base64_encode(crypto.sha256(string_to_bytes(replace(sql, "\r", ""))))
}

// A migration made from its parts, with its checksum worked out: for migrations that are written in the program
// rather than read from a directory.
pub fn migration(version: int, name: string, sql: string) -> Migration {
    return Migration {
        version: version,
        name: name,
        file: format("V{}__{}.sql", version, name),
        sql: sql,
        checksum: checksum(sql)
    }
}

// ---------------------------------------------------------------- engine type tokens

// Two engines often want the same table and disagree about one column type -- a key is `uuid` on PostgreSQL and
// `TEXT` on SQLite, and PostgreSQL will not create a foreign key between the two. Writing the whole file twice for
// that is how a schema drifts: the health-record backend had nine such pairs, 342 lines of DDL maintained in
// duplicate, and the duplication had already caused a two-commit PostgreSQL outage.
//
// So a shared migration may write a token, and `load_for` substitutes the engine's spelling before anything reads
// the SQL:
//
//     CREATE TABLE audit_events (
//         id {{uuid}} PRIMARY KEY,
//         actor_id {{uuid}} NOT NULL REFERENCES users(id),
//         ...
//
// This is deliberately not a template language. There are no expressions, no conditionals and no way to add a
// token from outside this file: a migration either differs in a column type, which a token covers, or it differs in
// its statements, which is what the `postgres/`, `sqlite/` and `mysql/` subdirectories are for. An unknown
// `{{...}}` is an error naming the file, never text passed through to the database, so a typo fails at startup
// rather than creating a column called `{{uudi}}`.
//
// **The checksum is of the substituted SQL, not of the template.** It has to be: the checksum's job is to notice
// when the SQL a database actually ran stops matching the SQL the program now has, and a template whose token
// table changed meaning would otherwise slip past. The consequence is worth stating plainly -- collapsing an
// already-applied pair of files into one token file changes that migration's checksum, and `run` refuses a
// database whose stored checksum moved. That is the correct refusal; it just means the collapse belongs in the
// same change as a fresh database, or needs the stored checksums updated deliberately.
pub struct TypeToken {
    token: string
    sqlite: string
    postgres: string
    mysql: string
}

// Every token, and what each engine gets. `CHAR(36)` rather than MySQL's `BINARY(16)`: the text form is what the
// other two store, and a migration that moves to the packed form can be written when something needs it.
pub val type_tokens = [
    TypeToken { token: "{{uuid}}", sqlite: "TEXT", postgres: "uuid", mysql: "CHAR(36)" }
]

fn spelling(t: TypeToken, dialect: string) -> Option<string> {
    if dialect == "sqlite" {
        return Some(t.sqlite)
    } else if dialect == "postgres" {
        return Some(t.postgres)
    } else if dialect == "mysql" {
        return Some(t.mysql)
    }
    return None
}

// `sql` with every `{{token}}` replaced by `dialect`'s spelling. An Err if a `{{...}}` is left over -- an unknown
// token, or a known one on an engine this file has no spelling for -- naming `file` so the message says where.
pub fn substitute(sql: string, dialect: string, file: string) -> Result<string, DbError> {
    var out = sql
    for t in type_tokens {
        if contains(out, t.token) {
            val replacement = switch spelling(t, dialect) {
                Some(s) { s }
                None { return err(problem(format(
                    "{} uses {} and there is no spelling of it for '{}'",
                    file,
                    t.token,
                    dialect
                ))) }
            }
            out = replace(out, t.token, replacement)
        }
    }
    // Only a `{{name}}` left over is a typo. The check is deliberately this narrow: PostgreSQL writes a
    // two-dimensional array literal as '{{1,2},{3,4}}', so a bare "does it contain {{" would refuse valid SQL.
    // A literal that is *exactly* one lowercase word, '{{a}}', is still refused -- the message says why, and
    // writing it as '{{"a"}}' is the way past.
    if Some(name) = leftover_token(out) {
        return err(problem(format(
            "{} uses an unknown token {} (the tokens are in migrate.zm's type_tokens)",
            file,
            name
        )))
    }
    return ok(out)
}

// The first `{{name}}` in `sql`, where `name` is a lowercase identifier, or None.
fn leftover_token(sql: string) -> Option<string> {
    var from = index_of(sql, "{{", 0)
    while from >= 0 {
        val close = index_of(sql, "}}", from)
        if close < 0 {
            return None
        }
        val inner = substring(sql, from + 2, close)
        if len(inner) > 0 && is_token_name(inner) {
            return Some(substring(sql, from, close + 2))
        }
        from = index_of(sql, "{{", from + 2)
    }
    return None
}

fn is_token_name(s: string) -> bool {
    for i in 0..len(s) {
        val c = substring(s, i, i + 1)
        val ok_char = (c >= "a" && c <= "z") || (c >= "0" && c <= "9") || c == "_"
        if !ok_char {
            return false
        }
    }
    return true
}

// `m` with its SQL substituted for `dialect` and its checksum worked out over the substituted text. A migration
// with no token is returned untouched, so its checksum is the file's and nothing that predates tokens moves.
fn for_dialect(m: Migration, dialect: string) -> Result<Migration, DbError> {
    if !contains(m.sql, "{{") {
        return ok(m)
    }
    val sql = try substitute(m.sql, dialect, m.file)
    return ok(with m { sql: sql, checksum: checksum(sql) })
}

// Every migration of `list`, substituted for `dialect`. Applied to the dialect subdirectories too, not only the
// shared one: a token there is pointless rather than wrong, and one rule is easier to hold than two.
fn substituted(list: [Migration], dialect: string) -> Result<[Migration], DbError> {
    val out = mutable_array_new<Migration>()
    for m in list {
        mutable_array_push(out, try for_dialect(m, dialect))
    }
    return ok(snapshot(out))
}

// ---------------------------------------------------------------- splitting a file into statements

fn is_tag_char(c: string) -> bool {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"
}

// The index after the quote that closes the one opened at `start` (a doubled quote does not close it, it is
// two quotes in a row: the first closes and the second opens again), or the end of `sql` when it never closes.
fn quote_end(sql: string, start: int, quote: string) -> int {
    val close = index_of(sql, quote, start + 1)
    return if close < 0 { len(sql) } else { close + 1 }
}

// The index after the end of the dollar-quoted body that starts at `start`, where `tag` (`$$`, `$body$`) opened it, or
// the end of `sql` when it never closes.
fn dollar_end(sql: string, start: int, tag: string) -> int {
    val close = index_of(sql, tag, start + len(tag))
    return if close < 0 { len(sql) } else { close + len(tag) }
}

// The statements of `sql`, without their `;`, comments or surrounding blanks; blank ones are dropped.
pub fn split_statements(sql: string) -> [string] {
    val out = mutable_array_new<string>()
    var current = mutable_string_new()
    val n = len(sql)
    var i = 0
    while i < n {
        val c = char_at(sql, i)
        if c == "'" || c == "\"" {
            val end = quote_end(sql, i, c)
            mutable_string_append(current, substring(sql, i, end))
            i = end
        } else if c == "-" && is_char_at(sql, i + 1, "-") {
            val end = index_of(sql, "\n", i)
            i = if end < 0 { n } else { end }
        } else if c == "/" && is_char_at(sql, i + 1, "*") {
            val end = index_of(sql, "*/", i + 2)
            i = if end < 0 { n } else { end + 2 }
        } else if c == "$" {
            var j = i + 1
            while j < n && is_tag_char(char_at(sql, j)) {
                j = j + 1
            }
            if j < n && is_char_at(sql, j, "$") {
                val tag = substring(sql, i, j + 1)
                val end = dollar_end(sql, i, tag)
                mutable_string_append(current, substring(sql, i, end))
                i = end
            } else {
                mutable_string_append(current, c)
                i = i + 1
            }
        } else if c == ";" {
            val statement = trim(snapshot(current))
            if !is_empty(statement) {
                mutable_array_push(out, statement)
            }
            current = mutable_string_new()
            i = i + 1
        } else {
            mutable_string_append(current, c)
            i = i + 1
        }
    }
    val last = trim(snapshot(current))
    if !is_empty(last) {
        mutable_array_push(out, last)
    }
    return snapshot(out)
}

// ---------------------------------------------------------------- reading a directory

// `V001__create_users.sql` as a migration, reading the file at `path`.
fn read_migration(dir: string, file: string) -> Result<Migration, DbError> {
    val separator = index_of(file, "__", 0)
    if !starts_with(file, "V") || separator < 2 || separator + 2 >= len(file) - 4 {
        return err(problem(format("{} is not named V<version>__<name>.sql", file)))
    }
    val version = switch parse_int(substring(file, 1, separator)) {
        Ok(number) { number }
        Err(_) { return err(problem(format("{} does not start with a version number", file))) }
    }
    if version < 1 {
        return err(problem(format("{}: versions start at 1", file)))
    }
    val text = switch fs.read_text(fs.path_join(dir, file)) {
        Ok(contents) { contents }
        Err(e) { return err(problem(fs.fs_error_message(e))) }
    }
    return Migration {
        version: version,
        name: substring(file, separator + 2, len(file) - 4),
        file: file,
        sql: text,
        checksum: checksum(text)
    }
}

// The migrations in `dir`, in version order. An Err for an unreadable directory, a `.sql` file with a bad name, or
// versions that repeat or skip.
//
// The SQL comes back as written, with any `{{token}}` still in it, because a directory has no engine of its own --
// `load_for` is what substitutes, and its checksums are the ones a database stores. Use this to list or inspect
// the files; use `load_for` to get what will actually run.
pub fn load(dir: string) -> Result<[Migration], DbError> {
    val names = switch fs.list_dir(dir) {
        Ok(listed) { listed }
        Err(e) { return err(problem(fs.fs_error_message(e))) }
    }
    val found = mutable_array_new<Migration>()
    for file in names {
        if ends_with(file, ".sql") {
            val one = try read_migration(dir, file)
            mutable_array_push(found, one)
        }
    }
    val items = snapshot(found)
    val versions = array_map<Migration, int>(items, fn(m: Migration) -> int { return m.version })
    return ok(array_sort_by_keys<Migration, int>(items, versions))
}

// The migrations for a database on `dialect` (`sqlite`, `postgres`, `mysql`): those in `dir`, which run everywhere, and those in `dir/<dialect>/`, which
// run only there, as one list in version order. A version may be in the shared directory or in a dialect's, never in both -- the versions of one
// database must be 1, 2, 3, ... whichever engine it is, so each dialect directory holds its own file for a version the shared directory leaves out. A
// missing dialect directory is no migrations of its own.
pub fn load_for(dir: string, dialect: string) -> Result<[Migration], DbError> {
    val shared = try substituted(try load(dir), dialect)
    val own = fs.path_join(dir, dialect)
    if !fs.is_dir(own) {
        return shared
    }
    val specific = try substituted(try load(own), dialect)
    for m in specific {
        for other in shared {
            if other.version == m.version {
                return err(problem(format(
                    "version {} is in both {} and {}",
                    m.version,
                    other.file,
                    fs.path_join(dialect, m.file)
                )))
            }
        }
    }
    val all = concat_arrays<Migration>(shared, specific)
    val versions = array_map<Migration, int>(all, fn(m: Migration) -> int { return m.version })
    return ok(array_sort_by_keys<Migration, int>(all, versions))
}

// The versions must be 1, 2, 3, ... in order.
fn check_sequence(migrations: [Migration]) -> Result<unit, DbError> {
    for i in 0..len(migrations) {
        val m = migrations[i]
        if i > 0 && migrations[i - 1].version == m.version {
            return err(problem(format(
                "version {} is used by both {} and {}",
                m.version,
                migrations[i - 1].file,
                m.file
            )))
        }
        if m.version != i + 1 {
            return err(problem(format(
                "versions must run 1, 2, 3, ... with no gap or repeat, but {} is where {} was expected",
                m.file,
                i + 1
            )))
        }
    }
    return unit
}

// ---------------------------------------------------------------- applying

// Applied migrations are checked against the ones the program has: the same count or fewer, the same versions in
// order, the same checksums. Returns how many are already applied.
fn check_applied(tx: Connection, migrations: [Migration]) -> Result<int, DbError> {
    val rows = try datasource.query(tx, "SELECT version, name, checksum FROM schema_migrations ORDER BY version")
    for i in 0..len(rows) {
        val version_value = try row_get(rows[i], "version")
        val version = try sql_as_int(version_value)
        val stored_value = try row_get(rows[i], "checksum")
        val stored = try sql_as_text(stored_value)
        if version != i + 1 || i >= len(migrations) {
            return err(problem(format(
                "the database has migration {} applied, which this program does not have (or not in this place)",
                version
            )))
        }
        if stored != migrations[i].checksum {
            return err(problem(format(
                "{} was changed after it was applied (its checksum is not the one stored); add a new migration instead of editing an applied one",
                migrations[i].file
            )))
        }
    }
    return len(rows)
}

fn apply_one(tx: Connection, m: Migration) -> Result<int, DbError> {
    for statement in split_statements(m.sql) {
        try datasource.execute(tx, statement)
    }
    return datasource.execute(
        tx,
        "INSERT INTO schema_migrations (version, name, checksum, applied_at) VALUES ($1, $2, $3, $4)",
        SqlValue.Int(m.version),
        SqlValue.Text(m.name),
        SqlValue.Text(m.checksum),
        SqlValue.Text(time.instant_to_string(time.instant_now()))
    )
}

fn apply_in(tx: Connection, migrations: [Migration]) -> Result<int, DbError> {
    if Connection.is_Postgres(tx) {
        try datasource.query(tx, "SELECT pg_advisory_xact_lock($1)", SqlValue.Int(lock_key))
    }
    try datasource.execute(
        tx,
        """
        CREATE TABLE IF NOT EXISTS schema_migrations (
            version INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            checksum TEXT NOT NULL,
            applied_at TEXT NOT NULL
        )
        """
    )
    val done = try check_applied(tx, migrations)
    for i in done..len(migrations) {
        try apply_one(tx, migrations[i])
    }
    return len(migrations) - done
}

// Brings the database to the latest of `migrations`, given in version order; the number applied by this call. See
// the top of this file for what it checks and how it is kept safe.
pub fn apply(conn: Connection, migrations: [Migration]) -> Result<int, DbError> {
    try check_sequence(migrations)
    return datasource.with_transaction<int>(conn, fn(tx: Connection) -> Result<int, DbError> {
        return apply_in(tx, migrations)
    })
}

// `apply` for the migrations in the directory `dir`, resolved through `ZIMAN_RESOURCE_PATH` first (see
// `fs.resolve`) -- with the variable unset, `dir` is used exactly as given, unchanged.
pub fn run(conn: Connection, dir: string) -> Result<int, DbError> {
    val resolved = switch fs.resolve(dir) {
        Some(path) { path }
        None { return err(problem(format(
            "'{}' is not in ZIMAN_RESOURCE_PATH ({})",
            dir,
            unwrap(os.getenv("ZIMAN_RESOURCE_PATH"))
        ))) }
    }
    return apply(conn, try load_for(resolved, datasource.dialect(conn)))
}
