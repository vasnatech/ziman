// pg.zm -- a PostgreSQL client, the second backend behind the `db`
// module (`db.open("postgres://user:password@host:port/database")`).
// Written in Ziman on top of `net` (TCP), `bytes` (message framing) and
// `crypto` (SCRAM-SHA-256); nothing here is native but the exact float
// formatting. It speaks protocol version 3.0.
//
// What it supports: trust, cleartext-password and SCRAM-SHA-256
// authentication (the default since Postgres 14); the simple query
// protocol for parameterless statements (which also lets `execute` take a
// `;`-separated DDL script) and the extended protocol (Parse/Bind/
// Describe/Execute/Sync) for statements with bound `$1, $2, ...`
// parameters -- values always travel as parameters, never spliced into the
// SQL. Everything is exchanged in text format, so a value's meaning comes
// from the result column's type OID: integers, floats, booleans and bytea
// become the matching `SqlValue`, and everything else (text, uuid, dates
// and timestamps, numeric, json, ...) arrives as `Text` and is converted
// by the mapping layer, exactly as it is for SQLite.
//
// TLS is negotiated the way Postgres does it: an SSLRequest packet, the
// server's one-byte answer ('S' to proceed, 'N' if it has no TLS), then
// the same connection is upgraded in place (`net.start_tls_with`) before
// the startup message. The URL's `sslmode` follows libpq's meanings:
// `disable` (no TLS -- the default here, unlike libpq's `prefer`),
// `prefer` (use TLS if the server offers it, else plaintext; no
// verification), `require` (TLS or fail, but the certificate is NOT
// verified -- encrypted, yet open to a man in the middle, exactly as in
// libpq), `verify-ca` (also verify the certificate chain) and
// `verify-full` (also that the certificate is valid for the host you
// asked for -- the one to use for a hosted database). `sslrootcert=<path>`
// names a PEM file of trusted CAs; without it the system CA store is
// used (libpq reads ~/.postgresql/root.crt instead). `allow` is not
// supported, and if a `prefer` handshake fails there is no retry over a
// fresh plaintext connection.
//
// What it does not: MD5 authentication (deprecated; removed as the
// default in Postgres 14), Kerberos/GSS, client certificates, IPv6
// literals in the URL, the COPY protocol, LISTEN/NOTIFY,
// prepared-statement reuse (every parameterised statement is parsed
// afresh), or SASLprep normalisation of a non-ASCII password. `[byte]` is an array of interpreter values, so
// very large result sets are slow -- see docs/ROADMAP.md.
//
// One connection is owned by one spawned thread and driven through a
// channel of requests -- Ziman has no mutex, and the protocol is strictly
// request/response, so a lone owner thread is what serialises concurrent
// callers (each blocks on its own reply channel). That also means there
// is no lock a `?` returning early can leave held. A *transaction* is
// still per-connection state on the server: statements from other
// threads interleave inside it, as documented for `db`.

use crypto.base64_decode
use crypto.base64_encode
use crypto.bytes_xor
use crypto.hmac_sha256
use crypto.pbkdf2_hmac_sha256
use crypto.sha256
use dburl
use net
use net.Socket
use net.net_error_message
use number.byte_from_hex
use number.bytes_to_hex
use number.u16_from_bytes
use number.u16_to_bytes
use number.u32_from_bytes
use number.u32_to_bytes
use random.random_bytes
use sql.DbError
use sql.Row
use sql.SqlValue

// Protocol 3.0 startup: a 4-byte length (counting itself), a 4-byte version, then the
// parameters -- 8 fixed bytes. An SSLRequest is that same 8-byte header with a magic
// code where the version goes.
val startup_header_bytes = 8
val protocol_version_3 = 196608
val ssl_request_code = 80877103

pub struct QueryResult {
    rows: [Row]
    affected: int
}

pub struct RunRequest {
    sql: string
    params: [SqlValue]
    reply_to: Channel<Result<QueryResult, DbError>>
}

pub enum Request {
    Run(RunRequest)
    Close
}

struct Message {
    kind: string
    body: [byte]
}

struct PgUrl {
    user: string
    password: string
    host: string
    port: int
    database: string
    sslmode: string
    sslrootcert: string
}

pub native fn float_to_text(f: float) -> string

// ---------------------------------------------------------------- helpers

fn lift<T>(r: Result<T, net.NetError>) -> Result<T, DbError> {
    if !is_ok(r) {
        return err(DbError.Connection(net_error_message(unwrap_err(r))))
    }
    return unwrap(r)
}

fn conn_err(message: string) -> DbError {
    return DbError.Connection(message)
}

fn cstring(s: string) -> [byte] {
    return bytes_concat(string_to_bytes(s), [0b])
}

fn text_of(b: [byte], start: int, end: int) -> string {
    return unwrap(bytes_to_string(slice<byte>(b, start, end)))
}

// Index of the 0 byte at or after `start`.
fn cstring_end(b: [byte], start: int) -> int {
    var i = start
    while i < len(b) && b[i] != 0b {
        i = i + 1
    }
    return i
}

fn send_message(sock: Socket, kind: string, body: [byte]) -> Result<int, DbError> {
    return lift<int>(net.write(sock, bytes_concat(string_to_bytes(kind), u32_to_bytes(len(body) + 4), body)))
}

fn read_message(sock: Socket) -> Result<Message, DbError> {
    val header = lift<[byte]>(net.read_exact(sock, 5))?
    val length = u32_from_bytes(header, 1)
    val body = lift<[byte]>(net.read_exact(sock, length - 4))?
    return Message { kind: text_of(header, 0, 1), body: body }
}

// An ErrorResponse: fields of (code byte, cstring) until a 0. 'C' is the
// five-character SQLSTATE, 'M' the human-readable message. SQLSTATE
// class 23 is an integrity-constraint violation (unique, foreign key,
// not null, check); class 08 is a connection exception.
fn parse_error(body: [byte]) -> DbError {
    var code = ""
    var message = "unknown error"
    var pos = 0
    while pos < len(body) && body[pos] != 0b {
        val field = text_of(body, pos, pos + 1)
        val end = cstring_end(body, pos + 1)
        val value = text_of(body, pos + 1, end)
        if field == "C" {
            code = value
        } else if field == "M" {
            message = value
        }
        pos = end + 1
    }
    val class = substring(concat(code, "00"), 0, 2)
    if class == "23" {
        return DbError.Constraint(message)
    }
    return if class == "08" || class == "28" || class == "3D" {
        DbError.Connection(message)
    } else {
        DbError.Sql(message)
    }
}

// ------------------------------------------------------------ URL parsing

// postgres://user[:password]@host[:port]/database[?sslmode=...&sslrootcert=...]
fn parse_url(url: string) -> Result<PgUrl, DbError> {
    val u = dburl.parse(url, ["postgres://", "postgresql://"], 5432)?
    var sslmode = "disable"
    var sslrootcert = ""
    val mode = dburl.param(u, "sslmode")
    if Option.is_Some(mode) {
        sslmode = Option.unwrap_Some(mode)
    }
    val root = dburl.param(u, "sslrootcert")
    if Option.is_Some(root) {
        sslrootcert = Option.unwrap_Some(root)
    }
    if sslmode != "disable" && sslmode != "prefer" && sslmode != "require" && sslmode != "verify-ca" && sslmode != "verify-full" {
        return err(conn_err(concat("unsupported sslmode (use disable, prefer, require, verify-ca or verify-full): ",
            sslmode)))
    }
    return PgUrl { user: u.user, password: u.password, host: u.host, port: u.port, database: u.database,
        sslmode: sslmode, sslrootcert: sslrootcert }
}

// ---------------------------------------------------------------- SCRAM

// Extracts `key=value` out of a comma-separated SCRAM attribute list.
fn scram_attr(message: string, key: string) -> Option<string> {
    for part in split(message, ",") {
        if starts_with(part, concat(key, "=")) {
            return Option<string>.Some(substring(part, len(key) + 1, len(part)))
        }
    }
    return Option<string>.None
}

fn expect_auth(sock: Socket, code: int) -> Result<Message, DbError> {
    val m = read_message(sock)?
    if m.kind == "E" {
        return err(parse_error(m.body))
    }
    if m.kind != "R" || u32_from_bytes(m.body, 0) != code {
        return err(conn_err(format("unexpected message '{}' during authentication", m.kind)))
    }
    return m
}

// RFC 5802 / RFC 7677, as Postgres implements it: channel binding off
// ("n,,"), the username left empty in the client-first-message (the
// server takes it from the startup packet).
fn scram_sha256(sock: Socket, password: string) -> Result<int, DbError> {
    val nonce = base64_encode(random_bytes(18))
    val client_first_bare = concat("n=,r=", nonce)
    val client_first = concat("n,,", client_first_bare)
    send_message(sock, "p",
        bytes_concat(cstring("SCRAM-SHA-256"), u32_to_bytes(len(client_first)), string_to_bytes(client_first)))?

    val first = expect_auth(sock, 11)?
    val server_first = text_of(first.body, 4, len(first.body))
    val server_nonce = scram_attr(server_first, "r")
    val salt_b64 = scram_attr(server_first, "s")
    val iterations_text = scram_attr(server_first, "i")
    if !Option.is_Some(server_nonce) || !Option.is_Some(salt_b64) || !Option.is_Some(iterations_text) {
        return err(conn_err("malformed SCRAM server-first-message"))
    }
    val combined_nonce = Option.unwrap_Some(server_nonce)
    if !starts_with(combined_nonce, nonce) {
        return err(conn_err("SCRAM server nonce does not extend the client nonce"))
    }
    val salt = base64_decode(Option.unwrap_Some(salt_b64))
    val iterations = parse_int(Option.unwrap_Some(iterations_text))
    if !is_ok(salt) || !is_ok(iterations) {
        return err(conn_err("malformed SCRAM salt or iteration count"))
    }

    val salted = pbkdf2_hmac_sha256(string_to_bytes(password), unwrap(salt), unwrap(iterations), 32)
    val client_key = hmac_sha256(salted, string_to_bytes("Client Key"))
    val stored_key = sha256(client_key)
    val client_final_without_proof = concat("c=biws,r=", combined_nonce)
    val auth_message = string_to_bytes(join(separator: ",",
        pieces: [client_first_bare, server_first, client_final_without_proof]))
    val client_signature = hmac_sha256(stored_key, auth_message)
    val proof = bytes_xor(client_key, client_signature)
    val client_final = concat(client_final_without_proof, concat(",p=", base64_encode(proof)))
    send_message(sock, "p", string_to_bytes(client_final))?

    val final = expect_auth(sock, 12)?
    val server_final = text_of(final.body, 4, len(final.body))
    val verifier = scram_attr(server_final, "v")
    if !Option.is_Some(verifier) {
        return err(conn_err("malformed SCRAM server-final-message"))
    }
    val server_key = hmac_sha256(salted, string_to_bytes("Server Key"))
    val expected = base64_encode(hmac_sha256(server_key, auth_message))
    if Option.unwrap_Some(verifier) != expected {
        return err(conn_err("SCRAM server signature mismatch -- the server did not prove it knows the password"))
    }
    return 0
}

// ------------------------------------------------------------- handshake

fn startup_message(url: PgUrl) -> [byte] {
    val params = bytes_concat(cstring("user"), cstring(url.user), cstring("database"), cstring(url.database),
        cstring("client_encoding"), cstring("UTF8"), [0b])
    return bytes_concat(u32_to_bytes(len(params) + startup_header_bytes), u32_to_bytes(protocol_version_3), params)
}

// Everything after authentication succeeds, up to ReadyForQuery:
// ParameterStatus ('S'), BackendKeyData ('K') and notices ('N') are
// ignored.
fn await_ready(sock: Socket) -> Result<int, DbError> {
    while true {
        val m = read_message(sock)?
        if m.kind == "Z" {
            return 0
        }
        if m.kind == "E" {
            return err(parse_error(m.body))
        }
    }
    return 0
}

// AuthenticationSASL's body is a code, then a list of mechanism names,
// each a cstring, ended by an empty one.
fn sasl_offers(body: [byte], mechanism: string) -> bool {
    var pos = 4
    while pos < len(body) && body[pos] != 0b {
        val end = cstring_end(body, pos)
        if text_of(body, pos, end) == mechanism {
            return true
        }
        pos = end + 1
    }
    return false
}

// SSLRequest (length 8, code 80877103) and the server's one-byte answer:
// 'S' means go ahead with a TLS handshake on this same connection, 'N'
// that the server has no TLS (fine for `prefer`, an error otherwise).
fn negotiate_tls(sock: Socket, url: PgUrl) -> Result<int, DbError> {
    if url.sslmode == "disable" {
        return 0
    }
    lift<int>(net.write(sock, bytes_concat(u32_to_bytes(startup_header_bytes), u32_to_bytes(ssl_request_code))))?
    val reply = lift<[byte]>(net.read_exact(sock, 1))?
    val answer = text_of(reply, 0, 1)
    if answer == "N" {
        if url.sslmode == "prefer" {
            return 0
        }
        return err(conn_err(format("the server does not support TLS (sslmode={})", url.sslmode)))
    }
    if answer != "S" {
        return err(conn_err(format("unexpected reply '{}' to the TLS request", answer)))
    }
    val verify = if url.sslmode == "verify-ca" {
        net.TlsVerify.Chain
    } else if url.sslmode == "verify-full" {
        net.TlsVerify.Full
    } else {
        net.TlsVerify.Off
    }
    val root = if url.sslrootcert != "" { Option<string>.Some(url.sslrootcert) } else { Option<string>.None }
    return lift<int>(net.start_tls_with(sock, url.host, verify, root))
}

fn handshake(sock: Socket, url: PgUrl) -> Result<int, DbError> {
    negotiate_tls(sock, url)?
    lift<int>(net.write(sock, startup_message(url)))?
    val first = read_message(sock)?
    if first.kind == "E" {
        return err(parse_error(first.body))
    }
    if first.kind != "R" {
        return err(conn_err(format("unexpected message '{}' at startup", first.kind)))
    }
    val code = u32_from_bytes(first.body, 0)
    if code == 3 {
        send_message(sock, "p", cstring(url.password))?
        expect_auth(sock, 0)?
    } else if code == 10 {
        if !sasl_offers(first.body, "SCRAM-SHA-256") {
            return err(conn_err("server offers no SASL mechanism this driver supports (only SCRAM-SHA-256)"))
        }
        scram_sha256(sock, url.password)?
        expect_auth(sock, 0)?
    } else if code == 5 {
        return err(conn_err("server requires MD5 password authentication, which this driver does not support"))
    } else if code != 0 {
        return err(conn_err(format("unsupported authentication method (code {})", code)))
    }
    return await_ready(sock)
}

// -------------------------------------------------------------- results

struct RowDesc {
    names: [string]
    oids: [int]
}

fn parse_row_description(body: [byte]) -> RowDesc {
    val count = u16_from_bytes(body, 0)
    val names = ab_new<string>()
    val oids = ab_new<int>()
    var pos = 2
    var i = 0
    while i < count {
        val end = cstring_end(body, pos)
        ab_append<string>(names, text_of(body, pos, end))
        ab_append<int>(oids, u32_from_bytes(body, end + 1 + 6))
        pos = end + 1 + 18
        i = i + 1
    }
    return RowDesc { names: ab_to_array<string>(names), oids: ab_to_array<int>(oids) }
}

// Text-format values, interpreted by the column's type OID: 16 bool,
// 17 bytea, 20/21/23 int8/int2/int4, 700/701 float4/float8. Everything
// else stays Text for the mapping layer.
fn decode_value(oid: int, raw: [byte]) -> Result<SqlValue, DbError> {
    if oid == 17 {
        val hex = text_of(raw, 0, len(raw))
        if !starts_with(hex, "\\x") {
            return err(DbError.Sql("bytea value is not in hex format"))
        }
        val out = ab_new<byte>()
        var i = 2
        while i + 2 <= len(hex) {
            val b = byte_from_hex(substring(hex, i, i + 2))
            if !is_ok(b) {
                return err(DbError.Sql("bad bytea hex digits"))
            }
            ab_append<byte>(out, unwrap(b))
            i = i + 2
        }
        return SqlValue.Bytes(ab_to_array<byte>(out))
    }
    val text = text_of(raw, 0, len(raw))
    if oid == 16 {
        return SqlValue.Bool(text == "t")
    }
    if oid == 20 || oid == 21 || oid == 23 {
        val n = parse_int(text)
        if !is_ok(n) {
            return err(DbError.Sql(concat("bad integer from server: ", text)))
        }
        return SqlValue.Int(unwrap(n))
    }
    if oid == 700 || oid == 701 {
        val f = parse_float(text)
        if is_ok(f) {
            return SqlValue.Float(unwrap(f))
        }
    }
    return SqlValue.Text(text)
}

fn parse_data_row(body: [byte], oids: [int]) -> Result<[SqlValue], DbError> {
    val count = u16_from_bytes(body, 0)
    val values = ab_new<SqlValue>()
    var pos = 2
    var i = 0
    while i < count {
        val length = u32_from_bytes(body, pos)
        pos = pos + 4
        if length == 4294967295 {
            ab_append<SqlValue>(values, SqlValue.Null)
        } else {
            val v = decode_value(oids[i], slice<byte>(body, pos, pos + length))?
            ab_append<SqlValue>(values, v)
            pos = pos + length
        }
        i = i + 1
    }
    return ab_to_array<SqlValue>(values)
}

// "INSERT 0 5" / "UPDATE 3" / "SELECT 2" -> the trailing count; 0 for a
// tag with none ("CREATE TABLE", "BEGIN").
fn affected_rows(tag: string) -> int {
    val words = split(tag, " ")
    val n = parse_int(words[len(words) - 1])
    return if is_ok(n) { unwrap(n) } else { 0 }
}

// Reads server messages until ReadyForQuery. An ErrorResponse doesn't
// stop the read -- the server always finishes with 'Z' -- so the
// connection stays in step for the next request.
fn collect_result(sock: Socket) -> Result<QueryResult, DbError> {
    val rows = ab_new<Row>()
    var names: [string] = []
    var oids: [int] = []
    var affected = 0
    var failure = Option<DbError>.None
    var done = false
    while !done {
        val m = read_message(sock)?
        if m.kind == "Z" {
            done = true
        } else if m.kind == "T" {
            val desc = parse_row_description(m.body)
            names = desc.names
            oids = desc.oids
        } else if m.kind == "D" {
            val values = parse_data_row(m.body, oids)
            if is_ok(values) {
                ab_append<Row>(rows, Row { columns: names, values: unwrap(values) })
            } else if !Option.is_Some(failure) {
                failure = Option<DbError>.Some(unwrap_err(values))
            }
        } else if m.kind == "C" {
            affected = affected_rows(text_of(m.body, 0, cstring_end(m.body, 0)))
        } else if m.kind == "E" {
            if !Option.is_Some(failure) {
                failure = Option<DbError>.Some(parse_error(m.body))
            }
        }
    }
    if Option.is_Some(failure) {
        return err(Option.unwrap_Some(failure))
    }
    return QueryResult { rows: ab_to_array<Row>(rows), affected: affected }
}

// ---------------------------------------------------------------- queries

// A parameter on the wire (length-prefixed; -1 means NULL). Booleans go
// as 1/0, which Postgres accepts for both BOOLEAN and INTEGER columns --
// the same repository SQL and schema then work on SQLite too.
fn encode_param(v: SqlValue) -> [byte] {
    if SqlValue.is_Null(v) {
        return u32_to_bytes(4294967295)
    }
    val text = if SqlValue.is_Int(v) {
        str(SqlValue.unwrap_Int(v))
    } else if SqlValue.is_Float(v) {
        float_to_text(SqlValue.unwrap_Float(v))
    } else if SqlValue.is_Text(v) {
        SqlValue.unwrap_Text(v)
    } else if SqlValue.is_Bool(v) {
        if SqlValue.unwrap_Bool(v) { "1" } else { "0" }
    } else {
        concat("\\x", bytes_to_hex(SqlValue.unwrap_Bytes(v)))
    }
    val payload = string_to_bytes(text)
    return bytes_concat(u32_to_bytes(len(payload)), payload)
}

fn extended_query(sock: Socket, sql: string, params: [SqlValue]) -> Result<QueryResult, DbError> {
    val encoded = ab_new<[byte]>()
    for p in params {
        ab_append<[byte]>(encoded, encode_param(p))
    }
    val bind_body = bytes_concat(cstring(""), cstring(""), u16_to_bytes(0), u16_to_bytes(len(params)),
        concat_arrays<byte>(parts: ab_to_array<[byte]>(encoded)), u16_to_bytes(0))
    val describe_body = bytes_concat(string_to_bytes("P"), cstring(""))
    val execute_body = bytes_concat(cstring(""), u32_to_bytes(0))
    val batch = bytes_concat(
        frame("P", bytes_concat([0b], cstring(sql), u16_to_bytes(0))),
        frame("B", bind_body),
        frame("D", describe_body),
        frame("E", execute_body),
        frame("S", []))
    lift<int>(net.write(sock, batch))?
    return collect_result(sock)
}

fn frame(kind: string, body: [byte]) -> [byte] {
    return bytes_concat(string_to_bytes(kind), u32_to_bytes(len(body) + 4), body)
}

fn run_query(sock: Socket, sql: string, params: [SqlValue]) -> Result<QueryResult, DbError> {
    if len(params) == 0 {
        send_message(sock, "Q", cstring(sql))?
        return collect_result(sock)
    }
    return extended_query(sock, sql, params)
}

// -------------------------------------------------------- owner thread API

fn serve(sock: Socket, requests: Channel<Request>) {
    var open = true
    while open {
        val req = receive(requests)
        if Request.is_Run(req) {
            val r = Request.unwrap_Run(req)
            send(r.reply_to, run_query(sock, r.sql, r.params))
        } else {
            send_message(sock, "X", [])
            net.close(sock)
            open = false
        }
    }
}

// An open Postgres connection: the channel to the thread that owns its
// socket. Opaque to callers -- use `execute`/`query`/`close`.
pub struct Connection {
    requests: Channel<Request>
}

// Connects, authenticates, and starts the thread that owns the socket.
pub fn connect(url: string) -> Result<Connection, DbError> {
    val parsed = parse_url(url)?
    val sock = lift<Socket>(net.connect(parsed.host, parsed.port))?
    val ready = handshake(sock, parsed)
    if !is_ok(ready) {
        net.close(sock)
        return err(unwrap_err(ready))
    }
    val requests: Channel<Request> = channel_new()
    spawn serve(sock, requests)
    return Connection { requests: requests }
}

fn run(conn: Connection, sql: string, params: [SqlValue]) -> Result<QueryResult, DbError> {
    val reply_to: Channel<Result<QueryResult, DbError>> = channel_new()
    send(conn.requests, Request.Run(RunRequest { sql: sql, params: params, reply_to: reply_to }))
    return receive(reply_to)
}

// The number of rows the last statement changed.
pub fn execute(conn: Connection, sql: string, params: [SqlValue]) -> Result<int, DbError> {
    val result = run(conn, sql, params)?
    return result.affected
}

pub fn query(conn: Connection, sql: string, params: [SqlValue]) -> Result<[Row], DbError> {
    val result = run(conn, sql, params)?
    return result.rows
}

pub fn close(conn: Connection) {
    send(conn.requests, Request.Close)
}
