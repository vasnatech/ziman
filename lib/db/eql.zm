// eql.zm -- an **entity query language**: JPQL's shape, over a Ziman struct instead of a Java
// class. A query names entities and their fields, and this module turns it into the SQL those
// names stand for.
//
//     val reg = eql.registry([patient.meta, visit.meta])
//     val q = try eql.translate(reg, "SELECT p FROM Patient p WHERE p.last_name = :name ORDER BY p.created_at DESC")
//     // q.sql       -> SELECT p.id AS id, p.last_name AS last_name, .. FROM patients AS p
//     //                WHERE p.last_name = $1 ORDER BY p.created_at DESC
//     // q.bindings  -> ["name"]
//
// **It is a translator, not an engine.** The answer is a `sql.Statement` and the SQL text that
// tree writes, so everything downstream is what it already was: `datasource` runs the text,
// `memdb` can run it in a test, and `sql.format` decides how it is spelled. Nothing here talks to
// a database -- `eql.list` and friends, which do, are a layer above this one.
//
// ## Why a translation rather than a string you write yourself
//
// Three things the repositories it is for do by hand today, and each is a mistake the type checker
// cannot see:
//
//   - **a field name is just text in a SQL string.** `WHERE last_nmae = $1` compiles, deploys, and
//     fails on the first request. Here a path is resolved against the entity's own column list, so
//     the error arrives at translation and names the entity and what it does have.
//   - **parameters are numbered by hand**, in one function, with the values assembled in another,
//     in the same order. `repository/paging.zm` builds ` AND type IN ($2, $3, ...)` that way, and
//     `service/crud.zm`'s E9 note is about a hand-numbered INSERT "passing 24 parameters to 8
//     holes". Here a parameter has a *name*, `arrange` lays the values out in whatever order the
//     SQL ended up numbering them, and a missing or unused one is an error rather than a shift.
//   - **the column list of a `SELECT *` is implicit**, so a row read by name depends on the
//     engine's column order. `SELECT p` expands to the entity's own columns, each aliased to its
//     bare name, which is what `<name>_from_row` reads by.
//
// ## How it works, and why at the token level
//
// The lexer is `sql.tokenize`, and the rewrite happens on the token run: entity names become
// tables, `alias.field` is checked and passed through, `:name` becomes `$N`. **A text-level
// substitution could not do this correctly** -- a `:` inside a quoted string or a `--` comment is
// text and not a parameter, and only the lexer knows the difference. The rewritten run is then
// handed to `sql.parse`, so the output is checked by the SQL parser before it can reach a
// database, and anything the expression grammar already reads -- `CASE`, `BETWEEN`, `IN`,
// subqueries, function calls, `CAST` -- works here without this module knowing it exists.
//
// ## What it reads
//
// `SELECT` (an alias on its own, or any expression over paths, aliases and literals, with
// `AS` names), `FROM Entity alias` with more entities after a comma, `[INNER|LEFT|RIGHT|FULL|
// CROSS] JOIN Entity alias [ON ..|USING (..)]`, `WHERE`, `GROUP BY`, `HAVING`, `ORDER BY` with
// `ASC`/`DESC`, `LIMIT` and `OFFSET`. Named parameters are `:name`; the SQL forms `?` and `$1` are
// refused, because a query that mixes the two numbering schemes is a bug waiting for a reader.
//
// ## What it does not read, and what that costs
//
// **No associations.** The entities this was built for declare no relationships -- a `patient_id`
// is a `Uuid` field, not a reference -- so there are no path expressions across entities
// (`v.patient.last_name`) and no fetch joins. A join names the second entity and its condition
// explicitly, which is what the repositories write today. Adding relationships is a modelling
// increment of its own, and the one that brings the N+1 question with it.
//
// **No `SELECT new Dto(..)`**: a projection answers rows, and the caller reads them.
//
// **`DELETE` is translated and `UPDATE` is not**, which is a line drawn by what each one needs
// rather than by how much work it is. A bulk delete is a `WHERE` over one entity and nothing else,
// so it is the same translation a `SELECT`'s `WHERE` already gets, and the reason to write it here
// is the same: a misspelt `v.patinet_id` fails when the module loads rather than on the request
// that would have run it. A bulk update additionally needs a `SET` list, which is the half that has no entity to check it
// against -- and a one-row update is `eql.update_one`, which builds its statement from the
// entity's own columns and so cannot disagree with them at all. There is nothing an
// `UPDATE .. SET ..` entity query would add except a second way to get a column list wrong.
//
// **No implicit joins, no `FETCH`, no `TREAT`, no polymorphism** -- there is no inheritance
// between entity structs to be polymorphic over.
#![experimental]
use datasource
use db
use db.DbError
use db.Row
use db.SqlValue
use locale
use sql
use sql.Statement
use sql.Token
use time
use time.Duration
use time.Instant
use time.LocalDate
use time.LocalDateTime
use time.LocalTime
use time.ZoneId
use time.ZoneOffset
use uuid.Uuid
use uuid.uuid_to_sql

// One entity: the name a query calls it, the table it is stored in, and its columns.
//
// The columns are `#[derive(Entity)]`'s `<name>_columns`. **They were the struct's own field list,
// so what a query may name and what `from_row` reads were the same list by construction** -- and a
// field carrying `#[column(name: "..")]` makes them two lists (2026-10-29), which is what `fields`
// below pairs. Everything a *reader* writes is still the field: a query says `e.start`, this maps
// it to `start_date`, and the column name appears in the SQL and in the attribute and nowhere
// else. The table is hand-written beside the struct, because no pluralisation rule survives a real
// schema -- see the derive's own comment.
pub struct Entity {
    name: string
    table: string
    columns: [string]
    // The columns that identify one row, in field order: the fields marked `#[pk]`.
    //
    // **Empty is allowed and means "no key was declared"**, not "the first column". A reader that
    // needs one -- anything addressing a single row -- refuses an empty `keys` by name rather than
    // guessing, because the guess was right for all 27 entities in the North Star application and
    // would have been silently wrong for the first table that is keyed on something else.
    //
    // More than one is a compound key, which is simply two fields marked. Nothing here objects to
    // that; a *reader* that can only address a single-column key is the thing that has to say so.
    keys: [string]
    // The struct field each column belongs to, in the same order -- what a *query* names where
    // `columns` is what the *database* has.
    //
    // **Equal to `columns` unless a field carries `#[column(name: "..")]`** (2026-10-29), and the
    // paragraph above this struct is why that matters: field name, column name, what a query may
    // write and what `from_row` reads were one list "by construction", and an override makes them
    // two. So a query still says `e.start`, this pairs it with `start_date`, and the column name
    // appears in the SQL and nowhere a reader of the struct has to think about it.
    //
    // The two lists are parallel. Nothing here enforces that, because the only thing that builds a
    // mismatched pair is a caller writing one by hand, and `column_for` falls back to the field's
    // own name rather than reading past the end of `columns`.
    fields: [string]
}

// An entity with no declared key, for a caller that only names columns.
//
// **The field names are the column names**, which is the case every caller had before an override
// existed and still the overwhelmingly common one: a query names what the struct spells.
pub fn entity(name: string, table: string, columns: [string]) -> Entity {
    val none: [string] = []
    return Entity { name: name, table: table, columns: columns, keys: none, fields: columns }
}

// The same where a field is stored in a column of another name: `fields` pairs with `columns`,
// position by position. What `#[derive(Entity("table"))]` writes when any field carries
// `#[column(name: "..")]`.
pub fn entity(name: string, table: string, columns: [string], fields: [string]) -> Entity {
    val none: [string] = []
    return Entity { name: name, table: table, columns: columns, keys: none, fields: fields }
}

// An entity and the columns that identify one of its rows. What `#[derive(Entity("table"))]`
// writes when the struct marks a field `#[pk]`.
pub fn keyed_entity(name: string, table: string, columns: [string], keys: [string]) -> Entity {
    return Entity { name: name, table: table, columns: columns, keys: keys, fields: columns }
}

// Keyed, and with a field-to-column pairing. `keys` are **column** names, as they are in the form
// above: they go into SQL, and `update_one` compares them against `columns`.
pub fn keyed_entity(
    name: string,
    table: string,
    columns: [string],
    keys: [string],
    fields: [string]
) -> Entity {
    return Entity { name: name, table: table, columns: columns, keys: keys, fields: fields }
}

// The entities a program has, and the only thing here that knows one exists -- the same shape as
// `datasource.registry`, and for the same reason: this module names no entity, so an application
// that has three hands over three.
pub struct Registry {
    // **Keyed on the folded name**, because SQL identifiers are case-insensitive and every lookup
    // folds what it was given. Folding happens once per entity here instead of once per entity per
    // comparison, which is what a linear scan over this was doing.
    by_name: Map<string, Entity>
    // The names as they were registered, in order, for the refusal message. The keys above are
    // folded and a map has no order, so "registered: vitalsign, bodymeasurement" is neither what
    // the caller wrote nor the order they wrote it in.
    names: [string]
}

pub fn registry(entities: [Entity]) -> Registry {
    val by_name = mutable_map_new<string, Entity>()
    val names = mutable_array_new<string>()
    for e in entities {
        val key = sql.fold_name(e.name)
        // **The first of a repeated name wins, as the scan did.** Registering two entities under
        // one name is a caller mistake and this cannot refuse it -- `registry` answers a `Registry`
        // and not a `Result` -- so the one thing it can do is not quietly change *which* of them a
        // query resolves to.
        if !contains(by_name, key) {
            set(by_name, key, e)
            push(names, e.name)
        }
    }
    return Registry { by_name: snapshot(by_name), names: snapshot(names) }
}

// A named parameter's value, or the values of a collection one.
//
// A collection is its own kind rather than an array of `SqlValue` everywhere, because the two
// cannot be told apart by looking: `:ids` bound to one value and `:ids` bound to a list of one are
// different queries, and only the binding knows which was meant.
pub struct Binding {
    name: string
    value: SqlValue
    values: [SqlValue]
    list: bool
}

pub fn bind(name: string, value: SqlValue) -> Binding {
    val none: [SqlValue] = []
    return Binding { name: name, value: value, values: none, list: false }
}

// **The conversion to `SqlValue` belongs here, not at the call site.** Every one of these is the
// one conversion its type has -- `uuid_to_sql` for a `Uuid`, `time.to_sql` for an instant -- so
// writing it out at the call site was never a choice being made, only a step that could be
// forgotten or, worse, got right in a way the reader has to re-verify. What a binding list looked
// like before was `[bind("id", uuid_to_sql(id)), bind("patient_id", uuid_to_sql(patient_id))]`,
// where the names and the values are what the reader is checking and `uuid_to_sql` is in the way
// of both.
//
// The `SqlValue` overload above stays, and is the escape hatch: a value whose SQL representation is
// a decision rather than a convention -- a decimal as text at a chosen scale, an `Option` as
// `Null` or not -- says so by constructing the `SqlValue` itself. These overloads deliberately do
// not cover `Option<T>`, because "absent means NULL" is exactly such a decision.
pub fn bind(name: string, value: int) -> Binding {
    return bind(name, SqlValue.Int(value))
}

pub fn bind(name: string, value: float) -> Binding {
    return bind(name, SqlValue.Float(value))
}

pub fn bind(name: string, value: string) -> Binding {
    return bind(name, SqlValue.Text(value))
}

pub fn bind(name: string, value: bool) -> Binding {
    return bind(name, SqlValue.Bool(value))
}

pub fn bind(name: string, value: [byte]) -> Binding {
    return bind(name, SqlValue.Bytes(value))
}

pub fn bind(name: string, value: Uuid) -> Binding {
    return bind(name, uuid_to_sql(value))
}

pub fn bind(name: string, value: Instant) -> Binding {
    return bind(name, time.to_sql(value))
}

pub fn bind(name: string, value: LocalDate) -> Binding {
    return bind(name, time.to_sql(value))
}

pub fn bind(name: string, value: LocalTime) -> Binding {
    return bind(name, time.to_sql(value))
}

pub fn bind(name: string, value: LocalDateTime) -> Binding {
    return bind(name, time.to_sql(value))
}

pub fn bind(name: string, value: Duration) -> Binding {
    return bind(name, time.to_sql(value))
}

pub fn bind(name: string, value: ZoneOffset) -> Binding {
    return bind(name, time.to_sql(value))
}

pub fn bind(name: string, value: ZoneId) -> Binding {
    return bind(name, time.to_sql(value))
}

// A collection parameter, for `IN :names`.
//
// **An empty list is refused rather than guessed at.** `x IN ()` is not SQL, and every spelling
// that is has the wrong answer for one of the two directions: `IN (NULL)` is unknown rather than
// false, and `NOT IN (NULL)` is unknown rather than true. A caller that can have an empty filter
// knows what it means by one -- usually "match nothing", which is an answer it can give without a
// round trip -- so it says so at the call site instead of here.
pub fn bind_list(name: string, values: [SqlValue]) -> Binding {
    return Binding { name: name, value: SqlValue.Null, values: values, list: true }
}

// The same conversion `bind` does, for a collection. **Three types rather than `bind`'s thirteen**,
// and the asymmetry is deliberate: a collection parameter is an `IN` list, and what a query filters
// a set of rows by is identifiers, numbers or text. `IN` over a list of durations or zone offsets
// is not a shape any query here has, so it is not guessed at -- the `[SqlValue]` overload above
// takes one if it ever is.
pub fn bind_list(name: string, values: [string]) -> Binding {
    val out = mutable_array_new<SqlValue>()
    for v in values {
        push(out, SqlValue.Text(v))
    }
    return bind_list(name, snapshot(out))
}

pub fn bind_list(name: string, values: [int]) -> Binding {
    val out = mutable_array_new<SqlValue>()
    for v in values {
        push(out, SqlValue.Int(v))
    }
    return bind_list(name, snapshot(out))
}

pub fn bind_list(name: string, values: [Uuid]) -> Binding {
    val out = mutable_array_new<SqlValue>()
    for v in values {
        push(out, uuid_to_sql(v))
    }
    return bind_list(name, snapshot(out))
}

// One collection size's translation, kept so that the second call with the same size does not
// translate again.
//
// **A value rather than a cache**, which is what makes it safe here: `eql` sits above the
// connection and has nowhere to keep per-connection state, module-level mutable state is refused,
// and Ziman has no mutex -- so a shared mutable cache would be both unreachable and unsound. These
// are computed once by `translate` and are thereafter immutable, so every thread may read them.
struct Shaped {
    key: string
    sql: string
    bindings: [string]
}

// How many collection sizes `translate` works out in advance.
//
// Measured: `prepare` costs **2 microseconds** for a static query, which reuses the one
// translation, and **227** for one with a collection, which re-translates because the number of
// placeholders is the number of values. Against a 300-3,000 microsecond round trip that is 7 to 43%
// of a request, spent on an answer that depends on nothing but a count.
//
// Eight because an `IN` list written by hand is a handful of values -- the health-record backend's
// widest category maps to six types -- and because each size costs one translation at startup:
// eight is under two milliseconds per query, once. A size past the eighth still works and still
// translates per call, which is the old behaviour rather than a failure.
val eager_sizes: int = 8

// The sizes a call bound, as a key. Ordered by `lists`, which the translator fixed, so the same
// sizes always render the same key.
fn sizes_key(lists: [string], sizes: Map<string, int>) -> string {
    val out = mutable_string_new()
    for name in lists {
        append(out, name, "=", str(get_or(sizes, name, 0)), ";")
    }
    return snapshot(out)
}

// What a query became: the SQL to send, the tree it parsed into, and the parameter names in the
// order the SQL numbers them.
//
// It also keeps the query and the registry it came from, because a **collection parameter's** SQL
// depends on how many values are bound -- `IN :types` is three placeholders for three values --
// and that is not known until the call. A query with no collection parameter is translated once and
// its `sql` is used as it stands; one with a collection is re-translated per call, which costs the
// 140-300 microseconds `translate` costs and is still a fraction of the round trip it saves
// hand-numbering for. `lists` is how `prepare` tells the two apart.
pub struct Translated {
    sql: string
    statement: Statement
    bindings: [string]
    lists: [string]
    query: string
    registry: Registry
    // The sizes already worked out, for a query with a collection parameter. See `Shaped`.
    shaped: [Shaped]
}

fn problem(message: string) -> DbError {
    return DbError.Sql(message)
}

// One entry of the `FROM`: the alias a query gave an entity.
struct Bound {
    alias: string
    entity: Entity
}

fn entity_named(reg: Registry, name: string) -> Result<Entity, DbError> {
    if Some(e) = get(reg.by_name, sql.fold_name(name)) {
        return e
    }
    if prelude.len(reg.names) == 0 {
        return err(problem(concat("no entities are registered, so '", name, "' cannot be resolved")))
    }
    return err(problem(prelude.format(
        "no registered entity is called '{}' (registered: {})",
        name,
        join(separator: ", ", pieces: reg.names)
    )))
}

fn bound_for(binds: [Bound], alias: string) -> Option<Bound> {
    val want = sql.fold_name(alias)
    for b in binds {
        if sql.fold_name(b.alias) == want {
            return Option<Bound>.Some(b)
        }
    }
    return Option<Bound>.None
}

// The column a query's `alias.field` refers to, with an error naming what the entity does have --
// which is the whole point of translating rather than writing the SQL by hand.
//
// **A query names a field and SQL names a column**, and they differ only for a field carrying
// `#[column(name: "..")]`. Matching is on `fields` and the answer is from `columns`, so the
// mapping happens in the one place a path is resolved.
fn column_for(e: Entity, field: string) -> Result<string, DbError> {
    val want = sql.fold_name(field)
    for i in 0..prelude.len(e.fields) {
        if sql.fold_name(e.fields[i]) != want {
            continue
        }
        // Parallel by construction; the field's own name rather than a read past the end.
        if i < prelude.len(e.columns) {
            return ok(e.columns[i])
        }
        return ok(e.fields[i])
    }
    return err(problem(prelude.format(
        "entity {} has no field '{}' (it has: {})",
        e.name,
        field,
        join(separator: ", ", pieces: e.fields)
    )))
}

// The words that end a `FROM`/`JOIN` entry, so an entity's alias is not mistaken for one.
// The words that end a `FROM` list, so a comma after one is a select item's comma and not another
// entity's.
val from_enders: Set<string> = to_set([
    "WHERE", "GROUP", "HAVING", "ORDER", "LIMIT", "OFFSET", "ON", "USING", "UNION", "INTERSECT",
    "EXCEPT"
])

val clause_enders: Set<string> = to_set([
    "WHERE", "GROUP", "HAVING", "ORDER", "LIMIT", "OFFSET", "JOIN", "INNER", "LEFT", "RIGHT",
    "FULL", "CROSS", "OUTER", "ON", "USING", "AS"
])

fn is_name(t: Token) -> bool {
    return t.kind == "name"
}

// Every `FROM`/`JOIN` entry's entity and alias, resolved against the registry.
//
// Read in a pass of its own, before anything is emitted, because a path may name an alias the
// `FROM` introduces *after* it: `SELECT v.reason FROM Visit v` reads `v` before the line that
// binds it.
fn bindings_of(reg: Registry, tokens: [Token]) -> Result<[Bound], DbError> {
    val out = mutable_array_new<Bound>()
    var i = 0
    while i < prelude.len(tokens) {
        val t = tokens[i]
        var entry = false
        if is_name(t) && (t.upper == "FROM" || t.upper == "JOIN") {
            entry = true
        }
        // **A parameter named after a clause keyword is a parameter.** `:from` and `:to` are the
        // obvious names for a date range, and this loop walks tokens without consuming `:name`
        // pairs the way the rewriter does -- so `WHERE d >= :from AND ..` read `from` as a FROM
        // clause and went looking for an entity after it. The error was
        // "no registered entity is called 'AND'", which names nothing the caller wrote.
        if i > 0 && tokens[i - 1].kind == "punct" && tokens[i - 1].text == ":" {
            entry = false
        }
        if !entry {
            i = i + 1
            continue
        }
        // `FROM Entity alias` and `FROM Entity alias, Entity alias`, so the loop keeps reading
        // entries while commas separate them.
        var more = true
        i = i + 1
        while more {
            more = false
            if i >= prelude.len(tokens) || !is_name(tokens[i]) {
                return err(problem("expected an entity name after FROM or JOIN"))
            }
            val e = try entity_named(reg, tokens[i].text)
            i = i + 1
            if i < prelude.len(tokens) && is_name(tokens[i]) && tokens[i].upper == "AS" {
                i = i + 1
            }
            if i >= prelude.len(tokens) || !is_name(tokens[i]) || contains(clause_enders, tokens[i].upper) {
                return err(problem(prelude.format(
                    "entity {} needs an alias: write `{} {}` and refer to its fields through it",
                    e.name,
                    e.name,
                    to_lower(e.name, sql_locale())
                )))
            }
            val alias = tokens[i].text
            if Some(already) = bound_for(snapshot(out), alias) {
                return err(problem(prelude.format(
                    "the alias '{}' is already bound to {}",
                    alias,
                    already.entity.name
                )))
            }
            push(out, Bound { alias: alias, entity: e })
            i = i + 1
            if i < prelude.len(tokens) && tokens[i].kind == "punct" && tokens[i].text == "," {
                i = i + 1
                more = true
            }
        }
    }
    if prelude.len(out) == 0 {
        return err(problem("a query needs a FROM naming at least one entity"))
    }
    return ok(snapshot(out))
}

// Case folding for an entity or field name is protocol folding, so it names the invariant locale
// for the same reason `sql` does: in Turkish, `I` folds to `ı`.
fn sql_locale() -> Locale {
    return locale.root()
}

// `alias.column AS column, ...` -- what an alias on its own in the select list stands for.
//
// Each column is aliased to its bare name because `<name>_from_row` reads a row **by name**
// through `row_get`, and a joined query can otherwise answer two columns called `id`.
fn expanded(b: Bound) -> string {
    val out = mutable_array_new<string>()
    for c in b.entity.columns {
        push(out, prelude.format("{}.{} AS {}", b.alias, c, c))
    }
    return join(separator: ", ", pieces: snapshot(out))
}

// A token written back as SQL text. Only the shapes `sql.tokenize` produces need a case here, and
// a `text` token has to be re-quoted, since the lexer took its quotes off.
fn written(t: Token) -> string {
    if t.kind == "text" {
        return concat("'", replace(t.text, "'", "''"), "'")
    }
    return t.text
}

// Whether `before` and `now` want a space between them. Punctuation mostly does not; two names
// always do, or `SELECT p` would come out as `SELECTp`.
fn spaced(before: Token, now: Token) -> bool {
    if before.kind == "punct" {
        if before.text == "(" || before.text == "." {
            return false
        }
    }
    if now.kind == "punct" {
        if now.text == ")" || now.text == "," || now.text == "." || now.text == ";" {
            return false
        }
        if now.text == "(" {
            // `count(` stays joined; `IN (` reads better apart, and either parses.
            return !is_name(before)
        }
    }
    return true
}

// A query translated: entity names become tables, paths are checked, `:name` becomes `$N`, and an
// alias on its own becomes the entity's columns.
pub fn translate(reg: Registry, query: string) -> Result<Translated, DbError> {
    val no_sizes: Map<string, int> = Map<string, int> {}
    val base = try translate_sized(reg, query, no_sizes)
    // **Only for a query with exactly one collection**, which is every one anybody writes. With
    // two the sizes are a cross product and working them all out in advance would cost 64
    // translations for a saving nothing has asked for; such a query translates per call, as before.
    if prelude.len(base.lists) != 1 {
        return ok(base)
    }
    val name = base.lists[0]
    val shaped = mutable_array_new<Shaped>()
    for n in 1..(eager_sizes + 1) {
        val sizes = mutable_map_new<string, int>()
        set(sizes, name, n)
        val fixed = snapshot(sizes)
        val variant = try translate_sized(reg, query, fixed)
        push(shaped, Shaped { key: sizes_key(base.lists, fixed), sql: variant.sql, bindings: variant.bindings })
    }
    return ok(with base { shaped: snapshot(shaped) })
}

// **A DELETE names one entity, and must say which rows.** Both refusals are about what the thing
// would otherwise do rather than about taste.
//
// One entity, because a multi-table delete is spelled differently by every engine -- `USING` in
// PostgreSQL, a table list before `FROM` in MySQL, a subquery in SQLite -- so there is no single
// SQL for this layer to produce.
//
// And a `WHERE`, because without one the statement empties the table. `delete_where` refuses an
// empty predicate for the same reason, and `delete_all` is the spelling that means it: a `DELETE`
// that came out unfiltered should never be the shape a filter collapsed into.
fn deletable(binds: [Bound], tokens: [Token]) -> Result<unit, DbError> {
    if prelude.len(binds) != 1 {
        val names = mutable_array_new<string>()
        for b in binds {
            push(names, b.entity.name)
        }
        return err(problem(prelude.format(
            "a DELETE names one entity and this names {} ({}) -- a multi-table delete has no portable SQL, so it is not translated here",
            prelude.len(binds),
            join(separator: ", ", pieces: snapshot(names))
        )))
    }
    for t in tokens {
        if is_name(t) && t.upper == "WHERE" {
            return ok(unit)
        }
    }
    return err(problem(
        "a DELETE with no WHERE would empty the table -- `eql.delete_all` is the spelling that says so, and this layer will not have a filter collapse into it"
    ))
}

// The translation, with the size of each collection parameter where it is known.
//
// Called twice for a query that has one: once by `translate` with nothing known, to learn the
// query's shape and which parameters are collections, and again by `prepare` once the values are
// in hand and the placeholder count is settled.
fn translate_sized(reg: Registry, query: string, sizes: Map<string, int>) -> Result<Translated, DbError> {
    val tokens = try sql.tokenize(query)
    if prelude.len(tokens) == 0 {
        return err(problem("an empty query"))
    }
    if !is_name(tokens[0]) {
        return err(problem("an entity query starts with SELECT or DELETE"))
    }
    val deleting = tokens[0].upper == "DELETE"
    if !deleting && tokens[0].upper != "SELECT" {
        return err(problem(
            "an entity query starts with SELECT or DELETE -- a one-row INSERT or UPDATE is `eql.insert_one` / `eql.update_one`, which build their statement from the entity rather than from a query"
        ))
    }
    if deleting && (prelude.len(tokens) < 2 || !is_name(tokens[1]) || tokens[1].upper != "FROM") {
        return err(problem(
            "a DELETE is written `DELETE FROM Entity alias WHERE ..` -- the row list some engines allow between DELETE and FROM is spelled differently by each of them"
        ))
    }
    val binds = try bindings_of(reg, tokens)
    if deleting {
        try deletable(binds, tokens)
    }
    val out = mutable_string_new()
    val order = mutable_array_new<string>()
    val lists = mutable_array_new<string>()
    val seen = mutable_map_new<string, int>()
    var next_number = 1
    // Where the select list ends, so an alias on its own is expanded there and nowhere else. A
    // DELETE has no select list, so it starts outside one: an alias standing for the entity's
    // columns is a projection, and a DELETE projects nothing.
    var in_select = !deleting
    // Inside a `FROM` or `JOIN` list, where a comma introduces another entity rather than another
    // select item. Without this the second entity of `FROM Patient p, Visit v` kept its entity
    // name in the SQL, which the `eql` tests caught on their first run.
    var in_from = false
    var at_entity = false
    var i = 0
    while i < prelude.len(tokens) {
        val t = tokens[i]
        if i > 0 && spaced(tokens[i - 1], t) {
            append(out, " ")
        }
        if is_name(t) {
            if t.upper == "FROM" {
                in_select = false
            }
            if t.upper == "FROM" || t.upper == "JOIN" {
                at_entity = true
                in_from = true
                append(out, t.text)
                i = i + 1
                continue
            }
            if contains(from_enders, t.upper) {
                in_from = false
            }
            if at_entity {
                // An entity name, which becomes its table; the alias after it is written as the
                // SQL alias it already is.
                val e = try entity_named(reg, t.text)
                append(out, e.table)
                at_entity = false
                i = i + 1
                // **The alias is dropped from a DELETE's SQL, where a SELECT keeps it.** Measured,
                // not assumed: memdb refuses `DELETE FROM t AS x` with "unexpected 'AS' after the
                // statement" while SQLite accepts it, so the bare form is the only one all four
                // engines take. The alias is still required in the entity query -- it is what makes
                // `v.patient_id` a field this layer can check -- it just does not survive into SQL,
                // where a single-table delete has nothing to qualify against anyway.
                if deleting {
                    if i < prelude.len(tokens) && is_name(tokens[i]) && tokens[i].upper == "AS" {
                        i = i + 1
                    }
                    if i < prelude.len(tokens) && is_name(tokens[i]) {
                        i = i + 1
                    }
                }
                continue
            }
        }
        if t.kind == "punct" && t.text == "," && in_from {
            at_entity = true
            append(out, ",")
            i = i + 1
            continue
        }
        if t.kind == "punct" && t.text == "," && at_entity {
            append(out, ",")
            i = i + 1
            continue
        }
        // A path: `alias.field`, checked against the alias's entity -- and `alias.*`, which is
        // the entity's columns, the same as the alias on its own.
        //
        // **A dotted name whose left side is not an alias is a mistake**, not a table reference:
        // every table here is reached through an entity's alias, so `q.id` where nothing binds `q`
        // is the typo this layer exists to catch. Passing it through would have produced SQL that
        // a database refuses later and further away.
        if is_name(t) && i + 1 < prelude.len(tokens) && tokens[i + 1].kind == "punct" &&
            tokens[i + 1].text == "." {
            val star = tokens[i + 2].kind == "punct" && tokens[i + 2].text == "*"
            if is_name(tokens[i + 2]) || star {
                val found = bound_for(binds, t.text)
                if Some(b) = found {
                    if star {
                        if deleting {
                            return err(problem(prelude.format(
                                "'{}.*' is a projection and a DELETE has none -- name the rows in a WHERE instead",
                                t.text
                            )))
                        }
                        append(out, expanded(b))
                    } else {
                        val column = try column_for(b.entity, tokens[i + 2].text)
                        // The qualifier goes with the alias it refers to; see the entity branch.
                        if deleting {
                            append(out, column)
                        } else {
                            append(out, b.alias, ".", column)
                        }
                    }
                    i = i + 3
                    continue
                }
                val aliases = mutable_array_new<string>()
                for b in binds {
                    push(aliases, b.alias)
                }
                return err(problem(prelude.format(
                    "nothing in this query binds the alias '{}' (it binds: {})",
                    t.text,
                    join(separator: ", ", pieces: snapshot(aliases))
                )))
            }
        }
        // An alias on its own in the select list: the entity's columns.
        //
        // **Except right after `AS`, where a name is a label.** `SELECT count(*) AS n FROM
        // Notification n` uses `n` for both the count's column name and the entity, and the label
        // was expanded into the entity's column list -- producing
        // `SELECT count(*) AS n.id AS id, ..` and an error about a '.' the caller never wrote. The
        // collision is avoidable by choosing another alias, but a label is not an alias in any
        // query, so the translator should not read one as the other.
        if in_select && is_name(t) && !(i >= 1 && is_name(tokens[i - 1]) && tokens[i - 1].upper == "AS") {
            if Some(b) = bound_for(binds, t.text) {
                append(out, expanded(b))
                i = i + 1
                continue
            }
        }
        // A named parameter. The same name twice is the same number, which is what makes
        // `:patient_id` usable in two places.
        if t.kind == "punct" && t.text == ":" {
            if i + 1 >= prelude.len(tokens) || !is_name(tokens[i + 1]) {
                return err(problem("expected a parameter name after ':'"))
            }
            val name = tokens[i + 1].text
            // A collection parameter is the one written after `IN`, and it stands for as many
            // placeholders as there are values. `sizes` is empty on the first translation, so one
            // placeholder is emitted then and the query is translated again once the count is
            // known -- which is what `lists` tells `prepare` to do.
            var width = 1
            var is_list = false
            if i >= 1 && is_name(tokens[i - 1]) && tokens[i - 1].upper == "IN" {
                is_list = true
                width = 1
                if Some(n) = get(sizes, name) {
                    width = n
                }
                if !contains(lists, name) {
                    push(lists, name)
                }
            }
            var number = next_number
            if Some(already) = get(seen, name) {
                number = already
            } else {
                set(seen, name, number)
                push(order, name)
                next_number = next_number + width
            }
            if is_list {
                // The parentheses are the translator's, because `IN :types` has none and SQL's
                // `IN` needs them.
                val holes = mutable_array_new<string>()
                for k in 0..width {
                    push(holes, concat("$", str(number + k)))
                }
                append(out, "(", join(separator: ", ", pieces: snapshot(holes)), ")")
            } else {
                append(out, "$", str(number))
            }
            i = i + 2
            continue
        }
        if t.kind == "param" {
            return err(problem(prelude.format(
                "an entity query's parameters are named, so write ':name' rather than '{}'",
                t.text
            )))
        }
        // Anything else is SQL the expression grammar already reads, passed through: a literal, an
        // operator, a function name, a keyword.
        append(out, written(t))
        i = i + 1
    }
    val text = snapshot(out)
    // Parsed before it is answered, so a translation that produced something the SQL grammar does
    // not accept is reported here rather than by a database.
    val statement = switch sql.parse(text) {
        Ok(s) { s }
        Err(e) { return err(problem(concat(db_message(e), " -- in the SQL this query became: ", text))) }
    }
    val nothing_yet: [Shaped] = []
    return ok(Translated {
        sql: sql.format(statement),
        statement: statement,
        bindings: snapshot(order),
        lists: snapshot(lists),
        query: query,
        registry: reg,
        shaped: nothing_yet
    })
}

fn db_message(e: DbError) -> string {
    return switch e {
        NotFound(m) { m }
        Constraint(m) { m }
        Connection(m) { m }
        Sql(m) { m }
    }
}

// The bound values in the order the translated SQL numbers them.
//
// **This is the half that removes the hand-numbering.** A caller binds by name, in any order, and
// a name the query does not use -- or one it uses and nothing bound -- is an error here, where the
// hand-written form silently shifted every later parameter by one.
pub fn arrange(t: Translated, bound: [Binding]) -> Result<[SqlValue], DbError> {
    return arrange_names(t.bindings, bound)
}

// The values for a parameter order, which for a collection query is the order of the *sized*
// translation rather than of the one `translate` answered.
fn arrange_names(names: [string], bound: [Binding]) -> Result<[SqlValue], DbError> {
    val out = mutable_array_new<SqlValue>()
    for name in names {
        var found = Option<Binding>.None
        for b in bound {
            if b.name == name {
                found = Option<Binding>.Some(b)
            }
        }
        if Some(b) = found {
            // A collection's values go in where its placeholders are, in order.
            if b.list {
                for v in b.values {
                    push(out, v)
                }
            } else {
                push(out, b.value)
            }
        } else {
            // **What was bound is named too**, because the usual cause of a missing binding is a
            // misspelled one, and the two names side by side diagnose it at a glance where either
            // alone leaves the reader looking.
            val given = mutable_array_new<string>()
            for b in bound {
                push(given, b.name)
            }
            return err(problem(prelude.format(
                "the query names :{} and nothing was bound to it (bound: {})",
                name,
                if prelude.len(bound) == 0 { "nothing" } else {
                    join(separator: ", ", pieces: snapshot(given))
                }
            )))
        }
    }
    for b in bound {
        if !contains(names, b.name) {
            return err(problem(prelude.format(
                "nothing in the query names :{} (it names: {})",
                b.name,
                if prelude.len(names) == 0 { "no parameters" } else {
                    join(separator: ", ", pieces: names)
                }
            )))
        }
    }
    return ok(snapshot(out))
}

// The SQL to send and the values to send with it.
//
// For a query with no collection parameter this is `t.sql` as it stands and the values laid out by
// `arrange` -- the translation was done once and is reused. For one with a collection it is a
// second translation, now that the number of values is known, because `IN :types` is three
// placeholders for three values and one for one. That costs what a translation costs and still
// beats what it replaces: a hand-built ` AND type IN ($2, $3, ...)` in one function with the
// values assembled in another.
pub fn prepare(query: Translated, bound: [Binding]) -> Result<Prepared, DbError> {
    if prelude.len(query.lists) == 0 {
        return ok(Prepared { sql: query.sql, params: try arrange(query, bound) })
    }
    val sizes = mutable_map_new<string, int>()
    for b in bound {
        if b.list {
            if prelude.len(b.values) == 0 {
                return err(problem(prelude.format(
                    "nothing was bound to the collection :{}, and `IN ()` is not SQL -- decide what an empty filter means at the call site (usually: answer nothing without asking the database)",
                    b.name
                )))
            }
            set(sizes, b.name, prelude.len(b.values))
        }
    }
    for name in query.lists {
        if !contains(sizes, name) {
            return err(problem(prelude.format(
                "the query names the collection :{} after IN, so it needs eql.bind_list(\"{}\", ..) rather than eql.bind",
                name,
                name
            )))
        }
    }
    // The sizes `translate` already worked out. A hit is the whole point of this layer: the second
    // call with a three-item `IN` list does no translating at all.
    val fixed = snapshot(sizes)
    val key = sizes_key(query.lists, fixed)
    for variant in query.shaped {
        if variant.key == key {
            return ok(Prepared { sql: variant.sql, params: try arrange_names(variant.bindings, bound) })
        }
    }
    val sized = try translate_sized(query.registry, query.query, fixed)
    return ok(Prepared { sql: sized.sql, params: try arrange(sized, bound) })
}

// One call's SQL and values.
pub struct Prepared {
    sql: string
    params: [SqlValue]
}

// ---------------------------------------------------------------- running one

// Running a translated query. **Each of these takes a `Translated`, not a query string**, and the
// reason is measured: translating costs 140 to 300 microseconds (tokenise, rewrite, parse,
// format), against 300 to 3,000 for a PostgreSQL round trip. Translating per call would add
// between a tenth and the whole of a fast query's cost for an answer that never changes, so a
// repository translates **once**, in a module-level `val`, and runs it many times:
//
//     val by_last_name = unwrap(eql.translate(reg, "SELECT p FROM Patient p WHERE p.last_name = :name"))
//
//     pub fn find_by_last_name(conn: datasource.Connection, name: string) -> Result<[Patient], DbError> {
//         return eql.list<Patient>(conn, by_last_name, [eql.bind("name", SqlValue.Text(name))], patient_from_row)
//     }
//
// A one-off is still one line -- `eql.list(conn, try eql.translate(reg, q), binds, from_row)` --
// it just says what it is paying for.
//
// `from_row` is passed at the call site rather than carried by the entity, because a `Registry`
// holding `fn(Row) -> Result<E, DbError>` would be typed over `E` and could not then hold two
// different entities. The metamodel is deliberately untyped; the call site is where the type is
// known anyway.

// The entities a query answers, read by `from_row`.
//
// A row answering **two** entities (`SELECT p, v FROM ..`) has two columns called `id`, and
// `row_get` takes the first -- so one `from_row` reads the first entity of such a row and the
// second is unreachable through it. Select one entity at a time, or use `rows` and read the tuple.
// JPQL answers an array of objects there; doing that here would need a tuple type this layer does
// not have.
pub fn list<E>(
    conn: datasource.Connection,
    query: Translated,
    bound: [Binding],
    from_row: fn(Row) -> Result<E, DbError>
) -> Result<[E], DbError> {
    val out = mutable_array_new<E>()
    for row in try rows(conn, query, bound) {
        push(out, try from_row(row))
    }
    return ok(snapshot(out))
}

// The first entity a query answers, or None.
//
// It runs the query as written and keeps the first row: like `datasource.query_one`, it does
// **not** add a `LIMIT 1`, so a query that could match many rows fetches and discards them all.
// Write the limit into the query when that matters.
pub fn one<E>(
    conn: datasource.Connection,
    query: Translated,
    bound: [Binding],
    from_row: fn(Row) -> Result<E, DbError>
) -> Result<Option<E>, DbError> {
    val found = try rows(conn, query, bound)
    if prelude.len(found) == 0 {
        return ok(Option<E>.None)
    }
    return ok(Option<E>.Some(try from_row(found[0])))
}

// The rows a query answers, for a projection -- a few fields, an aggregate, a count. The caller
// reads them with `db.row_get` and the `sql_as_*` converters, as it would any other result.
// ------------------------------------------------- writing one row by its key
//
// **These take an `Entity`, not a query**, which is the difference between this half of the module
// and the rest of it. A read is a query because a reader chooses what to ask; storing a row is not
// a question -- the table, the columns and the key are the entity's own, so a statement built from
// the metamodel cannot disagree with it.
//
// That is the point rather than the convenience. The hand-written form these replace names its
// columns in one place and fills them from `<name>_to_params` in another, and the two must agree
// in *order* -- a convention checked by nothing. Two adjacent columns of the same type swapped in
// that list produce a row that saves, with every value valid and a 200 from the API, and only the
// contents wrong. Built from `e.columns`, which is the same list `#[derive(Entity(..))]` writes
// from the struct, the two agreements are one fact.

// The values at the entity's key columns, in key order.
// The position of `name` in `e.columns`, or a refusal naming what the entity does have.
fn column_at(e: Entity, name: string) -> Result<int, DbError> {
    for i in 0..prelude.len(e.columns) {
        if e.columns[i] == name {
            return ok(i)
        }
    }
    return err(problem(prelude.format(
        "{} names {} and has no such column (it has: {})",
        e.name,
        name,
        join(separator: ", ", pieces: e.columns)
    )))
}

// The values of `names`, picked out of one full row of values in column order. **One array in, so
// naming extra columns adds no second order to keep right** -- which is the point of taking the
// entity rather than a statement.
fn values_of(e: Entity, names: [string], values: [SqlValue]) -> Result<[SqlValue], DbError> {
    val out = mutable_array_new<SqlValue>()
    for name in names {
        val at = try column_at(e, name)
        push(out, values[at])
    }
    return ok(snapshot(out))
}

fn key_values(e: Entity, values: [SqlValue]) -> Result<[SqlValue], DbError> {
    return values_of(e, e.keys, values)
}

// `c1 = $1 AND c2 = $2`, numbered from `from`.
fn where_of(columns: [string], from: int) -> string {
    val parts = mutable_array_new<string>()
    for i in 0..prelude.len(columns) {
        push(parts, prelude.format("{} = ${}", columns[i], from + i))
    }
    return join(separator: " AND ", pieces: snapshot(parts))
}

// Without a key there is no predicate that names one row, so every one of these refuses before it
// can build a statement with an empty -- or missing -- `WHERE`.
fn addressable(e: Entity) -> Result<unit, DbError> {
    if prelude.len(e.keys) == 0 {
        return err(problem(prelude.format(
            "{} declares no key, so one of its rows cannot be addressed -- mark a field #[pk]",
            e.name
        )))
    }
    return ok(unit)
}

// The two refusals every write shares, so none of them can forget one.
fn writable(e: Entity, values: [SqlValue]) -> Result<unit, DbError> {
    try addressable(e)
    if prelude.len(values) != prelude.len(e.columns) {
        return err(problem(prelude.format(
            "{} takes {} values and {} were given ({})",
            e.table,
            prelude.len(e.columns),
            prelude.len(values),
            join(separator: ", ", pieces: e.columns)
        )))
    }
    return ok(unit)
}

// **The row a predicate addresses, if it is there, and a second one refused rather than taken.**
// That refusal is what makes a mistake about the key loud: an entity whose `#[pk]` does not
// identify a row -- one column of a compound key, or a key marked on a column that is not unique --
// otherwise returns plausible data forever, picked by whatever order the engine happened to use.
fn maybe_row<E>(
    conn: datasource.Connection,
    e: Entity,
    predicate: [string],
    values: [SqlValue],
    from_row: fn(Row) -> Result<E, DbError>
) -> Result<Option<E>, DbError> {
    val found = try datasource.query(conn, prelude.format(
        "SELECT {} FROM {} WHERE {}",
        join(separator: ", ", pieces: e.columns),
        e.table,
        where_of(predicate, 1)
    ), values)
    if prelude.len(found) > 1 {
        return err(problem(prelude.format(
            "{} answered {} rows for one row's worth of values, so {} does not identify a row",
            e.table,
            prelude.len(found),
            join(separator: ", ", pieces: predicate)
        )))
    }
    if prelude.len(found) == 0 {
        return ok(Option<E>.None)
    }
    return ok(Option<E>.Some(try from_row(found[0])))
}

// The same, where absence is an error rather than an answer.
fn only_row<E>(
    conn: datasource.Connection,
    e: Entity,
    predicate: [string],
    values: [SqlValue],
    from_row: fn(Row) -> Result<E, DbError>
) -> Result<E, DbError> {
    val found = try maybe_row<E>(conn, e, predicate, values, from_row)
    if Some(row) = found {
        return row
    }
    return err(DbError.NotFound(prelude.format("{} not found", e.name)))
}

// A key, and the right number of values for it. Shared by everything that addresses one row, so
// the message about a compound key is written once.
fn keyed(e: Entity, keys: [SqlValue]) -> Result<unit, DbError> {
    try addressable(e)
    if prelude.len(keys) != prelude.len(e.keys) {
        return err(problem(prelude.format(
            "{} has a {}-column key ({}) and {} value(s) were given",
            e.name,
            prelude.len(e.keys),
            join(separator: ", ", pieces: e.keys),
            prelude.len(keys)
        )))
    }
    return ok(unit)
}

// **One row stored, and read back.** The columns and their order are the entity's, so the statement
// and the values cannot disagree; the read-back is by the entity's key, which is what `#[pk]` is
// for.
pub fn insert_one<E>(
    conn: datasource.Connection,
    e: Entity,
    values: [SqlValue],
    from_row: fn(Row) -> Result<E, DbError>
) -> Result<E, DbError> {
    try writable(e, values)
    val holes = mutable_array_new<string>()
    for i in 0..prelude.len(e.columns) {
        push(holes, concat("$", str(i + 1)))
    }
    try datasource.execute(conn, prelude.format(
        "INSERT INTO {} ({}) VALUES ({})",
        e.table,
        join(separator: ", ", pieces: e.columns),
        join(separator: ", ", pieces: snapshot(holes))
    ), values)
    return find_by_key<E>(conn, e, try key_values(e, values), from_row)
}

// **Every column of one row replaced by `values`, and the row read back.** The assignments are the
// entity's own non-key columns, so a `SET` list cannot drift out of step with the values the way a
// hand-written one can.
//
// `scope` names columns the stored row must match *as well as* the key -- for a table whose rows
// belong to someone, the owner. Their values come out of `values` like every other column's, so a
// scope costs no extra argument to keep aligned; `[]` is the plain shape, keyed and nothing else.
//
// **The read-back goes through the same predicate, not through the key alone**, and with a scope
// those differ exactly where it matters: an entity carrying a different owner matches no row, and a
// read-back by key would then answer *the other owner's row* -- the update correctly refused and
// its subject handed back anyway. Through the predicate it answers `NotFound`.
//
// That is also why this does not consult the number of rows the `UPDATE` affected, which is the
// obvious way to tell a miss from a hit: MySQL reports rows *changed* rather than matched unless
// `CLIENT_FOUND_ROWS` is set, and `lib/db/mysql.zm` does not set it, so storing the values a row
// already has would be indistinguishable from matching nothing.
pub fn update_one<E>(
    conn: datasource.Connection,
    e: Entity,
    values: [SqlValue],
    scope: [string],
    from_row: fn(Row) -> Result<E, DbError>
) -> Result<E, DbError> {
    try writable(e, values)
    val assigns = mutable_array_new<string>()
    val sent = mutable_array_new<SqlValue>()
    for i in 0..prelude.len(e.columns) {
        if contains(e.keys, e.columns[i]) {
            continue
        }
        push(assigns, prelude.format("{} = ${}", e.columns[i], prelude.len(sent) + 1))
        push(sent, values[i])
    }
    if prelude.len(assigns) == 0 {
        return err(problem(prelude.format(
            "every column of {} belongs to its key, so an update could not change anything",
            e.name
        )))
    }
    for name in scope {
        if contains(e.keys, name) {
            return err(problem(prelude.format(
                "{} is already part of {}'s key, so naming it as a scope column says nothing",
                name,
                e.name
            )))
        }
    }
    val predicate = concat(e.keys, scope)
    val matched = try values_of(e, predicate, values)
    for v in matched {
        push(sent, v)
    }
    try datasource.execute(conn, prelude.format(
        "UPDATE {} SET {} WHERE {}",
        e.table,
        join(separator: ", ", pieces: snapshot(assigns)),
        where_of(predicate, prelude.len(assigns) + 1)
    ), snapshot(sent))
    return only_row<E>(conn, e, predicate, matched, from_row)
}

// The one row a key addresses.
pub fn find_by_key<E>(
    conn: datasource.Connection,
    e: Entity,
    keys: [SqlValue],
    from_row: fn(Row) -> Result<E, DbError>
) -> Result<E, DbError> {
    try keyed(e, keys)
    return only_row<E>(conn, e, e.keys, keys, from_row)
}

// The row a key addresses, or `None`. **Absence is an answer here and an error in `find_by_key`**,
// and which one a caller wants is not guessable: a request for one record by id is a 404 and wants
// the error, while a check before writing wants the `Option` and would otherwise read a `NotFound`
// back out of a `Result` to decide nothing is wrong.
pub fn find_maybe<E>(
    conn: datasource.Connection,
    e: Entity,
    keys: [SqlValue],
    from_row: fn(Row) -> Result<E, DbError>
) -> Result<Option<E>, DbError> {
    try keyed(e, keys)
    return maybe_row<E>(conn, e, e.keys, keys, from_row)
}

// Whether the key addresses a row, without building the entity from it. The projection is the key
// rather than `1` or `*`: a constant is a different kind of expression for an engine to plan, and
// every column is work thrown away.
pub fn exists(conn: datasource.Connection, e: Entity, keys: [SqlValue]) -> Result<bool, DbError> {
    try keyed(e, keys)
    val found = try datasource.query(conn, prelude.format(
        "SELECT {} FROM {} WHERE {}",
        join(separator: ", ", pieces: e.keys),
        e.table,
        where_of(e.keys, 1)
    ), keys)
    return ok(prelude.len(found) > 0)
}

// **Every row, ordered by the key.** The order is not decoration: without an `ORDER BY` the engine
// may answer in any order it likes, and two runs of the same program disagreeing about the order of
// a list is the kind of difference that is found in production rather than in a test. The key is
// the one ordering every entity is guaranteed to have.
pub fn find_all<E>(
    conn: datasource.Connection,
    e: Entity,
    from_row: fn(Row) -> Result<E, DbError>
) -> Result<[E], DbError> {
    try addressable(e)
    val found = try datasource.query(conn, prelude.format(
        "SELECT {} FROM {} ORDER BY {}",
        join(separator: ", ", pieces: e.columns),
        e.table,
        join(separator: ", ", pieces: e.keys)
    ))
    val out = mutable_array_new<E>()
    for row in found {
        push(out, try from_row(row))
    }
    return ok(snapshot(out))
}

// How many rows the table has.
pub fn count_all(conn: datasource.Connection, e: Entity) -> Result<int, DbError> {
    val found = try datasource.query(conn, prelude.format("SELECT count(*) AS n FROM {}", e.table))
    if prelude.len(found) != 1 {
        return err(problem(prelude.format(
            "counting {} answered {} rows",
            e.table,
            prelude.len(found)
        )))
    }
    return db.sql_as_int(found[0].values[0])
}

// `c1 = $1 AND c2 = $2` for named columns and their values, which is the shape every delete in the
// sample backend has: a key with an owner beside it, or an owner alone.
//
// **Columns named beside their values, where `update_one` takes a column list alone.** The
// difference is not style: `update_one` has the whole row in its hands, so taking a scope value out
// of it is one fewer thing that can disagree with what is being written. A delete has no row --
// only an id and an owner -- so the alternative here would be two parallel arrays, which is the
// convention these functions exist to remove.
fn where_bound(matching: [Binding]) -> Result<string, DbError> {
    if prelude.len(matching) == 0 {
        return err(problem("a delete with no predicate would empty the table -- name at least one column"))
    }
    for b in matching {
        // A collection predicate is `IN`, not `=`; that is a different statement and not one of
        // these, so it is refused rather than silently taking the first value.
        if b.list {
            return err(problem(prelude.format(
                "{} was bound as a collection, and a delete predicate matches one value per column",
                b.name
            )))
        }
    }
    val parts = mutable_array_new<string>()
    for i in 0..prelude.len(matching) {
        push(parts, prelude.format("{} = ${}", matching[i].name, i + 1))
    }
    return ok(join(separator: " AND ", pieces: snapshot(parts)))
}

fn bound_values(matching: [Binding]) -> [SqlValue] {
    val out = mutable_array_new<SqlValue>()
    for b in matching {
        push(out, b.value)
    }
    return snapshot(out)
}

// **Every row matching `matching`, and how many there were.** An empty predicate is refused rather
// than read as "all of them": `DELETE FROM t` is a different intention and says so through
// `delete_all`.
pub fn delete_where(conn: datasource.Connection, e: Entity, matching: [Binding]) -> Result<int, DbError> {
    val predicate = try where_bound(matching)
    for b in matching {
        try column_at(e, b.name)
    }
    return datasource.execute(conn, prelude.format(
        "DELETE FROM {} WHERE {}",
        e.table,
        predicate
    ), bound_values(matching))
}

// **The one row the key addresses, with `scope` as well**, and `NotFound` when nothing matched --
// which is also the answer for a row another owner holds, because that is the rule the repository
// layer keeps throughout: another owner's row is not found, not forbidden.
//
// Unlike an update, this does consult the number of rows affected. A `DELETE` has no rows-changed
// regime to be wrong about: every engine counts the rows it removed.
pub fn delete_one(
    conn: datasource.Connection,
    e: Entity,
    keys: [SqlValue],
    scope: [Binding]
) -> Result<unit, DbError> {
    try keyed(e, keys)
    val matching = mutable_array_new<Binding>()
    for i in 0..prelude.len(e.keys) {
        push(matching, bind(e.keys[i], keys[i]))
    }
    for b in scope {
        if contains(e.keys, b.name) {
            return err(problem(prelude.format(
                "{} is already part of {}'s key, so naming it as a scope column says nothing",
                b.name,
                e.name
            )))
        }
        push(matching, b)
    }
    val gone = try delete_where(conn, e, snapshot(matching))
    if gone == 0 {
        return err(DbError.NotFound(prelude.format("{} not found", e.name)))
    }
    return ok(unit)
}

// Every row of the table, and how many there were. **Spelled out rather than reached by an empty
// predicate**, so emptying a table is never what a predicate that came out empty does by accident.
pub fn delete_all(conn: datasource.Connection, e: Entity) -> Result<int, DbError> {
    return datasource.execute(conn, prelude.format("DELETE FROM {}", e.table))
}

// Whether a translated query is the one kind that changes the database. `switch` over `Statement`
// would be thirteen arms to answer one question.
fn removes_rows(statement: Statement) -> bool {
    if Delete(d) = statement {
        return true
    }
    return false
}

// **A DELETE, and the rows it removed.** Separate from `rows`/`list`/`one`/`count` rather than
// folded into them, because the mistake worth preventing is not a wrong answer: handing a DELETE to
// a read would *run* it, delete the rows, and hand back the empty result as though it had found
// nothing. So each side refuses the other's statement by name.
pub fn execute(conn: datasource.Connection, query: Translated, bound: [Binding]) -> Result<int, DbError> {
    if !removes_rows(query.statement) {
        return err(problem(concat(
            "eql.execute runs a DELETE and this query reads -- use eql.list, eql.one or eql.count: ",
            query.sql
        )))
    }
    val ready = try prepare(query, bound)
    return datasource.execute(conn, ready.sql, ready.params)
}

pub fn rows(conn: datasource.Connection, query: Translated, bound: [Binding]) -> Result<[Row], DbError> {
    if removes_rows(query.statement) {
        return err(problem(concat(
            "this query is a DELETE, so reading it would run it -- use eql.execute: ",
            query.sql
        )))
    }
    val ready = try prepare(query, bound)
    return datasource.query(conn, ready.sql, ready.params)
}

// The one number a counting query answers: one row of one column, read as an integer.
//
// `SELECT count(*) AS n FROM Visit v WHERE v.patient_id = :id` is the commonest projection there
// is, and reading it by hand is four lines of row and converter every time. A query that answers
// more than one row, or a row of more than one column, is an error naming what it answered --
// because a count that quietly read the first of several numbers would be worse than no helper.
pub fn count(conn: datasource.Connection, query: Translated, bound: [Binding]) -> Result<int, DbError> {
    val found = try rows(conn, query, bound)
    if prelude.len(found) != 1 {
        return err(problem(prelude.format(
            "a counting query must answer one row, and this answered {}: {}",
            prelude.len(found),
            query.sql
        )))
    }
    if prelude.len(found[0].values) != 1 {
        return err(problem(prelude.format(
            "a counting query must answer one column, and this answered {}: {}",
            prelude.len(found[0].values),
            query.sql
        )))
    }
    return db.sql_as_int(found[0].values[0])
}
