// sqlite.zm -- the SQLite driver behind `datasource`. A connection is an integer
// handle to a native connection object (src/native_sqlite.c, linked against
// libsqlite3), closed by `close` or, failing that, when it is garbage collected. This
// module encodes `SqlValue` parameters into that native's primitive-only shape and decodes
// result cells back. Use it
// through `datasource.open("sqlite:...")`; `pg` is the Postgres counterpart.
//
// The natives only ever exchange primitives (ints, strings, arrays of
// *tagged strings* -- one tag character then a payload: N null,
// I<int>, F<float>, T<text>, B<hex>, b0/b1 bool).

use db.DbError
use db.Row
use db.SqlValue
use number.byte_from_hex
use number.byte_to_hex

native fn open_raw(path: string) -> Result<int, string>
native fn close_raw(handle: int)
native fn execute_raw(handle: int, sql: string, params: [string]) -> Result<int, string>
native fn query_raw(handle: int, sql: string, params: [string]) -> Result<[string], string>
native fn float_to_text(f: float) -> string
native fn cursor_open_raw(handle: int, sql: string, params: [string]) -> Result<int, string>
native fn cursor_columns_raw(cursor: int) -> [string]
native fn cursor_next_raw(cursor: int) -> Result<[string], string>
native fn cursor_close_raw(cursor: int)

// A native error arrives as "category|message".
fn error_from_raw(raw: string) -> DbError {
    var category = raw
    var message = ""
    val split_raw = split_once(raw, "|")
    if Option.is_Some(split_raw) {
        category = Option.unwrap_Some(split_raw)[0]
        message = Option.unwrap_Some(split_raw)[1]
    }
    if category == "constraint" {
        return DbError.Constraint(message)
    }
    return if category == "connection" { DbError.Connection(message) } else { DbError.Sql(message) }
}

fn encode_param(v: SqlValue) -> string {
    if SqlValue.is_Null(v) {
        return "N"
    }
    if SqlValue.is_Int(v) {
        return concat("I", str(SqlValue.unwrap_Int(v)))
    }
    if SqlValue.is_Float(v) {
        return concat("F", float_to_text(SqlValue.unwrap_Float(v)))
    }
    if SqlValue.is_Text(v) {
        return concat("T", SqlValue.unwrap_Text(v))
    }
    if SqlValue.is_Bool(v) {
        if SqlValue.unwrap_Bool(v) {
            return "b1"
        }
        return "b0"
    }
    val hex = sb_new()
    sb_append(hex, "B")
    for b in SqlValue.unwrap_Bytes(v) {
        sb_append(hex, byte_to_hex(b))
    }
    return sb_to_string(hex)
}

fn encode_params(params: [SqlValue]) -> [string] {
    val out = ab_new<string>()
    for p in params {
        ab_append<string>(out, encode_param(p))
    }
    return ab_to_array<string>(out)
}

fn decode_cell(cell: string) -> Result<SqlValue, DbError> {
    val tag = substring(cell, 0, 1)
    val payload = substring(cell, 1, len(cell))
    if tag == "N" {
        return SqlValue.Null
    }
    if tag == "T" {
        return SqlValue.Text(payload)
    }
    if tag == "I" {
        val n = parse_int(payload)
        if !is_ok(n) {
            return err(DbError.Sql(concat("bad integer from driver: ", payload)))
        }
        return SqlValue.Int(unwrap(n))
    }
    if tag == "F" {
        val f = parse_float(payload)
        if !is_ok(f) {
            return err(DbError.Sql(concat("bad float from driver: ", payload)))
        }
        return SqlValue.Float(unwrap(f))
    }
    if tag == "B" {
        val bytes = ab_new<byte>()
        for i in 0..len(payload) / 2 {
            val b = byte_from_hex(substring(payload, 2 * i, 2 * i + 2))
            if !is_ok(b) {
                return err(DbError.Sql(concat("bad blob from driver: ", payload)))
            }
            ab_append<byte>(bytes, unwrap(b))
        }
        return SqlValue.Bytes(ab_to_array<byte>(bytes))
    }
    return err(DbError.Sql(concat("unknown cell tag from driver: ", tag)))
}

// An open SQLite connection: a handle to the native connection. Opaque to
// callers -- use `execute`/`query`/`close`.
pub struct Connection {
    handle: int
}

// `path` is a SQLite filename, or `:memory:`.
pub fn open(path: string) -> Result<Connection, DbError> {
    val opened = open_raw(path)
    if !is_ok(opened) {
        return err(error_from_raw(unwrap_err(opened)))
    }
    return Connection { handle: unwrap(opened) }
}

// Closes the database. Using the connection afterwards is an error, not a crash; one never closed
// is closed when it is garbage collected, but a file database stays locked until then.
pub fn close(conn: Connection) {
    close_raw(conn.handle)
}

// Runs a statement, or a `;`-separated script of them, and returns the rows the last statement
// changed. `params` bind to the `?` placeholders.
pub fn execute(conn: Connection, sql: string, params: SqlValue...) -> Result<int, DbError> {
    val r = execute_raw(conn.handle, sql, encode_params(params))
    if !is_ok(r) {
        return err(error_from_raw(unwrap_err(r)))
    }
    return ok(unwrap(r))
}

// Runs a statement and returns its rows; `params` bind to the `?` placeholders.
pub fn query(conn: Connection, sql: string, params: SqlValue...) -> Result<[Row], DbError> {
    val r = query_raw(conn.handle, sql, encode_params(params))
    if !is_ok(r) {
        return err(error_from_raw(unwrap_err(r)))
    }
    val flat = unwrap(r)
    val ncols = unwrap(parse_int(flat[0]))
    val columns = ab_new<string>()
    for c in 0..ncols {
        ab_append<string>(columns, flat[1 + c])
    }
    val names = ab_to_array<string>(columns)
    val rows = ab_new<Row>()
    var pos = 1 + ncols
    while pos < len(flat) {
        val values = ab_new<SqlValue>()
        for k in 0..ncols {
            val cell = try decode_cell(flat[pos + k])
            ab_append<SqlValue>(values, cell)
        }
        ab_append<Row>(rows, Row { columns: names, values: ab_to_array<SqlValue>(values) })
        pos = pos + ncols
    }
    return ab_to_array<Row>(rows)
}

fn row_from_cells(names: [string], cells: [string]) -> Result<Row, DbError> {
    val values = ab_new<SqlValue>()
    for cell in cells {
        val v = try decode_cell(cell)
        ab_append<SqlValue>(values, v)
    }
    return Row { columns: names, values: ab_to_array<SqlValue>(values) }
}

fn next_row(cursor: int, names: [string]) -> Option<Result<Row, DbError>> {
    val r = cursor_next_raw(cursor)
    if !is_ok(r) {
        val failure: Result<Row, DbError> = error_from_raw(unwrap_err(r))
        return Option<Result<Row, DbError>>.Some(failure)
    }
    val cells = unwrap(r)
    if len(cells) == 0 {
        return Option<Result<Row, DbError>>.None
    }
    return Option<Result<Row, DbError>>.Some(row_from_cells(names, cells))
}

// Runs a statement and returns its rows lazily, one at a time as a `for` loop asks for them, so a
// result of any size uses memory for one row. Each item is a `Result<Row, DbError>`: a row, or the
// error that ended the result part-way (after which the iteration ends). The Err on the call is the
// statement failing to prepare or bind. The cursor is finalized when the rows are used up, when the
// loop is left early, with `iter_close`, or when it is garbage collected. Close cursors before
// closing the connection.
pub fn rows(conn: Connection, sql: string, params: SqlValue...) -> Result<Iter<Result<Row, DbError>>, DbError> {
    val opened = cursor_open_raw(conn.handle, sql, encode_params(params))
    if !is_ok(opened) {
        return err(error_from_raw(unwrap_err(opened)))
    }
    val cursor = unwrap(opened)
    val names = cursor_columns_raw(cursor)
    return iter_from<Result<Row, DbError>>(
        fn() -> Option<Result<Row, DbError>> { next_row(cursor, names) },
        fn() { cursor_close_raw(cursor) }
    )
}
