// memdb.zm -- a small SQL engine in pure Ziman, holding its tables in memory, for tests.
//
// A `db.Driver` like `sqlite`, `pg` and `mysql`, so `datasource` reaches it the same way and
// nothing above it knows the difference:
//
//     val drivers = datasource.registry([memdb.driver()])
//     val conn = try datasource.open(drivers, "memdb:")
//     try migrate.run(conn, "migrations")          // or run schema.sql and data.sql by hand
//
// **It is a third target, not a replacement.** A test that passes here and fails on PostgreSQL
// certifies nothing, so the point of this engine is to run the *same* suite that sqlite and
// postgres run, where a divergence shows up as a failure instead of hiding as a false green. The
// divergences it knows about are listed at the bottom of this comment; run the real engine before
// believing anything surprising.
//
// ## What it understands
//
// `CREATE TABLE` (with `NOT NULL`, `PRIMARY KEY`, `UNIQUE`, `DEFAULT` and a column type that is
// recorded but not enforced), `CREATE [UNIQUE] INDEX`, `ALTER TABLE ... ADD COLUMN`,
// `DROP TABLE [IF EXISTS]`, `INSERT INTO ... VALUES`, `SELECT` with `WHERE`, `GROUP BY`, `HAVING`,
// `ORDER BY`, `LIMIT` and `OFFSET`, `UPDATE ... SET ... WHERE`, `DELETE FROM ... WHERE`, and
// `BEGIN`/`COMMIT`/`ROLLBACK`.
//
// Expressions: literals, column references, bound parameters (`?`, `$1`), `AND`/`OR`/`NOT`, the six
// comparisons, `IS [NOT] NULL`, `LIKE`, `IN`, `BETWEEN`, `CASE WHEN`, `+ - * /`, `||`, parentheses,
// the scalar functions `substr`, `length`, `lower`, `upper`, `trim`, `abs` and `coalesce`, and the
// aggregates `COUNT`, `SUM`, `MIN`, `MAX` and `AVG`.
//
// **Columns are resolved before a statement runs**, as a real engine resolves them when it
// prepares one. Looking them up per row instead meant a query whose `WHERE` matched nothing never
// looked, so `SELECT count(age) FROM visit WHERE reason = 'nothing'` answered 0 where SQLite
// answers "no such column: age" -- a typo passing here and failing there is the exact false green
// this engine exists to avoid, and the cross-check fixture caught it within a minute of the
// aggregates being written.
//
// ## Two readings of SQL
//
// `driver()` at `memdb:` reads SQL the way SQLite does. `strict_driver()` at `memdb-ansi:` reads it
// the way the standard does, and the two differ in exactly four places -- `LIKE`'s case
// sensitivity, what division by zero answers, whether a number may be compared with text, and
// whether a boolean in a select list comes back as a boolean or as the integer 0 or 1 (SQLite has
// no boolean type; PostgreSQL and the standard do).
//
// **The strict one is a portability check.** A query that passes on `memdb:` and fails on
// `memdb-ansi:` is leaning on SQLite and will behave differently on PostgreSQL, which matters when
// one application ships on both. `tests/lang/memdb_ansi_strictness.zm` holds the list and asserts
// both halves: the lax reading still matches real SQLite, and the strict reading still differs.
//
// Measured against the sample application before any of it was written: its 191 SQL strings use no
// joins and no subqueries, because its repositories query one table each and compose in Ziman. The
// 20,365 characters of SQL in it are almost all of the shape above.
//
// `DISTINCT` and `RETURNING` are the next increment, then constraint *enforcement*, `JOIN`,
// subqueries and per-test forking. Anything it does not understand is an error naming the token,
// never a quiet partial execution.
//
// ## Transactions are free, because a database is a value
//
// A `Database` is an immutable `Map` of immutable tables, so `BEGIN` keeps the current one,
// `ROLLBACK` puts it back and `COMMIT` forgets it. There is no undo log and no copying: the saved
// database *is* the old state. That is also what will make per-test forking free later -- seed a
// schema and a dataset once, then hand every test its own copy of the same value.
//
// ## Known divergences from SQLite and PostgreSQL
//
//   - **No type affinity.** A column declared `INTEGER` holds whatever is inserted; SQLite would
//     coerce `'7'` to 7. Insert the right type.
//   - **The statement tree and the parser live in `sql`**, not here. This module is the engine:
//     storage, evaluation and the two drivers. `sql.parse` reads SQL, `sql.format` writes it back,
//     and anything wanting to read or rewrite SQL without a database uses that module alone.
//   - **Constraints are recorded, not enforced** in this increment: `NOT NULL`, `PRIMARY KEY` and
//     `UNIQUE` parse and are remembered, and a violation is accepted. The real engines refuse it.
//   - **`CREATE INDEX` is accepted and ignored.** An index changes how fast a query runs, not what
//     it answers, and this engine has no query planner to put one in.
//   - **NULLs sort first ascending**, which is SQLite's order. PostgreSQL sorts them last. A test
//     that depends on either is already engine-specific.
//   - **No `sqlite_master`, no `information_schema`.** A test that inspects the schema through SQL
//     is asking the engine about itself, and this one answers only about data.

#![experimental]
use db.Conn
use db.DbError
use db.Driver
use db.Row
use db.SqlValue
use locale
use sql
use sql.AlterStmt
use sql.Assignment
use sql.BinNode
use sql.CallNode
use sql.Column
use sql.CreateStmt
use sql.DeleteStmt
use sql.DropStmt
use sql.Expr
use sql.InsertStmt
use sql.SelectItem
use sql.SelectStmt
use sql.Statement
use sql.UpdateStmt

// Case folding for keywords and identifiers is protocol folding, so it names the invariant locale
// rather than whatever a program set as its default: in Turkish, `I` folds to `ı` and `SELECT`
// would stop being a keyword.
val invariant: Locale = locale.root()

// ---------------------------------------------------------------- storage

// A table: its columns in declaration order, and its rows as arrays of the same width. Row order
// is insertion order, which is what a `SELECT` with no `ORDER BY` returns -- the real engines
// promise nothing there, so a test that cares must say `ORDER BY`.
struct Table {
    name: string
    columns: [Column]
    rows: [[SqlValue]]
}

// The whole database as one immutable value. Tables are keyed by their folded name, so `Users` and
// `users` are one table, as they are in SQLite and (for unquoted names) PostgreSQL.
struct Database {
    tables: Map<string, Table>
}

fn empty_database() -> Database {
    return Database { tables: Map<string, Table> {} }
}

fn problem(message: string) -> DbError {
    return DbError.Sql(message)
}
// ---------------------------------------------------------------- evaluating

// What an expression is evaluated against: the row's shape and values, the statement's bound
// parameters, and whether this connection is the strict one.
//
// **`strict` is the whole of the ANSI-versus-SQLite difference**, and it is one field rather than
// two engines because the disagreements are few and local: `LIKE`'s case sensitivity, what
// division by zero answers, and whether a number may be compared with text. Each is marked
// `strict` at the point it decides, so the two readings cannot drift apart in separate code.
struct Ctx {
    columns: [string]
    row: [SqlValue]
    params: [SqlValue]
    strict: bool
}

fn ctx_of(columns: [string], row: [SqlValue], params: [SqlValue], strict: bool) -> Ctx {
    return Ctx { columns: columns, row: row, params: params, strict: strict }
}

// SQLite's type order, which is also the order NULLs sort first in: NULL, then numbers, then
// text, then blobs. PostgreSQL would refuse to compare a number with text at all; a test that
// relies on either is already engine-specific.
fn type_rank(v: SqlValue) -> int {
    return switch v {
        Null { 0 }
        Bool(_) { 1 }
        Int(_) { 1 }
        Float(_) { 1 }
        Text(_) { 2 }
        Bytes(_) { 3 }
    }
}

fn as_number(v: SqlValue) -> float {
    return switch v {
        Int(n) { n as float }
        Float(f) { f }
        Bool(b) { if b { 1.0 } else { 0.0 } }
        Null { 0.0 }
        Text(_) { 0.0 }
        Bytes(_) { 0.0 }
    }
}

// Negative, zero or positive, for `ORDER BY` and for the comparison operators. Two NULLs compare
// equal *here* so that sorting is a total order; `=` never reaches this with a NULL, because
// `compare_values` is only asked after the three-valued check below.
fn compare_values(a: SqlValue, b: SqlValue) -> int {
    val ra = type_rank(a)
    val rb = type_rank(b)
    if ra != rb {
        return if ra < rb { 0 - 1 } else { 1 }
    }
    return switch a {
        Text(sa) { switch b {
            Text(sb) { compare(sa, sb) }
            Null { 0 }
            Int(_) { 0 }
            Float(_) { 0 }
            Bool(_) { 0 }
            Bytes(_) { 0 }
        } }
        Bytes(ba) { switch b {
            Bytes(bb) { compare(ba, bb) }
            Null { 0 }
            Int(_) { 0 }
            Float(_) { 0 }
            Bool(_) { 0 }
            Text(_) { 0 }
        } }
        Null { 0 }
        Int(_) { compare(as_number(a), as_number(b)) }
        Float(_) { compare(as_number(a), as_number(b)) }
        Bool(_) { compare(as_number(a), as_number(b)) }
    }
}

// `WHERE` keeps a row when the filter is true; NULL and false both drop it, which is SQL's
// three-valued logic seen from the outside.
fn is_true(v: SqlValue) -> bool {
    return switch v {
        Bool(b) { b }
        Int(n) { n != 0 }
        Float(f) { f != 0.0 }
        Text(_) { false }
        Bytes(_) { false }
        Null { false }
    }
}

fn is_null(v: SqlValue) -> bool {
    return SqlValue.is_Null(v)
}

fn column_index(columns: [string], name: string) -> int {
    val want = sql.fold_name(name)
    for i in 0..prelude.len(columns) {
        if sql.fold_name(columns[i]) == want {
            return i
        }
    }
    return 0 - 1
}

fn eval_expr(e: Expr, cx: Ctx) -> Result<SqlValue, DbError> {
    return switch e {
        Lit(v) { ok(v) }
        Star { err(problem("'*' is only allowed on its own in a SELECT list")) }
        Param(number) {
            if number > prelude.len(cx.params) {
                err(problem(prelude.format(
                    "the statement wants parameter ${} but {} were given",
                    number,
                    prelude.len(cx.params)
                )))
            } else {
                ok(cx.params[number - 1])
            }
        }
        Col(ref) {
            // The qualifier is kept by the tree and ignored here: one table is in scope, so
            // `p.name` and `name` reach the same column.
            val at = column_index(cx.columns, ref.name)
            if at < 0 {
                err(problem(prelude.format("no such column: {}", ref.name)))
            } else {
                ok(cx.row[at])
            }
        }
        Not(node) {
            val inner = try eval_expr(node.inner, cx)
            // NOT NULL is NULL, not true.
            if is_null(inner) { ok(SqlValue.Null) } else { ok(SqlValue.Bool(!is_true(inner))) }
        }
        IsNull(node) {
            val inner = try eval_expr(node.inner, cx)
            ok(SqlValue.Bool(if node.negated { !is_null(inner) } else { is_null(inner) }))
        }
        Bin(node) { eval_binary(node, cx) }
        Call(node) { eval_call(node, cx) }
        Like(node) {
            val subject = try eval_expr(node.subject, cx)
            val pattern = try eval_expr(node.pattern, cx)
            if is_null(subject) || is_null(pattern) {
                ok(SqlValue.Null)
            } else {
                val hit = like_matches(text_of(subject), text_of(pattern), cx.strict)
                ok(SqlValue.Bool(if node.negated { !hit } else { hit }))
            }
        }
        In(node) {
            val subject = try eval_expr(node.subject, cx)
            if is_null(subject) {
                ok(SqlValue.Null)
            } else {
                var hit = false
                var unknown = false
                for option in node.options {
                    val v = try eval_expr(option, cx)
                    if is_null(v) {
                        unknown = true
                    } else if compare_values(subject, v) == 0 {
                        hit = true
                    }
                }
                // `x IN (1, NULL)` is true when x is 1 and unknown otherwise -- a NULL in the list
                // cannot make a match false, only an absence unknown.
                if hit {
                    ok(SqlValue.Bool(!node.negated))
                } else if unknown {
                    ok(SqlValue.Null)
                } else {
                    ok(SqlValue.Bool(node.negated))
                }
            }
        }
        Between(node) {
            val subject = try eval_expr(node.subject, cx)
            val low = try eval_expr(node.low, cx)
            val high = try eval_expr(node.high, cx)
            if is_null(subject) || is_null(low) || is_null(high) {
                ok(SqlValue.Null)
            } else {
                val inside = compare_values(subject, low) >= 0 && compare_values(subject, high) <= 0
                ok(SqlValue.Bool(if node.negated { !inside } else { inside }))
            }
        }
        Case(node) {
            var answer = SqlValue.Null
            var decided = false
            for arm in node.arms {
                if !decided {
                    // `try` cannot sit on the right of `&&` -- it must run exactly once and
                    // unconditionally -- so the condition is evaluated in its own step.
                    val test = try eval_expr(arm.condition, cx)
                    if is_true(test) {
                        answer = try eval_expr(arm.value, cx)
                        decided = true
                    }
                }
            }
            if !decided && prelude.len(node.fallback) == 1 {
                answer = try eval_expr(node.fallback[0], cx)
            }
            ok(answer)
        }
    }
}

// SQL's `LIKE`: `%` stands for any run of characters, `_` for exactly one, and `\` escapes either.
//
// **Case-insensitive for ASCII, which is SQLite's rule and not PostgreSQL's** (there, `LIKE` is
// case-sensitive and `ILIKE` is the other one). The two real engines already disagree here, so a
// test that depends on it is engine-specific whatever this does; matching SQLite keeps `memdb`
// shadowing the engine it stands in for.
fn like_matches(subject: string, pattern: string, strict: bool) -> bool {
    if strict {
        // The standard compares characters under the collation, which for these purposes means
        // case-sensitively -- PostgreSQL's reading, and `ILIKE` is its separate insensitive form.
        return like_from(subject, 0, pattern, 0)
    }
    return like_from(to_lower(subject, invariant), 0, to_lower(pattern, invariant), 0)
}

fn like_from(s: string, si: int, p: string, pi: int) -> bool {
    var i = si
    var j = pi
    while j < prelude.len(p) {
        val pc = char_at(p, j)
        if pc == "%" {
            // Try every split, shortest first. A pattern of all `%` therefore costs one step, and
            // the backtracking only pays where a `%` is followed by something real.
            var k = i
            while k <= prelude.len(s) {
                if like_from(s, k, p, j + 1) {
                    return true
                }
                k = k + 1
            }
            return false
        }
        if i >= prelude.len(s) {
            return false
        }
        if pc == "_" {
            i = i + 1
            j = j + 1
            continue
        }
        if pc == "\\" && j + 1 < prelude.len(p) {
            if char_at(s, i) != char_at(p, j + 1) {
                return false
            }
            i = i + 1
            j = j + 2
            continue
        }
        if char_at(s, i) != pc {
            return false
        }
        i = i + 1
        j = j + 1
    }
    return i == prelude.len(s)
}

// The scalar functions this increment carries. `substr` and `length` are here because the sample
// application's own migrations call them 30 times each for a data conversion, and an engine that
// cannot run a real migration directory is not usable for the thing it was built for. The
// aggregates (`COUNT`, `SUM`, `MIN`, `MAX`) are the next increment and say so: an unknown name is
// an error, never a NULL.
fn eval_call(node: CallNode, cx: Ctx) -> Result<SqlValue, DbError> {
    val name = sql.fold_name(node.name)
    val args = mutable_array_new<SqlValue>()
    for a in node.args {
        push(args, try eval_expr(a, cx))
    }
    val given = snapshot(args)
    val count = prelude.len(given)
    if name == "coalesce" {
        for v in given {
            if !is_null(v) {
                return ok(v)
            }
        }
        return ok(SqlValue.Null)
    }
    // Every other function here answers NULL for a NULL argument, as both real engines do.
    for v in given {
        if is_null(v) {
            return ok(SqlValue.Null)
        }
    }
    if name == "length" {
        if count != 1 {
            return err(problem("length takes one argument"))
        }
        return switch given[0] {
            Bytes(b) { ok(SqlValue.Int(prelude.len(b))) }
            Text(text) { ok(SqlValue.Int(prelude.len(text))) }
            Int(n) { ok(SqlValue.Int(prelude.len(str(n)))) }
            Float(f) { ok(SqlValue.Int(prelude.len(str(f)))) }
            Bool(_) { ok(SqlValue.Int(1)) }
            Null { ok(SqlValue.Null) }
        }
    }
    if name == "substr" || name == "substring" {
        if count != 2 && count != 3 {
            return err(problem("substr takes two or three arguments"))
        }
        val text = text_of(given[0])
        val size = prelude.len(text)
        // SQL counts from 1, and a negative start counts back from the end.
        var from = unwrap_int(given[1])
        if from < 0 {
            from = size + from + 1
        }
        if from < 1 {
            from = 1
        }
        var upto = size
        if count == 3 {
            val wanted = unwrap_int(given[2])
            if wanted < 0 {
                return ok(SqlValue.Text(""))
            }
            upto = from - 1 + wanted
        }
        if upto > size {
            upto = size
        }
        if from - 1 >= upto {
            return ok(SqlValue.Text(""))
        }
        return ok(SqlValue.Text(substring(text, from - 1, upto)))
    }
    if name == "lower" {
        return ok(SqlValue.Text(to_lower(text_of(given[0]), invariant)))
    }
    if name == "upper" {
        return ok(SqlValue.Text(to_upper(text_of(given[0]), invariant)))
    }
    if name == "trim" {
        return ok(SqlValue.Text(trim(text_of(given[0]))))
    }
    if name == "abs" {
        val v = given[0]
        if is_int(v) {
            val n = unwrap_int(v)
            return ok(SqlValue.Int(if n < 0 { 0 - n } else { n }))
        }
        val f = as_number(v)
        return ok(SqlValue.Float(if f < 0.0 { 0.0 - f } else { f }))
    }
    return err(problem(prelude.format(
        "unsupported function: {} (this engine has substr, length, lower, upper, trim, abs and coalesce; the aggregates are the next increment)",
        node.name
    )))
}

fn eval_binary(node: BinNode, cx: Ctx) -> Result<SqlValue, DbError> {
    // AND and OR short-circuit on a decisive left side, which is also what keeps
    // `x IS NOT NULL AND x > 3` from reading a NULL as a number.
    if node.op == "AND" {
        val left = try eval_expr(node.left, cx)
        if !is_null(left) && !is_true(left) {
            return ok(SqlValue.Bool(false))
        }
        val right = try eval_expr(node.right, cx)
        if is_null(left) || is_null(right) {
            return if !is_null(right) && !is_true(right) { ok(SqlValue.Bool(false)) } else { ok(SqlValue.Null) }
        }
        return ok(SqlValue.Bool(is_true(left) && is_true(right)))
    }
    if node.op == "OR" {
        val left = try eval_expr(node.left, cx)
        if is_true(left) {
            return ok(SqlValue.Bool(true))
        }
        val right = try eval_expr(node.right, cx)
        if is_true(right) {
            return ok(SqlValue.Bool(true))
        }
        return if is_null(left) || is_null(right) { ok(SqlValue.Null) } else { ok(SqlValue.Bool(false)) }
    }
    val left = try eval_expr(node.left, cx)
    val right = try eval_expr(node.right, cx)
    // Every other operator is NULL when either side is: comparing or adding an unknown gives an
    // unknown. This is the rule that makes `WHERE col = NULL` match nothing, which surprises
    // people and is correct.
    if is_null(left) || is_null(right) {
        return ok(SqlValue.Null)
    }
    if node.op == "||" {
        return ok(SqlValue.Text(concat(text_of(left), text_of(right))))
    }
    // Comparing a number with text is a type error in the standard and in PostgreSQL ("operator
    // does not exist: integer = text"); SQLite orders the two by a type rank instead, which is
    // how a query that silently matches nothing gets written. The strict connection refuses it.
    if cx.strict && type_rank(left) != type_rank(right) && is_comparison(node.op) {
        return err(problem(prelude.format(
            "cannot compare {} with {} (the strict engine refuses what SQLite would order by type)",
            sql_type_of(left),
            sql_type_of(right)
        )))
    }
    if node.op == "=" {
        return ok(SqlValue.Bool(compare_values(left, right) == 0))
    }
    if node.op == "<>" {
        return ok(SqlValue.Bool(compare_values(left, right) != 0))
    }
    if node.op == "<" {
        return ok(SqlValue.Bool(compare_values(left, right) < 0))
    }
    if node.op == "<=" {
        return ok(SqlValue.Bool(compare_values(left, right) <= 0))
    }
    if node.op == ">" {
        return ok(SqlValue.Bool(compare_values(left, right) > 0))
    }
    if node.op == ">=" {
        return ok(SqlValue.Bool(compare_values(left, right) >= 0))
    }
    // Arithmetic stays in integers when both sides are, so `3 / 2` is 1 as it is in SQLite and
    // PostgreSQL, and becomes a float as soon as either side is one.
    val both_int = is_int(left) && is_int(right)
    if node.op == "+" || node.op == "-" || node.op == "*" {
        val a = as_number(left)
        val b = as_number(right)
        val f = if node.op == "+" { a + b } else if node.op == "-" { a - b } else { a * b }
        return if both_int { ok(SqlValue.Int(f as int)) } else { ok(SqlValue.Float(f)) }
    }
    if node.op == "/" {
        val b = as_number(right)
        if b == 0.0 {
            // The standard makes this an error (SQLSTATE 22012), which PostgreSQL raises and
            // SQLite does not -- it answers NULL. The strict connection follows the standard.
            if cx.strict {
                return err(problem("division by zero"))
            }
            return ok(SqlValue.Null)
        }
        return if both_int {
            ok(SqlValue.Int(unwrap_int(left) / unwrap_int(right)))
        } else {
            ok(SqlValue.Float(as_number(left) / b))
        }
    }
    return err(problem(prelude.format("unsupported operator '{}'", node.op)))
}

// A value as `||` renders it, which is how both real engines read a number in a concatenation.
fn text_of(v: SqlValue) -> string {
    return switch v {
        Text(s) { s }
        Int(n) { str(n) }
        Float(f) { str(f) }
        Bool(b) { if b { "1" } else { "0" } }
        Null { "" }
        Bytes(_) { "" }
    }
}

fn is_comparison(op: string) -> bool {
    return op == "=" || op == "<>" || op == "<" || op == "<=" || op == ">" || op == ">="
}

fn sql_type_of(v: SqlValue) -> string {
    return switch v {
        Null { "NULL" }
        Int(_) { "INTEGER" }
        Float(_) { "REAL" }
        Text(_) { "TEXT" }
        Bool(_) { "BOOLEAN" }
        Bytes(_) { "BLOB" }
    }
}

fn is_int(v: SqlValue) -> bool {
    return switch v {
        Int(_) { true }
        Bool(_) { true }
        Null { false }
        Float(_) { false }
        Text(_) { false }
        Bytes(_) { false }
    }
}

fn unwrap_int(v: SqlValue) -> int {
    return switch v {
        Int(n) { n }
        Bool(b) { if b { 1 } else { 0 } }
        Float(f) { f as int }
        Null { 0 }
        Text(_) { 0 }
        Bytes(_) { 0 }
    }
}

// ---------------------------------------------------------------- aggregates

// Every column an expression names, checked against the table before anything runs.
//
// **A real engine resolves columns when it prepares a statement, and this one looked them up as it
// read each row** -- so a query whose `WHERE` matched nothing never looked, and
// `SELECT count(age) FROM visit WHERE reason = 'nothing'` answered 0 where SQLite answers "no such
// column: age". A typo in a column name passing on `memdb` and failing on the real engine is the
// precise false green this whole arrangement exists to prevent, and the cross-check fixture caught
// it on its first run against the aggregates.
fn validate_expr(e: Expr, names: [string]) -> Result<unit, DbError> {
    return switch e {
        Col(ref) {
            if column_index(names, ref.name) < 0 {
                err(problem(concat("no such column: ", ref.name)))
            } else {
                unit
            }
        }
        Not(node) { validate_expr(node.inner, names) }
        IsNull(node) { validate_expr(node.inner, names) }
        Bin(node) {
            try validate_expr(node.left, names)
            validate_expr(node.right, names)
        }
        Like(node) {
            try validate_expr(node.subject, names)
            validate_expr(node.pattern, names)
        }
        Between(node) {
            try validate_expr(node.subject, names)
            try validate_expr(node.low, names)
            validate_expr(node.high, names)
        }
        In(node) {
            try validate_expr(node.subject, names)
            for o in node.options {
                try validate_expr(o, names)
            }
            unit
        }
        Case(node) {
            for arm in node.arms {
                try validate_expr(arm.condition, names)
                try validate_expr(arm.value, names)
            }
            for f in node.fallback {
                try validate_expr(f, names)
            }
            unit
        }
        Call(node) {
            for a in node.args {
                try validate_expr(a, names)
            }
            unit
        }
        Lit(_) { unit }
        Param(_) { unit }
        Star { unit }
    }
}

// A group's representative row, or no row at all for an empty group. An empty array literal
// needs its element type somewhere, and a function signature is the tidiest place to put it.
// A value on its way out to the caller.
//
// **SQLite has no boolean type**, so a comparison in a select list comes back as the integer 0 or
// 1; PostgreSQL and the standard have a real boolean and answer one. That makes it the fourth place
// the two readings part, and the lax one follows SQLite -- which is also why `db.sql_as_bool`
// accepts an `Int` of 0 or 1 in the first place.
//
// Only the projection is converted. Inside a `WHERE` or a `HAVING` a boolean stays a boolean,
// because nothing outside sees it.
fn present(v: SqlValue, strict: bool) -> SqlValue {
    if strict {
        return v
    }
    return switch v {
        Bool(b) { SqlValue.Int(if b { 1 } else { 0 }) }
        Null { v }
        Int(_) { v }
        Float(_) { v }
        Text(_) { v }
        Bytes(_) { v }
    }
}

fn first_row(rows: [[SqlValue]]) -> [SqlValue] {
    if prelude.len(rows) > 0 {
        return rows[0]
    }
    val none: [SqlValue] = []
    return none
}

fn is_aggregate(name: string) -> bool {
    val n = sql.fold_name(name)
    return n == "count" || n == "sum" || n == "min" || n == "max" || n == "avg"
}

// Whether an expression contains an aggregate anywhere, which is what decides that a `SELECT` with
// no `GROUP BY` is nonetheless one group over every matching row.
fn has_aggregate(e: Expr) -> bool {
    return switch e {
        Call(node) {
            if is_aggregate(node.name) {
                true
            } else {
                var found = false
                for a in node.args {
                    if has_aggregate(a) {
                        found = true
                    }
                }
                found
            }
        }
        Not(node) { has_aggregate(node.inner) }
        IsNull(node) { has_aggregate(node.inner) }
        Bin(node) { has_aggregate(node.left) || has_aggregate(node.right) }
        Like(node) { has_aggregate(node.subject) || has_aggregate(node.pattern) }
        Between(node) { has_aggregate(node.subject) || has_aggregate(node.low) || has_aggregate(node.high) }
        In(node) {
            var found = has_aggregate(node.subject)
            for o in node.options {
                if has_aggregate(o) {
                    found = true
                }
            }
            found
        }
        Case(node) {
            var found = false
            for arm in node.arms {
                if has_aggregate(arm.condition) || has_aggregate(arm.value) {
                    found = true
                }
            }
            for f in node.fallback {
                if has_aggregate(f) {
                    found = true
                }
            }
            found
        }
        Lit(_) { false }
        Col(_) { false }
        Param(_) { false }
        Star { false }
    }
}

// One aggregate over one group, by the standard's rules -- which both real engines follow, and
// which are the ones a reader guesses wrong:
//
//   - `COUNT(*)` counts **rows**, including a row whose every column is NULL;
//   - `COUNT(expr)` counts the rows where `expr` is **not** NULL;
//   - every other aggregate **ignores** NULLs rather than propagating them, unlike every scalar
//     operator in SQL;
//   - `SUM`, `MIN`, `MAX` and `AVG` over no surviving value are **NULL**, while `COUNT` is **0**.
//     That asymmetry is the one worth having written down: `SELECT SUM(x) FROM empty` is NULL and
//     `SELECT COUNT(x) FROM empty` is 0.
//
// `AVG` answers a float, as SQLite does; PostgreSQL answers `numeric` for an integer column, and
// the standard leaves the exact-numeric result type implementation-defined.
fn eval_aggregate(
    node: CallNode,
    names: [string],
    rows: [[SqlValue]],
    params: [SqlValue],
    strict: bool
) -> Result<SqlValue, DbError> {
    val name = sql.fold_name(node.name)
    if prelude.len(node.args) != 1 {
        return err(problem(prelude.format("{} takes one argument", node.name)))
    }
    val arg = node.args[0]
    if name == "count" && Expr.is_Star(arg) {
        return ok(SqlValue.Int(prelude.len(rows)))
    }
    val kept = mutable_array_new<SqlValue>()
    for row in rows {
        val v = try eval_expr(arg, ctx_of(names, row, params, strict))
        if !is_null(v) {
            push(kept, v)
        }
    }
    val values = snapshot(kept)
    if name == "count" {
        return ok(SqlValue.Int(prelude.len(values)))
    }
    if prelude.len(values) == 0 {
        return ok(SqlValue.Null)
    }
    if name == "min" || name == "max" {
        var best = values[0]
        for v in values {
            val c = compare_values(v, best)
            if (name == "min" && c < 0) || (name == "max" && c > 0) {
                best = v
            }
        }
        return ok(best)
    }
    var total = 0.0
    var all_int = true
    for v in values {
        total = total + as_number(v)
        if !is_int(v) {
            all_int = false
        }
    }
    if name == "avg" {
        return ok(SqlValue.Float(total / (prelude.len(values) as float)))
    }
    return if all_int { ok(SqlValue.Int(total as int)) } else { ok(SqlValue.Float(total)) }
}

// An expression evaluated for a whole group: an aggregate call folds the group's rows, and
// anything else is read from the group's first row.
//
// **Reading a non-grouped column is allowed here**, as SQLite allows it, where the standard and
// PostgreSQL require every bare column to be a grouping column. It is a laxness rather than a
// difference in answers for the queries this engine is for, and the strict connection does not
// tighten it -- that would need the parser to know which columns are grouped, which is the next
// increment's problem rather than this one's.
fn eval_grouped(
    e: Expr,
    names: [string],
    rows: [[SqlValue]],
    params: [SqlValue],
    strict: bool
) -> Result<SqlValue, DbError> {
    if Call(node) = e {
        if is_aggregate(node.name) {
            return eval_aggregate(node, names, rows, params, strict)
        }
    }
    if has_aggregate(e) {
        // An aggregate nested inside an expression: fold each piece for the group, then combine.
        return switch e {
            Not(node) {
                val inner = try eval_grouped(node.inner, names, rows, params, strict)
                if is_null(inner) { ok(SqlValue.Null) } else { ok(SqlValue.Bool(!is_true(inner))) }
            }
            IsNull(node) {
                val inner = try eval_grouped(node.inner, names, rows, params, strict)
                ok(SqlValue.Bool(if node.negated { !is_null(inner) } else { is_null(inner) }))
            }
            Bin(node) {
                val left = try eval_grouped(node.left, names, rows, params, strict)
                val right = try eval_grouped(node.right, names, rows, params, strict)
                // Folded to literals, then run through the ordinary binary evaluator so the NULL
                // rules and the strict checks are written once.
                eval_binary(
                    BinNode { op: node.op, left: Expr.Lit(left), right: Expr.Lit(right) },
                    ctx_of(names, first_row(rows), params, strict)
                )
            }
            Case(node) {
                var answer = SqlValue.Null
                var decided = false
                for arm in node.arms {
                    if !decided {
                        val test = try eval_grouped(arm.condition, names, rows, params, strict)
                        if is_true(test) {
                            answer = try eval_grouped(arm.value, names, rows, params, strict)
                            decided = true
                        }
                    }
                }
                if !decided && prelude.len(node.fallback) == 1 {
                    answer = try eval_grouped(node.fallback[0], names, rows, params, strict)
                }
                ok(answer)
            }
            Call(node) {
                val args = mutable_array_new<Expr>()
                for a in node.args {
                    push(args, Expr.Lit(try eval_grouped(a, names, rows, params, strict)))
                }
                eval_call(
                    CallNode { name: node.name, args: snapshot(args) },
                    ctx_of(names, first_row(rows), params, strict)
                )
            }
            Lit(v) { ok(v) }
            Col(_) { err(problem("unreachable: a column holds no aggregate")) }
            Param(_) { err(problem("unreachable: a parameter holds no aggregate")) }
            Star { err(problem("'*' is only allowed inside COUNT")) }
            Like(_) { err(problem("an aggregate inside LIKE is not supported")) }
            In(_) { err(problem("an aggregate inside IN is not supported")) }
            Between(_) { err(problem("an aggregate inside BETWEEN is not supported")) }
        }
    }
    return eval_expr(e, ctx_of(names, first_row(rows), params, strict))
}

// ---------------------------------------------------------------- running statements

// What a statement did: the database after it, the rows it answered and how many it changed.
struct Outcome {
    database: Database
    rows: [Row]
    affected: int
}

fn table_of(database: Database, name: string) -> Result<Table, DbError> {
    return switch get(database.tables, sql.fold_name(name)) {
        Some(t) { ok(t) }
        None { err(problem(concat("no such table: ", name))) }
    }
}

fn with_table(database: Database, t: Table) -> Database {
    return Database { tables: set(database.tables, sql.fold_name(t.name), t) }
}

fn column_names(t: Table) -> [string] {
    val out = mutable_array_new<string>()
    for c in t.columns {
        push(out, c.name)
    }
    return snapshot(out)
}

// The rows of `t` that `filter` keeps, as indexes into `t.rows` so an UPDATE or DELETE can work on
// positions rather than copies.
fn matching(t: Table, filter: Option<Expr>, params: [SqlValue], strict: bool) -> Result<[int], DbError> {
    val names = column_names(t)
    val out = mutable_array_new<int>()
    for i in 0..prelude.len(t.rows) {
        var keep = true
        if Some(e) = filter {
            keep = is_true(try eval_expr(e, ctx_of(names, t.rows[i], params, strict)))
        }
        if keep {
            push(out, i)
        }
    }
    return ok(snapshot(out))
}

fn run_create(database: Database, stmt: CreateStmt) -> Result<Outcome, DbError> {
    if contains(database.tables, sql.fold_name(stmt.table)) {
        if stmt.if_not_exists {
            return ok(Outcome { database: database, rows: [], affected: 0 })
        }
        return err(problem(concat("table already exists: ", stmt.table)))
    }
    val t = Table { name: stmt.table, columns: stmt.columns, rows: [] }
    return ok(Outcome { database: with_table(database, t), rows: [], affected: 0 })
}

fn run_alter(database: Database, stmt: AlterStmt) -> Result<Outcome, DbError> {
    val t = try table_of(database, stmt.table)
    if column_index(column_names(t), stmt.column.name) >= 0 {
        return err(problem(prelude.format("column {} already exists on {}", stmt.column.name, t.name)))
    }
    // Existing rows gain the new column's default, or NULL -- which is what the real engines do
    // for an added column, and why `NOT NULL` without a default is refused there and merely
    // recorded here.
    val filler = switch stmt.column.default_value {
        Some(v) { v }
        None { SqlValue.Null }
    }
    val rows = mutable_array_new<[SqlValue]>()
    for row in t.rows {
        push(rows, push(row, filler))
    }
    val grown = Table {
        name: t.name,
        columns: push(t.columns, stmt.column),
        rows: snapshot(rows)
    }
    return ok(Outcome { database: with_table(database, grown), rows: [], affected: 0 })
}

fn run_drop(database: Database, stmt: DropStmt) -> Result<Outcome, DbError> {
    if !contains(database.tables, sql.fold_name(stmt.table)) {
        if stmt.if_exists {
            return ok(Outcome { database: database, rows: [], affected: 0 })
        }
        return err(problem(concat("no such table: ", stmt.table)))
    }
    return ok(Outcome {
        database: Database { tables: remove(database.tables, sql.fold_name(stmt.table)) },
        rows: [],
        affected: 0
    })
}

fn run_insert(database: Database, stmt: InsertStmt, params: [SqlValue], strict: bool) -> Result<Outcome, DbError> {
    val t = try table_of(database, stmt.table)
    val names = column_names(t)
    // With no column list the values are positional, in declaration order.
    val targets = if prelude.len(stmt.columns) > 0 { stmt.columns } else { names }
    val positions = mutable_array_new<int>()
    for name in targets {
        val at = column_index(names, name)
        if at < 0 {
            return err(problem(prelude.format("no such column: {} on {}", name, t.name)))
        }
        push(positions, at)
    }
    val where_to = snapshot(positions)
    var rows = t.rows
    var added = 0
    for values in stmt.rows {
        if prelude.len(values) != prelude.len(where_to) {
            return err(problem(prelude.format(
                "{} values for {} columns",
                prelude.len(values),
                prelude.len(where_to)
            )))
        }
        // Start from each column's default (NULL where there is none), then place the values.
        val row = mutable_array_new<SqlValue>()
        for c in t.columns {
            push(row, switch c.default_value {
                Some(v) { v }
                None { SqlValue.Null }
            })
        }
        for i in 0..prelude.len(where_to) {
            // An INSERT's expressions see no row, so a column reference in one is an error rather
            // than a silent NULL.
            row[where_to[i]] = try eval_expr(values[i], ctx_of([], [], params, strict))
        }
        rows = push(rows, snapshot(row))
        added = added + 1
    }
    val filled = Table { name: t.name, columns: t.columns, rows: rows }
    return ok(Outcome { database: with_table(database, filled), rows: [], affected: added })
}

fn run_delete(database: Database, stmt: DeleteStmt, params: [SqlValue], strict: bool) -> Result<Outcome, DbError> {
    val t = try table_of(database, stmt.table)
    if Some(e) = stmt.filter {
        try validate_expr(e, column_names(t))
    }
    val doomed = to_set(try matching(t, stmt.filter, params, strict))
    val rows = mutable_array_new<[SqlValue]>()
    for i in 0..prelude.len(t.rows) {
        if !contains(doomed, i) {
            push(rows, t.rows[i])
        }
    }
    val left = Table { name: t.name, columns: t.columns, rows: snapshot(rows) }
    return ok(Outcome {
        database: with_table(database, left),
        rows: [],
        affected: prelude.len(doomed)
    })
}

fn run_update(database: Database, stmt: UpdateStmt, params: [SqlValue], strict: bool) -> Result<Outcome, DbError> {
    val t = try table_of(database, stmt.table)
    val names = column_names(t)
    if Some(e) = stmt.filter {
        try validate_expr(e, names)
    }
    for assignment in stmt.sets {
        try validate_expr(assignment.value, names)
    }
    val chosen = to_set(try matching(t, stmt.filter, params, strict))
    val rows = mutable_array_new<[SqlValue]>()
    for i in 0..prelude.len(t.rows) {
        if !contains(chosen, i) {
            push(rows, t.rows[i])
            continue
        }
        var row = t.rows[i]
        for assignment in stmt.sets {
            val at = column_index(names, assignment.column)
            if at < 0 {
                return err(problem(prelude.format("no such column: {} on {}", assignment.column, t.name)))
            }
            // Every assignment of one statement reads the row as it was before the statement,
            // which is what `SET a = b, b = a` means in SQL.
            row = set(row, at, try eval_expr(assignment.value, ctx_of(names, t.rows[i], params, strict)))
        }
        push(rows, row)
    }
    val changed = Table { name: t.name, columns: t.columns, rows: snapshot(rows) }
    return ok(Outcome {
        database: with_table(database, changed),
        rows: [],
        affected: prelude.len(chosen)
    })
}

// The output column name for a select item: its alias, else the column it names, else its
// position -- which is roughly what SQLite does and close enough for a test to read by name.
fn item_name(item: SelectItem, at: int) -> string {
    if item.alias != "" {
        return item.alias
    }
    return switch item.expr {
        Col(ref) { ref.name }
        Lit(_) { prelude.format("column{}", at + 1) }
        Param(_) { prelude.format("column{}", at + 1) }
        Not(_) { prelude.format("column{}", at + 1) }
        Bin(_) { prelude.format("column{}", at + 1) }
        IsNull(_) { prelude.format("column{}", at + 1) }
        Call(node) { node.name }
        Like(_) { prelude.format("column{}", at + 1) }
        In(_) { prelude.format("column{}", at + 1) }
        Between(_) { prelude.format("column{}", at + 1) }
        Case(_) { prelude.format("column{}", at + 1) }
        Star { "*" }
    }
}

fn run_select(database: Database, stmt: SelectStmt, params: [SqlValue], strict: bool) -> Result<Outcome, DbError> {
    // No `FROM`: one row of no columns, which is what makes `SELECT 1` answer a single 1.
    if stmt.table == "" {
        val names = mutable_array_new<string>()
        val values = mutable_array_new<SqlValue>()
        for i in 0..prelude.len(stmt.items) {
            push(names, item_name(stmt.items[i], i))
            push(values, present(try eval_expr(stmt.items[i].expr, ctx_of([], [], params, strict)), strict))
        }
        val one = Row { columns: snapshot(names), values: snapshot(values) }
        return ok(Outcome { database: database, rows: [one], affected: 0 })
    }
    val t = try table_of(database, stmt.table)
    val names = column_names(t)
    for item in stmt.items {
        try validate_expr(item.expr, names)
    }
    if Some(e) = stmt.filter {
        try validate_expr(e, names)
    }
    for g in stmt.groups {
        try validate_expr(g, names)
    }
    if Some(e) = stmt.having {
        try validate_expr(e, names)
    }
    for term in stmt.order {
        try validate_expr(term.expr, names)
    }
    var chosen = try matching(t, stmt.filter, params, strict)

    // Aggregated when anything asks for it: a GROUP BY, a HAVING, or an aggregate in the select
    // list. With none of those the ordinary row-at-a-time path runs below.
    var aggregated = prelude.len(stmt.groups) > 0 || Option.is_Some(stmt.having)
    for item in stmt.items {
        if has_aggregate(item.expr) {
            aggregated = true
        }
    }
    if aggregated {
        return run_grouped(database, t, names, stmt, chosen, params, strict)
    }

    if prelude.len(stmt.order) > 0 {
        // Sorted by evaluating each term per row. `sort_with` is a stable sort, so equal keys keep
        // insertion order and a second ORDER BY term is only consulted where the first ties.
        val terms = stmt.order
        // A comparator cannot fail, and evaluating an ORDER BY term can, so the failure comes out
        // in a cell: a lambda captures by value and cannot touch an enclosing `var`, which is the
        // language saying that a closure and its enclosing function never share mutable state.
        val failure = mutable_new<string>("")
        chosen = sort_with(chosen, fn(a: int, b: int) -> int {
            for term in terms {
                val left = eval_expr(term.expr, ctx_of(names, t.rows[a], params, strict))
                val right = eval_expr(term.expr, ctx_of(names, t.rows[b], params, strict))
                if Err(e) = left {
                    set(failure, db_message(e))
                    return 0
                }
                if Err(e) = right {
                    set(failure, db_message(e))
                    return 0
                }
                val c = compare_values(unwrap(left), unwrap(right))
                if c != 0 {
                    return if term.descending { 0 - c } else { c }
                }
            }
            return 0
        })
        if get(failure) != "" {
            return err(problem(get(failure)))
        }
    }

    var from = 0
    if Some(e) = stmt.offset {
        from = unwrap_int(try eval_expr(e, ctx_of([], [], params, strict)))
    }
    var upto = prelude.len(chosen)
    if Some(e) = stmt.limit {
        val count = unwrap_int(try eval_expr(e, ctx_of([], [], params, strict)))
        if count >= 0 && from + count < upto {
            upto = from + count
        }
    }
    if from > prelude.len(chosen) {
        from = prelude.len(chosen)
    }
    if upto < from {
        upto = from
    }

    // `SELECT *` on its own expands to the table's columns; otherwise each item is one column.
    var out_names = mutable_array_new<string>()
    val star = prelude.len(stmt.items) == 1 && Expr.is_Star(stmt.items[0].expr)
    if star {
        out_names = mutable_array_new<string>()
        for name in names {
            push(out_names, name)
        }
    } else {
        for i in 0..prelude.len(stmt.items) {
            push(out_names, item_name(stmt.items[i], i))
        }
    }
    val headers = snapshot(out_names)

    val rows = mutable_array_new<Row>()
    for k in from..upto {
        val source = t.rows[chosen[k]]
        val values = mutable_array_new<SqlValue>()
        if star {
            for v in source {
                push(values, v)
            }
        } else {
            for item in stmt.items {
                push(values, present(try eval_expr(item.expr, ctx_of(names, source, params, strict)), strict))
            }
        }
        push(rows, Row { columns: headers, values: snapshot(values) })
    }
    return ok(Outcome { database: database, rows: snapshot(rows), affected: 0 })
}

// The grouped form of `run_select`: partition, fold, filter, order, slice, project.
//
// With no `GROUP BY` there is **one** group holding every matching row -- including when there are
// none, which is what makes `SELECT COUNT(*) FROM empty` answer one row of 0 rather than no rows
// at all. With a `GROUP BY` and no matching rows there are no groups and no rows, which is the
// other half of the same rule.
fn run_grouped(
    database: Database,
    t: Table,
    names: [string],
    stmt: SelectStmt,
    chosen: [int],
    params: [SqlValue],
    strict: bool
) -> Result<Outcome, DbError> {
    // Groups in first-appearance order, each a key and the rows that share it. A list searched
    // linearly rather than a Map: a key is several `SqlValue`s compared by SQL's rules, and
    // rendering that to a map key would mean inventing a canonical form for every type.
    val keys = mutable_array_new<[SqlValue]>()
    val members = mutable_array_new<[[SqlValue]]>()
    if prelude.len(stmt.groups) == 0 {
        val all = mutable_array_new<[SqlValue]>()
        for i in chosen {
            push(all, t.rows[i])
        }
        val no_key: [SqlValue] = []
        push(keys, no_key)
        push(members, snapshot(all))
    } else {
        for i in chosen {
            val row = t.rows[i]
            val key = mutable_array_new<SqlValue>()
            for g in stmt.groups {
                push(key, try eval_expr(g, ctx_of(names, row, params, strict)))
            }
            val wanted = snapshot(key)
            var at = 0 - 1
            for k in 0..prelude.len(keys) {
                if at < 0 {
                    var same = true
                    for j in 0..prelude.len(wanted) {
                        // Two NULL keys group together, which is what both engines do even though
                        // `NULL = NULL` is unknown: grouping compares for *distinctness*, not with
                        // the equality operator.
                        val a = keys[k][j]
                        val b = wanted[j]
                        if is_null(a) != is_null(b) {
                            same = false
                        } else if !is_null(a) && compare_values(a, b) != 0 {
                            same = false
                        }
                    }
                    if same {
                        at = k
                    }
                }
            }
            if at < 0 {
                push(keys, wanted)
                push(members, [row])
            } else {
                members[at] = push(members[at], row)
            }
        }
    }
    val grouped = snapshot(members)

    // HAVING filters whole groups, after the fold rather than before it.
    val surviving = mutable_array_new<[[SqlValue]]>()
    for rows in grouped {
        var keep = true
        if Some(e) = stmt.having {
            keep = is_true(try eval_grouped(e, names, rows, params, strict))
        }
        if keep {
            push(surviving, rows)
        }
    }
    var ordered = snapshot(surviving)

    if prelude.len(stmt.order) > 0 {
        val terms = stmt.order
        val failure = mutable_new<string>("")
        ordered = sort_with(ordered, fn(a: [[SqlValue]], b: [[SqlValue]]) -> int {
            for term in terms {
                val left = eval_grouped(term.expr, names, a, params, strict)
                val right = eval_grouped(term.expr, names, b, params, strict)
                if Err(e) = left {
                    set(failure, db_message(e))
                    return 0
                }
                if Err(e) = right {
                    set(failure, db_message(e))
                    return 0
                }
                val c = compare_values(unwrap(left), unwrap(right))
                if c != 0 {
                    return if term.descending { 0 - c } else { c }
                }
            }
            return 0
        })
        if get(failure) != "" {
            return err(problem(get(failure)))
        }
    }

    var from = 0
    if Some(e) = stmt.offset {
        from = unwrap_int(try eval_expr(e, ctx_of([], [], params, strict)))
    }
    var upto = prelude.len(ordered)
    if Some(e) = stmt.limit {
        val count = unwrap_int(try eval_expr(e, ctx_of([], [], params, strict)))
        if count >= 0 && from + count < upto {
            upto = from + count
        }
    }
    if from > prelude.len(ordered) {
        from = prelude.len(ordered)
    }
    if upto < from {
        upto = from
    }

    val headers = mutable_array_new<string>()
    for i in 0..prelude.len(stmt.items) {
        push(headers, item_name(stmt.items[i], i))
    }
    val columns = snapshot(headers)
    val out = mutable_array_new<Row>()
    for k in from..upto {
        val values = mutable_array_new<SqlValue>()
        for item in stmt.items {
            push(values, present(try eval_grouped(item.expr, names, ordered[k], params, strict), strict))
        }
        push(out, Row { columns: columns, values: snapshot(values) })
    }
    return ok(Outcome { database: database, rows: snapshot(out), affected: 0 })
}

fn db_message(e: DbError) -> string {
    return switch e {
        NotFound(m) { m }
        Constraint(m) { m }
        Connection(m) { m }
        Sql(m) { m }
    }
}

// ---------------------------------------------------------------- the connection

// A connection's state: the database, and the database as it was when a transaction began.
//
// **This is where a database being a value pays for itself.** `BEGIN` keeps the current `Database`,
// `ROLLBACK` puts it back and `COMMIT` forgets it -- no undo log, no copying, because the saved
// value *is* the old state. The same property is what will make per-test forking free: seed a
// schema and a dataset once, then hand each test its own copy.
struct State {
    database: Mutable<Database>
    saved: Mutable<[Database]>
    // Which reading of SQL this connection takes: see `Ctx.strict` and the two drivers below.
    strict: bool
}

fn run_one(state: State, sql: string, params: [SqlValue]) -> Result<Outcome, DbError> {
    val stmt = try sql.parse(sql)
    val before = get(state.database)
    return switch stmt {
        Begin {
            set(state.saved, push(get(state.saved), before))
            ok(Outcome { database: before, rows: [], affected: 0 })
        }
        Commit {
            val depth = prelude.len(get(state.saved))
            if depth > 0 {
                set(state.saved, slice(get(state.saved), 0, depth - 1))
            }
            ok(Outcome { database: before, rows: [], affected: 0 })
        }
        Rollback {
            val stack = get(state.saved)
            val depth = prelude.len(stack)
            if depth == 0 {
                ok(Outcome { database: before, rows: [], affected: 0 })
            } else {
                set(state.saved, slice(stack, 0, depth - 1))
                ok(Outcome { database: stack[depth - 1], rows: [], affected: 0 })
            }
        }
        // A statement this engine has nothing to do about: a setting, an empty statement, or an
        // index, which decides how fast a query runs and not what it answers.
        Passthrough(_) { ok(Outcome { database: before, rows: [], affected: 0 }) }
        CreateIndex(_) { ok(Outcome { database: before, rows: [], affected: 0 }) }
        Create(s) { run_create(before, s) }
        Alter(s) { run_alter(before, s) }
        Drop(s) { run_drop(before, s) }
        Insert(s) { run_insert(before, s, params, state.strict) }
        Update(s) { run_update(before, s, params, state.strict) }
        Delete(s) { run_delete(before, s, params, state.strict) }
        Select(s) { run_select(before, s, params, state.strict) }
    }
}

// Runs `sql` and keeps whatever it changed. A statement that fails leaves the database untouched,
// because the new value is only published when the whole statement succeeded.
fn apply(state: State, sql: string, params: [SqlValue]) -> Result<Outcome, DbError> {
    val outcome = try run_one(state, sql, params)
    set(state.database, outcome.database)
    return ok(outcome)
}

// ---------------------------------------------------------------- the driver

// This engine as a `db.Driver`, for `datasource.registry([memdb.driver()])`.
//
// The URL is `memdb:` with anything after it ignored, so `memdb:` and `memdb:whatever` are both a
// fresh empty database. There is no sharing between connections and no file: like
// `sqlite::memory:`, a connection *is* the database, which is why `poolable` says no -- a pool of
// four would be four different databases.
pub fn driver() -> Driver {
    return engine("memdb:", false)
}

// The same engine reading SQL the way the **standard** does, at `memdb-ansi:`. Three things
// differ, and they are the three where SQLite departs from ANSI:
//
//   - `LIKE` is case-sensitive, as the standard and PostgreSQL have it, where SQLite folds ASCII;
//   - division by zero is an error (SQLSTATE 22012's rule), where SQLite answers NULL;
//   - comparing a number with text is a type error, where SQLite orders them by a type rank.
//
// **It is a portability check, not a better engine.** A suite that passes on `memdb:` and fails on
// `memdb-ansi:` has found SQL that leans on SQLite, which matters when the same application also
// ships on PostgreSQL -- and finding it costs a second local run rather than a Postgres container.
// Both report the dialect `memdb`, so migrations and `migrate`'s type tokens work for either.
pub fn strict_driver() -> Driver {
    return engine("memdb-ansi:", true)
}

fn engine(prefix: string, strict: bool) -> Driver {
    return Driver {
        name: "memdb",
        prefixes: [prefix],
        poolable: fn(url: string) -> bool { return false },
        // Nothing here can go stale: there is no socket and no file, only a value in this process.
        idle_check: false,
        open: fn(url: string) -> Result<Conn, DbError> {
            val state = State {
                database: mutable_new(empty_database()),
                saved: mutable_new<[Database]>([]),
                strict: strict
            }
            return ok(Conn {
                dialect: "memdb",
                close: fn() {},
                execute: fn(sql: string, params: [SqlValue]) -> Result<int, DbError> {
                    return ok((try apply(state, sql, params)).affected)
                },
                query: fn(sql: string, params: [SqlValue]) -> Result<[Row], DbError> {
                    return ok((try apply(state, sql, params)).rows)
                },
                rows: fn(sql: string, params: [SqlValue]) -> Result<Iter<Result<Row, DbError>>, DbError> {
                    // Every row is already in memory, so the lazy form hands them out one at a
                    // time from the array rather than pretending to be a cursor.
                    val all = (try apply(state, sql, params)).rows
                    val at = mutable_new(0)
                    return ok(iter_from<Result<Row, DbError>>(
                        fn() -> Option<Result<Row, DbError>> {
                            val i = get(at)
                            if i >= prelude.len(all) {
                                return Option<Result<Row, DbError>>.None
                            }
                            set(at, i + 1)
                            return Option<Result<Row, DbError>>.Some(ok(all[i]))
                        },
                        fn() {}
                    ))
                }
            })
        }
    }
}
