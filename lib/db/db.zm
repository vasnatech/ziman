// db.zm -- what every database module shares: the value, row and error types, the readers that turn a
// `SqlValue` into an ordinary value, and the parser for database URLs. `sqlite`, `pg` and `mysql` are
// built on it, and so is `datasource`, the module a program calls (`datasource.open`, `datasource.query`, ...), which
// resolves a URL to one of the `Driver`s an application registered and pools connections. `Driver` and `Conn` below are
// that contract: they are why `datasource` names no engine. Anything that maps its own types to and from SQL (`uuid`, `time`,
// `#[derive(Row)]`-generated code) uses this module alone, so it needs no driver.
//
// Only primitives cross the driver boundary: NULL, integer, float, text, bool, and bytes. Uuid,
// LocalDate, Instant, decimal and bigint all travel as `Text` and are converted by the mapping layer --
// that sidesteps every dialect difference in how SQLite and Postgres type those (SQLite has no UUID or
// timestamp type at all).
//
// The URL parser reads `scheme://user[:password]@host[:port]/database[?k=v&...]`. User, password,
// database and query names *and* values are percent-decoded, so a password may contain `@`, `:` or `/`
// when written as %40, %3A, %2F (a literal `@` in the password also works: the LAST `@` separates
// userinfo from host). With no database, the user's name stands in, as Postgres itself does.
//
// **A host may be a bracketed IPv6 literal**, `[::1]:5432`; the brackets keep the address's own colons
// out of the host/port split and are not part of the address, so `host` holds the bare `::1` -- which is
// what `net.connect` resolves (it answers "host not found" for the bracketed form).
//
// **A port must be in 1..65535, and a query parameter must have a `=`.** Both are refused here rather
// than carried into a driver: a port of `0` or `70000` reaches `net.connect` and comes back as a
// connection problem rather than a typo, and a parameter with no value is dropped in silence -- which
// matters because both drivers read `sslmode` from these and default it to `disable` when it is absent,
// so `?sslmode` instead of `?sslmode=require` would be an unencrypted connection with nothing said.

use net
use net.net_error_message
use number.byte_from_hex
use url

// ---------------------------------------------------------------- the driver contract

// One open connection, as the four functions `datasource` needs from it.
//
// **Every field is a closure that already holds the driver's own connection**, and that is what
// lets `datasource` drive an engine it cannot name: there is no type here for a
// `sqlite.Connection` or a `pg.Connection` to be, so none has to exist. Before this, `datasource`
// held an enum of the three concrete connection types and switched over it in five places, which
// made it the one module that had to change whenever an engine was added.
//
// **`close` belongs here and not on `Driver`** -- that is the one forced move in the shape. A
// `close(connection)` on the driver would need a parameter type for the connection, which is
// exactly the concrete type the closure is hiding; as a closure with no arguments it needs none.
//
// `dialect` rides along because `migrate` asks for it, and reading it from the connection is what
// lets a pool answer without re-parsing its URL.
pub struct Conn {
    dialect: string
    close: fn()
    execute: fn(string, [SqlValue]) -> Result<int, DbError>
    query: fn(string, [SqlValue]) -> Result<[Row], DbError>
    rows: fn(string, [SqlValue]) -> Result<Iter<Result<Row, DbError>>, DbError>
}

// One engine, as an application hands it over: `datasource.registry([sqlite.driver(), pg.driver()])`.
// A program that talks to SQLite alone names SQLite alone, and nothing it links pulls in `pg` or
// `mysql`.
//
// `name` is the dialect too, deliberately one field rather than two: `migrate` compares it against
// "sqlite", "postgres" and "mysql", and a separate `dialect` could drift from the name.
//
// `prefixes` is how a URL finds its engine, so each engine owns its own URL spelling -- `sqlite`
// strips its own `sqlite:` rather than having `datasource` do it with a `substring(url, 7, ..)`.
//
// `poolable` answers whether several connections to this URL would be the same database. Only
// SQLite says no, and only for `:memory:`, where each connection is a private database and a pool
// of four would be four different ones. Asking the driver puts that where the knowledge is.
//
// `idle_check` answers whether a connection that has sat idle is worth testing before it is lent
// out again. A connection over a socket can be closed from the far end while nobody is looking;
// an open file cannot, so SQLite says no. It is a plain `bool` where `poolable` is a function
// because it is a fact about the engine, while poolability is a fact about the URL.
pub struct Driver {
    name: string
    prefixes: [string]
    poolable: fn(string) -> bool
    idle_check: bool
    open: fn(string) -> Result<Conn, DbError>
}

// ---------------------------------------------------------------- values, rows, errors

// One database value: SQL NULL, an integer, a float, text, a boolean or a blob.
pub enum SqlValue {
    Null
    Int(int)
    Float(float)
    Text(string)
    Bool(bool)
    Bytes([byte])
}

// What a database call can fail with. `NotFound` isn't something a
// driver raises -- it's for a repository whose lookup came back empty,
// kept here so one error type covers the whole data-access layer.
// `Constraint` is a unique/foreign-key/not-null/check violation (the
// caller did something the schema forbids); `Connection` is failing to
// reach or open the database at all; `Sql` is everything else (bad
// syntax, wrong parameter count, a value of the wrong SQL type).
pub enum DbError {
    NotFound(string)
    Constraint(string)
    Connection(string)
    Sql(string)
}

// One result row: `values[i]` belongs to column `columns[i]`.
pub struct Row {
    columns: [string]
    values: [SqlValue]
}

// `e` as a sentence for a log line or a response, prefixed by its kind (`NotFound` is the bare
// message).
pub fn db_error_message(e: DbError) -> string {
    return switch e {
        NotFound(msg) { msg }
        Constraint(msg) { concat("constraint violation: ", msg) }
        Connection(msg) { concat("database connection error: ", msg) }
        Sql(msg) { concat("database error: ", msg) }
    }
}

// The value of column `column` in `row`, or a DbError.Sql naming the missing column.
pub fn row_get(row: Row, column: string) -> Result<SqlValue, DbError> {
    var i = 0
    while i < len(row.columns) {
        if row.columns[i] == column {
            return row.values[i]
        }
        i = i + 1
    }
    return err(DbError.Sql(concat("no such column in result row: ", column)))
}

fn sql_type_name(v: SqlValue) -> string {
    return switch v {
        Null { "NULL" }
        Int(_) { "INTEGER" }
        Float(_) { "FLOAT" }
        Text(_) { "TEXT" }
        Bool(_) { "BOOL" }
        Bytes(_) { "BYTES" }
    }
}

fn sql_mismatch(expected: string, v: SqlValue) -> DbError {
    return DbError.Sql(format("expected {}, found {}", expected, sql_type_name(v)))
}

// The text of a TEXT value, or a DbError.Sql saying what was found instead.
pub fn sql_as_text(v: SqlValue) -> Result<string, DbError> {
    if Text(s) = v {
        return s
    }
    return err(sql_mismatch("TEXT", v))
}

// The number in an INTEGER value, or a DbError.Sql saying what was found instead.
pub fn sql_as_int(v: SqlValue) -> Result<int, DbError> {
    if Int(n) = v {
        return n
    }
    return err(sql_mismatch("INTEGER", v))
}

// SQLite hands an integer column back for a value stored as 0/1 where
// Postgres would say Bool -- accept an integer that's exactly 0 or 1 too.
pub fn sql_as_bool(v: SqlValue) -> Result<bool, DbError> {
    if Bool(b) = v {
        return b
    }
    if Int(n) = v {
        if n == 0 {
            return false
        }
        if n == 1 {
            return true
        }
    }
    return err(sql_mismatch("BOOL", v))
}

// A whole-number column read as a float, or a float column as itself.
pub fn sql_as_float(v: SqlValue) -> Result<float, DbError> {
    if Float(f) = v {
        return f
    }
    if Int(n) = v {
        return n as float
    }
    return err(sql_mismatch("FLOAT", v))
}

// A decimal column: TEXT holding decimal text (how `#[derive(Row)]` writes one, keeping its scale), or a whole-number or float
// column read as a decimal.
pub fn sql_as_decimal(v: SqlValue) -> Result<decimal, DbError> {
    if Text(s) = v {
        return sql_lift<decimal>(parse_decimal(s), "decimal")
    }
    if Int(n) = v {
        return n as decimal
    }
    if Float(f) = v {
        return f as decimal
    }
    return err(sql_mismatch("DECIMAL", v))
}

// Lifts a domain type's own parse result (Result<T, string>, e.g.
// uuid.parse) into the DbError error type a from_sql needs.
pub fn sql_lift<T>(r: Result<T, string>, what: string) -> Result<T, DbError> {
    switch r {
        Ok(v) { return ok(v) }
        Err(msg) { return err(DbError.Sql(format("invalid {} value: {}", what, msg))) }
    }
}

// ---------------------------------------------------------------- URLs

// One `name=value` pair from the query part of a database URL, already decoded.
pub struct UrlParam {
    name: string
    value: string
}

// A parsed database URL: the decoded credentials, host, port (0 when the URL names none), database
// and query parameters.
pub struct DbUrl {
    user: string
    password: string
    host: string
    port: int
    database: string
    params: [UrlParam]
}

fn bad(message: string) -> DbError {
    return DbError.Connection(message)
}

// Decodes `%XX` escapes in `s`; an Err for a malformed escape or one that yields a NUL byte. The loop is
// `url.percent_decode`, shared with `http`; this wraps its message in the `DbError` the rest of this module
// answers with, and says which URL was at fault, which a caller cannot work out from "bad %-escape" alone.
// `+` is a literal plus here: a database URL is not a query string.
pub fn percent_decode(s: string) -> Result<string, DbError> {
    return switch url.percent_decode(s, false) {
        Ok(decoded) { ok(decoded) }
        Err(message) { err(bad(format("{} in database URL: {}", message, s))) }
    }
}

// The query parameter `name`, if the URL has it.
pub fn url_param(u: DbUrl, name: string) -> Option<string> {
    for p in u.params {
        if p.name == name {
            return Option<string>.Some(p.value)
        }
    }
    return Option<string>.None
}

// `prefixes` are the accepted `scheme://` starts (e.g. "postgres://").
// The database defaults to the user name when the URL has none.
pub fn parse_url(url: string, prefixes: [string], default_port: int) -> Result<DbUrl, DbError> {
    var rest = ""
    var matched = false
    for prefix in prefixes {
        if !matched && starts_with(url, prefix) {
            rest = substring(url, len(prefix), len(url))
            matched = true
        }
    }
    if !matched {
        return err(bad(concat("unsupported database URL: ", url)))
    }

    var path_and_query = ""
    var authority = rest
    val slash = split_once(rest, "/")
    if Some(parts) = slash {
        authority = parts[0]
        path_and_query = parts[1]
    }
    var database = path_and_query
    val params = mutable_array_new<UrlParam>()
    val q = split_once(path_and_query, "?")
    if Some(parts) = q {
        database = parts[0]
        for pair in split(parts[1], "&") {
            // An empty piece is what a trailing `&`, a `&&` or a bare `?` leaves behind, and
            // skipping it is the ordinary reading.
            if pair == "" {
                continue
            }
            val kv = split_once(pair, "=")
            if Some(kv) = kv {
                // **The name is decoded too.** Only the value was, so `?a%2Db=1` produced a
                // parameter literally named `a%2Db` and `url_param(u, "a-b")` answered None --
                // asking for a name as written in the URL was the one way not to find it.
                push(params, UrlParam {
                    name: try percent_decode(kv[0]),
                    value: try percent_decode(kv[1])
                })
            } else {
                // **Silently dropped until now, and the consequence was not silent.** Both
                // drivers default `sslmode` to "disable" when the parameter is absent, so
                // `?sslmode` -- a plain typo for `?sslmode=require` -- became an unencrypted
                // connection with nothing said. A database URL is configuration read once at
                // startup; a loud error there beats a quiet downgrade afterwards.
                return err(bad(concat("database URL parameter has no '=': ", pair)))
            }
        }
    }

    val at = last_index_of(authority, "@")
    var userinfo = ""
    var hostport = authority
    if at >= 0 {
        userinfo = substring(authority, 0, at)
        hostport = substring(authority, at + 1, len(authority))
    }
    var user = userinfo
    var password = ""
    val up = split_once(userinfo, ":")
    if Some(parts) = up {
        user = parts[0]
        password = parts[1]
    }
    var host = hostport
    var port_text = ""
    var have_port = false
    if starts_with(hostport, "[") {
        // **A bracketed IPv6 literal**, `[::1]:5432`. Splitting at the first `:` made the host `[`
        // and the port `:1]:5432`, so every IPv6 URL was refused with a message about its port.
        // The brackets exist precisely to keep the address's own colons out of the host/port
        // split, and they are not part of the address: `net.connect("::1", p)` resolves and
        // answers "connection refused", `net.connect("[::1]", p)` answers "host not found", so
        // what the driver is handed has to be the bare form.
        val close = index_of(hostport, "]", 0)
        if close < 0 {
            return err(bad(concat("no ']' closing the IPv6 host in database URL: ", hostport)))
        }
        host = substring(hostport, 1, close)
        val after = substring(hostport, close + 1, len(hostport))
        if after != "" {
            if !starts_with(after, ":") {
                return err(bad(concat("unexpected text after the IPv6 host in database URL: ", after)))
            }
            port_text = substring(after, 1, len(after))
            have_port = true
        }
    } else {
        val hp = split_once(hostport, ":")
        if Some(parts) = hp {
            host = parts[0]
            port_text = parts[1]
            have_port = true
        }
    }
    var port = default_port
    if have_port {
        val parsed_port = parse_int(port_text)
        if !is_ok(parsed_port) {
            return err(bad(concat("bad port in database URL: ", port_text)))
        }
        port = unwrap(parsed_port)
        // A port outside 1..65535 is not a port. `0`, `-1` and `70000` were all carried to
        // `net.connect` to fail there, which reports a connection problem for what is a typo in a
        // URL -- and the two read very differently at three in the morning.
        if port < 1 || port > 65535 {
            return err(bad(format("port {} in database URL is not in 1..65535", port)))
        }
    }
    val user_decoded = try percent_decode(user)
    val password_decoded = try percent_decode(password)
    val database_decoded = try percent_decode(database)
    if user_decoded == "" {
        return err(bad("database URL has no user name"))
    }
    if host == "" {
        return err(bad("database URL has no host"))
    }
    var db_name = database_decoded
    if db_name == "" {
        db_name = user_decoded
    }
    return DbUrl {
        user: user_decoded,
        password: password_decoded,
        host: host,
        port: port,
        database: db_name,
        params: snapshot(params)
    }
}

// ---------------------------------------------------------------- what the network drivers share

// `pg` and `mysql` each run a connection on one spawned thread that owns the socket, and talk to it through a
// channel of `Request`s; the types and the client half of that (running a statement, reading a cursor as an
// `Iter`) are here so the two drivers do not carry the same code twice.

// What a statement produced: its rows and how many rows it changed.
pub struct QueryResult {
    rows: [Row]
    affected: int
}

// A statement sent to the thread that owns the connection, with the channel to answer on.
// `internal`, not `pub`, from here through `run_request` below: the driver-thread wire protocol
// between a `Connection` and the thread that owns it, not something a caller of `db`/`datasource`
// ever constructs directly -- see docs/DESIGN.md's visibility entry. `mysql.zm`/`pg.zm` can
// still reach it, since both are bundled core modules, the same package as `db.zm`.
internal struct RunRequest {
    sql: string
    params: [SqlValue]
    reply_to: Channel<Result<QueryResult, DbError>>
}

// One batch of a cursor's rows, decoded, whether the server has no more, and the cursor's number (each
// cursor a connection opens gets the next one, so a late message about a finished cursor cannot touch
// the cursor that replaced it).
internal struct Page {
    rows: [Row]
    finished: bool
    cursor: int
}

// Starts a cursor on the owning thread: run `sql` and answer with its first page.
internal struct OpenRequest {
    sql: string
    params: [SqlValue]
    reply_to: Channel<Result<Page, DbError>>
}

// Asks the owning thread for the next page of the open cursor.
internal struct FetchRequest {
    cursor: int
    reply_to: Channel<Result<Page, DbError>>
}

// Asks the owning thread to end the open cursor, if there is one; answered when the connection is
// ready for the next statement.
internal struct EndRequest {
    cursor: int
    reply_to: Channel<int>
}

// A message to a connection's owning thread: run a statement, work a cursor, or close the connection.
internal enum Request {
    Run(RunRequest)
    OpenCursor(OpenRequest)
    FetchCursor(FetchRequest)
    EndCursor(EndRequest)
    Close
}

// How long a caller waits for its owning thread's answer before deciding the thread is gone.
//
// **Not a statement timeout.** It is a liveness backstop, and ten minutes is chosen to be longer
// than any statement this library is meant to carry, so that it never cuts a slow query short. The
// hang it exists for is narrow: a driver's `serve` thread dies of a runtime error, its `on_error`
// handler answers every request already queued (see `fail_pending`), and a request sent in the
// window between those two events has nobody left to answer it. Before this, that caller waited
// for ever -- and the deadlock detector could not save it, because it only fires when *every* live
// thread is blocked on a channel, and in a server the other threads are legitimately blocked on
// sockets (A47). A statement timeout is a real feature and belongs on `ServeOptions`-style
// configuration, not here.
internal val reply_timeout_millis = 600000

// The error a caller gets when its owning thread never answered.
internal fn owner_gone<T>() -> Result<T, DbError> {
    return err(DbError.Connection(concat(
        "the connection's owning thread stopped answering (no reply in ",
        format("{}", reply_timeout_millis / 1000),
        "s); the connection is no longer usable"
    )))
}

// Answers every request still queued on `requests` with a connection error, so a caller blocked on
// its own reply channel is woken rather than waiting for a thread that has already died. Called
// from the `on_error` handler of each driver's `spawn serve`, which runs on the dying thread while
// its resources are still open.
//
// `try_receive`, not `receive`: this must not block, because anything still arriving is the caller
// side racing the close, and `run_request`'s own timeout is what covers that window.
internal fn fail_pending(requests: Channel<Request>, message: string) {
    val reason = concat("the connection's owning thread failed: ", message)
    while channel_len(requests) > 0 {
        if Some(req) = try_receive(requests) {
            switch req {
                Run(r) {
                    val answer: Result<QueryResult, DbError> = err(DbError.Connection(reason))
                    send(r.reply_to, answer)
                }
                OpenCursor(r) {
                    val answer: Result<Page, DbError> = err(DbError.Connection(reason))
                    send(r.reply_to, answer)
                }
                FetchCursor(r) {
                    val answer: Result<Page, DbError> = err(DbError.Connection(reason))
                    send(r.reply_to, answer)
                }
                EndCursor(r) { send(r.reply_to, 0) }
                Close {}
            }
        }
    }
}

// A socket failure as a `DbError`, for the two drivers that speak over one. Both had their own copy
// of this, identical in meaning and differing only in whether it was written as a `switch` or an
// `if` -- which is the only one of the four `lift` functions in the library that really was a
// duplicate (C21).
//
// It stays a hand-written conversion rather than becoming `#[from]`, and the reason is worth
// recording because the task assumed otherwise: `#[from]` wraps the error *value* in a variant
// whose payload type matches it, so using it here would mean `DbError` growing a variant that
// carries a `net.NetError`. That flattens nothing -- the point of this function is that a caller of
// `pg` or `mysql` never has to know `net` exists -- and it would add a fifth variant to every
// exhaustive `switch` over `DbError` in every program.
internal fn lift_net<T>(r: Result<T, net.NetError>) -> Result<T, DbError> {
    return switch r {
        Ok(v) { ok(v) }
        Err(e) { err(DbError.Connection(net_error_message(e))) }
    }
}

// Sends a statement to the connection's owning thread and waits for its answer.
internal fn run_request(requests: Channel<Request>, sql: string, params: [SqlValue]) -> Result<QueryResult, DbError> {
    val reply_to: Channel<Result<QueryResult, DbError>> = channel_new()
    send(requests, Request.Run(RunRequest { sql: sql, params: params, reply_to: reply_to }))
    return switch receive_timeout(reply_to, reply_timeout_millis) {
        Some(answer) { answer }
        None { owner_gone<QueryResult>() }
    }
}

// What a cursor iterator keeps: the channel to the owning thread and a guard that ends the cursor if the
// iterator is dropped unfinished.
struct CursorHandle {
    cursor: int
    requests: Channel<Request>
    guard: Guard
}

// Ends the cursor on the connection, and -- first -- gives back every row its own page buffer is
// still holding. That buffer is a channel, and a value left queued on a channel keeps the dedicated
// copy `send` made of it alive for as long as the channel itself lives (docs/DESIGN.md): a cursor
// left early strands up to a whole page of rows that way, each one holding its own copy, so the
// drain is what actually releases them rather than waiting for the channel to be collected.
fn end_cursor(handle: CursorHandle, buffer: Channel<Option<Row>>) {
    while channel_len(buffer) > 0 {
        val _ = try_receive(buffer)
    }
    val reply: Channel<int> = channel_new()
    send(handle.requests, Request.EndCursor(EndRequest { cursor: handle.cursor, reply_to: reply }))
    // Timed like every other wait here (A47). This one has nothing to report: it is cleanup, and a
    // connection whose owning thread has gone has no cursor left to end.
    val _ = receive_timeout(reply, reply_timeout_millis)
}

fn buffer_page(buffer: Channel<Option<Row>>, page: Page) {
    for row in page.rows {
        send(buffer, Option<Row>.Some(row))
    }
    if page.finished {
        send(buffer, Option<Row>.None)
    }
}

// The next row from the buffer, fetching another page from the server when it is empty. A `None` in
// the buffer marks the end and is put back, so asking again after the end is safe.
fn next_item(handle: CursorHandle, buffer: Channel<Option<Row>>) -> Option<Result<Row, DbError>> {
    val got = try_receive(buffer)
    if Some(item) = got {
        if Some(r) = item {
            val row: Result<Row, DbError> = r
            return Option<Result<Row, DbError>>.Some(row)
        }
        send(buffer, item)
        return Option<Result<Row, DbError>>.None
    }
    val reply: Channel<Result<Page, DbError>> = channel_new()
    send(handle.requests, Request.FetchCursor(FetchRequest { cursor: handle.cursor, reply_to: reply }))
    val page = switch receive_timeout(reply, reply_timeout_millis) {
        Some(answer) { answer }
        None { owner_gone<Page>() }
    }
    if Err(e) = page {
        send(buffer, Option<Row>.None)
        val failure: Result<Row, DbError> = e
        return Option<Result<Row, DbError>>.Some(failure)
    }
    buffer_page(buffer, unwrap(page))
    return next_item(handle, buffer)
}

// Opens a cursor for `sql` on the connection whose owning thread reads `requests`, and returns its rows
// lazily as an `Iter`: the first page is fetched before this returns (so a failing statement is an Err here),
// and later pages as the loop asks for them. Each item is a `Result<Row, DbError>`: a row, or the error that
// ended the result part-way (after which the iteration ends). Leaving the loop early or `iter_close` ends the
// cursor, and a cursor dropped unfinished is ended when it is garbage collected.
pub fn open_rows(
    requests: Channel<Request>,
    sql: string,
    params: [SqlValue]
) -> Result<Iter<Result<Row, DbError>>, DbError> {
    val reply: Channel<Result<Page, DbError>> = channel_new()
    send(requests, Request.OpenCursor(OpenRequest { sql: sql, params: params, reply_to: reply }))
    val first = try switch receive_timeout(reply, reply_timeout_millis) {
        Some(answer) { answer }
        None { owner_gone<Page>() }
    }
    val ender: Channel<int> = channel_new()
    val handle = CursorHandle {
        cursor: first.cursor,
        requests: requests,
        guard: guard_new<Request>(
            requests,
            Request.EndCursor(EndRequest { cursor: first.cursor, reply_to: ender })
        )
    }
    val buffer: Channel<Option<Row>> = channel_new()
    buffer_page(buffer, first)
    return iter_from<Result<Row, DbError>>(
        fn() -> Option<Result<Row, DbError>> { next_item(handle, buffer) },
        fn() { end_cursor(handle, buffer) }
    )
}
