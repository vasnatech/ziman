// db.zm -- what every database module shares: the value, row and error types, the readers that turn a
// `SqlValue` into an ordinary value, and the parser for database URLs. `sqlite`, `pg` and `mysql` are
// built on it, and so is `sql`, the module a program calls (`sql.open`, `sql.query`, ...), which picks
// the driver and pools connections. Anything that maps its own types to and from SQL (`uuid`, `time`,
// `#[derive(Row)]`-generated code) uses this module alone, so it needs no driver.
//
// Only primitives cross the driver boundary: NULL, integer, float, text, bool, and bytes. Uuid,
// LocalDate, Instant, decimal and bigint all travel as `Text` and are converted by the mapping layer --
// that sidesteps every dialect difference in how SQLite and Postgres type those (SQLite has no UUID or
// timestamp type at all).
//
// The URL parser reads `scheme://user[:password]@host[:port]/database[?k=v&...]`. User, password,
// database and query values are percent-decoded, so a password may contain `@`, `:` or `/` when written
// as %40, %3A, %2F (a literal `@` in the password also works: the LAST `@` separates userinfo from host).

use number.byte_from_hex

// ---------------------------------------------------------------- values, rows, errors

// One database value: SQL NULL, an integer, a float, text, a boolean or a blob.
pub enum SqlValue {
    Null
    Int(int)
    Float(float)
    Text(string)
    Bool(bool)
    Bytes([byte])
}

// What a database call can fail with. `NotFound` isn't something a
// driver raises -- it's for a repository whose lookup came back empty,
// kept here so one error type covers the whole data-access layer.
// `Constraint` is a unique/foreign-key/not-null/check violation (the
// caller did something the schema forbids); `Connection` is failing to
// reach or open the database at all; `Sql` is everything else (bad
// syntax, wrong parameter count, a value of the wrong SQL type).
pub enum DbError {
    NotFound(string)
    Constraint(string)
    Connection(string)
    Sql(string)
}

// One result row: `values[i]` belongs to column `columns[i]`.
pub struct Row {
    columns: [string]
    values: [SqlValue]
}

// `e` as a sentence for a log line or a response, prefixed by its kind (`NotFound` is the bare
// message).
pub fn db_error_message(e: DbError) -> string {
    if DbError.is_NotFound(e) {
        return DbError.unwrap_NotFound(e)
    }
    if DbError.is_Constraint(e) {
        return concat("constraint violation: ", DbError.unwrap_Constraint(e))
    }
    return if DbError.is_Connection(e) {
        concat("database connection error: ", DbError.unwrap_Connection(e))
    } else {
        concat("database error: ", DbError.unwrap_Sql(e))
    }
}

// The value of column `column` in `row`, or a DbError.Sql naming the missing column.
pub fn row_get(row: Row, column: string) -> Result<SqlValue, DbError> {
    var i = 0
    while i < len(row.columns) {
        if row.columns[i] == column {
            return row.values[i]
        }
        i = i + 1
    }
    return err(DbError.Sql(concat("no such column in result row: ", column)))
}

fn sql_type_name(v: SqlValue) -> string {
    if SqlValue.is_Null(v) {
        return "NULL"
    }
    if SqlValue.is_Int(v) {
        return "INTEGER"
    }
    if SqlValue.is_Float(v) {
        return "FLOAT"
    }
    if SqlValue.is_Text(v) {
        return "TEXT"
    }
    return if SqlValue.is_Bool(v) { "BOOL" } else { "BYTES" }
}

fn sql_mismatch(expected: string, v: SqlValue) -> DbError {
    return DbError.Sql(format("expected {}, found {}", expected, sql_type_name(v)))
}

// The text of a TEXT value, or a DbError.Sql saying what was found instead.
pub fn sql_as_text(v: SqlValue) -> Result<string, DbError> {
    if !SqlValue.is_Text(v) {
        return err(sql_mismatch("TEXT", v))
    }
    return SqlValue.unwrap_Text(v)
}

// The number in an INTEGER value, or a DbError.Sql saying what was found instead.
pub fn sql_as_int(v: SqlValue) -> Result<int, DbError> {
    if !SqlValue.is_Int(v) {
        return err(sql_mismatch("INTEGER", v))
    }
    return SqlValue.unwrap_Int(v)
}

// SQLite hands an integer column back for a value stored as 0/1 where
// Postgres would say Bool -- accept an integer that's exactly 0 or 1 too.
pub fn sql_as_bool(v: SqlValue) -> Result<bool, DbError> {
    if SqlValue.is_Bool(v) {
        return SqlValue.unwrap_Bool(v)
    }
    if SqlValue.is_Int(v) {
        val n = SqlValue.unwrap_Int(v)
        if n == 0 {
            return false
        }
        if n == 1 {
            return true
        }
    }
    return err(sql_mismatch("BOOL", v))
}

// A whole-number column read as a float, or a float column as itself.
pub fn sql_as_float(v: SqlValue) -> Result<float, DbError> {
    if SqlValue.is_Float(v) {
        return SqlValue.unwrap_Float(v)
    }
    if SqlValue.is_Int(v) {
        return SqlValue.unwrap_Int(v) as float
    }
    return err(sql_mismatch("FLOAT", v))
}

// Lifts a domain type's own parse result (Result<T, string>, e.g.
// uuid_from_string) into the DbError error type a from_sql needs.
pub fn sql_lift<T>(r: Result<T, string>, what: string) -> Result<T, DbError> {
    if !is_ok(r) {
        return err(DbError.Sql(format("invalid {} value: {}", what, unwrap_err(r))))
    }
    return unwrap(r)
}

// ---------------------------------------------------------------- URLs

// One `name=value` pair from the query part of a database URL, already decoded.
pub struct UrlParam {
    name: string
    value: string
}

// A parsed database URL: the decoded credentials, host, port (0 when the URL names none), database
// and query parameters.
pub struct DbUrl {
    user: string
    password: string
    host: string
    port: int
    database: string
    params: [UrlParam]
}

fn bad(message: string) -> DbError {
    return DbError.Connection(message)
}

// Decodes `%XX` escapes in `s`; an Err for a malformed escape or one that yields a NUL byte.
pub fn percent_decode(s: string) -> Result<string, DbError> {
    val out = sb_new()
    var run = 0
    var i = 0
    while i < len(s) {
        if is_char_at(s, i, "%") {
            if i + 3 > len(s) {
                return err(bad(concat("bad %-escape in database URL: ", s)))
            }
            sb_append(out, substring(s, run, i))
            val b = byte_from_hex(substring(s, i + 1, i + 3))
            if !is_ok(b) {
                return err(bad(concat("bad %-escape in database URL: ", s)))
            }
            if !sb_append_byte(out, unwrap(b)) {
                return err(bad("database URL decodes to text containing a NUL byte"))
            }
            i = i + 3
            run = i
        } else {
            i = i + 1
        }
    }
    sb_append(out, substring(s, run, len(s)))
    return sb_to_string(out)
}

// The query parameter `name`, if the URL has it.
pub fn url_param(u: DbUrl, name: string) -> Option<string> {
    for p in u.params {
        if p.name == name {
            return Option<string>.Some(p.value)
        }
    }
    return Option<string>.None
}

// `prefixes` are the accepted `scheme://` starts (e.g. "postgres://").
// The database defaults to the user name when the URL has none.
pub fn parse_url(url: string, prefixes: [string], default_port: int) -> Result<DbUrl, DbError> {
    var rest = ""
    var matched = false
    for prefix in prefixes {
        if !matched && starts_with(url, prefix) {
            rest = substring(url, len(prefix), len(url))
            matched = true
        }
    }
    if !matched {
        return err(bad(concat("unsupported database URL: ", url)))
    }

    var path_and_query = ""
    var authority = rest
    val slash = split_once(rest, "/")
    if Option.is_Some(slash) {
        authority = Option.unwrap_Some(slash)[0]
        path_and_query = Option.unwrap_Some(slash)[1]
    }
    var database = path_and_query
    val params = ab_new<UrlParam>()
    val q = split_once(path_and_query, "?")
    if Option.is_Some(q) {
        database = Option.unwrap_Some(q)[0]
        for pair in split(Option.unwrap_Some(q)[1], "&") {
            val kv = split_once(pair, "=")
            if Option.is_Some(kv) {
                val value = percent_decode(Option.unwrap_Some(kv)[1])?
                ab_append<UrlParam>(params, UrlParam { name: Option.unwrap_Some(kv)[0], value: value })
            }
        }
    }

    val at = last_index_of(authority, "@")
    var userinfo = ""
    var hostport = authority
    if at >= 0 {
        userinfo = substring(authority, 0, at)
        hostport = substring(authority, at + 1, len(authority))
    }
    var user = userinfo
    var password = ""
    val up = split_once(userinfo, ":")
    if Option.is_Some(up) {
        user = Option.unwrap_Some(up)[0]
        password = Option.unwrap_Some(up)[1]
    }
    var host = hostport
    var port = default_port
    val hp = split_once(hostport, ":")
    if Option.is_Some(hp) {
        host = Option.unwrap_Some(hp)[0]
        val text = Option.unwrap_Some(hp)[1]
        val parsed_port = parse_int(text)
        if !is_ok(parsed_port) {
            return err(bad(concat("bad port in database URL: ", text)))
        }
        port = unwrap(parsed_port)
    }
    val user_decoded = percent_decode(user)?
    val password_decoded = percent_decode(password)?
    val database_decoded = percent_decode(database)?
    if user_decoded == "" {
        return err(bad("database URL has no user name"))
    }
    if host == "" {
        return err(bad("database URL has no host"))
    }
    var db_name = database_decoded
    if db_name == "" {
        db_name = user_decoded
    }
    return DbUrl { user: user_decoded, password: password_decoded, host: host, port: port, database: db_name,
        params: ab_to_array<UrlParam>(params) }
}
