// set.zm -- `Set<T>` and its builder `MutableSet<T>`: membership, the four set operations
// (`union`, `intersect`, `difference`, `is_subset`) over both worlds, and the variadic `add`.
//
// Part of Ziman's prelude: every file in lib/prelude/ is merged bare into every program by the
// loader, so everything here is callable with no `use` and `use prelude` does not resolve. In this
// directory `pub` does not control reachability -- a plain `fn` is just as callable -- it controls
// whether `ziman --api builtins` advertises the name, and `internal` is the one modifier that
// subtracts, taking a name out of `--api builtins` and out of editor completion while leaving it
// callable. Native functions are registered by prelude_register() in src/prelude.c, and each file's
// header is generated from its source by the Makefile's prelude rule.
//
// **A declaration lives in the file for the type its first argument has.** So `concat`'s string
// form is in string.zm and its array forms in array.zm, and `get_or`'s `Option` form is in
// option.zm with its two map forms in map.zm -- one overload set, read where each member's type
// lives.
//
// **`ziman --api builtins` prints an overload set as one block**, so the listing answers "what
// does this name accept" in one place even when the sources do not.
//
// That sentence was here, in all ten of these headers, as the reason splitting a set across files
// was safe -- and **it was false for a day**. The listing is built in file order, which grouped
// every set only while no set was ever split; checked on 2026-10-22, `filter` came out in two
// blocks 56 lines apart, `concat` in two, `get_or` in two, and `snapshot` and `clear` in **four**
// each. The listing now groups by name (a set appears where its first advertised member does, so
// the file order's topical reading survives), which made the claim true rather than deleting it.
// A pure reordering: 307 lines before and after, identical as sets.
//
// `docs/lib/prelude.md` is **not** grouped -- it is organised as one `##` section per file, so a
// split set still has a `###` heading in each. The listing is the one place to read a whole set.
//
// That reverses the older rule, which kept a split set whole in collections.zm. What remains in
// collections.zm is the names whose members span so many types that no one file is theirs -- `len`
// over nine, `contains` over nine, `remove` over six -- plus `map` and `flat_map`, which `map`'s
// Map and Set members pin there, `mutable`, whose fourth member takes a bare `T` and so has no
// file at all, and `filter`, down to four since its array pair moved to array.zm on 2026-10-22. **Everything else splits, however few files that
// means**: `snapshot` and `clear` across four each, `set` and `remove_all` across three, `get_or`
// and `update` across two. See docs/DESIGN.md's "Overloading available to a declaration".

// A mutable set under construction; see MutableMap.
#[thread_bound]
struct MutableSet<T: Eq + Hash> {
    handle: int
}

// An empty set builder.
native fn mutable_set_new<T: Eq + Hash>() -> MutableSet<T>

// Adds `item`; nothing happens when it is already there.
internal native fn mutable_set_add<T: Eq + Hash>(s: MutableSet<T>, item: T) -> bool

// Adds each of `items`, answering whether any of them was new. The singular `mutable_set_add` is
// not variadic, which is what keeps a `MutableSet<[int]>` from being a special case -- one element
// or several is never ambiguous when only the `_all` form takes many.
//
// `#[effectful]`, because "did anything change?" is an answer you are usually entitled to ignore:
// `add(s, x)` on its own is "make sure x is in here", and that is the ordinary call. Without the
// attribute the dropped-result gate reads a non-void prelude overload as pure and refuses it, as
// it did from F199 until F212.
#[at_least_one]
#[effectful]
pub fn add<T: Eq + Hash>(s: MutableSet<T>, items: variadic T) -> bool {
    var added_any = false
    for item in items {
        if mutable_set_add<T>(s, item) {
            added_any = true
        }
    }
    return added_any
}

// Drops each of `items`, answering whether any of them was there -- `add`'s opposite, and variadic
// for the same reason. The map form answers the same question of keys and is in map.zm; `remove`
// itself, the singular over all six collections, stays in collections.zm.
//
// `#[effectful]` for the reason `add` carries it: "did anything change?" is an answer
// "make sure these are gone" has no use for.
#[at_least_one]
#[effectful]
pub fn remove_all<T: Eq + Hash>(s: MutableSet<T>, items: variadic T) -> bool {
    var removed_any = false
    for item in items {
        if remove(s, item) {
            removed_any = true
        }
    }
    return removed_any
}

// The elements as an array, in insertion order, as `items` gives for a Set.
pub fn items<T: Eq + Hash>(s: MutableSet<T>) -> [T] {
    val out = mutable_array_new<T>()
    for item in s {
        push(out, item)
    }
    return snapshot(out)
}

native fn items<T: Eq + Hash>(s: Set<T>) -> [T]

builtin fn union<T: Eq + Hash>(s: Set<T>, other: Set<T>) -> Set<T>

builtin fn intersect<T: Eq + Hash>(s: Set<T>, other: Set<T>) -> Set<T>

builtin fn difference<T: Eq + Hash>(s: Set<T>, other: Set<T>) -> Set<T>

builtin fn is_subset<T: Eq + Hash>(s: Set<T>, other: Set<T>) -> bool

#[at_least_one]
builtin fn add<T: Eq + Hash>(s: Set<T>, items: variadic T) -> Set<T>

builtin fn union<T: Eq + Hash>(s: MutableSet<T>, other: Set<T>)
builtin fn union<T: Eq + Hash>(s: MutableSet<T>, other: MutableSet<T>)

builtin fn intersect<T: Eq + Hash>(s: MutableSet<T>, other: Set<T>)
builtin fn intersect<T: Eq + Hash>(s: MutableSet<T>, other: MutableSet<T>)

builtin fn difference<T: Eq + Hash>(s: MutableSet<T>, other: Set<T>)
builtin fn difference<T: Eq + Hash>(s: MutableSet<T>, other: MutableSet<T>)

builtin fn is_subset<T: Eq + Hash>(s: MutableSet<T>, other: Set<T>) -> bool
builtin fn is_subset<T: Eq + Hash>(s: MutableSet<T>, other: MutableSet<T>) -> bool

// The elements added so far as an ordinary `Set`, in insertion order; O(n), and the builder stays
// usable afterwards. `items` answers the same elements as an array -- this one answers the type
// the builder is building, which is what makes it `snapshot` and not a second `items`.
native fn snapshot<T: Eq + Hash>(s: MutableSet<T>) -> Set<T>

// Empties the builder in place, keeping the handle.
native fn clear<T: Eq + Hash>(s: MutableSet<T>)
