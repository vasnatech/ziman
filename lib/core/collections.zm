// collections.zm -- HashMap<K, V>, HashSet<T>, written in ordinary
// Ziman, no native/C code -- the concrete payoff of the generics work
// (see ../../docs/ROADMAP.md's "Generics" and "Collections module"
// entries). `Option<T>` used to live here too; moved to
// lib/prelude.zm since it's needed everywhere HashMap/HashSet
// aren't, so it's now always available bare, no `use` needed -- see
// docs/DESIGN.md's "Prelude" entry. `Box<T>` also used to live here --
// removed outright (not moved anywhere) since nothing ever actually
// used it: it was the first generic struct ever written, kept around
// as a minimal illustrative example rather than for any real payoff,
// and a single-value wrapper was never really "a collection" to begin
// with. See docs/DESIGN.md's "Bundled core modules" entry.
//
// HashMap/HashSet use real bucket-array storage (separate chaining),
// grown (doubled, load factor 0.75, matching Java's HashMap default)
// whenever an insert would push the average chain length too high --
// see should_grow/hashmap_grow/hashset_grow below. Eq + Hash together
// restrict a HashMap/HashSet key to int/float/bool/string for now: Hash
// has no derived form for a struct or enum (see docs/SYNTAX.md
// "Generics").
//
// Growing keeps get/has/contains genuinely O(1) average (bounded chain
// length) regardless of how many entries are inserted -- the thing the
// fixed-16-bucket version this replaced couldn't promise, since an
// unbounded chain degrades a lookup into a linear scan. It does *not*
// make set/add/remove O(1), though, and it's worth being honest about
// why: Ziman's arrays are immutable value types (see docs/DESIGN.md),
// so `set(m.buckets, idx, new_bucket)` always rebuilds the *entire*
// outer bucket array, not just the one slot -- every set/add/remove
// call is O(bucket_count) for that reason alone, growing or not. What
// growing changes is the *shape* of that O(bucket_count) work: without
// it, a long chain means copying a chain of full Entry<K, V> structs on
// every write to that bucket; with it, chains stay short and the
// dominant cost is copying `bucket_count` array references instead --
// a real reduction in the constant factor, not a change in asymptotic
// order. Fixing that ceiling for real needs mutable/shared array
// storage at the language level (see docs/ROADMAP.md's memory-
// reclamation entry), which is out of scope for this module alone.
//
// `Entry`/`buckets`/`count` are implementation details, not part of
// the intended public API -- use the functions below, not direct field
// access, even though Ziman has no per-field privacy to enforce that.

struct Entry<K, V> {
    key: K
    value: V
}

// Shared by hashmap_set/hashset_add -- plain int arithmetic, no type
// parameters needed, so one function serves both instead of two
// identical copies. `count * 4 > bucket_count * 3` is `count /
// bucket_count > 0.75` done in integers, avoiding a float cast for
// something this simple.
fn should_grow(count: int, bucket_count: int) -> bool {
    return count * 4 > bucket_count * 3
}

// Built on ArrayBuilder<[T]> rather than `push` in a loop -- called on
// every grow (bucket_count doubles each time), so for a large map this
// used to mean one leaked, ever-growing outer bucket array per bucket
// initialized (see docs/DESIGN.md's "ArrayBuilder" entry). Unlike
// hashmap_set/hashmap_remove's own per-bucket `push` loops (deliberately
// left alone -- bounded by one chain's length, kept short by the same
// load-factor growth this function is part of), `bucket_count` itself
// has no such bound.
fn new_buckets_of_size<T>(bucket_count: int) -> [[T]] {
    val empty_bucket: [T] = []
    val buckets = ab_new<[T]>()
    for i in 0..bucket_count {
        ab_append<[T]>(buckets, empty_bucket)
    }
    return ab_to_array<[T]>(buckets)
}

pub struct HashMap<K: Eq + Hash, V> {
    buckets: [[Entry<K, V>]]
    count: int
}

pub fn hashmap_new<K: Eq + Hash, V>() -> HashMap<K, V> {
    return HashMap<K, V> { buckets: new_buckets_of_size<Entry<K, V>>(16), count: 0 }
}

pub fn hashmap_size<K: Eq + Hash, V>(m: HashMap<K, V>) -> int {
    return m.count
}

pub fn hashmap_get<K: Eq + Hash, V>(m: HashMap<K, V>, key: K) -> Option<V> {
    val idx = hash(key) % len(m.buckets)
    val bucket = m.buckets[idx]
    for entry in bucket {
        if entry.key == key {
            return Option<V>.Some(entry.value)
        }
    }
    return Option<V>.None
}

pub fn hashmap_has<K: Eq + Hash, V>(m: HashMap<K, V>, key: K) -> bool {
    return Option.is_Some(hashmap_get<K, V>(m, key))
}

// All keys, in no particular (and no stable) order -- bucket order,
// which changes across a resize. Together with hashmap_values, the way
// to enumerate a HashMap from outside this module without reaching
// into `buckets` directly.
//
// Built on ArrayBuilder<T> rather than `push` in a loop -- `push`
// copies the *entire* accumulated array on every call, since Ziman's
// arrays are immutable value types, so a map with many entries used to
// mean one leaked, ever-growing array per iteration (see
// docs/DESIGN.md's "ArrayBuilder" entry).
pub fn hashmap_keys<K: Eq + Hash, V>(m: HashMap<K, V>) -> [K] {
    val keys = ab_new<K>()
    for bucket in m.buckets {
        for entry in bucket {
            ab_append<K>(keys, entry.key)
        }
    }
    return ab_to_array<K>(keys)
}

pub fn hashmap_values<K: Eq + Hash, V>(m: HashMap<K, V>) -> [V] {
    val values = ab_new<V>()
    for bucket in m.buckets {
        for entry in bucket {
            ab_append<V>(values, entry.value)
        }
    }
    return ab_to_array<V>(values)
}

// Rehashes every existing entry into a fresh, doubled bucket array --
// called once from hashmap_set right after an insert crosses the load
// factor. Reuses hashmap_set itself for each re-inserted entry rather
// than a separate insertion path: the grown map starts well under the
// load factor for its own (now larger) bucket count, so none of these
// re-insertions can themselves trigger a further grow (see the module
// header comment's complexity note for why one grow is still an
// O(bucket_count) rebuild per entry, not free).
fn hashmap_grow<K: Eq + Hash, V>(m: HashMap<K, V>) -> HashMap<K, V> {
    val grown_empty = HashMap<K, V> { buckets: new_buckets_of_size<Entry<K, V>>(len(m.buckets) * 2), count: 0 }
    var grown = grown_empty
    for bucket in m.buckets {
        for entry in bucket {
            grown = hashmap_set<K, V>(grown, entry.key, entry.value)
        }
    }
    return grown
}

pub fn hashmap_set<K: Eq + Hash, V>(m: HashMap<K, V>, key: K, value: V) -> HashMap<K, V> {
    val idx = hash(key) % len(m.buckets)
    val old_bucket = m.buckets[idx]
    var new_bucket: [Entry<K, V>] = []
    var replaced = false
    for entry in old_bucket {
        if entry.key == key {
            new_bucket = push(new_bucket, Entry<K, V> { key: key, value: value })
            replaced = true
        } else {
            new_bucket = push(new_bucket, entry)
        }
    }
    var new_count = m.count
    if !replaced {
        new_bucket = push(new_bucket, Entry<K, V> { key: key, value: value })
        new_count = m.count + 1
    }
    val new_buckets = set(m.buckets, idx, new_bucket)
    val updated = HashMap<K, V> { buckets: new_buckets, count: new_count }
    if should_grow(updated.count, len(updated.buckets)) {
        return hashmap_grow<K, V>(updated)
    }
    return updated
}

pub fn hashmap_remove<K: Eq + Hash, V>(m: HashMap<K, V>, key: K) -> HashMap<K, V> {
    val idx = hash(key) % len(m.buckets)
    val old_bucket = m.buckets[idx]
    var new_bucket: [Entry<K, V>] = []
    var removed = false
    for entry in old_bucket {
        if entry.key == key {
            removed = true
        } else {
            new_bucket = push(new_bucket, entry)
        }
    }
    val new_buckets = set(m.buckets, idx, new_bucket)
    var new_count = m.count
    if removed {
        new_count = m.count - 1
    }
    return HashMap<K, V> { buckets: new_buckets, count: new_count }
}

pub struct HashSet<T: Eq + Hash> {
    buckets: [[T]]
    count: int
}

pub fn hashset_new<T: Eq + Hash>() -> HashSet<T> {
    return HashSet<T> { buckets: new_buckets_of_size<T>(16), count: 0 }
}

pub fn hashset_size<T: Eq + Hash>(s: HashSet<T>) -> int {
    return s.count
}

pub fn hashset_contains<T: Eq + Hash>(s: HashSet<T>, item: T) -> bool {
    val idx = hash(item) % len(s.buckets)
    val bucket = s.buckets[idx]
    for x in bucket {
        if x == item {
            return true
        }
    }
    return false
}

// All items, in no particular (and no stable) order -- same caveat as
// hashmap_keys/hashmap_values, built the same ArrayBuilder<T> way.
pub fn hashset_items<T: Eq + Hash>(s: HashSet<T>) -> [T] {
    val items = ab_new<T>()
    for bucket in s.buckets {
        ab_append<T>(ab: items, pieces: bucket)
    }
    return ab_to_array<T>(items)
}

// Same reasoning as hashmap_grow -- reuses hashset_add per re-inserted
// item rather than a separate path.
fn hashset_grow<T: Eq + Hash>(s: HashSet<T>) -> HashSet<T> {
    val grown_empty = HashSet<T> { buckets: new_buckets_of_size<T>(len(s.buckets) * 2), count: 0 }
    var grown = grown_empty
    for bucket in s.buckets {
        for x in bucket {
            grown = hashset_add<T>(grown, x)
        }
    }
    return grown
}

pub fn hashset_add<T: Eq + Hash>(s: HashSet<T>, item: T) -> HashSet<T> {
    if hashset_contains<T>(s, item) {
        return s
    }
    val idx = hash(item) % len(s.buckets)
    val new_bucket = push(s.buckets[idx], item)
    val new_buckets = set(s.buckets, idx, new_bucket)
    val updated = HashSet<T> { buckets: new_buckets, count: s.count + 1 }
    if should_grow(updated.count, len(updated.buckets)) {
        return hashset_grow<T>(updated)
    }
    return updated
}

pub fn hashset_remove<T: Eq + Hash>(s: HashSet<T>, item: T) -> HashSet<T> {
    val idx = hash(item) % len(s.buckets)
    val old_bucket = s.buckets[idx]
    var new_bucket: [T] = []
    var removed = false
    for x in old_bucket {
        if x == item {
            removed = true
        } else {
            new_bucket = push(new_bucket, x)
        }
    }
    val new_buckets = set(s.buckets, idx, new_bucket)
    var new_count = s.count
    if removed {
        new_count = s.count - 1
    }
    return HashSet<T> { buckets: new_buckets, count: new_count }
}

// ---------------------------------------------------------------- sorting
//
// `sort` takes an `Ord` type (`compare` orders any number, string or byte, and
// any struct/enum with a `<type>_compare` function -- `#[derive(Ord)]` writes
// one). To sort by something other than a type's own order, compute the key
// for each item and use `sort_by_keys`, or pass a comparator function value
// to `sort_with`. All of these return a new array
// (arrays are immutable) and the sort is stable: equal keys keep their order.

// The positions of `keys` in ascending order: a stable bottom-up merge sort,
// O(n log n) comparisons. `sort` and `sort_by_keys` are both "gather by this
// permutation". Descending is the same merge with the comparison flipped, and
// is stable too: equal keys keep their input order (it is NOT the ascending
// result reversed, which would flip ties).
pub fn sort_indices<K: Ord>(keys: [K]) -> [int] {
    return merge_sort_indices<K>(keys, false)
}

pub fn sort_indices_desc<K: Ord>(keys: [K]) -> [int] {
    return merge_sort_indices<K>(keys, true)
}

fn merge_sort_indices<K: Ord>(keys: [K], descending: bool) -> [int] {
    val n = len(keys)
    val start = ab_new<int>()
    for i in 0..n {
        ab_append<int>(start, i)
    }
    var order = ab_to_array<int>(start)
    var width = 1
    while width < n {
        val merged = ab_new<int>()
        var lo = 0
        while lo < n {
            val mid = min(lo + width, n)
            val hi = min(lo + 2 * width, n)
            var i = lo
            var j = mid
            while i < mid && j < hi {
                var take_right = compare(keys[order[j]], keys[order[i]]) < 0
                if descending {
                    take_right = compare(keys[order[j]], keys[order[i]]) > 0
                }
                if take_right {
                    ab_append<int>(merged, order[j])
                    j = j + 1
                } else {
                    ab_append<int>(merged, order[i])
                    i = i + 1
                }
            }
            ab_append<int>(ab: merged, pieces: slice<int>(order, i, mid))
            ab_append<int>(ab: merged, pieces: slice<int>(order, j, hi))
            lo = lo + 2 * width
        }
        order = ab_to_array<int>(merged)
        width = width * 2
    }
    return order
}

fn gather<T>(items: [T], order: [int]) -> [T] {
    val out = ab_new<T>()
    for position in order {
        ab_append<T>(out, items[position])
    }
    return ab_to_array<T>(out)
}

// `items` in ascending order of their own `compare`.
pub fn sort<T: Ord>(items: [T]) -> [T] {
    return gather<T>(items, sort_indices<T>(items))
}

// `items` in descending order of their own `compare` (stable).
pub fn sort_desc<T: Ord>(items: [T]) -> [T] {
    return gather<T>(items, sort_indices_desc<T>(items))
}

// `items` ordered by `keys[i]` for each `items[i]` -- the key array is how a
// caller sorts by a field or a computed value without a comparator function.
// An Err if the two arrays differ in length.
pub fn sort_by_keys<T, K: Ord>(items: [T], keys: [K]) -> Result<[T], string> {
    if len(items) != len(keys) {
        return err(format("sort_by_keys: {} items but {} keys", len(items), len(keys)))
    }
    return ok(gather<T>(items, sort_indices<K>(keys)))
}

// The descending form of `sort_by_keys`.
pub fn sort_by_keys_desc<T, K: Ord>(items: [T], keys: [K]) -> Result<[T], string> {
    if len(items) != len(keys) {
        return err(format("sort_by_keys_desc: {} items but {} keys", len(items), len(keys)))
    }
    return ok(gather<T>(items, sort_indices_desc<K>(keys)))
}

pub fn is_sorted<T: Ord>(items: [T]) -> bool {
    for i in 1..len(items) {
        if compare(items[i - 1], items[i]) > 0 {
            return false
        }
    }
    return true
}

// The position of the first element equal to `target` in an already sorted
// array, or None. O(log n).
pub fn binary_search<T: Ord>(sorted: [T], target: T) -> Option<int> {
    var lo = 0
    var hi = len(sorted)
    while lo < hi {
        val mid = lo + (hi - lo) / 2
        if compare(sorted[mid], target) < 0 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < len(sorted) && compare(sorted[lo], target) == 0 {
        return Option<int>.Some(lo)
    }
    return Option<int>.None
}

// The same elements, last to first -- with `sort`, a descending sort.
pub fn reverse<T>(items: [T]) -> [T] {
    val out = ab_new<T>()
    var i = len(items) - 1
    while i >= 0 {
        ab_append<T>(out, items[i])
        i = i - 1
    }
    return ab_to_array<T>(out)
}

// ------------------------------------------------- higher-order functions
//
// Ziman's function values are references to named top-level functions (no
// closures), so the function passed in is a named function; anything it needs
// besides its argument goes in an explicit context value (`fold` threads one
// through as the accumulator). The type arguments are written out at the call:
// `collections.map<int, string>(numbers, label)`.

pub fn map<T, U>(items: [T], f: fn(T) -> U) -> [U] {
    val out = ab_new<U>()
    for item in items {
        ab_append<U>(out, f(item))
    }
    return ab_to_array<U>(out)
}

pub fn filter<T>(items: [T], keep: fn(T) -> bool) -> [T] {
    val out = ab_new<T>()
    for item in items {
        if keep(item) {
            ab_append<T>(out, item)
        }
    }
    return ab_to_array<T>(out)
}

// Left to right: `f(f(initial, items[0]), items[1])` and so on.
pub fn fold<T, A>(items: [T], initial: A, f: fn(A, T) -> A) -> A {
    var acc = initial
    for item in items {
        acc = f(acc, item)
    }
    return acc
}

pub fn any<T>(items: [T], test: fn(T) -> bool) -> bool {
    for item in items {
        if test(item) {
            return true
        }
    }
    return false
}

pub fn all<T>(items: [T], test: fn(T) -> bool) -> bool {
    for item in items {
        if !test(item) {
            return false
        }
    }
    return true
}

// The first element for which `test` is true, or None.
pub fn find<T>(items: [T], test: fn(T) -> bool) -> Option<T> {
    for item in items {
        if test(item) {
            return Option<T>.Some(item)
        }
    }
    return Option<T>.None
}

// The `_ctx` forms pass an extra value through to the function on every call:
// function values don't capture, so what `f` needs besides the element -- the
// request a route is matched against, say -- is threaded in explicitly.
pub fn map_ctx<C, T, U>(items: [T], ctx: C, f: fn(C, T) -> U) -> [U] {
    val out = ab_new<U>()
    for item in items {
        ab_append<U>(out, f(ctx, item))
    }
    return ab_to_array<U>(out)
}

pub fn filter_ctx<C, T>(items: [T], ctx: C, keep: fn(C, T) -> bool) -> [T] {
    val out = ab_new<T>()
    for item in items {
        if keep(ctx, item) {
            ab_append<T>(out, item)
        }
    }
    return ab_to_array<T>(out)
}

pub fn find_ctx<C, T>(items: [T], ctx: C, test: fn(C, T) -> bool) -> Option<T> {
    for item in items {
        if test(ctx, item) {
            return Option<T>.Some(item)
        }
    }
    return Option<T>.None
}

pub fn for_each<T>(items: [T], f: fn(T)) {
    for item in items {
        f(item)
    }
}

// A stable merge sort by a comparator function (negative / zero / positive,
// like `compare`): for an order that is neither the type's own nor a single
// key -- a two-field ordering, say. `sort_by_keys` covers the single-key case.
pub fn sort_with<T>(items: [T], cmp: fn(T, T) -> int) -> [T] {
    val n = len(items)
    val start = ab_new<int>()
    for i in 0..n {
        ab_append<int>(start, i)
    }
    var order = ab_to_array<int>(start)
    var width = 1
    while width < n {
        val merged = ab_new<int>()
        var lo = 0
        while lo < n {
            val mid = min(lo + width, n)
            val hi = min(lo + 2 * width, n)
            var i = lo
            var j = mid
            while i < mid && j < hi {
                if cmp(items[order[j]], items[order[i]]) < 0 {
                    ab_append<int>(merged, order[j])
                    j = j + 1
                } else {
                    ab_append<int>(merged, order[i])
                    i = i + 1
                }
            }
            ab_append<int>(ab: merged, pieces: slice<int>(order, i, mid))
            ab_append<int>(ab: merged, pieces: slice<int>(order, j, hi))
            lo = lo + 2 * width
        }
        order = ab_to_array<int>(merged)
        width = width * 2
    }
    return gather<T>(items, order)
}
