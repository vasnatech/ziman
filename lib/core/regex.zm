// regex.zm -- regular expressions: a native engine that runs in time linear in the text (no
// backreferences), with patterns compiled once and cached.
//
//   val re = try regex.compile("(\\w+)@(\\w+)\\.com")
//   val m = regex.find(re, "mail bob@site.com now")     // Option<Match>
//   regex.replace_all(re, text, "$2: $1")
//
// A Perl-flavoured syntax, without backreferences or lookaround -- which is what
// lets every match run in time proportional to (text length x pattern size), so
// a pattern that comes from outside can never make a program hang. Text and
// patterns are UTF-8; every offset is a *byte* offset, like `substring`.
//
// Supported: literals, `.`, `[a-z]` `[^...]` classes (with `\d \w \s`, POSIX
// `[:alpha:]` and `\p{...}` inside), `\d \D \w \W \s \S` (ASCII), `\p{L}` /
// `\P{L}` Unicode categories and scripts, `\b \B`, `^ $`, groups `( )`,
// `(?: )` and named `(?P<name>...)` / `(?<name>...)`,
// alternation `|`, and the quantifiers `* + ? {n} {n,} {n,m}` (greedy, or lazy
// with a trailing `?`). Escapes: `\n \r \t \f \v \0 \xHH` and `\` before any
// punctuation. Flags go first: `(?i)` ignore ASCII case, `(?s)` `.` matches
// newline, `(?m)` `^`/`$` match at line breaks (combine: `(?im)`). `.` and
// classes match one whole UTF-8 character. `$` matches only at the very end
// unless `(?m)`. Matching is leftmost, with Perl's priority between
// alternatives.

native fn compile_raw(pattern: string) -> Result<int, string>
native fn group_count_raw(handle: int) -> int
native fn group_names_raw(handle: int) -> [string]
native fn search_raw(handle: int, text: string, from: int) -> [int]
native fn search_all_raw(handle: int, text: string) -> [int]

// (A pattern compiled before is looked up, not recompiled: the compiler keeps the last 256
// distinct patterns, so `compile` in a loop or on every request is cheap.)
//
// A compiled pattern. Immutable and shareable between threads; compile once.
pub struct Regex {
    handle: int
    groups: int
    pattern: string
    names: [string]
}

// One match: where it is (byte offsets, `end` exclusive), its text, and the
// capture groups 1..n in order (`None` for a group that did not take part).
pub struct Match {
    start: int
    end: int
    text: string
    groups: [Option<string>]
    names: [string]
}

// Compiles `pattern`. An Err usually names the position of the problem -- except when the pattern is
// refused for its size, where it names the size instead: a pattern needing more than 64 MB of
// capture buffers to match is refused here rather than attempted later, which in practice is a cap
// of about 1,170 capture groups and never one on pattern length.
//
// That budget bounds the memory a match needs, not the time: a pattern that compiles cheaply can
// still be expensive per input byte. So matching is bounded too, and a search that would do more
// work than its subject's length allows stops with a runtime error naming the subject's size. The
// headroom is wide -- a real pattern uses a ten-thousandth of what is allowed, and what reaches the
// ceiling is hundreds of capture groups over a short subject -- and `find_all` is budgeted as one
// scan rather than once per match, so stepping through a subject cannot evade it.
//
// (A pattern compiled before is looked up, not recompiled: the last 256 distinct patterns are kept,
// so `compile` in a loop or on every request is cheap -- for patterns that compile. A *failed*
// compile is not cached, so a caller that recompiles a bad pattern per request pays for it every
// time.)
pub fn compile(pattern: string) -> Result<Regex, string> {
    val handle = try compile_raw(pattern)
    return ok(Regex {
        handle: handle,
        groups: group_count_raw(handle),
        pattern: pattern,
        names: group_names_raw(handle)
    })
}

fn match_of(re: Regex, text: string, caps: [int], at: int) -> Match {
    val groups = mutable_array_new<Option<string>>()
    for g in 1..re.groups + 1 {
        val s = caps[at + 2 * g]
        if s < 0 {
            push(groups, Option<string>.None)
        } else {
            push(groups, Option<string>.Some(substring(text, s, caps[at + 2 * g + 1])))
        }
    }
    return Match {
        start: caps[at],
        end: caps[at + 1],
        text: substring(text, caps[at], caps[at + 1]),
        groups: snapshot(groups),
        names: re.names
    }
}

// True if the pattern matches anywhere in `text`.
pub fn is_match(re: Regex, text: string) -> bool {
    return len(search_raw(re.handle, text, 0)) > 0
}

// The first match at or after byte offset `from` (0 <= from <= len(text)).
pub fn find_from(re: Regex, text: string, from: int) -> Option<Match> {
    val caps = search_raw(re.handle, text, from)
    if len(caps) == 0 {
        return Option<Match>.None
    }
    return Option<Match>.Some(match_of(re, text, caps, 0))
}

// The first match in `text`, or None.
pub fn find(re: Regex, text: string) -> Option<Match> {
    return find_from(re, text, 0)
}

// Every non-overlapping match, left to right. After an empty match the scan
// moves on by one character.
pub fn find_all(re: Regex, text: string) -> [Match] {
    val caps = search_all_raw(re.handle, text)
    val stride = 2 * (re.groups + 1)
    val out = mutable_array_new<Match>()
    var at = 0
    while at < len(caps) {
        push(out, match_of(re, text, caps, at))
        at = at + stride
    }
    return snapshot(out)
}

// The text of group `n` of a match: 0 is the whole match, 1.. the groups.
// `None` for a group that did not take part or one that does not exist.
pub fn group(m: Match, n: int) -> Option<string> {
    if n == 0 {
        return Option<string>.Some(m.text)
    }
    if n < 0 || n > len(m.groups) {
        return Option<string>.None
    }
    return m.groups[n - 1]
}

// The text of the group written `(?P<name>...)` or `(?<name>...)`. `None` if it
// did not take part or no group has that name.
pub fn group_named(m: Match, name: string) -> Option<string> {
    for i in 0..len(m.names) {
        if m.names[i] == name {
            return m.groups[i]
        }
    }
    return Option<string>.None
}

fn group_text(m: Match, n: int) -> string {
    return get_or(group(m, n), "")
}

fn named_text(m: Match, name: string) -> string {
    return get_or(group_named(m, name), "")
}

fn is_name_char(c: string) -> bool {
    return is_digit_char(c) || (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"
}

// `replacement` with `$0` (whole match), `$1`..`$9`, `${12}` (any group number)
// replaced by that group's text (empty if it did not take part or does not
// exist), and `$$` for a literal `$`.
fn expand(replacement: string, m: Match) -> string {
    if index_of(replacement, "$", 0) < 0 {
        return replacement
    }
    val out = mutable_string_new()
    var i = 0
    while i < byte_len(replacement) {
        val dollar = index_of(replacement, "$", i)
        if dollar < 0 {
            append(out, substring(replacement, i, byte_len(replacement)))
            i = byte_len(replacement)
        } else {
            append(out, substring(replacement, i, dollar))
            i = dollar + 1
            if is_char_at(replacement, i, "$") {
                append(out, "$")
                i = i + 1
            } else if is_char_at(replacement, i, "{") {
                val close = index_of(replacement, "}", i)
                if close < 0 {
                    append(out, "$")
                } else {
                    val inside = substring(replacement, i + 1, close)
                    val number = parse_int(inside)
                    if is_ok(number) {
                        append(out, group_text(m, unwrap(number)))
                    } else {
                        append(out, named_text(m, inside))
                    }
                    i = close + 1
                }
            } else {
                var j = i
                while j < byte_len(replacement) && is_digit_char(char_at(replacement, j)) {
                    j = j + 1
                }
                if j == i {
                    var k = i
                    while k < byte_len(replacement) && is_name_char(char_at(replacement, k)) {
                        k = k + 1
                    }
                    if k == i {
                        append(out, "$")
                    } else {
                        append(out, named_text(m, substring(replacement, i, k)))
                        i = k
                    }
                } else {
                    append(out, group_text(m, unwrap(parse_int(substring(replacement, i, j)))))
                    i = j
                }
            }
        }
    }
    return snapshot(out)
}

fn is_digit_char(c: string) -> bool {
    return c >= "0" && c <= "9"
}

fn replace_matches(re: Regex, text: string, replacement: string, first_only: bool) -> string {
    val matches = find_all(re, text)
    if len(matches) == 0 {
        return text
    }
    val out = mutable_string_new()
    var last = 0
    var i = 0
    while i < len(matches) {
        val m = matches[i]
        append(out, substring(text, last, m.start), expand(replacement, m))
        last = m.end
        i = if first_only { len(matches) } else { i + 1 }
    }
    append(out, substring(text, last, byte_len(text)))
    return snapshot(out)
}

// Replaces the first match; see `expand` for `$1`-style references.
pub fn replace(re: Regex, text: string, replacement: string) -> string {
    return replace_matches(re, text, replacement, true)
}

// Replaces every non-overlapping match; see `expand` for `$1`-style references.
pub fn replace_all(re: Regex, text: string, replacement: string) -> string {
    return replace_matches(re, text, replacement, false)
}

// The pieces of `text` between matches (an empty match separates nothing).
pub fn split(re: Regex, text: string) -> [string] {
    val out = mutable_array_new<string>()
    var last = 0
    for m in find_all(re, text) {
        if m.end > m.start {
            push(out, substring(text, last, m.start))
            last = m.end
        }
    }
    push(out, substring(text, last, byte_len(text)))
    return snapshot(out)
}

// `text` with every regex metacharacter escaped, so it matches itself.
pub fn escape(text: string) -> string {
    val out = mutable_string_new()
    for i in 0..byte_len(text) {
        val c = char_at(text, i)
        if contains("\\.^$|?*+()[]{}", c) {
            append(out, "\\")
        }
        append(out, c)
    }
    return snapshot(out)
}
