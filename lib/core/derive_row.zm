// `#[derive(Row)]`, written in Ziman: `<name>_from_row` and `<name>_to_params`, which map a
// struct to and from one SQL result row.
//
// **The second generator ported out of `src/derive.c`, and the one that answers whether
// templates pay.** `Ord`'s two halves were a wash and a win; this one is bigger, nests, and has
// to handle `Option`. What it found is in docs/design/templates.md §14, and the short version is
// in this file: **the two function bodies are templates and the per-field conversions are not**,
// because a conversion is recursive and a template can only show a fixed shape.
//
// Column names are the struct's own field names, as written -- already snake_case, which is also
// how SQL columns are conventionally named, so unlike Json's camelCase keys there is no transform
// here.
#![experimental]
#![generator(Row)]

use meta
use template

// The bundled types whose converters are spelled short -- `to_sql(d)` and `to_localdate(v)`
// rather than `local_date_to_sql` and `local_date_from_sql`. `Uuid` is deliberately absent: its
// name has nothing to shorten, so it keeps `uuid_to_sql`. `standard_flat_type_name` in
// src/derive.c says why the short form stops at these seven.
//
// **That function and this map are the same table in two languages, on purpose** (F229): this one
// decides what the generated text *calls*, and the C one decides which names are *imported* for
// it, so they have to agree. The reason it is survivable is that a disagreement is a missing
// import -- an error at the deriving declaration -- rather than a wrong answer at run time.
val flat_names = Map<string, string> {
    "Instant": "instant",
    "LocalDate": "localdate",
    "LocalTime": "localtime",
    "LocalDateTime": "localdatetime",
    "Duration": "duration",
    "ZoneOffset": "zoneoffset",
    "ZoneId": "zoneid"
}

// Everything this generator writes, in one sheet, in the order a reader meets it. For
// `#[derive(Row)] struct Note { id: int  body: Option<string> }`:
//
//     pub fn note_from_row(row: Row) -> Result<Note, DbError> {
//         val field_id_raw = try row_get(row, "id")
//         val field_id = try sql_as_int(field_id_raw)
//         val field_body_raw = try row_get(row, "body")
//         var field_body = Option<string>.None
//         if !SqlValue.is_Null(field_body_raw) {
//             val __derive_opt_inner_0 = try sql_as_text(field_body_raw)
//             field_body = Option<string>.Some(__derive_opt_inner_0)
//         }
//         return Note {
//             id: field_id,
//             body: field_body
//         }
//     }
//
// **The flat indentation inside the `if` was the C generator's and is gone (2026-10-29).** It was
// kept while this port was checked by emitting the same bytes, with the fix named in advance:
// `@yield` prefixes the block with its own indentation, so indenting the directive is the whole
// change. The bridge landed (F225-F229), the fixtures could move, and they did -- generated code
// inside an `if` is indented like code a person would write.
val sheet = template.must_parse("""
@template from_row
pub fn @{snake}_from_row(row: Row) -> Result<@{name}, DbError> {
@for f in fields
    val field_@{f.name}_raw = try row_get(row, "@{f.name}")
@yield f.read
@end
    return @{name} {
@for f in fields
        @{f.name}: field_@{f.name}@{f.comma}
@end
    }
}

@end

@template read
@if shape == 'simple'
    val @{dst} = try @{call}(@{src})
@else
    var @{dst} = Option<@{elem}>.None
    if !SqlValue.is_Null(@{src}) {
    @yield nested
        @{dst} = Option<@{elem}>.Some(@{inner})
    }
@end
@end

@template to_params
pub fn @{snake}_to_params(v: @{name}) -> [SqlValue] {
    val __derive_params = mutable_array_new<SqlValue>()
@for f in fields
@yield f.write
    push<SqlValue>(__derive_params, field_@{f.name}_sql)
@end
    return snapshot(__derive_params)
}

@end

@template write
@if shape == 'value'
    val @{dst} = SqlValue.@{ctor}(@{src})
@elif shape == 'converted'
    val @{dst} = @{call}(@{src})
@else
    var @{dst} = SqlValue.Null
    if Option.is_Some(@{src}) {
    @yield nested
        @{dst} = @{inner}
    }
@end
@end
""")

// The `sql_as_*` a scalar reads through, or None for a type that is not one.
fn reader_for(t: meta.Type) -> Option<string> {
    switch t {
        Int { return Option<string>.Some("sql_as_int") }
        Float { return Option<string>.Some("sql_as_float") }
        Decimal { return Option<string>.Some("sql_as_decimal") }
        Bool { return Option<string>.Some("sql_as_bool") }
        String { return Option<string>.Some("sql_as_text") }
        Bigint { return Option<string>.None }
        Byte { return Option<string>.None }
        Unit { return Option<string>.None }
        Void { return Option<string>.None }
        Array(_) { return Option<string>.None }
        SetOf(_) { return Option<string>.None }
        ChannelOf(_) { return Option<string>.None }
        MapOf(_) { return Option<string>.None }
        ResultOf(_) { return Option<string>.None }
        Func(_) { return Option<string>.None }
        Optional(_) { return Option<string>.None }
        Named(_) { return Option<string>.None }
        Var(_) { return Option<string>.None }
    }
}

// The `SqlValue` variant a scalar goes out as, or None for a type that needs a converter.
fn writer_for(t: meta.Type) -> Option<string> {
    switch t {
        Int { return Option<string>.Some("Int") }
        Float { return Option<string>.Some("Float") }
        Bool { return Option<string>.Some("Bool") }
        String { return Option<string>.Some("Text") }
        Decimal { return Option<string>.Some("Text") }
        Bigint { return Option<string>.None }
        Byte { return Option<string>.None }
        Unit { return Option<string>.None }
        Void { return Option<string>.None }
        Array(_) { return Option<string>.None }
        SetOf(_) { return Option<string>.None }
        ChannelOf(_) { return Option<string>.None }
        MapOf(_) { return Option<string>.None }
        ResultOf(_) { return Option<string>.None }
        Func(_) { return Option<string>.None }
        Optional(_) { return Option<string>.None }
        Named(_) { return Option<string>.None }
        Var(_) { return Option<string>.None }
    }
}

// A conversion's text ends with the newline its own template put there, and the line that holds
// `@{nested}` supplies one too -- so the inner text is handed over without it.
fn without_newline(text: string) -> string {
    return substring(text, 0, prelude.len(text) - 1)
}

// **Reading a column back, recursively.** `Option<U>` is NULL-or-value, so it emits a `var`, a
// null test and `U`'s own conversion inside it; everything else is one line. A kind with no
// conversion is refused by name, which is where `derive(Row) does not support field type ..`
// comes from.
fn emit_from_sql(t: meta.Type, src: string, dst: string, n: Mutable<int>) -> Result<string, string> {
    if Some(reader) = reader_for(t) {
        return simple_read(dst, reader, src)
    }
    if Optional(elem) = t {
        val inner = meta.fresh(n, "opt_inner")
        return template.render(sheet, "read", [
            template.text("shape", "option"),
            template.text("dst", dst),
            template.text("elem", meta.type_text(elem)),
            template.text("src", src),
            template.text("nested", without_newline(try emit_from_sql(elem, src, inner, n))),
            template.text("inner", inner)
        ])
    }
    if Named(named) = t {
        if Some(flat) = get(flat_names, meta.bare_name(named.name)) {
            return simple_read(dst, concat("to_", flat), src)
        }
        return simple_read(dst, concat(meta.snake_case(named.name), "_from_sql"), src)
    }
    return err(concat("derive(Row) does not support field type '", meta.type_text(t), "'"))
}

fn simple_read(dst: string, call: string, src: string) -> Result<string, string> {
    return template.render(sheet, "read", [
        template.text("shape", "simple"),
        template.text("dst", dst),
        template.text("call", call),
        template.text("src", src)
    ])
}

// The same the other way: a value to a `SqlValue`. An absent `Option` is `SqlValue.Null`, which
// is why this one opens with a `var` rather than returning the inner conversion directly.
//
// **`pub`, and the only part of this file that is** (2026-10-29): `derive_repository` converts a
// repository's key columns and a derived query's bound parameters, and those have to reach SQL by
// exactly the route the entity's own `to_params` writes them. The C shared one `emit_to_sql` for
// that reason; two copies of this rule could disagree, and a key bound differently from the
// column it addresses finds no row and says nothing. If a third generator ever needs it, the
// conversion layer below is what moves into a `derive_sql` of its own.
pub fn emit_to_sql(t: meta.Type, src: string, dst: string, n: Mutable<int>) -> Result<string, string> {
    if Some(ctor) = writer_for(t) {
        // `decimal` is the one scalar whose value is converted on the way in rather than named
        // by a different variant, so it is the source that changes and not the template.
        var value = src
        if Decimal = t {
            value = concat("str(", src, ")")
        }
        return template.render(sheet, "write", [
            template.text("shape", "value"),
            template.text("dst", dst),
            template.text("ctor", ctor),
            template.text("src", value)
        ])
    }
    if Optional(elem) = t {
        val inner = meta.fresh(n, "opt_inner")
        return template.render(sheet, "write", [
            template.text("shape", "option"),
            template.text("dst", dst),
            template.text("src", src),
            template.text("nested", without_newline(
                try emit_to_sql(elem, concat("Option.unwrap_Some(", src, ")"), inner, n)
            )),
            template.text("inner", inner)
        ])
    }
    if Named(named) = t {
        var call = concat(meta.snake_case(named.name), "_to_sql")
        if contains(flat_names, meta.bare_name(named.name)) {
            call = "to_sql"
        }
        return template.render(sheet, "write", [
            template.text("shape", "converted"),
            template.text("dst", dst),
            template.text("call", call),
            template.text("src", src)
        ])
    }
    return err(concat("derive(Row) does not support field type '", meta.type_text(t), "'"))
}

// Both functions, in the order `src/derive.c` splices them.
pub fn generate(d: meta.Decl) -> Result<string, string> {
    switch d.body {
        Struct(fields) { return ok(concat(try from_row(d, fields), try to_params(d, fields))) }
        // `src/derive.c` refuses `derive(Row)` on an enum before this runs; the arm exists
        // because the `switch` requires one, which is what makes the refusal unforgettable.
        Enum(_) {
            return err(concat("derive(Row) does not support an enum ('", d.name, "')"))
        }
    }
}

fn from_row(d: meta.Decl, members: [meta.Field]) -> Result<string, string> {
    val n = mutable_new<int>(0)
    val fields = mutable_array_new<template.Row>()
    val last = prelude.len(members) - 1
    for i in 0..prelude.len(members) {
        val m = members[i]
        push(fields, template.row([
            template.text("name", m.name),
            // The block ends with its own newline and the template line supplies one too, so the
            // trailing one is dropped here rather than leaving a blank line per field.
            template.text("read", without_newline(
                try emit_from_sql(m.type, concat("field_", m.name, "_raw"), concat("field_", m.name), n)
            )),
            template.text("comma", if i < last { "," } else { "" })
        ]))
    }
    return template.render(sheet, "from_row", [
        template.text("snake", d.snake_name),
        template.text("name", d.name),
        template.rows("fields", snapshot(fields))
    ])
}

fn to_params(d: meta.Decl, members: [meta.Field]) -> Result<string, string> {
    val n = mutable_new<int>(0)
    val fields = mutable_array_new<template.Row>()
    for m in members {
        push(fields, template.row([
            template.text("name", m.name),
            template.text("write", without_newline(
                try emit_to_sql(m.type, concat("v.", m.name), concat("field_", m.name, "_sql"), n)
            ))
        ]))
    }
    return template.render(sheet, "to_params", [
        template.text("snake", d.snake_name),
        template.text("name", d.name),
        template.rows("fields", snapshot(fields))
    ])
}
