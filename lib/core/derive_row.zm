// `#[derive(Row)]`, written in Ziman: `<name>_from_row` and `<name>_to_params`, which map a
// struct to and from one SQL result row.
//
// **The second generator ported out of `src/derive.c`, and the one that answers whether
// templates pay.** `Ord`'s two halves were a wash and a win; this one is bigger, nests, and has
// to handle `Option`. What it found is in docs/design/templates.md §14, and the short version is
// in this file: **the two function bodies are templates and the per-field conversions are not**,
// because a conversion is recursive and a template can only show a fixed shape.
//
// Column names are the struct's own field names, as written -- already snake_case, which is also
// how SQL columns are conventionally named, so unlike Json's camelCase keys there is no transform
// here.
#![experimental]
#![generator(Row)]

use meta
use template

// The bundled types whose converters are spelled short -- `to_sql(d)` and `to_localdate(v)`
// rather than `local_date_to_sql` and `local_date_from_sql`. `Uuid` is deliberately absent: its
// name has nothing to shorten, so it keeps `uuid_to_sql`. See `standard_flat_type_name` in
// src/derive.c for why the short form stops at these seven.
val flat_names = Map<string, string> {
    "Instant": "instant",
    "LocalDate": "localdate",
    "LocalTime": "localtime",
    "LocalDateTime": "localdatetime",
    "Duration": "duration",
    "ZoneOffset": "zoneoffset",
    "ZoneId": "zoneid"
}

// Everything this generator writes, in one sheet, in the order a reader meets it. For
// `#[derive(Row)] struct Note { id: int  body: Option<string> }`:
//
//     pub fn note_from_row(row: Row) -> Result<Note, DbError> {
//         val field_id_raw = try row_get(row, "id")
//         val field_id = try sql_as_int(field_id_raw)
//         val field_body_raw = try row_get(row, "body")
//         var field_body = Option<string>.None
//         if !SqlValue.is_Null(field_body_raw) {
//         val __derive_opt_inner_0 = try sql_as_text(field_body_raw)
//         field_body = Option<string>.Some(__derive_opt_inner_0)
//         }
//         return Note {
//             id: field_id,
//             body: field_body
//         }
//     }
//
// The flat indentation inside the `if` is the C generator's, kept because this port is checked
// by emitting the same bytes. **`@yield` is what will fix it**: it prefixes the block with its
// own indentation, so indenting the directive is the whole change -- taken once the bridge lands
// and the fixtures can move.
val sheet = template.must_parse("""
@template from_row
pub fn @{snake}_from_row(row: Row) -> Result<@{name}, DbError> {
@for f in fields
    val field_@{f.name}_raw = try row_get(row, "@{f.name}")
@yield f.read
@end
    return @{name} {
@for f in fields
        @{f.name}: field_@{f.name}@{f.comma}
@end
    }
}

@end

@template read
@choose shape
@when simple
    val @{dst} = try @{call}(@{src})
@when option
    var @{dst} = Option<@{elem}>.None
    if !SqlValue.is_Null(@{src}) {
@yield nested
    @{dst} = Option<@{elem}>.Some(@{inner})
    }
@end
@end

@template to_params
pub fn @{snake}_to_params(v: @{name}) -> [SqlValue] {
    val __derive_params = mutable_array_new<SqlValue>()
@for f in fields
@yield f.write
    push<SqlValue>(__derive_params, field_@{f.name}_sql)
@end
    return snapshot(__derive_params)
}

@end

@template write
@choose shape
@when value
    val @{dst} = SqlValue.@{ctor}(@{src})
@when converted
    val @{dst} = @{call}(@{src})
@when option
    var @{dst} = SqlValue.Null
    if Option.is_Some(@{src}) {
@yield nested
    @{dst} = @{inner}
    }
@end
@end
""")

fn reader_for(kind: string) -> string {
    if kind == "int" {
        return "sql_as_int"
    }
    if kind == "float" {
        return "sql_as_float"
    }
    if kind == "decimal" {
        return "sql_as_decimal"
    }
    if kind == "bool" {
        return "sql_as_bool"
    }
    return "sql_as_text"
}

// The `SqlValue` variant a scalar goes out as, or None for a kind that needs a converter.
fn writer_for(kind: string) -> Option<string> {
    if kind == "int" {
        return Option<string>.Some("Int")
    }
    if kind == "float" {
        return Option<string>.Some("Float")
    }
    if kind == "bool" {
        return Option<string>.Some("Bool")
    }
    if kind == "string" || kind == "decimal" {
        return Option<string>.Some("Text")
    }
    return Option<string>.None
}

// A conversion's text ends with the newline its own template put there, and the line that holds
// `@{nested}` supplies one too -- so the inner text is handed over without it.
fn without_newline(text: string) -> string {
    return substring(text, 0, prelude.len(text) - 1)
}

fn is_scalar(kind: string) -> bool {
    return kind == "int" || kind == "float" || kind == "decimal" || kind == "bool" || kind == "string"
}

// **Reading a column back, recursively.** `Option<U>` is NULL-or-value, so it emits a `var`, a
// null test and `U`'s own conversion inside it; everything else is one line. A kind with no
// conversion is refused by name, which is where `derive(Row) does not support field type ..`
// comes from.
fn emit_from_sql(t: meta.MetaType, src: string, dst: string, n: Mutable<int>) -> Result<string, string> {
    if is_scalar(t.kind) {
        return simple_read(dst, reader_for(t.kind), src)
    }
    if t.kind != "struct" && t.kind != "enum" {
        return err(concat("derive(Row) does not support field type '", meta.type_text(t), "'"))
    }
    if meta.is_option(t) {
        val inner = meta.fresh(n, "opt_inner")
        return template.render(sheet, "read", [
            template.text("shape", "option"),
            template.text("dst", dst),
            template.text("elem", meta.type_text(t.args[0])),
            template.text("src", src),
            template.text("nested", without_newline(try emit_from_sql(t.args[0], src, inner, n))),
            template.text("inner", inner)
        ])
    }
    if Some(flat) = get(flat_names, meta.bare_name(t.name)) {
        return simple_read(dst, concat("to_", flat), src)
    }
    return simple_read(dst, concat(meta.snake_case(t.name), "_from_sql"), src)
}

fn simple_read(dst: string, call: string, src: string) -> Result<string, string> {
    return template.render(sheet, "read", [
        template.text("shape", "simple"),
        template.text("dst", dst),
        template.text("call", call),
        template.text("src", src)
    ])
}

// The same the other way: a value to a `SqlValue`. An absent `Option` is `SqlValue.Null`, which
// is why this one opens with a `var` rather than returning the inner conversion directly.
fn emit_to_sql(t: meta.MetaType, src: string, dst: string, n: Mutable<int>) -> Result<string, string> {
    if Some(ctor) = writer_for(t.kind) {
        // `decimal` is the one scalar whose value is converted on the way in rather than named
        // by a different variant, so it is the source that changes and not the template.
        return template.render(sheet, "write", [
            template.text("shape", "value"),
            template.text("dst", dst),
            template.text("ctor", ctor),
            template.text("src", if t.kind == "decimal" { concat("str(", src, ")") } else { src })
        ])
    }
    if t.kind != "struct" && t.kind != "enum" {
        return err(concat("derive(Row) does not support field type '", meta.type_text(t), "'"))
    }
    if meta.is_option(t) {
        val inner = meta.fresh(n, "opt_inner")
        return template.render(sheet, "write", [
            template.text("shape", "option"),
            template.text("dst", dst),
            template.text("src", src),
            template.text("nested", without_newline(
                try emit_to_sql(t.args[0], concat("Option.unwrap_Some(", src, ")"), inner, n)
            )),
            template.text("inner", inner)
        ])
    }
    return template.render(sheet, "write", [
        template.text("shape", "converted"),
        template.text("dst", dst),
        template.text("call", if contains(flat_names, meta.bare_name(t.name)) {
            "to_sql"
        } else {
            concat(meta.snake_case(t.name), "_to_sql")
        }),
        template.text("src", src)
    ])
}

// Both functions, in the order `src/derive.c` splices them.
pub fn generate(d: meta.Decl) -> Result<string, string> {
    return ok(concat(try from_row(d), try to_params(d)))
}

fn from_row(d: meta.Decl) -> Result<string, string> {
    val n = mutable_new<int>(0)
    val fields = mutable_array_new<template.Row>()
    val last = prelude.len(d.members) - 1
    for i in 0..prelude.len(d.members) {
        val m = d.members[i]
        push(fields, template.row([
            template.text("name", m.name),
            // The block ends with its own newline and the template line supplies one too, so the
            // trailing one is dropped here rather than leaving a blank line per field.
            template.text("read", without_newline(
                try emit_from_sql(m.type, concat("field_", m.name, "_raw"), concat("field_", m.name), n)
            )),
            template.text("comma", if i < last { "," } else { "" })
        ]))
    }
    return template.render(sheet, "from_row", [
        template.text("snake", d.snake_name),
        template.text("name", d.name),
        template.rows("fields", snapshot(fields))
    ])
}

fn to_params(d: meta.Decl) -> Result<string, string> {
    val n = mutable_new<int>(0)
    val fields = mutable_array_new<template.Row>()
    for m in d.members {
        push(fields, template.row([
            template.text("name", m.name),
            template.text("write", without_newline(
                try emit_to_sql(m.type, concat("v.", m.name), concat("field_", m.name, "_sql"), n)
            ))
        ]))
    }
    return template.render(sheet, "to_params", [
        template.text("snake", d.snake_name),
        template.text("name", d.name),
        template.rows("fields", snapshot(fields))
    ])
}
