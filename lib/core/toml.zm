// toml.zm -- TOML 1.0 on top of `json`: a document is a `Json` object, so any
// `#[derive(Json)]` type decodes from it with its own `_from_json`. Written in pure Ziman.
//
// Marked `#![experimental]` below: unlike `json`, no real Ziman program depends on this
// module yet, so treat a gap or an edge case as more likely here than elsewhere in the
// library.
//
// Reads tables (`[a.b]`), arrays of tables (`[[a]]`), dotted keys, inline tables, arrays
// (any nesting, multi-line, trailing commas), basic / literal / multi-line strings with all
// escapes, integers (decimal, `0x` `0o` `0b`, `_` separators), floats, booleans and comments.
// Date and time values are kept as `JString` text (Json has no date type). `inf` and `nan`
// are rejected. Defining the same key or table twice is an error.
//
// Writes a `Json` object: scalars and arrays first as `key = value`, then sub-tables, then
// arrays of tables (`[[name]]`). TOML has no null, so a `JNull` field is left out; a null
// inside an array is an error. The output re-reads as the same tree (a float that is a whole
// number keeps its `.0`; an `Int` stays an integer).

// The UTF-16 surrogate block (not valid code points) and the highest code point, for `\u` escapes.
#![experimental]

val surrogate_start = 55296
val surrogate_end = 57343
val max_code_point = 1114111
val hex_chars = "0123456789abcdef"

use json.Json
use json.Number
use json.float_to_json
use json.int_to_json
use number.float_to_text

// ------------------------------------------------------------------ reading

struct Parsed {
    value: Json
    next: int
}

struct PStr {
    text: string
    next: int
}

struct PPath {
    path: [string]
    next: int
}

fn line_of(s: string, p: int) -> int {
    var line = 1
    var i = 0
    while i < p && i < len(s) {
        if is_char_at(s, i, "\n") {
            line = line + 1
        }
        i = i + 1
    }
    return line
}

fn fail(s: string, p: int, message: string) -> string {
    return format("line {}: {}", line_of(s, p), message)
}

fn is_digit_c(c: string) -> bool {
    return len(c) == 1 && index_of("0123456789", c, 0) >= 0
}

fn is_bare_key_char(c: string) -> bool {
    return len(c) == 1 && index_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-", c, 0) >= 0
}

fn hex_value(c: string) -> int {
    if len(c) != 1 {
        return -1
    }
    return index_of(hex_chars, to_lower(c), 0)
}

fn append_utf8(out: MutableString, cp: int) {
    if cp < 128 {
        append_byte(out, cp as byte)
    } else if cp < 2048 {
        append_byte(out, (192 + cp / 64) as byte, (128 + cp % 64) as byte)
    } else if cp < 65536 {
        append_byte(
            out,
            (224 + cp / 4096) as byte,
            (128 + cp / 64 % 64) as byte,
            (128 + cp % 64) as byte
        )
    } else {
        append_byte(
            out,
            (240 + cp / 262144) as byte,
            (128 + cp / 4096 % 64) as byte,
            (128 + cp / 64 % 64) as byte,
            (128 + cp % 64) as byte
        )
    }
}

// Spaces and tabs.
fn skip_blank(s: string, pos: int) -> int {
    var p = pos
    while p < len(s) && (is_char_at(s, p, " ") || is_char_at(s, p, "\t")) {
        p = p + 1
    }
    return p
}

// Everything up to the end of the line (a `#` comment), not consuming the newline.
fn skip_comment(s: string, pos: int) -> int {
    if !is_char_at(s, pos, "#") {
        return pos
    }
    var p = pos
    while p < len(s) && !is_char_at(s, p, "\n") {
        p = p + 1
    }
    return p
}

// Blank space, newlines and comments -- between array elements and between statements.
fn skip_all(s: string, pos: int) -> int {
    var p = pos
    while p < len(s) {
        val c = char_at(s, p)
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            p = p + 1
        } else if c == "#" {
            p = skip_comment(s, p)
        } else {
            return p
        }
    }
    return p
}

// Reads `n` hex digits at `pos` (after a `\u` / `\U`).
fn read_hex(s: string, pos: int, n: int) -> int {
    if pos + n > len(s) {
        return -1
    }
    var v = 0
    for i in 0..n {
        val d = hex_value(char_at(s, pos + i))
        if d < 0 {
            return -1
        }
        v = v * 16 + d
    }
    return v
}

// A basic (`"..."`) or multi-line basic (`"""..."""`) string whose opening quote is at `pos`.
fn parse_basic(s: string, pos: int) -> Result<PStr, string> {
    val multi = is_char_at(s, pos, "\"") && is_char_at(s, pos + 1, "\"") && is_char_at(s, pos + 2, "\"")
    var p = if multi { pos + 3 } else { pos + 1 }
    if multi {
        if is_char_at(s, p, "\r") && is_char_at(s, p + 1, "\n") {
            p = p + 2
        } else if is_char_at(s, p, "\n") {
            p = p + 1
        }
    }
    val out = mutable_string_new()
    while p < len(s) {
        val c = char_at(s, p)
        if multi && c == "\"" && is_char_at(s, p + 1, "\"") && is_char_at(s, p + 2, "\"") {
            var end = p + 3
            while end < len(s) && end < p + 5 && is_char_at(s, end, "\"") {
                append(out, "\"")
                end = end + 1
            }
            return ok(PStr { text: snapshot(out), next: end })
        }
        if !multi && c == "\"" {
            return ok(PStr { text: snapshot(out), next: p + 1 })
        }
        if !multi && (c == "\n" || c == "\r") {
            return err(fail(s, p, "a basic string cannot span lines (use \"\"\" for that)"))
        }
        if c == "\\" {
            if p + 1 >= len(s) {
                return err(fail(s, p, "unterminated escape"))
            }
            val e = char_at(s, p + 1)
            if e == "n" {
                append(out, "\n")
            } else if e == "t" {
                append(out, "\t")
            } else if e == "r" {
                append(out, "\r")
            } else if e == "b" {
                append_byte(out, 8b)
            } else if e == "f" {
                append_byte(out, 12b)
            } else if e == "\"" {
                append(out, "\"")
            } else if e == "\\" {
                append(out, "\\")
            } else if e == "u" || e == "U" {
                val digits = if e == "u" { 4 } else { 8 }
                val cp = read_hex(s, p + 2, digits)
                if cp <= 0 || cp > max_code_point || (cp >= surrogate_start && cp <= surrogate_end) {
                    return err(fail(s, p, "invalid unicode escape"))
                }
                append_utf8(out, cp)
                p = p + 2 + digits
                continue
            } else if multi && (e == "\n" || e == "\r" || e == " " || e == "\t") {
                // a line-ending backslash: drop it, the newline and all following whitespace
                var q = p + 1
                while q < len(s) && (is_char_at(s, q, " ") || is_char_at(s, q, "\t") || is_char_at(
                    s,
                    q,
                    "\r"
                ) || is_char_at(s, q, "\n")) {
                    q = q + 1
                }
                p = q
                continue
            } else {
                return err(fail(s, p, format("unsupported escape '\\{}'", e)))
            }
            p = p + 2
        } else {
            append(out, c)
            p = p + 1
        }
    }
    return err(fail(s, pos, "unterminated string"))
}

// A literal (`'...'`) or multi-line literal (`'''...'''`) string: no escapes at all.
fn parse_literal(s: string, pos: int) -> Result<PStr, string> {
    val multi = is_char_at(s, pos, "'") && is_char_at(s, pos + 1, "'") && is_char_at(s, pos + 2, "'")
    var p = if multi { pos + 3 } else { pos + 1 }
    if multi {
        if is_char_at(s, p, "\r") && is_char_at(s, p + 1, "\n") {
            p = p + 2
        } else if is_char_at(s, p, "\n") {
            p = p + 1
        }
    }
    val start = p
    while p < len(s) {
        if multi && is_char_at(s, p, "'") && is_char_at(s, p + 1, "'") && is_char_at(s, p + 2, "'") {
            return ok(PStr { text: substring(s, start, p), next: p + 3 })
        }
        if !multi && is_char_at(s, p, "'") {
            return ok(PStr { text: substring(s, start, p), next: p + 1 })
        }
        if !multi && (is_char_at(s, p, "\n") || is_char_at(s, p, "\r")) {
            return err(fail(s, p, "a literal string cannot span lines (use ''' for that)"))
        }
        p = p + 1
    }
    return err(fail(s, pos, "unterminated string"))
}

// One key segment: bare, "basic" or 'literal'.
fn parse_key_part(s: string, pos: int) -> Result<PStr, string> {
    if is_char_at(s, pos, "\"") {
        return parse_basic(s, pos)
    }
    if is_char_at(s, pos, "'") {
        return parse_literal(s, pos)
    }
    var p = pos
    while p < len(s) && is_bare_key_char(char_at(s, p)) {
        p = p + 1
    }
    if p == pos {
        return err(fail(s, pos, "expected a key"))
    }
    return ok(PStr { text: substring(s, pos, p), next: p })
}

// `a.b."c d"` -- dotted key, whitespace allowed around the dots.
fn parse_key_path(s: string, pos: int) -> Result<PPath, string> {
    val parts = mutable_array_new<string>()
    var p = skip_blank(s, pos)
    while true {
        val part = try parse_key_part(s, p)
        push(parts, part.text)
        p = skip_blank(s, part.next)
        if is_char_at(s, p, ".") {
            p = skip_blank(s, p + 1)
        } else {
            return ok(PPath { path: snapshot(parts), next: p })
        }
    }
    // The `while true` above only ever exits via a `return`; this line is dead and exists
    // purely because the typechecker still requires every path out of the function to
    // produce a value. The same idiom recurs below in parse_array_value and
    // parse_inline_table, each with their own infinite loop.
    return err("unreachable")
}

// A bare token "looks like" a date or time by shape alone (digits and `-`/`:` in the right
// positions) -- not validated beyond that. TOML keeps date/time values as plain text (Json has
// no date type), so this only decides whether to parse `tok` as a number or leave it as a
// JString; an invalid date like `2024-13-40` still passes through as a string untouched.
fn looks_datetime(t: string) -> bool {
    if contains(t, ":") {
        return true
    }
    return len(t) >= 10 && char_at(t, 4) == "-" && char_at(t, 7) == "-" && is_digit_c(char_at(t, 0))
}

fn parse_radix(t: string, digits: string, base: int) -> Result<Json, string> {
    if len(t) == 0 {
        return err("empty number")
    }
    var n = 0
    for i in 0..len(t) {
        val d = index_of(digits, to_lower(char_at(t, i)), 0)
        if d < 0 {
            return err(format("invalid digit '{}'", char_at(t, i)))
        }
        n = n * base + d
    }
    return ok(int_to_json(n))
}

fn number_token(tok: string) -> Result<Json, string> {
    if looks_datetime(tok) {
        return ok(Json.JString(tok))
    }
    val t = replace(tok, "_", "")
    if starts_with(t, "0x") {
        return parse_radix(substring(t, 2, len(t)), hex_chars, 16)
    }
    if starts_with(t, "0o") {
        return parse_radix(substring(t, 2, len(t)), "01234567", 8)
    }
    if starts_with(t, "0b") {
        return parse_radix(substring(t, 2, len(t)), "01", 2)
    }
    val bare = if starts_with(t, "+") || starts_with(t, "-") { substring(t, 1, len(t)) } else { t }
    if bare == "inf" || bare == "nan" {
        return err("inf and nan are not supported")
    }
    if len(bare) == 0 || !is_digit_c(char_at(bare, 0)) {
        return err(format("invalid value '{}'", tok))
    }
    val signed = if starts_with(t, "+") { substring(t, 1, len(t)) } else { t }
    if contains(bare, ".") || contains(bare, "e") || contains(bare, "E") {
        val f = parse_float(signed)
        if !is_ok(f) {
            return err(format("invalid number '{}'", tok))
        }
        return ok(float_to_json(unwrap(f)))
    }
    if len(bare) > 1 && char_at(bare, 0) == "0" {
        return err(format("leading zeros are not allowed in '{}'", tok))
    }
    val n = parse_int(signed)
    if !is_ok(n) {
        return err(format("invalid integer '{}'", tok))
    }
    return ok(int_to_json(unwrap(n)))
}

fn parse_scalar_token(s: string, pos: int) -> Result<Parsed, string> {
    var p = pos
    while p < len(s) && !contains(" \t\n\r,]}#", char_at(s, p)) {
        p = p + 1
    }
    if p == pos {
        return err(fail(s, pos, "expected a value"))
    }
    var tok = substring(s, pos, p)
    if tok == "true" {
        return ok(Parsed { value: Json.JBool(true), next: p })
    }
    if tok == "false" {
        return ok(Parsed { value: Json.JBool(false), next: p })
    }
    // a date and a time separated by a space form one value
    if len(tok) == 10 && is_char_at(s, p, " ") && p + 1 < len(s) && is_digit_c(char_at(s, p + 1)) {
        var q = p + 1
        while q < len(s) && !contains(" \t\n\r,]}#", char_at(s, q)) {
            q = q + 1
        }
        tok = substring(s, pos, q)
        p = q
    }
    val n = number_token(tok)
    if Err(e) = n {
        return err(fail(s, pos, e))
    }
    return ok(Parsed { value: unwrap(n), next: p })
}

fn parse_array_value(s: string, pos: int) -> Result<Parsed, string> {
    val items = mutable_array_new<Json>()
    var p = skip_all(s, pos + 1)
    while true {
        if p >= len(s) {
            return err(fail(s, pos, "unterminated array"))
        }
        if is_char_at(s, p, "]") {
            return ok(Parsed { value: Json.JArray(snapshot(items)), next: p + 1 })
        }
        val item = try parse_value(s, p)
        push(items, item.value)
        p = skip_all(s, item.next)
        if is_char_at(s, p, ",") {
            p = skip_all(s, p + 1)
        } else if !is_char_at(s, p, "]") {
            return err(fail(s, p, "expected ',' or ']' in an array"))
        }
    }
    return err("unreachable")
}

fn parse_inline_table(s: string, pos: int) -> Result<Parsed, string> {
    var table = Json.JObject(Map<string, Json> {})
    var p = skip_blank(s, pos + 1)
    if is_char_at(s, p, "}") {
        return ok(Parsed { value: table, next: p + 1 })
    }
    while true {
        val key = try parse_key_path(s, p)
        p = skip_blank(s, key.next)
        if !is_char_at(s, p, "=") {
            return err(fail(s, p, "expected '=' after a key"))
        }
        val value = try parse_value(s, skip_blank(s, p + 1))
        val updated = descend(table, key.path, 0, 0, value.value)
        if Err(e) = updated {
            return err(fail(s, p, e))
        }
        table = unwrap(updated)
        p = skip_blank(s, value.next)
        if is_char_at(s, p, ",") {
            p = skip_blank(s, p + 1)
        } else if is_char_at(s, p, "}") {
            return ok(Parsed { value: table, next: p + 1 })
        } else {
            return err(fail(s, p, "expected ',' or '}' in an inline table"))
        }
    }
    return err("unreachable")
}

fn parse_value(s: string, pos: int) -> Result<Parsed, string> {
    if pos >= len(s) {
        return err("unexpected end of input, expected a value")
    }
    val c = char_at(s, pos)
    if c == "\"" {
        val str_result = try parse_basic(s, pos)
        return ok(Parsed { value: Json.JString(str_result.text), next: str_result.next })
    }
    if c == "'" {
        val str_result = try parse_literal(s, pos)
        return ok(Parsed { value: Json.JString(str_result.text), next: str_result.next })
    }
    if c == "[" {
        return parse_array_value(s, pos)
    }
    if c == "{" {
        return parse_inline_table(s, pos)
    }
    return parse_scalar_token(s, pos)
}

// Every field of `incoming` added to `target`, in order, refusing a key `target` already has.
// What a `[header]` section's accumulated keys do when the section ends.
fn merge_into(target: Map<string, Json>, incoming: Map<string, Json>) -> Result<Map<string, Json>, string> {
    if len(incoming) == 0 {
        return ok(target)
    }
    val out = mutable_map_new<string, Json>()
    for k, v in target {
        set(out, k, v)
    }
    for k, v in incoming {
        if Some(_) = get(out, k) {
            return err(format("duplicate key '{}'", k))
        }
        set(out, k, v)
    }
    return ok(snapshot(out))
}

// The one tree-building step. `node` is an object; walk `path` from index `i`, creating
// objects on the way, and at the last segment: op 0 sets `value` (error if the key exists),
// op 1 merges `value`'s fields into the table there (creating it when absent), op 2 appends
// `value` to the array of tables there. A step that lands on an array of tables continues
// into its last element.
//
// Ops 1 and 2 take a whole finished table rather than making an empty one for later keys to
// be walked into individually. That is the difference between parsing a document of N tables
// in O(N) and in O(N^2): `set` on an array copies it, so writing each key of each `[[entry]]`
// through here used to recopy the whole array of entries once per key. 2000 entries took 3.5
// seconds; the same document now parses in the time 250 of them used to.
fn descend(node: Json, path: [string], i: int, op: int, value: Json) -> Result<Json, string> {
    val fields = Json.unwrap_JObject(node)
    val name = path[i]
    val existing = get(fields, name)
    if i + 1 == len(path) {
        if op == 0 {
            if Option.is_Some(existing) {
                return err(format("duplicate key '{}'", name))
            }
            return ok(Json.JObject(set(fields, name, value)))
        }
        if op == 1 {
            if Some(e) = existing {
                if JObject(target) = e {
                    val merged = try merge_into(target, Json.unwrap_JObject(value))
                    return ok(Json.JObject(set(fields, name, Json.JObject(merged))))
                }
                return err(format("'{}' is already defined as a value, not a table", name))
            }
            return ok(Json.JObject(set(fields, name, value)))
        }
        if Some(current) = existing {
            if JArray(items) = current {
                return ok(Json.JObject(set(fields, name, Json.JArray(push(items, value)))))
            }
            return err(format("'{}' is already defined and is not an array of tables", name))
        }
        return ok(Json.JObject(set(fields, name, Json.JArray([value]))))
    }
    var child = Json.JObject(Map<string, Json> {})
    if Some(e) = existing {
        child = e
    }
    if JArray(items) = child {
        val last = len(items) - 1
        if last < 0 || !Json.is_JObject(items[last]) {
            return err(format("'{}' is not a table", name))
        }
        return ok(Json.JObject(set(
            fields,
            name,
            Json.JArray(set(items, last, try descend(items[last], path, i + 1, op, value)))
        )))
    }
    if !Json.is_JObject(child) {
        return err(format("'{}' is already defined as a value, not a table", name))
    }
    return ok(Json.JObject(set(fields, name, try descend(child, path, i + 1, op, value))))
}

// After a statement: optional blanks and comment, then a newline or the end.
fn expect_line_end(s: string, pos: int) -> Result<int, string> {
    var p = skip_comment(s, skip_blank(s, pos))
    if p >= len(s) {
        return ok(p)
    }
    if is_char_at(s, p, "\r") {
        p = p + 1
    }
    if is_char_at(s, p, "\n") {
        return ok(p + 1)
    }
    return err(fail(s, p, "expected the end of the line"))
}

// Writes the table that has been accumulating into the tree. `op` 0 is the keys that come
// before any header, which belong to the root itself.
fn flush_table(root: Json, pending: Json, path: [string], op: int) -> Result<Json, string> {
    if op == 0 {
        val fields = Json.unwrap_JObject(pending)
        if len(fields) == 0 {
            return ok(root)
        }
        return ok(Json.JObject(try merge_into(Json.unwrap_JObject(root), fields)))
    }
    return descend(root, path, 0, op, pending)
}

// Parses a TOML document into a `Json` object (tables and inline tables become objects, arrays
// arrays, integers `JNumber(Int)`, floats `JNumber(Float)`, dates and times `JString`). An Err carries
// `line N: ...` for a syntax error, a duplicate key, a table defined twice, a table redefined as a
// value (or the reverse), or an unsupported value (`inf`, `nan`).
pub fn parse_toml(text: string) -> Result<Json, string> {
    var root = Json.JObject(Map<string, Json> {})
    // The table being filled. A key goes in here, not into `root`: the whole table is written
    // into the tree once, when the next header arrives or the document ends. Walking from the
    // root for every key is what made this quadratic -- `set` on an array copies it, so each
    // key of each `[[entry]]` recopied the entire array of entries.
    var pending = Json.JObject(Map<string, Json> {})
    var pending_path: [string] = []
    var pending_op = 0
    // Where the pending table's header was, so an error found when it is written still points
    // at the header that caused it rather than at whatever came next.
    var pending_pos = 0
    var defined = Set<string> {}
    var p = skip_all(text, 0)
    while p < len(text) {
        if is_char_at(text, p, "[") {
            val is_array = is_char_at(text, p + 1, "[")
            val header = try parse_key_path(text, p + (if is_array { 2 } else { 1 }))
            var q = skip_blank(text, header.next)
            if !is_char_at(text, q, "]") || (is_array && !is_char_at(text, q + 1, "]")) {
                return err(fail(text, q, "expected ']' to close the table header"))
            }
            q = q + (if is_array { 2 } else { 1 })
            val joined = join(separator: ".", pieces: header.path)
            if !is_array {
                if contains(defined, joined) {
                    return err(fail(text, p, format("table [{}] is defined more than once", joined)))
                }
                defined = add(defined, joined)
            }
            val flushed = flush_table(root, pending, pending_path, pending_op)
            if Err(e) = flushed {
                return err(fail(text, pending_pos, e))
            }
            root = unwrap(flushed)
            pending = Json.JObject(Map<string, Json> {})
            pending_path = header.path
            pending_op = if is_array { 2 } else { 1 }
            pending_pos = p
            val after_header = try expect_line_end(text, q)
            p = after_header
        } else {
            val key = try parse_key_path(text, p)
            val q = skip_blank(text, key.next)
            if !is_char_at(text, q, "=") {
                return err(fail(text, q, "expected '=' after a key"))
            }
            val value = try parse_value(text, skip_blank(text, q + 1))
            val updated = descend(pending, key.path, 0, 0, value.value)
            if Err(e) = updated {
                return err(fail(text, p, e))
            }
            pending = unwrap(updated)
            val after_value = try expect_line_end(text, value.next)
            p = after_value
        }
        p = skip_all(text, p)
    }
    val flushed = flush_table(root, pending, pending_path, pending_op)
    if Err(e) = flushed {
        return err(fail(text, pending_pos, e))
    }
    return ok(unwrap(flushed))
}

// ------------------------------------------------------------------ writing

fn quote_basic(s: string) -> string {
    val out = mutable_string_new()
    append(out, "\"")
    var i = 0
    while i < len(s) {
        val c = char_at(s, i)
        if c == "\"" {
            append(out, "\\\"")
        } else if c == "\\" {
            append(out, "\\\\")
        } else if c == "\n" {
            append(out, "\\n")
        } else if c == "\t" {
            append(out, "\\t")
        } else if c == "\r" {
            append(out, "\\r")
        } else if compare(c, " ") < 0 {
            val code = string_to_bytes(c)[0] as int
            append(
                out,
                "\\u00",
                substring(hex_chars, code / 16, code / 16 + 1),
                substring(hex_chars, code % 16, code % 16 + 1)
            )
        } else {
            append(out, c)
        }
        i = i + 1
    }
    append(out, "\"")
    return snapshot(out)
}

fn key_text(k: string) -> string {
    if len(k) == 0 {
        return "\"\""
    }
    for i in 0..len(k) {
        if !is_bare_key_char(char_at(k, i)) {
            return quote_basic(k)
        }
    }
    return k
}

fn path_text(path: [string]) -> string {
    val parts = mutable_array_new<string>()
    for k in path {
        push(parts, key_text(k))
    }
    return join(separator: ".", pieces: snapshot(parts))
}

fn float_text(f: float) -> string {
    val t = float_to_text(f)
    if contains(t, ".") || contains(t, "e") || contains(t, "n") || contains(t, "i") {
        return t
    }
    return concat(t, ".0")
}

// A JSON number as TOML text: an int or bigint as its digits, a float with the fewest digits that read back (and a `.0` if it
// would otherwise look like an integer), a decimal as its digits at its own scale.
fn number_text(n: Number) -> string {
    switch n {
        Int(i) { return str(i) }
        Float(f) { return float_text(f) }
        Bigint(b) { return str(b) }
        Decimal(d) { return str(d) }
    }
}

// A value on one line: scalars, arrays, and objects as inline tables.
fn inline_value(j: Json) -> Result<string, string> {
    return switch j {
        JNull { err("TOML cannot hold null inside an array or inline table") }
        JBool(b) { ok(if b { "true" } else { "false" }) }
        JNumber(n) { ok(number_text(n)) }
        JString(s) { ok(quote_basic(s)) }
        JArray(items) {
            val parts = mutable_array_new<string>()
            for item in items {
                val text = try inline_value(item)
                push(parts, text)
            }
            ok(concat("[", join(separator: ", ", pieces: snapshot(parts)), "]"))
        }
        JObject(fields) {
            val parts = mutable_array_new<string>()
            for key, value in fields {
                if Json.is_JNull(value) {
                    continue
                }
                val text = try inline_value(value)
                push(parts, concat(key_text(key), " = ", text))
            }
            if len(parts) == 0 {
                ok("{}")
            } else {
                ok(concat("{ ", join(separator: ", ", pieces: snapshot(parts)), " }"))
            }
        }
    }
}

fn is_table_array(j: Json) -> bool {
    if JArray(items) = j {
        if len(items) == 0 {
            return false
        }
        for item in items {
            if !Json.is_JObject(item) {
                return false
            }
        }
        return true
    }
    return false
}

fn write_table(out: MutableString, table: Json, path: [string]) -> Result<int, string> {
    val fields = Json.unwrap_JObject(table)
    for key, value in fields {
        if Json.is_JNull(value) || Json.is_JObject(value) || is_table_array(value) {
            continue
        }
        val text = try inline_value(value)
        append(out, key_text(key), " = ", text, "\n")
    }
    for key, value in fields {
        val sub_path = concat(path, [key])
        if Json.is_JObject(value) {
            append(out, "\n[", path_text(sub_path), "]\n")
            try write_table(out, value, sub_path)
        } else if is_table_array(value) {
            for item in Json.unwrap_JArray(value) {
                append(out, "\n[[", path_text(sub_path), "]]\n")
                try write_table(out, item, sub_path)
            }
        }
    }
    return ok(0)
}

// Writes a `Json` object as TOML: scalars and arrays first as `key = value`, then sub-tables
// (`[a.b]`), then arrays of objects (`[[name]]`). Floats are written with full precision and always
// look like floats (`150.0`). An Err if `j` is not an object, or a null sits inside an array or an
// inline table (TOML has no null; a null field of a table is simply left out).
pub fn toml_to_string(j: Json) -> Result<string, string> {
    if !Json.is_JObject(j) {
        return err("a TOML document must be an object")
    }
    val out = mutable_string_new()
    try write_table(out, j, [])
    val text = snapshot(out)
    return ok(if starts_with(text, "\n") { substring(text, 1, len(text)) } else { text })
}
