// `#[derive(Reflect)]`: prints the declaration a generator was handed, and generates nothing.
//
// **This is a test instrument, not a feature.** Every fixture that exercises a generator builds
// its own `meta.Decl` by hand, which means it asserts what the *generator* does with a type and
// can say nothing about what *reification* produced -- it is the thing standing in for
// reification. So the C-to-Ziman boundary, the one piece of the derive mechanism still written
// in C, has never had a test. Three bugs shipped through it in one week: a stripped module
// qualifier, a map and a set arriving with no element types, and a `Decl` built where the
// collector could not see it. None was caught by 1,293 fixtures and all three were found by
// hand, late.
//
// This generator closes that. Write `#[derive(Reflect)]` on a real declaration, run
// `ziman --emit-derived`, and the output is exactly what `src/generators.c` built -- pinned by
// `tests/lang/derive_reflect`. See docs/design/meta.md §10.
//
// **It emits only comments**, so a declaration that derives it is unchanged. That is deliberate:
// the instrument must not be able to break the program it is measuring.
#![experimental]
#![generator(Reflect)]

use meta

// One flat line per type node, prefixed by its path.
//
// **The path names the part**, which is the change the enum bought: where this once printed
// `args[0]` and `args[1]` for both a map and a result, it now prints `.key`/`.value` and
// `.ok`/`.err`, and a reader no longer has to know which positional slot meant what.
fn walk(path: string, t: meta.Type) -> string {
    val out = mutable_array_new<string>()
    switch t {
        Int { push(out, concat("//   ", path, " int\n")) }
        Float { push(out, concat("//   ", path, " float\n")) }
        Bool { push(out, concat("//   ", path, " bool\n")) }
        String { push(out, concat("//   ", path, " string\n")) }
        Bigint { push(out, concat("//   ", path, " bigint\n")) }
        Decimal { push(out, concat("//   ", path, " decimal\n")) }
        Byte { push(out, concat("//   ", path, " byte\n")) }
        Unit { push(out, concat("//   ", path, " unit\n")) }
        Void { push(out, concat("//   ", path, " void\n")) }
        Array(e) {
            push(out, concat("//   ", path, " array\n"))
            push(out, walk(concat(path, ".elem"), e))
        }
        SetOf(e) {
            push(out, concat("//   ", path, " set\n"))
            push(out, walk(concat(path, ".elem"), e))
        }
        ChannelOf(e) {
            push(out, concat("//   ", path, " channel\n"))
            push(out, walk(concat(path, ".elem"), e))
        }
        Optional(e) {
            push(out, concat("//   ", path, " optional\n"))
            push(out, walk(concat(path, ".elem"), e))
        }
        MapOf(m) {
            push(out, concat("//   ", path, " map\n"))
            push(out, walk(concat(path, ".key"), m.key))
            push(out, walk(concat(path, ".value"), m.value))
        }
        ResultOf(r) {
            push(out, concat("//   ", path, " result\n"))
            push(out, walk(concat(path, ".ok"), r.ok))
            push(out, walk(concat(path, ".err"), r.err))
        }
        Func(f) {
            push(out, concat("//   ", path, " func params=", str(prelude.len(f.params)), "\n"))
            for i in 0..prelude.len(f.params) {
                push(out, walk(concat(path, ".params[", str(i), "]"), f.params[i]))
            }
            push(out, walk(concat(path, ".returns"), f.returns))
        }
        Named(n) {
            push(out, concat("//   ", path, " named name='", n.name, "' args=", str(prelude.len(n.args)), "\n"))
            for i in 0..prelude.len(n.args) {
                push(out, walk(concat(path, ".args[", str(i), "]"), n.args[i]))
            }
        }
        Var(name) { push(out, concat("//   ", path, " var name='", name, "'\n")) }
    }
    return concat(pieces: snapshot(out))
}

pub fn generate(d: meta.Decl) -> Result<string, string> {
    val out = mutable_array_new<string>()
    push(out, concat("// reflect ", d.name, "\n"))
    push(out, concat("//   snake_name='", d.snake_name, "'\n"))
    push(out, concat("//   type_params=[", join(separator: ", ", pieces: d.type_params), "]\n"))
    if Some(arg) = d.arg {
        push(out, concat("//   arg='", arg, "'\n"))
    } else {
        push(out, concat("//   arg=none\n"))
    }
    switch d.body {
        Struct(fields) {
            push(out, concat("//   struct, fields=", str(prelude.len(fields)), "\n"))
            for i in 0..prelude.len(fields) {
                push(out, concat(
                    "//   field[",
                    str(i),
                    "] name='",
                    fields[i].name,
                    "' attrs=[",
                    join(separator: ", ", pieces: fields[i].attrs),
                    "]\n"
                ))
                push(out, walk(concat("field[", str(i), "].type"), fields[i].type))
            }
        }
        Enum(variants) {
            push(out, concat("//   enum, variants=", str(prelude.len(variants)), "\n"))
            for i in 0..prelude.len(variants) {
                val v = variants[i]
                push(out, concat("//   variant[", str(i), "] name='", v.name, "'\n"))
                if Some(payload) = v.payload {
                    push(out, walk(concat("variant[", str(i), "].payload"), payload))
                }
            }
        }
    }
    return ok(concat(pieces: snapshot(out)))
}
