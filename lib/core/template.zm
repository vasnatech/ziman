// Templates for generated code: the shape of the output, visible in the source.
//
// Written for the derive generators (`lib/core/derive_*.zm`), which assemble Ziman source. A
// generator built from `push`/`concat` hides the thing it exists to produce. See
// docs/design/templates.md -- §12 for the comparison this module was built on, §15 for why a
// source is a *sheet* of named templates rather than one anonymous one.
//
// ```
// @template from_row
// pub fn @{snake}_from_row(row: Row) -> Result<@{name}, DbError> {
// @for f in fields
//     val field_@{f.name}_raw = try row_get(row, "@{f.name}")
// @yield f.read
// @end
// }
// @end
//
// @template read
// @choose shape
// @when simple
//     val @{dst} = try @{call}(@{src})
// @when option
//     var @{dst} = Option<@{elem}>.None
// @end
// @end
// ```
//
// **`@` and not `{}`**, which is where this parts company with `format`: a code template's output
// is mostly braces, and under `format`'s `{{`/`}}` rule every literal brace would double -- the
// common case paying for the rare one. `@` is not a token in Ziman's grammar at all.
//
// **There are no expressions.** `@choose` reads a bound string and `@when` compares it to a
// literal tag; a loop runs over bound rows; a hole holds a bound string. Anything that needs
// computing is computed in Ziman, where the type checker reads it. That rule is the whole design
// -- docs/design/templates.md §4 argues it against the generator that wants the most, and §15
// keeps it while making the alternatives visible.
//
// **This module carries no `#[derive(..)]` and uses no generated code, deliberately**: a
// generator that needs a generator cannot be loaded. See the design's §8.
#![experimental]

use expr
use expr.Expr
use json
use json.Json
use json.Number

// ------------------------------------------------------------------ the parsed sheet

// `@{<expression>}`. **The text is kept beside the parsed form**, because every message about a
// hole quotes the hole as it was written -- `'@{r.cell}' is bound to an array` reads as the
// author's own line, where a rendering of the parse tree would not.
struct HoleNode {
    source: string
    e: Expr
}

// `@for <binder> in <expression>`. The binder enters the context for the body, so a row's field
// is an ordinary member access (`@{r.cell}`) rather than a second lookup mechanism -- which is
// what let the frame stack go.
struct Loop {
    binder: string
    source: string
    over: Expr
    body: [Node]
}

// One `@if` or `@elif` of a conditional: the condition as written, for messages, and parsed.
struct Arm {
    source: string
    cond: Expr
    body: [Node]
}

// `@if` / `@elif`* / `@else`? / `@end`. **No arm matching and no `@else` emits nothing**, which
// is what `@if` means everywhere -- and is the one thing `@choose` did differently: it refused a
// tag no `@when` named. That refusal is given up with the construct (see docs/design/templates.md
// §15's reversal), so a dispatch that must be exhaustive ends with an `@else` holding whatever is
// right for it rather than relying on the renderer to complain.
struct Conditional {
    arms: [Arm]
    otherwise: [Node]
    has_otherwise: bool
}

// `@yield name`, a hole holding a *block*. `indent` is the whitespace the directive itself sat
// behind, which every line of the block is prefixed with -- so a `@yield` at column 0 splices
// the block verbatim and an indented one produces indented output.
struct Block {
    source: string
    e: Expr
    indent: string
}

enum Node {
    Literal(string)
    Hole(HoleNode)
    Repeat(Loop)
    Branch(Conditional)
    Yield(Block)
}

struct Named {
    name: string
    nodes: [Node]
    // Every context key this template reads: the **root** of each expression in it, from
    // `expr.names`, minus the binders its own `@for`s introduce. Collected at parse time so that
    // `render` can refuse an unused binding, which is a *static* question about the text --
    // counting what a render touched would call a binding unused whenever its loop ran zero times
    // or its case was not the one chosen.
    refs: [string]
}

// A source's templates, by name. **A source is always a sheet**, never one anonymous template:
// a generator's output vocabulary belongs in one literal, read top to bottom, which is what §15
// of the design is about.
pub struct Sheet {
    templates: [Named]
}

// ------------------------------------------------------------------ what a template is given
//
// **A context is a `Json` object, and the three constructors below are sugar for building one**
// (docs/design/expressions.md §11, step 3 of 5). The old model -- a `[Binding]` with a `Bound`
// that was either a string or a list of rows -- was a degenerate `Json` by construction: a string
// is a `JString`, a row is a `JObject`, rows are a `JArray` of them. So this is one type where
// there were three, and docs/design/templates.md §5's "why not a `Map`" is answered by the
// recursive type that comparison was missing.
//
// **What is given up** is templates.md §5's guarantee that every value a hole can hold is already
// a `string`, which made "how is a number formatted" a question that could not be asked. It can be
// asked now and the answer is in `hole_text`: a string renders as itself, a number as `str` writes
// it, a bool as `true`/`false`, and an array, an object or null is refused.

pub struct Row {
    cells: [Binding]
}

// A value under a name, as `eql.bind` is -- the same problem, so the same shape. The value is a
// `Json` now, which is what makes the three constructors sugar rather than a second model.
pub struct Binding {
    name: string
    value: Json
}

// A string for `@{name}`, for `@yield name`, and for the tag a `@choose` reads.
pub fn text(name: string, value: string) -> Binding {
    return Binding { name: name, value: Json.JString(value) }
}

// A `bool` for an `@if`. **This existed, went when `@if` went (templates.md §5), and returns with
// it**: a condition over a real boolean is what the construct is for, and `text("keyed", "yes")`
// with `@if keyed == 'yes'` is the stringly-typed dance the swap exists to remove.
pub fn flag(name: string, value: bool) -> Binding {
    return Binding { name: name, value: Json.JBool(value) }
}

// The rows a `@for name` repeats over.
pub fn rows(name: string, value: [Row]) -> Binding {
    val items = mutable_array_new<Json>()
    for r in value {
        push(items, context(r.cells))
    }
    return Binding { name: name, value: Json.JArray(snapshot(items)) }
}

// One row of a `@for`: its cells are reached qualified, as `@{binder.cell}`.
pub fn row(cells: [Binding]) -> Row {
    return Row { cells: cells }
}

// The object a binding list means. Public because a caller that wants to see what it is passing --
// or to pass a tree a generator did not build, which is the point of the change -- should not have
// to guess the mapping.
pub fn context(bindings: [Binding]) -> Json {
    val out = mutable_map_new<string, Json>()
    for b in bindings {
        set(out, b.name, b.value)
    }
    return Json.JObject(snapshot(out))
}

// ------------------------------------------------------------------ parsing

fn problem(line_no: int, message: string) -> string {
    return concat("template line ", str(line_no), ": ", message)
}

fn leading_space(line: string) -> string {
    var n = 0
    val cs = chars(line)
    while n < prelude.len(cs) && (cs[n] == " " || cs[n] == "\t") {
        n = n + 1
    }
    return substring(line, 0, n)
}

// One line's text, as literals and holes. A line is scanned between `@`s rather than character by
// character, so the usual case copies in one piece.
fn parse_line(text: string, line_no: int) -> Result<[Node], string> {
    val out = mutable_array_new<Node>()
    var at = 0
    while at < len(text) {
        val sigil = index_of(text, "@", at)
        if sigil < 0 {
            push(out, Node.Literal(substring(text, at, len(text))))
            at = len(text)
            continue
        }
        if sigil > at {
            push(out, Node.Literal(substring(text, at, sigil)))
        }
        if is_char_at(text, sigil + 1, "@") {
            push(out, Node.Literal("@"))
            at = sigil + 2
            continue
        }
        if !is_char_at(text, sigil + 1, "{") {
            return err(problem(line_no, "a lone '@' -- write '@@' for a literal one, or '@{name}' for a hole"))
        }
        val close = index_of(text, "}", sigil + 2)
        if close < 0 {
            return err(problem(line_no, "'@{' with no closing '}'"))
        }
        val inside = substring(text, sigil + 2, close)
        if len(trim(inside)) == 0 {
            return err(problem(line_no, "'@{}' names nothing"))
        }
        push(out, Node.Hole(HoleNode { source: trim(inside), e: try expression(inside, line_no) }))
        at = close + 1
    }
    return snapshot(out)
}

// What a nested `parse_block` hands back: the nodes it read, the line after the directive that
// stopped it, which directive that was ("end", "when", "otherwise", or "" for the end of the
// source), and the tag when it was a `@when`.
struct Section {
    nodes: [Node]
    next: int
    closer: string
    tag: string
}

// An expression, parsed with the sheet. **A malformed one is a load-time failure**, exactly as a
// malformed directive is: a generator's sheet is a module-level `val`, so a sheet that cannot be
// read stops the module rather than the first render (docs/design/expressions.md §10).
fn expression(source: string, line_no: int) -> Result<Expr, string> {
    if Err(why) = expr.parse(source) {
        return err(problem(line_no, prelude.format("'{}' is not an expression: {}", trim(source), why)))
    }
    return ok(unwrap(expr.parse(source)))
}

fn parse_block(lines: [string], start: int) -> Result<Section, string> {
    val out = mutable_array_new<Node>()
    var i = start
    while i < len(lines) {
        val raw = lines[i]
        val t = trim(raw)
        val line_no = i + 1
        if t == "@end" {
            return Section { nodes: snapshot(out), next: i + 1, closer: "end", tag: "" }
        }
        if t == "@else" {
            return Section { nodes: snapshot(out), next: i + 1, closer: "else", tag: "" }
        }
        if starts_with(t, "@elif ") {
            return Section {
                nodes: snapshot(out),
                next: i + 1,
                closer: "elif",
                tag: trim(substring(t, 6, len(t)))
            }
        }
        if starts_with(t, "@for ") {
            // The source is an expression now, which may hold spaces, so the split is on the
            // first ` in ` rather than on every space.
            val rest = trim(substring(t, 5, len(t)))
            val sep = index_of(rest, " in ", 0)
            if sep < 0 {
                return err(problem(line_no, "'@for' reads '@for <binder> in <expression>'"))
            }
            val binder = trim(substring(rest, 0, sep))
            val over = trim(substring(rest, sep + 4, len(rest)))
            if len(binder) == 0 || len(over) == 0 || contains(binder, " ") {
                return err(problem(line_no, "'@for' reads '@for <binder> in <expression>'"))
            }
            val parsed = try expression(over, line_no)
            val inner = try parse_block(lines, i + 1)
            if inner.closer != "end" {
                return err(problem(line_no, "this '@for' is never closed by an '@end'"))
            }
            push(out, Node.Repeat(Loop {
                binder: binder,
                source: over,
                over: parsed,
                body: inner.nodes
            }))
            i = inner.next
            continue
        }
        if starts_with(t, "@if ") {
            val arms = mutable_array_new<Arm>()
            val otherwise = mutable_array_new<Node>()
            var cond_text = trim(substring(t, 4, len(t)))
            var cond = try expression(cond_text, line_no)
            var section = try parse_block(lines, i + 1)
            var more = true
            while more {
                push(arms, Arm { source: cond_text, cond: cond, body: section.nodes })
                if section.closer == "elif" {
                    cond_text = section.tag
                    cond = try expression(cond_text, line_no)
                    section = try parse_block(lines, section.next)
                } else {
                    more = false
                }
            }
            var has_else = false
            if section.closer == "else" {
                val tail = try parse_block(lines, section.next)
                for n in tail.nodes {
                    push(otherwise, n)
                }
                has_else = true
                section = tail
            }
            if section.closer != "end" {
                return err(problem(line_no, "this '@if' is never closed by an '@end'"))
            }
            push(out, Node.Branch(Conditional {
                arms: snapshot(arms),
                otherwise: snapshot(otherwise),
                has_otherwise: has_else
            }))
            i = section.next
            continue
        }
        if starts_with(t, "@yield ") {
            val subject = trim(substring(t, 7, len(t)))
            push(out, Node.Yield(Block {
                source: subject,
                e: try expression(subject, line_no),
                indent: leading_space(raw)
            }))
            i = i + 1
            continue
        }
        if starts_with(t, "@template ") {
            return err(problem(line_no, "a '@template' cannot sit inside another one"))
        }
        // Not a directive, so it is text -- but a line opening with `@` and not `@@` or `@{` is a
        // misspelled directive far more often than it is literal text, and saying so beats the
        // lone-'@' message parse_line would give it.
        if starts_with(t, "@") && !starts_with(t, "@@") && !starts_with(t, "@{") {
            return err(problem(
                line_no,
                "unknown directive -- the seven are '@template', '@for', '@if', '@elif', '@else', '@yield' and '@end'"
            ))
        }
        for n in try parse_line(raw, line_no) {
            push(out, n)
        }
        // **Every body line carries its newline, including the last**, and a directive line
        // carries none -- which is what lets `@for` sit on its own line without opening a gap.
        // `@end` being a terminator rather than a string delimiter is what makes this statable:
        // a text block drops the newline before its closing `\"\"\"`, so the old anonymous form
        // needed two blank lines to end a function with one, and that cost a bug (design §13).
        push(out, Node.Literal("\n"))
        i = i + 1
    }
    return Section { nodes: snapshot(out), next: i, closer: "", tag: "" }
}

// The context keys a template reads. `bound` is the `@for` binders in scope, which are bound by
// the text itself and so are not asked of the caller -- the one place this needs to know anything
// about scope, and the reason it is not simply `expr.names` over every node.
fn collect_refs(nodes: [Node], into: MutableArray<string>, bound: [string]) {
    for n in nodes {
        switch n {
            Literal(s) {
                val ignored = s
            }
            Hole(h) { add_names(h.e, into, bound) }
            Yield(b) { add_names(b.e, into, bound) }
            Repeat(l) {
                add_names(l.over, into, bound)
                collect_refs(l.body, into, push(bound, l.binder))
            }
            Branch(c) {
                for arm in c.arms {
                    add_names(arm.cond, into, bound)
                    collect_refs(arm.body, into, bound)
                }
                collect_refs(c.otherwise, into, bound)
            }
        }
    }
}

fn add_names(e: Expr, into: MutableArray<string>, bound: [string]) {
    for name in expr.names(e) {
        if !contains(bound, name) && !contains(into, name) {
            push(into, name)
        }
    }
}

// Reads a sheet, or says what is wrong with it and where.
pub fn parse(source: string) -> Result<Sheet, string> {
    val lines = split(source, "\n")
    val out = mutable_array_new<Named>()
    var i = 0
    while i < len(lines) {
        val t = trim(lines[i])
        if t == "" {
            i = i + 1
            continue
        }
        // A bare `@template` is matched here rather than left to the catch-all below, so that
        // forgetting the name says so instead of "every line outside a '@template' must be
        // blank", which is true and unhelpful.
        if t == "@template" {
            return err(problem(i + 1, "'@template' needs a name"))
        }
        if !starts_with(t, "@template ") {
            return err(problem(
                i + 1,
                "every line outside a '@template' must be blank -- a source is a sheet of named templates"
            ))
        }
        val name = trim(substring(t, 10, len(t)))
        if len(name) == 0 {
            return err(problem(i + 1, "'@template' needs a name"))
        }
        for already in snapshot(out) {
            if already.name == name {
                return err(problem(i + 1, concat("this sheet already has a template called '", name, "'")))
            }
        }
        // The body's last line is the one before the closing `@end`, which is what decides where
        // the trailing newline stops. Found by scanning forward for the `@end` at this level.
        val body = try parse_block(lines, i + 1)
        if body.closer != "end" {
            return err(problem(i + 1, concat("template '", name, "' is never closed by an '@end'")))
        }
        val refs = mutable_array_new<string>()
        val no_binders: [string] = []
        collect_refs(body.nodes, refs, no_binders)
        push(out, Named { name: name, nodes: body.nodes, refs: snapshot(refs) })
        i = body.next
    }
    return Sheet { templates: snapshot(out) }
}

// `parse` for a module-level `val`, where a broken sheet is a mistake in a string literal in the
// source rather than a condition any caller could act on -- the same reasoning
// `repository.query` records for its own `unwrap`.
pub fn must_parse(source: string) -> Sheet {
    return unwrap(parse(source))
}

// ------------------------------------------------------------------ rendering

// The keys of a context object, in the order they were bound: an object is a `Map`, which keeps
// insertion order, so an error still lists them the way the caller wrote them.
fn names_of(ctx: Json) -> string {
    val out = mutable_array_new<string>()
    if JObject(fields) = ctx {
        for key, ignored in fields {
            push(out, key)
        }
    }
    return join(separator: ", ", pieces: snapshot(out))
}

// A kind with its article, because every message that uses it reads "is bound to <kind>".
fn kind_of(v: Json) -> string {
    switch v {
        JString(ignored) { return "a string" }
        JNumber(ignored) { return "a number" }
        JBool(ignored) { return "a bool" }
        JArray(ignored) { return "an array" }
        JObject(ignored) { return "an object" }
        JNull { return "null" }
    }
}

// **What a hole may hold.** A string is itself; a number is what `str` writes, so `19.90` as a
// `decimal` keeps its scale and an `int` has no point; a bool is `true`/`false`.
//
// An array, an object and **null** are refused. Null is the interesting one: a hole holding it is
// nearly always a mistake rather than a request for the empty string, and the alternative -- a
// silent "" -- is the shape of bug that reaches a reader as a missing word in generated code.
fn hole_text(v: Json) -> Option<string> {
    if JString(s) = v {
        return Option<string>.Some(s)
    }
    if JBool(b) = v {
        return Option<string>.Some(if b { "true" } else { "false" })
    }
    if JNumber(n) = v {
        switch n {
            Int(i) { return Option<string>.Some(str(i)) }
            Bigint(b) { return Option<string>.Some(str(b)) }
            Float(f) { return Option<string>.Some(str(f)) }
            Decimal(d) { return Option<string>.Some(str(d)) }
        }
    }
    return Option<string>.None
}

// A `@{hole}` or a `@yield`'s subject, as text.
//
// **The lookup is `expr`'s now**, which is where the two mechanisms this module used to have --
// a global binding and a frame's cell -- became one: a `@for` binder is a context key, so
// `r.cell` is a member access and a missing one is reported by the evaluator that owns paths
// ("no 'cell' here; this object has other"). What stays here is what a *hole* additionally
// requires: that the value be renderable as text.
fn string_at(e: Expr, ctx: Json, what: string) -> Result<string, string> {
    val value = expr.eval(e, ctx)
    if Err(why) = value {
        return err(prelude.format("'{}': {}", what, why))
    }
    if Some(text) = hole_text(unwrap(value)) {
        return ok(text)
    }
    return err(prelude.format("'{}' is {}, and a hole holds text", what, kind_of(unwrap(value))))
}

// A context with one more key: what a `@for` hands its body.
fn with_key(ctx: Json, key: string, value: Json) -> Json {
    val out = mutable_map_new<string, Json>()
    if JObject(fields) = ctx {
        for k, v in fields {
            set(out, k, v)
        }
    }
    set(out, key, value)
    return Json.JObject(snapshot(out))
}

// Every line of `block` behind `indent`. A blank line is left blank rather than padded with
// trailing spaces, which `--fmt` would strip from the generated source anyway.
fn indented(block: string, indent: string) -> string {
    if indent == "" {
        return block
    }
    val out = mutable_array_new<string>()
    for line in split(block, "\n") {
        if line == "" {
            push(out, line)
        } else {
            push(out, concat(indent, line))
        }
    }
    return join(separator: "\n", pieces: snapshot(out))
}

fn emit(nodes: [Node], ctx: Json, out: MutableArray<string>) -> Result<unit, string> {
    for n in nodes {
        switch n {
            Literal(s) {
                push(out, s)
            }
            Hole(h) {
                push(out, try string_at(h.e, ctx, concat("@{", h.source, "}")))
            }
            Yield(b) {
                val block = try string_at(b.e, ctx, concat("@yield ", b.source))
                push(out, indented(block, b.indent))
                push(out, "\n")
            }
            Repeat(l) {
                val over = expr.eval(l.over, ctx)
                if Err(why) = over {
                    return err(prelude.format("'@for {} in {}': {}", l.binder, l.source, why))
                }
                val value = unwrap(over)
                if !Json.is_JArray(value) {
                    return err(prelude.format(
                        "'@for {} in {}' needs an array, and that is {}",
                        l.binder,
                        l.source,
                        kind_of(value)
                    ))
                }
                // **The binder shadowing a bound name is refused**, which keeps templates.md §5's
                // "shadowing is impossible by construction" now that a binder is an ordinary
                // context key rather than a separate frame.
                if Some(ignored) = json.get(ctx, l.binder) {
                    return err(prelude.format(
                        "'@for {} in {}' would shadow the bound '{}'",
                        l.binder,
                        l.source,
                        l.binder
                    ))
                }
                // An element may be anything a hole can hold: `@{n}` over an array of numbers is
                // as good as `@{r.cell}` over an array of objects. The old model needed objects
                // because a cell was a second lookup; an expression needs no such promise.
                for item in Json.unwrap_JArray(value) {
                    try emit(l.body, with_key(ctx, l.binder, item), out)
                }
            }
            Branch(c) {
                var chosen = false
                for arm in c.arms {
                    if !chosen {
                        val holds = expr.eval_bool(arm.cond, ctx)
                        if Err(why) = holds {
                            return err(prelude.format("'@if {}': {}", arm.source, why))
                        }
                        if unwrap(holds) {
                            chosen = true
                            try emit(arm.body, ctx, out)
                        }
                    }
                }
                // Nothing matched and there is no `@else`: nothing is emitted, which is what an
                // `@if` means. `@choose` refused instead, and that difference is the reason a
                // dispatch that has to be exhaustive now writes its last case as `@else`.
                if !chosen && c.has_otherwise {
                    try emit(c.otherwise, ctx, out)
                }
            }
        }
    }
    return unit
}

fn named_in(sheet: Sheet, name: string) -> Option<Named> {
    for t in sheet.templates {
        if t.name == name {
            return Option<Named>.Some(t)
        }
    }
    return Option<Named>.None
}

fn sheet_names(sheet: Sheet) -> string {
    val out = mutable_array_new<string>()
    for t in sheet.templates {
        push(out, t.name)
    }
    return join(separator: ", ", pieces: snapshot(out))
}

// One of the sheet's templates, with its holes filled.
//
// **Both directions are checked**: a hole naming nothing bound, and a binding the template never
// mentions. The second is the more likely one after a template is edited, and it is a question
// about the text rather than about this render -- so an unused binding is reported even when the
// loop that would have read it has no rows, or the `@when` that would have is not the one chosen.
pub fn render(sheet: Sheet, name: string, ctx: Json) -> Result<string, string> {
    val found = named_in(sheet, name)
    if None = found {
        return err(concat("this sheet has no template called '", name, "' (it has: ", sheet_names(sheet), ")"))
    }
    if !Json.is_JObject(ctx) {
        return err(concat("a template's context is a JSON object, and this one is ", kind_of(ctx)))
    }
    val t = unwrap(found)
    if JObject(fields) = ctx {
        for key, ignored in fields {
            if !contains(t.refs, key) {
                return err(concat(
                    "'",
                    key,
                    "' is bound and template '",
                    name,
                    "' never mentions it (it uses: ",
                    join(separator: ", ", pieces: t.refs),
                    ")"
                ))
            }
        }
    }
    val out = mutable_array_new<string>()
    try emit(t.nodes, ctx, out)
    return ok(concat(pieces: snapshot(out)))
}

// The same with the three constructors' sugar, which is what every bundled generator passes.
// **Kept rather than migrated**: the generators declare `template.Row` and build binding lists in
// about 1,100 lines, and their output is pinned byte for byte -- so leaving those call sites alone
// while the engine underneath changes is what makes the fixtures evidence that the new model
// renders the same text, rather than two changes proving each other.
pub fn render(sheet: Sheet, name: string, bindings: [Binding]) -> Result<string, string> {
    return render(sheet, name, context(bindings))
}
