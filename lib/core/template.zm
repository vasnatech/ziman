// Templates for generated code: the shape of the output, visible in the source.
//
// Written for the derive generators (`lib/core/derive_*.zm`), which assemble Ziman source. A
// generator built from `push`/`concat` hides the thing it exists to produce; the same generator
// built from a template shows it. See docs/design/templates.md for the design, and its §12 for
// the comparison this module was built on.
//
// ```
// pub fn @{snake}_compare(a: @{self}, b: @{self}) -> int {
// @for m in members
//     val c_@{m.name} = compare(a.@{m.name}, b.@{m.name})
// @end
//     return 0
// }
// ```
//
// **`@` and not `{}`**, which is where this parts company with `format`: a code template's output
// is mostly braces, and under `format`'s `{{`/`}}` rule every literal brace would double -- the
// common case paying for the rare one. `@` is not a token in Ziman's grammar at all.
//
// **There are no expressions.** `@if` takes a bound boolean; a loop runs over bound rows; a hole
// holds a bound string. Anything that needs computing is computed in Ziman, where the type
// checker reads it. That rule is the whole design and the reason this is 300 lines rather than a
// second language -- docs/design/templates.md §4 argues it against the generator that wants the
// most.
//
// **This module carries no `#[derive(..)]` and uses no generated code, deliberately**: a
// generator that needs a generator cannot be loaded. See the design's §8.
#![experimental]

// ------------------------------------------------------------------ the parsed template

// `@{name}`, or `@{binder.name}` for a cell of the row a `@for` is on. `binder` is empty for the
// first form.
struct HoleRef {
    binder: string
    name: string
}

struct Loop {
    binder: string
    source: string
    body: [Node]
}

struct Branch {
    flag: string
    then_body: [Node]
    else_body: [Node]
}

enum Node {
    Literal(string)
    Hole(HoleRef)
    Repeat(Loop)
    Choose(Branch)
}

// A template, parsed. **Parse once, in a module-level `val`** -- `repository.query`'s pattern, and
// the same gain: a malformed template fails when the module loads rather than on the first call
// that happens to reach it.
pub struct Template {
    nodes: [Node]
    // Every top-level name the text mentions -- holes, `@for` sources and `@if` flags. Collected
    // at parse time so that `render` can refuse an unused binding, which is a *static* question
    // about the text: counting what a render touched would call a binding unused whenever its
    // loop ran zero times.
    refs: [string]
}

// ------------------------------------------------------------------ what a template is given

pub struct Row {
    cells: [Binding]
}

enum Bound {
    Text(string)
    Flag(bool)
    Rows([Row])
}

// A value under a name, as `eql.bind` is -- the same problem, so the same shape.
pub struct Binding {
    name: string
    value: Bound
}

// A string for `@{name}`. **Everything a hole can hold is already a string**, so there is no
// number to format and no question about how one is formatted.
pub fn text(name: string, value: string) -> Binding {
    return Binding { name: name, value: Bound.Text(value) }
}

// A boolean for `@if name`, and nothing else reads it.
pub fn flag(name: string, value: bool) -> Binding {
    return Binding { name: name, value: Bound.Flag(value) }
}

// The rows a `@for name` repeats over.
pub fn rows(name: string, value: [Row]) -> Binding {
    return Binding { name: name, value: Bound.Rows(value) }
}

// One row of a `@for`: its cells are reached qualified, as `@{binder.cell}`.
pub fn row(cells: [Binding]) -> Row {
    return Row { cells: cells }
}

// ------------------------------------------------------------------ parsing

fn problem(line_no: int, message: string) -> string {
    return concat("template line ", str(line_no), ": ", message)
}

// One line's text, as literals and holes. A line is scanned between `@`s rather than character by
// character, so the usual case copies in one piece.
fn parse_line(text: string, line_no: int) -> Result<[Node], string> {
    val out = mutable_array_new<Node>()
    var at = 0
    while at < len(text) {
        val sigil = index_of(text, "@", at)
        if sigil < 0 {
            push(out, Node.Literal(substring(text, at, len(text))))
            at = len(text)
            continue
        }
        if sigil > at {
            push(out, Node.Literal(substring(text, at, sigil)))
        }
        if is_char_at(text, sigil + 1, "@") {
            push(out, Node.Literal("@"))
            at = sigil + 2
            continue
        }
        if !is_char_at(text, sigil + 1, "{") {
            return err(problem(line_no, "a lone '@' -- write '@@' for a literal one, or '@{name}' for a hole"))
        }
        val close = index_of(text, "}", sigil + 2)
        if close < 0 {
            return err(problem(line_no, "'@{' with no closing '}'"))
        }
        val inside = substring(text, sigil + 2, close)
        if len(trim(inside)) == 0 {
            return err(problem(line_no, "'@{}' names nothing"))
        }
        if Some(parts) = split_once(inside, ".") {
            push(out, Node.Hole(HoleRef { binder: parts[0], name: parts[1] }))
        } else {
            push(out, Node.Hole(HoleRef { binder: "", name: inside }))
        }
        at = close + 1
    }
    return snapshot(out)
}

// What a nested `parse_block` hands back: the nodes it read, the line after it, and which
// directive stopped it ("end", "else", or "" for the end of the template).
struct Block {
    nodes: [Node]
    next: int
    closer: string
}

fn is_directive(t: string) -> bool {
    return starts_with(t, "@for ") || starts_with(t, "@if ") || t == "@else" || t == "@end"
}

fn parse_block(lines: [string], start: int) -> Result<Block, string> {
    val out = mutable_array_new<Node>()
    var i = start
    while i < len(lines) {
        val raw = lines[i]
        val t = trim(raw)
        val line_no = i + 1
        if t == "@end" {
            return Block { nodes: snapshot(out), next: i + 1, closer: "end" }
        }
        if t == "@else" {
            return Block { nodes: snapshot(out), next: i + 1, closer: "else" }
        }
        if starts_with(t, "@for ") {
            val head = split(trim(substring(t, 5, len(t))), " ")
            if len(head) != 3 || head[1] != "in" {
                return err(problem(line_no, "'@for' reads '@for <binder> in <name>'"))
            }
            val inner = try parse_block(lines, i + 1)
            if inner.closer != "end" {
                return err(problem(line_no, "this '@for' is never closed by an '@end'"))
            }
            push(out, Node.Repeat(Loop { binder: head[0], source: head[2], body: inner.nodes }))
            i = inner.next
            continue
        }
        if starts_with(t, "@if ") {
            val flag_name = trim(substring(t, 4, len(t)))
            val taken = try parse_block(lines, i + 1)
            var otherwise: [Node] = []
            var after = taken.next
            if taken.closer == "else" {
                val rest = try parse_block(lines, taken.next)
                if rest.closer != "end" {
                    return err(problem(line_no, "this '@else' is never closed by an '@end'"))
                }
                otherwise = rest.nodes
                after = rest.next
            }
            if taken.closer == "" {
                return err(problem(line_no, "this '@if' is never closed by an '@end'"))
            }
            push(out, Node.Choose(Branch { flag: flag_name, then_body: taken.nodes, else_body: otherwise }))
            i = after
            continue
        }
        // Not a directive, so it is text -- but a line opening with `@` and not `@@` or `@{` is a
        // misspelled directive far more often than it is literal text, and saying so beats the
        // lone-'@' message parse_line would give it.
        if starts_with(t, "@") && !starts_with(t, "@@") && !starts_with(t, "@{") {
            return err(problem(line_no, "unknown directive -- the four are '@for', '@if', '@else' and '@end'"))
        }
        for n in try parse_line(raw, line_no) {
            push(out, n)
        }
        // Every line but the last carries its newline; a directive line carries none, which is
        // what lets `@for` sit on its own line without opening a gap in the output.
        if i + 1 < len(lines) {
            push(out, Node.Literal("\n"))
        }
        i = i + 1
    }
    return Block { nodes: snapshot(out), next: i, closer: "" }
}

fn collect_refs(nodes: [Node], into: MutableArray<string>) {
    for n in nodes {
        switch n {
            Literal(s) {
                val ignored = s
            }
            Hole(h) {
                if h.binder == "" && !contains(into, h.name) {
                    push(into, h.name)
                }
            }
            Repeat(l) {
                if !contains(into, l.source) {
                    push(into, l.source)
                }
                collect_refs(l.body, into)
            }
            Choose(b) {
                if !contains(into, b.flag) {
                    push(into, b.flag)
                }
                collect_refs(b.then_body, into)
                collect_refs(b.else_body, into)
            }
        }
    }
}

// Reads a template, or says what is wrong with it and where.
pub fn parse(source: string) -> Result<Template, string> {
    val lines = split(source, "\n")
    val block = try parse_block(lines, 0)
    if block.closer == "end" {
        return err("template: an '@end' with nothing open")
    }
    if block.closer == "else" {
        return err("template: an '@else' with no '@if' open")
    }
    val refs = mutable_array_new<string>()
    collect_refs(block.nodes, refs)
    return Template { nodes: block.nodes, refs: snapshot(refs) }
}

// `parse` for a module-level `val`, where a broken template is a mistake in a string literal in
// the source rather than a condition any caller could act on -- the same reasoning
// `repository.query` records for its own `unwrap`.
pub fn must_parse(source: string) -> Template {
    return unwrap(parse(source))
}

// ------------------------------------------------------------------ rendering

struct Frame {
    binder: string
    cells: [Binding]
}

fn names_of(bindings: [Binding]) -> string {
    val out = mutable_array_new<string>()
    for b in bindings {
        push(out, b.name)
    }
    return join(separator: ", ", pieces: snapshot(out))
}

fn lookup(bindings: [Binding], name: string) -> Option<Bound> {
    for b in bindings {
        if b.name == name {
            return Option<Bound>.Some(b.value)
        }
    }
    return Option<Bound>.None
}

fn emit(nodes: [Node], globals: [Binding], frames: [Frame], out: MutableArray<string>) -> Result<unit, string> {
    for n in nodes {
        switch n {
            Literal(s) {
                push(out, s)
            }
            Hole(h) {
                push(out, try hole_text(h, globals, frames))
            }
            Repeat(l) {
                val bound = lookup(globals, l.source)
                if None = bound {
                    return err(concat("'@for .. in ", l.source, "' is not bound (bound: ", names_of(globals), ")"))
                }
                val value = unwrap(bound)
                if !Bound.is_Rows(value) {
                    return err(concat(
                        "'@for .. in ",
                        l.source,
                        "' needs rows, and '",
                        l.source,
                        "' is bound to a ",
                        kind_of(value)
                    ))
                }
                for r in Bound.unwrap_Rows(value) {
                    try emit(l.body, globals, push(frames, Frame { binder: l.binder, cells: r.cells }), out)
                }
            }
            Choose(b) {
                val bound = lookup(globals, b.flag)
                if None = bound {
                    return err(concat("'@if ", b.flag, "' is not bound (bound: ", names_of(globals), ")"))
                }
                val value = unwrap(bound)
                if !Bound.is_Flag(value) {
                    return err(concat(
                        "'@if ",
                        b.flag,
                        "' needs a flag, and '",
                        b.flag,
                        "' is bound to a ",
                        kind_of(value)
                    ))
                }
                if Bound.unwrap_Flag(value) {
                    try emit(b.then_body, globals, frames, out)
                } else {
                    try emit(b.else_body, globals, frames, out)
                }
            }
        }
    }
    return unit
}

fn kind_of(v: Bound) -> string {
    if Bound.is_Text(v) {
        return "string"
    }
    if Bound.is_Flag(v) {
        return "flag"
    }
    return "list of rows"
}

fn hole_text(h: HoleRef, globals: [Binding], frames: [Frame]) -> Result<string, string> {
    if h.binder == "" {
        val bound = lookup(globals, h.name)
        if None = bound {
            return err(concat("'@{", h.name, "}' is not bound (bound: ", names_of(globals), ")"))
        }
        val value = unwrap(bound)
        if !Bound.is_Text(value) {
            return err(concat("'@{", h.name, "}' is bound to a ", kind_of(value), ", and a hole holds a string"))
        }
        return ok(Bound.unwrap_Text(value))
    }
    for f in frames {
        if f.binder == h.binder {
            val cell = lookup(f.cells, h.name)
            if None = cell {
                return err(concat(
                    "'@{",
                    h.binder,
                    ".",
                    h.name,
                    "}' names no cell of that row (it has: ",
                    names_of(f.cells),
                    ")"
                ))
            }
            val value = unwrap(cell)
            if !Bound.is_Text(value) {
                return err(concat(
                    "'@{",
                    h.binder,
                    ".",
                    h.name,
                    "}' is bound to a ",
                    kind_of(value),
                    ", and a hole holds a string"
                ))
            }
            return ok(Bound.unwrap_Text(value))
        }
    }
    return err(concat("'@{", h.binder, ".", h.name, "}' -- '", h.binder, "' is not a '@for' binder in scope here"))
}

// The template's text with its holes filled.
//
// **Both directions are checked**: a hole naming nothing bound, and a binding the text never
// mentions. The second is the more likely one after a template is edited, and it is a question
// about the text rather than about this render -- so an unused binding is reported even when the
// loop that would have read it has no rows.
pub fn render(t: Template, bindings: [Binding]) -> Result<string, string> {
    for b in bindings {
        if !contains(t.refs, b.name) {
            return err(concat(
                "'",
                b.name,
                "' is bound and the template never mentions it (it uses: ",
                join(separator: ", ", pieces: t.refs),
                ")"
            ))
        }
    }
    val out = mutable_array_new<string>()
    try emit(t.nodes, bindings, [], out)
    return ok(concat(pieces: snapshot(out)))
}
