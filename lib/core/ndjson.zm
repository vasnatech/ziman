// ndjson.zm -- newline-delimited JSON: one JSON value per line, written on top of `json`.
// The format of the FHIR bulk-data files and of most log pipelines.

use json.Json
use json.json_to_string
use json.parse_json

// Every non-blank line as a JSON value, in order. A line that is not valid JSON is an
// error naming its (1-based) line number. A trailing CR (CRLF files) is ignored.
pub fn parse_ndjson(text: string) -> Result<[Json], string> {
    val items = ab_new<Json>()
    var line_no = 0
    for raw in split(text, "\n") {
        line_no = line_no + 1
        val line = trim(raw)
        if len(line) == 0 {
            continue
        }
        val parsed = parse_json(line)
        if !is_ok(parsed) {
            return err(format("line {}: {}", line_no, unwrap_err(parsed)))
        }
        ab_append<Json>(items, unwrap(parsed))
    }
    return ok(ab_to_array<Json>(items))
}

// One compact JSON value per line, each line ended by "\n" (so the text ends with a newline).
pub fn ndjson_to_string(items: [Json]) -> string {
    val out = sb_new()
    for item in items {
        sb_append(out, json_to_string(item), "\n")
    }
    return sb_to_string(out)
}
