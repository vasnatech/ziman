// jwt.zm -- JSON Web Tokens (RFC 7519), in two families: **a shared secret** (HS256, HS384,
// HS512) and **a P-256 key pair** (ES256, added 2026-10-29). `sign` makes a token from a claims
// object, `verify` checks one and gives the claims back. Built on `crypto` (HMAC, ECDSA,
// base64url, a constant-time comparison), `json` and `clock`.
//
// **A key's type chooses its family, and that is a security property rather than a convenience.**
// A shared secret is `[byte]`; an EC key is PEM `string`. The classic JWT attack is algorithm
// confusion -- presenting a public key as if it were an HMAC secret, so a token the attacker
// signed verifies -- and it needs one key parameter that both families read. There is none here,
// so a token's `alg` header can only choose **within** the family the caller already chose: an
// `HS256` token handed to a verifier holding a public key is refused by name, never MAC'd with the
// PEM text as a secret. `tests/lang/jwt_es256` pins that and three more of the same shape.
//
//     val key = unwrap(base64_decode(secret))
//     val token = unwrap(jwt.sign(jwt.with_claim(jwt.claims("ada@example.com", 3600), "role", Json.JString("admin")), key))
//     switch jwt.verify(token, key) {
//         Ok(claims) { ... jwt.subject(claims) ... }
//         Err(e) { print(jwt.jwt_error_message(e)) }
//     }
//
// What `verify` checks: the token has three parts and a JSON header and payload; the header's `alg` is one of the three
// HMAC algorithms (never `none`, and never an algorithm this module cannot use with a shared key); the signature matches,
// compared in constant time; the token HAS an `exp` claim and it is not past; `nbf`, when there is one, is not in the future
// (each with an optional leeway); and an `exp` or `nbf` that is there but is not a number is an error, not "no expiry". A
// token without `exp` never expires, so `verify` refuses one unless `verify_claims(require_exp: false)` says a token may be
// open-ended. `verify_claims` can also require the issuer (`iss`) and audience (`aud`) to be the ones this service expects,
// which matters when several services share a key: without it a token issued for one is accepted by all. It does not check
// `sub`: read it from the claims. Only the signature of the token as issued protects it, so keep the key secret and long
// (32 bytes or more for HS256).
//
//     jwt.verify_claims(token: t, key: key, issuer: "health-record", audience: "web")

use clock
use crypto
use encoding
use json
use json.Json
use json.int_to_json
use json.number_of
use json.parse
use json.require_string
use number.to_hex

// Why a token was rejected.
pub enum JwtError {
    Malformed(string)
    UnsupportedAlgorithm(string)
    BadSignature
    Expired
    NotYetValid
    MissingClaim(string)
    WrongIssuer
    WrongAudience
}

// The text for a JwtError.
pub fn jwt_error_message(e: JwtError) -> string {
    return switch e {
        Malformed(reason) { format("malformed token: {}", reason) }
        UnsupportedAlgorithm(name) { format("unsupported algorithm '{}'", name) }
        BadSignature { "the signature does not match" }
        Expired { "the token has expired" }
        NotYetValid { "the token is not valid yet" }
        MissingClaim(name) { format("the token has no '{}' claim", name) }
        WrongIssuer { "the token was issued by someone else" }
        WrongAudience { "the token is not for this audience" }
    }
}

// The HMAC algorithm that matches a key's size, as the common libraries choose it: HS512 for 64 bytes or more, HS384 for 48
// or more, otherwise HS256.
pub fn algorithm_for_key(key: [byte]) -> string {
    if len(key) >= 64 {
        return "HS512"
    }
    if len(key) >= 48 {
        return "HS384"
    }
    return "HS256"
}

// A key, as this module's two families spell it: a shared secret is bytes and an EC key is PEM
// text.
//
// **This type is the security property, not a convenience.** The classic JWT attack is algorithm
// confusion -- presenting a public key as if it were a shared secret, so that a token the attacker
// signed with the (public) key verifies. It needs one key parameter that both families read. Here
// the families are two types, a caller picks one by which function they call, and the `alg` header
// can only choose **within** the family the caller already chose: `signature_holds` refuses every
// other pairing. A token saying `HS256` to a verifier holding a public key is refused by name, and
// one saying `ES256` to a verifier holding a secret likewise.
enum Key {
    Secret([byte])
    PublicPem(string)
}

// Whether `algorithm` is one the family can use at all, and the signature over `data`.
//
// **The one place a key and an algorithm meet**, so that the pairing table is readable in full and
// a new algorithm has exactly one place to be wrong.
fn signature_holds(algorithm: string, key: Key, data: [byte], given: [byte]) -> Option<bool> {
    if Secret(secret) = key {
        if Some(expected) = mac(algorithm, secret, data) {
            return Option<bool>.Some(crypto.bytes_equal(expected, given))
        }
        return Option<bool>.None
    }
    if PublicPem(pem) = key {
        if algorithm == "ES256" {
            return Option<bool>.Some(crypto.ecdsa_p256_verify(pem, data, given))
        }
        return Option<bool>.None
    }
    return Option<bool>.None
}

fn mac(algorithm: string, key: [byte], data: [byte]) -> Option<[byte]> {
    if algorithm == "HS256" {
        return Option<[byte]>.Some(crypto.hmac_sha256(key, data))
    }
    if algorithm == "HS384" {
        return Option<[byte]>.Some(crypto.hmac_sha384(key, data))
    }
    if algorithm == "HS512" {
        return Option<[byte]>.Some(crypto.hmac_sha512(key, data))
    }
    return Option<[byte]>.None
}

fn now_seconds() -> int {
    return clock.now_raw()[0]
}

// A claims object for `subject` (the `sub` claim) issued now (`iat`) and expiring `expires_in_seconds` from now (`exp`).
pub fn claims(subject: string, expires_in_seconds: int) -> Json {
    val now = now_seconds()
    return Json.JObject(Map<string, Json> {
        "sub": Json.JString(subject),
        "iat": int_to_json(now),
        "exp": int_to_json(now + expires_in_seconds)
    })
}

// `claims` with one more claim (or `name` replaced): `with_claim(c, "role", Json.JString("admin"))`. `claims` that is not a
// JSON object is returned as it is.
pub fn with_claim(claims: Json, name: string, value: Json) -> Json {
    if JObject(fields) = claims {
        return Json.JObject(set(fields, name, value))
    }
    return claims
}

// A token for `claims` (a JSON object), signed with `key` and the HMAC algorithm that matches its size
// (`algorithm_for_key`). An Err for claims that are not an object.
pub fn sign(claims: Json, key: [byte]) -> Result<string, string> {
    return sign(claims, key, algorithm_for_key(key))
}

// The same with `algorithm` chosen: HS256, HS384 or HS512, an Err for anything else.
//
// **`sign_with` until 2026-10-24.** The suffix was saying what the third argument already says,
// and an algorithm is a `string` where nothing else here is -- unlike a bare `true` or a lone
// `int`, a reader of `sign(claims, key, "HS512")` needs no name to tell them what it is.
pub fn sign(claims: Json, key: [byte], algorithm: string) -> Result<string, string> {
    if !Json.is_JObject(claims) {
        return err("the claims of a token must be a JSON object")
    }
    val signing_input = try signing_input_for(claims, algorithm)
    if Some(signature) = mac(algorithm, key, to_bytes(signing_input)) {
        return ok(format("{}.{}", signing_input, encoding.base64url_encode(signature)))
    }
    return err(format("unsupported algorithm '{}': use HS256, HS384 or HS512", algorithm))
}

fn signing_input_for(claims: Json, algorithm: string) -> Result<string, string> {
    val header = Json.JObject(Map<string, Json> {
        "alg": Json.JString(algorithm),
        "typ": Json.JString("JWT")
    })
    return ok(format(
        "{}.{}",
        encoding.base64url_encode(to_bytes(json.format(header))),
        encoding.base64url_encode(to_bytes(json.format(claims)))
    ))
}

// **ES256**: a token signed with a P-256 private key as PEM text, so a holder can verify it
// without being able to issue one. That is what a shared secret cannot do, and what a verifiable
// credential needs (2026-10-29).
//
// The key is a `string` where an HMAC key is `[byte]`, and that is deliberate: see `Key`. An EC key
// is never a `[byte]` key here, so there is no call that hands a public key to the HMAC path.
pub fn sign(claims: Json, private_key_pem: string) -> Result<string, string> {
    return sign(claims, private_key_pem, "ES256")
}

// The same with the algorithm written out. `ES256` is the only one an EC key signs here -- P-256 is
// the only curve `crypto` has -- and anything else is refused by name rather than ignored.
pub fn sign(claims: Json, private_key_pem: string, algorithm: string) -> Result<string, string> {
    if !Json.is_JObject(claims) {
        return err("the claims of a token must be a JSON object")
    }
    if algorithm != "ES256" {
        return err(format(
            "unsupported algorithm '{}' for a PEM key: an EC key signs ES256 (a shared secret " \
                "signs HS256, HS384 or HS512)",
            algorithm
        ))
    }
    val signing_input = try signing_input_for(claims, algorithm)
    val signature = crypto.ecdsa_p256_sign(private_key_pem, to_bytes(signing_input))
    if Err(why) = signature {
        return err(why)
    }
    return ok(format("{}.{}", signing_input, encoding.base64url_encode(unwrap(signature))))
}

fn decode_part(part: string, what: string) -> Result<Json, JwtError> {
    val raw = encoding.base64url_decode(part)
    if Err(reason) = raw {
        return JwtError.Malformed(format("{} is not base64url ({})", what, reason))
    }
    val text = bytes_to_string(unwrap(raw))
    if Err(reason) = text {
        return JwtError.Malformed(format("{} is not text ({})", what, reason))
    }
    val tree = parse(unwrap(text))
    if Err(reason) = tree {
        return JwtError.Malformed(format("{} is not JSON ({})", what, reason))
    }
    return unwrap(tree)
}

// The numeric claim `name` in seconds: None when it is not there, an Err when it is there and is not a number (so a
// token cannot pass as open-ended by saying `"exp": "never"`).
fn seconds_claim(payload: Json, name: string) -> Result<Option<int>, JwtError> {
    if Some(value) = json.get(payload, name) {
        if Some(number) = number_of(value) {
            switch number {
                Int(n) { return Option<int>.Some(n) }
                Float(f) { return Option<int>.Some(f as int) }
                Bigint(b) { return Option<int>.Some(b as int) }
                Decimal(d) { return Option<int>.Some(d as int) }
            }
        }
        return JwtError.Malformed(format("the '{}' claim is not a number", name))
    }
    return Option<int>.None
}

// Checks `token` against `key` as of `now_seconds` (Unix time) with `leeway_seconds` of allowed clock difference on `exp`
// and `nbf`, and gives back its claims. `verify` is this with the current time; this one exists so a token can be checked at a
// chosen time. The token must have an `exp`.
pub fn verify_at(token: string, key: [byte], now_seconds: int, leeway_seconds: int) -> Result<Json, JwtError> {
    return check(
        token,
        Key.Secret(key),
        now_seconds,
        leeway_seconds,
        true,
        Option<string>.None,
        Option<string>.None,
        Option<string>.None
    )
}

// Checks `token` against `key` now and gives back its claims. The token must have an `exp` that is not past.
pub fn verify(token: string, key: [byte]) -> Result<Json, JwtError> {
    return check(
        token,
        Key.Secret(key),
        now_seconds(),
        0,
        true,
        Option<string>.None,
        Option<string>.None,
        Option<string>.None
    )
}

// **ES256**: checks `token` against a P-256 **public** key as PEM text. The key verifies and
// cannot issue, which is the whole reason this path exists.
//
// A token naming any other algorithm is refused by name rather than verified another way -- see
// `Key`, where that is the point rather than a precaution.
pub fn verify(token: string, public_key_pem: string) -> Result<Json, JwtError> {
    return check(
        token,
        Key.PublicPem(public_key_pem),
        now_seconds(),
        0,
        true,
        Option<string>.None,
        Option<string>.None,
        Option<string>.None
    )
}

// `verify_at` for a public key: the same clock control, the same family rule.
pub fn verify_at(
    token: string,
    public_key_pem: string,
    now_seconds: int,
    leeway_seconds: int
) -> Result<Json, JwtError> {
    return check(
        token,
        Key.PublicPem(public_key_pem),
        now_seconds,
        leeway_seconds,
        true,
        Option<string>.None,
        Option<string>.None,
        Option<string>.None
    )
}

// `verify` with every check chosen, in a named call that leaves out what it does not need. `leeway_seconds` (default 0) is the
// clock difference forgiven on `exp` and `nbf`; `now` (default the current time) is the Unix time to check as of;
// `require_exp` (default true) says a token with no `exp` is refused (`MissingClaim("exp")`) -- pass false only for a token
// that is meant never to expire; `issuer`, when given, must be the token's `iss` (`WrongIssuer`, or `MissingClaim("iss")` when
// there is none); and `audience`, when given, must be the token's `aud` -- a string, or one of an array of strings
// (`WrongAudience`, or `MissingClaim("aud")`). An `exp` or `nbf` that is not a number is `Malformed` whatever `require_exp` says.
pub fn verify_claims(
    token: string,
    key: [byte],
    leeway_seconds: Option<int>,
    now: Option<int>,
    require_exp: Option<bool>,
    issuer: Option<string>,
    audience: Option<string>,
    algorithm: Option<string>
) -> Result<Json, JwtError> {
    return check(
        token,
        Key.Secret(key),
        get_or(now, now_seconds()),
        get_or(leeway_seconds, 0),
        get_or(require_exp, true),
        issuer,
        audience,
        algorithm
    )
}

// `verify_claims` for a public key: every check the HMAC form offers, over the family a PEM key
// can use. A credential is the case that wants `issuer`/`audience` most, since the point of
// publishing a verifying key is that several parties hold it.
//
// **This was `verify_claims_pem` until F239.** A named call that omitted optional parameters did
// not resolve against an overload set, so declaring a second `verify_claims` broke every existing
// `verify_claims(token: t, key: k, now: n)` with "no declaration takes 3 argument(s)" -- a gap in
// overload resolution rather than a fact about JWTs, and this carried a name of its own to work
// around it while `verify`/`verify_at`, which are called positionally, overloaded cleanly. With
// the gap closed the name is the key's own: `key:` reaches the secret form and
// `public_key_pem:` reaches this one, so the parameter a caller names chooses the family, exactly
// as the type does for the positional pair.
pub fn verify_claims(
    token: string,
    public_key_pem: string,
    leeway_seconds: Option<int>,
    now: Option<int>,
    require_exp: Option<bool>,
    issuer: Option<string>,
    audience: Option<string>,
    algorithm: Option<string>
) -> Result<Json, JwtError> {
    return check(
        token,
        Key.PublicPem(public_key_pem),
        get_or(now, now_seconds()),
        get_or(leeway_seconds, 0),
        get_or(require_exp, true),
        issuer,
        audience,
        algorithm
    )
}

fn check(
    token: string,
    key: Key,
    now: int,
    leeway: int,
    require_exp: bool,
    issuer: Option<string>,
    audience: Option<string>,
    expect_algorithm: Option<string>
) -> Result<Json, JwtError> {
    val parts = split(token, ".")
    if len(parts) != 3 {
        return JwtError.Malformed("a token has three parts separated by dots")
    }
    val header = try decode_part(parts[0], "the header")
    val algorithm = require_string(header, "alg")
    if Err(_) = algorithm {
        return JwtError.Malformed("the header has no 'alg'")
    }
    // **Pinning, when the caller asked for it.** Checked before any signature is computed, so a
    // token naming an algorithm the caller did not ask for is refused rather than verified under
    // it.
    //
    // **Why it is opt-in, corrected 2026-10-29 when ES256 arrived.** This comment used to argue
    // that a trusted `alg` header needs a *mix* of symmetric and asymmetric algorithms to be
    // dangerous -- presenting a public key as an HMAC secret -- and that with HS256/384/512 as the
    // whole set, switching `alg` bought an attacker nothing. The premise is gone: the mix exists
    // now. What replaces it is stronger than pinning and is not optional: **the key's own type
    // chooses the family** (`Key`, and the pairing in `signature_holds`), so a token's header can
    // only choose within the family the caller already chose. An `HS256` token presented to a
    // verifier holding a public key is refused by name, not verified with the PEM text as a
    // secret. What pinning still buys is the narrower thing it always bought: a deployment signing
    // with HS512 stops accepting a valid HS256 token over the same key.
    if Some(wanted_alg) = expect_algorithm {
        if unwrap(algorithm) != wanted_alg {
            return JwtError.UnsupportedAlgorithm(unwrap(algorithm))
        }
    }
    val given = encoding.base64url_decode(parts[2])
    if Err(reason) = given {
        return JwtError.Malformed(format("the signature is not base64url ({})", reason))
    }
    val holds = signature_holds(
        unwrap(algorithm),
        key,
        to_bytes(format("{}.{}", parts[0], parts[1])),
        unwrap(given)
    )
    if None = holds {
        return JwtError.UnsupportedAlgorithm(unwrap(algorithm))
    }
    if !unwrap(holds) {
        return JwtError.BadSignature
    }
    val payload = try decode_part(parts[1], "the payload")
    if !Json.is_JObject(payload) {
        return JwtError.Malformed("the payload is not a JSON object")
    }
    val exp = try seconds_claim(payload, "exp")
    if Some(at) = exp {
        if now - leeway >= at {
            return JwtError.Expired
        }
    } else if require_exp {
        return JwtError.MissingClaim("exp")
    }
    val nbf = try seconds_claim(payload, "nbf")
    if Some(from) = nbf {
        if now + leeway < from {
            return JwtError.NotYetValid
        }
    }
    if Some(wanted) = issuer {
        if Some(found) = json.get(payload, "iss") {
            val actual = switch issuer_of(found) {
                Some(a) { a }
                None { return JwtError.WrongIssuer }
            }
            if actual != wanted {
                return JwtError.WrongIssuer
            }
        } else {
            return JwtError.MissingClaim("iss")
        }
    }
    if Some(wanted) = audience {
        if Some(found) = json.get(payload, "aud") {
            var listed = false
            for name in audiences_of(found) {
                if name == wanted {
                    listed = true
                }
            }
            if !listed {
                return JwtError.WrongAudience
            }
        } else {
            return JwtError.MissingClaim("aud")
        }
    }
    return payload
}

fn issuer_of(value: Json) -> Option<string> {
    if JString(text) = value {
        return Option<string>.Some(text)
    }
    return Option<string>.None
}

// The audiences an `aud` claim names: the string itself, or the strings of an array (anything else in it is ignored).
fn audiences_of(value: Json) -> [string] {
    if JString(text) = value {
        return [text]
    }
    val names = mutable_array_new<string>()
    if JArray(items) = value {
        for item in items {
            if JString(text) = item {
                push(names, text)
            }
        }
    }
    return snapshot(names)
}

// The `sub` claim, when it is a string.
pub fn subject(claims: Json) -> Option<string> {
    if Some(value) = json.get(claims, "sub") {
        if JString(text) = value {
            return Option<string>.Some(text)
        }
    }
    return Option<string>.None
}

// The `iss` claim, when it is a string.
pub fn issuer(claims: Json) -> Option<string> {
    if Some(value) = json.get(claims, "iss") {
        return issuer_of(value)
    }
    return Option<string>.None
}

// The audiences the `aud` claim names, in order: `["web"]` for `"aud": "web"`, the strings of an array, and `[]` when there is
// no `aud` (or it is neither).
pub fn audience(claims: Json) -> [string] {
    if Some(value) = json.get(claims, "aud") {
        return audiences_of(value)
    }
    val none: [string] = []
    return none
}
