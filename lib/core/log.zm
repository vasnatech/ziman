// log.zm -- levelled logging to stderr or to a file.
//
// Ziman has no mutable globals, so there is no hidden "the logger": you build a
// `Logger` once (from configuration, say) and pass it where it is needed.
//
//   val logger = log.logger(level: Level.Info)
//   log.info(logger, "listening on port 8080")
//   log.debug(logger, "not printed: below the Info threshold")
//
// A line looks like `2026-09-24T12:00:00.123Z INFO  listening on port 8080`.
// Messages below the logger's level are dropped without being written.
//
// A logger with a `file` can rotate it (`max_bytes`, `keep_files`): a file that has reached `max_bytes` is renamed `<file>.1`, the older `<file>.1` becoming `<file>.2`
// and so on up to `<file>.<keep_files>`, and the oldest is deleted, before the next line is written to a fresh `<file>`. So a log never grows past about
// `max_bytes` (plus one line) in the file that is written, nor past `keep_files` more of them. Without `max_bytes` a log is never rotated (the operator's `logrotate`
// does it, or nothing does).
use clock.now_iso
use fs
use os

// A message's severity, lowest first. A logger drops messages below its own level.
pub enum Level {
    Debug
    Info
    Warn
    Error
}

// A logger's settings; build one with `logger`, and use `with_prefix` for per-component copies.
pub struct Logger {
    level: Level
    file: Option<string>
    timestamps: bool
    prefix: string
    console: bool
    max_bytes: int
    keep_files: int
}

fn open_rotation_lock() -> Channel<int> {
    val lock: Channel<int> = channel_new()
    send(lock, 1)
    return lock
}

// Held while a log file is being rotated, so two threads that both see a full file do not both rotate it.
val rotation_lock: Channel<int> = open_rotation_lock()

// A logger for messages at `level` and above. Without `file` it writes to
// stderr; with one it appends to that file (a failed write falls back to
// stderr, so a log line is never silently lost). `timestamps: false` leaves the
// time off, for output that is compared in tests. With `console: true` a logger that has a `file` also
// writes every line to stderr, as a server does that logs to a file for the record and to the console for whoever
// is watching. `max_bytes` (0 or left out: never) rotates the file when it reaches that size, keeping `keep_files` old ones (default 5; 0 keeps none).
pub fn logger(
    level: Level,
    file: Option<string>,
    timestamps: Option<bool>,
    prefix: Option<string>,
    console: Option<bool>,
    max_bytes: Option<int>,
    keep_files: Option<int>
) -> Logger {
    return Logger {
        level: level,
        file: file,
        timestamps: option_unwrap_or<bool>(timestamps, true),
        prefix: option_unwrap_or<string>(prefix, ""),
        console: option_unwrap_or<bool>(console, false),
        max_bytes: option_unwrap_or<int>(max_bytes, 0),
        keep_files: option_unwrap_or<int>(keep_files, 5)
    }
}

// The same logger with `prefix` in front of every message -- one per component.
pub fn with_prefix(l: Logger, prefix: string) -> Logger {
    return Logger {
        level: l.level,
        file: l.file,
        timestamps: l.timestamps,
        prefix: prefix,
        console: l.console,
        max_bytes: l.max_bytes,
        keep_files: l.keep_files
    }
}

// 0 for Debug up to 3 for Error: the order of severity.
pub fn level_rank(level: Level) -> int {
    return switch level {
        Debug { 0 }
        Info { 1 }
        Warn { 2 }
        Error { 3 }
    }
}

// The level as it appears in a log line, padded to five characters ("INFO ").
pub fn level_name(level: Level) -> string {
    return switch level {
        Debug { "DEBUG" }
        Info { "INFO " }
        Warn { "WARN " }
        Error { "ERROR" }
    }
}

// "debug", "info", "warn"/"warning" or "error" (any case), for a level read
// from configuration.
pub fn level_parse(text: string) -> Result<Level, string> {
    val t = to_lower(trim(text))
    if t == "debug" { return ok(Level.Debug) }
    if t == "info" { return ok(Level.Info) }
    if t == "warn" || t == "warning" { return ok(Level.Warn) }
    if t == "error" { return ok(Level.Error) }
    return err(format("unknown log level '{}' (use debug, info, warn or error)", text))
}

// True if a message at `level` would be written by `l`.
pub fn enabled(l: Logger, level: Level) -> bool {
    return level_rank(level) >= level_rank(l.level)
}

// `message` with each line break written as the two characters `\n` or `\r`, so text that came from a
// user (an email address in a failed login) cannot end the log line and start a forged one.
fn single_line(message: string) -> string {
    return replace(replace(message, "\n", "\\n"), "\r", "\\r")
}

// Moves `<path>.<n>` to `<path>.<n + 1>` for the kept files, oldest first, and `path` to `<path>.1`; the file past the last kept one is deleted. With
// `keep` below 1 the full file is just deleted.
fn shift_files(path: string, keep: int) {
    if keep < 1 {
        val _ = fs.remove(path)
        return
    }
    val _ = fs.remove(format("{}.{}", path, keep))
    var n = keep - 1
    while n >= 1 {
        val from = format("{}.{}", path, n)
        if fs.exists(from) {
            val _ = fs.rename(from, format("{}.{}", path, n + 1))
        }
        n = n - 1
    }
    val _ = fs.rename(path, format("{}.1", path))
}

// Rotates `path` if it has reached `max_bytes`. The size is checked again once the lock is held, since another thread may have rotated it in the meantime.
fn rotate_if_full(path: string, max_bytes: int, keep: int) {
    val size = fs.size(path)
    if !is_ok(size) || unwrap(size) < max_bytes {
        return
    }
    receive(rotation_lock)
    val again = fs.size(path)
    if is_ok(again) && unwrap(again) >= max_bytes {
        shift_files(path, keep)
    }
    send(rotation_lock, 1)
}

// Writes `message` at `level` if the logger's level allows it: a line of the form
// `<timestamp> <LEVEL> <prefix><message>`. Line breaks in `message` are written as `\n` and `\r`, so
// one call is always one line. To stderr, or appended to the logger's file (falling back
// to stderr if the file cannot be written, and also written to stderr when the logger is a `console` one).
pub fn write(l: Logger, level: Level, message: string) {
    if !enabled(l, level) {
        return
    }
    var line = ""
    if l.timestamps {
        line = format("{} ", now_iso())
    }
    line = format("{}{} {}{}\n", line, level_name(level), l.prefix, single_line(message))
    switch l.file {
        Some(path) {
            if l.max_bytes > 0 {
                rotate_if_full(path, l.max_bytes, l.keep_files)
            }
            val r = fs.append_text(path, line)
            if !is_ok(r) || l.console {
                os.write_stderr(line)
            }
        }
        None { os.write_stderr(line) }
    }
}

// `write` at each level: detail useful while developing.
pub fn debug(l: Logger, message: string) { write(l, Level.Debug, message) }
// Normal events worth recording.
pub fn info(l: Logger, message: string) { write(l, Level.Info, message) }
// Something unexpected that the program handled.
pub fn warn(l: Logger, message: string) { write(l, Level.Warn, message) }
// A failure the program could not handle.
pub fn error(l: Logger, message: string) { write(l, Level.Error, message) }
