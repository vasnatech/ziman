// log.zm -- levelled logging to stderr or to a file.
//
// Ziman has no mutable globals, so there is no hidden "the logger": you build a
// `Logger` once (from configuration, say) and pass it where it is needed.
//
//   val logger = log.logger(level: Level.Info)
//   log.info(logger, "listening on port 8080")
//   log.debug(logger, "not printed: below the Info threshold")
//
// A line looks like `2026-09-24T12:00:00.123Z INFO  listening on port 8080`.
// Messages below the logger's level are dropped without being written.
//
// A logger with a `file` can rotate it (`max_bytes`, `keep_files`): a file that has reached `max_bytes` is renamed `<file>.1`, the older `<file>.1` becoming `<file>.2`
// and so on up to `<file>.<keep_files>`, and the oldest is deleted, before the next line is written to a fresh `<file>`. So a log never grows past about
// `max_bytes` (plus one line) in the file that is written, nor past `keep_files` more of them. Without `max_bytes` a log is never rotated (the operator's `logrotate`
// does it, or nothing does).
use clock.now_iso
use fs
use json.Json
use json.json_to_string
use number.byte_to_hex
use os

// A message's severity, lowest first. A logger drops messages below its own level.
pub enum Level {
    Debug
    Info
    Warn
    Error
}

// A logger's settings; build one with `logger`, and use `with_prefix` for per-component copies.
pub struct Logger {
    level: Level
    file: Option<string>
    timestamps: bool
    prefix: string
    console: bool
    max_bytes: int
    keep_files: int
    // One JSON object per line instead of the text format, for a log a machine reads. See `write`
    // for the field names and why the escaping goes through `json` rather than `single_line`.
    json: bool
    // Carried on the logger rather than passed to every call, so a request's handler sets it once
    // (`with_request_id`) and every line it logs afterwards carries it -- the same shape as
    // `prefix`, and the reason this is a field and not a parameter. Empty means no id, and the
    // field is then left out of the object rather than written as null, which is friendlier to
    // whatever indexes the log.
    request_id: string
}

fn open_rotation_lock() -> Channel<int> {
    val lock: Channel<int> = channel_new()
    send(lock, 1)
    return lock
}

// Held while a log file is being rotated, so two threads that both see a full file do not both rotate it.
val rotation_lock: Channel<int> = open_rotation_lock()

// A logger for messages at `level` and above. Without `file` it writes to
// stderr; with one it appends to that file (a failed write falls back to
// stderr, so a log line is never silently lost). `timestamps: false` leaves the
// time off, for output that is compared in tests. With `console: true` a logger that has a `file` also
// writes every line to stderr, as a server does that logs to a file for the record and to the console for whoever
// is watching. `max_bytes` (0 or left out: never) rotates the file when it reaches that size, keeping `keep_files` old ones (default 5; 0 keeps none).
pub fn logger(
    level: Level,
    file: Option<string>,
    timestamps: Option<bool>,
    prefix: Option<string>,
    console: Option<bool>,
    max_bytes: Option<int>,
    keep_files: Option<int>,
    json: Option<bool>
) -> Logger {
    return Logger {
        level: level,
        file: file,
        timestamps: option_unwrap_or<bool>(timestamps, true),
        prefix: option_unwrap_or<string>(prefix, ""),
        console: option_unwrap_or<bool>(console, false),
        max_bytes: option_unwrap_or<int>(max_bytes, 0),
        keep_files: option_unwrap_or<int>(keep_files, 5),
        json: option_unwrap_or<bool>(json, false),
        request_id: ""
    }
}

// The same logger with `prefix` in front of every message -- one per component.
//
// Written with `with` rather than by naming all nine fields: the field-by-field version silently
// dropped whatever was added to `Logger` later, which is exactly how `json` and `request_id` would
// have been lost here when they arrived.
pub fn with_prefix(l: Logger, prefix: string) -> Logger {
    return with l { prefix: prefix }
}

// The same logger stamping `id` on every line it writes -- set once where a request begins, so the
// handler's own logging needs no extra argument. An empty `id` clears it again.
pub fn with_request_id(l: Logger, id: string) -> Logger {
    return with l { request_id: id }
}

// 0 for Debug up to 3 for Error: the order of severity.
pub fn level_rank(level: Level) -> int {
    return switch level {
        Debug { 0 }
        Info { 1 }
        Warn { 2 }
        Error { 3 }
    }
}

// The level as it appears in a log line, padded to five characters ("INFO ").
pub fn level_name(level: Level) -> string {
    return switch level {
        Debug { "DEBUG" }
        Info { "INFO " }
        Warn { "WARN " }
        Error { "ERROR" }
    }
}

// "debug", "info", "warn"/"warning" or "error" (any case), for a level read
// from configuration.
pub fn level_parse(text: string) -> Result<Level, string> {
    val t = to_lower(trim(text))
    if t == "debug" { return ok(Level.Debug) }
    if t == "info" { return ok(Level.Info) }
    if t == "warn" || t == "warning" { return ok(Level.Warn) }
    if t == "error" { return ok(Level.Error) }
    return err(format("unknown log level '{}' (use debug, info, warn or error)", text))
}

// True if a message at `level` would be written by `l`.
pub fn enabled(l: Logger, level: Level) -> bool {
    return level_rank(level) >= level_rank(l.level)
}

// `message` with every control byte written out, so text that came from a user (an email address in a failed
// login) cannot do anything to the log but appear in it. A line break would end the line and start a forged
// one, which this always handled; the rest matter just as much and did not. An ESC byte begins an ANSI
// sequence, so `ESC [ 2 J` clears the screen of whoever is reading the log, `ESC [ 1 A` moves the cursor up a
// line to overwrite what is above it, and BEL and BS are the small change of the same trick. A terminal is
// the one place these are instructions rather than characters.
//
// Bytes from 0x80 up pass through untouched: they are UTF-8 continuation and lead bytes, and mangling them
// would corrupt every non-English log line to guard against nothing -- a terminal acts on C0 controls and
// DEL, not on text.
fn single_line(message: string) -> string {
    val out = mutable_string_new()
    for b in string_to_bytes(message) {
        val c = b as int
        if c == 10 {
            mutable_string_append(out, "\\n")
        } else if c == 13 {
            mutable_string_append(out, "\\r")
        } else if c == 9 {
            mutable_string_append(out, "\\t")
        } else if c < 32 || c == 127 {
            mutable_string_append(out, "\\x", byte_to_hex(b))
        } else {
            mutable_string_append_byte(out, b)
        }
    }
    return snapshot(out)
}

// Moves `<path>.<n>` to `<path>.<n + 1>` for the kept files, oldest first, and `path` to `<path>.1`; the file past the last kept one is deleted. With
// `keep` below 1 the full file is just deleted.
fn shift_files(path: string, keep: int) {
    if keep < 1 {
        val _ = fs.remove(path)
        return
    }
    val _ = fs.remove(format("{}.{}", path, keep))
    var n = keep - 1
    while n >= 1 {
        val from = format("{}.{}", path, n)
        if fs.exists(from) {
            val _ = fs.rename(from, format("{}.{}", path, n + 1))
        }
        n = n - 1
    }
    val _ = fs.rename(path, format("{}.1", path))
}

// Rotates `path` if it has reached `max_bytes`. The size is checked again once the lock is held, since another thread may have rotated it in the meantime.
fn rotate_if_full(path: string, max_bytes: int, keep: int) {
    val size = fs.size(path)
    if !is_ok(size) || unwrap(size) < max_bytes {
        return
    }
    receive(rotation_lock)
    val again = fs.size(path)
    if is_ok(again) && unwrap(again) >= max_bytes {
        shift_files(path, keep)
    }
    send(rotation_lock, 1)
}

// Writes `message` at `level` if the logger's level allows it: a line of the form
// `<timestamp> <LEVEL> <prefix><message>`. Line breaks in `message` are written as `\n` and `\r`, so
// one call is always one line. To stderr, or appended to the logger's file (falling back
// to stderr if the file cannot be written, and also written to stderr when the logger is a `console` one).
// One JSON object, one line, ending in a newline. Field names are the conventional ones a log
// pipeline expects (`time`, `level`, `message`), with `prefix` and `request_id` as their own fields
// rather than glued into the message -- a field is the whole point of a structured line, and a
// reader that wants to filter by component or follow one request can then do it without parsing
// prose. Both are omitted entirely when empty, rather than written as null.
//
// The escaping goes through `json` and not through `single_line`. `single_line` writes a control
// byte as `\xNN`, which is not valid JSON, and a hand-rolled escaper here would reproduce the bug
// A8 fixed: invalid UTF-8 flowing into a document other parsers reject. `json_to_string` on a
// `JString` quotes, escapes, and substitutes U+FFFD for an invalid sequence -- so a log line
// carrying bytes from a user is still a document something else can read.
fn json_line(l: Logger, level: Level, message: string) -> string {
    val out = mutable_string_new()
    mutable_string_append(out, "{")
    if l.timestamps {
        mutable_string_append(out, "\"time\":", json_to_string(Json.JString(now_iso())), ",")
    }
    // `level_name` pads to five characters so the text format's columns line up ("INFO "), and the
    // prefix carries its own trailing space for the same reason -- both are presentation, and both
    // would arrive in a log index as part of the value. Trimmed here, and the level lowercased,
    // which is what every JSON log schema uses.
    mutable_string_append(out, "\"level\":", json_to_string(Json.JString(to_lower(trim(level_name(level))))))
    val component = trim(l.prefix)
    if len(component) > 0 {
        mutable_string_append(out, ",\"prefix\":", json_to_string(Json.JString(component)))
    }
    if len(l.request_id) > 0 {
        mutable_string_append(out, ",\"request_id\":", json_to_string(Json.JString(l.request_id)))
    }
    mutable_string_append(out, ",\"message\":", json_to_string(Json.JString(message)), "}\n")
    return snapshot(out)
}

pub fn write(l: Logger, level: Level, message: string) {
    if !enabled(l, level) {
        return
    }
    if l.json {
        write_line(l, json_line(l, level, message))
        return
    }
    var line = ""
    if l.timestamps {
        line = format("{} ", now_iso())
    }
    line = format("{}{} {}{}\n", line, level_name(level), l.prefix, single_line(message))
    write_line(l, line)
}

// Where a composed line goes: the file if there is one (rotating first if it has grown past
// `max_bytes`), stderr as well when `console` is set, and stderr alone if the append failed or no
// file was configured. Factored out of `write` when the JSON format arrived, so the two formats
// cannot drift apart on rotation, fallback or the console rule.
fn write_line(l: Logger, line: string) {
    switch l.file {
        Some(path) {
            if l.max_bytes > 0 {
                rotate_if_full(path, l.max_bytes, l.keep_files)
            }
            val r = fs.append_text(path, line)
            if !is_ok(r) || l.console {
                os.write_stderr(line)
            }
        }
        None { os.write_stderr(line) }
    }
}

// `write` at each level: detail useful while developing.
pub fn debug(l: Logger, message: string) { write(l, Level.Debug, message) }
// Normal events worth recording.
pub fn info(l: Logger, message: string) { write(l, Level.Info, message) }
// Something unexpected that the program handled.
pub fn warn(l: Logger, message: string) { write(l, Level.Warn, message) }
// A failure the program could not handle.
pub fn error(l: Logger, message: string) { write(l, Level.Error, message) }
