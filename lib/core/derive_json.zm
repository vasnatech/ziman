// `#[derive(Json)]`, written in Ziman: `<name>_to_json`, `<name>_from_json` and the accumulating
// `<name>_from_json_all`.
//
// **The largest of the five and the last ported** -- 418 lines of C against `Row`'s 128 -- and
// the only one that reaches arrays, maps, sets, generics and type variables. Structs and enums
// are both here, so with this module `src/derive.c` no longer generates any JSON at all.
//
// Keys are camelCase (`middle_name` -> `middleName`), which is the one transform here; `Row`'s
// column names are the field names as written, and the difference is deliberate -- JSON is read
// by other systems and a SQL column is not.
#![experimental]
#![generator(Json)]

use meta
use template

// The bundled types whose converters are spelled short, as in `derive_row`: `to_json(d)` and
// `to_localdate(j)` rather than `local_date_to_json`. `Uuid` is absent and keeps `uuid_to_json`.
val flat_names = Map<string, string> {
    "Instant": "instant",
    "LocalDate": "localdate",
    "LocalTime": "localtime",
    "LocalDateTime": "localdatetime",
    "Duration": "duration",
    "ZoneOffset": "zoneoffset",
    "ZoneId": "zoneid"
}

// Everything this generator writes. For `#[derive(Json)] struct P { x: int }`, which is
// tests/lang/cli_emit_derived.zm, the encoder is `p_to_json(v: P) -> Json` building one
// `Json.JObject`; the decoder is the half worth showing, because the error handling is its
// whole shape:
//
//     pub fn p_from_json(j: Json) -> Result<P, string> {
//         if !Json.is_JObject(j) { return err("expected a JSON object for P") }
//         val field_x_raw = try json.require(j, "x")
//         val field_x = switch int_from_json(field_x_raw) {
//             Ok(__derive_ok_0) { __derive_ok_0 }
//             Err(__derive_err_1) { return err(concat("x: ", __derive_err_1)) }
//         }
//         return P {
//             x: field_x
//         }
//     }
//
// `p_from_json_all` follows it, same fields inside one lambda each, collecting into `problems`.
// The full shape of both, over every type this reaches, is tests/lang/derive_json_in_ziman.out.
val sheet = template.must_parse("""
@template to_json
pub fn @{snake}_to_json@{params}(v: @{self}@{converters}) -> Json {
@for f in fields
@yield f.conv
@end
    return Json.JObject(Map<string, Json> {
@for f in fields
        "@{f.key}": field_@{f.name}_json@{f.comma}
@end
    })
}

@end

@template to_one
    val @{dst} = @{call}(@{src})
@end

@template to_seq
    val @{acc} = mutable_array_new<Json>()
    for @{item} in @{src} {
    @yield inner
        push<Json>(@{acc}, @{item_json})
    }
    val @{dst} = Json.JArray(snapshot(@{acc}))
@end

@template to_map
    val @{acc} = mutable_map_new<string, Json>()
    for @{key}, @{entry} in @{src} {
    @yield inner
        set<string, Json>(@{acc}, @{key_expr}, @{entry_json})
    }
    val @{dst} = Json.JObject(snapshot(@{acc}))
@end

@template to_option
    var @{dst} = Json.JNull
    if Option.is_Some(@{src}) {
    @yield inner
        @{dst} = @{inner_var}
    }
@end

@template from_json
pub fn @{snake}_from_json@{params}(j: Json@{converters}) -> Result<@{self}, string> {
    if !Json.is_JObject(j) { return err("expected a JSON object for @{name}") }
@for f in fields
@yield f.read
@end
    return @{self} {
@for f in fields
        @{f.name}: field_@{f.name}@{f.comma}
@end
    }
}

@end

@template from_json_all
pub fn @{snake}_from_json_all@{params}(j: Json@{converters}) -> Result<@{self}, [string]> {
    if !Json.is_JObject(j) { return err(["expected a JSON object for @{name}"]) }
    val problems = mutable_array_new<string>()
@for f in fields
    val get_@{f.name} = fn() -> Result<@{f.type}, string> {
@yield f.read
    return ok(field_@{f.name})
    }
    val got_@{f.name} = get_@{f.name}()
    if Err(problem_@{f.name}) = got_@{f.name} { push(problems, concat("@{f.key}: ", problem_@{f.name})) }
@end
    if len(problems) > 0 { return err(snapshot(problems)) }
    return ok(@{self} {
@for f in fields
        @{f.name}: unwrap(got_@{f.name})@{f.comma}
@end
    })
}

@end

@template from_required_field
    val field_@{name}_raw = try json.require(j, "@{key}")
@yield body
@end

@template from_optional_field
    val field_@{name}_found = json.get(j, "@{key}")
    var field_@{name} = Option<@{elem}>.None
    if Option.is_Some(field_@{name}_found) {
    val field_@{name}_raw = Option.unwrap_Some(field_@{name}_found)
    if !Json.is_JNull(field_@{name}_raw) {
@yield body
    field_@{name} = Option<@{elem}>.Some(field_@{name}_inner)
    }
    }
@end

@template from_check
@if ctx
    if !@{cond} { return err("@{label}: @{msg}") }
@else
    if !@{cond} { return err("@{msg}") }
@end
@end

@template from_try
@if ctx
    val @{dst} = switch @{call} {
        Ok(@{ok_v}) { @{ok_v} }
        Err(@{err_v}) { return err(concat("@{label}: ", @{err_v})) }
    }
@else
    val @{dst} = try @{call}
@end
@end


@template from_unwrap
@yield check
    val @{dst} = Json.unwrap_@{variant}(@{src})
@end

@template from_seq
@yield check
    val @{acc} = mutable_array_new<@{elem}>()
    for @{item} in Json.unwrap_JArray(@{src}) {
    @yield inner
        push<@{elem}>(@{acc}, @{item_val})
    }
    val @{dst} = snapshot(@{acc})
@end

@template from_set
@yield check
    val @{acc} = mutable_set_new<@{elem}>()
    for @{item} in Json.unwrap_JArray(@{src}) {
    @yield inner
        add<@{elem}>(@{acc}, @{item_val})
    }
    val @{dst} = snapshot(@{acc})
@end

@template from_map
@yield check
    val @{acc} = mutable_map_new<@{kt}, @{vt}>()
    for @{key}, @{raw} in Json.unwrap_JObject(@{src}) {
    @yield inner
@if key_kind == 'int'
        val @{key_n} = try parse_int(@{key})
        set<@{kt}, @{vt}>(@{acc}, @{key_n}, @{entry})
@else
        set<@{kt}, @{vt}>(@{acc}, @{key}, @{entry})
@end
    }
    val @{dst} = snapshot(@{acc})
@end

@template from_option
    var @{dst} = Option<@{elem}>.None
    if !Json.is_JNull(@{src}) {
    @yield inner
        @{dst} = Option<@{elem}>.Some(@{inner_var})
    }
@end

@template enum_to_json
pub fn @{snake}_to_json@{params}(v: @{self}@{converters}) -> Json {
@for v in variants
@yield v.block
@end
@if closed
    }
@end
}

@end

@template enum_to_variant
@if opener == 'first'
    if @{enum}.is_@{variant}(v) {
@elif opener == 'middle'
    } else if @{enum}.is_@{variant}(v) {
@elif opener == 'last'
    } else {
@end
@if payload
    @yield conv
        return Json.JObject(Map<string, Json> {
            "type": Json.JString("@{variant}"),
            "value": @{dst}
        })
@else
        return Json.JObject(Map<string, Json> { "type": Json.JString("@{variant}") })
@end
@end

@template enum_from_json
pub fn @{snake}_from_json@{params}(j: Json@{converters}) -> Result<@{self}, string> {
    if !Json.is_JObject(j) { return err("expected a JSON object for @{name}") }
    val __derive_tag = try json.require_string(j, "type")
@for v in variants
@yield v.block
@end
    } else {
        return err(concat("unknown variant tag for @{name}: ", __derive_tag))
    }
}

@end

@template enum_from_variant
@if first
    if __derive_tag == "@{variant}" {
@else
    } else if __derive_tag == "@{variant}" {
@end
@if payload
        val __derive_payload_raw = try json.require(j, "value")
    @yield conv
        return @{self}.@{variant}(@{dst})
@else
        return @{self}.@{variant}
@end
@end
""")

// The converter a scalar goes out through, or None for a type that is not one. `bool` and
// `string` name a `Json` variant rather than a function, which is why this answers a call
// expression rather than a function name.
fn is_scalar_call(t: meta.Type) -> Option<string> {
    switch t {
        Int { return Option<string>.Some("int_to_json") }
        Float { return Option<string>.Some("float_to_json") }
        Bigint { return Option<string>.Some("bigint_to_json") }
        Decimal { return Option<string>.Some("decimal_to_json") }
        Bool { return Option<string>.Some("Json.JBool") }
        String { return Option<string>.Some("Json.JString") }
        Byte { return Option<string>.None }
        Unit { return Option<string>.None }
        Void { return Option<string>.None }
        Array(_) { return Option<string>.None }
        SetOf(_) { return Option<string>.None }
        ChannelOf(_) { return Option<string>.None }
        MapOf(_) { return Option<string>.None }
        ResultOf(_) { return Option<string>.None }
        Func(_) { return Option<string>.None }
        Optional(_) { return Option<string>.None }
        Named(_) { return Option<string>.None }
        Var(_) { return Option<string>.None }
    }
}

// `t_to_json` -- the converter parameter a generic declaration threads through for type `T`.
fn converter_param(type_param: string, is_to: bool) -> string {
    return concat(meta.snake_case(type_param), if is_to { "_to_json" } else { "_from_json" })
}

fn one(dst: string, call: string, src: string) -> Result<string, string> {
    return template.render(sheet, "to_one", [
        template.text("dst", dst),
        template.text("call", call),
        template.text("src", src)
    ])
}

fn without_newline(text: string) -> string {
    return substring(text, 0, prelude.len(text) - 1)
}

// A `Map` key becomes a JSON object key, so only a string or an int can be one.
fn check_map_key(t: meta.Type) -> Result<unit, string> {
    if String = t {
        return unit
    }
    if Int = t {
        return unit
    }
    return err(concat(
        "derive(Json) supports Map keys of type string or int (they become JSON object keys), found '",
        meta.type_text(t),
        "'"
    ))
}

// The converter a generic type argument is given: a type variable passes the parameter it was
// given, a scalar names its own function, a plain struct or enum names `<snake>_to_json`.
fn converter_for(arg: meta.Type, is_to: bool) -> Result<string, string> {
    val dir = if is_to { "to" } else { "from" }
    if Var(name) = arg {
        return ok(converter_param(name, is_to))
    }
    if Named(named) = arg {
        if prelude.len(named.args) == 0 {
            return ok(concat(meta.snake_case(named.name), "_", dir, "_json"))
        }
    }
    val scalar = scalar_name(arg)
    if scalar != "" {
        return ok(concat(scalar, "_", dir, "_json"))
    }
    return err(concat(
        "derive(Json) cannot build a converter for type argument '",
        meta.type_text(arg),
        "' -- use a scalar, a type parameter or a plain struct/enum there"
    ))
}

// The six scalars that have a `<name>_to_json`/`<name>_from_json` pair, or "" for anything else.
fn scalar_name(t: meta.Type) -> string {
    switch t {
        Int { return "int" }
        Float { return "float" }
        Bigint { return "bigint" }
        Decimal { return "decimal" }
        Bool { return "bool" }
        String { return "string" }
        Byte { return "" }
        Unit { return "" }
        Void { return "" }
        Array(_) { return "" }
        SetOf(_) { return "" }
        ChannelOf(_) { return "" }
        MapOf(_) { return "" }
        ResultOf(_) { return "" }
        Func(_) { return "" }
        Optional(_) { return "" }
        Named(_) { return "" }
        Var(_) { return "" }
    }
}

fn type_args_text(args: [meta.Type]) -> string {
    val out = mutable_array_new<string>()
    for a in args {
        push(out, meta.type_text(a))
    }
    return concat("<", join(separator: ", ", pieces: snapshot(out)), ">")
}

// A value to `Json`, recursively. The shapes are the sheet's; the recursion, the temporary
// names and the per-kind choice are here.
fn emit_to_json(t: meta.Type, src: string, dst: string, n: Mutable<int>) -> Result<string, string> {
    if Some(call) = is_scalar_call(t) {
        return one(dst, call, src)
    }
    if Var(name) = t {
        return one(dst, converter_param(name, true), src)
    }
    // An array and a set emit the same loop; only the thing being iterated differs, and that is
    // `@{src}`. One branch for both, where the decoder needs two because its accumulators are
    // built differently.
    var seq_elem = Option<meta.Type>.None
    if Array(e) = t {
        seq_elem = Option<meta.Type>.Some(e)
    }
    if SetOf(e) = t {
        seq_elem = Option<meta.Type>.Some(e)
    }
    if Some(elem) = seq_elem {
        val item = meta.fresh(n, "item")
        val item_json = meta.fresh(n, "item_json")
        val acc = meta.fresh(n, "ab")
        return template.render(sheet, "to_seq", [
            template.text("acc", acc),
            template.text("item", item),
            template.text("src", src),
            template.text("inner", without_newline(try emit_to_json(elem, item, item_json, n))),
            template.text("item_json", item_json),
            template.text("dst", dst)
        ])
    }
    if MapOf(m) = t {
        try check_map_key(m.key)
        val key = meta.fresh(n, "key")
        val entry = meta.fresh(n, "entry")
        val entry_json = meta.fresh(n, "entry_json")
        val acc = meta.fresh(n, "fields")
        var key_expr = key
        if Int = m.key {
            key_expr = concat("str(", key, ")")
        }
        return template.render(sheet, "to_map", [
            template.text("acc", acc),
            template.text("key", key),
            template.text("entry", entry),
            template.text("src", src),
            template.text("inner", without_newline(try emit_to_json(m.value, entry, entry_json, n))),
            template.text("key_expr", key_expr),
            template.text("entry_json", entry_json),
            template.text("dst", dst)
        ])
    }
    if Optional(elem) = t {
        val inner_var = meta.fresh(n, "opt_inner")
        return template.render(sheet, "to_option", [
            template.text("dst", dst),
            template.text("src", src),
            template.text("inner", without_newline(
                try emit_to_json(elem, concat("Option.unwrap_Some(", src, ")"), inner_var, n)
            )),
            template.text("inner_var", inner_var)
        ])
    }
    if Named(named) = t {
        if prelude.len(named.args) > 0 {
            val convs = mutable_array_new<string>()
            for a in named.args {
                push(convs, try converter_for(a, true))
            }
            return one(
                dst,
                concat(meta.snake_case(named.name), "_to_json", type_args_text(named.args)),
                concat(src, ", ", join(separator: ", ", pieces: snapshot(convs)))
            )
        }
        if contains(flat_names, meta.bare_name(named.name)) {
            return one(dst, "to_json", src)
        }
        return one(dst, concat(meta.snake_case(named.name), "_to_json"), src)
    }
    return err(concat("derive(Json) does not support field type '", meta.type_text(t), "' yet"))
}

// `<T, U>` for a generic declaration, and the converter parameters its functions take.
fn decl_params(d: meta.Decl) -> string {
    if prelude.len(d.type_params) == 0 {
        return ""
    }
    return concat("<", join(separator: ", ", pieces: d.type_params), ">")
}

fn converter_params(d: meta.Decl, is_to: bool) -> string {
    val out = mutable_array_new<string>()
    for p in d.type_params {
        if is_to {
            push(out, concat(", ", converter_param(p, true), ": fn(", p, ") -> Json"))
        } else {
            push(out, concat(", ", converter_param(p, false), ": fn(Json) -> Result<", p, ", string>"))
        }
    }
    return concat(pieces: snapshot(out))
}

fn self_text(d: meta.Decl) -> string {
    if prelude.len(d.type_params) == 0 {
        return d.name
    }
    return concat(d.name, "<", join(separator: ", ", pieces: d.type_params), ">")
}

// ---- the decoder ------------------------------------------------------------------------
//
// `from_json` is the mirror of `to_json` and has two things its counterpart does not. **A
// decode can fail**, so every conversion either tests the JSON shape first or catches an `Err`
// and prefixes it with the field's key -- `ctx` threaded through below, `Option<string>.None`
// where the key is already named by the caller. And **an absent key is not an error for an
// `Option` field**: a missing key and an explicit `null` both decode to `None`, which is the
// hand-written tolerance the backend's `request.zm` had before this mechanism existed.

// `int_from_json` and the three other scalars that answer a `Result`; `bool` and `string` are
// tested and unwrapped instead, so they are not here.
fn from_reader(t: meta.Type) -> Option<string> {
    switch t {
        Int { return Option<string>.Some("int_from_json") }
        Float { return Option<string>.Some("float_from_json") }
        Bigint { return Option<string>.Some("bigint_from_json") }
        Decimal { return Option<string>.Some("decimal_from_json") }
        Bool { return Option<string>.None }
        String { return Option<string>.None }
        Byte { return Option<string>.None }
        Unit { return Option<string>.None }
        Void { return Option<string>.None }
        Array(_) { return Option<string>.None }
        SetOf(_) { return Option<string>.None }
        ChannelOf(_) { return Option<string>.None }
        MapOf(_) { return Option<string>.None }
        ResultOf(_) { return Option<string>.None }
        Func(_) { return Option<string>.None }
        Optional(_) { return Option<string>.None }
        Named(_) { return Option<string>.None }
        Var(_) { return Option<string>.None }
    }
}

// A shape test whose failure message is known here. Consumes no temporary.
fn from_check(cond: string, ctx: Option<string>, msg: string) -> Result<string, string> {
    if Some(label) = ctx {
        return template.render(sheet, "from_check", [
            template.flag("ctx", true),
            template.text("cond", cond),
            template.text("label", label),
            template.text("msg", msg)
        ])
    }
    return template.render(sheet, "from_check", [
        template.flag("ctx", false),
        template.text("cond", cond),
        template.text("msg", msg)
    ])
}

// A call whose failure message is only known at run time. Without a key to name it is a bare
// `try`; with one the `Err` is caught and prefixed, which costs two temporaries.
fn from_try(dst: string, call: string, ctx: Option<string>, n: Mutable<int>) -> Result<string, string> {
    if Some(label) = ctx {
        val ok_v = meta.fresh(n, "ok")
        val err_v = meta.fresh(n, "err")
        return template.render(sheet, "from_try", [
            template.flag("ctx", true),
            template.text("dst", dst),
            template.text("call", call),
            template.text("ok_v", ok_v),
            template.text("err_v", err_v),
            template.text("label", label)
        ])
    }
    return template.render(sheet, "from_try", [
        template.flag("ctx", false),
        template.text("dst", dst),
        template.text("call", call)
    ])
}

// `Json` to a value, recursively. **The temporary numbering is part of the contract** --
// `tests/lang/derive_json_in_ziman` pins this text byte for byte -- and it is simply the order
// the `fresh` calls below appear in. (That fixture used to be checked against what
// `src/derive.c` emitted; the C generator is gone, so the pin is now against the text itself.)
fn emit_from_json(
    t: meta.Type,
    src: string,
    dst: string,
    ctx: Option<string>,
    n: Mutable<int>
) -> Result<string, string> {
    if Some(call) = from_reader(t) {
        return from_try(dst, concat(call, "(", src, ")"), ctx, n)
    }
    var unwrapped = Option<string>.None
    if Bool = t {
        unwrapped = Option<string>.Some("JBool")
    }
    if String = t {
        unwrapped = Option<string>.Some("JString")
    }
    if Some(variant) = unwrapped {
        val msg = if variant == "JBool" { "expected a boolean" } else { "expected a string" }
        return template.render(sheet, "from_unwrap", [
            template.text("check", without_newline(
                try from_check(concat("Json.is_", variant, "(", src, ")"), ctx, msg)
            )),
            template.text("dst", dst),
            template.text("variant", variant),
            template.text("src", src)
        ])
    }
    if Var(name) = t {
        return from_try(dst, concat(converter_param(name, false), "(", src, ")"), ctx, n)
    }
    // An array and a set differ only in which name the accumulator takes and in `push` vs `add`
    // -- but they take their temporaries in a **different order**, which is the C's doing and
    // the reason these are two branches rather than one with a flag in it.
    if Array(elem) = t {
        val acc = meta.fresh(n, "ab")
        val item = meta.fresh(n, "item")
        val item_val = meta.fresh(n, "item_val")
        return template.render(sheet, "from_seq", [
            template.text("check", without_newline(
                try from_check(concat("Json.is_JArray(", src, ")"), ctx, "expected an array")
            )),
            template.text("acc", acc),
            template.text("elem", meta.type_text(elem)),
            template.text("item", item),
            template.text("src", src),
            template.text("inner", without_newline(
                try emit_from_json(elem, item, item_val, Option<string>.None, n)
            )),
            template.text("item_val", item_val),
            template.text("dst", dst)
        ])
    }
    if SetOf(elem) = t {
        val item = meta.fresh(n, "item")
        val item_val = meta.fresh(n, "item_val")
        val acc = meta.fresh(n, "builder")
        return template.render(sheet, "from_set", [
            template.text("check", without_newline(
                try from_check(concat("Json.is_JArray(", src, ")"), ctx, "expected an array")
            )),
            template.text("acc", acc),
            template.text("elem", meta.type_text(elem)),
            template.text("item", item),
            template.text("src", src),
            template.text("inner", without_newline(
                try emit_from_json(elem, item, item_val, Option<string>.None, n)
            )),
            template.text("item_val", item_val),
            template.text("dst", dst)
        ])
    }
    if MapOf(m) = t {
        try check_map_key(m.key)
        val key = meta.fresh(n, "key")
        val raw = meta.fresh(n, "raw")
        val entry = meta.fresh(n, "entry")
        val key_n = meta.fresh(n, "key_n")
        val acc = meta.fresh(n, "builder")
        var key_kind = "text"
        if Int = m.key {
            key_kind = "int"
        }
        return template.render(sheet, "from_map", [
            template.text("check", without_newline(
                try from_check(concat("Json.is_JObject(", src, ")"), ctx, "expected an object")
            )),
            template.text("acc", acc),
            template.text("kt", meta.type_text(m.key)),
            template.text("vt", meta.type_text(m.value)),
            template.text("key", key),
            template.text("raw", raw),
            template.text("src", src),
            template.text("inner", without_newline(
                try emit_from_json(m.value, raw, entry, Option<string>.None, n)
            )),
            template.text("key_kind", key_kind),
            template.text("key_n", key_n),
            template.text("entry", entry),
            template.text("dst", dst)
        ])
    }
    if Optional(elem) = t {
        val inner_var = meta.fresh(n, "opt_inner")
        return template.render(sheet, "from_option", [
            template.text("dst", dst),
            template.text("elem", meta.type_text(elem)),
            template.text("src", src),
            template.text("inner", without_newline(
                try emit_from_json(elem, src, inner_var, Option<string>.None, n)
            )),
            template.text("inner_var", inner_var)
        ])
    }
    if Named(named) = t {
        if prelude.len(named.args) > 0 {
            val convs = mutable_array_new<string>()
            for a in named.args {
                push(convs, try converter_for(a, false))
            }
            return from_try(dst, concat(
                meta.snake_case(named.name),
                "_from_json",
                type_args_text(named.args),
                "(",
                src,
                ", ",
                join(separator: ", ", pieces: snapshot(convs)),
                ")"
            ), ctx, n)
        }
        if contains(flat_names, meta.bare_name(named.name)) {
            return from_try(
                dst,
                concat("to_", unwrap(get(flat_names, meta.bare_name(named.name))), "(", src, ")"),
                ctx,
                n
            )
        }
        return from_try(dst, concat(meta.snake_case(named.name), "_from_json(", src, ")"), ctx, n)
    }
    return err(concat("derive(Json) does not support field type '", meta.type_text(t), "' yet"))
}

// One field's decode block. **Shared by both decoders** -- the single-error one names the key in
// every message, the accumulating one leaves `ctx` empty because it prefixes the key once
// itself, and that is the whole difference between them.
fn field_read(m: meta.Field, key: string, ctx: Option<string>, n: Mutable<int>) -> Result<string, string> {
    val dst = concat("field_", m.name)
    if Optional(elem) = m.type {
        return template.render(sheet, "from_optional_field", [
            template.text("name", m.name),
            template.text("key", key),
            template.text("elem", meta.type_text(elem)),
            template.text("body", without_newline(
                try emit_from_json(elem, concat(dst, "_raw"), concat(dst, "_inner"), ctx, n)
            ))
        ])
    }
    return template.render(sheet, "from_required_field", [
        template.text("name", m.name),
        template.text("key", key),
        template.text("body", without_newline(
            try emit_from_json(m.type, concat(dst, "_raw"), dst, ctx, n)
        ))
    ])
}

// `<name>_from_json`: stops at the first bad field.
pub fn from_json(d: meta.Decl, members: [meta.Field]) -> Result<string, string> {
    val n = mutable_new<int>(0)
    val fields = mutable_array_new<template.Row>()
    val last = prelude.len(members) - 1
    for i in 0..prelude.len(members) {
        val m = members[i]
        val key = meta.camel_case(m.name)
        push(fields, template.row([
            template.text("name", m.name),
            template.text("read", without_newline(try field_read(m, key, Option<string>.Some(key), n))),
            template.text("comma", if i < last { "," } else { "" })
        ]))
    }
    return template.render(sheet, "from_json", [
        template.text("snake", d.snake_name),
        template.text("params", decl_params(d)),
        template.text("self", self_text(d)),
        template.text("name", d.name),
        template.text("converters", converter_params(d, false)),
        template.rows("fields", snapshot(fields))
    ])
}

// `<name>_from_json_all`: reports every bad field, as `Result<T, [string]>`.
//
// Each field decodes inside a **lambda**, which is what makes this cheap to generate: the
// emitters above end a failing field with `return err(..)`, and inside a lambda that returns
// from the lambda -- so `field_read` is reused exactly, with no second recording mode to keep in
// step with it. The cost is one closure per field, paid only by callers of this function.
pub fn from_json_all(d: meta.Decl, members: [meta.Field]) -> Result<string, string> {
    val n = mutable_new<int>(0)
    val fields = mutable_array_new<template.Row>()
    val last = prelude.len(members) - 1
    for i in 0..prelude.len(members) {
        val m = members[i]
        push(fields, template.row([
            template.text("name", m.name),
            template.text("key", meta.camel_case(m.name)),
            template.text("type", meta.type_text(m.type)),
            template.text("read", without_newline(
                try field_read(m, meta.camel_case(m.name), Option<string>.None, n)
            )),
            template.text("comma", if i < last { "," } else { "" })
        ]))
    }
    return template.render(sheet, "from_json_all", [
        template.text("snake", d.snake_name),
        template.text("params", decl_params(d)),
        template.text("self", self_text(d)),
        template.text("name", d.name),
        template.text("converters", converter_params(d, false)),
        template.rows("fields", snapshot(fields))
    ])
}

// ---- the enum halves --------------------------------------------------------------------
//
// An enum is **externally tagged**: `{"type": "Pending"}` for a unit variant and
// `{"type": "Shipped", "value": ..}` for one with a payload. `Option<T>` never reaches here --
// a field's `Option` is intercepted by `emit_to_json`/`emit_from_json` before an enum is ever
// considered, so this runs only for an enum a user wrote `#[derive(Json)]` on.

// Which `if`/`} else if`/`} else` a variant opens with. A one-variant enum opens with nothing:
// there is no other variant it could be.
fn opener_shape(i: int, last: int) -> string {
    if last == 0 {
        return "only"
    }
    if i == 0 {
        return "first"
    }
    if i < last {
        return "middle"
    }
    return "last"
}

// `<name>_to_json` for an enum: a chain of variant tests, each returning its own object.
//
// The encoder tests variants and the decoder compares tags, so only the encoder has a shape for
// "the last one" -- the decoder always needs its `else` for a tag that matches nothing.
pub fn enum_to_json(d: meta.Decl, variants: [meta.Variant]) -> Result<string, string> {
    val n = mutable_new<int>(0)
    val rows = mutable_array_new<template.Row>()
    val last = prelude.len(variants) - 1
    for i in 0..prelude.len(variants) {
        val m = variants[i]
        val dst = concat("payload_json_", str(i))
        var conv = ""
        var carries = false
        if Some(payload) = m.payload {
            carries = true
            conv = without_newline(
                try emit_to_json(payload, concat(d.name, ".unwrap_", m.name, "(v)"), dst, n)
            )
        }
        push(rows, template.row([
            template.text("block", without_newline(try template.render(sheet, "enum_to_variant", [
                template.text("opener", opener_shape(i, last)),
                template.text("enum", d.name),
                template.text("variant", m.name),
                template.flag("payload", carries),
                template.text("conv", conv),
                template.text("dst", dst)
            ])))
        ]))
    }
    return template.render(sheet, "enum_to_json", [
        template.text("snake", d.snake_name),
        template.text("params", decl_params(d)),
        template.text("self", self_text(d)),
        template.text("converters", converter_params(d, true)),
        template.flag("closed", last > 0),
        template.rows("variants", snapshot(rows))
    ])
}

// `<name>_from_json` for an enum: read the tag, then build the variant it names.
pub fn enum_from_json(d: meta.Decl, variants: [meta.Variant]) -> Result<string, string> {
    val n = mutable_new<int>(0)
    val rows = mutable_array_new<template.Row>()
    for i in 0..prelude.len(variants) {
        val m = variants[i]
        val dst = concat("payload_", str(i))
        var conv = ""
        var carries = false
        if Some(payload) = m.payload {
            carries = true
            conv = without_newline(
                try emit_from_json(payload, "__derive_payload_raw", dst, Option<string>.None, n)
            )
        }
        push(rows, template.row([
            template.text("block", without_newline(try template.render(sheet, "enum_from_variant", [
                template.flag("first", i == 0),
                template.text("self", self_text(d)),
                template.text("variant", m.name),
                template.flag("payload", carries),
                template.text("conv", conv),
                template.text("dst", dst)
            ])))
        ]))
    }
    return template.render(sheet, "enum_from_json", [
        template.text("snake", d.snake_name),
        template.text("params", decl_params(d)),
        template.text("self", self_text(d)),
        template.text("name", d.name),
        template.text("converters", converter_params(d, false)),
        template.rows("variants", snapshot(rows))
    ])
}

// Three functions for a struct, two for an enum -- the order `src/derive.c` spliced them in.
pub fn generate(d: meta.Decl) -> Result<string, string> {
    switch d.body {
        Struct(fields) {
            return ok(concat(
                try to_json(d, fields),
                try from_json(d, fields),
                try from_json_all(d, fields)
            ))
        }
        Enum(variants) {
            return ok(concat(try enum_to_json(d, variants), try enum_from_json(d, variants)))
        }
    }
}

// `<name>_to_json` for a struct. The five pieces are exported individually as well as through
// `generate`, so `tests/lang/derive_json_in_ziman` can hold each to the bytes the C emitted.
pub fn to_json(d: meta.Decl, members: [meta.Field]) -> Result<string, string> {
    val n = mutable_new<int>(0)
    val fields = mutable_array_new<template.Row>()
    val last = prelude.len(members) - 1
    for i in 0..prelude.len(members) {
        val m = members[i]
        push(fields, template.row([
            template.text("name", m.name),
            template.text("key", meta.camel_case(m.name)),
            template.text("conv", without_newline(
                try emit_to_json(m.type, concat("v.", m.name), concat("field_", m.name, "_json"), n)
            )),
            template.text("comma", if i < last { "," } else { "" })
        ]))
    }
    return template.render(sheet, "to_json", [
        template.text("snake", d.snake_name),
        template.text("params", decl_params(d)),
        template.text("self", self_text(d)),
        template.text("converters", converter_params(d, true)),
        template.rows("fields", snapshot(fields))
    ])
}
