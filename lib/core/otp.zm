// otp.zm -- time-based one-time passwords (RFC 6238, over RFC 4226's HOTP) of the kind authenticator apps show: six digits that
// change every 30 seconds, from a secret shared once, by QR code or by typing it. Pure Ziman on top of `crypto` and `random`.
//
//     val secret = otp.generate_secret()                       // "JBSWY3DPEHPK3PXP..." to show the user, base32
//     val uri = otp.provisioning_uri("My App", "ada@example.com", secret)   // otpauth://totp/... for a QR code
//     val key = try otp.base32_decode(secret)                     // the bytes a code is computed from
//     otp.totp_valid(key, typed_code, now_seconds, 1)          // true for this 30-second step and one either side
//
// Only the parameters every authenticator app supports: HMAC-SHA-1, six digits, a 30-second step.

use crypto
use locale
use random

// Case folding here is **protocol folding**, so it names the invariant locale rather than taking
// whatever a program set as its default: Turkish folds `I` to `ı`, and a header name, a hex digit, a
// media type or an identifier compared under a user's language is a bug. Hoisted to a `val` because
// some of these sit in per-character loops and `locale.root()` is a call.
val invariant: Locale = locale.root()

// The secret of 20 random bytes (the size RFC 4226 recommends) as base32 text, 32 characters, the way it is shown to a user and stored.
pub fn generate_secret() -> string {
    return base32_encode(random.random_bytes(20))
}

val base32_alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

// `data` as base32 (RFC 4648) without `=` padding.
pub fn base32_encode(data: [byte]) -> string {
    val out = mutable_string_new()
    var buffer = 0
    var bits = 0
    for b in data {
        buffer = buffer * 256 + (b as int)
        bits = bits + 8
        while bits >= 5 {
            var divisor = 1
            for _ in 0..(bits - 5) {
                divisor = divisor * 2
            }
            val index = buffer / divisor
            append(out, char_at(base32_alphabet, index))
            buffer = buffer - index * divisor
            bits = bits - 5
        }
    }
    if bits > 0 {
        var shift = 1
        for _ in 0..(5 - bits) {
            shift = shift * 2
        }
        append(out, char_at(base32_alphabet, buffer * shift))
    }
    return snapshot(out)
}

// base32 text as bytes: upper or lower case, with or without `=` padding, spaces and dashes ignored (as people write a secret down). An Err
// for any other character.
pub fn base32_decode(text: string) -> Result<[byte], string> {
    val out = mutable_array_new<byte>()
    var buffer = 0
    var bits = 0
    for i in 0..len(text) {
        val c = to_upper(char_at(text, i), invariant)
        if c == "=" || c == " " || c == "-" {
            continue
        }
        val index = index_of(base32_alphabet, c, 0)
        if index < 0 {
            return err(format("not base32: '{}' at {}", c, i))
        }
        buffer = buffer * 32 + index
        bits = bits + 5
        if bits >= 8 {
            var divisor = 1
            for _ in 0..(bits - 8) {
                divisor = divisor * 2
            }
            val value = buffer / divisor
            push(out, value as byte)
            buffer = buffer - value * divisor
            bits = bits - 8
        }
    }
    return snapshot(out)
}

// The counter as the 8 big-endian bytes HOTP signs.
fn counter_bytes(counter: int) -> [byte] {
    val out = mutable_array_new<byte>()
    var digits: [int] = []
    var rest = counter
    for _ in 0..8 {
        digits = push(digits, rest % 256)
        rest = rest / 256
    }
    for i in 0..8 {
        push(out, digits[7 - i] as byte)
    }
    return snapshot(out)
}

// The HOTP value (RFC 4226) for `counter`, `digits` long with leading zeros: HMAC-SHA-1, then the
// "dynamic truncation".
//
// **`digits` must be 6 to 9, and that is now enforced** rather than only documented. Dynamic
// truncation yields a 31-bit number, at most 2147483647, so nine digits is the most that can carry
// real entropy: a tenth could only ever be 0, 1 or 2, which makes `digits: 10` a code that looks
// stronger than it is. Below six is weaker than the RFC allows at all, `0` and a negative both used
// to answer the single character `"0"`, and `20` reached an integer overflow inside the modulus
// loop and reported *that* -- a message about `*` on line 110, naming nothing the caller wrote.
pub fn hotp(key: [byte], counter: int, digits: int) -> string {
    if digits < 6 || digits > 9 {
        val bad: Result<unit, string> = err(prelude.format(
            "hotp: digits must be 6 to 9, found {} (dynamic truncation yields a 31-bit number, so a tenth digit could only ever be 0, 1 or 2)",
            digits
        ))
        val _ = unwrap(bad)
    }
    val mac = crypto.hmac_sha1(key, counter_bytes(counter))
    val offset = (mac[19] as int) % 16
    val number = ((mac[offset] as int) % 128) * 16777216 + (mac[offset + 1] as int) * 65536 + (mac[offset + 2] as int) * 256 + (mac[offset + 3] as int)
    var modulus = 1
    for _ in 0..digits {
        modulus = modulus * 10
    }
    val text = str(number % modulus)
    val padding = mutable_string_new()
    for _ in 0..(digits - len(text)) {
        append(padding, "0")
    }
    append(padding, text)
    return snapshot(padding)
}

// The six-digit code an authenticator app shows at `unix_seconds` (30-second steps from the epoch).
pub fn totp(key: [byte], unix_seconds: int) -> string {
    return totp(key, unix_seconds, 6)
}

// **The same with `digits` chosen**, 6 to 9. RFC 6238 allows more than six and its own test vectors
// are eight, which this could not produce until 2026-10-24: `hotp(key, unix_seconds / 30, 8)` did
// it by hand, but the *verifiers* below went through the six-digit `totp`, so an eight-digit code
// could be generated and then not checked. All three take `digits` now.
pub fn totp(key: [byte], unix_seconds: int, digits: int) -> string {
    return hotp(key, unix_seconds / 30, digits)
}

// The 30-second step number `code` matches, at `unix_seconds` or within `window` steps of it either way (1
// allows for a clock a few seconds off), or `None` when it matches none: what a caller needs to reject a
// replay of a step already spent (store the step a login accepted; refuse a future call that matches the
// same one). The comparison takes the same time whatever the code, and every step in the window is checked
// even after a match, so the time taken does not say which step (or whether one) matched.
pub fn totp_matching_step(key: [byte], code: string, unix_seconds: int, window: int) -> Option<int> {
    return totp_matching_step(key, code, unix_seconds, window, 6)
}

// The same for a code of `digits` digits.
pub fn totp_matching_step(
    key: [byte],
    code: string,
    unix_seconds: int,
    window: int,
    digits: int
) -> Option<int> {
    var found: Option<int> = None
    val typed = to_bytes(trim(code))
    for step in (0 - window)..(window + 1) {
        val at = unix_seconds + step * 30
        val expected = to_bytes(totp(key, at, digits))
        if len(expected) == len(typed) && crypto.bytes_equal(expected, typed) {
            found = Option<int>.Some(at / 30)
        }
    }
    return found
}

// Whether `code` is the code at `unix_seconds` or within `window` 30-second steps of it either way (1 allows for a clock a few seconds
// off). The comparison takes the same time whatever the code.
pub fn totp_valid(key: [byte], code: string, unix_seconds: int, window: int) -> bool {
    return is_Some(totp_matching_step(key, code, unix_seconds, window, 6))
}

// The same for a code of `digits` digits.
pub fn totp_valid(key: [byte], code: string, unix_seconds: int, window: int, digits: int) -> bool {
    return is_Some(totp_matching_step(key, code, unix_seconds, window, digits))
}

// `text` percent-encoded for a URI component: letters, digits and `-_.~` stay, every other byte becomes `%XX`.
fn uri_encode(text: string) -> string {
    val out = mutable_string_new()
    val hex = "0123456789ABCDEF"
    for b in to_bytes(text) {
        val v = b as int
        if (v >= 48 && v <= 57) || (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || v == 45 || v == 95 || v == 46 || v == 126 {
            append_byte(out, b)
        } else {
            append(out, "%", char_at(hex, v / 16), char_at(hex, v % 16))
        }
    }
    return snapshot(out)
}

// The `otpauth://` address an authenticator app takes as a QR code to add the account: `issuer` (the name of your service) and
// `account` (the user's email) label it, `secret` is the base32 secret.
pub fn provisioning_uri(issuer: string, account: string, secret: string) -> string {
    return format(
        "otpauth://totp/{}:{}?secret={}&issuer={}&algorithm=SHA1&digits=6&period=30",
        uri_encode(issuer),
        uri_encode(account),
        secret,
        uri_encode(issuer)
    )
}
