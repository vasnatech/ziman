// csv.zm -- CSV (RFC 4180) as `Json`: a table is a `Json` array of objects, one per data row and
// keyed by the header row, so any `#[derive(Json)]` type decodes from a row with its own
// `_from_json` and encodes back. Splitting the text into cells is a native scanner
// (`scan_cells`); the rest is Ziman.
//
// Every function that takes text and returns a table comes in two forms: the plain one uses
// the comma, and the `_with` form takes a one-character delimiter (`"\t"` for TSV). They are
// separate functions because Ziman can only omit an optional parameter in a call that names
// its arguments. A delimiter that is not exactly one character, or is a quote or a newline,
// is an `Err`.
//
// Cells are text. A reader returns them as strings (`parse_csv`), or infers a type for the
// cells that look like one (`parse_csv_typed`); see each function. The writer quotes exactly
// the strings that would otherwise read back as something else, so `parse_csv_typed` of what
// `csv_to_string` wrote gives the same table.

use fs
use json.Json
use json.Number
use json.float_to_json
use json.int_to_json
use number.float_to_text

// One cell as the scanner saw it, and one row with the line it started on (a quoted cell can
// contain newlines, so a row's line is not its index).
struct Cell {
    text: string
    tag: string
}

struct Row {
    line: int
    cells: [Cell]
}

// The UTF-8 byte order mark that spreadsheets put at the start of a file.
val byte_order_mark = unwrap(bytes_to_string([239b, 187b, 191b]))

// Splits `text` into cells. The result is a flat array: each cell is a one-character tag
// followed by its text, and each row is ended by a string starting with the control character
// U+0001 followed by the row's line number. The tag is `q` for a quoted cell and `u` for an
// unquoted one; with `typed`, an unquoted cell that looks like something else is tagged `n`
// (empty), `t` or `x` (true or false), `i` (an integer) or `d` (a float). Blank lines produce
// nothing. An Err names the line of a stray quote, of text after a closing quote, or of an
// unterminated quote (and where that quote opened).
native fn scan_cells(text: string, sep: string, typed: bool) -> Result<[string], string>

// ---------------------------------------------------------------- reading

fn check_delimiter(sep: string) -> Result<string, string> {
    if len(sep) != 1 || sep == "\"" || sep == "\n" || sep == "\r" {
        return err(format("invalid delimiter '{}': it must be one character and not a quote or a newline", sep))
    }
    return ok(sep)
}

// The table as rows of cells, from the scanner's flat form.
fn parse_rows(text: string, sep: string, typed: bool) -> Result<[Row], string> {
    try check_delimiter(sep)
    val body = if starts_with(text, byte_order_mark) { substring(text, len(byte_order_mark), len(text)) } else { text }
    val flat = try scan_cells(body, sep, typed)
    val rows = ab_new<Row>()
    var cells = ab_new<Cell>()
    for item in flat {
        if compare(char_at(item, 0), " ") < 0 {
            val line = unwrap(parse_int(substring(item, 1, len(item))))
            ab_append(rows, Row { line: line, cells: ab_to_array(cells) })
            cells = ab_new<Cell>()
        } else {
            ab_append(cells, Cell { text: substring(item, 1, len(item)), tag: substring(item, 0, 1) })
        }
    }
    return ok(ab_to_array(rows))
}

fn is_digit_char(c: string) -> bool {
    return len(c) == 1 && index_of("0123456789", c, 0) >= 0
}

// `42`, `-7`, `0`; not `007`, `+1`, `1_000`, `-`.
fn looks_int(s: string) -> bool {
    var i = 0
    if is_char_at(s, 0, "-") {
        i = 1
    }
    if i >= len(s) {
        return false
    }
    if char_at(s, i) == "0" && len(s) > i + 1 {
        return false
    }
    while i < len(s) {
        if !is_digit_char(char_at(s, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// `1.5`, `-0.25`, `2e3`, `1.5E-3`: an int-looking part, then a fraction and/or an exponent.
fn looks_float(s: string) -> bool {
    var i = 0
    if is_char_at(s, 0, "-") {
        i = 1
    }
    if i >= len(s) || !is_digit_char(char_at(s, i)) {
        return false
    }
    if char_at(s, i) == "0" && len(s) > i + 1 && is_digit_char(char_at(s, i + 1)) {
        return false
    }
    var seen_dot = false
    var seen_exp = false
    var seen_digit = false
    while i < len(s) {
        val c = char_at(s, i)
        if is_digit_char(c) {
            seen_digit = true
        } else if c == "." && !seen_dot && !seen_exp && seen_digit {
            seen_dot = true
            seen_digit = false
        } else if (c == "e" || c == "E") && !seen_exp && seen_digit {
            seen_exp = true
            seen_digit = false
            if is_char_at(s, i + 1, "+") || is_char_at(s, i + 1, "-") {
                i = i + 1
            }
        } else {
            return false
        }
        i = i + 1
    }
    return seen_digit && (seen_dot || seen_exp)
}

// A cell as JSON: the scanner's tag says what it looks like (only `parse_csv_typed` asks it to
// look).
fn typed_cell(cell: Cell) -> Json {
    val tag = cell.tag
    if tag == "n" {
        return Json.JNull
    }
    if tag == "t" {
        return Json.JBool(true)
    }
    if tag == "x" {
        return Json.JBool(false)
    }
    if tag == "i" {
        val n = parse_int(cell.text)
        return if is_ok(n) { int_to_json(unwrap(n)) } else { Json.JString(cell.text) }
    }
    if tag == "d" {
        val f = parse_float(cell.text)
        return if is_ok(f) { float_to_json(unwrap(f)) } else { Json.JString(cell.text) }
    }
    return Json.JString(cell.text)
}

// Rows `from..` as objects keyed by `header`. Every row must have as many cells as the header.
fn rows_to_objects(rows: [Row], header: [string], from: int, typed: bool) -> Result<Json, string> {
    val seen = setb_new<string>()
    for h in header {
        if setb_contains(seen, h) {
            return err(format("duplicate column name '{}'", h))
        }
        setb_add(seen, h)
    }
    val out = ab_new<Json>()
    for i in from..len(rows) {
        val row = rows[i]
        if len(row.cells) != len(header) {
            return err(format("line {}: {} cells, but there are {} columns", row.line, len(row.cells), len(header)))
        }
        val obj = mapb_new<string, Json>()
        for j in 0..len(header) {
            val cell = row.cells[j]
            mapb_set(obj, header[j], if typed { typed_cell(cell) } else { Json.JString(cell.text) })
        }
        ab_append(out, Json.JObject(mapb_to_map(obj)))
    }
    return ok(Json.JArray(ab_to_array(out)))
}

fn header_of(rows: [Row]) -> [string] {
    val names = ab_new<string>()
    for cell in rows[0].cells {
        ab_append(names, cell.text)
    }
    return ab_to_array(names)
}

fn table_of(text: string, sep: string, typed: bool) -> Result<Json, string> {
    val rows = try parse_rows(text, sep, typed)
    if len(rows) == 0 {
        val no_rows: [Json] = []
        return ok(Json.JArray(no_rows))
    }
    return rows_to_objects(rows, header_of(rows), 1, typed)
}

fn table_with_columns(text: string, columns: [string], typed: bool) -> Result<Json, string> {
    return rows_to_objects(try parse_rows(text, ",", typed), columns, 0, typed)
}

// The raw table as strings, header row included: `[["name", "age"], ["Ada", "36"]]`. Quotes
// are removed and doubled quotes collapsed; nothing else is interpreted. Blank lines are
// skipped and a leading byte order mark is ignored.
pub fn parse_csv_rows(text: string) -> Result<[[string]], string> {
    return parse_csv_rows_with(text, ",")
}

// parse_csv_rows with another one-character delimiter, e.g. "\t" for TSV.
pub fn parse_csv_rows_with(text: string, delimiter: string) -> Result<[[string]], string> {
    val rows = try parse_rows(text, delimiter, false)
    val out = ab_new<[string]>()
    for row in rows {
        val cells = ab_new<string>()
        for cell in row.cells {
            ab_append(cells, cell.text)
        }
        ab_append(out, ab_to_array(cells))
    }
    return ok(ab_to_array(out))
}

// The first row names the columns; every later row becomes a JSON object of strings keyed by
// them, so `#[derive(Json)]` types with `string` fields decode straight from it. An Err for a
// duplicate column name, or for a row whose cell count differs from the header's (the message
// names the line). An empty file is an empty array.
pub fn parse_csv(text: string) -> Result<Json, string> {
    return table_of(text, ",", false)
}

// parse_csv with another one-character delimiter.
pub fn parse_csv_with(text: string, delimiter: string) -> Result<Json, string> {
    return table_of(text, delimiter, false)
}

// parse_csv, but an *unquoted* cell becomes a number (`42` an int, `-1.5` or `2e3` a float; not
// `007`, `+1` or `1_000`, which stay strings), `true` / `false` a boolean, and an empty cell
// null. A quoted cell is always a string. This is what lets `#[derive(Json)]` types with `int`,
// `float`, `bool` and `Option` fields decode from a row.
pub fn parse_csv_typed(text: string) -> Result<Json, string> {
    return table_of(text, ",", true)
}

// parse_csv_typed with another one-character delimiter.
pub fn parse_csv_typed_with(text: string, delimiter: string) -> Result<Json, string> {
    return table_of(text, delimiter, true)
}

// For a file with no header row: every row is data, and `columns` names the cells. Each row
// must have `len(columns)` cells.
pub fn parse_csv_columns(text: string, columns: string...) -> Result<Json, string> {
    return table_with_columns(text, columns, false)
}

// parse_csv_columns with the cell typing of `parse_csv_typed`.
pub fn parse_csv_columns_typed(text: string, columns: string...) -> Result<Json, string> {
    return table_with_columns(text, columns, true)
}

// ---------------------------------------------------------------- reading a file lazily

// The text of one logical record, which spans several lines when a quoted cell contains newlines, and
// the line it started on.
struct RecordText {
    text: string
    line: int
}

fn record_text_error(line: int, message: string) -> Result<RecordText, string> {
    return err(format("line {}: {}", line, message))
}

// How many `"` characters a line holds. A record is complete when its total is even: a quoted cell
// opens and closes with one each and a doubled quote inside adds two.
fn quote_count(line: string) -> int {
    return len(split(line, "\"")) - 1
}

// The Err for a record whose quotes never balanced by the end of the file: the scanner's own message when
// it can give one (a stray quote in the middle of a cell looks the same to a line count), else that a
// quoted cell is never closed.
fn unclosed_record(text: string, start_line: int, sep: string) -> Result<RecordText, string> {
    return switch parse_rows(text, sep, false) {
        Ok(_) { record_text_error(start_line, "a quoted cell is never closed") }
        Err(e) { err(record_error(start_line, e)) }
    }
}

// The next record of a file being read line by line, or None at its end. Blank lines between records are
// skipped; `cell` holds how many lines have been read. An Err item for a line that cannot be text, a
// read error, or a quote that is never closed.
fn read_record(
    lines: Iter<Result<string,
    string>>,
    cell: Channel<int>,
    sep: string
) -> Option<Result<RecordText, string>> {
    var text = ""
    var started = false
    var start_line = 0
    var quotes = 0
    var result = Option<Result<RecordText, string>>.None
    var done = false
    while !done {
        val item = iter_next<Result<string, string>>(lines)
        val number = receive(cell) + 1
        if Option.is_None(item) {
            send(cell, number - 1)
            done = true
            if started {
                result = Option<Result<RecordText, string>>.Some(unclosed_record(text, start_line, sep))
            }
        } else {
            send(cell, number)
            val line_result = Option.unwrap_Some(item)
            if !is_ok(line_result) {
                done = true
                result = Option<Result<RecordText, string>>.Some(record_text_error(number, unwrap_err(line_result)))
            } else {
                val line = unwrap(line_result)
                if !started && len(trim(line)) == 0 {
                    continue
                }
                if started {
                    text = concat(text, "\n", line)
                } else {
                    started = true
                    start_line = number
                    text = line
                }
                quotes = quotes + quote_count(line)
                if quotes % 2 == 0 {
                    done = true
                    val record: Result<RecordText, string> = RecordText { text: text, line: start_line }
                    result = Option<Result<RecordText, string>>.Some(record)
                }
            }
        }
    }
    return result
}

// The scanner's message for one record, with its line numbers (relative to the record) turned into the
// file's: the leading "line N: " becomes the record's first line plus N - 1, and so does an "(opened on
// line N)" inside the message.
fn record_error(start_line: int, message: string) -> string {
    val parts = split_once(message, ": ")
    if !starts_with(message, "line ") || Option.is_None(parts) {
        return format("line {}: {}", start_line, message)
    }
    val prefix = Option.unwrap_Some(parts)[0]
    val relative = parse_int(substring(prefix, 5, len(prefix)))
    val line = if is_ok(relative) { start_line + unwrap(relative) - 1 } else { start_line }
    var detail = Option.unwrap_Some(parts)[1]
    val marker = "(opened on line "
    val at = index_of(detail, marker, 0)
    if at >= 0 {
        val close = index_of(detail, ")", at)
        val opened = parse_int(substring(detail, at + len(marker), close))
        if close >= 0 && is_ok(opened) {
            detail = concat(
                substring(detail, 0, at),
                format("(opened on line {})", start_line + unwrap(opened) - 1),
                substring(detail, close + 1, len(detail))
            )
        }
    }
    return format("line {}: {}", line, detail)
}

// One record's text as a row with its real line number.
fn row_of_record(record: RecordText, sep: string, typed: bool) -> Result<Row, string> {
    val parsed = parse_rows(record.text, sep, typed)
    if !is_ok(parsed) {
        return err(record_error(record.line, unwrap_err(parsed)))
    }
    val rows = unwrap(parsed)
    if len(rows) == 0 {
        return err(format("line {}: empty record", record.line))
    }
    return Row { line: record.line, cells: rows[0].cells }
}

fn next_object(
    lines: Iter<Result<string,
    string>>,
    cell: Channel<int>,
    names: [string],
    sep: string,
    typed: bool
) -> Option<Result<Json, string>> {
    val record = read_record(lines, cell, sep)
    if Option.is_None(record) {
        return Option<Result<Json, string>>.None
    }
    val text = Option.unwrap_Some(record)
    if !is_ok(text) {
        val failure: Result<Json, string> = unwrap_err(text)
        return Option<Result<Json, string>>.Some(failure)
    }
    val row = row_of_record(unwrap(text), sep, typed)
    if !is_ok(row) {
        val failure: Result<Json, string> = unwrap_err(row)
        return Option<Result<Json, string>>.Some(failure)
    }
    val objects = rows_to_objects([unwrap(row)], names, 0, typed)
    if !is_ok(objects) {
        val failure: Result<Json, string> = unwrap_err(objects)
        return Option<Result<Json, string>>.Some(failure)
    }
    val array = Json.unwrap_JArray(unwrap(objects))
    val item: Result<Json, string> = array[0]
    return Option<Result<Json, string>>.Some(item)
}

fn open_records(path: string, sep: string, typed: bool) -> Result<Iter<Result<Json, string>>, string> {
    try check_delimiter(sep)
    val lines = try fs.lines(path)
    val cell: Channel<int> = channel_new()
    send(cell, 0)
    val first = read_record(lines, cell, sep)
    if Option.is_None(first) {
        iter_close<Result<string, string>>(lines)
        val no_items: [Result<Json, string>] = []
        return iter_of_array<Result<Json, string>>(no_items)
    }
    val header_text = Option.unwrap_Some(first)
    if !is_ok(header_text) {
        iter_close<Result<string, string>>(lines)
        return err(unwrap_err(header_text))
    }
    val header_row = row_of_record(unwrap(header_text), sep, false)
    if !is_ok(header_row) {
        iter_close<Result<string, string>>(lines)
        return err(unwrap_err(header_row))
    }
    val names = header_of([unwrap(header_row)])
    return switch rows_to_objects([unwrap(header_row)], names, 1, typed) {
        Ok(_) {
            iter_from<Result<Json, string>>(fn() -> Option<Result<Json, string>> {
                next_object(lines, cell, names, sep, typed)
            }, fn() { iter_close<Result<string, string>>(lines) })
        }
        Err(e) {
            iter_close<Result<string, string>>(lines)
            err(e)
        }
    }
}

// A CSV file read lazily, one record at a time as a `for` loop asks for them, so a file of any size uses
// memory for one record: `val records = try csv.records(path)` then `for record in records { val row =
// try record ... }`. The first record names the columns and every later one is a JSON object of strings keyed
// by them, as in `parse_csv`. Each item is a `Result<Json, string>`: an object, or an Err for a record
// with the wrong number of cells, a stray quote, a quote never closed, a line with a NUL byte or a read
// error; each message names the line the record started on, and the iteration carries on after all but a
// read error or an unclosed quote. The Err on the call is the file failing to open, an invalid header
// or a duplicate column name. A quoted cell may contain newlines (the record then spans lines). Leaving the
// loop early closes the file.
pub fn records(path: string) -> Result<Iter<Result<Json, string>>, string> {
    return open_records(path, ",", false)
}

// records with another one-character delimiter.
pub fn records_with(path: string, delimiter: string) -> Result<Iter<Result<Json, string>>, string> {
    return open_records(path, delimiter, false)
}

// records with the cell typing of `parse_csv_typed`: unquoted numbers, booleans and empty cells.
pub fn records_typed(path: string) -> Result<Iter<Result<Json, string>>, string> {
    return open_records(path, ",", true)
}

// records_typed with another one-character delimiter.
pub fn records_typed_with(path: string, delimiter: string) -> Result<Iter<Result<Json, string>>, string> {
    return open_records(path, delimiter, true)
}

// ---------------------------------------------------------------- writing
//
// Every line ends in "\n" (RFC 4180 says CRLF, which the readers here accept and nearly every
// tool does too). A cell is quoted when it contains the delimiter, a quote or a newline, or
// starts or ends with a space; an empty string, and a string that looks like a number or
// `true` / `false`, is quoted so it reads back as a string.

fn needs_quotes(s: string, sep: string) -> bool {
    if len(s) == 0 {
        return false
    }
    if is_char_at(s, 0, " ") || is_char_at(s, len(s) - 1, " ") {
        return true
    }
    return contains(s, sep) || contains(s, "\"") || contains(s, "\n") || contains(s, "\r")
}

fn quote_cell(s: string) -> string {
    return concat("\"", replace(s, "\"", "\"\""), "\"")
}

fn write_row(out: StringBuilder, cells: [string], sep: string) {
    var first = true
    for cell in cells {
        if !first {
            sb_append(out, sep)
        }
        first = false
        sb_append(out, if needs_quotes(cell, sep) { quote_cell(cell) } else { cell })
    }
    sb_append(out, "\n")
}

// A table of raw strings as text, one row per line, quoting where a cell needs it. Nothing
// is inferred: an empty string is written as an empty cell.
pub fn csv_rows_to_string(rows: [[string]]) -> string {
    val out = sb_new()
    for row in rows {
        write_row(out, row, ",")
    }
    return sb_to_string(out)
}

// csv_rows_to_string with another one-character delimiter. An Err for an invalid delimiter.
pub fn csv_rows_to_string_with(rows: [[string]], delimiter: string) -> Result<string, string> {
    try check_delimiter(delimiter)
    val out = sb_new()
    for row in rows {
        write_row(out, row, delimiter)
    }
    return ok(sb_to_string(out))
}

// A scalar as the text of its cell. A string that would read back as something else under
// parse_csv_typed (empty, numeric, true/false) is quoted so it stays a string.
fn cell_text(v: Json, key: string, sep: string) -> Result<string, string> {
    if Json.is_JNull(v) {
        return ok("")
    }
    if Json.is_JBool(v) {
        return ok(if Json.unwrap_JBool(v) { "true" } else { "false" })
    }
    if Json.is_JNumber(v) {
        return ok(number_cell(Json.unwrap_JNumber(v)))
    }
    if Json.is_JString(v) {
        val s = Json.unwrap_JString(v)
        if len(s) == 0 || s == "true" || s == "false" || looks_int(s) || looks_float(s) {
            return ok(quote_cell(s))
        }
        return ok(if needs_quotes(s, sep) { quote_cell(s) } else { s })
    }
    return err(format("field '{}' is nested more than one level deep (or an array); CSV cannot hold it", key))
}

// Flattens one row into ordered (column, cell text) entries.
fn flatten_row(row: Json, sep: string) -> Result<Map<string, string>, string> {
    val cells = mapb_new<string, string>()
    for key, value in Json.unwrap_JObject(row) {
        if Json.is_JObject(value) {
            for inner_key, inner in Json.unwrap_JObject(value) {
                val name = concat(key, ".", inner_key)
                val text = try cell_text(inner, name, sep)
                mapb_set(cells, name, text)
            }
        } else {
            val text = try cell_text(value, key, sep)
            mapb_set(cells, key, text)
        }
    }
    return ok(mapb_to_map(cells))
}

// A JSON array of objects as CSV: a header row of the union of the rows' keys in first-seen
// order, then one line per object; a key a row lacks is an empty cell. An object value is
// flattened one level into dotted columns (`address.city`); an array, or an object nested
// deeper, is an Err (CSV cannot hold it), as is a row that is not an object.
pub fn csv_to_string(rows: Json) -> Result<string, string> {
    return csv_to_string_with(rows, ",")
}

// csv_to_string with another one-character delimiter.
pub fn csv_to_string_with(rows: Json, delimiter: string) -> Result<string, string> {
    try check_delimiter(delimiter)
    if !Json.is_JArray(rows) {
        return err("expected an array of objects")
    }
    val flat = ab_new<Map<string, string>>()
    val columns = setb_new<string>()
    var i = 0
    for row in Json.unwrap_JArray(rows) {
        if !Json.is_JObject(row) {
            return err(format("row {} is not an object", i))
        }
        val cells = try flatten_row(row, delimiter)
        for name in map_keys(cells) {
            setb_add(columns, name)
        }
        ab_append(flat, cells)
        i = i + 1
    }
    val names = set_items(setb_to_set(columns))
    val out = sb_new()
    write_row(out, names, delimiter)
    for cells in ab_to_array(flat) {
        var first = true
        for name in names {
            if !first {
                sb_append(out, delimiter)
            }
            first = false
            sb_append(out, option_unwrap_or<string>(map_get(cells, name), ""))
        }
        sb_append(out, "\n")
    }
    return ok(sb_to_string(out))
}

// A JSON number as the text of a cell: an int or bigint as its digits, a float as the fewest digits that read back, a decimal
// as its digits at its own scale.
fn number_cell(n: Number) -> string {
    switch n {
        Int(i) { return str(i) }
        Float(f) { return float_to_text(f) }
        Bigint(b) { return str(b) }
        Decimal(d) { return str(d) }
    }
}
