// csv.zm -- CSV (RFC 4180) on top of `json`: a table is a `Json` array of objects, one per
// data row, keyed by the header row, so any `#[derive(Json)]` type decodes from a row with
// its own `_from_json`. Written in pure Ziman.
//
// Reading: quoted fields may hold the separator, doubled quotes (`""`) and newlines; rows may
// end in LF or CRLF; blank lines are skipped. `parse_csv` keeps every cell as a `JString`;
// `parse_csv_typed` also reads an *unquoted* cell as a number (`42`, `-1.5`, but not `007` --
// a leading zero is an identifier, not a number), `true`/`false`, or null (empty), and a
// quoted cell always stays a string -- so `csv_to_string` (which quotes exactly the strings
// that would otherwise read back as something else) round-trips through `parse_csv_typed`.
//
// Writing: columns are the union of the rows' keys in first-seen order. An object value is
// flattened one level into dotted columns (`address.city`); an array, or a deeper object,
// is an error (CSV cannot represent nesting). A key a row lacks is an empty cell.
// Every writer line ends in "\n".

use json.Json

struct Cell {
    text: string
    quoted: bool
}

fn finish_field(row: ArrayBuilder<Cell>, field: StringBuilder, quoted: bool) {
    ab_append<Cell>(row, Cell { text: sb_to_string(field), quoted: quoted })
}

// A row that is one empty unquoted cell is a blank line.
fn finish_row(rows: ArrayBuilder<[Cell]>, row: ArrayBuilder<Cell>) {
    val cells = ab_to_array<Cell>(row)
    if len(cells) == 1 && len(cells[0].text) == 0 && !cells[0].quoted {
        return
    }
    ab_append<[Cell]>(rows, cells)
}

fn parse_cells(text: string, sep: string) -> Result<[[Cell]], string> {
    val rows = ab_new<[Cell]>()
    var row = ab_new<Cell>()
    var field = sb_new()
    var quoted = false
    var in_quotes = false
    var started = false
    var line = 1
    var p = 0
    val n = len(text)
    while p < n {
        val c = char_at(text, p)
        if in_quotes {
            if c == "\"" {
                if is_char_at(text, p + 1, "\"") {
                    sb_append(field, "\"")
                    p = p + 2
                } else {
                    in_quotes = false
                    p = p + 1
                }
            } else {
                if c == "\n" {
                    line = line + 1
                }
                sb_append(field, c)
                p = p + 1
            }
            continue
        }
        if c == "\"" {
            if started {
                return err(format("line {}: a quote inside an unquoted field", line))
            }
            in_quotes = true
            quoted = true
            started = true
            p = p + 1
        } else if c == sep {
            finish_field(row, field, quoted)
            field = sb_new()
            quoted = false
            started = false
            p = p + 1
        } else if c == "\n" || c == "\r" {
            if c == "\r" && is_char_at(text, p + 1, "\n") {
                p = p + 1
            }
            finish_field(row, field, quoted)
            finish_row(rows, row)
            row = ab_new<Cell>()
            field = sb_new()
            quoted = false
            started = false
            line = line + 1
            p = p + 1
        } else {
            if quoted {
                return err(format("line {}: text after a closing quote", line))
            }
            sb_append(field, c)
            started = true
            p = p + 1
        }
    }
    if in_quotes {
        return err(format("line {}: unterminated quoted field", line))
    }
    if started || quoted || sb_len(field) > 0 || ab_len<Cell>(row) > 0 {
        finish_field(row, field, quoted)
        finish_row(rows, row)
    }
    return ok(ab_to_array<[Cell]>(rows))
}

fn is_digit_char(c: string) -> bool {
    return len(c) == 1 && index_of("0123456789", c, 0) >= 0
}

// `42`, `-7`, `0`; not `007`, `+1`, `1_000`, `-`.
fn looks_int(s: string) -> bool {
    var i = 0
    if is_char_at(s, 0, "-") {
        i = 1
    }
    if i >= len(s) {
        return false
    }
    if char_at(s, i) == "0" && len(s) > i + 1 {
        return false
    }
    while i < len(s) {
        if !is_digit_char(char_at(s, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// `1.5`, `-0.25`, `2e3`, `1.5E-3`: an int-looking part, then a fraction and/or an exponent.
fn looks_float(s: string) -> bool {
    var i = 0
    if is_char_at(s, 0, "-") {
        i = 1
    }
    if i >= len(s) || !is_digit_char(char_at(s, i)) {
        return false
    }
    if char_at(s, i) == "0" && len(s) > i + 1 && is_digit_char(char_at(s, i + 1)) {
        return false
    }
    var seen_dot = false
    var seen_exp = false
    var seen_digit = false
    while i < len(s) {
        val c = char_at(s, i)
        if is_digit_char(c) {
            seen_digit = true
        } else if c == "." && !seen_dot && !seen_exp && seen_digit {
            seen_dot = true
            seen_digit = false
        } else if (c == "e" || c == "E") && !seen_exp && seen_digit {
            seen_exp = true
            seen_digit = false
            if is_char_at(s, i + 1, "+") || is_char_at(s, i + 1, "-") {
                i = i + 1
            }
        } else {
            return false
        }
        i = i + 1
    }
    return seen_digit && (seen_dot || seen_exp)
}

fn typed_cell(cell: Cell) -> Json {
    if cell.quoted {
        return Json.JString(cell.text)
    }
    val t = cell.text
    if len(t) == 0 {
        return Json.JNull
    }
    if t == "true" {
        return Json.JBool(true)
    }
    if t == "false" {
        return Json.JBool(false)
    }
    if looks_int(t) {
        val n = parse_int(t)
        if is_ok(n) {
            return Json.JInt(unwrap(n))
        }
    }
    if looks_float(t) {
        val f = parse_float(t)
        if is_ok(f) {
            return Json.JNumber(unwrap(f))
        }
    }
    return Json.JString(t)
}

fn rows_to_objects(rows: [[Cell]], typed: bool) -> Result<Json, string> {
    val out = ab_new<Json>()
    if len(rows) == 0 {
        return ok(Json.JArray(ab_to_array<Json>(out)))
    }
    val header = rows[0]
    val seen = setb_new<string>()
    for h in header {
        if setb_contains<string>(seen, h.text) {
            return err(format("duplicate column name '{}'", h.text))
        }
        setb_add<string>(seen, h.text)
    }
    var i = 1
    while i < len(rows) {
        val row = rows[i]
        if len(row) != len(header) {
            return err(format("row {} has {} cells but the header has {}", i, len(row), len(header)))
        }
        val obj = mapb_new<string, Json>()
        var j = 0
        while j < len(header) {
            mapb_set<string, Json>(obj, header[j].text,
                if typed { typed_cell(row[j]) } else { Json.JString(row[j].text) })
            j = j + 1
        }
        ab_append<Json>(out, Json.JObject(mapb_to_map<string, Json>(obj)))
        i = i + 1
    }
    return ok(Json.JArray(ab_to_array<Json>(out)))
}

// The raw table as strings, header row included: [["name", "age"], ["Ada", "36"]].
pub fn parse_csv_rows(text: string) -> Result<[[string]], string> {
    return parse_csv_rows_with(text, ",")
}

// parse_csv_rows with another separator, e.g. "\t" for TSV.
pub fn parse_csv_rows_with(text: string, delimiter: string) -> Result<[[string]], string> {
    val rows = parse_cells(text, delimiter)?
    val out = ab_new<[string]>()
    for row in rows {
        val cells = ab_new<string>()
        for cell in row {
            ab_append<string>(cells, cell.text)
        }
        ab_append<[string]>(out, ab_to_array<string>(cells))
    }
    return ok(ab_to_array<[string]>(out))
}

// The first row names the columns; each later row becomes a JSON object of strings.
pub fn parse_csv(text: string) -> Result<Json, string> {
    return parse_csv_with(text, ",")
}

pub fn parse_csv_with(text: string, delimiter: string) -> Result<Json, string> {
    val rows = parse_cells(text, delimiter)?
    return rows_to_objects(rows, false)
}

// parse_csv, reading an unquoted cell as a number, a boolean or null where it looks like one.
pub fn parse_csv_typed(text: string) -> Result<Json, string> {
    return parse_csv_typed_with(text, ",")
}

pub fn parse_csv_typed_with(text: string, delimiter: string) -> Result<Json, string> {
    val rows = parse_cells(text, delimiter)?
    return rows_to_objects(rows, true)
}

fn needs_quotes(s: string, sep: string) -> bool {
    if len(s) == 0 {
        return false
    }
    if is_char_at(s, 0, " ") || is_char_at(s, len(s) - 1, " ") {
        return true
    }
    return contains(s, sep) || contains(s, "\"") || contains(s, "\n") || contains(s, "\r")
}

fn quote_cell(s: string) -> string {
    return concat("\"", concat(replace(s, "\"", "\"\""), "\""))
}

fn write_row(out: StringBuilder, cells: [string], sep: string) {
    var first = true
    for cell in cells {
        if !first {
            sb_append(out, sep)
        }
        first = false
        sb_append(out, if needs_quotes(cell, sep) { quote_cell(cell) } else { cell })
    }
    sb_append(out, "\n")
}

// A table of raw strings back to text (quoting where needed), one row per line.
pub fn csv_rows_to_string(rows: [[string]]) -> string {
    return csv_rows_to_string_with(rows, ",")
}

pub fn csv_rows_to_string_with(rows: [[string]], sep: string) -> string {
    val out = sb_new()
    for row in rows {
        write_row(out, row, sep)
    }
    return sb_to_string(out)
}

// A scalar as the text of its cell. A string that would read back as something else under
// parse_csv_typed (empty, numeric, true/false) is quoted so it stays a string.
fn cell_text(v: Json, key: string, sep: string) -> Result<string, string> {
    if Json.is_JNull(v) {
        return ok("")
    }
    if Json.is_JBool(v) {
        return ok(if Json.unwrap_JBool(v) { "true" } else { "false" })
    }
    if Json.is_JInt(v) {
        return ok(str(Json.unwrap_JInt(v)))
    }
    if Json.is_JNumber(v) {
        return ok(str(Json.unwrap_JNumber(v)))
    }
    if Json.is_JString(v) {
        val s = Json.unwrap_JString(v)
        if len(s) == 0 || s == "true" || s == "false" || looks_int(s) || looks_float(s) {
            return ok(quote_cell(s))
        }
        return ok(if needs_quotes(s, sep) { quote_cell(s) } else { s })
    }
    return err(format("field '{}' is nested more than one level deep (or an array); CSV cannot hold it", key))
}

// Flattens one row into ordered (column, cell text) entries.
fn flatten_row(row: Json, sep: string) -> Result<Map<string, string>, string> {
    val cells = mapb_new<string, string>()
    for key, value in Json.unwrap_JObject(row) {
        if Json.is_JObject(value) {
            for inner_key, inner in Json.unwrap_JObject(value) {
                val name = concat(key, concat(".", inner_key))
                val text = cell_text(inner, name, sep)?
                mapb_set<string, string>(cells, name, text)
            }
        } else {
            val text = cell_text(value, key, sep)?
            mapb_set<string, string>(cells, key, text)
        }
    }
    return ok(mapb_to_map<string, string>(cells))
}

// A JSON array of objects as CSV: a header row of the union of the keys, then one line per
// object. Cells are already quoted by cell_text; the header is quoted where needed.
pub fn csv_to_string(rows: Json) -> Result<string, string> {
    return csv_to_string_with(rows, ",")
}

pub fn csv_to_string_with(rows: Json, sep: string) -> Result<string, string> {
    if !Json.is_JArray(rows) {
        return err("expected an array of objects")
    }
    val flat = ab_new<Map<string, string>>()
    val columns = setb_new<string>()
    var i = 0
    for row in Json.unwrap_JArray(rows) {
        if !Json.is_JObject(row) {
            return err(format("row {} is not an object", i))
        }
        val cells = flatten_row(row, sep)?
        for name in map_keys(cells) {
            setb_add<string>(columns, name)
        }
        ab_append<Map<string, string>>(flat, cells)
        i = i + 1
    }
    val names = set_items(setb_to_set<string>(columns))
    val out = sb_new()
    write_row(out, names, sep)
    for cells in ab_to_array<Map<string, string>>(flat) {
        var first = true
        for name in names {
            if !first {
                sb_append(out, sep)
            }
            first = false
            sb_append(out, option_unwrap_or<string>(map_get(cells, name), ""))
        }
        sb_append(out, "\n")
    }
    return ok(sb_to_string(out))
}
