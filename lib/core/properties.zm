// properties.zm -- Spring-Boot-style configuration: `key=value` files,
// profiles, `${placeholder}` substitution, and environment-variable
// overrides, all reporting errors that name the key and where its value
// came from. Pure Ziman on top of `io` and `os`.
//
// Format: one `key=value` per line; `#` starts a comment only at the
// beginning of a line; keys are lowercase, dotted, kebab-case
// (`server.idle-timeout-ms`); values are trimmed, with no quoting,
// escapes or inline comments. Anything else -- a duplicate key, an
// uppercase key, a line that is neither blank, comment nor key=value --
// is an error with its file:line, never silently skipped.
//
// Loading `load("application")` reads `application.properties` (required)
// from the working directory, then `application-<profile>.properties`
// when a profile is active. The profile is env `PROFILE_ACTIVE`, else
// `profile.active` in the base file; an active profile whose file is
// missing is an error (it catches typos). Profile values override base
// values.
//
// Lookup precedence, highest first: environment variable (the key
// upper-cased with `.`/`-` -> `_`, so `server.port` is `SERVER_PORT`),
// profile file, base file. Values may contain `${name}` or
// `${name:default}`, resolved against properties, then the environment
// (exact name), then the default; an unresolvable placeholder or a
// cycle is an error. The default may itself contain `:`.
//
// Placeholders are resolved once, when the properties are built, so a bad
// one fails startup and every lookup afterwards is a plain array scan.

use fs
use os

// One setting: its `key`, its `value`, and `source`, where it came from (a file, the environment,
// an override) for messages that say why a value is what it is.
pub struct Entry {
    key: string
    value: string
    source: string
}

// The loaded configuration: every entry in lookup order, and the active `profile` (empty when
// none).
pub struct Properties {
    entries: [Entry]
    profile: string
}

// server.idle-timeout-ms -> SERVER_IDLE_TIMEOUT_MS
fn env_name(key: string) -> string {
    return to_upper(replace(replace(key, ".", "_"), "-", "_"))
}

fn find_file_entry(entries: [Entry], key: string) -> Option<Entry> {
    for i in 0..len(entries) {
        if entries[i].key == key {
            return Option<Entry>.Some(entries[i])
        }
    }
    return Option<Entry>.None
}

// The entry for `key`: its environment variable if set (taken literally),
// else the file entry.
pub fn lookup(props: Properties, key: string) -> Option<Entry> {
    val name = env_name(key)
    val e = os.getenv(name)
    return switch e {
        Some(v) { Option<Entry>.Some(Entry { key: key, value: v, source: concat("env ", name) }) }
        None { find_file_entry(props.entries, key) }
    }
}

// Resolves `${name}` / `${name:default}` in `value`; `seen` holds the
// names being expanded, to catch cycles.
fn resolve(props: Properties, value: string, source: string, seen: [string]) -> Result<string, string> {
    val sb = sb_new()
    var p = 0
    var done = false
    while !done {
        val start = index_of(value, "${", p)
        if start < 0 {
            sb_append(sb, substring(value, p, len(value)))
            done = true
        } else {
            val end = index_of(value, "}", start + 2)
            if end < 0 {
                return err(format("{}: unterminated placeholder in '{}'", source, value))
            }
            sb_append(sb, substring(value, p, start))
            val inner = substring(value, start + 2, end)
            val colon = index_of(inner, ":", 0)
            val name = if colon >= 0 { substring(inner, 0, colon) } else { inner }
            if contains(seen, name) {
                return err(format("{}: placeholder cycle through '{}'", source, name))
            }
            val referenced = find_file_entry(props.entries, name)
            val env = os.getenv(name)
            if Some(r) = referenced {
                val expanded = try resolve(props, r.value, r.source, push(seen, name))
                sb_append(sb, expanded)
            } else if Some(v) = env {
                sb_append(sb, v)
            } else if colon >= 0 {
                sb_append(sb, substring(inner, colon + 1, len(inner)))
            } else {
                return err(format(
                    "{}: placeholder '{}' is neither a property nor an environment variable and has no default",
                    source,
                    name
                ))
            }
            p = end + 1
        }
    }
    return ok(sb_to_string(sb))
}

fn resolve_all(props: Properties) -> Result<Properties, string> {
    val out = ab_new<Entry>()
    for i in 0..len(props.entries) {
        val e = props.entries[i]
        val value = try resolve(props, e.value, e.source, [e.key])
        ab_append(out, Entry { key: e.key, value: value, source: e.source })
    }
    return ok(Properties { entries: ab_to_array(out), profile: props.profile })
}

fn parse_raw(text: string, source: string) -> Result<Properties, string> {
    val lines = split(text, "\n")
    val found = ab_new<Entry>()
    for i in 0..len(lines) {
        val line = trim(lines[i])
        val where = format("{}:{}", source, i + 1)
        if len(line) == 0 || starts_with(line, "#") {
            continue
        }
        val eq = index_of(line, "=", 0)
        if eq < 0 {
            return err(format("{}: expected key=value or a # comment, got '{}'", where, line))
        }
        val key = trim(substring(line, 0, eq))
        if len(key) == 0 {
            return err(format("{}: empty key", where))
        }
        if to_lower(key) != key {
            return err(format(
                "{}: key '{}' must be lowercase (use dotted kebab-case, e.g. server.idle-timeout-ms)",
                where,
                key
            ))
        }
        if contains(key, " ") || contains(key, "\t") {
            return err(format("{}: key '{}' contains whitespace", where, key))
        }
        ab_append(found, Entry { key: key, value: trim(substring(line, eq + 1, len(line))), source: where })
    }
    val entries = ab_to_array(found)
    val first_seen = mapb_new<string, string>()
    for e in entries {
        val earlier = mapb_get(first_seen, e.key)
        if Some(first) = earlier {
            return err(format(
                "{}: duplicate key '{}' (first defined at {})",
                e.source,
                e.key,
                first
            ))
        }
        mapb_set(first_seen, e.key, e.source)
    }
    return ok(Properties { entries: entries, profile: "" })
}

// Parses one properties text, resolving placeholders within it.
pub fn parse(text: string, source: string) -> Result<Properties, string> {
    return resolve_all(try parse_raw(text, source))
}

// Resolves `file` through `ZIMAN_RESOURCE_PATH` (see `fs.resolve`) before reading it, so `load`
// follows the same convention as anything else built on `fs.resolve` -- with the variable unset,
// this is exactly `fs.read_text(file)`, unchanged.
fn read_source(file: string) -> Result<string, string> {
    val resolved = switch fs.resolve(file) {
        Some(path) { path }
        None { return err(format(
            "'{}' is not in ZIMAN_RESOURCE_PATH ({})",
            file,
            unwrap(os.getenv("ZIMAN_RESOURCE_PATH"))
        )) }
    }
    return result_map_err(fs.read_text(resolved), fs.fs_error_message)
}

// `over` wins on a key present in both.
fn merge(base: Properties, over: Properties, profile: string) -> Properties {
    val out = ab_new<Entry>()
    for i in 0..len(over.entries) {
        ab_append(out, over.entries[i])
    }
    for i in 0..len(base.entries) {
        if !Option.is_Some(find_file_entry(over.entries, base.entries[i].key)) {
            ab_append(out, base.entries[i])
        }
    }
    return Properties { entries: ab_to_array(out), profile: profile }
}

// Reads `<name>.properties` from the working directory (an Err if it is missing), then
// `<name>-<profile>.properties` if a profile is active (env `PROFILE_ACTIVE`, else `profile.active` in
// the base file; an active profile with no file is an Err), applies the profile's values over the
// base ones, and resolves every `${placeholder}`. The result is what `lookup` and the `get_*`
// functions read.
pub fn load(name: string) -> Result<Properties, string> {
    val base_file = concat(name, ".properties")
    val text = try read_source(base_file)
    val base = try parse_raw(text, base_file)
    val from_env = os.getenv("PROFILE_ACTIVE")
    val declared = find_file_entry(base.entries, "profile.active")
    val profile = switch from_env {
        Some(v) { trim(v) }
        None {
            switch declared {
                Some(e) { e.value }
                None { "" }
            }
        }
    }
    if len(profile) == 0 {
        return resolve_all(base)
    }
    val profile_file = format("{}-{}.properties", name, profile)
    val profile_text = try read_source(profile_file)
    return resolve_all(merge(base, try parse_raw(profile_text, profile_file), profile))
}

fn require(props: Properties, key: string) -> Result<Entry, string> {
    return switch lookup(props, key) {
        Some(e) { ok(e) }
        None {
            err(format(
                "missing required property '{}' (set it in a .properties file or the {} environment variable)",
                key,
                env_name(key)
            ))
        }
    }
}

// The entry's value as a string (always Ok; here so every `entry_*` has the same shape, which is
// what `#[derive(Properties)]` relies on).
pub fn entry_string(e: Entry) -> Result<string, string> {
    return ok(e.value)
}

// The entry's value as an int. An Err naming the key, the text and where the value came from.
pub fn entry_int(e: Entry) -> Result<int, string> {
    switch parse_int(e.value) {
        Ok(n) { return ok(n) }
        Err(_) { return err(format("{}: '{}' is not an integer ({})", e.key, e.value, e.source)) }
    }
}

// The entry's value as a float. An Err naming the key, the text and where the value came from.
pub fn entry_float(e: Entry) -> Result<float, string> {
    switch parse_float(e.value) {
        Ok(n) { return ok(n) }
        Err(_) { return err(format("{}: '{}' is not a number ({})", e.key, e.value, e.source)) }
    }
}

// The entry's value as a bool: `true` or `false`, any case. An Err otherwise, naming the key and source.
pub fn entry_bool(e: Entry) -> Result<bool, string> {
    val v = to_lower(e.value)
    if v == "true" {
        return ok(true)
    }
    if v == "false" {
        return ok(false)
    }
    return err(format("{}: '{}' is not true or false ({})", e.key, e.value, e.source))
}

// Required typed getters. An optional key is `lookup` plus `entry_*`
// (what #[derive(Properties)] generates for an Option<T> field).
//
// The value of the required property `key` (environment variable first, then the files) as a
// string. An Err if it is missing; the message names the key and the environment variable.
pub fn get_string(props: Properties, key: string) -> Result<string, string> {
    return entry_string(try require(props, key))
}

// The value of the required property `key` (environment variable first, then the files) as an
// int. An Err if it is missing or not an integer; the message names the key and where to set it.
pub fn get_int(props: Properties, key: string) -> Result<int, string> {
    return entry_int(try require(props, key))
}

// The required property `key` as a float; same lookup and errors as `get_int`.
pub fn get_float(props: Properties, key: string) -> Result<float, string> {
    return entry_float(try require(props, key))
}

// The required property `key` as a bool (`true` / `false`); same lookup and errors as `get_int`.
pub fn get_bool(props: Properties, key: string) -> Result<bool, string> {
    return entry_bool(try require(props, key))
}

// "server" + "port" -> "server.port"; an empty prefix leaves the name alone.
pub fn key(prefix: string, name: string) -> string {
    return if len(prefix) == 0 { name } else { format("{}.{}", prefix, name) }
}

// The edit distance between two strings (single-character inserts, deletes and substitutions),
// for "did you mean" hints.
fn distance(a: string, b: string) -> int {
    val first_row = ab_new<int>()
    for j in 0..len(b) + 1 {
        ab_append(first_row, j)
    }
    var prev = ab_to_array(first_row)
    for i in 0..len(a) {
        val row = ab_new<int>()
        ab_append(row, i + 1)
        var left = i + 1
        for j in 0..len(b) {
            val cost = if is_char_at(a, i, char_at(b, j)) { 0 } else { 1 }
            left = min(min(left + 1, prev[j + 1] + 1), prev[j] + cost)
            ab_append(row, left)
        }
        prev = ab_to_array(row)
    }
    return prev[len(b)]
}

fn suggestion(key: string, known: [string]) -> string {
    var best = ""
    var best_distance = 3
    for i in 0..len(known) {
        val d = distance(key, known[i])
        if d < best_distance {
            best = known[i]
            best_distance = d
        }
    }
    return if len(best) == 0 { "" } else { format(" -- did you mean '{}'?", best) }
}

// Fails on a key in the files that isn't in `known` (`profile.active` is
// always allowed), so a typo like `server.prot` stops startup instead of
// silently falling back to a default.
pub fn check_unknown(props: Properties, known: string...) -> Result<bool, string> {
    for i in 0..len(props.entries) {
        val e = props.entries[i]
        if e.key != "profile.active" && !contains(known, e.key) {
            return err(format("unknown property '{}' ({}){}", e.key, e.source, suggestion(e.key, known)))
        }
    }
    return ok(true)
}

fn is_secret_key(key: string) -> bool {
    return contains(key, "password") || contains(key, "secret") || contains(key, "token") || contains(key, "key")
}

// scheme://user:pass@host -> scheme://user:****@host, and password=...
// query parameters.
fn mask_value(value: string) -> string {
    var v = value
    val scheme = index_of(v, "://", 0)
    if scheme >= 0 {
        val at = index_of(v, "@", scheme + 3)
        if at >= 0 {
            val colon = index_of(substring(v, 0, at), ":", scheme + 3)
            if colon >= 0 {
                v = concat(substring(v, 0, colon + 1), "****", substring(v, at, len(v)))
            }
        }
    }
    val pw = index_of(v, "password=", 0)
    if pw >= 0 {
        val start = pw + 9
        var end = index_of(v, "&", start)
        if end < 0 {
            end = len(v)
        }
        v = concat(substring(v, 0, start), "****", substring(v, end, len(v)))
    }
    return v
}

// One line per key in `keys` that has a value: `key=value (source)`,
// with secrets masked. Meant to be printed at startup.
pub fn report(props: Properties, keys: string...) -> string {
    val sb = sb_new()
    if len(props.profile) == 0 {
        sb_append(sb, "active profile: (none)\n")
    } else {
        sb_append(sb, format("active profile: {}\n", props.profile))
    }
    for i in 0..len(keys) {
        val found = lookup(props, keys[i])
        if Some(e) = found {
            val shown = if is_secret_key(e.key) { "****" } else { mask_value(e.value) }
            sb_append(sb, format("{}={} ({})\n", e.key, shown, e.source))
        }
    }
    return sb_to_string(sb)
}
