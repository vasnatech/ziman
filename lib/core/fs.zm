// fs.zm -- the filesystem: files, directories and paths.
//
// Every function that can fail returns a `Result` carrying an `FsError`, so a missing directory, a
// permission problem or a full disk is something a program handles, not a crash -- and the cases worth
// branching on are variants rather than substrings of the OS's message, which is what they used to be.
// `fs_error_message(e)` is the message to show a human, and keeps the OS's own wording inside it. An action with no value
// to report returns `Ok(unit)` (or `Ok(bytes)` for the ones that write), the same shape `net`
// uses. The path predicates (`exists`, `is_dir`, `is_file`) return a plain bool: false covers
// "does not exist" and "cannot be checked" alike.
//
// Text is UTF-8 in a `string`, which cannot hold a NUL byte; anything else -- images, archives,
// files that might contain NUL -- is read and written as `[byte]`.

use os

// ---------------------------------------------------------------- errors

// What went wrong, in the shape `net` uses for `NetError`. The three a program actually branches on --
// "it is not there", "I am not allowed", "that is a directory" -- were reachable only by matching
// substrings of `strerror`, which is neither stable across platforms nor meant to be parsed. `Exists`
// covers the create-a-thing-that-is-already-there case; anything else is `Other`, carrying the OS's
// message unchanged.
pub enum FsError {
    NotFound(string)
    Denied(string)
    IsDirectory(string)
    NotDirectory(string)
    Exists(string)
    Other(string)
}

// A native error arrives as "category|message", classified from `errno` in C (see src/native_fs.c): one
// errno switch there, the enum declared here, and neither side builds the other's values.
fn fs_error_from_raw(raw: string) -> FsError {
    var category = raw
    var message = raw
    if Some(parts) = split_once(raw, "|") {
        category = parts[0]
        message = parts[1]
    }
    if category == "notfound" {
        return FsError.NotFound(message)
    }
    if category == "denied" {
        return FsError.Denied(message)
    }
    if category == "isdir" {
        return FsError.IsDirectory(message)
    }
    if category == "notdir" {
        return FsError.NotDirectory(message)
    }
    if category == "exists" {
        return FsError.Exists(message)
    }
    return FsError.Other(message)
}

// The message to show a human. Every variant already carries the OS's own wording, so this adds nothing
// but passes it through uniformly -- the counterpart of `net_error_message`.
pub fn fs_error_message(e: FsError) -> string {
    return switch e {
        NotFound(msg) { msg }
        Denied(msg) { msg }
        IsDirectory(msg) { msg }
        NotDirectory(msg) { msg }
        Exists(msg) { msg }
        Other(msg) { msg }
    }
}

// ---------------------------------------------------------------- text files

// The whole file as a string. An Err if it cannot be read or contains a NUL byte.
native fn read_text_raw(path: string) -> Result<string, string>

pub fn read_text(path: string) -> Result<string, FsError> {
    val r = read_text_raw(path)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// The lines of a file, read lazily as a `for` loop asks for them, so a file of any size uses memory
// for one line: `val lines = try fs.lines(path)` then `for line in lines { val text = try line ... }`. Each item is a
// `Result<string, string>`: the line without its `\n` or `\r\n` (a final line with no newline counts,
// an empty file has no lines), or an Err for a line with a NUL byte (a string cannot hold one) or a read
// error, after which the iteration ends. The Err on the call itself is the file failing to open.
// Leaving the loop early closes the file.
native fn lines_raw(path: string) -> Result<Iter<Result<string, string>>, string>

pub fn lines(path: string) -> Result<Iter<Result<string, string>>, FsError> {
    val r = lines_raw(path)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// The bytes of a file in blocks of `size` (1 to 1073741824), read lazily as a `for` loop asks for them, so
// a file of any size uses memory for one block: for copying, hashing or uploading a large file. Each item
// is a `Result<[byte], string>`: a block of exactly `size` bytes, except the last, which may be shorter (an
// empty file has none); a read error is a last Err item. The Err on the call is the file failing to open
// or a `size` out of range. Leaving the loop early closes the file.
native fn chunks_raw(path: string, size: int) -> Result<Iter<Result<[byte], string>>, string>

pub fn chunks(path: string, size: int) -> Result<Iter<Result<[byte], string>>, FsError> {
    val r = chunks_raw(path, size)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// The files under a directory, found lazily and depth first, each directory's entries in sorted order:
// `val files = try fs.walk(dir)` then `for file in files { val path = try file ... }`. Each item is a
// `Result<string, string>`: a path made of `dir` and the names below it, for anything that is not a
// directory (a file, a link, a device); a subdirectory that cannot be read is an Err item and the walk
// carries on. Directories themselves are not listed, and a symbolic link to a directory is a path, not
// followed, so a cycle cannot loop. The Err on the call is `dir` failing to open. Leaving the loop early
// releases it.
native fn walk_raw(dir: string) -> Result<Iter<Result<string, string>>, string>

pub fn walk(dir: string) -> Result<Iter<Result<string, string>>, FsError> {
    val r = walk_raw(dir)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// Replaces the file's contents with `text`, creating the file. `Ok(bytes written)`. Not
// atomic: a crash part-way leaves a partly written file (use `write_text_atomic` for that).
native fn write_text_raw(path: string, text: string) -> Result<int, string>

pub fn write_text(path: string, text: string) -> Result<int, FsError> {
    val r = write_text_raw(path, text)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// Adds `text` to the end of the file, creating it. `Ok(bytes written)`.
native fn append_text_raw(path: string, text: string) -> Result<int, string>

pub fn append_text(path: string, text: string) -> Result<int, FsError> {
    val r = append_text_raw(path, text)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// Replaces the file's contents so that a reader, or a crash, sees either the old contents or
// the new ones, never a mixture: the text goes to a temporary file next to `path`, is flushed
// to disk, and is renamed over it. `Ok(bytes written)`.
native fn write_text_atomic_raw(path: string, text: string) -> Result<int, string>

pub fn write_text_atomic(path: string, text: string) -> Result<int, FsError> {
    val r = write_text_atomic_raw(path, text)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// ---------------------------------------------------------------- binary files

// The whole file as bytes (any content, including NUL).
native fn read_bytes_raw(path: string) -> Result<[byte], string>

pub fn read_bytes(path: string) -> Result<[byte], FsError> {
    val r = read_bytes_raw(path)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// Replaces the file's contents with `data`, creating the file. `Ok(bytes written)`.
native fn write_bytes_raw(path: string, data: [byte]) -> Result<int, string>

pub fn write_bytes(path: string, data: [byte]) -> Result<int, FsError> {
    val r = write_bytes_raw(path, data)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// Adds `data` to the end of the file, creating it. `Ok(bytes written)`.
native fn append_bytes_raw(path: string, data: [byte]) -> Result<int, string>

pub fn append_bytes(path: string, data: [byte]) -> Result<int, FsError> {
    val r = append_bytes_raw(path, data)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// ---------------------------------------------------------------- inspecting

// True if something (a file, directory, ...) exists at `path`.
pub native fn exists(path: string) -> bool

// True if `path` is a directory.
pub native fn is_dir(path: string) -> bool

// True if `path` is a regular file.
pub native fn is_file(path: string) -> bool

// The size of the file in bytes.
native fn size_raw(path: string) -> Result<int, string>

pub fn size(path: string) -> Result<int, FsError> {
    val r = size_raw(path)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// The time the file was last modified, in seconds since the Unix epoch.
native fn modified_seconds_raw(path: string) -> Result<int, string>

pub fn modified_seconds(path: string) -> Result<int, FsError> {
    val r = modified_seconds_raw(path)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// The names in a directory, sorted (no "." or ".."). Names only, not paths: join them with
// `path_join`.
native fn list_dir_raw(path: string) -> Result<[string], string>

pub fn list_dir(path: string) -> Result<[string], FsError> {
    val r = list_dir_raw(path)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// `name` (a file or a directory), found by searching `ZIMAN_RESOURCE_PATH` -- a colon-separated list of
// directories, checked in order, the first one that has `name` winning -- the same idea as `PATH`, or a
// Java classpath. With `ZIMAN_RESOURCE_PATH` unset, `name` is returned exactly as given, unchecked, so a
// program that never sets it behaves exactly as if this function did not exist: whatever it does next
// with the path (`read_text`, `exists`, `list_dir`, ...) fails or succeeds precisely as it always did.
// With it set and no listed directory having `name`, `None`. `properties.load` and `migrate.run` both
// resolve their own file/directory argument through this, so `application.properties` and a migrations
// directory follow the same convention as anything else that calls this directly.
pub fn resolve(name: string) -> Option<string> {
    val search = os.getenv("ZIMAN_RESOURCE_PATH")
    return switch search {
        None { Some(name) }
        Some(s) {
            for dir in split(s, ":") {
                val candidate = path_join(dir, name)
                if exists(candidate) {
                    return Some(candidate)
                }
            }
            None
        }
    }
}

// ---------------------------------------------------------------- changing

// Deletes a file or an *empty* directory.
native fn remove_raw(path: string) -> Result<unit, string>

pub fn remove(path: string) -> Result<unit, FsError> {
    val r = remove_raw(path)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// Creates one directory; its parent must exist and it must not already exist.
native fn make_dir_raw(path: string) -> Result<unit, string>

pub fn make_dir(path: string) -> Result<unit, FsError> {
    val r = make_dir_raw(path)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// Creates a directory and any missing parents (like `mkdir -p`); `Ok(unit)` if it already
// exists as a directory.
native fn make_dirs_raw(path: string) -> Result<unit, string>

pub fn make_dirs(path: string) -> Result<unit, FsError> {
    val r = make_dirs_raw(path)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// Moves or renames `from` to `to`, replacing `to` if it is a file.
native fn rename_raw(from: string, to: string) -> Result<unit, string>

pub fn rename(from: string, to: string) -> Result<unit, FsError> {
    val r = rename_raw(from, to)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// Copies a file's contents (not its permissions) to `to`, replacing it. `Ok(bytes copied)`.
native fn copy_file_raw(from: string, to: string) -> Result<int, string>

pub fn copy_file(from: string, to: string) -> Result<int, FsError> {
    val r = copy_file_raw(from, to)
    if Err(e) = r {
        return err(fs_error_from_raw(e))
    }
    return ok(unwrap(r))
}

// ---------------------------------------------------------------- paths
//
// Pure string helpers using "/" as the separator; they never touch the filesystem.

// Joins path pieces with single slashes: `path_join("a/", "/b", "c.txt")` is "a/b/c.txt". A
// piece that starts with "/" after the first one is treated as relative, not as a new root.
pub fn path_join(pieces: variadic string) -> string {
    val out = sb_new()
    var first = true
    // Whether what has been appended so far ends in "/", tracked rather than rediscovered. This
    // used to call `sb_to_string(out)` on every piece purely to look at its last character, which
    // copies the whole accumulated path each time: measurably superlinear past a few thousand
    // pieces (0.02s, 0.04s, 0.09s, 0.35s at 2,000 to 16,000), and the shape `--lint` now reports
    // (docs/reviews/tasks.md F84). A real path has a handful of pieces, so this was never a
    // practical cost -- it is fixed because the library is the code people read for the idiom.
    var ends_with_slash = false
    for piece in pieces {
        if len(piece) == 0 {
            continue
        }
        val appended = if first {
            sb_append(out, piece)
            first = false
            piece
        } else {
            val right = if is_char_at(piece, 0, "/") { substring(piece, 1, len(piece)) } else { piece }
            sb_append(out, if ends_with_slash { "" } else { "/" }, right)
            right
        }
        // An empty `right` leaves the separator as the last character, which is itself a "/".
        ends_with_slash = if len(appended) == 0 { !first } else { is_char_at(appended, len(appended) - 1, "/") }
    }
    return sb_to_string(out)
}

// The last segment of a path: `file_name("a/b/c.txt")` is "c.txt". A trailing slash is ignored.
pub fn file_name(path: string) -> string {
    val trimmed = if len(path) > 1 && is_char_at(path, len(path) - 1, "/") {
        substring(path, 0, len(path) - 1)
    } else {
        path
    }
    val at = last_index_of(trimmed, "/")
    return if at < 0 { trimmed } else { substring(trimmed, at + 1, len(trimmed)) }
}

// Everything before the last segment: `parent_dir("a/b/c.txt")` is "a/b"; "." for a bare name,
// "/" for a top-level absolute path.
pub fn parent_dir(path: string) -> string {
    val trimmed = if len(path) > 1 && is_char_at(path, len(path) - 1, "/") {
        substring(path, 0, len(path) - 1)
    } else {
        path
    }
    val at = last_index_of(trimmed, "/")
    if at < 0 {
        return "."
    }
    return if at == 0 { "/" } else { substring(trimmed, 0, at) }
}

// The extension of the last segment including the dot, or "" if it has none:
// `extension("a/b.tar.gz")` is ".gz"; `extension(".bashrc")` and `extension("a/b")` are "".
pub fn extension(path: string) -> string {
    val name = file_name(path)
    val at = last_index_of(name, ".")
    return if at <= 0 { "" } else { substring(name, at, len(name)) }
}
