// xml.zm -- XML 1.0 as a document tree: a reader, a writer, and a small path finder.
// Written in pure Ziman, like `toml` and `yaml`; `json` and `csv` are native because they
// sit on hot paths (a JSON body on every request), and XML does not.
//
// Marked `#![experimental]` below: new, and no Ziman program depends on it yet.
//
// Unlike `yaml` and `toml`, this does **not** parse into a `Json` tree, because XML does not
// fit one. `<p>Take <b>2</b> tablets</p>` interleaves text and elements, so children are an
// ordered list rather than a map; `<dose value="2"/>` and `<dose><value>2</value></dose>` are
// different documents, so attributes are not children; and a name's identity is its namespace
// URI, not its prefix. Flattening any of that into `Json` is the usual way an XML library
// becomes a one-way street -- it can write a document it cannot read back.
//
// ## What it will not do, on purpose
//
// **There is no DTD.** `<!DOCTYPE ...>` is a parse error, not an option that defaults to off.
// That single decision removes the billion-laughs entity expansion (a kilobyte of input
// becoming gigabytes of output) and XXE (`<!ENTITY x SYSTEM "file:///etc/passwd">`, and the
// same trick aimed at an internal URL) by construction rather than by configuration, so there
// is no flag for a caller to turn off and no default for a future refactor to get wrong. The
// five predefined entities and numeric character references still work: those are XML itself,
// not DTD. Nothing here reads a file or opens a socket.
//
// The other limits are in `XmlLimits` and apply to every parse: input size, nesting depth and
// attribute count. A byte cap alone would not be enough -- 100 KB of `<a>` is fifty thousand
// levels deep -- so depth is counted separately, at the same 512 `parse` already uses.
//
// Also absent, and not planned: XSD or any other validation, XPath (`find` below is child-name
// steps, nothing more), and XML 1.1.
//
// ## Namespaces
//
// `xmlns` and `xmlns:p` stay in `attributes` where they were written, *and* are used to resolve
// names while reading, so `Name.namespace` holds the URI a name resolved to. An unprefixed
// attribute is in no namespace, which is what the spec says and what trips people up -- a
// default `xmlns` applies to elements only.
//
// The writer does not consult `namespace`: it emits `prefix:local` when a prefix is set and
// `local` otherwise, and never invents a declaration. So a tree that came from `parse`
// writes back unchanged, and a tree built by hand needs its `xmlns` written as an ordinary
// attribute, once, on the element that scopes it. `namespace` is what `==` and `find_ns`
// compare; `prefix` is only ever a hint to the writer.

#![experimental]
use locale

// Case folding here is **protocol folding**, so it names the invariant locale rather than taking
// whatever a program set as its default: Turkish folds `I` to `ı`, and a header name, a hex digit, a
// media type or an identifier compared under a user's language is a bug. Hoisted to a `val` because
// some of these sit in per-character loops and `locale.root()` is a call.
val invariant: Locale = locale.root()

// Everything XML 1.0 cannot represent at all: the C0 controls other than tab, newline and
// carriage return. There is no escape for them -- `&#0;` is itself illegal -- so they are an
// error on both sides rather than something silently dropped.
val max_code_point = 1114111
val surrogate_start = 55296
val surrogate_end = 57343
val hex_digits = "0123456789abcdef"

// ------------------------------------------------------------------ the model

// An expanded name: the namespace URI it resolved to (None when in no namespace), the local
// part, and the prefix as written. Two names are the same name when `namespace` and `local`
// match, whatever the prefixes; `same_name` says so, since `==` on the struct would compare
// the prefix too.
pub struct Name {
    namespace: Option<string>
    local: string
    prefix: Option<string>
}

pub struct Attribute {
    name: Name
    value: string
}

// One piece of an element's content. `CData` is kept apart from `Text` so a document survives
// a read/write round trip; the two mean the same thing to a reader of the data.
// A `<?target data?>` processing instruction. `data` is everything after the target, verbatim,
// and is "" when there is none.
pub struct Instruction {
    target: string
    data: string
}

pub enum Node {
    Element(Element)
    Text(string)
    CData(string)
    Comment(string)
    ProcessingInstruction(Instruction)
}

pub struct Element {
    name: Name
    attributes: [Attribute]
    children: [Node]
}

// The `<?xml ... ?>` declaration, when the document has one.
pub struct Declaration {
    version: string
    encoding: Option<string>
    standalone: Option<bool>
}

// `prolog` and `epilog` are the comments and processing instructions before and after the root
// element, kept so that writing a parsed document back gives the same text.
pub struct Document {
    declaration: Option<Declaration>
    prolog: [Node]
    root: Element
    epilog: [Node]
}

// The reader's limits. `xml_limits()` has the defaults; pass your own to `parse`.
// There is deliberately no `allow_doctype`: see the module header.
pub struct XmlLimits {
    max_bytes: int
    max_depth: int
    max_attributes: int
}

// 16 MiB, 512 levels, 256 attributes per element. The depth matches `parse`'s, so the two
// readers behave the same way on input built to exhaust a stack.
pub fn xml_limits() -> XmlLimits {
    return XmlLimits { max_bytes: 16777216, max_depth: 512, max_attributes: 256 }
}

// ------------------------------------------------------------------ building

// A name in no namespace: what you want for an ordinary document.
pub fn name(local: string) -> Name {
    return Name { namespace: Option<string>.None, local: local, prefix: Option<string>.None }
}

// A name in namespace `uri` written with `prefix`. Pass "" for `prefix` to write it unprefixed,
// which is right when the element is covered by a default `xmlns`.
pub fn ns_name(uri: string, prefix: string, local: string) -> Name {
    val p = if prefix == "" { Option<string>.None } else { Option<string>.Some(prefix) }
    return Name { namespace: Option<string>.Some(uri), local: local, prefix: p }
}

// An element with attributes and children.
pub fn element(n: Name, attributes: [Attribute], children: [Node]) -> Element {
    return Element { name: n, attributes: attributes, children: children }
}

// An empty element: `<name/>`.
pub fn empty(local: string) -> Element {
    return Element { name: name(local), attributes: [], children: [] }
}

// An element holding one run of text: `<name>text</name>`. Empty text gives an element with no
// children at all rather than one holding an empty `Text`, because that is what reading
// `<name></name>` back produces -- so a tree built here and the same tree parsed from its own
// output compare equal, which they would not if one carried a child the other never makes.
pub fn text_element(local: string, content: string) -> Element {
    if content == "" {
        return Element { name: name(local), attributes: [], children: [] }
    }
    return Element { name: name(local), attributes: [], children: [Node.Text(content)] }
}

// A child element holding `value`, or nothing at all when there is no value -- the shape of
// almost every field in an exported record, where an absent one is left out rather than written
// empty. Pair it with `filter_present`, which drops the nothings:
//
//     xml.element(xml.name("patient"), [], filter_present<Node>(
//         xml.opt_element("firstName", p.first_name),
//         xml.opt_element("dateOfBirth", p.date_of_birth)
//     ))
pub fn opt_element(local: string, value: Option<string>) -> Option<Node> {
    return switch value {
        Some(v) { Option<Node>.Some(Node.Element(text_element(local, v))) }
        None { Option<Node>.None }
    }
}

// `opt_element` for a value that is always there, so a required field and an optional one can
// stand side by side in one `filter_present` list instead of the required one being lifted into
// an `Option` by hand at the call site.
pub fn req_element(local: string, value: string) -> Option<Node> {
    return Option<Node>.Some(Node.Element(text_element(local, value)))
}

pub fn attribute(local: string, value: string) -> Attribute {
    return Attribute { name: name(local), value: value }
}

// A document with no declaration and nothing around the root. `format` writes a
// `<?xml version="1.0" encoding="UTF-8"?>` line for a document whose declaration is None, so
// the output is still a well-formed file.
pub fn document(root: Element) -> Document {
    return Document {
        declaration: Option<Declaration>.None,
        prolog: [],
        root: root,
        epilog: []
    }
}

// ------------------------------------------------------------------ reading a tree

// Whether two names are the same name: same namespace, same local part, prefixes ignored.
pub fn same_name(a: Name, b: Name) -> bool {
    if a.local != b.local {
        return false
    }
    return switch a.namespace {
        Some(x) {
            switch b.namespace {
                Some(y) { x == y }
                None { false }
            }
        }
        None {
            switch b.namespace {
                Some(_) { false }
                None { true }
            }
        }
    }
}

// The value of attribute `local` (in no namespace), or None.
pub fn attr(e: Element, local: string) -> Option<string> {
    for a in e.attributes {
        if a.name.local == local {
            if None = a.name.namespace {
                return Option<string>.Some(a.value)
            }
        }
    }
    return Option<string>.None
}

// The value of the attribute named `local` in namespace `uri`, or None.
pub fn attr_ns(e: Element, uri: string, local: string) -> Option<string> {
    for a in e.attributes {
        if a.name.local == local {
            if Some(u) = a.name.namespace {
                if u == uri {
                    return Option<string>.Some(a.value)
                }
            }
        }
    }
    return Option<string>.None
}

// `attr`, or `fallback` when the attribute is absent.
pub fn attr_or(e: Element, local: string, fallback: string) -> string {
    return switch attr(e, local) {
        Some(v) { v }
        None { fallback }
    }
}

// Every child element, in order.
pub fn children(e: Element) -> [Element] {
    var out: [Element] = []
    for child in e.children {
        if Element(sub) = child {
            out = push(out, sub)
        }
    }
    return out
}

// The child elements with local name `local`, in order.
pub fn children_named(e: Element, local: string) -> [Element] {
    var out: [Element] = []
    for child in e.children {
        if Element(sub) = child {
            if sub.name.local == local {
                out = push(out, sub)
            }
        }
    }
    return out
}

// The first child element with local name `local`, or None.
pub fn child(e: Element, local: string) -> Option<Element> {
    for c in e.children {
        if Element(sub) = c {
            if sub.name.local == local {
                return Option<Element>.Some(sub)
            }
        }
    }
    return Option<Element>.None
}

// All the text under `e`, with its elements flattened away and comments and processing
// instructions left out: the usual way to read a leaf whose content may be split by a CDATA
// section or an entity. `text_of(<p>Take <b>2</b></p>)` is "Take 2".
pub fn text_of(e: Element) -> string {
    val out = mutable_string_new()
    gather_text(e, out)
    return snapshot(out)
}

fn gather_text(e: Element, out: MutableString) {
    for c in e.children {
        switch c {
            Text(t) { append(out, t) }
            CData(t) { append(out, t) }
            Element(sub) { gather_text(sub, out) }
            Comment(_) {}
            ProcessingInstruction(_) {}
        }
    }
}

// The elements reached by following `path`, a `/`-separated list of child steps starting at
// `e`'s children: `find(root, "component/section/entry")`. A step of `*` matches any element.
// Steps match the **local** name, ignoring namespaces, which is what makes a namespace-heavy
// document (a CDA, a SOAP envelope) readable without spelling out a URI at every step; use
// `find_ns` when a document mixes vocabularies and the distinction matters. An empty path
// returns `[e]`, an unmatched step an empty array -- never an error, so a chain of `find`s on a
// document shaped differently than expected gives nothing rather than blowing up.
pub fn find(e: Element, path: string) -> [Element] {
    if path == "" {
        return [e]
    }
    var current = [e]
    for step in split(path, "/") {
        if step != "" {
            var next: [Element] = []
            for parent in current {
                for c in parent.children {
                    if Element(sub) = c {
                        if step == "*" || sub.name.local == step {
                            next = push(next, sub)
                        }
                    }
                }
            }
            current = next
        }
    }
    return current
}

// `find`, restricted to elements in namespace `uri`.
pub fn find_ns(e: Element, uri: string, path: string) -> [Element] {
    var out: [Element] = []
    for found in find(e, path) {
        if Some(u) = found.name.namespace {
            if u == uri {
                out = push(out, found)
            }
        }
    }
    return out
}

// The first element `find` reaches, or None.
pub fn find_first(e: Element, path: string) -> Option<Element> {
    val all = find(e, path)
    if len(all) == 0 {
        return Option<Element>.None
    }
    return Option<Element>.Some(all[0])
}

// ------------------------------------------------------------------ reading

struct PStr {
    text: string
    next: int
}

struct PNode {
    node: Node
    next: int
}

struct PElem {
    elem: Element
    next: int
}

struct RawAttr {
    qname: string
    value: string
    at: int
}

struct PAttrs {
    attrs: [RawAttr]
    next: int
}

// **The parser reads a decoded character array, not the string.** Every function below took
// `(s: string, pos: int)` and reached `pos` with `char_at`, which walks from the start of the
// string unless the text is all-ASCII -- so threading a character position over a whole document
// was quadratic *in the document*. Measured: 40 KB of CJK XML took 2.2 s, with 69% of a profile in
// `char_at`, `is_char_at` and `substring`. `parse` decodes once and these four helpers are
// what the string accessors were.

// `cs[p]` carrying `is_char_at`'s bounds check: false rather than an error past the end, which
// every scanner here relies on to look ahead.
fn at_is(cs: [string], p: int, c: string) -> bool {
    return p >= 0 && p < len(cs) && cs[p] == c
}

// The text of characters `a` up to `b` -- what `substring(s, a, b)` answered. `concat` over one
// array argument spreads, so it is a single allocation of the final size.
fn span_text(cs: [string], a: int, b: int) -> string {
    return concat(slice<string>(cs, a, b))
}

// Whether the document reads `needle` at `p`. This replaces `starts_with(substring(s, p, len(s)),
// needle)`, which built a copy of everything from `p` to the end of the document on every call just
// to look at two characters.
fn at_starts(cs: [string], p: int, needle: [string]) -> bool {
    if p < 0 || p + len(needle) > len(cs) {
        return false
    }
    var i = 0
    while i < len(needle) {
        if cs[p + i] != needle[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// The character index of the first `needle` at or after `from`, or -1 -- `index_of(s, needle, from)`
// over the array. Naive, as `index_of` itself is.
fn find_from(cs: [string], needle: [string], from: int) -> int {
    var p = if from < 0 { 0 } else { from }
    while p + len(needle) <= len(cs) {
        if at_starts(cs, p, needle) {
            return p
        }
        p = p + 1
    }
    return -1
}

// The needles the scanners look for, built once at module level rather than per call: a `[string]`
// literal in an argument position would allocate on every comparison.
val tok_semicolon: [string] = [";"]
val tok_comment_end: [string] = ["-", "-", ">"]
val tok_cdata_end: [string] = ["]", "]", ">"]
val tok_pi_end: [string] = ["?", ">"]
val tok_empty_end: [string] = ["/", ">"]
val tok_bang: [string] = ["<", "!"]
val tok_pi_start: [string] = ["<", "?"]
val tok_close: [string] = ["<", "/"]
val tok_comment_start: [string] = ["<", "!", "-", "-"]
val tok_cdata_start: [string] = ["<", "!", "[", "C", "D", "A", "T", "A", "["]
val tok_doctype: [string] = ["<", "!", "D", "O", "C", "T", "Y", "P", "E"]

fn line_of(cs: [string], p: int) -> int {
    var line = 1
    var i = 0
    while i < p && i < len(cs) {
        if at_is(cs, i, "\n") {
            line = line + 1
        }
        i = i + 1
    }
    return line
}

fn fail(cs: [string], p: int, message: string) -> string {
    return prelude.format("line {}: {}", line_of(cs, p), message)
}

fn is_space_at(cs: [string], p: int) -> bool {
    return at_is(cs, p, " ") || at_is(cs, p, "\t") ||
        at_is(cs, p, "\n") || at_is(cs, p, "\r")
}

fn skip_space(cs: [string], pos: int) -> int {
    var p = pos
    while p < len(cs) && is_space_at(cs, p) {
        p = p + 1
    }
    return p
}

// XML names: ASCII letters, `_` and `:` to start, plus digits, `.` and `-` after. Any byte of
// 0x80 and up is accepted so that a name written in UTF-8 goes through; this is more permissive
// than the spec's code-point ranges, which would reject a handful of characters this lets by.

fn is_name_start(cs: [string], p: int) -> bool {
    if p >= len(cs) {
        return false
    }
    val c = cs[p]
    if index_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_:", c, 0) >= 0 {
        return true
    }
    // Any character outside ASCII is a name character, which is `byte_len(c) > 1` -- the same
    // question the old `to_bytes(c)[0] >= 128` asked of the lead byte, without the allocation.
    return byte_len(c) > 1
}

fn is_name_char(cs: [string], p: int) -> bool {
    if is_name_start(cs, p) {
        return true
    }
    if p >= len(cs) {
        return false
    }
    val c = cs[p]
    return index_of("0123456789.-", c, 0) >= 0
}

fn read_name(cs: [string], pos: int) -> Result<PStr, string> {
    if !is_name_start(cs, pos) {
        return err(fail(cs, pos, "expected a name"))
    }
    var p = pos + 1
    while is_name_char(cs, p) {
        p = p + 1
    }
    return ok(PStr { text: span_text(cs, pos, p), next: p })
}

// A character XML cannot carry at all: a C0 control other than tab, newline or return. There is
// no escape for these, so they are refused on the way in rather than written back out broken.
// Whether a code point is one XML 1.0 cannot represent in any form: a control character other than
// tab, newline or return. This is the form a numeric character reference needs -- `&#11;` hands
// `read_reference` a real code point, not a character.
fn illegal_code(code: int) -> bool {
    return code < 32 && code != 9 && code != 10 && code != 13
}

// The same question asked of a *character*, which is what every scanner and writer here has.
// Equivalent to `illegal_code` by construction: each of those code points is one byte in UTF-8, so
// "one byte and below space" is the same set, and a multi-byte character answers false without
// being decoded.
//
// **This read `to_bytes(char_at(s, p))[0]` until 2026-10-23**, which allocated a one-element array
// *per character scanned* -- four of its five call sites sit in a per-character loop -- and compared
// a UTF-8 *lead byte* against the control range rather than a code point. That was right only by
// coincidence, every multi-byte lead byte being at least 0xC2 and so well clear of 32. Nothing
// depends on that coincidence now.
fn illegal_char(c: string) -> bool {
    return byte_len(c) == 1 && compare(c, " ") < 0 && c != "\t" && c != "\n" && c != "\r"
}

// The code point of a one-byte character, for the two messages that name the offending character by
// number. Only ever reached once, on an error path, so its allocation costs nothing.
fn char_code(c: string) -> int {
    return to_bytes(c)[0] as int
}

fn append_code_point(out: MutableString, cp: int) {
    if cp < 128 {
        append_byte(out, cp as byte)
    } else if cp < 2048 {
        append_byte(out, (192 + cp / 64) as byte, (128 + cp % 64) as byte)
    } else if cp < 65536 {
        append_byte(
            out,
            (224 + cp / 4096) as byte,
            (128 + cp / 64 % 64) as byte,
            (128 + cp % 64) as byte
        )
    } else {
        append_byte(
            out,
            (240 + cp / 262144) as byte,
            (128 + cp / 4096 % 64) as byte,
            (128 + cp / 64 % 64) as byte,
            (128 + cp % 64) as byte
        )
    }
}

// One `&...;`. The five predefined entities and numeric character references are XML itself and
// are expanded; anything else is a reference into a DTD this parser does not have, and saying so
// is better than leaving `&patientName;` in the output looking like text.
fn read_reference(cs: [string], pos: int, out: MutableString) -> Result<int, string> {
    val end = find_from(cs, tok_semicolon, pos)
    if end < 0 {
        return err(fail(cs, pos, "an entity reference with no ';'"))
    }
    val body = span_text(cs, pos + 1, end)
    if body == "lt" {
        append(out, "<")
    } else if body == "gt" {
        append(out, ">")
    } else if body == "amp" {
        append(out, "&")
    } else if body == "quot" {
        append(out, "\"")
    } else if body == "apos" {
        append(out, "'")
    } else if starts_with(body, "#") {
        val cp = try read_char_code(cs, pos, body)
        append_code_point(out, cp)
    } else {
        return err(fail(cs, pos, prelude.format(
            "undefined entity '&{};' -- this parser has no DTD, so only &lt; &gt; &amp; &quot; &apos; and &#...; are defined",
            body
        )))
    }
    return ok(end + 1)
}

fn read_char_code(cs: [string], pos: int, body: string) -> Result<int, string> {
    var digits = substring(body, 1, len(body))
    var base = 10
    if starts_with(digits, "x") || starts_with(digits, "X") {
        digits = substring(digits, 1, len(digits))
        base = 16
    }
    if digits == "" {
        return err(fail(cs, pos, "a character reference with no digits"))
    }
    var value = 0
    var i = 0
    while i < len(digits) {
        val d = index_of(hex_digits, to_lower(char_at(digits, i), invariant), 0)
        if d < 0 || d >= base {
            return err(fail(cs, pos, prelude.format("'&{};' is not a character reference", body)))
        }
        value = value * base + d
        if value > max_code_point {
            return err(fail(cs, pos, prelude.format("character reference '&{};' is out of range", body)))
        }
        i = i + 1
    }
    if value > max_code_point || (value >= surrogate_start && value <= surrogate_end) {
        return err(fail(cs, pos, prelude.format("character reference '&{};' is not a character", body)))
    }
    if illegal_code(value) {
        return err(fail(cs, pos, prelude.format(
            "character reference '&{};' is a control character XML cannot represent",
            body
        )))
    }
    return ok(value)
}

// Character data up to the next `<`. References are expanded; a raw `]]>` is refused because it
// ends a CDATA section and so cannot appear literally in content.

fn read_text(cs: [string], pos: int) -> Result<PStr, string> {
    val out = mutable_string_new()
    var p = pos
    while p < len(cs) && !at_is(cs, p, "<") {
        if at_is(cs, p, "&") {
            p = try read_reference(cs, p, out)
        } else {
            if illegal_char(cs[p]) {
                return err(fail(cs, p, "a control character XML cannot represent"))
            }
            if at_is(cs, p, "]") && at_starts(cs, p, tok_cdata_end) {
                return err(fail(cs, p, "']]>' cannot appear in content; write '&gt;' for the '>'"))
            }
            append(out, cs[p])
            p = p + 1
        }
    }
    return ok(PStr { text: snapshot(out), next: p })
}

fn read_attr_value(cs: [string], pos: int) -> Result<PStr, string> {
    if pos >= len(cs) || (!at_is(cs, pos, "\"") && !at_is(cs, pos, "'")) {
        return err(fail(cs, pos, "an attribute value must be quoted"))
    }
    val quote = cs[pos]
    val out = mutable_string_new()
    var p = pos + 1
    while p < len(cs) {
        if at_is(cs, p, quote) {
            return ok(PStr { text: snapshot(out), next: p + 1 })
        }
        if at_is(cs, p, "<") {
            return err(fail(cs, p, "'<' cannot appear in an attribute value; write '&lt;'"))
        }
        if at_is(cs, p, "&") {
            p = try read_reference(cs, p, out)
        } else {
            if illegal_char(cs[p]) {
                return err(fail(cs, p, "a control character XML cannot represent"))
            }
            append(out, cs[p])
            p = p + 1
        }
    }
    return err(fail(cs, pos, "an attribute value with no closing quote"))
}

val xml_ns = "http://www.w3.org/XML/1998/namespace"
val xmlns_ns = "http://www.w3.org/2000/xmlns/"

// A prefixed name against the namespaces in scope. An unprefixed *attribute* is in no
// namespace however the default `xmlns` stands -- the default applies to elements only, which
// is the one namespace rule nearly everyone gets wrong.

fn resolve(cs: [string], at: int, qname: string, scope: Map<string, string>, is_attr: bool) -> Result<Name, string> {
    val colon = index_of(qname, ":", 0)
    if colon < 0 {
        if is_attr {
            return ok(Name { namespace: Option<string>.None, local: qname, prefix: Option<string>.None })
        }
        return switch get(scope, "") {
            Some(uri) {
                if uri == "" {
                    ok(Name { namespace: Option<string>.None, local: qname, prefix: Option<string>.None })
                } else {
                    ok(Name { namespace: Option<string>.Some(uri), local: qname, prefix: Option<string>.None })
                }
            }
            None { ok(Name { namespace: Option<string>.None, local: qname, prefix: Option<string>.None }) }
        }
    }
    val prefix = substring(qname, 0, colon)
    val local = substring(qname, colon + 1, len(qname))
    if local == "" || index_of(local, ":", 0) >= 0 {
        return err(fail(cs, at, prelude.format("'{}' is not a valid name", qname)))
    }
    if prefix == "xml" {
        return ok(named(xml_ns, prefix, local))
    }
    if prefix == "xmlns" {
        return ok(named(xmlns_ns, prefix, local))
    }
    return switch get(scope, prefix) {
        Some(uri) { ok(named(uri, prefix, local)) }
        None { err(fail(cs, at, prelude.format("undeclared namespace prefix '{}' in '{}'", prefix, qname))) }
    }
}

fn named(uri: string, prefix: string, local: string) -> Name {
    return Name {
        namespace: Option<string>.Some(uri),
        local: local,
        prefix: Option<string>.Some(prefix)
    }
}

// The `xmlns` declarations among `attrs`, layered over the scope they were found in. Maps are
// values here, so an inner element's scope is simply its parent's with its own declarations
// set -- leaving the element restores the outer one with nothing to unwind.
fn extend_scope(scope: Map<string, string>, attrs: [RawAttr]) -> Map<string, string> {
    var declares = false
    for a in attrs {
        if a.qname == "xmlns" || starts_with(a.qname, "xmlns:") {
            declares = true
        }
    }
    if !declares {
        return scope
    }
    val out = mutable_map_new<string, string>()
    for k, v in scope {
        set(out, k, v)
    }
    for a in attrs {
        if a.qname == "xmlns" {
            set(out, "", a.value)
        } else if starts_with(a.qname, "xmlns:") {
            set(out, substring(a.qname, 6, len(a.qname)), a.value)
        }
    }
    return snapshot(out)
}

fn read_attributes(cs: [string], pos: int, limits: XmlLimits) -> Result<PAttrs, string> {
    var attrs: [RawAttr] = []
    var p = pos
    while true {
        val before = p
        p = skip_space(cs, p)
        if p >= len(cs) {
            return err(fail(cs, pos, "a tag that is never closed"))
        }
        if at_is(cs, p, ">") || at_starts(cs, p, tok_empty_end) {
            return ok(PAttrs { attrs: attrs, next: p })
        }
        if p == before {
            return err(fail(cs, p, "expected whitespace before an attribute"))
        }
        val at = p
        val n = try read_name(cs, p)
        p = skip_space(cs, n.next)
        if !at_is(cs, p, "=") {
            return err(fail(cs, p, prelude.format("expected '=' after attribute '{}'", n.text)))
        }
        p = skip_space(cs, p + 1)
        val v = try read_attr_value(cs, p)
        p = v.next
        attrs = push(attrs, RawAttr { qname: n.text, value: v.text, at: at })
        if len(attrs) > limits.max_attributes {
            return err(fail(cs, at, prelude.format(
                "more than {} attributes on one element",
                limits.max_attributes
            )))
        }
    }
    return err(fail(cs, pos, "a tag that is never closed"))
}

fn read_comment(cs: [string], pos: int) -> Result<PStr, string> {
    val end = find_from(cs, tok_comment_end, pos + 4)
    if end < 0 {
        return err(fail(cs, pos, "a comment that is never closed"))
    }
    val body = span_text(cs, pos + 4, end)
    if index_of(body, "--", 0) >= 0 {
        return err(fail(cs, pos, "'--' cannot appear inside a comment"))
    }
    return ok(PStr { text: body, next: end + 3 })
}

fn read_cdata(cs: [string], pos: int) -> Result<PStr, string> {
    val end = find_from(cs, tok_cdata_end, pos + 9)
    if end < 0 {
        return err(fail(cs, pos, "a CDATA section that is never closed"))
    }
    return ok(PStr { text: span_text(cs, pos + 9, end), next: end + 3 })
}

fn read_pi(cs: [string], pos: int) -> Result<PNode, string> {
    val target = try read_name(cs, pos + 2)
    if equals_ignore_case(target.text, "xml", invariant) {
        return err(fail(cs, pos, "'<?xml' is only allowed as the declaration on the first line"))
    }
    val end = find_from(cs, tok_pi_end, target.next)
    if end < 0 {
        return err(fail(cs, pos, "a processing instruction that is never closed"))
    }
    val data = trim(span_text(cs, target.next, end))
    return ok(PNode {
        node: Node.ProcessingInstruction(Instruction { target: target.text, data: data }),
        next: end + 2
    })
}

// `<!...` is a comment, a CDATA section, or a DTD. The last is refused: see the module header.

fn read_bang(cs: [string], pos: int) -> Result<PNode, string> {
    // Tested against the document in place. This built `span_text(cs, pos, len(cs))` first -- a copy
    // of the whole remaining document, per `<!`, to look at four characters. It was free before the
    // parser took characters, `substring` on a string being a view rather than a copy, and that is
    // what made the straight translation 26x slower on ASCII input than the string version.
    if at_starts(cs, pos, tok_comment_start) {
        val c = try read_comment(cs, pos)
        return ok(PNode { node: Node.Comment(c.text), next: c.next })
    }
    if at_starts(cs, pos, tok_cdata_start) {
        val c = try read_cdata(cs, pos)
        return ok(PNode { node: Node.CData(c.text), next: c.next })
    }
    if at_starts(cs, pos, tok_doctype) {
        return err(fail(cs, pos, concat(
            "a DOCTYPE is not accepted: this parser has no DTD at all, which is what rules out ",
            "entity-expansion and external-entity attacks. Remove the DOCTYPE and the document will parse."
        )))
    }
    return err(fail(cs, pos, "expected a comment or a CDATA section after '<!'"))
}

fn read_element(
    cs: [string],
    pos: int,
    scope: Map<string, string>,
    limits: XmlLimits,
    depth: int
) -> Result<PElem, string> {
    if depth > limits.max_depth {
        return err(fail(cs, pos, prelude.format("nesting deeper than {} levels", limits.max_depth)))
    }
    val open = try read_name(cs, pos + 1)
    val raw = try read_attributes(cs, open.next, limits)
    val inner = extend_scope(scope, raw.attrs)

    val elem_name = try resolve(cs, pos, open.text, inner, false)
    var attributes: [Attribute] = []
    for a in raw.attrs {
        val an = try resolve(cs, a.at, a.qname, inner, true)
        for seen in attributes {
            if same_name(seen.name, an) {
                return err(fail(cs, a.at, prelude.format("attribute '{}' appears twice", a.qname)))
            }
        }
        attributes = push(attributes, Attribute { name: an, value: a.value })
    }

    var p = raw.next
    if at_starts(cs, p, tok_empty_end) {
        return ok(PElem {
            elem: Element { name: elem_name, attributes: attributes, children: [] },
            next: p + 2
        })
    }
    p = p + 1
    var kids: [Node] = []
    while true {
        if p >= len(cs) {
            return err(fail(cs, pos, prelude.format("<{}> is never closed", open.text)))
        }
        if at_is(cs, p, "<") {
            // In place, for the same reason as read_bang above: this copied the rest of the
            // document once per child node.
            if at_starts(cs, p, tok_close) {
                val close = try read_name(cs, p + 2)
                if close.text != open.text {
                    return err(fail(cs, p, prelude.format(
                        "</{}> closes <{}>",
                        close.text,
                        open.text
                    )))
                }
                val after = skip_space(cs, close.next)
                if !at_is(cs, after, ">") {
                    return err(fail(cs, after, prelude.format("expected '>' to end </{}>", close.text)))
                }
                return ok(PElem {
                    elem: Element { name: elem_name, attributes: attributes, children: kids },
                    next: after + 1
                })
            }
            if at_starts(cs, p, tok_bang) {
                val n = try read_bang(cs, p)
                kids = push(kids, n.node)
                p = n.next
            } else if at_starts(cs, p, tok_pi_start) {
                val n = try read_pi(cs, p)
                kids = push(kids, n.node)
                p = n.next
            } else {
                val sub = try read_element(cs, p, inner, limits, depth + 1)
                kids = push(kids, Node.Element(sub.elem))
                p = sub.next
            }
        } else {
            val t = try read_text(cs, p)
            if t.text != "" {
                kids = push(kids, Node.Text(t.text))
            }
            p = t.next
        }
    }
    return err(fail(cs, pos, prelude.format("<{}> is never closed", open.text)))
}

val tok_decl_start: [string] = ["<", "?", "x", "m", "l"]

fn read_declaration(cs: [string]) -> Result<Option<Declaration>, string> {
    if !at_starts(cs, 0, tok_decl_start) {
        return ok(Option<Declaration>.None)
    }
    if len(cs) > 5 && is_name_char(cs, 5) {
        return ok(Option<Declaration>.None)
    }
    val end = find_from(cs, tok_pi_end, 0)
    if end < 0 {
        return err(fail(cs, 0, "an XML declaration that is never closed"))
    }
    val limits = xml_limits()
    // The declaration re-read as an element, so one attribute reader serves both. `concat` of two
    // arrays rather than of two strings now, the parser taking characters.
    val raw = try read_attributes(concat(slice<string>(cs, 0, end), [">"]), 5, limits)
    var version = ""
    var encoding = Option<string>.None
    var standalone = Option<bool>.None
    for a in raw.attrs {
        if a.qname == "version" {
            version = a.value
        } else if a.qname == "encoding" {
            encoding = Option<string>.Some(a.value)
        } else if a.qname == "standalone" {
            if a.value == "yes" {
                standalone = Option<bool>.Some(true)
            } else if a.value == "no" {
                standalone = Option<bool>.Some(false)
            } else {
                return err(fail(cs, 0, "standalone must be 'yes' or 'no'"))
            }
        } else {
            return err(fail(cs, 0, prelude.format("'{}' is not part of an XML declaration", a.qname)))
        }
    }
    if version == "" {
        return err(fail(cs, 0, "an XML declaration must state a version"))
    }
    if version != "1.0" {
        return err(fail(cs, 0, prelude.format("XML {} is not supported; this reader is XML 1.0", version)))
    }
    if Some(enc) = encoding {
        if !equals_ignore_case(enc, "utf-8", invariant) && !equals_ignore_case(enc, "utf8", invariant) {
            return err(fail(cs, 0, prelude.format(
                "encoding '{}' is not supported; this reader reads UTF-8, and guessing would misread the text",
                enc
            )))
        }
    }
    return ok(Option<Declaration>.Some(Declaration {
        version: version,
        encoding: encoding,
        standalone: standalone
    }))
}

// A UTF-8 byte order mark, which an editor on Windows may have put there. It is not part of
// the document, so it is dropped before parsing rather than becoming text before the root.
fn has_bom(s: string) -> bool {
    if byte_len(s) < 3 {
        return false
    }
    // The first *character*, whose bytes are then compared -- not the first three characters, which
    // is what `substring(s, 0, 3)` meant once `substring` started counting them (2026-10-23) and
    // which could read past the end of a short multi-byte document. A BOM is one character of three
    // bytes, so one character is exactly the right amount to look at, and `byte_len >= 3` above
    // guarantees there is one.
    val b = to_bytes(substring(s, 0, 1))
    return len(b) == 3 && (b[0] as int) == 239 && (b[1] as int) == 187 && (b[2] as int) == 191
}

// XML normalises every line ending to a single newline before anything else looks at the text,
// so a document written on Windows and one written on Unix parse to the same tree.
fn normalise_newlines(s: string) -> string {
    if index_of(s, "\r", 0) < 0 {
        return s
    }
    return replace(replace(s, "\r\n", "\n"), "\r", "\n")
}

// Parses one XML document with the default limits (`xml_limits()`): at most 16 MiB, 512 levels
// of nesting and 256 attributes on an element, and no DTD -- a `<!DOCTYPE>` is an error whose
// message says why. An Err carries `line N: ...`.
//
// A leading byte order mark is ignored. Line endings are normalised to `\n`. Namespaces are
// resolved as the document is read, so `Name.namespace` holds a URI and `find`/`same_name`
// compare on it. Text that `&...;` references expand to is already expanded in `Node.Text`;
// only the five predefined entities and numeric character references exist, there being no DTD
// to define any others.
pub fn parse(text: string) -> Result<Document, string> {
    return parse(text, xml_limits())
}

// `parse` with limits of your own. Tightening `max_bytes` is the usual reason -- a document
// arriving from somewhere you do not control has a size you are willing to spend memory on, and
// it is smaller than 16 MiB.
pub fn parse(text: string, limits: XmlLimits) -> Result<Document, string> {
    if byte_len(text) > limits.max_bytes {
        return err(prelude.format(
            "the document is {} bytes, over the {}-byte limit",
            byte_len(text),
            limits.max_bytes
        ))
    }
    var s = normalise_newlines(text)
    if has_bom(s) {
        s = substring(s, 1, len(s))  // one character, not its three bytes -- see has_bom
    }
    // **Decoded once here, and indexed as an array by every function below.** See the helpers above
    // `line_of`: reaching position `p` with `char_at` walks from the start of the string unless the
    // text is all-ASCII, so threading a character position over a whole document was quadratic in
    // it -- 40 KB of CJK XML took 2.2 s. `normalise_newlines` and `has_bom` stay on the string,
    // both running once over the whole of it before this point.
    val cs = chars(s)
    val decl = try read_declaration(cs)
    var p = 0
    if Some(_) = decl {
        p = find_from(cs, tok_pi_end, 0) + 2
    }

    var prolog: [Node] = []
    var root = Option<Element>.None
    var epilog: [Node] = []
    while true {
        p = skip_space(cs, p)
        if p >= len(cs) {
            break
        }
        if !at_is(cs, p, "<") {
            return err(fail(cs, p, "text is not allowed outside the root element"))
        }
        // Three prefix tests against the document in place. This built `substring(s, p, len(s))`
        // first -- a copy of everything from `p` to the end of the document, per iteration, to look
        // at two characters.
        if at_starts(cs, p, tok_bang) {
            val n = try read_bang(cs, p)
            if CData(_) = n.node {
                return err(fail(cs, p, "a CDATA section is not allowed outside the root element"))
            }
            if None = root {
                prolog = push(prolog, n.node)
            } else {
                epilog = push(epilog, n.node)
            }
            p = n.next
        } else if at_starts(cs, p, tok_pi_start) {
            val n = try read_pi(cs, p)
            if None = root {
                prolog = push(prolog, n.node)
            } else {
                epilog = push(epilog, n.node)
            }
            p = n.next
        } else if at_starts(cs, p, tok_close) {
            return err(fail(cs, p, "a closing tag with nothing open"))
        } else {
            if Some(_) = root {
                return err(fail(cs, p, "a second root element: an XML document has exactly one"))
            }
            val e = try read_element(cs, p, Map<string, string> {}, limits, 1)
            root = Option<Element>.Some(e.elem)
            p = e.next
        }
    }
    return switch root {
        Some(r) { ok(Document { declaration: decl, prolog: prolog, root: r, epilog: epilog }) }
        None { err("the document has no root element") }
    }
}

// `parse` over the bytes of a document -- what `fs.read_bytes` gives, or an HTTP body. The
// bytes must be UTF-8; invalid UTF-8 is an Err rather than a tree with broken text in it.
pub fn parse(data: [byte]) -> Result<Document, string> {
    return parse(data, xml_limits())
}

pub fn parse(data: [byte], limits: XmlLimits) -> Result<Document, string> {
    if len(data) > limits.max_bytes {
        return err(prelude.format(
            "the document is {} bytes, over the {}-byte limit",
            len(data),
            limits.max_bytes
        ))
    }
    return switch bytes_to_string(data) {
        Ok(s) { parse(s, limits) }
        Err(e) { err(prelude.format("the document is not valid UTF-8: {}", e)) }
    }
}

// ------------------------------------------------------------------ writing

// Character data, escaped. `>` does not strictly need escaping outside `]]>`, but escaping it
// always costs nothing and removes a case where correctness depends on what came before.
fn escape_text(s: string, out: MutableString) -> Result<bool, string> {
    // Walked with `for`, not indexed with `char_at`: this only ever moves forward, and indexing a
    // non-ASCII string by character walks from its start, so the indexed form was quadratic in the
    // length of a single text node.
    for c in chars(s) {
        if illegal_char(c) {
            val code = char_code(c)
            return err(prelude.format(
                "the text contains character {}, which XML 1.0 cannot represent in any form (there is no '&#{};')",
                code,
                code
            ))
        }
        if c == "&" {
            append(out, "&amp;")
        } else if c == "<" {
            append(out, "&lt;")
        } else if c == ">" {
            append(out, "&gt;")
        } else {
            append(out, c)
        }
    }
    return ok(true)
}

// An attribute value, escaped and written in double quotes. Tab, newline and return are written
// as character references: a reader normalises a literal one to a space, so leaving them raw
// would quietly change the value on the way back in.
fn escape_attr(s: string, out: MutableString) -> Result<bool, string> {
    for c in chars(s) {  // see escape_text
        if illegal_char(c) {
            return err(prelude.format(
                "an attribute value contains character {}, which XML 1.0 cannot represent",
                char_code(c)
            ))
        }
        if c == "&" {
            append(out, "&amp;")
        } else if c == "<" {
            append(out, "&lt;")
        } else if c == ">" {
            append(out, "&gt;")
        } else if c == "\"" {
            append(out, "&quot;")
        } else if c == "\t" {
            append(out, "&#9;")
        } else if c == "\n" {
            append(out, "&#10;")
        } else if c == "\r" {
            append(out, "&#13;")
        } else {
            append(out, c)
        }
    }
    return ok(true)
}

// Whether `n` is a name XML would accept, asked on the way *out*: a `Name` built by hand can hold
// anything, and writing an invalid one would produce a document this reader would refuse.
//
// Decoded like the parser's own input, the two name predicates taking characters. A name is a few
// characters, so the array costs nothing worth naming here.
fn valid_name(n: string) -> bool {
    if n == "" {
        return false
    }
    val cn = chars(n)
    if !is_name_start(cn, 0) {
        return false
    }
    var i = 1
    while i < len(cn) {
        if !is_name_char(cn, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// A name as it is written: `prefix:local`, or `local` when there is no prefix. The namespace URI
// is not consulted -- see the module header.
fn write_name(n: Name, out: MutableString) -> Result<bool, string> {
    if !valid_name(n.local) {
        return err(prelude.format("'{}' is not a valid XML name", n.local))
    }
    if Some(p) = n.prefix {
        if !valid_name(p) {
            return err(prelude.format("'{}' is not a valid namespace prefix", p))
        }
        append(out, p, ":")
    }
    append(out, n.local)
    return ok(true)
}

fn write_attributes(e: Element, out: MutableString) -> Result<bool, string> {
    for a in e.attributes {
        append(out, " ")
        val _ = try write_name(a.name, out)
        append(out, "=\"")
        val _ = try escape_attr(a.value, out)
        append(out, "\"")
    }
    return ok(true)
}

fn write_comment(body: string, out: MutableString) -> Result<bool, string> {
    if index_of(body, "--", 0) >= 0 {
        return err("a comment cannot contain '--'")
    }
    if ends_with(body, "-") {
        return err("a comment cannot end with '-'")
    }
    append(out, "<!--", body, "-->")
    return ok(true)
}

fn write_cdata(body: string, out: MutableString) -> Result<bool, string> {
    if index_of(body, "]]>", 0) >= 0 {
        return err("a CDATA section cannot contain ']]>'")
    }
    append(out, "<![CDATA[", body, "]]>")
    return ok(true)
}

fn write_pi(pi: Instruction, out: MutableString) -> Result<bool, string> {
    if !valid_name(pi.target) {
        return err(prelude.format("'{}' is not a valid processing-instruction target", pi.target))
    }
    if equals_ignore_case(pi.target, "xml", invariant) {
        return err("'xml' is reserved as a processing-instruction target")
    }
    if index_of(pi.data, "?>", 0) >= 0 {
        return err("a processing instruction cannot contain '?>'")
    }
    if pi.data == "" {
        append(out, "<?", pi.target, "?>")
    } else {
        append(out, "<?", pi.target, " ", pi.data, "?>")
    }
    return ok(true)
}

// Whether an element may be laid out over several lines. Adding a newline and an indent inside
// mixed content changes the text the document carries, so an element holding any text at all is
// written on one line however deep it sits.
fn indentable(e: Element) -> bool {
    if len(e.children) == 0 {
        return false
    }
    for c in e.children {
        switch c {
            Text(_) { return false }
            CData(_) { return false }
            Element(_) {}
            Comment(_) {}
            ProcessingInstruction(_) {}
        }
    }
    return true
}

fn write_node(n: Node, out: MutableString, indent: string, depth: int) -> Result<bool, string> {
    return switch n {
        Text(t) { escape_text(t, out) }
        CData(t) { write_cdata(t, out) }
        Comment(t) { write_comment(t, out) }
        ProcessingInstruction(pi) { write_pi(pi, out) }
        Element(e) { write_element(e, out, indent, depth) }
    }
}

fn write_element(e: Element, out: MutableString, indent: string, depth: int) -> Result<bool, string> {
    append(out, "<")
    val _ = try write_name(e.name, out)
    val _ = try write_attributes(e, out)
    if len(e.children) == 0 {
        append(out, "/>")
        return ok(true)
    }
    append(out, ">")
    val pretty = indent != "" && indentable(e)
    for c in e.children {
        if pretty {
            append(out, "\n")
            var i = 0
            while i <= depth {
                append(out, indent)
                i = i + 1
            }
        }
        val _ = try write_node(c, out, indent, depth + 1)
    }
    if pretty {
        append(out, "\n")
        var i = 0
        while i < depth {
            append(out, indent)
            i = i + 1
        }
    }
    append(out, "</")
    val _ = try write_name(e.name, out)
    append(out, ">")
    return ok(true)
}

fn write_declaration(d: Option<Declaration>, out: MutableString) {
    val decl = switch d {
        Some(x) { x }
        None {
            Declaration {
                version: "1.0",
                encoding: Option<string>.Some("UTF-8"),
                standalone: Option<bool>.None
            }
        }
    }
    append(out, "<?xml version=\"", decl.version, "\"")
    if Some(enc) = decl.encoding {
        append(out, " encoding=\"", enc, "\"")
    }
    if Some(sa) = decl.standalone {
        append(out, " standalone=\"", if sa { "yes" } else { "no" }, "\"")
    }
    append(out, "?>")
}

fn write_document(doc: Document, indent: string) -> Result<string, string> {
    val out = mutable_string_new()
    write_declaration(doc.declaration, out)
    append(out, "\n")
    for n in doc.prolog {
        val _ = try write_node(n, out, indent, 0)
        append(out, "\n")
    }
    val _ = try write_element(doc.root, out, indent, 0)
    append(out, "\n")
    for n in doc.epilog {
        val _ = try write_node(n, out, indent, 0)
        append(out, "\n")
    }
    return ok(snapshot(out))
}

// `doc` as XML text on one line, with a declaration and a trailing newline. A document that came
// from `parse` writes back as the same tree -- reading the output gives an equal `Document`.
//
// Unlike `json.format` this can fail, because XML genuinely cannot carry some strings: a name
// that is not a legal XML name, a comment containing `--`, a CDATA section containing `]]>`, and
// above all text holding a C0 control character, for which XML 1.0 has no escape at all. JSON
// writes that last one as `\u0000`; XML has nothing to write, so refusing is the only honest
// answer. The message says which rule the tree broke. (NUL specifically never gets this far: a
// Ziman `string` cannot hold one, because `bytes_to_string` refuses it at the boundary.)
pub fn format(doc: Document) -> Result<string, string> {
    return write_document(doc, "")
}

// `format` laid out over several lines, each level indented by `indent` (two spaces, a
// tab -- whatever you pass). An element with any text in it stays on one line, because
// indentation inside mixed content would change the text itself.
//
// **This is not round-trip safe, and cannot be.** The indentation between elements is text like
// any other, and nothing in the document says whether it matters -- only a schema this reader
// does not have could say. So reading the pretty output back gives a tree with whitespace in it
// that the original did not have. Use `format` when the bytes have to come back the
// same (a signature, a checksum, a stored document) and this one when a person reads the
// output.
pub fn format(doc: Document, indent: string) -> Result<string, string> {
    return write_document(doc, indent)
}

// `format` as UTF-8 bytes: an HTTP body, or what `fs.write_bytes` takes.
pub fn xml_to_bytes(doc: Document) -> Result<[byte], string> {
    val s = try format(doc)
    return ok(to_bytes(s))
}

// One element as XML text, with no declaration: a fragment to embed in a document being built
// some other way.
pub fn format(e: Element) -> Result<string, string> {
    val out = mutable_string_new()
    val _ = try write_element(e, out, "", 0)
    return ok(snapshot(out))
}
