// yaml.zm -- a strict YAML 1.2 subset on top of `json`: a document is a `Json` tree, so any
// `#[derive(Json)]` type decodes from it with its own `_from_json`. Written in pure Ziman.
//
// Marked `#![experimental]` below: unlike `json`, no real Ziman program depends on this
// module yet, so treat a gap or an edge case as more likely here than elsewhere in the
// library.
//
// Reads: block mappings and sequences (indentation, spaces only), `- key: v` items, flow
// `[a, b]` / `{a: b}` (nesting, multi-line), plain / 'single' / "double" quoted scalars,
// literal `|` and folded `>` block scalars (with `-` and `+` chomping), comments, and an
// optional leading `---`. Scalars follow the YAML 1.2 core schema: `null`/`~`/empty, `true`/`false`,
// integers (`42`, `0x1f`, `0o17`), floats (`1.5`, `2e3`); anything else is a string. `yes`/`no`/`on`/`off`
// are strings. A number with a leading zero (`007`, a zip code) stays a string.
// Not supported, and reported as errors rather than misread: anchors and aliases (`&a`, `*a`),
// tags (`!!str`), the `<<` merge key, complex keys (`? `), multiple documents, tab indentation,
// block-scalar indentation indicators, `.inf` / `.nan`.
//
// Writes block style; a string that would read back as another type (`"42"`, `"true"`, `""`,
// `"null"`) or that needs it is double-quoted, so the output re-reads as the same tree. A
// `JNull` is written `null`; a whole-valued float keeps a `.0`.

// The UTF-16 surrogate block (not valid code points) and the highest code point, for `\u` escapes.
#![experimental]

val surrogate_start = 55296
val surrogate_end = 57343
val max_code_point = 1114111
val hex_chars = "0123456789abcdef"

use json.Json
use json.Number
use json.float_to_json
use json.int_to_json
use locale
use number.float_to_text

// Case folding here is **protocol folding**, so it names the invariant locale rather than taking
// whatever a program set as its default: Turkish folds `I` to `ı`, and a header name, a hex digit, a
// media type or an identifier compared under a user's language is a bug. Hoisted to a `val` because
// some of these sit in per-character loops and `locale.root()` is a call.
val invariant: Locale = locale.root()

// `indent` is where this line's own content starts (after any `- ` lifted off the front, per
// `tokenize`'s own comment). `base` is the indentation of the original source line before any
// lifting, shared by every line lifted out of it -- it is the baseline a block scalar's body
// (and a block-mapping value on its own lines) must be indented past, which can differ from
// `indent` for a lifted line. `cont` marks a line produced by that lifting, sharing `raw` with
// the line it came from.
struct Line {
    no: int
    indent: int
    base: int
    body: string
    raw: string
    cont: bool
    // `body` with its trailing comment removed, computed once here rather than by every reader.
    // `content_of` is called at twelve sites and each one re-ran the whole scan over the line.
    content: string
}

struct NodeRes {
    value: Json
    next: int
}

struct KeyRes {
    key: string
    rest: string
}

struct Scalar {
    value: Json
    next: int
}

fn fail(no: int, message: string) -> string {
    return format("line {}: {}", no, message)
}

fn is_digit_c(c: string) -> bool {
    return byte_len(c) == 1 && index_of("0123456789", c, 0) >= 0
}

fn hex_value(c: string) -> int {
    if byte_len(c) != 1 {
        return -1
    }
    return index_of(hex_chars, to_lower(c, invariant), 0)
}

fn read_hex(cs: [string], pos: int, n: int) -> int {
    if pos + n > len(cs) {
        return -1
    }
    var v = 0
    for i in 0..n {
        val d = hex_value(cs[pos + i])
        if d < 0 {
            return -1
        }
        v = v * 16 + d
    }
    return v
}

fn append_utf8(out: MutableString, cp: int) {
    if cp < 128 {
        append_byte(out, cp as byte)
    } else if cp < 2048 {
        append_byte(out, (192 + cp / 64) as byte, (128 + cp % 64) as byte)
    } else if cp < 65536 {
        append_byte(
            out,
            (224 + cp / 4096) as byte,
            (128 + cp / 64 % 64) as byte,
            (128 + cp % 64) as byte
        )
    } else {
        append_byte(
            out,
            (240 + cp / 262144) as byte,
            (128 + cp / 4096 % 64) as byte,
            (128 + cp / 64 % 64) as byte,
            (128 + cp % 64) as byte
        )
    }
}

// ------------------------------------------------------------------ lines

// Splits into lines and lifts every leading `- ` into a line of its own, so `- a: 1` becomes
// the lines `-` (at the dash's indent) and `a: 1` (at the indent of `a`). The extra pieces
// share the original raw text and are marked `cont`.
fn tokenize(text: string) -> Result<[Line], string> {
    val out = mutable_array_new<Line>()
    var no = 0
    for raw_line in split(text, "\n") {
        no = no + 1
        val raw = if is_char_at(
            raw_line,
            len(raw_line) - 1,
            "\r"
        ) { substring(raw_line, 0, len(raw_line) - 1) } else { raw_line }
        var indent = 0
        while is_char_at(raw, indent, " ") {
            indent = indent + 1
        }
        var body = substring(raw, indent, len(raw))
        if is_char_at(body, 0, "\t") && byte_len(trim(body)) > 0 {
            return err(fail(no, "tabs are not allowed for indentation"))
        }
        val base = indent
        var cont = false
        var cur = indent
        while body == "-" || starts_with(body, "- ") {
            push(out, Line { no: no, indent: cur, base: base, body: "-", raw: raw, cont: cont, content: "-" })
            cont = true
            var skip = 1
            while is_char_at(body, skip, " ") {
                skip = skip + 1
            }
            cur = cur + skip
            body = substring(body, skip, len(body))
        }
        push(
            out,
            Line {
                no: no,
                indent: cur,
                base: if cont { base } else { cur },
                body: body,
                raw: raw,
                cont: cont,
                content: strip_comment(body)
            }
        )
    }
    return ok(snapshot(out))
}

// The body without a trailing `# comment` (a `#` at the start or after a space, outside quotes), trimmed.
//
// **Walked forward, not indexed.** This read `char_at(body, i)` *and* `char_at(body, i - 1)` at
// every position, and `char_at` walks from the start of the string unless the text is all-ASCII --
// so it was quadratic in the length of a line, twice over. A profile of 200 records with ~1,000
// character Japanese descriptions put 99% of the parse in this function and the `char_at` calls it
// makes. `prev` is the look-behind turned into state; `""` stands for "no previous character",
// which is what `i == 0` meant.
//
// `skip_next` is the old loop's `i = i + 1` inside the backslash case, which skipped the escaped
// character entirely. As a flag it does the same thing and survives being written as a `for`.
// `cs[p]` with `is_char_at`'s bounds check, and `substring` over the array -- what the flow
// sub-parser below used to ask of a string. It threads a position over one line, and `char_at`
// walks from the start of the string on text that is not all-ASCII, so scanning a long flow
// collection on a single line was quadratic in that line.
fn at_is(cs: [string], p: int, c: string) -> bool {
    return p >= 0 && p < len(cs) && cs[p] == c
}

fn span_text(cs: [string], a: int, b: int) -> string {
    return concat(slice<string>(cs, a, b))
}

fn strip_comment(body: string) -> string {
    var in_single = false
    var in_double = false
    var skip_next = false
    var prev = ""
    var i = 0
    for c in chars(body) {
        if skip_next {
            skip_next = false
        } else if in_double {
            if c == "\\" {
                skip_next = true
            } else if c == "\"" {
                in_double = false
            }
        } else if in_single {
            if c == "'" {
                in_single = false
            }
        } else if c == "\"" && (prev == "" || contains(" \t[{,:", prev)) {
            in_double = true
        } else if c == "'" && (prev == "" || contains(" \t[{,:", prev)) {
            in_single = true
        } else if c == "#" && (prev == "" || contains(" \t", prev)) {
            return trim(substring(body, 0, i))
        }
        prev = c
        i = i + 1
    }
    return trim(body)
}

fn content_of(ln: Line) -> string {
    return ln.content
}

// The first line at or after `i` that is neither blank nor a comment.
fn next_sig(lines: [Line], i: int) -> int {
    var j = i
    while j < len(lines) && byte_len(content_of(lines[j])) == 0 {
        j = j + 1
    }
    return j
}

// ------------------------------------------------------------------ scalars

fn looks_int(s: string) -> bool {
    var i = 0
    if is_char_at(s, 0, "-") || is_char_at(s, 0, "+") {
        i = 1
    }
    if i >= len(s) {
        return false
    }
    if char_at(s, i) == "0" && len(s) > i + 1 {
        return false
    }
    while i < len(s) {
        if !is_digit_c(char_at(s, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn looks_float(s: string) -> bool {
    var i = 0
    if is_char_at(s, 0, "-") || is_char_at(s, 0, "+") {
        i = 1
    }
    if i >= len(s) {
        return false
    }
    if char_at(s, i) == "0" && len(s) > i + 1 && is_digit_c(char_at(s, i + 1)) {
        return false
    }
    var seen_dot = false
    var seen_exp = false
    var digits = 0
    while i < len(s) {
        val c = char_at(s, i)
        if is_digit_c(c) {
            digits = digits + 1
        } else if c == "." && !seen_dot && !seen_exp {
            seen_dot = true
        } else if (c == "e" || c == "E") && !seen_exp && digits > 0 {
            seen_exp = true
            if is_char_at(s, i + 1, "+") || is_char_at(s, i + 1, "-") {
                i = i + 1
            }
            if i + 1 >= len(s) {
                return false
            }
        } else {
            return false
        }
        i = i + 1
    }
    return digits > 0 && (seen_dot || seen_exp)
}

fn parse_radix(t: string, digits: string, base: int) -> Json {
    var n = 0
    for i in 0..len(t) {
        val d = index_of(digits, to_lower(char_at(t, i), invariant), 0)
        if d < 0 {
            return Json.JString(t)
        }
        n = n * base + d
    }
    return int_to_json(n)
}

// A plain (unquoted) scalar, typed by the YAML 1.2 core schema.
fn plain_scalar(t: string, no: int) -> Result<Json, string> {
    if byte_len(t) == 0 || t == "~" || t == "null" || t == "Null" || t == "NULL" {
        return ok(Json.JNull)
    }
    if t == "true" || t == "True" || t == "TRUE" {
        return ok(Json.JBool(true))
    }
    if t == "false" || t == "False" || t == "FALSE" {
        return ok(Json.JBool(false))
    }
    val first = char_at(t, 0)
    if first == "&" || first == "*" || first == "!" {
        return err(fail(no, "anchors, aliases and tags are not supported"))
    }
    if first == "@" || first == "`" || first == "%" {
        return err(fail(no, format("'{}' cannot start a plain scalar", first)))
    }
    if t == ".inf" || t == "-.inf" || t == "+.inf" || t == ".nan" || t == ".NaN" || t == ".Inf" {
        return err(fail(no, ".inf and .nan are not supported"))
    }
    if starts_with(t, "0x") && len(t) > 2 {
        return ok(parse_radix(substring(t, 2, len(t)), hex_chars, 16))
    }
    if starts_with(t, "0o") && len(t) > 2 {
        return ok(parse_radix(substring(t, 2, len(t)), "01234567", 8))
    }
    if looks_int(t) {
        val n = parse_int(if is_char_at(t, 0, "+") { substring(t, 1, len(t)) } else { t })
        if is_ok(n) {
            return ok(int_to_json(unwrap(n)))
        }
    }
    if looks_float(t) {
        val f = parse_float(if is_char_at(t, 0, "+") { substring(t, 1, len(t)) } else { t })
        if is_ok(f) {
            return ok(float_to_json(unwrap(f)))
        }
    }
    return ok(Json.JString(t))
}

// A double-quoted scalar starting at the quote in `s[pos]`; the text and the index after the closing quote.
fn read_double(cs: [string], pos: int, no: int) -> Result<Scalar, string> {
    val out = mutable_string_new()
    var p = pos + 1
    while p < len(cs) {
        val c = cs[p]
        if c == "\"" {
            return ok(Scalar { value: Json.JString(snapshot(out)), next: p + 1 })
        }
        if c == "\\" {
            val e = cs[p + 1]
            if e == "n" {
                append(out, "\n")
            } else if e == "t" {
                append(out, "\t")
            } else if e == "r" {
                append(out, "\r")
            } else if e == "b" {
                append_byte(out, 8b)
            } else if e == "f" {
                append_byte(out, 12b)
            } else if e == "\"" || e == "\\" || e == "/" || e == " " {
                append(out, e)
            } else if e == "x" || e == "u" || e == "U" {
                val digits = if e == "x" { 2 } else if e == "u" { 4 } else { 8 }
                val cp = read_hex(cs, p + 2, digits)
                if cp <= 0 || cp > max_code_point || (cp >= surrogate_start && cp <= surrogate_end) {
                    return err(fail(no, "invalid unicode escape"))
                }
                append_utf8(out, cp)
                p = p + 2 + digits
                continue
            } else {
                return err(fail(no, format("unsupported escape '\\{}'", e)))
            }
            p = p + 2
        } else {
            append(out, c)
            p = p + 1
        }
    }
    return err(fail(no, "unterminated double-quoted string"))
}

fn read_single(cs: [string], pos: int, no: int) -> Result<Scalar, string> {
    val out = mutable_string_new()
    var p = pos + 1
    while p < len(cs) {
        val c = cs[p]
        if c == "'" {
            if at_is(cs, p + 1, "'") {
                append(out, "'")
                p = p + 2
            } else {
                return ok(Scalar { value: Json.JString(snapshot(out)), next: p + 1 })
            }
        } else {
            append(out, c)
            p = p + 1
        }
    }
    return err(fail(no, "unterminated single-quoted string"))
}

// ------------------------------------------------------------------ flow collections

fn skip_sp(cs: [string], pos: int) -> int {
    var p = pos
    while p < len(cs) && (at_is(cs, p, " ") || at_is(cs, p, "\t")) {
        p = p + 1
    }
    return p
}

// One scalar inside `[...]` / `{...}`: quoted, or plain up to `,` `]` `}` (a key: also up to `: `).

fn flow_scalar(cs: [string], pos: int, is_key: bool, no: int) -> Result<Scalar, string> {
    if at_is(cs, pos, "\"") {
        return read_double(cs, pos, no)
    }
    if at_is(cs, pos, "'") {
        return read_single(cs, pos, no)
    }
    var p = pos
    while p < len(cs) {
        val c = cs[p]
        if c == "," || c == "]" || c == "}" {
            break
        }
        if is_key && c == ":" && (p + 1 >= len(cs) || contains(" ,]}", cs[p + 1])) {
            break
        }
        p = p + 1
    }
    val value = try plain_scalar(trim(span_text(cs, pos, p)), no)
    return ok(Scalar { value: value, next: p })
}

// The nesting cap on flow collections, matching `json`'s own documented 512 (src/native_json.c).
// `flow_node` and `flow_seq`/`flow_map` recurse into each other with nothing to stop them, so a
// document of 100,000 open brackets aborted the process -- "Too many retries in GC_allocobj" and a
// core dump, because each level also allocates a builder handle (D19).
val max_flow_depth = 512

fn flow_node(cs: [string], pos: int, no: int, depth: int) -> Result<Scalar, string> {
    if depth > max_flow_depth {
        return err(format("line {}: flow collections nested deeper than {}", no, max_flow_depth))
    }
    val p = skip_sp(cs, pos)
    if p >= len(cs) {
        return err(fail(no, "unexpected end of a flow collection"))
    }
    if at_is(cs, p, "[") {
        return flow_seq(cs, p, no, depth)
    }
    if at_is(cs, p, "{") {
        return flow_map(cs, p, no, depth)
    }
    return flow_scalar(cs, p, false, no)
}

fn flow_seq(cs: [string], pos: int, no: int, depth: int) -> Result<Scalar, string> {
    val items = mutable_array_new<Json>()
    var p = skip_sp(cs, pos + 1)
    while true {
        if p >= len(cs) {
            return err(fail(no, "unterminated '['"))
        }
        if at_is(cs, p, "]") {
            return ok(Scalar { value: Json.JArray(snapshot(items)), next: p + 1 })
        }
        val item = try flow_node(cs, p, no, depth + 1)
        push(items, item.value)
        p = skip_sp(cs, item.next)
        if at_is(cs, p, ",") {
            p = skip_sp(cs, p + 1)
        } else if !at_is(cs, p, "]") {
            return err(fail(no, "expected ',' or ']'"))
        }
    }
    // The `while true` above only ever exits via a `return`; this line is dead and exists
    // purely because the typechecker still requires every path out of the function to
    // produce a value. The same idiom recurs in flow_map below.
    return err("unreachable")
}

fn flow_map(cs: [string], pos: int, no: int, depth: int) -> Result<Scalar, string> {
    val fields = mutable_map_new<string, Json>()
    var p = skip_sp(cs, pos + 1)
    while true {
        if p >= len(cs) {
            return err(fail(no, "unterminated '{'"))
        }
        if at_is(cs, p, "}") {
            return ok(Scalar { value: Json.JObject(snapshot(fields)), next: p + 1 })
        }
        val key = try flow_scalar(cs, p, true, no)
        // A flow mapping's key becomes its scanned source text verbatim (not its typed value)
        // unless it was quoted: `Json` only has string keys, and keeping the literal text for
        // an unquoted key (`0x1A: v`, `true: v`) avoids silently renormalizing it to a
        // different string (e.g. its decimal value, or its own canonical casing).
        val key_text = if Json.is_JString(key.value) { Json.unwrap_JString(key.value) } else { trim(span_text(
            cs,
            p,
            key.next
        )) }
        if contains(fields, key_text) {
            return err(fail(no, format("duplicate key '{}'", key_text)))
        }
        p = skip_sp(cs, key.next)
        var value = Json.JNull
        if at_is(cs, p, ":") {
            val item = try flow_node(cs, skip_sp(cs, p + 1), no, depth + 1)
            value = item.value
            p = skip_sp(cs, item.next)
        }
        set(fields, key_text, value)
        if at_is(cs, p, ",") {
            p = skip_sp(cs, p + 1)
        } else if !at_is(cs, p, "}") {
            return err(fail(no, "expected ',' or '}'"))
        }
    }
    return err("unreachable")
}

// Net open brackets in `s`, ignoring quoted text; and whether a quote is left open.
// **The flow scan's state, so a continuation line can be scanned on its own.** `flow_depth` read
// the whole accumulated text on every round of `inline_value`'s gather loop, which together with
// the `concat` in that loop made parsing a multi-line flow collection quadratic *twice over*: 1,600
// lines of flow sequence (18 KB of YAML) took 2.2 s. `inline_value` recorded that as open and named
// what it needed -- "the depth and quote state tracked incrementally" (D22, F133). This is it.
//
// `escaped` is the one piece of state the old loop did not have to name: it skipped the character
// after a backslash with `i = i + 1`, which cannot survive the end of a line. As a flag it can.
struct FlowState {
    depth: int
    in_single: bool
    in_double: bool
    escaped: bool
}

fn flow_begin() -> FlowState {
    return FlowState { depth: 0, in_single: false, in_double: false, escaped: false }
}

fn flow_advance(st: FlowState, s: string) -> FlowState {
    var depth = st.depth
    var in_single = st.in_single
    var in_double = st.in_double
    var escaped = st.escaped
    // Walked, not indexed: this only moves forward, and `char_at` walks from the start of the
    // string on text that is not all-ASCII, which made scanning one line quadratic in its length.
    for c in chars(s) {
        if escaped {
            escaped = false
        } else if in_double {
            if c == "\\" {
                escaped = true
            } else if c == "\"" {
                in_double = false
            }
        } else if in_single {
            if c == "'" {
                in_single = false
            }
        } else if c == "\"" {
            in_double = true
        } else if c == "'" {
            in_single = true
        } else if c == "[" || c == "{" {
            depth = depth + 1
        } else if c == "]" || c == "}" {
            depth = depth - 1
        }
    }
    return FlowState { depth: depth, in_single: in_single, in_double: in_double, escaped: escaped }
}

// **Whether the quoted scalar opened on the first line is still open**, carried across lines for
// the same reason FlowState is -- this read the whole accumulation per round too.
//
// `pending` is the old code's one-character lookahead turned into state: inside a single-quoted
// scalar a `''` is a literal quote rather than the end. It is forced closed at the end of each
// piece, which is exactly what the old scanner did -- it asked `is_char_at(s, i + 1, "'")` of a
// position past the end of the text and got false. That stays right across lines because the gather
// inserts a space between them, so a `'` ending one line is never adjacent to a `'` starting the
// next one either way.
struct QuoteState {
    open: bool
    escaped: bool
    pending: bool
}

fn quote_begin() -> QuoteState {
    return QuoteState { open: true, escaped: false, pending: false }
}

fn quote_advance(st: QuoteState, s: string, quote: string, from: int) -> QuoteState {
    var open = st.open
    var escaped = st.escaped
    var pending = st.pending
    // Decoded once and indexed, rather than `char_at` per position: same reason as flow_advance.
    // Kept as a `while` and not a `for` because the `continue` below deliberately does not advance
    // -- it re-reads nothing, it ends the scan -- and a `for` would change that control flow.
    val cs = chars(s)
    var i = from
    while open && i < len(cs) {
        val c = cs[i]
        if pending {
            pending = false
            if c == quote {
                i = i + 1  // a doubled quote: a literal one, and the scalar is still open
                continue
            }
            open = false  // the quote before this character ended the scalar
            continue
        }
        if escaped {
            escaped = false
        } else if quote == "\"" && c == "\\" {
            escaped = true
        } else if c == quote {
            if quote == "'" {
                pending = true
            } else {
                open = false
            }
        }
        i = i + 1
    }
    if pending {
        open = false
    }
    return QuoteState { open: open, escaped: false, pending: false }
}

// ------------------------------------------------------------------ block structure

// `key: rest` (rest may be empty) -- None when the text is not a mapping entry.
fn split_key(content: string, no: int) -> Result<Option<KeyRes>, string> {
    if byte_len(content) == 0 {
        return ok(Option<KeyRes>.None)
    }
    val first = char_at(content, 0)
    if first == "[" || first == "{" || first == "|" || first == ">" {
        return ok(Option<KeyRes>.None)
    }
    if first == "?" && (len(content) == 1 || is_char_at(content, 1, " ")) {
        return err(fail(no, "complex keys ('? ') are not supported"))
    }
    if first == "\"" || first == "'" {
        // The line decoded once for the quoted-scalar reader, which indexes characters.
        val cc = chars(content)
        val quoted = if first == "\"" { try read_double(cc, 0, no) } else { try read_single(cc, 0, no) }
        val after = skip_sp(cc, quoted.next)
        if at_is(cc, after, ":") && (after + 1 >= len(cc) || at_is(cc, after + 1, " ")) {
            return ok(Option<KeyRes>.Some(KeyRes {
                key: Json.unwrap_JString(quoted.value),
                rest: trim(substring(content, after + 1, len(content)))
            }))
        }
        return ok(Option<KeyRes>.None)
    }
    var i = 0
    while i < len(content) {
        if char_at(content, i) == ":" && (i + 1 >= len(content) || is_char_at(content, i + 1, " ")) {
            val key = trim(substring(content, 0, i))
            if key == "<<" {
                return err(fail(no, "the '<<' merge key is not supported"))
            }
            if starts_with(key, "&") || starts_with(key, "*") || starts_with(key, "!") {
                return err(fail(no, "anchors, aliases and tags are not supported"))
            }
            return ok(Option<KeyRes>.Some(KeyRes {
                key: key,
                rest: trim(substring(content, i + 1, len(content)))
            }))
        }
        i = i + 1
    }
    return ok(Option<KeyRes>.None)
}

// A block scalar (`|` literal, `>` folded): the more-indented lines after line `j`.
fn block_scalar(lines: [Line], j: int, header: string, base: int) -> Result<NodeRes, string> {
    val no = lines[j].no
    var chomp = "clip"
    for k in 1..len(header) {
        val c = char_at(header, k)
        if c == "-" {
            chomp = "strip"
        } else if c == "+" {
            chomp = "keep"
        } else {
            return err(fail(no, "block scalar indentation indicators are not supported"))
        }
    }
    val literal = char_at(header, 0) == "|"
    val body_lines = mutable_array_new<string>()
    var indent = -1
    var i = j + 1
    var last_used = j
    while i < len(lines) {
        val ln = lines[i]
        if ln.cont {
            i = i + 1
            continue
        }
        val blank = byte_len(trim(ln.raw)) == 0
        if !blank && ln.indent <= base {
            break
        }
        if !blank && indent < 0 {
            indent = ln.indent
        }
        if !blank && ln.indent < indent {
            return err(fail(ln.no, "bad indentation in a block scalar"))
        }
        push(
            body_lines,
            if blank { (if indent >= 0 && len(ln.raw) > indent { substring(
                ln.raw,
                indent,
                len(ln.raw)
            ) } else { "" }) } else { substring(
                ln.raw,
                indent,
                len(ln.raw)
            ) }
        )
        i = i + 1
        if !blank {
            last_used = i
        }
    }
    val all = snapshot(body_lines)
    // trailing blank lines belong to the chomping, not the text
    var count = len(all)
    while count > 0 && byte_len(all[count - 1]) == 0 {
        count = count - 1
    }
    val out = mutable_string_new()
    var k = 0
    while k < count {
        if k > 0 {
            if literal {
                append(out, "\n")
            } else if byte_len(all[k]) == 0 {
                append(out, "\n")
            } else if byte_len(all[k - 1]) == 0 {
                // a blank line already produced its own newline
            } else {
                append(out, " ")
            }
        }
        append(out, all[k])
        k = k + 1
    }
    // Appended to the builder and snapshotted once, rather than snapshotting first and then
    // `concat`-ing a newline at a time: the `keep` loop runs once per trailing blank line and each
    // pass re-copied the whole block scalar (D22).
    if count > 0 {
        if chomp == "clip" {
            append(out, "\n")
        } else if chomp == "keep" {
            append(out, "\n")
            for t in 0..(len(all) - count) {
                append(out, "\n")
            }
        }
    }
    val text = snapshot(out)
    return ok(NodeRes { value: Json.JString(text), next: if chomp == "keep" { i } else { last_used } })
}

// The value written on the same line as its key / dash: a flow collection, a quoted or plain
// scalar; continuation lines are gathered for an unbalanced flow / quote and folded for plain text.
fn inline_value(lines: [Line], j: int, rest: string, parent_indent: int) -> Result<NodeRes, string> {
    val no = lines[j].no
    var text = rest
    var next = j + 1
    val first = char_at(rest, 0)
    if first == "[" || first == "{" {
        // Each line scanned once as it arrives and the pieces joined in one allocation, where this
        // rescanned the whole accumulation per line and rebuilt it with `concat`. See FlowState.
        val pieces = mutable_array_new<string>()
        push(pieces, rest)
        var st = flow_advance(flow_begin(), rest)
        while st.depth > 0 && next < len(lines) {
            val piece = concat(" ", content_of(lines[next]))
            push(pieces, piece)
            st = flow_advance(st, piece)
            next = next + 1
        }
        text = concat(snapshot(pieces))
        val ct = chars(text)
        val node = try flow_node(ct, 0, no, 0)
        if skip_sp(ct, node.next) < len(ct) {
            return err(fail(no, "unexpected text after a flow collection"))
        }
        return ok(NodeRes { value: node.value, next: next })
    }
    if first == "\"" || first == "'" {
        // Same shape as the flow branch above. `from` is 1 on the first piece, to step over the
        // opening quote, and 0 on every continuation.
        val pieces = mutable_array_new<string>()
        push(pieces, rest)
        var qs = quote_advance(quote_begin(), rest, first, 1)
        while qs.open && next < len(lines) {
            val piece = concat(" ", content_of(lines[next]))
            push(pieces, piece)
            qs = quote_advance(qs, piece, first, 0)
            next = next + 1
        }
        text = concat(snapshot(pieces))
        val ct = chars(text)
        val node = if first == "\"" { try read_double(ct, 0, no) } else { try read_single(ct, 0, no) }
        if skip_sp(ct, node.next) < len(ct) {
            return err(fail(no, "unexpected text after a quoted scalar"))
        }
        return ok(NodeRes { value: node.value, next: next })
    }
    // plain: more-indented following lines continue it.
    //
    // A builder here, an array of pieces in the two loops above; all three accumulate once and
    // join once. The difference used to matter -- this predicate reads only `lines[next]` while
    // those two reread the whole accumulation, so only this loop could avoid being quadratic. D22
    // and F133 recorded that as open and named the fix as "the depth and quote state tracked
    // incrementally"; FlowState and QuoteState are that, and all three loops are linear now.
    val plain = mutable_string_new()
    append(plain, text)
    while next < len(lines) && byte_len(content_of(lines[next])) > 0 && lines[next].indent > parent_indent {
        append(plain, " ")
        append(plain, content_of(lines[next]))
        next = next + 1
    }
    val value = try plain_scalar(snapshot(plain), no)
    return ok(NodeRes { value: value, next: next })
}

fn parse_node(lines: [Line], i: int, min_indent: int) -> Result<NodeRes, string> {
    val j = next_sig(lines, i)
    if j >= len(lines) || lines[j].indent < min_indent {
        return ok(NodeRes { value: Json.JNull, next: j })
    }
    val ln = lines[j]
    val content = content_of(ln)
    if content == "-" {
        return parse_seq(lines, j, ln.indent)
    }
    // Only used as a look-ahead here, to tell a mapping apart from a sequence or a scalar;
    // parse_map re-runs split_key on this same line to actually use its result.
    val kv = try split_key(content, ln.no)
    if Option.is_Some(kv) {
        return parse_map(lines, j, ln.indent)
    }
    if starts_with(content, "|") || starts_with(content, ">") {
        return block_scalar(lines, j, content, ln.base - 1)
    }
    return inline_value(lines, j, content, ln.indent - 1)
}

fn parse_seq(lines: [Line], i: int, ind: int) -> Result<NodeRes, string> {
    val items = mutable_array_new<Json>()
    var j = i
    while true {
        j = next_sig(lines, j)
        if j >= len(lines) || lines[j].indent != ind || content_of(lines[j]) != "-" {
            break
        }
        val nxt = next_sig(lines, j + 1)
        if nxt >= len(lines) || lines[nxt].indent <= ind {
            push(items, Json.JNull)
            j = j + 1
        } else {
            val item = try parse_node(lines, j + 1, ind + 1)
            push(items, item.value)
            j = item.next
        }
    }
    if j < len(lines) && lines[j].indent > ind && byte_len(content_of(lines[j])) > 0 {
        return err(fail(lines[j].no, "unexpected indentation"))
    }
    return ok(NodeRes { value: Json.JArray(snapshot(items)), next: j })
}

fn parse_map(lines: [Line], i: int, ind: int) -> Result<NodeRes, string> {
    val fields = mutable_map_new<string, Json>()
    var j = i
    while true {
        j = next_sig(lines, j)
        if j >= len(lines) || lines[j].indent < ind {
            break
        }
        val ln = lines[j]
        if ln.indent > ind {
            return err(fail(ln.no, "unexpected indentation"))
        }
        val content = content_of(ln)
        if content == "-" {
            break
        }
        val entry = switch try split_key(content, ln.no) {
            Some(e) { e }
            None { return err(fail(ln.no, "expected 'key: value'")) }
        }
        if contains(fields, entry.key) {
            return err(fail(ln.no, format("duplicate key '{}'", entry.key)))
        }
        var value = Json.JNull
        var after = j + 1
        if byte_len(entry.rest) == 0 {
            val nxt = next_sig(lines, j + 1)
            if nxt < len(lines) && lines[nxt].indent > ind {
                val node = try parse_node(lines, j + 1, ind + 1)
                value = node.value
                after = node.next
            } else if nxt < len(lines) && lines[nxt].indent == ind && content_of(lines[nxt]) == "-" {
                val node = try parse_seq(lines, nxt, ind)
                value = node.value
                after = node.next
            }
        } else if starts_with(entry.rest, "|") || starts_with(entry.rest, ">") {
            val node = try block_scalar(lines, j, entry.rest, ln.base)
            value = node.value
            after = node.next
        } else {
            val node = try inline_value(lines, j, entry.rest, ind)
            value = node.value
            after = node.next
        }
        set(fields, entry.key, value)
        j = after
    }
    return ok(NodeRes { value: Json.JObject(snapshot(fields)), next: j })
}

// Parses a YAML document (the subset described above) into a `Json` tree; an empty document is
// `JNull`. An Err carries `line N: ...` for a syntax error, a duplicate key, bad indentation, or
// something unsupported (anchors, aliases, tags, the `<<` merge key, multiple documents, tab
// indentation), so nothing is silently misread.
pub fn parse_yaml(text: string) -> Result<Json, string> {
    val all = try tokenize(text)
    val kept = mutable_array_new<Line>()
    var seen_start = false
    for ln in all {
        val c = content_of(ln)
        if !ln.cont && (c == "---" || starts_with(c, "--- ")) {
            if seen_start || len(kept) > 0 {
                return err(fail(ln.no, "multiple documents are not supported"))
            }
            if c != "---" {
                return err(fail(ln.no, "a value after '---' is not supported"))
            }
            seen_start = true
        } else if !ln.cont && c == "..." {
            // end of document marker
        } else if !ln.cont && starts_with(c, "%") && ln.indent == 0 {
            return err(fail(ln.no, "directives are not supported"))
        } else {
            push(kept, ln)
        }
    }
    val lines = snapshot(kept)
    if next_sig(lines, 0) >= len(lines) {
        return ok(Json.JNull)
    }
    val root = try parse_node(lines, 0, 0)
    val rest = next_sig(lines, root.next)
    if rest < len(lines) {
        return err(fail(lines[rest].no, "unexpected content"))
    }
    return ok(root.value)
}

// ------------------------------------------------------------------ writing

fn quote_double(s: string) -> string {
    val out = mutable_string_new()
    append(out, "\"")
    var i = 0
    while i < len(s) {
        val c = char_at(s, i)
        if c == "\"" {
            append(out, "\\\"")
        } else if c == "\\" {
            append(out, "\\\\")
        } else if c == "\n" {
            append(out, "\\n")
        } else if c == "\t" {
            append(out, "\\t")
        } else if c == "\r" {
            append(out, "\\r")
        } else if compare(c, " ") < 0 {
            val code = to_bytes(c)[0] as int
            append(
                out,
                "\\x",
                substring(hex_chars, code / 16, code / 16 + 1),
                substring(hex_chars, code % 16, code % 16 + 1)
            )
        } else {
            append(out, c)
        }
        i = i + 1
    }
    append(out, "\"")
    return snapshot(out)
}

// A string as YAML text: plain when it reads back as the same string, else double-quoted.
fn string_text(s: string) -> string {
    if byte_len(s) == 0 {
        return "\"\""
    }
    val parsed = plain_scalar(s, 0)
    if !is_ok(parsed) || !Json.is_JString(unwrap(parsed)) || Json.unwrap_JString(unwrap(parsed)) != s {
        return quote_double(s)
    }
    if is_char_at(s, 0, " ") || is_char_at(s, len(s) - 1, " ") || is_char_at(s, 0, "\t") || is_char_at(
        s,
        len(s) - 1,
        "\t"
    ) {
        return quote_double(s)
    }
    if contains("-?:,[]{}#&*!|>'\"%@`", char_at(s, 0)) {
        return quote_double(s)
    }
    if contains(s, ": ") || contains(s, " #") || is_char_at(s, len(s) - 1, ":") {
        return quote_double(s)
    }
    for i in 0..len(s) {
        if compare(char_at(s, i), " ") < 0 {
            return quote_double(s)
        }
    }
    return s
}

fn key_text(k: string) -> string {
    return string_text(k)
}

fn float_text(f: float) -> string {
    val t = float_to_text(f)
    if contains(t, ".") || contains(t, "e") {
        return t
    }
    return concat(t, ".0")
}

// A JSON number as YAML text: an int or bigint as its digits, a float with the fewest digits that read back (and a `.0` if it
// would otherwise look like an integer), a decimal as its digits at its own scale.
fn number_text(n: Number) -> string {
    switch n {
        Int(i) { return str(i) }
        Float(f) { return float_text(f) }
        Bigint(b) { return str(b) }
        Decimal(d) { return str(d) }
    }
}

fn scalar_text(j: Json) -> string {
    if Json.is_JNull(j) {
        return "null"
    }
    if Json.is_JBool(j) {
        return if Json.unwrap_JBool(j) { "true" } else { "false" }
    }
    if Json.is_JNumber(j) {
        return number_text(Json.unwrap_JNumber(j))
    }
    return string_text(Json.unwrap_JString(j))
}

fn is_container(j: Json) -> bool {
    return Json.is_JArray(j) || Json.is_JObject(j)
}

fn is_empty_container(j: Json) -> bool {
    if JArray(items) = j {
        return len(items) == 0
    }
    if JObject(fields) = j {
        return len(fields) == 0
    }
    return false
}

fn empty_text(j: Json) -> string {
    return if Json.is_JArray(j) { "[]" } else { "{}" }
}

fn pad_of(n: int) -> string {
    val out = mutable_string_new()
    for i in 0..n {
        append(out, " ")
    }
    return snapshot(out)
}

// Writes the entries of an object at `indent`. `first_prefix` is written before the first
// entry instead of the indentation (`- ` when the object is a sequence item).
fn write_map(out: MutableString, obj: Json, indent: int, first_prefix: string) {
    var first = true
    for key, value in Json.unwrap_JObject(obj) {
        append(out, if first && byte_len(first_prefix) > 0 { first_prefix } else { pad_of(indent) })
        first = false
        if is_container(value) && !is_empty_container(value) {
            append(out, key_text(key), ":\n")
            write_node(out, value, indent + 2)
        } else if is_container(value) {
            append(out, key_text(key), ": ", empty_text(value), "\n")
        } else {
            append(out, key_text(key), ": ", scalar_text(value), "\n")
        }
    }
}

fn write_seq(out: MutableString, arr: Json, indent: int) {
    for item in Json.unwrap_JArray(arr) {
        if Json.is_JObject(item) && !is_empty_container(item) {
            write_map(out, item, indent + 2, concat(pad_of(indent), "- "))
        } else if is_container(item) && !is_empty_container(item) {
            append(out, pad_of(indent), "-\n")
            write_node(out, item, indent + 2)
        } else if is_container(item) {
            append(out, pad_of(indent), "- ", empty_text(item), "\n")
        } else {
            append(out, pad_of(indent), "- ", scalar_text(item), "\n")
        }
    }
}

fn write_node(out: MutableString, j: Json, indent: int) {
    if Json.is_JObject(j) {
        write_map(out, j, indent, "")
    } else {
        write_seq(out, j, indent)
    }
}

// Writes `j` as block-style YAML: maps as `key: value`, sequences as `- item`, empty containers
// as `{}` / `[]`. A string that would read back as another type (`"42"`, `"true"`, `""`, `"null"`)
// or that needs it (a leading `-`, a `: ` inside) is double-quoted; floats are written with full
// precision and keep a `.0`. Reading the output back gives the same tree.
pub fn yaml_to_string(j: Json) -> string {
    if is_container(j) && !is_empty_container(j) {
        val out = mutable_string_new()
        write_node(out, j, 0)
        return snapshot(out)
    }
    if is_container(j) {
        return concat(empty_text(j), "\n")
    }
    return concat(scalar_text(j), "\n")
}
