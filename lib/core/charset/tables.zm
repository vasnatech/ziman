// Every set this file carries, for a caller that wants to offer a list and for the round-trip
// test that holds all of them to the same promise.
pub fn single_byte_sets() -> [Charset] {
    return [
        iso_8859_2(), iso_8859_3(), iso_8859_4(), iso_8859_5(), iso_8859_6(), iso_8859_7(),
        iso_8859_8(), iso_8859_9(), iso_8859_10(), iso_8859_11(), iso_8859_13(), iso_8859_14(),
        iso_8859_15(), iso_8859_16(), cp1250(), cp1251(), cp1253(), cp1254(), cp1255(), cp1256(),
        cp1257(), cp1258(), koi8_r(), koi8_u(), mac_roman()
    ]
}
