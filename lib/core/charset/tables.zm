// The set a written name means, for the names this file carries.
//
// **Grouped by first character, which is worth 5x and is the reason this is not one flat chain.**
// 106 comparisons in a row cost 2.3 microseconds for the last name and the same for any name that
// is *not* here -- and a miss is the common case, because `charset_named` asks the hand-written
// sets first and reaches this only to find `utf8` is not in it. Measured at 200,000 lookups:
//
// | | flat | grouped |
// |---|---|---|
// | the last name | 457 ms | **151 ms** |
// | a name that is not here | 466 ms | **93 ms** |
//
// A second level inside each group, by length, was measured too and buys nothing (116 ms against
// 114): some bucket still holds nineteen names, so the split stops partitioning. A map is about
// twice as fast again at 50 ms and is not what this file is -- a table of names reads as a table.
//
// Each group returns rather than falling through, which is safe because the groups partition on
// the first character: a name beginning with `i` that is not in the `i` group is in none of them.
fn table_named(key: string) -> Option<Charset> {
    if starts_with(key, "1") {
        if key == "1250" {
            return Option<Charset>.Some(cp1250())
        }
        if key == "1251" {
            return Option<Charset>.Some(cp1251())
        }
        if key == "1253" {
            return Option<Charset>.Some(cp1253())
        }
        if key == "1254" {
            return Option<Charset>.Some(cp1254())
        }
        if key == "1255" {
            return Option<Charset>.Some(cp1255())
        }
        if key == "1256" {
            return Option<Charset>.Some(cp1256())
        }
        if key == "1257" {
            return Option<Charset>.Some(cp1257())
        }
        if key == "1258" {
            return Option<Charset>.Some(cp1258())
        }
        return Option<Charset>.None
    }
    if starts_with(key, "a") {
        if key == "arabic" {
            return Option<Charset>.Some(iso_8859_6())
        }
        if key == "asmo708" {
            return Option<Charset>.Some(iso_8859_6())
        }
        return Option<Charset>.None
    }
    if starts_with(key, "c") {
        if key == "cp1250" {
            return Option<Charset>.Some(cp1250())
        }
        if key == "cp1251" {
            return Option<Charset>.Some(cp1251())
        }
        if key == "cp1253" {
            return Option<Charset>.Some(cp1253())
        }
        if key == "cp1254" {
            return Option<Charset>.Some(cp1254())
        }
        if key == "cp1255" {
            return Option<Charset>.Some(cp1255())
        }
        if key == "cp1256" {
            return Option<Charset>.Some(cp1256())
        }
        if key == "cp1257" {
            return Option<Charset>.Some(cp1257())
        }
        if key == "cp1258" {
            return Option<Charset>.Some(cp1258())
        }
        if key == "csisolatin2" {
            return Option<Charset>.Some(iso_8859_2())
        }
        if key == "csisolatin3" {
            return Option<Charset>.Some(iso_8859_3())
        }
        if key == "csisolatin4" {
            return Option<Charset>.Some(iso_8859_4())
        }
        if key == "csisolatin5" {
            return Option<Charset>.Some(iso_8859_9())
        }
        if key == "csisolatin6" {
            return Option<Charset>.Some(iso_8859_10())
