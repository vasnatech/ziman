// A colour as a document writes one: `#f0f`, `#ff00ff`, `#ff00ff80`, `rgb(255, 0, 255)`,
// `rgb(100%, 0%, 100%)`, `rgba(255, 0, 255, 0.5)`, `rgb(255 0 255 / 50%)`, any of the 148 names, or
// `transparent`.
//
// **An Err rather than a fallback**, for `hex`'s reason: a colour that silently reads as black is a
// wrong drawing with nothing to point at. What this deliberately does not accept is the rest of CSS
// Color -- `hsl()`, `lab()`, `color()` -- and the two keywords that are not colours at all:
// `currentColor` says to use somebody else's colour and `none` says to paint nothing, and only the
// caller knows what either means (`svg.Fill` is one answer).
//
// Hex needs its `#` here, although `hex` itself does not: without it `fff` and `red` are the same
// kind of word, and guessing between a name and three hex digits is how `beef` becomes a colour.
pub fn parse(text: string) -> Result<Color, string> {
    val body = trim(text)
    if len(body) == 0 {
        return err("paint.parse: a colour was expected and the text is empty")
    }
    if starts_with(body, "#") {
        return hex(body)
    }
    val key = to_lower(body, invariant)
    // Not one of the 148 and not a colour in SVG 1.1 either -- but CSS allows it wherever a colour
    // is allowed, and design tools write it.
    if key == "transparent" {
        return ok(transparent())
    }
    if starts_with(key, "rgb(") || starts_with(key, "rgba(") {
        return functional(body, key)
    }
    if starts_with(key, "hsl(") || starts_with(key, "hsla(") {
        return hsl_colour(body, key)
    }
    if starts_with(key, "oklab(") {
        return oklab_colour(body, key)
    }
    if starts_with(key, "oklch(") {
        return oklch_colour(body, key)
    }
    if Some(c) = named(key) {
        return ok(c)
    }
    return err(concat(
        "paint.parse: '",
        body,
        "' is not a colour: expected #rgb, #rrggbb, rgb(..), rgba(..), hsl(..), oklab(..), ",
        "oklch(..) or one of the 148 colour names"
    ))
}

// **`rgb()` and `rgba()` are one function**, which is what CSS Color 4 made them: `rgb()` takes an
// optional fourth component and `rgba()` is an alias for it. A file written to SVG 1.1 only ever
// writes three, so both spellings accept both shapes rather than policing a distinction every
// browser dropped.
//
// Components may be separated by commas or by spaces, and the alpha may follow a `/` -- the three
// spellings that occur in files, from SVG 1.1 through CSS Color 4.
// The three components and an optional alpha of a functional notation, as text.
//
// **One grammar, four readers.** `rgb()`, `hsl()`, `oklab()` and `oklch()` differ in what their
// components *mean* and not at all in how they are written: separated by commas or by spaces, with
// the alpha given either as a fourth component or after a slash. Four copies of the splitting would
// be four places for a space to stop being allowed in, which is how a reader ends up accepting
// `rgb(1 2 3)` and refusing `hsl(1 2 3)`.
fn three_and_alpha(whole: string, key: string, what: string) -> Result<[string], string> {
    if !ends_with(key, ")") {
        return err(concat("paint.parse: '", whole, "' never closes its '('"))
    }
    val open = index_of(key, "(", 0)
    val inside = substring(key, open + 1, len(key) - 1)
    val flat = replace(replace(replace(replace(inside, ",", " "), "/", " / "), "\t", " "), "\n", " ")
    var alpha_text = ""
    var head = flat
    val slash = index_of(flat, "/", 0)
    if slash >= 0 {
        head = substring(flat, 0, slash)
        alpha_text = trim(substring(flat, slash + 1, len(flat)))
        if len(alpha_text) == 0 {
            return err(concat("paint.parse: '", whole, "' has a '/' with no alpha after it"))
        }
    }
    val fields = words(head)
    if len(fields) != 3 && len(fields) != 4 {
        return err(concat(
            "paint.parse: '",
            whole,
            "' has ",
            str(len(fields)),
            " components, and ",
            what,
            " takes three or four"
        ))
    }
    if len(fields) == 4 {
        if len(alpha_text) > 0 {
            return err(concat("paint.parse: '", whole, "' gives the alpha twice"))
        }
        alpha_text = fields[3]
    }
    return ok([fields[0], fields[1], fields[2], alpha_text])
}

fn plain_number(text: string, whole: string) -> Result<float, string> {
    val body = trim(text)
    val read = parse_float(body)
    if Err(why) = read {
        return err(concat("paint.parse: '", body, "' is not a number, in '", whole, "' (", why, ")"))
    }
    val v = try read
    return ok(v)
}

// A number where `100%` means `full` and a bare number means itself: OKLab's lightness (full 1.0)
// and its axes and chroma (full 0.4, which is about as far as sRGB reaches). CSS Color 4's rule.
fn scaled_number(text: string, full: float, whole: string) -> Result<float, string> {
    val body = trim(text)
    if ends_with(body, "%") {
        val v = try plain_number(substring(body, 0, len(body) - 1), whole)
        return ok(v / 100.0 * full)
    }
    return plain_number(body, whole)
}

// A number that is a percentage **whether or not it carries the sign**, which is `hsl()`'s
// saturation and lightness: CSS accepts `50%` and `50` there and means the same by both.
fn percentage(text: string, whole: string) -> Result<float, string> {
    val body = trim(text)
    if ends_with(body, "%") {
        val v = try plain_number(substring(body, 0, len(body) - 1), whole)
        return ok(clamped(v / 100.0))
    }
    val v = try plain_number(body, whole)
    return ok(clamped(v / 100.0))
}

// An angle in degrees, however it was written.
//
// **`grad` is tested before `rad` on purpose**: "grad" ends with "rad", so the obvious order reads
// 400 gradians as 400 radians and lands 57 times round the wheel from where it meant to.
fn angle(text: string, whole: string) -> Result<float, string> {
    val body = trim(text)
    if ends_with(body, "grad") {
        val v = try plain_number(substring(body, 0, len(body) - 4), whole)
        return ok(v * 0.9)
    }
    if ends_with(body, "turn") {
        val v = try plain_number(substring(body, 0, len(body) - 4), whole)
        return ok(v * 360.0)
    }
    if ends_with(body, "rad") {
        val v = try plain_number(substring(body, 0, len(body) - 3), whole)
        return ok(v * degrees_per_radian)
    }
    if ends_with(body, "deg") {
        return plain_number(substring(body, 0, len(body) - 3), whole)
    }
    return plain_number(body, whole)
}

// HSL to sRGB, and **private on purpose**.
//
// `parse` reads `hsl()` because it is a way of *writing one colour* -- it turns up in SVG files and
// in what design tools export -- and a notation is this function's whole reason to exist. HSL is
// **not** a working space here and there is no `hsl()` constructor or `to_hsl`: the algebra above
// is OKLab's, for the reasons `Oklab` gives, and a second space reachable from outside would invite
// a theme to be written half in each.
fn hsl_to_color(hue: float, saturation: float, lightness: float, alpha: float) -> Color {
    val s = clamped(saturation)
    val l = clamped(lightness)
    val chroma = (1.0 - math.abs(2.0 * l - 1.0)) * s
    val turned = hue - 360.0 * math.floor_float(hue / 360.0)
    val sector = turned / 60.0
    val second = chroma * (1.0 - math.abs(sector - 2.0 * math.floor_float(sector / 2.0) - 1.0))
    val base = l - chroma / 2.0
    if sector < 1.0 {
        return rgba(chroma + base, second + base, base, alpha)
    }
    if sector < 2.0 {
        return rgba(second + base, chroma + base, base, alpha)
    }
    if sector < 3.0 {
        return rgba(base, chroma + base, second + base, alpha)
    }
    if sector < 4.0 {
        return rgba(base, second + base, chroma + base, alpha)
    }
    if sector < 5.0 {
        return rgba(second + base, base, chroma + base, alpha)
    }
    return rgba(chroma + base, base, second + base, alpha)
}

fn hsl_colour(whole: string, key: string) -> Result<Color, string> {
    val parts = try three_and_alpha(whole, key, "hsl()")
    val h = try angle(parts[0], whole)
    val s = try percentage(parts[1], whole)
    val l = try percentage(parts[2], whole)
    var a = 1.0
    if len(parts[3]) > 0 {
        a = try component(parts[3], 1.0, whole)
    }
    return ok(hsl_to_color(h, s, l, a))
}

fn oklab_colour(whole: string, key: string) -> Result<Color, string> {
    val parts = try three_and_alpha(whole, key, "oklab()")
    val lightness = try scaled_number(parts[0], 1.0, whole)
    val a_axis = try scaled_number(parts[1], 0.4, whole)
    val b_axis = try scaled_number(parts[2], 0.4, whole)
    var alpha = 1.0
    if len(parts[3]) > 0 {
        alpha = try component(parts[3], 1.0, whole)
    }
    return ok(oklab(clamped(lightness), a_axis, b_axis, alpha))
}

fn oklch_colour(whole: string, key: string) -> Result<Color, string> {
    val parts = try three_and_alpha(whole, key, "oklch()")
    val lightness = try scaled_number(parts[0], 1.0, whole)
    val chroma = try scaled_number(parts[1], 0.4, whole)
    val hue = try angle(parts[2], whole)
    var alpha = 1.0
    if len(parts[3]) > 0 {
        alpha = try component(parts[3], 1.0, whole)
    }
    return ok(oklch(clamped(lightness), math.max(0.0, chroma), hue, alpha))
}

fn functional(whole: string, key: string) -> Result<Color, string> {
    val parts = try three_and_alpha(whole, key, "rgb()")
    // Red, green and blue are bytes unless written as percentages; the alpha is a fraction unless
    // written as one. That asymmetry is CSS's, not this reader's.
    val r = try component(parts[0], 255.0, whole)
    val g = try component(parts[1], 255.0, whole)
    val b = try component(parts[2], 255.0, whole)
    var a = 1.0
    if len(parts[3]) > 0 {
        a = try component(parts[3], 1.0, whole)
    }
    return ok(rgba(r, g, b, a))
}

fn component(text: string, full: float, whole: string) -> Result<float, string> {
    var body = trim(text)
    var scale = full
    if ends_with(body, "%") {
        body = trim(substring(body, 0, len(body) - 1))
        scale = 100.0
    }
    val read = parse_float(body)
    if Err(why) = read {
        return err(concat("paint.parse: '", text, "' is not a number, in '", whole, "' (", why, ")"))
    }
    val v = try read
    return ok(clamped(v / scale))
}

fn clamped(v: float) -> float {
    if v < 0.0 {
        return 0.0
    }
    if v > 1.0 {
        return 1.0
    }
    return v
}

// `split` takes one separator and keeps the empties a run of spaces leaves, so this is the
// whitespace split the standard library does not have as a builtin.
fn words(s: string) -> [string] {
    val out = mutable_array_new<string>()
    for piece in split(s, " ") {
        if len(piece) > 0 {
            push(out, piece)
        }
    }
    return snapshot(out)
}

// One stop of a gradient: `offset` runs 0.0 to 1.0 along the gradient's own axis.
pub struct Stop {
    offset: float
    color: Color
}

pub fn stop_of(offset: float, color: Color) -> Stop {
    return Stop { offset: offset, color: color }
}

pub struct Linear {
    from: Point
    to: Point
    stops: [Stop]
}

pub struct Radial {
    centre: Point
    radius: float
    stops: [Stop]
}

// An image, placed by a matrix. The handle is an index into the scene's image table (phase 4);
// paints do not own images, so the same image can back several paints and be written once.
pub struct Tiled {
    image: int
    transform: Matrix
}

pub enum Paint {
    Solid(Color)
    LinearGradient(Linear)
    RadialGradient(Radial)
    Pattern(Tiled)
}

pub fn solid(c: Color) -> Paint {
    return Paint.Solid(c)
}

pub fn linear(from: Point, to: Point, stops: [Stop]) -> Paint {
    return Paint.LinearGradient(Linear { from: from, to: to, stops: stops })
}

pub fn radial(centre: Point, radius: float, stops: [Stop]) -> Paint {
    return Paint.RadialGradient(Radial { centre: centre, radius: radius, stops: stops })
}

// The constructor exists so the variant is reachable the same way the others are; **no backend
// draws it yet**, and both say so rather than painting nothing (lib/graphics/pdf.zm).
pub fn pattern(image: int, transform: Matrix) -> Paint {
    return Paint.Pattern(Tiled { image: image, transform: transform })
}

pub enum Cap {
    Butt
    Round
    Square
}

pub enum Join {
    Miter
    Round
    Bevel
}

// How a line is drawn. **Parameters, not an outline**: PDF has native `w`, `J`, `j`, `M` and `d`
// operators, so the PDF backend passes these straight through and a stroked hairline stays a
// hairline at any zoom. Only the raster backend turns a stroke into a fillable outline (phase 5).
// Java 2D's `Stroke.createStrokedShape` is the right fallback and the wrong only path.
pub struct Stroke {
    width: float
    cap: Cap
    join: Join
    // Past this ratio a miter join becomes a bevel. Without the fallback a near-180 degree join
    // produces a spike thousands of units long, which is the classic stroking bug.
    miter_limit: float
    // Empty for a solid line. Otherwise alternating on and off lengths.
    dash: [float]
    dash_phase: float
}

// The common case: butt caps, miter joins, PDF's and PostScript's default limit of 10, no dash.
pub fn stroke_of(width: float) -> Stroke {
    return Stroke {
        width: width,
        cap: Cap.Butt,
        join: Join.Miter,
        miter_limit: 10.0,
        dash: [],
        dash_phase: 0.0
    }
}

pub fn dashed(width: float, dash: [float]) -> Stroke {
    return with stroke_of(width) {
        dash: dash
    }
}
