// paint.zm -- what fills a region, and how a line is drawn.
//
// **The paint set is closed, and that is the central decision of this library.** Java 2D's `Paint`
// is an interface whose implementations produce pixels (`createContext` hands back a `Raster`), so
// any paint a backend does not recognise forces rasterisation -- which is why PDF output from Java
// 2D quietly degrades to embedded bitmaps. Cairo makes the same set closed (six cases) and then
// reopens it with one callback variant, and its PDF backend rasterises "fallback regions" for
// exactly that reason.
//
// These four cases are what PDF has native shading dictionaries for, so every paint here survives
// as vectors in both backends. Adding a fifth means adding it to both, on purpose.
use geom.Matrix
use geom.Point
use locale
use math

// Case folding here is **protocol folding**, so it names the invariant locale rather than taking
// whatever a program set as its default: Turkish folds `I` to `ı`, and a header name, a hex digit, a
// media type or an identifier compared under a user's language is a bug. Hoisted to a `val` because
// some of these sit in per-character loops and `locale.root()` is a call.
val invariant: Locale = locale.root()

// Components are 0.0 to 1.0, not bytes, because PDF writes colour as decimals (`rg`, `RG`) and a
// raster backend converts to bytes once at the end. Bytes in the middle would lose precision in a
// gradient for nothing.
pub struct Color {
    red: float
    green: float
    blue: float
    alpha: float
}

pub fn rgb(r: float, g: float, b: float) -> Color {
    return Color { red: r, green: g, blue: b, alpha: 1.0 }
}

pub fn rgba(r: float, g: float, b: float, a: float) -> Color {
    return Color { red: r, green: g, blue: b, alpha: a }
}

pub fn gray(level: float) -> Color {
    return Color { red: level, green: level, blue: level, alpha: 1.0 }
}

// Functions rather than `pub val`s: a module-qualified global val is not reachable as
// `paint.black` -- Ziman asks for `use paint.black` and a bare name -- and a caller who has written
// `use paint` should not then need a second import per colour. The same reason `identity()` and
// `empty_rect()` in `geom` are functions.
pub fn black() -> Color {
    return Color { red: 0.0, green: 0.0, blue: 0.0, alpha: 1.0 }
}

pub fn white() -> Color {
    return Color { red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0 }
}

pub fn transparent() -> Color {
    return Color { red: 0.0, green: 0.0, blue: 0.0, alpha: 0.0 }
}

// `#rgb`, `#rrggbb` or `#rrggbbaa`, with or without the leading `#`. An Err names what it could not
// read, since a colour typo is otherwise a silent black.
pub fn hex(text: string) -> Result<Color, string> {
    var body = trim(text)
    if starts_with(body, "#") {
        body = substring(body, 1, len(body))
    }
    val n = len(body)
    if n != 3 && n != 6 && n != 8 {
        return err(concat("paint.hex: expected 3, 6 or 8 hex digits, got '", text, "'"))
    }
    if n == 3 {
        val r = try nibble(body, 0, text)
        val g = try nibble(body, 1, text)
        val b = try nibble(body, 2, text)
        // `#abc` means `#aabbcc`, so each digit is doubled rather than scaled -- `#fff` is white.
        return ok(rgba(r * 17.0 / 255.0, g * 17.0 / 255.0, b * 17.0 / 255.0, 1.0))
    }
    val r = try byte_at(body, 0, text)
    val g = try byte_at(body, 2, text)
    val b = try byte_at(body, 4, text)
    var a = 1.0
    if n == 8 {
        a = try byte_at(body, 6, text)
    }
    return ok(rgba(r, g, b, a))
}

fn nibble(body: string, at: int, whole: string) -> Result<float, string> {
    val digits = "0123456789abcdef"
    val c = to_lower(substring(body, at, at + 1), invariant)
    val i = index_of(digits, c, 0)
    if i < 0 {
        return err(concat("paint.hex: '", c, "' is not a hex digit, in '", whole, "'"))
    }
    return ok(i as float)
}

fn byte_at(body: string, at: int, whole: string) -> Result<float, string> {
    val hi = try nibble(body, at, whole)
    val lo = try nibble(body, at + 1, whole)
    return ok((hi * 16.0 + lo) / 255.0)
}

// Bytes rather than fractions, because that is how a document writes a colour: `rgb(240, 248, 255)`
// and `#f0f8ff` are the same colour and neither of them is written as a float.
//
// **Out of range clamps rather than refusing**, which is what CSS says to do and what every browser
// does: a reader that rejects `rgb(300, 0, 0)` rejects a file everything else draws.
pub fn rgb8(r: int, g: int, b: int) -> Color {
    return rgba8(r, g, b, 255)
}

pub fn rgba8(r: int, g: int, b: int, a: int) -> Color {
    return Color {
        red: byte_fraction(r),
        green: byte_fraction(g),
        blue: byte_fraction(b),
        alpha: byte_fraction(a)
    }
}

// One channel of sRGB, linearised: the first half of WCAG's relative luminance.
//
// **The constants are the specification's**, not approximations of it -- 0.03928 and the 2.4
// exponent are what WCAG 2.1 §1.4.3 states, and a gamma of 2.2 applied to the whole channel is
// the usual near-miss.
fn linear_channel(c: float) -> float {
    if c <= 0.03928 {
        return c / 12.92
    }
    return math.pow((c + 0.055) / 1.055, 2.4)
}

// How light a colour is to the eye, between 0 and 1.
//
// **Not the average of the channels, and not `gray`'s level.** Green carries nearly three quarters
// of perceived lightness and blue under a fourteenth, which is why a pure blue on black fails a
// contrast check that a pure green passes -- and why a palette chosen by eye from hex digits
// drifts. Alpha is ignored: a translucent colour has no luminance until it is over something, and
// the caller is the only one who knows what.
pub fn relative_luminance(c: Color) -> float {
    return 0.2126 * linear_channel(c.red) + 0.7152 * linear_channel(c.green) +
        0.0722 * linear_channel(c.blue)
}

// WCAG's contrast ratio between two colours: 1.0 for a colour against itself, 21.0 for black
// against white.
//
// **Symmetric by construction** -- the lighter over the darker -- so there is no "foreground" and
// "background" argument to get the wrong way round. AA wants 4.5 for body text and 3.0 for large
// text or a control's edge; AAA wants 7.0.
//
// Here rather than in the one application that needed it: `gallery/ui/desktop/highlight.zm` had
// this and `relative_luminance` written out, which is a general fact about colour sitting in a
// program about syntax colouring. `lib/ui/theme` now asserts every shipped look against it.
pub fn contrast_ratio(a: Color, b: Color) -> float {
    val la = relative_luminance(a)
    val lb = relative_luminance(b)
    if la > lb {
        return (la + 0.05) / (lb + 0.05)
    }
    return (lb + 0.05) / (la + 0.05)
}

// Radians to degrees, hoisted for the reason `invariant` above is: `to_oklch` and `oklch` are the
// two ends of one conversion and a literal written twice is a literal that can disagree with
// itself. `math` has no pi.
val degrees_per_radian: float = 57.295779513082320876798154814105

// A colour in OKLab: a lightness that matches the eye, and two opponent axes.
//
// **This is the space every derived colour in this library is computed in**, and the reason is that
// its lightness is perceptually uniform -- equal steps of `lightness` look like equal steps, which
// is what makes a tonal scale a scale rather than a list of numbers that happen to be ordered.
// HSL's lightness is not that: `lighten` in HSL barely moves a blue and blows out a yellow, and
// drifts the hue while doing it. FlatLaf's `autoInverse` option exists to paper over exactly that
// -- it reverses the direction of a lighten above 65% lightness -- and there is nothing here for
// such a flag to correct.
//
// Alpha is carried through so that a round trip loses nothing. The axes are roughly -0.4 to 0.4 for
// colours sRGB can show.
pub struct Oklab {
    lightness: float
    a: float
    b: float
    alpha: float
}

// The same colour with the two axes read as a distance from grey and an angle.
//
// **This is the form a palette is built in**: hold `hue` and `chroma` and step `lightness`, and the
// result is a ramp whose every entry belongs to the same colour. `hue` is in degrees, 0 to 360.
pub struct Oklch {
    lightness: float
    chroma: float
    hue: float
    alpha: float
}

// **Signed, because the matrices below produce negative values for colours outside sRGB** and
// `math.pow` of a negative base is not a number. A cube root is defined there and a power is not.
fn cube_root(x: float) -> float {
    if x < 0.0 {
        return -math.pow(-x, 1.0 / 3.0)
    }
    return math.pow(x, 1.0 / 3.0)
}

// sRGB's own transfer function, which is **not quite `linear_channel` above** -- that one is
// WCAG's, whose threshold the specification states as 0.03928 where sRGB's is 0.04045.
//
// **Two linearisations in one file is deliberate, not an oversight.** `relative_luminance` must
// answer what WCAG says it answers, because a contrast ratio is a claim measured against that
// document; OKLab must use sRGB's, because that is what the matrices were fitted to. The two differ
// only below about 4% brightness and by less than a part in a thousand, and the right response to
// that is to use each where it belongs rather than to pick a favourite.
fn srgb_to_linear(v: float) -> float {
    if v <= 0.04045 {
        return v / 12.92
    }
    return math.pow((v + 0.055) / 1.055, 2.4)
}

// Back to sRGB.
//
// **A last guard, not the gamut strategy.** `fitted` below has already reduced the chroma until the
// colour fits, so a channel arriving here is in range bar arithmetic error, and this clamp is for
// that error. The first draft of this file clipped *instead* of fitting, and its own tests caught
// what that costs -- `fitted` says what.
fn encoded(v: float) -> float {
    val linear = clamped(v)
    if linear <= 0.0031308 {
        return clamped(linear * 12.92)
    }
    return clamped(1.055 * math.pow(linear, 1.0 / 2.4) - 0.055)
}

// The three linear-light channels an OKLab triple asks for, before anything is clamped. Its own
// type because the gamut search has to ask whether a colour fits **without** building it.
//
// Not `Linear`, which is already the gradient below.
struct Channels {
    red: float
    green: float
    blue: float
}

fn linear_of(lightness: float, a: float, b: float) -> Channels {
    val long = lightness + 0.3963377774 * a + 0.2158037573 * b
    val middle = lightness - 0.1055613458 * a - 0.0638541728 * b
    val short = lightness - 0.0894841775 * a - 1.2914855480 * b
    val l3 = long * long * long
    val m3 = middle * middle * middle
    val s3 = short * short * short
    return Channels {
        red: 4.0767416621 * l3 - 3.3077115913 * m3 + 0.2309699292 * s3,
        green: -1.2684380046 * l3 + 2.6097574011 * m3 - 0.3413193965 * s3,
        blue: -0.0041960863 * l3 - 0.7034186147 * m3 + 1.7076147010 * s3
    }
}

// A tenth of a byte's worth of slack, so a colour sRGB can just about show is not sent through the
// search by arithmetic error alone.
val gamut_slack: float = 0.0004

fn shows(v: Channels) -> bool {
    return v.red >= -gamut_slack && v.red <= 1.0 + gamut_slack && v.green >= -gamut_slack &&
        v.green <= 1.0 + gamut_slack && v.blue >= -gamut_slack && v.blue <= 1.0 + gamut_slack
}

fn hue_of(a: float, b: float) -> float {
    val degrees = math.atan2(b, a) * degrees_per_radian
    if degrees < 0.0 {
        return degrees + 360.0
    }
    return degrees
}

// A colour sRGB can show: the lightness and hue that were asked for, with **the chroma reduced
// until it fits**.
//
// **Not a per-channel clip, and that difference is the whole predictability argument.** Clipping
// each channel separately changes the lightness, because the channel that overflowed is pinned
// while the others keep moving. Measured: ask a saturated blue to lighten by a tenth and a clip
// answers with six hundredths -- `lighten` stops meaning the same thing on every hue, which is the
// entire reason this library works in OKLab, and the clip takes it back without saying so. Holding
// the two coordinates a theme cares about and giving way on the third is what keeps the promise.
//
// **This was found by a test, not by reading.** The first draft clipped, and
// `an_equal_step_is_an_equal_step_whatever_the_hue` failed on pure blue -- the claim in `Oklab`'s
// own comment, refuted by the implementation underneath it. The reasoning that let it through is
// worth recording because it is plausible and wrong: *a ramp starts from a colour sRGB already
// holds, so clipping cannot bite*. The start is in gamut; the steps need not be, and a ramp is made
// of steps.
//
// CSS Color 4 gamut-maps the same way and for the same reason. Eighteen halvings take 0.4 to under
// two millionths, far finer than a byte of colour.
fn fitted(lightness: float, chroma: float, hue: float, alpha: float) -> Color {
    val radians = hue / degrees_per_radian
    val cosine = math.cos(radians)
    val sine = math.sin(radians)
    val wanted = math.max(0.0, chroma)
    var low = 0.0
    if shows(linear_of(lightness, wanted * cosine, wanted * sine)) {
        low = wanted
    } else {
        var high = wanted
        var left = 18
        while left > 0 {
            val mid = (low + high) / 2.0
            if shows(linear_of(lightness, mid * cosine, mid * sine)) {
                low = mid
            } else {
                high = mid
            }
            left = left - 1
        }
    }
    val v = linear_of(lightness, low * cosine, low * sine)
    return Color {
        red: encoded(v.red),
        green: encoded(v.green),
        blue: encoded(v.blue),
        alpha: clamped(alpha)
    }
}

// The matrices are Björn Ottosson's, who fitted OKLab in 2020 against a perceptual dataset: sRGB to
// linear, linear to a cone response, the cube root of that, and a final rotation.
pub fn to_oklab(c: Color) -> Oklab {
    val r = srgb_to_linear(clamped(c.red))
    val g = srgb_to_linear(clamped(c.green))
    val b = srgb_to_linear(clamped(c.blue))
    val long = cube_root(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
    val middle = cube_root(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
    val short = cube_root(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
    return Oklab {
        lightness: 0.2104542553 * long + 0.7936177850 * middle - 0.0040720468 * short,
        a: 1.9779984951 * long - 2.4285922050 * middle + 0.4505937099 * short,
        b: 0.0259040371 * long + 0.7827717662 * middle - 0.8086757660 * short,
        alpha: c.alpha
    }
}

pub fn oklab(lightness: float, a: float, b: float) -> Color {
    return oklab(lightness, a, b, 1.0)
}

// **Through polar coordinates, so that both notations get the same gamut treatment.** An OKLab
// triple outside sRGB has a hue just as an OKLCH one does, and fitting it by reducing chroma is
// the right answer whichever way the caller spelled the colour.
pub fn oklab(lightness: float, a: float, b: float, alpha: float) -> Color {
    return fitted(lightness, math.sqrt(a * a + b * b), hue_of(a, b), alpha)
}

pub fn to_oklch(c: Color) -> Oklch {
    val v = to_oklab(c)
    return Oklch {
        lightness: v.lightness,
        chroma: math.sqrt(v.a * v.a + v.b * v.b),
        hue: hue_of(v.a, v.b),
        alpha: v.alpha
    }
}

pub fn oklch(lightness: float, chroma: float, hue: float) -> Color {
    return oklch(lightness, chroma, hue, 1.0)
}

pub fn oklch(lightness: float, chroma: float, hue: float, alpha: float) -> Color {
    return fitted(lightness, chroma, hue, alpha)
}

// **`amount` is a distance in lightness, not a percentage of anything.** `lighten(c, 0.1)` raises
// the colour's lightness by a tenth of the full range, and because that range is perceptual the
// same tenth looks like the same step on a blue as on a yellow. A percentage of the *remaining*
// headroom -- which is what a naive implementation does -- gives a different visual step for every
// starting colour, so a theme written with it has to be re-tuned per colour.
pub fn lighten(c: Color, amount: float) -> Color {
    val v = to_oklch(c)
    return oklch(clamped(v.lightness + amount), v.chroma, v.hue, v.alpha)
}

pub fn darken(c: Color, amount: float) -> Color {
    return lighten(c, -amount)
}

// Chroma has no fixed ceiling -- how much a hue can hold depends on the hue -- so this floors at
// grey and lets `encoded` clip whatever sRGB cannot show.
pub fn saturate(c: Color, amount: float) -> Color {
    val v = to_oklch(c)
    return oklch(v.lightness, math.max(0.0, v.chroma + amount), v.hue, v.alpha)
}

pub fn desaturate(c: Color, amount: float) -> Color {
    return saturate(c, -amount)
}

// The three absolute setters, for a palette that states its steps rather than nudging them: this is
// what a tonal ramp is built from, holding two coordinates and walking the third.
pub fn change_lightness(c: Color, lightness: float) -> Color {
    val v = to_oklch(c)
    return oklch(clamped(lightness), v.chroma, v.hue, v.alpha)
}

pub fn change_chroma(c: Color, chroma: float) -> Color {
    val v = to_oklch(c)
    return oklch(v.lightness, math.max(0.0, chroma), v.hue, v.alpha)
}

pub fn change_hue(c: Color, hue: float) -> Color {
    val v = to_oklch(c)
    return oklch(v.lightness, v.chroma, hue, v.alpha)
}

// Alpha set outright, in sRGB, because transparency is not a colour: putting it through OKLab and
// back would clip the colour's channels for no reason at all.
pub fn fade(c: Color, alpha: float) -> Color {
    return rgba(c.red, c.green, c.blue, clamped(alpha))
}

// `at` is 0.0 for `a` and 1.0 for `b`, an interpolation parameter and not a weight -- the reading
// `stop_of` already uses for a gradient's offset.
//
// **Mixed on the opponent axes rather than through hue and chroma.** Interpolating a hue angle
// between a grey and a colour means interpolating an angle that one end does not have, and taking
// the short way round two saturated colours swings the mixture through hues in neither of them.
// Rectangular mixing is also what CSS's `color-mix(in oklab, ...)` does, for the same reason.
pub fn mix(a: Color, b: Color, at: float) -> Color {
    val t = clamped(at)
    val from = to_oklab(a)
    val to = to_oklab(b)
    return oklab(
        from.lightness + (to.lightness - from.lightness) * t,
        from.a + (to.a - from.a) * t,
        from.b + (to.b - from.b) * t,
        from.alpha + (to.alpha - from.alpha) * t
    )
}

pub fn tint(c: Color, at: float) -> Color {
    return mix(c, white(), at)
}

pub fn shade(c: Color, at: float) -> Color {
    return mix(c, black(), at)
}

// Whichever of two inks reads better on `c`.
//
// **Decided by `contrast_ratio`, which is the gate's own function**, so a colour chosen here cannot
// be one the contrast test then rejects in favour of the alternative -- the choice and the check
// agree by construction. Judging by lightness instead, which is the usual shortcut, picks the wrong
// ink at exactly the mid-tones where the two are closest and it matters most.
//
// Two candidates rather than a computed ink, because a theme's dark and light inks are decisions
// someone made: this answers which of them to use, not what they should be.
pub fn contrast(c: Color, dark: Color, light: Color) -> Color {
    if contrast_ratio(dark, c) >= contrast_ratio(light, c) {
        return dark
    }
    return light
}

fn byte_fraction(v: int) -> float {
    if v <= 0 {
        return 0.0
    }
    if v >= 255 {
        return 1.0
    }
    return (v as float) / 255.0
}

// **The 148 colour names CSS and SVG share**, or `None` for a name that is not one of them. Case
// is folded under the invariant locale, because a colour name read out of a file is protocol text:
// a Turkish locale folds the `I` of `Indigo` to a dotless `i` and the name stops matching.
//
// **`transparent` is deliberately absent**, because it is not one of the 148 -- it is a keyword CSS
// accepts wherever a colour is allowed, and `parse` answers it. `none` is likewise not a colour but
// an instruction not to paint, which only the caller can act on.
//
// The table is generated from the list every browser agrees on (Python's
// `PIL.ImageColor.colormap`, the CSS3/SVG set) and then committed, because the set is closed: the
// last addition was `rebeccapurple` in 2014, in memory of Eric Meyer's daughter. One value is
// checkable in a line -- `python3 -c "from PIL import ImageColor;
// print(ImageColor.colormap['papayawhip'])"`.
//
// Grouped by first letter rather than written flat for the reason `charset.table_named` is: a flat
// chain of this length pays for every name before the one it wants, and the grouping turns 148
// comparisons into at most 21.
pub fn named(name: string) -> Option<Color> {
    val key = to_lower(trim(name), invariant)
    if len(key) == 0 {
        return Option<Color>.None
    }
    if starts_with(key, "a") {
        if key == "aliceblue" { return Option<Color>.Some(rgb8(240, 248, 255)) }
        if key == "antiquewhite" { return Option<Color>.Some(rgb8(250, 235, 215)) }
        if key == "aqua" { return Option<Color>.Some(rgb8(0, 255, 255)) }
        if key == "aquamarine" { return Option<Color>.Some(rgb8(127, 255, 212)) }
        if key == "azure" { return Option<Color>.Some(rgb8(240, 255, 255)) }
        return Option<Color>.None
    }
    if starts_with(key, "b") {
        if key == "beige" { return Option<Color>.Some(rgb8(245, 245, 220)) }
        if key == "bisque" { return Option<Color>.Some(rgb8(255, 228, 196)) }
        if key == "black" { return Option<Color>.Some(rgb8(0, 0, 0)) }
        if key == "blanchedalmond" { return Option<Color>.Some(rgb8(255, 235, 205)) }
        if key == "blue" { return Option<Color>.Some(rgb8(0, 0, 255)) }
        if key == "blueviolet" { return Option<Color>.Some(rgb8(138, 43, 226)) }
        if key == "brown" { return Option<Color>.Some(rgb8(165, 42, 42)) }
        if key == "burlywood" { return Option<Color>.Some(rgb8(222, 184, 135)) }
        return Option<Color>.None
    }
    if starts_with(key, "c") {
        if key == "cadetblue" { return Option<Color>.Some(rgb8(95, 158, 160)) }
        if key == "chartreuse" { return Option<Color>.Some(rgb8(127, 255, 0)) }
        if key == "chocolate" { return Option<Color>.Some(rgb8(210, 105, 30)) }
        if key == "coral" { return Option<Color>.Some(rgb8(255, 127, 80)) }
        if key == "cornflowerblue" { return Option<Color>.Some(rgb8(100, 149, 237)) }
        if key == "cornsilk" { return Option<Color>.Some(rgb8(255, 248, 220)) }
        if key == "crimson" { return Option<Color>.Some(rgb8(220, 20, 60)) }
        if key == "cyan" { return Option<Color>.Some(rgb8(0, 255, 255)) }
        return Option<Color>.None
    }
    if starts_with(key, "d") {
        if key == "darkblue" { return Option<Color>.Some(rgb8(0, 0, 139)) }
        if key == "darkcyan" { return Option<Color>.Some(rgb8(0, 139, 139)) }
        if key == "darkgoldenrod" { return Option<Color>.Some(rgb8(184, 134, 11)) }
        if key == "darkgray" { return Option<Color>.Some(rgb8(169, 169, 169)) }
        if key == "darkgreen" { return Option<Color>.Some(rgb8(0, 100, 0)) }
        if key == "darkgrey" { return Option<Color>.Some(rgb8(169, 169, 169)) }
        if key == "darkkhaki" { return Option<Color>.Some(rgb8(189, 183, 107)) }
        if key == "darkmagenta" { return Option<Color>.Some(rgb8(139, 0, 139)) }
        if key == "darkolivegreen" { return Option<Color>.Some(rgb8(85, 107, 47)) }
        if key == "darkorange" { return Option<Color>.Some(rgb8(255, 140, 0)) }
        if key == "darkorchid" { return Option<Color>.Some(rgb8(153, 50, 204)) }
        if key == "darkred" { return Option<Color>.Some(rgb8(139, 0, 0)) }
        if key == "darksalmon" { return Option<Color>.Some(rgb8(233, 150, 122)) }
        if key == "darkseagreen" { return Option<Color>.Some(rgb8(143, 188, 143)) }
        if key == "darkslateblue" { return Option<Color>.Some(rgb8(72, 61, 139)) }
        if key == "darkslategray" { return Option<Color>.Some(rgb8(47, 79, 79)) }
