fn hex4(cp: int) -> string {
    val digits = "0123456789ABCDEF"
    var n = cp
    var out = ""
    var i = 0
    while i < 4 {
        val d = n % 16
        out = concat(substring(digits, d, d + 1), out)
        n = n / 16
        i = i + 1
    }
    return out
}
