// raster.zm -- the second backend: a `Scene` to an `Image`.
//
// The PDF backend is a serialiser; this one has to *do* what a PDF reader was doing. Three
// separable pieces live here -- scan-conversion, stroking, and glyph rendering -- and they land in
// that order, because each is testable without the next and the first is the one the other two are
// written in terms of.
//
// **Correct first, and measured rather than guessed at.** The design note for this phase says the
// first version should be obviously correct and measured before it is made fast, because this
// project's history is full of structurally obvious optimisations that measured worse. Two were
// kept because they were measured, both with the output byte-identical: bounding a fill to its own
// horizontal extent (1.6x) and evaluating a `Solid` paint once per fill instead of once per pixel
// (a further 1.33x). Together 3592 ms to 1667 ms for a 600x800 page of 400 round rectangles at
// `samples: 4`.
//
// **What is still slow, measured and not fixed here.** `crossings_at` walks the whole edge list for
// every sub-scanline, so cost grows with (rows x samples x edges). Holding the samples at 1 and
// raising them to 8 moves that page from 1730 ms to 2863 ms, which puts roughly 160 ms per sample
// step in the edge scan and leaves about 1570 ms that sampling does not touch -- the per-pixel loop
// and plain interpreter overhead. The textbook fix is an active edge table (edges sorted by y, a
// list maintained across scanlines), which would cut the scan by about the edge count; it is not
// here because part 1's job is to be right, and because that is a change worth measuring against
// text, which is the workload with the most edges and does not exist yet.
use font
use geom.Matrix
use geom.Point
use geom.Rect
use geom.identity
use geom.invert
use geom.matrix_concat
use geom.point_of
use geom.rect_of
use geom.transform_point
use image
use math.ceil
use math.floor
use math.round
use math.sqrt
use paint.Color
use paint.Paint
use paint.Stop
use scene
use scene.Op
use scene.Scene
use shape.Path
use shape.Segment
use shape.Winding
use stroker
use truetype

// Quarter of a pixel, which is the tolerance the design settled on: looser and a large circle
// visibly facets, tighter and a page of text costs many times what it should for a difference
// nobody can see.
val flatten_tolerance: float = 0.25

// Subdivision is adaptive, so this cap is not the quality knob -- it only bounds the work a
// pathological curve (a cusp, or control points at infinity) can ask for.
val max_subdivision: int = 16

pub struct Options {
    format: image.Pixels
    // Anti-aliasing: vertical sub-scanlines per pixel row. 1 is none, 4 is good, 16 is as much as
    // this method can usefully give. Horizontal coverage is *exact* either way -- see `add_span` --
    // so this number only quantises the vertical direction.
    samples: int
    // What the canvas starts as. `None` is transparent, which an `Rgb8` or `Gray8` output then
    // flattens to black, because those formats have nowhere to keep the transparency.
    background: Option<Color>
    // The images `DrawImage` and `paint.Pattern` index into, exactly as `pdf.Options` carries them.
    images: [image.Image]
    // The faces a `TextRun` indexes, the same table `pdf.Options` has. **Only embedded faces can be
    // drawn here**: the standard fourteen are names a PDF reader resolves against fonts it already
    // has, and a raster device has no such library to resolve against.
    fonts: [font.FontRef]
    // The same guard `image.decode_png` takes, for the same reason: a scene's size can come from a
    // request, and a 50000x50000 page should be a message rather than 40 GB of allocation.
    max_pixels: int
    // How many device pixels one unit of the scene becomes.
    //
    // **This is what makes the scene's units points rather than pixels**, and it is here rather
    // than on `scene.Scene` deliberately: a `Scene` still does not know what a unit is -- its own
    // comment promises that the backend decides -- and this is the backend deciding. The PDF
    // backend reads the same scene as points at 1/72 inch and wants no such field.
    //
    // 1.0 means a point is a pixel, which is the default and what every existing caller gets.
    // 1.5 means a 100-unit box is drawn 150 pixels wide, with glyph *outlines* scaled before being
    // rasterised rather than a 12-unit bitmap stretched -- so text at 1.5 is 18 real pixels of
    // type, not a blurred 12.
    //
    // A fractional ratio leaves a one-unit line straddling two pixels, which reads grey rather
    // than black. Accepted here, as CSS and Flutter accept it: snapping thin edges to whole pixels
    // is a rendering feature, not a property of the unit.
    px_per_pt: float
}

pub fn options() -> Options {
    return Options {
        format: image.Pixels.Rgba8,
        samples: 4,
        background: Option<Color>.None,
        images: [],
        fonts: [],
        max_pixels: 4000000,
        px_per_pt: 1.0
    }
}

// Premultiplied, because every blend here is in premultiplied alpha. Gradient interpolation
// especially: lerping *un*-premultiplied colour toward a transparent stop darkens through the
// middle, which reads as a rendering bug rather than as the arithmetic mistake it is.
struct Premul {
    red: float
    green: float
    blue: float
    alpha: float
}

fn premul_of(c: Color) -> Premul {
    return Premul { red: c.red * c.alpha, green: c.green * c.alpha, blue: c.blue * c.alpha, alpha: c.alpha }
}

// An image placed into a rectangle. `DrawImage` is not a `Paint`, but it is the same operation from
// the span loop's point of view -- a function from a point to a colour -- so it joins the paints
// here rather than growing a second fill path.
struct Tile {
    handle: int
    into: Rect
}

enum Ink {
    FromPaint(Paint)
    FromImage(Tile)
}

// The accumulation buffer: premultiplied RGBA, four floats a pixel. `[float]` is packed storage in
// this language, so this is 16 bytes a pixel of pointer-free memory the collector never scans, not
// four boxed values.
struct Target {
    width: int
    height: int
    data: MutableArray<float>
    // **The pixels this pass may write, inclusive** -- the whole canvas unless a caller narrowed it
    // with `draw_into_region`.
    //
    // It lives here rather than in a parameter because *every* drawing function needs it and almost
    // none of them would use it directly: `fill_shape` and `blit` are the only two that touch
    // pixels, and a parameter would have had to thread through `draw_ops`, `draw_text`, `clear_to`
    // and the group recursion to reach them. A `Target` is a handle to a canvas plus the terms on
    // which it may be written, which is what these four numbers are.
    //
    // **Not a clip.** A clip in this renderer is a full-canvas coverage mask (`clip_mask`), which is
    // an allocation of width*height floats and a read per pixel -- exactly what a damage region
    // exists to avoid. These four ints narrow the loops instead, so a small region costs nothing
    // beyond the pixels it covers.
    win_x0: int
    win_y0: int
    win_x1: int
    win_y1: int
    // Rasterised glyphs, keyed by shape and subpixel position. Per *render*, deliberately: a cache
    // that outlived the call would need invalidating when a face changed and bounding so a
    // long-lived process could not grow one forever. A page is where the reuse is anyway.
    glyphs: MutableMap<string, GlyphTile>
}

// One glyph, already rasterised: coverage in 0..1 over a small box, with the box's position given
// relative to the integer pixel the pen landed on.
struct GlyphTile {
    left: int
    top: int
    width: int
    height: int
    cover: [float]
}

// Non-horizontal edges only, four floats each (x0, y0, x1, y1), in device space. A horizontal edge
// crosses no scanline, so dropping it here means the span loop never has to special-case the
// division by zero.
struct Edges {
    xy: [float]
    min_x: float
    max_x: float
    min_y: float
    max_y: float
}

// A render target held across frames, so that repainting does not allocate one.
//
// **Called a surface and not a canvas because `image.Canvas` already exists one module away** and
// is a different thing: a buffer of bytes a caller sets pixels on by hand. This is an accumulation
// buffer of floats that `render_into` writes whole scenes to, and the name every library that has
// both uses for it.
//
// **This exists because the probe said so.** A render asks `new_target` for `width * height * 4`
// floats -- 4,096,000 at 1280x800, measured at 16.5 ms a frame to allocate and zero, with the
// collector warning about the repeated 32 MB block of its own accord. That, and the collection it
// causes, was about a quarter of a frame: more than the edge walk and twice the character map, and
// nothing that could be fixed by moving a loop to C, because the cost is asking for the memory at
// all. `render` keeps doing exactly that, because a one-off render of a page should not have to
// manage one; a window repainting sixty times a second should.
//
// **It also keeps the glyph cache**, which `render` throws away per call. The comment on `Target`
// explains that choice -- a cache outliving the call "would need invalidating when a face changed
// and bounding so a long-lived process could not grow one forever. A page is where the reuse is
// anyway." That was right when the target was a page. F269 and F277 make it a window, so the reuse
// is across frames, and the two conditions it names are met here: the key now carries
// `truetype.face_id`, so a changed face cannot be served a stale entry, and the cache is bounded
// below.
//
// Holds a `MutableArray` and a `MutableMap`, so **a surface belongs to the thread that made it** and
// using it from another fails at run time. One thread paints a window; that is the shape of every
// toolkit and of F269's event loop.
pub struct Surface {
    target: Target
    // How many rasterised glyphs to keep -- `glyph_cache_limit` unless a caller says otherwise.
    //
    // **A field rather than only a constant, so that the bound can be tested.** An untested bound
    // in a long-lived process is the thing `Target`'s comment was worried about, and a fixture
    // cannot reach 8192 distinct glyphs without a font and a minute; with a surface of limit 2 it
    // takes three renders. `with s { glyph_limit: 2 }` is how a test asks.
    glyph_limit: int
}

// How many rasterised glyphs a surface keeps before it starts again.
//
// Checked once at the **start** of a frame rather than on each insertion, which matters: a frame
// needing more than this still gets a working cache for its whole length and pays once, where
// evicting on insertion would thrash inside the frame and be slower than no cache at all.
//
// Dropped wholesale rather than least-recently-used, because an LRU needs a linked list and an
// order to maintain per hit, and the next frame refills what it actually draws. A window whose text
// is stable never reaches this; one that does is paying a fraction of what it would pay to
// re-rasterise everything every frame.
//
// 8192 entries: a glyph is keyed by face, transform, id and one of sixteen subpixel positions, so
// this is a few hundred distinct glyphs across a handful of sizes.
pub val glyph_cache_limit = 8192

// A surface of a fixed pixel size. Reused by `render_into` for as many frames as the window keeps
// that size; a resize makes a new one, which is the right trade because a resize is rare and a
// repaint is not.
// Takes **scene units and the ratio, not pixels, so that a surface and a scene cannot disagree.**
// An application sizes its window in points; the surface has to be however many pixels those points
// come to. Given pixels directly, one number would be derived in two places, and the first caller
// to set a ratio other than 1.0 would meet `render_into`'s size refusal -- a correct error about a
// mistake that did not need to be possible.
pub fn surface_of(width_pt: float, height_pt: float, px_per_pt: float) -> Result<Surface, string> {
    if px_per_pt <= 0.0 || px_per_pt > 64.0 {
        return err(format("raster: px_per_pt must be above 0 and at most 64, got {}", px_per_pt))
    }
    if width_pt <= 0.0 || height_pt <= 0.0 {
        return err(concat(
            "raster: a surface must be larger than nothing, got ",
            format("{}", width_pt),
            "x",
            format("{}", height_pt)
        ))
    }
    val width = ceil(width_pt * px_per_pt)
    val height = ceil(height_pt * px_per_pt)
    // The same ceiling `Options.max_pixels` defends, applied here because a surface is allocated
    // before any `Options` exists to ask.
    if width > 16384 || height > 16384 {
        return err(concat(
            "raster: a surface may be at most 16384 pixels on a side, got ",
            str(width),
            "x",
            str(height)
        ))
    }
    return ok(Surface { target: new_target(width, height), glyph_limit: glyph_cache_limit })
}

pub fn surface_width(c: Surface) -> int {
    return c.target.width
}

pub fn surface_height(c: Surface) -> int {
    return c.target.height
}

// How many glyphs the surface is holding -- for a caller that wants to see the cache working, and
// for the test that proves it does.
pub fn cached_glyphs(c: Surface) -> int {
    return len(c.target.glyphs)
}

// A scene onto a surface the caller owns, reusing its pixels and its glyph cache.
//
// **The scene must be exactly the surface's size**, and a mismatch is refused rather than scaled or
// cropped: a window whose scene and surface disagree has a bug in its resize handling, and quietly
// drawing the wrong thing would hide it. The message names both sizes.
pub fn render_into(c: Surface, s: Scene, o: Options) -> Result<image.Image, string> {
    try draw_into(c, s, o)
    return finish(c.target, o.format)
}

// Draws into the surface and **stops there**, leaving the pixels as premultiplied floats.
//
// This is `render_into` without the conversion to bytes, and it exists for the repaint loop.
// `render_into` answers an `image.Image`, which means `width * height * channels` fresh bytes every
// call -- 4 MB a frame at 1280x800, which the profile put at the largest single item of a repaint
// once the canvas itself stopped being reallocated, and which the collector complained about by
// itself (`Repeated allocation of very large block`). A window does not want an `Image`: it wants
// those pixels on the screen, and `window.present` takes them in this form, so the bytes were
// allocated, filled, copied and dropped every frame for nobody.
//
// A caller that wants an encodable image still calls `render_into`; this is for one that is going
// to hand the pixels straight to a display. Pair it with `premultiplied_of`.
pub fn draw_into(c: Surface, s: Scene, o: Options) -> Result<unit, string> {
    try draw_window(c, s, o, 0, 0, c.target.width - 1, c.target.height - 1)
    return unit
}

// The device-pixel rectangle a regional draw actually painted, which is exactly what
// `window.present_region` needs. Returned rather than recomputed by the caller: it is the region
// asked for, scaled by `px_per_pt`, rounded outwards and clipped to the surface, and a caller
// repeating that arithmetic is a second place for it to be wrong.
pub struct Painted {
    x: int
    y: int
    width: int
    height: int
}

// Redraws **one rectangle** of the surface and leaves every other pixel as it was.
//
// This is the whole point of keeping a `Surface` between frames. A window repaints because something
// small changed -- a caret blinked, a button took the pointer, one row of a list got longer -- and
// redrawing 1,024,000 pixels to show a new caret is most of what makes a toolkit feel slow.
// Measured on this file's own benchmark scene at 1280x800: a full frame is about 34 ms, and the same
// frame with *no ops at all* is 2 ms, so roughly 32 of those 34 milliseconds are drawing things that
// did not change.
//
// `region` is in scene units, like everything else a caller passes; it is scaled by
// `Options.px_per_pt`, rounded **outwards** so a region that falls between pixels covers both, and
// clipped to the surface. The pixels it covers are cleared and redrawn exactly as a full frame would
// do it, so the result is per-pixel identical to a full redraw inside the region -- which is what
// `tests/lang/graphics_damage.zm` asserts rather than assumes.
//
// **What this does not do is decide what changed.** That is the caller's, and deliberately so: the
// renderer sees one scene and has no memory of the last one, while an application knows which widget
// it just changed. A caller that wants it computed can diff two scenes; a caller that gets it wrong
// gets a stale window rather than a crash, which is the failure mode to expect from this.
pub fn draw_into_region(c: Surface, s: Scene, o: Options, region: Rect) -> Result<Painted, string> {
    val ratio = o.px_per_pt
    // Outwards on every side: `floor` the near edges, `ceil` the far ones. Rounding inwards would
    // leave a half-covered pixel showing the previous frame, which is a one-pixel seam along the
    // edge of everything that ever moves -- the same class of mistake as the half-open scanline
    // rule in `row_coverage_raw`.
    val x0 = clamp_int(floor(region.x * ratio), 0, c.target.width - 1)
    val y0 = clamp_int(floor(region.y * ratio), 0, c.target.height - 1)
    val x1 = clamp_int(ceil((region.x + region.width) * ratio), 0, c.target.width - 1)
    val y1 = clamp_int(ceil((region.y + region.height) * ratio), 0, c.target.height - 1)
    if region.width <= 0.0 || region.height <= 0.0 {
        return err("raster: a region to redraw must be larger than nothing")
    }
    try draw_window(c, s, o, x0, y0, x1, y1)
    return ok(Painted { x: x0, y: y0, width: x1 - x0 + 1, height: y1 - y0 + 1 })
}

// ---- what changed

// What `damage_between` has worked out so far: a rectangle, whether anything changed at all, and
// whether it gave up and wants the whole scene.
//
// `whole` is not a failure. Some ops cannot be bounded without doing the work that bounding them was
// meant to avoid -- a text run in a font the face table does not hold, say -- and the honest answer
// for those is "repaint everything", which is correct, slower, and never wrong. Nothing here returns
// an error: a damage calculation that fails closed is a stale window, so it fails open instead.
struct Changed {
    rect: Rect
    any: bool
    whole: bool
}

fn nothing_changed() -> Changed {
    return Changed { rect: geom.empty_rect(), any: false, whole: false }
}

fn merge_changed(a: Changed, b: Changed) -> Changed {
    if !b.any {
        return a
    }
    if !a.any {
        return b
    }
    return Changed { rect: geom.rect_union(a.rect, b.rect), any: true, whole: a.whole || b.whole }
}

// A rectangle in a group's own space, brought out through the transforms above it.
fn changed_at(r: Rect, m: Matrix) -> Changed {
    return Changed { rect: geom.transform_rect(m, r), any: true, whole: false }
}

fn changed_everything() -> Changed {
    return Changed { rect: geom.empty_rect(), any: true, whole: true }
}

// Where an op puts ink, in its own coordinate space. `None` means it cannot be bounded cheaply.
fn op_bounds(op: Op, o: Options) -> Option<Rect> {
    return switch op {
        Fill(f) { Option<Rect>.Some(shape.path_bounds(f.path)) }
        // **Grown by the pen, and by the miter.** A stroke's outline reaches half the width to
        // either side of the path, and a miter join reaches `miter_limit` times that from the joint
        // -- which is the whole reason `miter_limit` exists, since without the fallback a near-180
        // degree join spikes thousands of units. Bounding a stroke by its path alone would leave a
        // half-width border of stale pixels along every stroked edge.
        StrokePath(st) {
            val reach = st.stroke.width * 0.5 * (if st.stroke.miter_limit > 1.0 { st.stroke.miter_limit } else { 1.0 })
            val b = shape.path_bounds(st.path)
            Option<Rect>.Some(rect_of(b.x - reach, b.y - reach, b.width + reach * 2.0, b.height + reach * 2.0))
        }
        Text(run) { text_bounds(run, o) }
        DrawImage(pl) { Option<Rect>.Some(pl.into) }
        Nested(g) { group_bounds(g, o) }
    }
}

// A run's ink, from the face's own global bounding box.
//
// `x_min`/`x_max` and `y_min`/`y_max` bound *any* glyph of the face relative to its own pen, so this
// encloses the run whatever it says: the left edge allows for a glyph that starts behind its pen and
// the right edge for one whose ink runs past its advance, which is why neither side is just the
// advance. The same reasoning as `draw_text`'s band test, and the same reason the declared ascender
// is not used.
fn text_bounds(run: scene.TextRun, o: Options) -> Option<Rect> {
    if run.font < 0 || run.font >= len(o.fonts) || run.size <= 0.0 {
        return Option<Rect>.None
    }
    val face = switch o.fonts[run.font] {
        Embedded(f) { f }
        // A standard font carries no outlines and this backend refuses to draw one, so there is
        // nothing to measure and nothing that will be drawn either.
        Standard(_) { return Option<Rect>.None }
    }
    val width = switch font.advance(o.fonts[run.font], run.text, run.size) {
        Ok(w) { w }
        Err(_) { return Option<Rect>.None }
    }
    val per_unit = run.size / (face.units_per_em as float)
    val left = run.at.x + (face.x_min as float) * per_unit
    val right = run.at.x + width + (face.x_max as float) * per_unit
    val top = run.at.y - (face.y_max as float) * per_unit
    val bottom = run.at.y - (face.y_min as float) * per_unit
    return Option<Rect>.Some(rect_of(left, top, right - left, bottom - top))
}

fn group_bounds(g: scene.Group, o: Options) -> Option<Rect> {
    var acc = nothing_changed()
    for child in g.ops {
        acc = merge_changed(acc, bounds_of_op(child, g.transform, o))
    }
    if acc.whole {
        return Option<Rect>.None
    }
    if !acc.any {
        return Option<Rect>.Some(geom.empty_rect())
    }
    // A clip can only make the ink smaller, so it is intersected rather than ignored -- a group
    // clipped to a corner must not damage the whole of what its children would have covered.
    return switch g.clip {
        Some(path) { Option<Rect>.Some(rect_intersection(
            acc.rect,
            geom.transform_rect(g.transform, shape.path_bounds(path))
        )) }
        None { Option<Rect>.Some(acc.rect) }
    }
}

// A group's clip narrowing the damage its children reported.
//
// **This was missing and nothing but the recorded damage size could see it.** The recursion into a
// matching pair of groups threaded the transform and not the clip, so a clipped group whose child
// changed reported the child's whole extent -- correct, since a larger region is never wrong, and
// therefore invisible to every pixel comparison in the fixture. A clip composes by intersection at
// each level on the way out, which is why doing it here rather than at the top is right for nested
// groups.
fn clipped_by(c: Changed, clip: Option<shape.Path>, m: Matrix) -> Changed {
    if !c.any || c.whole {
        return c
    }
    return switch clip {
        Some(path) {
            val within = rect_intersection(c.rect, geom.transform_rect(m, shape.path_bounds(path)))
            if geom.is_empty(within) { nothing_changed() } else { Changed { rect: within, any: true, whole: false } }
        }
        None { c }
    }
}

// Can a shape with these user-space bounds touch the target's write window?
//
// **The cheap test that has to come before the expensive work.** `shape.path_bounds` is the
// control-point hull -- a walk over the points, no flattening, no allocation -- and it always
// encloses the curve, so a box that misses the window means a shape that misses it. Transforming
// the path and building its edge list to find that out costs the flattening of every curve in it,
// which is what this exists to skip.
fn reaches_window(t: Target, user: Rect, m: Matrix) -> bool {
    val device = geom.transform_rect(m, user)
    if ceil(geom.bottom(device)) < t.win_y0 || floor(device.y) > t.win_y1 {
        return false
    }
    if ceil(geom.right(device)) < t.win_x0 || floor(device.x) > t.win_x1 {
        return false
    }
    return true
}

fn bounds_of_op(op: Op, m: Matrix, o: Options) -> Changed {
    return switch op_bounds(op, o) {
        Some(r) { if geom.is_empty(r) { nothing_changed() } else { changed_at(r, m) } }
        None { changed_everything() }
    }
}

fn rect_intersection(a: Rect, b: Rect) -> Rect {
    val x0 = if a.x > b.x { a.x } else { b.x }
    val y0 = if a.y > b.y { a.y } else { b.y }
    val x1 = if geom.right(a) < geom.right(b) { geom.right(a) } else { geom.right(b) }
    val y1 = if geom.bottom(a) < geom.bottom(b) { geom.bottom(a) } else { geom.bottom(b) }
    if x1 <= x0 || y1 <= y0 {
        return geom.empty_rect()
    }
    return rect_of(x0, y0, x1 - x0, y1 - y0)
}

// Two ops at the same position in their lists, known to differ.
fn diff_one(before: Op, after: Op, m: Matrix, o: Options) -> Changed {
    // **Two groups with the same frame are compared inside**, which is what keeps damage tight in a
    // real tree: a window is a group of rows, and one row changing should not damage the window. The
    // transform and clip have to match for this -- a group that *moved* has its old and new ink in
    // different places, and the only honest answer there is both.
    val deeper = switch before {
        Nested(gb) {
            switch after {
                Nested(ga) {
                    if gb.transform == ga.transform && gb.clip == ga.clip {
                        val inner = matrix_concat(m, gb.transform)
                        Option<Changed>.Some(clipped_by(diff_ops(gb.ops, ga.ops, inner, o), gb.clip, inner))
                    } else {
                        Option<Changed>.None
                    }
                }
                Fill(_) { Option<Changed>.None }
                StrokePath(_) { Option<Changed>.None }
                Text(_) { Option<Changed>.None }
                DrawImage(_) { Option<Changed>.None }
            }
        }
        Fill(_) { Option<Changed>.None }
        StrokePath(_) { Option<Changed>.None }
        Text(_) { Option<Changed>.None }
        DrawImage(_) { Option<Changed>.None }
    }
    return switch deeper {
        Some(c) { c }
        // **Both the old ink and the new**, because the old has to be erased as much as the new has
        // to be drawn. A region covering only where the op moved *to* leaves its previous position
        // on the screen, which is the classic trail-behind-a-dragged-thing bug.
        None { merge_changed(bounds_of_op(before, m, o), bounds_of_op(after, m, o)) }
    }
}

fn diff_ops(before: [Op], after: [Op], m: Matrix, o: Options) -> Changed {
    var acc = nothing_changed()
    val shared = if len(before) < len(after) { len(before) } else { len(after) }
    var i = 0
    while i < shared {
        if before[i] != after[i] {
            acc = merge_changed(acc, diff_one(before[i], after[i], m, o))
        }
        i = i + 1
    }
    // The tail of whichever list is longer: ops that appeared, or ops that are gone and whose ink
    // has to be cleared away.
    var extra = shared
    while extra < len(before) {
        acc = merge_changed(acc, bounds_of_op(before[extra], m, o))
        extra = extra + 1
    }
    extra = shared
    while extra < len(after) {
        acc = merge_changed(acc, bounds_of_op(after[extra], m, o))
        extra = extra + 1
    }
    return acc
}

// What changed between two scenes, as a rectangle in scene units to hand to `draw_into_region` --
// or `None` if nothing did, in which case a window needs no repaint at all.
//
// **This is the piece that makes damage regions automatic.** `draw_into_region` can repaint a
// rectangle but has no idea which one; an application knows what it changed but usually only in
// terms of its own widgets. Comparing the scene it just built against the one it built last frame
// answers the question without either side having to track anything: `Scene` is an immutable value,
// so last frame's is still there to compare against, and the comparison is structural.
//
// **Deliberately conservative, in one direction only.** Every case that cannot be answered exactly
// answers "everything" -- an op whose bounds need the work that bounding them was meant to avoid, a
// scene that changed size, a different background, a group that moved. The result may therefore be
// larger than necessary and is never smaller, so the failure mode is a slower frame rather than a
// stale window. Nothing here returns an error for the same reason.
//
// **Ops are matched by position, so inserting one marks everything after it as changed.** That is
// usually right rather than merely safe -- inserting a row does move every row below it -- but a
// caller that reorders a long list will see large damage, and the way out is to reorder inside a
// `Nested` group so the comparison recurses into it. Two groups are compared internally when their
// transform and clip match; otherwise both the old and the new ink are damaged, because the old has
// to be erased.
pub fn damage_between(previous: Scene, current: Scene, o: Options) -> Option<Rect> {
    val whole = rect_of(0.0, 0.0, current.width, current.height)
    if previous.width != current.width || previous.height != current.height {
        return Option<Rect>.Some(whole)
    }
    if previous.background != current.background {
        return Option<Rect>.Some(whole)
    }
    val changed = diff_ops(previous.ops, current.ops, identity(), o)
    if !changed.any {
        return Option<Rect>.None
    }
    if changed.whole {
        return Option<Rect>.Some(whole)
    }
    return Option<Rect>.Some(rect_intersection(changed.rect, whole))
}

fn draw_window(c: Surface, s: Scene, o: Options, x0: int, y0: int, x1: int, y1: int) -> Result<unit, string> {
    val frame = try frame_size(s, o)
    if frame.width != c.target.width || frame.height != c.target.height {
        return err(concat(
            "raster: the scene comes to ",
            str(frame.width),
            "x",
            str(frame.height),
            " but the surface is ",
            str(c.target.width),
            "x",
            str(c.target.height),
            " pixels -- make a new surface when the window resizes or the ratio changes"
        ))
    }
    // Bounded here, at the top of a frame, for the reason `glyph_cache_limit` gives.
    if len(c.target.glyphs) > c.glyph_limit {
        clear(c.target.glyphs)
    }
    // **Reset to transparent, because the surface holds the last frame** -- unless the very next
    // thing is going to overwrite every pixel anyway.
    //
    // `draw_frame` starts by clearing to `Options.background` when there is one, and that clear
    // *writes* every pixel rather than compositing over it, so doing a transparent pass first is
    // two passes over the canvas where one will do. At 1280x800 each pass is 4 million float
    // stores, and the profile of a repaint put this at **13% of a frame** -- the third largest item
    // and the only one that was pure waste. A window almost always has a background.
    //
    // Only `Options.background` licenses the skip. A scene's own background is a `Paint`, drawn as
    // a fill, so it composites: a semi-transparent one over last frame's pixels would be wrong, and
    // an opaque one only looks right by accident of its alpha.
    val overwritten = switch o.background {
        Some(_) { true }
        None { false }
    }
    // **A copy of the target carrying the window**, which is cheap and is what lets one code path
    // serve both entry points: `data` and `glyphs` are handles, so the copy shares the canvas and
    // the glyph cache and only the four bounds differ.
    val t = with c.target {
        win_x0: x0,
        win_y0: y0,
        win_x1: x1,
        win_y1: y1
    }
    if !overwritten {
        clear_premul(t.data, t.width, t.win_x0, t.win_y0, t.win_x1, t.win_y1, 0.0, 0.0, 0.0, 0.0)
    }
    return draw_frame(t, s, o)
}

// A surface's pixels as they are held: **premultiplied** RGBA floats, four per pixel, row-major.
//
// The width and height come with the buffer rather than being asked for separately, because a flat
// array has no shape of its own and a caller that computed the pixel size itself would be deriving
// `surface_of`'s arithmetic a second time -- which is the mistake `surface_of` takes scene units
// and a ratio to prevent.
//
// **Premultiplied is a promise about the contents, not an implementation detail**, which is why the
// type says so: red at half alpha is `(0.5, 0, 0, 0.5)` here and `(1, 0, 0, 0.5)` in an
// `image.Image`. Anything reading this buffer has to know which it is holding.
pub struct Premultiplied {
    width: int
    height: int
    data: MutableArray<float>
}

pub fn premultiplied_of(c: Surface) -> Premultiplied {
    return Premultiplied { width: c.target.width, height: c.target.height, data: c.target.data }
}

pub fn render(s: Scene, o: Options) -> Result<image.Image, string> {
    val frame = try frame_size(s, o)
    val t = new_target(frame.width, frame.height)
    try draw_frame(t, s, o)
    return finish(t, o.format)
}

struct Frame {
    width: int
    height: int
}

// The pixel size a scene asks for, with everything `Options` forbids checked. Shared so that
// `render` and `render_into` cannot drift in what they refuse.
fn frame_size(s: Scene, o: Options) -> Result<Frame, string> {
    if o.px_per_pt <= 0.0 || o.px_per_pt > 64.0 {
        return err(concat(
            "raster: px_per_pt must be above 0 and at most 64, got ",
            format("{}", o.px_per_pt)
        ))
    }
    if o.samples < 1 || o.samples > 16 {
        return err(concat(
            "raster: samples must be between 1 and 16, got ",
            str(o.samples),
            " (1 is no anti-aliasing, 4 is good, 16 is as much as vertical supersampling gives)"
        ))
    }
    if s.width <= 0.0 || s.height <= 0.0 {
        return err(format("raster: a {}x{} scene has no pixels", s.width, s.height))
    }
    // **The pixels, not the units.** `max_pixels` guards an absurd allocation, so it has to count
    // what is actually allocated: a 1280x800 scene is 1,024,000 units and 2,304,000 pixels at 1.5,
    // and a limit checked before the ratio would under-count by its square -- 2.25x at 1.5, 9x at
    // 3.0 -- while still reading as enforced.
    val width = ceil(s.width * o.px_per_pt)
    val height = ceil(s.height * o.px_per_pt)
    if width * height > o.max_pixels {
        return err(concat(
            "raster: ",
            str(width),
            "x",
            str(height),
            " is ",
            str(width * height),
            " pixels, past the ",
            str(o.max_pixels),
            " allowed"
        ))
    }
    return ok(Frame { width: width, height: height })
}

fn draw_frame(t: Target, s: Scene, o: Options) -> Result<unit, string> {
    switch o.background {
        Some(c) { clear_to(t, premul_of(c)) }
        None { unit }
    }
    // The scene's own background is a `Paint`, so it is a fill of the whole canvas rather than a
    // memset -- that is what makes a gradient background work.
    // **The ratio is one transform at the root and nothing else.** Every length in the scene, every
    // font size, every gradient's geometry and every clip path passes through it once, so there is
    // no list of places that must remember to scale -- which is how a renderer that multiplies at
    // each site ends up with one that does not.
    val root = if o.px_per_pt == 1.0 { identity() } else { geom.scaling(o.px_per_pt, o.px_per_pt) }
    switch s.background {
        Some(p) {
            try fill_shape(
                t,
                shape.rect_path(rect_of(0.0, 0.0, s.width, s.height)),
                Ink.FromPaint(p),
                root,
                Option<[float]>.None,
                o
            )
        }
        None { unit }
    }
    try draw_ops(t, s.ops, root, Option<[float]>.None, o)
    return unit
}

fn new_target(width: int, height: int) -> Target {
    val total = width * height * 4
    // Asked for in one go rather than grown: a 600x800 canvas is 1.9 million floats, and a builder
    // that starts at 20 and doubles copies the whole thing twenty times on the way up.
    val data = mutable_array_filled<float>(total, 0.0)
    return Target {
        win_x0: 0,
        win_y0: 0,
        win_x1: width - 1,
        win_y1: height - 1,
        width: width,
        height: height,
        data: data,
        glyphs: mutable_map_new<string, GlyphTile>()
    }
}

// **The two per-pixel loops are native, and that is the only reason this module is usable for
// anything interactive.** A canvas is four floats per pixel, so clearing a 1280x800 one is 4 million
// stores and converting it to bytes is a million iterations of float arithmetic -- which measured as
// two thirds of a frame with *nothing drawn on it*
// (`tests/bench/ui_frame.zm`, docs/design/desktop-applications.md §3).
//
// Everything else here is still Ziman: the geometry, the winding rules, the stroking, the glyph
// cache. These two are moved because they are per-pixel and have no geometry in them at all, which
// also makes them exactly reproducible: `tests/lang/graphics_raster.zm` asserts real pixels across
// anti-aliasing, both winding rules, strokes, gradients, alpha and all three output formats, and it
// is byte-identical with these loops in C. That fixture is the oracle, and it predates the change.
native fn clear_premul(
    data: MutableArray<float>,
    width: int,
    x0: int,
    y0: int,
    x1: int,
    y1: int,
    r: float,
    g: float,
    b: float,
    a: float
)

native fn to_bytes_premul(data: MutableArray<float>, channels: int) -> Result<[byte], string>

// One scanline of a **solid** fill. The third per-pixel loop, and the one `fill_shape` spends its
// time in: a shape's bounding box, once per pixel, with a coverage read, a clip read and a blend.
// Only the flat case goes native -- a gradient or an image evaluates its colour per pixel through
// `ready_at` and stays here, because moving it would mean moving the paint model with it.
// A run of a **solid** fill whose coverage and canvas are indexed independently: `blit`'s loop,
// which is text. A glyph's coverage is a tile just big enough to hold it, so it advances by the
// tile's width while the canvas advances by the canvas's.
// One coverage row's window set to zero, once per scanline of every fill, and a span's exact
// overlap with each pixel it touches -- the innermost loop of the anti-aliasing pass, reached once
// per span per sub-scanline with a per-pixel run in the middle. Both are transcribed statement for
// statement in `src/native_raster.c`; `add_span`'s arithmetic especially, because coverage
// accumulates and one ulp in a partial pixel survives into the composite and then into a byte.
// One scanline of a linear or radial gradient. **The paint crosses as one flat `[float]`**, not as
// a dozen parameters: the kind, the inverse matrix, the gradient's geometry and its premultiplied
// stops, built once per fill by `gradient_spec`. A solid fill measured 47 ms over a 1280x800 canvas
// and the same fill with a gradient 2625 ms, because a gradient is an inverse transform, a stop
// search and a lerp *per pixel* -- 56x for a scene that looks no more complicated.
native fn composite_row_gradient(
    data: MutableArray<float>,
    coverage: MutableArray<float>,
    row_base: int,
    first_col: int,
    last_col: int,
    row_y: float,
    spec: [float],
    mask: [float],
    has_mask: bool
)

// One scanline of a tiled pattern or a placed image. The spec is `composite_row_gradient`'s,
// extended; the pixels are a separate argument because an image's bytes cannot live in a
// `[float]`, which is the only reason this is not two more `kind` values on that one.
native fn composite_row_image(
    data: MutableArray<float>,
    coverage: MutableArray<float>,
    row_base: int,
    first_col: int,
    last_col: int,
    row_y: float,
    spec: [float],
    pixels: [byte],
    mask: [float],
    has_mask: bool
)

native fn clear_range(row: MutableArray<float>, from_x: int, to_x: int)

native fn add_span(row: MutableArray<float>, width: int, from: float, to: float, weight: float)

// One scanline's coverage, the whole of it: the crossings, their order, the winding rule and every
// span, in C.
//
// **The item F270 measured its way to rather than guessed at.** Two attempts at this loop in Ziman
// -- one removing a divide and three comparisons per crossing, one removing 1,600 builder
// allocations per fill -- each measured 1.00x over three interleaved passes. The cost here is not
// the arithmetic or the allocation, it is the per-operation overhead of doing anything a few
// million times, and the only way to remove that is to stop interpreting.
//
// Takes the *whole* row for the same reason: `crossings_at`, the insertion sort, `spans_from` and
// an `add_span` per span were four interpreted calls deep per sub-scanline, and a narrower boundary
// would have left the dispatch in place. `winding` crosses as an int because an enum does not.
native fn row_coverage_raw(
    row: MutableArray<float>,
    width: int,
    edges: [float],
    live: MutableArray<int>,
    winding: int,
    samples: int,
    y: int,
    from_x: int,
    to_x: int,
    shift: int
)

native fn composite_span_flat(
    data: MutableArray<float>,
    cover: [float],
    cover_at: int,
    canvas_at: int,
    count: int,
    r: float,
    g: float,
    b: float,
    a: float,
    mask: [float],
    has_mask: bool
)

native fn composite_row_flat(
    data: MutableArray<float>,
    coverage: MutableArray<float>,
    row_base: int,
    first_col: int,
    last_col: int,
    r: float,
    g: float,
    b: float,
    a: float,
    mask: [float],
    has_mask: bool
)

fn clear_to(t: Target, c: Premul) {
    clear_premul(t.data, t.width, t.win_x0, t.win_y0, t.win_x1, t.win_y1, c.red, c.green, c.blue, c.alpha)
}

// ---- the scene walk

fn draw_ops(t: Target, ops: [Op], m: Matrix, clip: Option<[float]>, o: Options) -> Result<unit, string> {
    for op in ops {
        switch op {
            Fill(f) { try fill_shape(t, f.path, Ink.FromPaint(f.fill), m, clip, o) }
            // A stroke *is* a fill of its outline, which is the whole content of part 2: the
            // stroker is device-independent, so this is one call and then the same span loop.
            // Stroked in user space and transformed afterwards, so a non-uniform scale makes an
            // elliptical pen -- which is what PDF does with the same input.
            StrokePath(s) {
                // **Tested here rather than in `fill_shape`, because the stroker runs first.**
                // `stroker.outline` is the most expensive single thing in this module and it runs
                // before any of `fill_shape`'s own checks, so a stroke outside the window would be
                // fully widened -- joins, caps, dashes -- and then discarded. The pen's reach is
                // added to the path's own box for the same reason `op_bounds` adds it: the ink
                // extends half a width either side, and a miter join up to `miter_limit` times that.
                val reach = s.stroke.width * 0.5 *
                    (if s.stroke.miter_limit > 1.0 { s.stroke.miter_limit } else { 1.0 })
                val box = shape.path_bounds(s.path)
                val grown = rect_of(
                    box.x - reach,
                    box.y - reach,
                    box.width + reach * 2.0,
                    box.height + reach * 2.0
                )
                if reaches_window(t, grown, m) {
                    val widened = try stroker.outline(s.path, s.stroke)
                    try fill_shape(t, widened, Ink.FromPaint(s.fill), m, clip, o)
                }
            }
            Text(run) { try draw_text(t, run, m, clip, o) }
            DrawImage(p) {
                if p.image < 0 || p.image >= len(o.images) {
                    return err(concat(
                        "raster: a draw names image ",
                        str(p.image),
                        " but Options.images holds ",
                        str(len(o.images))
                    ))
                }
                try fill_shape(
                    t,
                    shape.rect_path(p.into),
                    Ink.FromImage(Tile { handle: p.image, into: geom.normalized(p.into) }),
                    m,
                    clip,
                    o
                )
            }
            Nested(g) {
                val inner = matrix_concat(m, g.transform)
                val narrowed = switch g.clip {
                    Some(path) { Option<[float]>.Some(try clip_mask(t, path, m, clip, o)) }
                    None { clip }
                }
                try draw_ops(t, g.ops, inner, narrowed, o)
            }
        }
    }
    return unit
}

// Text is lowered to outlines and filled -- the one place where `GlyphVector.getOutline()`'s
// equivalent is the *right* answer, because a raster device has no font machinery of its own to
// defer to. `truetype.glyph_outline` was written in phase 3 for exactly this.
//
// **No hinting and no kerning.** Hinting is an interpreter for a bytecode language embedded in the
// font and is a project in itself; unhinted small text is blurrier than a hinted renderer's, which
// is a real cost and is named rather than hidden. Kerning needs `kern` or GPOS, which phase 3 did
// not read: advances come from `hmtx` alone, so "AV" sits further apart here than in a shaped
// renderer.
fn draw_text(
    t: Target,
    run: scene.TextRun,
    m: Matrix,
    clip: Option<[float]>,
    o: Options
) -> Result<unit, string> {
    if run.font < 0 || run.font >= len(o.fonts) {
        return err(concat(
            "raster: a text run names font ",
            str(run.font),
            " but Options.fonts holds ",
            str(len(o.fonts))
        ))
    }
    if run.size <= 0.0 {
        return err(format("raster: a text run needs a positive size, got {}", run.size))
    }
    val face = switch o.fonts[run.font] {
        Embedded(f) { f }
        Standard(s) {
            return err(concat(
                "raster: '",
                font.base_font_name(s),
                "' is one of the standard fourteen, which carry no outlines -- a PDF reader resolves them against fonts it already has, and this backend has no such library. Load a TrueType face with font.load"
            ))
        }
    }
    // **Is this run anywhere near the window? Asked before the run is shaped, which is the whole
    // point of asking.**
    //
    // A regional redraw of a 2x14 caret measured 17.1 ms against a full frame's 33.1 -- 1.9x, where
    // the floor said 17x was available -- and the profile said why: `draw_text`, `lookup4`,
    // `u16_at`, `glyphs_of`, `advance_of` and `glyph_for` were half the frame. Every one of the 48
    // runs in the scene was being shaped in full -- each character mapped through the cmap, each
    // advance read, each outline fetched -- and only then handed to `blit`, which returned
    // immediately because the window excluded it. The pixel loops were already skipping the work;
    // the *shaping* was not.
    //
    // The bound is **exact, not a guess**: `y_min`/`y_max` are the `head` table's global bounding
    // box, so no glyph of this face can reach beyond them at any size. A declared
    // ascender/descender would have been the obvious thing to use and would be wrong -- an accent
    // or a tail can exceed it, and the clipping would appear only for particular letters.
    //
    // **Only for a transform with no rotation or skew**, because this tests the vertical extent
    // alone and under a rotation the horizontal extent feeds into it -- and the horizontal extent is
    // exactly what cannot be known without shaping the run. A rotated run is shaped as before. The
    // horizontal direction needs no test here either way: `blit` clamps each glyph's tile to the
    // window already, and that is per glyph rather than per run.
    if m.b == 0.0 && m.c == 0.0 {
        val per_unit = run.size / (face.units_per_em as float)
        val user_top = run.at.y - (face.y_max as float) * per_unit
        val user_bottom = run.at.y - (face.y_min as float) * per_unit
        val edge_a = m.d * user_top + m.f
        val edge_b = m.d * user_bottom + m.f
        val top = if edge_a < edge_b { edge_a } else { edge_b }
        val bottom = if edge_a < edge_b { edge_b } else { edge_a }
        if ceil(bottom) < t.win_y0 || floor(top) > t.win_y1 {
            return unit
        }
    }
    val ids = try font.glyphs_of(face, run.text)
    // The linear part of the glyph transform is the same for every glyph in the run -- only the
    // pen moves -- so it keys the whole run, and a rotated or scaled run simply gets its own
    // entries rather than falling off the cache.
    val linear = matrix_concat(m, geom.scaling(run.size / (face.units_per_em as float), 0.0 - run.size /
            (face.units_per_em as float)))
    // **The face has to be part of the key, and it was not.** The key was the transform, the glyph
    // id and the subpixel offset -- so two faces with the same units per em, drawn at the same size
    // under the same transform, produced the same prefix, and a glyph id present in both was served
    // from whichever face drew it first. That is not a corner case: it is regular and bold of one
    // family in one scene, which share a character set and so share glyph ids. `Caladea-Regular`
    // and `Caladea-Bold` are both 1000 units per em with 420 glyphs, and 'a' is glyph 68 in both;
    // drawing it in each rendered the second in the first's shape.
    //
    // `truetype.face_id` is the font's own `checkSumAdjustment`, four bytes it already carries. The
    // units per em and the glyph count go in beside it so that a face with no usable checksum --
    // where `face_id` answers 0 -- still separates from most others rather than from none.
    val prefix = concat(
        str(truetype.face_id(face)),
        ":",
        str(face.units_per_em),
        ":",
        str(face.glyph_count),
        ":",
        format("{:.5}", linear.a),
        ",",
        format("{:.5}", linear.b),
        ",",
        format("{:.5}", linear.c),
        ",",
        format("{:.5}", linear.d)
    )
    // Font units to scene units. The **negative Y** is the whole conversion: a glyph outline has Y
    // growing upward from its baseline, and this library's coordinates grow downward.
    val scale = run.size / (face.units_per_em as float)
    // Nothing to draw, and nothing to refuse: an empty run returns before the blitter is built, so
    // a run of no glyphs under a degenerate transform behaves as it did when the inversion happened
    // per glyph and therefore never happened.
    if len(ids) == 0 {
        return unit
    }
    val blitter = try blitter_of(Ink.FromPaint(run.fill), m, clip, o)
    var pen = run.at.x
    for g in ids {
        val origin = transform_point(m, point_of(pen, run.at.y))
        // **Subpixel position, quantised to a quarter of a pixel.** Snapping glyphs to whole
        // pixels would make their spacing visibly uneven; keeping the exact fraction would make
        // every glyph a cache miss. A quarter is the usual compromise.
        //
        // Rounded to the *nearest* quarter, not floored: flooring shifts every glyph left by up to
        // a quarter pixel and by an eighth on average, which is a systematic drift of the whole
        // line rather than a rounding error that cancels. Rounding bounds the error at an eighth
        // and centres it on zero. A fraction that rounds up to 1 is the next pixel at offset zero.
        var ix = floor(origin.x)
        var iy = floor(origin.y)
        var nx = round((origin.x - (ix as float)) * 4.0)
        var ny = round((origin.y - (iy as float)) * 4.0)
        if nx == 4 {
            nx = 0
            ix = ix + 1
        }
        if ny == 4 {
            ny = 0
            iy = iy + 1
        }
        val qx = (nx as float) / 4.0
        val qy = (ny as float) / 4.0
        val key = concat(prefix, "/", str(g), "/", str(nx), ",", str(ny))
        val tile = switch get(t.glyphs, key) {
            Some(cached) { cached }
            None {
                val outline = try truetype.glyph_outline(face, g)
                val made = rasterise_tile(
                    outline,
                    matrix_concat(geom.translation(qx, qy), linear),
                    o.samples
                )
                set(t.glyphs, key, made)
                made
            }
        }
        try blit(t, tile, ix, iy, blitter)
        pen = pen + ((try truetype.advance_of(face, g)) as float) * scale
    }
    return unit
}

// A glyph rasterised on its own, into a box just big enough to hold it. This is `fill_shape`'s row
// loop writing coverage into a buffer instead of compositing it, which is the only part of the two
// that differs.
fn rasterise_tile(outline: Path, gm: Matrix, samples: int) -> GlyphTile {
    val device = shape.transform_path(outline, gm)
    val e = edges_of(device)
    if len(e.xy) == 0 {
        return GlyphTile { left: 0, top: 0, width: 0, height: 0, cover: [] }
    }
    val left = floor(e.min_x)
    val top = floor(e.min_y)
    val width = ceil(e.max_x) - left + 1
    val height = ceil(e.max_y) - top + 1
    val cover = mutable_array_new<float>()
    val row = mutable_array_new<float>()
    var i = 0
    while i < width {
        push(row, 0.0)
        i = i + 1
    }
    val plan = plan_of(e, top, top + height - 1)
    val live = mutable_array_new<int>()
    var cursor = 0
    var y = top
    while y < top + height {
        cursor = advance_active(plan, live, cursor, y)
        // The row buffer is in *tile* coordinates, so the edge list is shifted by `left` on the way
        // in and the spans come out already local.
        row_coverage_shifted(row, width, e, live, device.winding, samples, y, left)
        var x = 0
        while x < width {
            push(cover, row[x])
            x = x + 1
        }
        y = y + 1
    }
    return GlyphTile { left: left, top: top, width: width, height: height, cover: snapshot(cover) }
}

// Everything a blit needs that is the same for every glyph of a run.
//
// **Built once per run, because it used to be built once per glyph.** `blit` inverted the group's
// transform, prepared the ink and unwrapped the clip on every call -- and a run of text calls it
// once a letter, with the same transform, the same ink and the same clip every time. `geom::invert`
// alone was 2.1% of a repaint for work whose answer could not change, and in the flat case the
// inverse is never even read.
//
// The same argument `fill_shape` already makes one level down, where these values are hoisted out
// of the per-*pixel* loop. This is the per-*glyph* loop, and nothing had hoisted them out of it.
struct Blitter {
    inv: Matrix
    ready: Ready
    // `Some` for a solid colour, which is the case that reaches the native span compositor.
    flat: Option<Premul>
    clipped: bool
    mask_values: [float]
}

fn blitter_of(k: Ink, m: Matrix, clip: Option<[float]>, o: Options) -> Result<Blitter, string> {
    // Eager, as it was when it sat inside `blit`: a transform that cannot be inverted is refused
    // even when the ink is flat and would not have read the inverse. Kept that way deliberately --
    // this move is about *when* the work happens, not about which inputs are accepted, and `blit`
    // is called only from `draw_text`, which returns before building this for an empty run so that
    // a run with no glyphs still refuses nothing.
    val inv = switch invert(m) {
        Ok(i) { i }
        Err(why) { return err(concat("raster: this group's transform cannot be inverted (", why, ")")) }
    }
    val ready = try prepare(k, o.images)
    val flat = switch ready {
        Flat(c) { Option<Premul>.Some(c) }
        Axial(_) { Option<Premul>.None }
        Radial(_) { Option<Premul>.None }
        Tiled(_) { Option<Premul>.None }
        Placed(_) { Option<Premul>.None }
    }
    val clipped = switch clip {
        Some(_) { true }
        None { false }
    }
    val no_mask: [float] = []
    val mask_values = switch clip {
        Some(values) { values }
        None { no_mask }
    }
    return ok(Blitter {
        inv: inv,
        ready: ready,
        flat: flat,
        clipped: clipped,
        mask_values: mask_values
    })
}

fn blit(t: Target, tile: GlyphTile, ix: int, iy: int, b: Blitter) -> Result<unit, string> {
    if tile.width == 0 {
        return unit
    }
    val inv = b.inv
    val ready = b.ready
    val flat = b.flat
    val clipped = b.clipped
    val mask_values = b.mask_values
    // The tile's x range that lands on the canvas, computed per blit rather than tested per pixel:
    // a glyph half off the left edge otherwise costs a bounds check for every pixel it does not
    // have. `lo`/`hi` are tile coordinates; the canvas column is `ix + tile.left + tx`.
    // Against the target's write window rather than the canvas, for the reason `fill_shape` gives:
    // this is where a glyph outside a damage region stops costing anything, and where one that
    // overlaps its edge is cut off instead of writing over kept pixels.
    val offset = ix + tile.left
    val lo = if offset < t.win_x0 { t.win_x0 - offset } else { 0 }
    val hi = if offset + tile.width > t.win_x1 + 1 { t.win_x1 - offset } else { tile.width - 1 }
    if lo > hi {
        return unit
    }
    var ty = 0
    while ty < tile.height {
        val py = iy + tile.top + ty
        if py >= t.win_y0 && py <= t.win_y1 {
            if Some(constant) = flat {
                composite_span_flat(
                    t.data,
                    tile.cover,
                    ty * tile.width + lo,
                    py * t.width + offset + lo,
                    hi - lo + 1,
                    constant.red,
                    constant.green,
                    constant.blue,
                    constant.alpha,
                    mask_values,
                    clipped
                )
            } else {
                var tx = lo
                while tx <= hi {
                    val px = offset + tx
                    val cov = tile.cover[ty * tile.width + tx]
                    if cov > 0.002 {
                        val through = if clipped { mask_values[py * t.width + px] } else { 1.0 }
                        if through > 0.002 {
                            val c = ready_at(
                                ready,
                                inv,
                                point_of((px as float) + 0.5, (py as float) + 0.5)
                            )
                            composite(t, px, py, c, cov * through)
                        }
                    }
                    tx = tx + 1
                }
            }
        }
        ty = ty + 1
    }
    return unit
}

// A clip is a **coverage mask**, not a rectangle: an arbitrary clip path is rasterised once into a
// Gray-ish buffer and multiplied into everything the group draws. A rectangle fast path is worth
// having later (almost every clip is one), but the general case has to exist, because a `Group`
// whose clip was silently ignored is exactly what invariant 2 forbids.
// The extreme of one coordinate across every edge: `which` is 0 for x and 1 for y, and an edge
// is four floats, so both ends of each are looked at.
fn lowest(e: Edges, which: int) -> float {
    var best = 0.0
    var seen = false
    var i = 0
    while i < len(e.xy) {
        val a = e.xy[i + which]
        val b = e.xy[i + which + 2]
        if !seen || a < best {
            best = a
            seen = true
        }
        if b < best {
            best = b
        }
        i = i + 4
    }
    return best
}

fn highest(e: Edges, which: int) -> float {
    var best = 0.0
    var seen = false
    var i = 0
    while i < len(e.xy) {
        val a = e.xy[i + which]
        val b = e.xy[i + which + 2]
        if !seen || a > best {
            best = a
            seen = true
        }
        if b > best {
            best = b
        }
        i = i + 4
    }
    return best
}

fn bigger(a: int, b: int) -> int {
    return if a > b { a } else { b }
}

fn smaller(a: int, b: int) -> int {
    return if a < b { a } else { b }
}

fn floor_to_int(v: float) -> int {
    return floor(v) as int
}

fn ceil_to_int(v: float) -> int {
    return ceil(v) as int
}

fn clip_mask(
    t: Target,
    path: Path,
    m: Matrix,
    existing: Option<[float]>,
    o: Options
) -> Result<[float], string> {
    val device = shape.transform_path(path, m)
    val e = edges_of(device)
    // **Only where the mask can be anything but zero, and only where this pass may write.**
    //
    // This walked every row and every column of the canvas, whatever the clip covered and
    // whatever region was being redrawn. The `Target` comment a few hundred lines up says a clip
    // is "exactly what a damage region exists to avoid" -- and it was, because the mask ignored
    // the window those four ints describe. Measured on a hundred fills wrapped in one clip: 270
    // ms against 23 ms unclipped, and a fiftieth of the surface cost 249 ms rather than the 1 ms
    // the same ops cost unclipped. `lib/ui` wraps every scroll viewport in one of these, so a
    // window that scrolled anything paid for the whole canvas per viewport per frame.
    //
    // Outside the path's own bounds the coverage is zero, and zero times anything is the zero the
    // array already holds; outside the window nothing is read, because the only two functions
    // that touch pixels are bounded by the same four ints.
    val mask = mutable_array_filled<float>(t.width * t.height, 0.0)
    val lo_y = bigger(t.win_y0, floor_to_int(lowest(e, 1)))
    val hi_y = smaller(t.win_y1, ceil_to_int(highest(e, 1)))
    val lo_x = bigger(t.win_x0, floor_to_int(lowest(e, 0)))
    val hi_x = smaller(t.win_x1, ceil_to_int(highest(e, 0)))
    if hi_y < lo_y || hi_x < lo_x {
        return ok(snapshot(mask))
    }
    val row = mutable_array_filled<float>(t.width, 0.0)
    val plan = plan_of(e, lo_y, hi_y)
    val live = mutable_array_new<int>()
    var cursor = 0
    var y = lo_y
    while y <= hi_y {
        cursor = advance_active(plan, live, cursor, y)
        row_coverage(row, t.width, e, live, device.winding, o.samples, y, lo_x, hi_x)
        // The row's base, out of the inner loop: this is a multiply per pixel otherwise, and the
        // inner loop is the whole cost of a clip.
        val base = y * t.width
        var x = lo_x
        while x <= hi_x {
            val here = row[x]
            val before = switch existing {
                Some(prev) { prev[base + x] }
                None { 1.0 }
            }
            mask[base + x] = here * before
            x = x + 1
        }
        y = y + 1
    }
    return ok(snapshot(mask))
}

// ---- filling

fn fill_shape(
    t: Target,
    path: Path,
    k: Ink,
    m: Matrix,
    clip: Option<[float]>,
    o: Options
) -> Result<unit, string> {
    // The paint is evaluated in **user space**, by mapping each covered pixel's centre back through
    // the inverse. The alternative -- transforming the gradient's own geometry forward -- cannot be
    // right under a non-uniform scale, where a radial gradient's circle becomes an ellipse and its
    // `radius` has no single value to carry. So a singular matrix is refused rather than guessed
    // at; it also means the shape has no area, so nothing is lost.
    val inv = switch invert(m) {
        Ok(i) { i }
        Err(why) { return err(concat("raster: this group's transform cannot be inverted (", why, ")")) }
    }
    // **Asked before the path is transformed and flattened**, which is the point: `edges_of`
    // flattens every curve, and a regional repaint of a list row was still flattening eight
    // round-rect buttons outside it, every frame. Profiled at about a quarter of such a frame --
    // `cubic_is_flat`, `midpoint` and `flatten_cubic_into` together -- for shapes that could not
    // draw a pixel. The same mistake as shaping a text run before checking whether it is visible,
    // which `draw_text` had already been fixed for and this had not.
    if !reaches_window(t, shape.path_bounds(path), m) {
        return unit
    }
    val device = shape.transform_path(path, m)
    val e = edges_of(device)
    if len(e.xy) == 0 {
        return unit
    }
    // **Clamped to the target's write window, not to the canvas** -- which is the whole of how a
    // damage region skips work. A shape wholly outside the window produces `first > last` and
    // returns below, so an op that did not change costs the path transform and its edge list and
    // nothing else; a shape that straddles the window is drawn only where it is allowed to be,
    // which is what stops it corrupting the pixels the surface is keeping from the last frame.
    val first_row = clamp_int(floor(e.min_y), t.win_y0, t.win_y1)
    val last_row = clamp_int(ceil(e.max_y), t.win_y0, t.win_y1)
    // **The shape's own horizontal extent, not the canvas's.** A 26-pixel-wide rectangle on a
    // 600-pixel canvas otherwise costs 600 pixels a row instead of 26. Interleaved A/B on a page of
    // 400 of them: 3592 ms to 2253 ms, so 1.6x -- not the 23x the ratio of widths suggests, because
    // most of the remaining time is the edge scan and the interpreter, not this loop.
    val first_col = clamp_int(floor(e.min_x), t.win_x0, t.win_x1)
    val last_col = clamp_int(ceil(e.max_x), t.win_x0, t.win_x1)
    // `clamp_int` pins a shape that misses the window entirely to the window's own edge, so the
    // range it leaves is a single row or column rather than an empty one -- the emptiness has to be
    // tested against the *shape*. Without this a glyph far above the window would repaint its top
    // row, which is a one-pixel smear rather than an obvious failure.
    if ceil(e.max_y) < t.win_y0 || floor(e.min_y) > t.win_y1 {
        return unit
    }
    if ceil(e.max_x) < t.win_x0 || floor(e.min_x) > t.win_x1 {
        return unit
    }
    // A solid colour is the same at every pixel, so it is evaluated once instead of per pixel --
    // which also skips the inverse transform there. Every other ink genuinely varies with position.
    // Worth 1.33x on the same page (2253 ms to 1667 ms, interleaved), and `Solid` is the common case.
    val ready = try prepare(k, o.images)
    val row = mutable_array_filled<float>(t.width, 0.0)
    val plan = plan_of(e, first_row, last_row)
    val live = mutable_array_new<int>()
    var cursor = 0
    // **Both of these are decided once, not per pixel.** `clip` and `flat` are the same `Option`
    // for every pixel of the fill, and a `switch` on one inside the inner loop is an enum dispatch
    // a few hundred thousand times over for an answer that cannot change. Unwrapping them here
    // leaves the loop with two bool tests.
    val clipped = switch clip {
        Some(_) { true }
        None { false }
    }
    val no_mask: [float] = []
    val mask = switch clip {
        Some(m) { m }
        None { no_mask }
    }
    // A solid colour is the same at every pixel, so the loop reads it rather than asking.
    val is_flat = switch ready {
        Flat(_) { true }
        Axial(_) { false }
        Radial(_) { false }
        Tiled(_) { false }
        Placed(_) { false }
    }
    val flat_ink_value = switch ready {
        Flat(c) { c }
        Axial(_) { Premul { red: 0.0, green: 0.0, blue: 0.0, alpha: 0.0 } }
        Radial(_) { Premul { red: 0.0, green: 0.0, blue: 0.0, alpha: 0.0 } }
        Tiled(_) { Premul { red: 0.0, green: 0.0, blue: 0.0, alpha: 0.0 } }
        Placed(_) { Premul { red: 0.0, green: 0.0, blue: 0.0, alpha: 0.0 } }
    }
    // Decided once, like `is_flat` above: an ink the native can evaluate crosses as a flat spec,
    // and anything else keeps the per-pixel path.
    val spec = gradient_spec(ready, inv)
    val no_spec: [float] = []
    val spec_values = switch spec {
        Some(v) { v }
        None { no_spec }
    }
    val is_gradient = switch spec {
        Some(_) { true }
        None { false }
    }
    val ink_image = image_spec(ready, inv)
    val no_pixels: [byte] = []
    val image_spec_values = switch ink_image {
        Some(v) { v.spec }
        None { no_spec }
    }
    val image_pixels = switch ink_image {
        Some(v) { v.pixels }
        None { no_pixels }
    }
    val is_image = switch ink_image {
        Some(_) { true }
        None { false }
    }
    var y = first_row
    while y <= last_row {
        cursor = advance_active(plan, live, cursor, y)
        row_coverage(row, t.width, e, live, device.winding, o.samples, y, first_col, last_col)
        val row_base = y * t.width
        if is_flat {
            composite_row_flat(
                t.data,
                row,
                row_base,
                first_col,
                last_col,
                flat_ink_value.red,
                flat_ink_value.green,
                flat_ink_value.blue,
                flat_ink_value.alpha,
                mask,
                clipped
            )
        } else if is_image {
            composite_row_image(
                t.data,
                row,
                row_base,
                first_col,
                last_col,
                (y as float) + 0.5,
                image_spec_values,
                image_pixels,
                mask,
                clipped
            )
        } else if is_gradient {
            composite_row_gradient(
                t.data,
                row,
                row_base,
                first_col,
                last_col,
                (y as float) + 0.5,
                spec_values,
                mask,
                clipped
            )
        } else {
            var x = first_col
            while x <= last_col {
                val cov = row[x]
                // Below a 255th of a level there is nothing to add to an 8-bit channel, and skipping
                // it is what keeps a full-page fill from evaluating a gradient outside its own
                // bounds. The two natives reproduce both guards and this constant.
                if cov > 0.002 {
                    val through = if clipped { mask[row_base + x] } else { 1.0 }
                    if through > 0.002 {
                        val c = ready_at(ready, inv, point_of((x as float) + 0.5, (y as float) + 0.5))
                        composite(t, x, y, c, cov * through)
                    }
                }
                x = x + 1
            }
        }
        y = y + 1
    }
    return unit
}

// ---- the active edge table
//
// Part 1 scanned **every** edge of a path for every sub-scanline, which is fine for a rectangle and
// ruinous for a page of text: measured at 2160 glyphs, 87% of the time was in that scan. The fix is
// the textbook one, deferred until there was text to measure it against.
//
// Edges are ordered by the first row they touch (a counting sort over rows, so O(edges + rows) and
// no comparator), and a live list is carried down the page: each row admits the edges that start on
// it and drops the ones that ended above it. Because `y` and then `sy` both increase monotonically,
// each edge is added once and removed once however tall the shape is.
struct Plan {
    // Edge indices, ordered by `start`.
    order: [int]
    // Per edge: the first row it can touch, and the largest y it reaches.
    start: [int]
    high: [float]
}

fn plan_of(e: Edges, first_row: int, last_row: int) -> Plan {
    val count = len(e.xy) / 4
    val start = mutable_array_new<int>()
    val high = mutable_array_new<float>()
    var i = 0
    while i < count {
        val y0 = e.xy[i * 4 + 1]
        val y1 = e.xy[i * 4 + 3]
        val lo = if y0 < y1 { y0 } else { y1 }
        val hi = if y0 < y1 { y1 } else { y0 }
        push(start, clamp_int(floor(lo), first_row, last_row))
        push(high, hi)
        i = i + 1
    }
    // Counting sort by start row. The bucket array is one per row of the shape, not of the canvas.
    val rows = last_row - first_row + 1
    val counts = mutable_array_new<int>()
    var k = 0
    while k <= rows {
        push(counts, 0)
        k = k + 1
    }
    i = 0
    while i < count {
        val b = start[i] - first_row
        counts[b] = counts[b] + 1
        i = i + 1
    }
    var running = 0
    k = 0
    while k <= rows {
        val here = counts[k]
        counts[k] = running
        running = running + here
        k = k + 1
    }
    val order = mutable_array_new<int>()
    i = 0
    while i < count {
        push(order, 0)
        i = i + 1
    }
    i = 0
    while i < count {
        val b = start[i] - first_row
        order[counts[b]] = i
        counts[b] = counts[b] + 1
        i = i + 1
    }
    return Plan { order: snapshot(order), start: snapshot(start), high: snapshot(high) }
}

// Admit the edges that start on this row, drop those that ended above it, and report where the
// cursor got to. The cursor is returned rather than held in the struct because a `Plan` is a value.
fn advance_active(p: Plan, live: MutableArray<int>, cursor: int, y: int) -> int {
    var next = cursor
    while next < len(p.order) && p.start[p.order[next]] <= y {
        push(live, p.order[next])
        next = next + 1
    }
    var write = 0
    var read = 0
    while read < len(live) {
        val idx = live[read]
        if p.high[idx] > (y as float) {
            live[write] = idx
            write = write + 1
        }
        read = read + 1
    }
    narrow(live, 0, write)
    return next
}

// One pixel row's coverage, as a fraction in 0..1 per pixel.
//
// Vertically the row is sampled `samples` times; horizontally each span contributes its **exact**
// overlap with each pixel. That asymmetry is deliberate: horizontal exactness is free (it is one
// subtraction per span end) and it is the direction a near-vertical edge needs most.
fn row_coverage(
    row: MutableArray<float>,
    width: int,
    e: Edges,
    live: MutableArray<int>,
    winding: Winding,
    samples: int,
    y: int,
    from_x: int,
    to_x: int
) {
    row_coverage_at(row, width, e, live, winding, samples, y, from_x, to_x, 0)
}

// A glyph tile's row buffer is in tile coordinates, so its spans come back shifted left by the
// tile's own origin. Everything else is identical, which is why it is one parameter rather than a
// second copy of the loop.
fn row_coverage_shifted(
    row: MutableArray<float>,
    width: int,
    e: Edges,
    live: MutableArray<int>,
    winding: Winding,
    samples: int,
    y: int,
    shift: int
) {
    row_coverage_at(row, width, e, live, winding, samples, y, 0, width - 1, shift)
}

fn row_coverage_at(
    row: MutableArray<float>,
    width: int,
    e: Edges,
    live: MutableArray<int>,
    winding: Winding,
    samples: int,
    y: int,
    from_x: int,
    to_x: int,
    shift: int
) {
    // **The whole row in one native**, including the window clear: see `row_coverage_raw` for why
    // the boundary is here and not narrower.
    //
    // **The Ziman implementation of this loop is gone, and that is a real loss worth naming.**
    // Every earlier instalment of F270 could be checked against a slow correct version of the same
    // thing; from here the oracle is a fixture oracle. Keeping the Ziman version would have meant
    // dead code no test could reach, since it and the two functions only it called are private and
    // a fixture can only see `pub`.
    //
    // So the oracle was measured rather than assumed, by breaking the native eight ways and seeing
    // which fixture noticed. **Three fixtures do all the work** -- `graphics_raster.zm`,
    // `graphics_stroke.zm`, `graphics_text.zm` -- and two of the eight were caught by exactly one
    // fixture each, which is the part worth knowing before deleting a case that looks redundant:
    //
    //   - the even-odd predicate, by `graphics_raster` alone;
    //   - the half-open `sy < high` becoming `<=` -- the shared-vertex rule -- by `graphics_text`
    //     alone, because only glyph outlines here have contours that meet at a scanline.
    //
    // The other six (sample centre, the first and last partial pixel, edge direction, the crossing
    // sort, and the window clear) were each caught by three or four. `graphics_pdf`,
    // `graphics_geometry` and `graphics_image` were byte-identical across the port but caught none
    // of the eight, so they are not the gate here whatever their names suggest.
    row_coverage_raw(
        row,
        width,
        e.xy,
        live,
        winding_code(winding),
        samples,
        y,
        from_x,
        to_x,
        shift
    )
}

fn winding_code(w: Winding) -> int {
    return switch w {
        NonZero { 0 }
        EvenOdd { 1 }
    }
}

// Source-over in premultiplied alpha, which is two multiplies and an add per channel and the reason
// the buffer is premultiplied in the first place.
fn composite(t: Target, x: int, y: int, c: Premul, cov: float) {
    val at = (y * t.width + x) * 4
    val keep = 1.0 - c.alpha * cov
    t.data[at] = c.red * cov + t.data[at] * keep
    t.data[at + 1] = c.green * cov + t.data[at + 1] * keep
    t.data[at + 2] = c.blue * cov + t.data[at + 2] * keep
    t.data[at + 3] = c.alpha * cov + t.data[at + 3] * keep
}

// ---- paints

// A paint with everything that does not change per pixel already done: the stops premultiplied,
// the gradient's axis reduced to the numbers the projection needs, an image's inverse matrix taken.
//
// **This is where the paint's errors are raised**, once per fill rather than once per pixel --
// the same messages, from a place that runs a few hundred times a page instead of a few hundred
// thousand. Preparing it is also what stopped `ramp_at` re-premultiplying both of its stops on
// every pixel, which was three allocations a pixel for two values that never change.
struct ReadyStop {
    offset: float
    colour: Premul
}

struct ReadyAxial {
    from: Point
    dx: float
    dy: float
    span: float
    stops: [ReadyStop]
}

struct ReadyRadial {
    centre: Point
    radius: float
    stops: [ReadyStop]
}

struct ReadyTiled {
    img: image.Image
    inverse: Matrix
}

struct ReadyPlaced {
    img: image.Image
    into: Rect
}

enum Ready {
    Flat(Premul)
    Axial(ReadyAxial)
    Radial(ReadyRadial)
    Tiled(ReadyTiled)
    Placed(ReadyPlaced)
}

fn prepare(k: Ink, images: [image.Image]) -> Result<Ready, string> {
    return switch k {
        FromImage(tile) {
            ok(Ready.Placed(ReadyPlaced { img: images[tile.handle], into: tile.into }))
        }
        FromPaint(p) {
            switch p {
                Solid(c) { ok(Ready.Flat(premul_of(c))) }
                LinearGradient(g) {
                    val dx = g.to.x - g.from.x
                    val dy = g.to.y - g.from.y
                    val span = dx * dx + dy * dy
                    if span <= 0.0 {
                        return err("raster: a linear gradient whose two points are the same has no axis")
                    }
                    ok(Ready.Axial(ReadyAxial {
                        from: g.from,
                        dx: dx,
                        dy: dy,
                        span: span,
                        stops: try ready_stops(g.stops)
                    }))
                }
                RadialGradient(g) {
                    if g.radius <= 0.0 {
                        return err(concat(
                            "raster: a radial gradient needs a positive radius, got ",
                            format("{}", g.radius)
                        ))
                    }
                    ok(Ready.Radial(ReadyRadial {
                        centre: g.centre,
                        radius: g.radius,
                        stops: try ready_stops(g.stops)
                    }))
                }
                Pattern(tiled) {
                    if tiled.image < 0 || tiled.image >= len(images) {
                        return err(concat(
                            "raster: a pattern names image ",
                            str(tiled.image),
                            " but Options.images holds ",
                            str(len(images))
                        ))
                    }
                    // **The raster backend can draw this and the PDF one cannot**, which is the
                    // asymmetry invariant 2 exists for: a backend says what it cannot do instead
                    // of approximating. Sampling is nearest-neighbour, which is honest and
                    // obviously improvable, where a half-finished bilinear would be neither.
                    switch invert(tiled.transform) {
                        Ok(i) { ok(Ready.Tiled(ReadyTiled { img: images[tiled.image], inverse: i })) }
                        Err(why) {
                            err(concat("raster: this pattern's matrix cannot be inverted (", why, ")"))
                        }
                    }
                }
            }
        }
    }
}

fn ready_stops(stops: [Stop]) -> Result<[ReadyStop], string> {
    if len(stops) < 2 {
        return err(concat("raster: a gradient needs at least two stops, got ", str(len(stops))))
    }
    val out = mutable_array_new<ReadyStop>(capacity: len(stops))
    for s in stops {
        push(out, ReadyStop { offset: s.offset, colour: premul_of(s.color) })
    }
    return ok(snapshot(out))
}

fn ready_at(r: Ready, inv: Matrix, device: Point) -> Premul {
    return switch r {
        Flat(c) { c }
        Axial(g) {
            val user = transform_point(inv, device)
            // The projection of the point onto the axis, as a fraction of its length.
            ramp_at(g.stops, ((user.x - g.from.x) * g.dx + (user.y - g.from.y) * g.dy) / g.span)
        }
        Radial(g) {
            val user = transform_point(inv, device)
            val dx = user.x - g.centre.x
            val dy = user.y - g.centre.y
            ramp_at(g.stops, sqrt(dx * dx + dy * dy) / g.radius)
        }
        Tiled(tile) {
            val local = transform_point(tile.inverse, transform_point(inv, device))
            sample_image(
                tile.img,
                local.x / (tile.img.width as float),
                local.y / (tile.img.height as float)
            )
        }
        Placed(tile) {
            val user = transform_point(inv, device)
            val r2 = tile.into
            sample_image(tile.img, (user.x - r2.x) / r2.width, (user.y - r2.y) / r2.height)
        }
    }
}

// Interpolation **in premultiplied alpha**, over stops that were premultiplied once. Done on
// straight colour, a ramp from opaque red to transparent passes through a dark red halfway along,
// because the transparent stop's own RGB gets averaged in at full weight.
// The flat form of a gradient that `composite_row_gradient` reads -- see its own comment in
// src/native_raster.c for the layout. `None` for an ink the native does not handle, which keeps the
// per-pixel Ziman path below as the general case rather than a fallback nobody exercises.
//
// Built once per fill. The stops are already premultiplied by `prepare`, so this only flattens
// them; getting that wrong would darken every gradient through its middle, which is the bug
// `Premul`'s own comment warns about.
fn gradient_spec(r: Ready, inv: Matrix) -> Option<[float]> {
    val out = mutable_array_new<float>()
    val stops = switch r {
        Axial(g) {
            push(out, 0.0)
            push_matrix(out, inv)
            push(out, g.from.x)
            push(out, g.from.y)
            push(out, g.span)
            push(out, g.dx)
            push(out, g.dy)
            g.stops
        }
        Radial(g) {
            push(out, 1.0)
            push_matrix(out, inv)
            push(out, g.centre.x)
            push(out, g.centre.y)
            push(out, g.radius)
            push(out, 0.0)
            push(out, 0.0)
            g.stops
        }
        Flat(_) { return Option<[float]>.None }
        Tiled(_) { return Option<[float]>.None }
        Placed(_) { return Option<[float]>.None }
    }
    if len(stops) == 0 {
        return Option<[float]>.None
    }
    push(out, len(stops) as float)
    for one in stops {
        push(out, one.offset)
        push(out, one.colour.red)
        push(out, one.colour.green)
        push(out, one.colour.blue)
        push(out, one.colour.alpha)
    }
    return Option<[float]>.Some(snapshot(out))
}

// An image ink flattened the same way, plus the pixels it samples. `None` for anything that is
// not one, so the per-pixel Ziman path below stays the general case.
struct ImageInk {
    spec: [float]
    pixels: [byte]
}

fn image_spec(r: Ready, inv: Matrix) -> Option<ImageInk> {
    val out = mutable_array_new<float>()
    val img = switch r {
        Tiled(tile) {
            push(out, 2.0)
            push_matrix(out, inv)
            push_image_shape(out, tile.img)
            push_matrix(out, tile.inverse)
            tile.img
        }
        Placed(tile) {
            push(out, 3.0)
            push_matrix(out, inv)
            push_image_shape(out, tile.img)
            push(out, tile.into.x)
            push(out, tile.into.y)
            push(out, tile.into.width)
            push(out, tile.into.height)
            tile.img
        }
        Flat(_) { return Option<ImageInk>.None }
        Axial(_) { return Option<ImageInk>.None }
        Radial(_) { return Option<ImageInk>.None }
    }
    // A degenerate destination would divide by zero per pixel; the Ziman path produces an infinity
    // that `sample_image` then clamps, and reproducing that in C is not worth the argument -- so it
    // stays on the general path instead.
    if img.width < 1 || img.height < 1 {
        return Option<ImageInk>.None
    }
    if Placed(tile) = r {
        if tile.into.width == 0.0 || tile.into.height == 0.0 {
            return Option<ImageInk>.None
        }
    }
    return Option<ImageInk>.Some(ImageInk { spec: snapshot(out), pixels: img.data })
}

fn push_image_shape(out: MutableArray<float>, img: image.Image) {
    push(out, img.width as float)
    push(out, img.height as float)
    push(out, image.channels_of(img.format) as float)
}

fn push_matrix(out: MutableArray<float>, m: Matrix) {
    push(out, m.a)
    push(out, m.b)
    push(out, m.c)
    push(out, m.d)
    push(out, m.e)
    push(out, m.f)
}

fn ramp_at(stops: [ReadyStop], raw: float) -> Premul {
    var t = raw
    if t < 0.0 {
        t = 0.0
    }
    if t > 1.0 {
        t = 1.0
    }
    if t <= stops[0].offset {
        return stops[0].colour
    }
    var i = 1
    while i < len(stops) {
        val lo = stops[i - 1]
        val hi = stops[i]
        if t <= hi.offset {
            val width = hi.offset - lo.offset
            val f = if width > 0.0 { (t - lo.offset) / width } else { 0.0 }
            val a = lo.colour
            val b = hi.colour
            return Premul {
                red: a.red + (b.red - a.red) * f,
                green: a.green + (b.green - a.green) * f,
                blue: a.blue + (b.blue - a.blue) * f,
                alpha: a.alpha + (b.alpha - a.alpha) * f
            }
        }
        i = i + 1
    }
    return stops[len(stops) - 1].colour
}

// Nearest-neighbour, clamped at the edges. `u` and `v` are in 0..1 across the image.
// Nearest-neighbour, clamped at the edges, straight out of the buffer.
//
// **Not through `image.pixel_at`**, which is the obvious way to write this and allocates three
// values a pixel for it: a `Result`, the `Color` inside it, and the `Premul` this converts that
// into. At a page-sized image that is over a million allocations whose only purpose is to be
// discarded, and the collector was 21% of a profile because of it. The layout read here is
// `pixel_at`'s own -- row-major, `width * channels` per row -- and that function stays the
// reference for it; premultiplying is this module's business and not `image`'s, which is why the
// conversion lives on this side.
fn sample_image(img: image.Image, u: float, v: float) -> Premul {
    val x = clamp_int(floor(u * (img.width as float)), 0, img.width - 1)
    val y = clamp_int(floor(v * (img.height as float)), 0, img.height - 1)
    val n = image.channels_of(img.format)
    val at = (y * img.width + x) * n
    if n == 1 {
        val g = ((img.data[at] as int) as float) / 255.0
        return Premul { red: g, green: g, blue: g, alpha: 1.0 }
    }
    if n == 3 {
        return Premul {
            red: ((img.data[at] as int) as float) / 255.0,
            green: ((img.data[at + 1] as int) as float) / 255.0,
            blue: ((img.data[at + 2] as int) as float) / 255.0,
            alpha: 1.0
        }
    }
    // `image.Image` stores un-premultiplied RGBA, so the alpha multiplies in here.
    val a = ((img.data[at + 3] as int) as float) / 255.0
    return Premul {
        red: ((img.data[at] as int) as float) / 255.0 * a,
        green: ((img.data[at + 1] as int) as float) / 255.0 * a,
        blue: ((img.data[at + 2] as int) as float) / 255.0 * a,
        alpha: a
    }
}

// ---- the edge list

// Built from `shape.flattened`, which owns the adaptive subdivision: a second implementation of it
// in here would be a second chance to get the same arithmetic wrong, and `stroker` needs the same
// polylines anyway.
//
// **A fill always closes.** An unclosed subpath still bounds a region, and leaving its last edge
// out would let the span loop pair a crossing with one from the next subpath.
fn edges_of(p: Path) -> Edges {
    val xy = mutable_array_new<float>()
    for line in shape.flattened(p, flatten_tolerance) {
        val pts = line.points
        var i = 0
        while i < len(pts) {
            val a = pts[i]
            val b = pts[(i + 1) % len(pts)]
            push_edge(xy, a.x, a.y, b.x, b.y)
            i = i + 1
        }
    }
    // The extent of the whole edge list, in both directions. The horizontal half is what keeps a
    // narrow shape from costing a full canvas row per scanline -- see `fill_shape`.
    var min_x = 0.0
    var max_x = 0.0
    var min_y = 0.0
    var max_y = 0.0
    if len(xy) >= 2 {
        min_x = xy[0]
        max_x = min_x
        min_y = xy[1]
        max_y = min_y
    }
    var i = 0
    while i + 1 < len(xy) {
        val x = xy[i]
        val y = xy[i + 1]
        if x < min_x {
            min_x = x
        }
        if x > max_x {
            max_x = x
        }
        if y < min_y {
            min_y = y
        }
        if y > max_y {
            max_y = y
        }
        i = i + 2
    }
    return Edges { xy: snapshot(xy), min_x: min_x, max_x: max_x, min_y: min_y, max_y: max_y }
}

fn push_edge(xy: MutableArray<float>, x0: float, y0: float, x1: float, y1: float) {
    // A horizontal edge crosses no scanline. Dropping it here is why `crossings_at` never divides
    // by zero.
    if y0 == y1 {
        return
    }
    push(xy, x0)
    push(xy, y0)
    push(xy, x1)
    push(xy, y1)
}

// ---- output

// The float buffer out as bytes.
//
// **One loop per format, and the clamp written inline.** This runs once per pixel of the whole
// canvas whatever was drawn, so at 600x800 it is 480,000 iterations: a `to_byte` call per channel
// is 1.4 million interpreted calls, and re-deciding the format inside the loop is 480,000 branches
// on a value that cannot change. Measured at 12.5% of a page before this, with `to_byte` another
// 7.8% on top.
fn finish(t: Target, format: image.Pixels) -> Result<image.Image, string> {
    val bytes = try to_bytes_premul(t.data, image.channels_of(format))
    return image.image_of(t.width, t.height, format, bytes)
}

fn to_byte(v: float) -> byte {
    var x = v * 255.0 + 0.5
    if x < 0.0 {
        x = 0.0
    }
    if x > 255.0 {
        x = 255.0
    }
    return (x as int) as byte
}

fn clamp_int(v: int, low: int, high: int) -> int {
    if v < low {
        return low
    }
    if v > high {
        return high
    }
    return v
}

fn abs_float(v: float) -> float {
    if v < 0.0 {
        return 0.0 - v
    }
    return v
}
use geom
use shape
