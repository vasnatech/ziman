// schedule.zm -- periodic background work inside a long-running process.
//
// The gap this fills: `server.serve` owns the accept loop and never returns, so a program that
// also has to do something *on a clock* -- a nightly scan, a cache refresh, an expiry sweep -- had
// nowhere to put it. The pieces were all here (`spawn`, `Channel`, `clock.sleep_millis`), and the
// loop that combines them is the part everyone would write slightly differently and one of them
// would get wrong. So it lives here once.
//
// The shape is one scheduler thread holding every job's own next-due time, spawning each due job
// as it falls due. `spawn` it beside the server and the two run independently:
//
//     val stop: Channel<unit> = channel_new()
//     spawn schedule.run_until(jobs, stop, fn(name: string, message: string) {
//         log.error(logger, concat("job ", name, " failed: ", message))
//     })
//     server.serve(listener, handler, options)
//
// **Why a due job is `spawn`ed rather than called.** A runtime error ends the thread it happens in
// (docs/DESIGN.md), so a job that aborts -- an `unwrap` on a `None`, a database that went away --
// would take the scheduler with it and silently stop every *other* job for the life of the
// process. Spawned, it ends only itself and arrives at `on_error` instead. The cost of that choice,
// stated plainly: nothing waits for a job to finish, so a job that takes longer than its own
// interval will overlap with its next run. `EveryMillis` therefore means "start one every N
// milliseconds", not "leave N milliseconds between them" -- keep a job shorter than its interval,
// or have it hold its own lock if overlapping would be wrong.
//
// **Three forms, and when to use which.** `every_millis` for "every so often", `daily_at_utc` for
// the common daily case, and `cron` for a pattern neither can express -- a weekday-only sweep, the
// first of the month -- or one carried over from another system. The overlap between the last two
// is real and deliberate: `daily_at_utc(8, 0)` and `cron("0 0 8 * * *")` are the same schedule, but
// the first is checked by the compiler for arity and type and by a `Result` for range, while the
// second is a string that parses or does not. Prefer the constructor when it fits.
//
// **UTC only, deliberately.** `daily_at_utc` is arithmetic on the epoch second (`% 86400`), which
// is why this module needs no calendar and does not import `time`. A local-time daily schedule
// would need `time`/`zone` *and* an answer for the two days a year when 02:30 happens twice or not
// at all -- a real design question, not an oversight, and one worth settling only when something
// asks for it. Every `@Scheduled` job in the reference backend is already `zone = "UTC"`.
use clock
use time.LocalDate
use time.localdate_from_epoch_day

// How often a job runs. Two forms, because these are the two questions that have come up: "every
// so often" and "once a day at a fixed time".
pub enum Schedule {
    // Start a run every N milliseconds, the first one immediately.
    EveryMillis(int)
    // Run once a day, at this many seconds past 00:00:00 UTC.
    DailyAtUtc(int)
    // Run whenever the UTC wall clock matches a cron pattern (`cron`).
    Cron(CronSpec)
}

// A parsed cron expression, as one membership table per field: `seconds[s]` is true when second `s`
// matches. Tables rather than a re-parse per tick, because the loop asks "does now match" several
// times a second and the answer is then six array reads.
//
// `dom_restricted`/`dow_restricted` record whether the day-of-month and day-of-week fields were
// anything other than `*`, which `cron` uses to refuse an expression that restricts both -- see
// there for why.
pub struct CronSpec {
    seconds: [bool]
    minutes: [bool]
    hours: [bool]
    days_of_month: [bool]
    months: [bool]
    days_of_week: [bool]
    dom_restricted: bool
    dow_restricted: bool
}

// `every_millis(60000)` -- every minute. Refuses a non-positive interval, which would otherwise be
// a spin loop that looks like a scheduler.
pub fn every_millis(ms: int) -> Result<Schedule, string> {
    if ms <= 0 {
        return err(concat("schedule.every_millis needs a positive interval, got ", str(ms)))
    }
    return ok(Schedule.EveryMillis(ms))
}

// `daily_at_utc(8, 0)` -- 08:00 UTC every day.
pub fn daily_at_utc(hour: int, minute: int) -> Result<Schedule, string> {
    if hour < 0 || hour > 23 {
        return err(concat("schedule.daily_at_utc needs an hour of 0..23, got ", str(hour)))
    }
    if minute < 0 || minute > 59 {
        return err(concat("schedule.daily_at_utc needs a minute of 0..59, got ", str(minute)))
    }
    return ok(Schedule.DailyAtUtc(hour * 3600 + minute * 60))
}

val day_names: [string] = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
val month_names: [string] = ["", "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]

// Parses a cron expression into a `Schedule`.
//
// **Six fields, not five: `second minute hour day-of-month month day-of-week`.** This is the form
// Spring and Quartz use, and it is the form every expression in the reference backend is written
// in. A five-field expression -- the Unix `crontab` form, which has no seconds -- is **refused by
// field count rather than guessed at**, because the two dialects collide silently: `0 8 * * *` is
// "08:00 daily" to crontab and "every hour at 8 minutes past" here, which is a schedule that runs
// twenty-four times too often and never errors. Refusing is the same answer `..=` gets from the
// lexer, and for the same reason: a message beats a plausible misreading.
//
// Each field takes `*`, a number, `a-b`, `*/n`, `a-b/n`, and a comma-separated list of any of
// those. `?` is accepted as a synonym for `*`. Day-of-week is 0-6 with 0 as Sunday, and 7 is also
// Sunday so a copied expression keeps working; the names `SUN`-`SAT` and `JAN`-`DEC` are accepted
// case-insensitively.
//
// **What is refused, with a message rather than silently:** `L` (last), `W` (nearest weekday) and
// `#` (nth weekday) are not implemented; and an expression that restricts *both* day-of-month and
// day-of-week is refused, because the two established answers disagree -- Vixie cron fires when
// **either** matches, Quartz requires a `?` in one and forbids the pair -- so an expression meaning
// one thing elsewhere would quietly mean the other here. Write `*` or `?` in whichever one does not
// apply.
pub fn cron(expr: string) -> Result<Schedule, string> {
    val fields = split_fields(trim(expr))
    if len(fields) == 5 {
        return err(concat(
            "schedule.cron takes six fields (second minute hour day-of-month month day-of-week), ",
            "and got five: '",
            expr,
            "'. A five-field expression is the Unix crontab form, which has ",
            "no seconds field -- it is refused rather than assumed because the dialects collide: ",
            "'0 8 * * *' is 08:00 daily to crontab and every hour at 8 minutes past here. Add a ",
            "leading seconds field, so '0 8 * * *' becomes '0 0 8 * * *'."
        ))
    }
    if len(fields) != 6 {
        return err(concat(
            "schedule.cron takes six fields (second minute hour day-of-month month day-of-week), got ",
            str(len(fields)),
            ": '",
            expr,
            "'"
        ))
    }
    val seconds = try parse_field(fields[0], 0, 59, [], "second")
    val minutes = try parse_field(fields[1], 0, 59, [], "minute")
    val hours = try parse_field(fields[2], 0, 23, [], "hour")
    val doms = try parse_field(fields[3], 1, 31, [], "day-of-month")
    val months = try parse_field(fields[4], 1, 12, month_names, "month")
    val dows = try parse_field(fields[5], 0, 7, day_names, "day-of-week")
    val dom_restricted = !is_wildcard(fields[3])
    val dow_restricted = !is_wildcard(fields[5])
    if dom_restricted && dow_restricted {
        return err(concat(
            "schedule.cron refuses an expression that restricts both day-of-month and day-of-week ('",
            fields[3],
            "' and '",
            fields[5],
            "'), because the established answers disagree: Vixie cron ",
            "fires when either matches, Quartz forbids the pair. Write '*' or '?' in whichever does not apply."
        ))
    }
    // 7 is Sunday as well as 0, so fold it down before the tables are frozen.
    val dow = mutable_array_new<bool>()
    var d = 0
    while d < 7 {
        push(dow, dows[d] || (d == 0 && dows[7]))
        d = d + 1
    }
    return ok(Schedule.Cron(CronSpec {
        seconds: seconds,
        minutes: minutes,
        hours: hours,
        days_of_month: doms,
        months: months,
        days_of_week: snapshot(dow),
        dom_restricted: dom_restricted,
        dow_restricted: dow_restricted
    }))
}

// Splits on runs of spaces, so an expression padded for alignment still parses.
fn split_fields(expr: string) -> [string] {
    val out = mutable_array_new<string>()
    for part in split(expr, " ") {
        if byte_len(trim(part)) > 0 {
            push(out, trim(part))
        }
    }
    return snapshot(out)
}

fn is_wildcard(field: string) -> bool {
    val f = trim(field)
    return f == "*" || f == "?"
}

// One field to a membership table of `max + 1` entries. `names` maps a leading-letter spelling to
// its number by index (`day_names[1]` is "MON"), and is empty for the numeric-only fields.
fn parse_field(field: string, min: int, max: int, names: [string], label: string) -> Result<[bool], string> {
    val hits = mutable_array_new<bool>()
    var i = 0
    while i <= max {
        push(hits, false)
        i = i + 1
    }
    if contains(field, "L") || contains(field, "W") || contains(field, "#") {
        return err(concat(
            "schedule.cron does not implement 'L', 'W' or '#' (the ",
            label,
            " field is '",
            field,
            "'): they need a calendar rule this module has no answer for yet"
        ))
    }
    for part in split(field, ",") {
        val piece = trim(part)
        if byte_len(piece) == 0 {
            return err(concat("schedule.cron found an empty entry in the ", label, " field"))
        }
        // `*/n` and `a-b/n`: the step applies to whatever precedes the slash.
        var range_text = piece
        var step = 1
        if Some(halves) = split_once(piece, "/") {
            range_text = trim(halves[0])
            val parsed = parse_int(trim(halves[1]))
            switch parsed {
                Ok(n) {
                    if n <= 0 {
                        return err(concat(
                            "schedule.cron needs a positive step in the ",
                            label,
                            " field, got '",
                            piece,
                            "'"
                        ))
                    }
                    step = n
                }
                Err(_) {
                    return err(concat(
                        "schedule.cron could not read the step in the ",
                        label,
                        " field: '",
                        piece,
                        "'"
                    ))
                }
            }
        }
        var from = min
        var to = max
        if !is_wildcard(range_text) {
            if Some(ends) = split_once(range_text, "-") {
                from = try field_number(trim(ends[0]), min, max, names, label)
                to = try field_number(trim(ends[1]), min, max, names, label)
            } else {
                from = try field_number(range_text, min, max, names, label)
                // A bare number with a step runs from it to the end of the field, as cron does:
                // `5/10` in minutes is 5, 15, 25, ... not just 5.
                if step > 1 {
                    to = max
                } else {
                    to = from
                }
            }
        }
        if from > to {
            return err(concat("schedule.cron got a reversed range in the ", label, " field: '", piece, "'"))
        }
        var at = from
        while at <= to {
            hits[at] = true
            at = at + step
        }
    }
    return ok(snapshot(hits))
}

fn field_number(text: string, min: int, max: int, names: [string], label: string) -> Result<int, string> {
    val upper = to_upper(text)
    var idx = 0
    while idx < len(names) {
        if byte_len(names[idx]) > 0 && names[idx] == upper {
            return ok(idx)
        }
        idx = idx + 1
    }
    switch parse_int(text) {
        Ok(n) {
            if n < min || n > max {
                return err(concat(
                    "schedule.cron needs ",
                    str(min),
                    "-",
                    str(max),
                    " in the ",
                    label,
                    " field, got '",
                    text,
                    "'"
                ))
            }
            return ok(n)
        }
        Err(_) {
            return err(concat("schedule.cron could not read the ", label, " field entry '", text, "'"))
        }
    }
}

// One scheduled job. `name` is what `on_error` is told, so make it the name you would want to read
// in a log line at four in the morning.
pub struct Job {
    name: string
    schedule: Schedule
    run: fn() -> Result<unit, string>
}

pub fn job(name: string, schedule: Schedule, run: fn() -> Result<unit, string>) -> Job {
    return Job { name: name, schedule: schedule, run: run }
}

// How long the loop will sleep before looking again. A job never fires late by more than this, and
// `stop` is never noticed later than this. Fixed rather than configurable: 250ms is already far
// below any schedule worth expressing here, and a knob on it would be one more thing to get wrong.
val slice_ms: int = 250

// Runs `jobs` until `stop` delivers anything, then returns. Intended to be `spawn`ed; a server that
// wants the scheduler for the whole life of the process passes a channel it never sends on, and
// process exit tears the thread down.
//
// `on_error(name, message)` is called for a job that returns an `Err` *and* for one that aborts, so
// it is the one place a failure can be seen. It runs on the scheduler's own thread for an `Err` and
// on the job's thread for an abort, so it must be safe to call from either -- which is why it takes
// plain strings rather than anything thread-bound.
pub fn run_until(jobs: [Job], stop: Channel<unit>, on_error: fn(string, string)) {
    // Per-job state, parallel to `jobs`, owned by this thread and never shared.
    //  - due_at: monotonic millisecond an `EveryMillis` job is next due. 0 means "now".
    //  - last_day: epoch day a `DailyAtUtc` job last ran on, -1 for never.
    //  - last_sec: epoch second a `Cron` job last ran on, -1 for never. The loop looks several
    //    times a second, so without this a one-second match fires on every look within it.
    val due_at = mutable_array_new<int>()
    val last_day = mutable_array_new<int>()
    val last_sec = mutable_array_new<int>()
    for _ in jobs {
        push(due_at, 0)
        push(last_day, -1)
        push(last_sec, -1)
    }

    var running = true
    while running {
        if Some(_) = try_receive(stop) {
            running = false
        } else {
            val now_mono = clock.monotonic_millis()
            val now_secs = clock.now_raw()[0]
            val epoch_day = now_secs / 86400
            val sec_of_day = now_secs % 86400

            var i = 0
            while i < len(jobs) {
                val j = jobs[i]
                switch j.schedule {
                    EveryMillis(ms) {
                        if now_mono >= due_at[i] {
                            start(j, on_error)
                            // From now, not from when it was due: a process that was paused or a
                            // job that ran long should not come back to a queue of missed runs it
                            // then fires back to back.
                            due_at[i] = clock.monotonic_millis() + ms
                        }
                    }
                    DailyAtUtc(target) {
                        // Fires on the first look after the target passes, and once a day: the day
                        // guard is what stops it firing again on every slice until midnight.
                        if sec_of_day >= target && epoch_day > last_day[i] {
                            last_day[i] = epoch_day
                            start(j, on_error)
                        }
                    }
                    Cron(spec) {
                        // Matches the wall clock rather than computing a next-fire time: the loop
                        // already wakes several times a second, so asking "does now match" is six
                        // array reads, where working out the next matching instant means calendar
                        // arithmetic over month lengths and leap years for no gain.
                        if now_secs > last_sec[i] && cron_matches_at(spec, now_secs) {
                            last_sec[i] = now_secs
                            start(j, on_error)
                        }
                    }
                }
                i = i + 1
            }
            clock.sleep_millis(slice_ms)
        }
    }
}

// Whether the UTC wall clock at `epoch_second` matches `spec` -- what the loop asks on every look,
// and public because it is the only way to check a schedule without waiting for it. A pure function
// of its two arguments, so a test can ask about next February from today.
//
// Day-of-month and day-of-week are both consulted, but `cron` has already refused an expression
// that restricts both, so at most one of them is doing any work here and the two cron dialects
// cannot disagree about this.
pub fn cron_matches_at(spec: CronSpec, epoch_second: int) -> bool {
    val epoch_day = epoch_second / 86400
    val sec_of_day = epoch_second % 86400
    if !spec.seconds[sec_of_day % 60] {
        return false
    }
    if !spec.minutes[(sec_of_day / 60) % 60] {
        return false
    }
    if !spec.hours[sec_of_day / 3600] {
        return false
    }
    val date = localdate_from_epoch_day(epoch_day)
    if !spec.months[date.month] {
        return false
    }
    if spec.dom_restricted && !spec.days_of_month[date.day] {
        return false
    }
    if spec.dow_restricted {
        // 1970-01-01 was a Thursday, so day 0 is index 4 with 0 as Sunday.
        if !spec.days_of_week[(epoch_day + 4) % 7] {
            return false
        }
    }
    return true
}

// Spawns one run of `j`. Named rather than a lambda because `spawn` takes a function call, and the
// job's own closure has to travel as an argument (`spawn j.run()` is not a thing -- Ziman has no
// methods, and `spawn` wants a named function).
fn start(j: Job, on_error: fn(string, string)) {
    spawn run_once(j.name, j.run, on_error) on_error fn(message: string) {
        on_error(j.name, message)
    }
}

fn run_once(name: string, body: fn() -> Result<unit, string>, on_error: fn(string, string)) {
    switch body() {
        Ok(_) {}
        Err(message) { on_error(name, message) }
    }
}
