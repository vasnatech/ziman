// time.zm -- dates, times, durations and instants, modeled on java.time and written in ordinary
// Ziman (the only native code is `clock.now_raw`, which reads the system clock).
//
// Seven types, all plain structs with `==`/`!=` and a `_compare` function that makes them `Ord`
// (so `compare` and `array_sort` work on them):
//
//   LocalDate       a calendar date: year, month, day
//   LocalTime       a time of day, to the nanosecond
//   LocalDateTime   a date and a time of day, with no zone
//   Duration        a length of time: seconds and nanoseconds
//   Instant         a point on the timeline: seconds and nanoseconds since 1970-01-01T00:00:00Z
//   ZoneOffset      a fixed offset from UTC, such as `+05:30`
//   ZoneId          an IANA time zone such as `Europe/Paris`, with its daylight saving rules
//
// Build a value with its `_of` function, which checks the fields and returns a `Result`; add to it
// with `_add_*`; compare with `_compare`. Every type reads and writes its ISO-8601 form with
// `_to_string` / `_from_string` (`2026-09-24`, `13:05:09.5`, `PT1.5S`, `+05:30`). The calendar
// types and `Instant` also take a `DateTimeFormat`, a pattern compiled once by
// `datetime_format_of` and reused: `yyyy MM dd HH mm ss` and `SSSSSSSSS` (nanoseconds), each fixed
// width, anything else copied through as literal text. Every type has `_to_json` / `_from_json`
// and `_to_sql` / `_from_sql`, so `#[derive(Json)]` and `#[derive(Row)]` handle a field of these
// types (an ISO string, and a TEXT column).
//
// Named zones (`zoneid_of("Europe/Paris")`) come from the system's IANA zone files (see `zone`), so
// they need the operating system's tzdata package; `zoneid_offset_at` gives the offset at an
// instant and `instant_to_localdatetime_in` / `localdatetime_to_instant_in` convert with daylight
// saving applied.
//
// Limits: years are 0 or later (no BCE), and there is no locale, month name or weekday support.
// That last one is tracked as of 2026-10-23 rather than merely noted: ROADMAP.md's "Locale support"
// entry has it as item 5, where the hole is shaped like a missing pattern letter for
// `datetime_format_of` rather than a missing module.

// Implementation notes. Modeled on java.time, scoped down in two deliberate ways:
//
// - Named zones read the operating system's zone files (module `zone`) instead of embedding the
//   IANA database, which changes several times a year worldwide; a system without them can still
//   use `UTC` and fixed `ZoneOffset`s, and gets an Err from `zoneid_of` for the rest.
// - Instant/Duration are `{ seconds: int, nanos: int }`, matching both
//   C's own `struct timespec` and java.time's internal shape -- not a
//   single bigint-nanoseconds count, which is what this project tried
//   first: `int` (int64) nanoseconds-since-epoch only covers ~292
//   years, the exact problem Java's own split representation avoids.
//   `nanos` is always kept in [0, 999999999]; `seconds` carries the
//   overall sign -- so -0.5s is `{seconds: -1, nanos: 500000000}`, not
//   `{seconds: 0, nanos: -500000000}`. Every constructor/arithmetic
//   function funnels through `normalize` below to maintain this.
//
// No `<`/`>` operators on any of these seven types. Every type instead has
// a `_compare(a, b) -> int` function (negative/zero/positive, the same
// convention as C's strcmp/qsort comparator), which is what makes it `Ord`
// (usable with `compare` and `array_sort`); `==`/`!=` come free from
// structural equality on plain int/struct fields.
//
// Calendar year is assumed non-negative throughout (no BCE support) --
// undocumented territory nothing here needs, so it's not handled rather
// than silently mishandled.
//
// Formatting and parsing: every type has a fixed ISO-8601-shaped
// `_to_string`/`_from_string` pair (no arguments beyond the value/string
// itself -- named to match `uuid_to_string`/`uuid_from_string`, not the
// original `_parse`, once a proposed compile-time JSON-derive mechanism
// wanted one canonical suffix across every corelib type to look for)
// plus, for the three calendar-shaped types (`LocalDate`,
// `LocalTime`, `LocalDateTime`) and `Instant`, a general `_format`/
// `_parse_pattern` pair taking a `DateTimeFormat`. `DateTimeFormat` is
// a *compiled representation* of a pattern, not a wrapper around the
// pattern string -- `datetime_format_of(pattern) -> DateTimeFormat`
// scans the pattern exactly once, up front, into an array of
// `DateTimePart`s (each either a known field or a literal run of
// characters); format_fields/parse_fields below then walk that array
// directly, never re-scanning the original pattern text. This matters
// because a `DateTimeFormat` is meant to be built once and reused --
// see the `iso_*_format` global vals below, each compiled exactly once
// at program start (see docs/DESIGN.md's "Global val" entry) and reused
// for the process's whole lifetime, and the `_to_string` pair is
// implemented *in terms of* the general one using those, one engine
// rather than two independently-maintained implementations of "what
// does an ISO date look like." `Duration`/`ZoneOffset`/`ZoneId` only
// get the fixed ISO pair -- their `_to_string` shapes ("PT...S",
// "Z"/"+HH:MM", a bare zone name) aren't calendar patterns in the same
// sense, so a general pattern language wouldn't fit them the way it
// fits a year/month/day/hour/minute/second breakdown.

// Named constants used throughout: the {seconds, nanos} representation, and the civil-date
// (days <-> year/month/day) algorithm's cycle length and epoch shift (Howard Hinnant's
// `civil_from_days`, with the 0000-03-01 origin).
val nanos_per_second = 1000000000
val max_nano = 999999999
val seconds_per_hour = 3600
val seconds_per_day = 86400
val nanos_per_day = 86400000000000
val max_offset_seconds = 64800
val days_per_era = 146097
val epoch_shift_days = 719468

use clock.now_raw
use db.DbError
use db.SqlValue
use db.sql_as_text
use db.sql_lift
use json.Json
use zone.ZoneRules
use zone.load_rules
use zone.no_rule
use zone.type_at

fn is_leap_year(year: int) -> bool {
    if year % 400 == 0 {
        return true
    }
    if year % 100 == 0 {
        return false
    }
    return year % 4 == 0
}

fn days_in_month(year: int, month: int) -> int {
    if month == 1 || month == 3 || month == 5 || month == 7 || month == 8 || month == 10 || month == 12 {
        return 31
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }
    return if is_leap_year(year) { 29 } else { 28 }
}

fn pad_left(n: int, width: int) -> string {
    var s = str(n)
    while byte_len(s) < width {
        s = concat("0", s)
    }
    return s
}

// The pattern language datetime_format_of compiles -- deliberately
// small, fixed-width-only (no Java-style "letter count changes meaning"
// -- M vs MM vs MMM vs MMMM mean four different things there; here
// there's exactly one recognized run length per letter and nothing
// else), and with no month/day names or locale-awareness at all:
//
//   yyyy       4-digit zero-padded year
//   MM         2-digit zero-padded month
//   dd         2-digit zero-padded day
//   HH         2-digit zero-padded hour (0-23)
//   mm         2-digit zero-padded minute
//   ss         2-digit zero-padded second
//   SSSSSSSSS  9-digit zero-padded nanosecond-of-second
//
// Every token's pattern-string length equals its own rendered-output
// length exactly (each is fixed-width in both directions) -- a
// deliberate property, not a coincidence: `DateTimeFormat.width` below
// (and instant_parse_pattern, which uses it) relies on this to know
// exactly where the calendar part of an instant string ends and its
// zone-offset suffix begins, with no separator to search for. Anything
// else in a pattern is a literal, copied through character by
// character, with no escaping mechanism -- none of the separators any
// pattern here actually needs ("-", ":", ".", "T") collide with a
// token letter, so there's nothing to escape. A pattern with a
// *different* run length of one of these letters (e.g. three `S`s)
// matches no token and is folded into the surrounding literal text
// too, rather than erroring -- a narrow, documented scope cut, not a
// trap that's been guarded against.
fn matches_token(pattern: string, i: int, token: string) -> bool {
    return is_char_at(pattern, i, token)
}

// One part of a compiled `DateTimeFormat` -- either a known field or a
// run of literal characters (consecutive literal characters are
// coalesced into one `Literal` at compile time, in datetime_format_of,
// rather than kept one part per character).
enum DateTimePart {
    Year
    Month
    Day
    Hour
    Minute
    Second
    Nano
    Literal(string)
}

// A pattern, compiled once (by datetime_format_of) into a form
// format_fields/parse_fields can walk directly, without ever re-
// scanning the original pattern text -- the whole point of this type
// existing separately from a bare pattern string, since a
// `DateTimeFormat` is meant to be built once (see the `iso_*_format`
// global vals below, or a project's own, compiled once wherever it's
// declared) and then reused for many format/parse calls. `width` is
// the pattern's total rendered/parsed length, precomputed at compile
// time from `parts` (never recomputed per call) -- see the pattern-
// language comment above for why every part's width is already fixed
// and known. `parts`/`width` are implementation details, not part of
// the intended public API, same as `HashMap`'s `buckets`/`count`.
pub struct DateTimeFormat {
    parts: [DateTimePart]
    width: int
}

fn datetime_part_width(part: DateTimePart) -> int {
    return switch part {
        Year { 4 }
        Month { 2 }
        Day { 2 }
        Hour { 2 }
        Minute { 2 }
        Second { 2 }
        Nano { 9 }
        Literal(s) { byte_len(s) }
    }
}

// Scans `pattern` exactly once, building the compiled parts array
// (and its total width) that format_fields/parse_fields below then
// work from -- the one place the pattern text itself is ever matched
// character by character.
// `parts` is built via MutableArray<DateTimePart> rather than `push` in
// a loop -- an arbitrarily long/verbose pattern used to mean one
// leaked, ever-growing array per recognized token (see docs/DESIGN.md's
// "MutableArray" entry). `literal_buf`, in contrast, is left as plain
// `concat` on purpose: it only ever accumulates the handful of literal
// characters *between* two tokens in a pattern (a "-", a ":", at most a
// few characters in any realistic pattern), reset back to "" the
// instant a token flushes it -- a fixed, small bound with nothing to
// gain from a builder, the same reasoning `pad_left` above and
// `int_to_hex`'s zero-padding loop are exempted from converting too.
pub fn datetime_format_of(pattern: string) -> DateTimeFormat {
    val parts = mutable_array_new<DateTimePart>()
    var literal_buf = ""
    var i = 0
    val plen = byte_len(pattern)
    while i < plen {
        if matches_token(pattern, i, "yyyy") {
            if literal_buf != "" {
                push(parts, DateTimePart.Literal(literal_buf))
                literal_buf = ""
            }
            push(parts, DateTimePart.Year)
            i = i + 4
        } else if matches_token(pattern, i, "MM") {
            if literal_buf != "" {
                push(parts, DateTimePart.Literal(literal_buf))
                literal_buf = ""
            }
            push(parts, DateTimePart.Month)
            i = i + 2
        } else if matches_token(pattern, i, "dd") {
            if literal_buf != "" {
                push(parts, DateTimePart.Literal(literal_buf))
                literal_buf = ""
            }
            push(parts, DateTimePart.Day)
            i = i + 2
        } else if matches_token(pattern, i, "HH") {
            if literal_buf != "" {
                push(parts, DateTimePart.Literal(literal_buf))
                literal_buf = ""
            }
            push(parts, DateTimePart.Hour)
            i = i + 2
        } else if matches_token(pattern, i, "mm") {
            if literal_buf != "" {
                push(parts, DateTimePart.Literal(literal_buf))
                literal_buf = ""
            }
            push(parts, DateTimePart.Minute)
            i = i + 2
        } else if matches_token(pattern, i, "ss") {
            if literal_buf != "" {
                push(parts, DateTimePart.Literal(literal_buf))
                literal_buf = ""
            }
            push(parts, DateTimePart.Second)
            i = i + 2
        } else if matches_token(pattern, i, "SSSSSSSSS") {
            if literal_buf != "" {
                push(parts, DateTimePart.Literal(literal_buf))
                literal_buf = ""
            }
            push(parts, DateTimePart.Nano)
            i = i + 9
        } else {
            literal_buf = concat(literal_buf, char_at(pattern, i))
            i = i + 1
        }
    }
    if literal_buf != "" {
        push(parts, DateTimePart.Literal(literal_buf))
    }
    val parts_array = snapshot(parts)
    var width = 0
    for part in parts_array {
        width = width + datetime_part_width(part)
    }
    return DateTimeFormat { parts: parts_array, width: width }
}

// Built on MutableString rather than the concat-in-a-loop this
// originally was -- unlike datetime_format_of (compiled once per
// distinct pattern and reused), this runs once per *formatted value*,
// so it's the hotter of the two -- every field in every formatted
// date/time used to mean one more leaked, ever-growing string.
// The year as four digits, `2026`; outside 0-9999 it carries a sign and keeps at least four digits
// (`+10000`, `-0044`), so that `parse_year` reads back everything `format_year` writes.
fn format_year(year: int) -> string {
    if year >= 0 && year <= 9999 {
        return pad_left(year, 4)
    }
    if year > 0 {
        return concat("+", pad_left(year, 4))
    }
    return concat("-", pad_left(0 - year, 4))
}

fn format_fields(
    year: int,
    month: int,
    day: int,
    hour: int,
    minute: int,
    second: int,
    nano: int,
    fmt: DateTimeFormat
) -> string {
    val out = mutable_string_new()
    for part in fmt.parts {
        append(out, switch part {
            Year { format_year(year) }
            Month { pad_left(month, 2) }
            Day { pad_left(day, 2) }
            Hour { pad_left(hour, 2) }
            Minute { pad_left(minute, 2) }
            Second { pad_left(second, 2) }
            Nano { pad_left(nano, 9) }
            Literal(s) { s }
        })
    }
    return snapshot(out)
}

struct ParsedFields {
    year: int
    month: int
    day: int
    hour: int
    minute: int
    second: int
    nano: int
}

fn parse_fixed_width_int(s: string, start: int, width: int) -> Result<int, string> {
    if start + width > byte_len(s) {
        return err(format("'{}' is too short (expected {} more character(s))", s, width))
    }
    return parse_int(substring(s, start, start + width))
}

// Reads the year at `start`: four digits, or a `+`/`-` followed by four to nine digits (what
// `format_year` writes outside 0-9999). Returns the year and the position after it.
fn parse_year(s: string, start: int) -> Result<[int], string> {
    if !is_char_at(s, start, "+") && !is_char_at(s, start, "-") {
        val r = parse_fixed_width_int(s, start, 4)
        if Err(e) = r {
            return err(e)
        }
        return ok([unwrap(r), start + 4])
    }
    var end = start + 1
    while end < byte_len(s) && contains("0123456789", char_at(s, end)) {
        end = end + 1
    }
    val digits = end - start - 1
    if digits < 4 || digits > 9 {
        return err(format("a signed year needs 4 to 9 digits, found {}", digits))
    }
    val magnitude = parse_int(substring(s, start + 1, end))
    if Err(e) = magnitude {
        return err(e)
    }
    return ok([if is_char_at(s, start, "-") { 0 - unwrap(magnitude) } else { unwrap(magnitude) }, end])
}

fn parse_fields(s: string, fmt: DateTimeFormat) -> Result<ParsedFields, string> {
    var year = 0
    var month = 0
    var day = 0
    var hour = 0
    var minute = 0
    var second = 0
    var nano = 0
    var si = 0
    for part in fmt.parts {
        switch part {
            Year {
                val r = switch parse_year(s, si) {
                    Ok(v) { v }
                    Err(e) { return err(format("invalid year in '{}': {}", s, e)) }
                }
                year = r[0]
                si = r[1]
            }
            Month {
                val r = switch parse_fixed_width_int(s, si, 2) {
                    Ok(v) { v }
                    Err(e) { return err(format("invalid month in '{}': {}", s, e)) }
                }
                month = r
                si = si + 2
            }
            Day {
                val r = switch parse_fixed_width_int(s, si, 2) {
                    Ok(v) { v }
                    Err(e) { return err(format("invalid day in '{}': {}", s, e)) }
                }
                day = r
                si = si + 2
            }
            Hour {
                val r = switch parse_fixed_width_int(s, si, 2) {
                    Ok(v) { v }
                    Err(e) { return err(format("invalid hour in '{}': {}", s, e)) }
                }
                hour = r
                si = si + 2
            }
            Minute {
                val r = switch parse_fixed_width_int(s, si, 2) {
                    Ok(v) { v }
                    Err(e) { return err(format("invalid minute in '{}': {}", s, e)) }
                }
                minute = r
                si = si + 2
            }
            Second {
                val r = switch parse_fixed_width_int(s, si, 2) {
                    Ok(v) { v }
                    Err(e) { return err(format("invalid second in '{}': {}", s, e)) }
                }
                second = r
                si = si + 2
            }
            Nano {
                val r = switch parse_fixed_width_int(s, si, 9) {
                    Ok(v) { v }
                    Err(e) { return err(format("invalid nanosecond fraction in '{}': {}", s, e)) }
                }
                nano = r
                si = si + 9
            }
            Literal(lit) {
                val llen = byte_len(lit)
                if !is_char_at(s, si, lit) {
                    return err(format("'{}' does not match expected literal '{}' at position {}", s, lit, si))
                }
                si = si + llen
            }
        }
    }
    if si != byte_len(s) {
        return err(format("'{}' has trailing content after position {}", s, si))
    }
    return ok(ParsedFields {
        year: year,
        month: month,
        day: day,
        hour: hour,
        minute: minute,
        second: second,
        nano: nano
    })
}

// The fixed shapes every existing `_to_string` produces, now also the
// default `DateTimeFormat`s their matching `_parse`/`_format` pair
// uses -- one engine, not two independently-maintained implementations
// of "what does an ISO date look like." Compiled exactly once, at
// program start (global vals are evaluated eagerly before `main` runs
// -- see docs/DESIGN.md's "Global val" entry), and reused for the rest
// of the process's lifetime; `pub` so application code can also pass
// them straight to `_format`/`_parse_pattern` instead of compiling the
// pattern again itself.
pub val iso_date_format = datetime_format_of("yyyy-MM-dd")
pub val iso_time_format = datetime_format_of("HH:mm:ss")
pub val iso_time_nanos_format = datetime_format_of("HH:mm:ss.SSSSSSSSS")
pub val iso_datetime_format = datetime_format_of("yyyy-MM-ddTHH:mm:ss")
pub val iso_datetime_nanos_format = datetime_format_of("yyyy-MM-ddTHH:mm:ss.SSSSSSSSS")

// Howard Hinnant's days-from-civil / civil-from-days algorithm (public
// domain, used in libc++'s <chrono>), adapted to Ziman's truncating
// (toward zero) integer division -- exactly the semantics the original
// C++ was written against, so the translation is direct. Correct for
// the whole proleptic Gregorian calendar, not just dates after 1970;
// `epoch_day` is signed (negative for dates before 1970-01-01).
fn epoch_day_of(year: int, month: int, day: int) -> int {
    var y = year
    if month <= 2 {
        y = y - 1
    }
    val era = if y < 0 { (y - 399) / 400 } else { y / 400 }
    val yoe = y - era * 400
    val mp = if month > 2 { month - 3 } else { month + 9 }
    val doy = (153 * mp + 2) / 5 + day - 1
    val doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * days_per_era + doe - epoch_shift_days
}

// The inverse of `epoch_day_of`: the same Hinnant civil-from-days algorithm, run backward.
fn date_of_epoch_day(epoch_day: int) -> LocalDate {
    val z = epoch_day + epoch_shift_days
    val era = if z < 0 { (z - (days_per_era - 1)) / days_per_era } else { z / days_per_era }
    val doe = z - era * days_per_era
    val yoe = (doe - doe / 1460 + doe / 36524 - doe / (days_per_era - 1)) / 365
    val y = yoe + era * 400
    val doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    val mp = (5 * doy + 2) / 153
    val d = doy - (153 * mp + 2) / 5 + 1
    val m = if mp < 10 { mp + 3 } else { mp - 9 }
    val year = if m <= 2 { y + 1 } else { y }
    return LocalDate { year: year, month: m, day: d }
}

// A calendar date with no time or zone: a proleptic Gregorian `year`, `month` (1-12) and `day`.
// Build one with `localdate_of`, which checks the fields.
//
// The year is **signed**, and negative years are a supported case rather than an accident: 44 BC is
// `-0044`, `localdate_add_days` walks back past year 1 into it (the fixture
// `time_year_range_roundtrip` pins `-0044-03-15` round-tripping and an 800,000-day subtraction
// landing on `-2190-09-05`), `format_year` writes a sign outside 0-9999, and
// `localdate_from_string` reads a signed year of 4 to 9 digits. This comment used to say "0 or
// later", which is what led the 2026-10-14 review to report accepting BCE years as a bug (D19):
// the code was right and the sentence describing it was not.
pub struct LocalDate {
    year: int
    month: int
    day: int
}

// The date `year`-`month`-`day`, or an Err naming the field that is out of range (the day is checked
// against that month's length, leap years included).
pub fn localdate_of(year: int, month: int, day: int) -> Result<LocalDate, string> {
    if month < 1 || month > 12 {
        return err(format("invalid month: {} (must be 1-12)", month))
    }
    val max_day = days_in_month(year, month)
    if day < 1 || day > max_day {
        return err(format("invalid day: {} (month {} of {} has {} days)", day, month, year, max_day))
    }
    return ok(LocalDate { year: year, month: month, day: day })
}

// True when `year` is a leap year in the Gregorian calendar.
pub fn localdate_is_leap_year(year: int) -> bool {
    return is_leap_year(year)
}

// The number of days from 1970-01-01 to `d`; negative before it.
pub fn localdate_to_epoch_day(d: LocalDate) -> int {
    return epoch_day_of(d.year, d.month, d.day)
}

// The date `epoch_day` days after 1970-01-01 (the inverse of `localdate_to_epoch_day`).
pub fn localdate_from_epoch_day(epoch_day: int) -> LocalDate {
    return date_of_epoch_day(epoch_day)
}

// `d` moved by `days` (negative to go back), across month and year ends.
pub fn localdate_add_days(d: LocalDate, days: int) -> LocalDate {
    return date_of_epoch_day(localdate_to_epoch_day(d) + days)
}

// Clamps the day to the target month's own length, same as
// java.time.LocalDate.plusMonths -- Jan 31 + 1 month is Feb 28 (or 29),
// never "Mar 3".
pub fn localdate_add_months(d: LocalDate, months: int) -> LocalDate {
    val total_months = (d.year * 12 + (d.month - 1)) + months
    var y = total_months / 12
    var m = total_months % 12
    if m < 0 {
        m = m + 12
        y = y - 1
    }
    val year = y
    val month = m + 1
    var day = d.day
    val max_day = days_in_month(year, month)
    if day > max_day {
        day = max_day
    }
    return LocalDate { year: year, month: month, day: day }
}

// `d` moved by `years` years; 29 February in a non-leap target year becomes the 28th, as in
// `localdate_add_months`.
pub fn localdate_add_years(d: LocalDate, years: int) -> LocalDate {
    return localdate_add_months(d, years * 12)
}

// The whole days from `b` to `a`: positive when `a` is the later date.
pub fn localdate_diff_days(a: LocalDate, b: LocalDate) -> int {
    return localdate_to_epoch_day(a) - localdate_to_epoch_day(b)
}

// Negative, zero or positive as `a` is before, the same as, or after `b`. This makes `LocalDate`
// `Ord`.
pub fn localdate_compare(a: LocalDate, b: LocalDate) -> int {
    return localdate_to_epoch_day(a) - localdate_to_epoch_day(b)
}

// `d` rendered with a compiled pattern from `datetime_format_of`. Fields the date lacks (hour,
// minute, second, nanosecond) print as zeros.
pub fn localdate_format(d: LocalDate, fmt: DateTimeFormat) -> string {
    return format_fields(d.year, d.month, d.day, 0, 0, 0, 0, fmt)
}

// Reads `s` with a compiled pattern; an Err says which part did not match, or that the resulting
// date does not exist (31 February).
pub fn localdate_parse_pattern(s: string, fmt: DateTimeFormat) -> Result<LocalDate, string> {
    val fields_r = parse_fields(s, fmt)
    if Err(e) = fields_r {
        return err(e)
    }
    val f = unwrap(fields_r)
    return localdate_of(f.year, f.month, f.day)
}

// Reads an ISO date, `2026-09-24`; an Err otherwise. The inverse of `localdate_to_string`.
pub fn localdate_from_string(s: string) -> Result<LocalDate, string> {
    return localdate_parse_pattern(s, iso_date_format)
}

// `d` as an ISO date, `2026-09-24`.
pub fn localdate_to_string(d: LocalDate) -> string {
    return localdate_format(d, iso_date_format)
}

// A time of day with no date or zone: `hour` (0-23), `minute`, `second` and `nano` (nanosecond
// within the second). Build one with `localtime_of`, which checks the fields.
pub struct LocalTime {
    hour: int
    minute: int
    second: int
    nano: int
}

// The time `hour`:`minute`:`second`.`nano`, or an Err naming the field that is out of range.
pub fn localtime_of(hour: int, minute: int, second: int, nano: int) -> Result<LocalTime, string> {
    if hour < 0 || hour > 23 {
        return err(format("invalid hour: {} (must be 0-23)", hour))
    }
    if minute < 0 || minute > 59 {
        return err(format("invalid minute: {} (must be 0-59)", minute))
    }
    if second < 0 || second > 59 {
        return err(format("invalid second: {} (must be 0-59)", second))
    }
    if nano < 0 || nano > max_nano {
        return err(format("invalid nano: {} (must be 0-999999999)", nano))
    }
    return ok(LocalTime { hour: hour, minute: minute, second: second, nano: nano })
}

fn nano_of_day(t: LocalTime) -> int {
    return (t.hour * seconds_per_hour + t.minute * 60 + t.second) * nanos_per_second + t.nano
}

// `nanos_per_day` (above) is inlined everywhere it's needed
// (a plain function, not a top-level `val`, so it stays pure arithmetic).
fn time_of_nano_of_day(n: int) -> LocalTime {
    var total = n % nanos_per_day
    if total < 0 {
        total = total + nanos_per_day
    }
    val nano = total % nanos_per_second
    var secs = total / nanos_per_second
    val second = secs % 60
    secs = secs / 60
    val minute = secs % 60
    val hour = secs / 60
    return LocalTime { hour: hour, minute: minute, second: second, nano: nano }
}

// `t` moved by `nanos` nanoseconds (negative to go back). Wraps at midnight and drops the day carry,
// like java.time.LocalTime.plusNanos; use `localdatetime_add_nanos` to keep it.
pub fn localtime_add_nanos(t: LocalTime, nanos: int) -> LocalTime {
    return time_of_nano_of_day(nano_of_day(t) + nanos)
}

// `t` moved by `seconds`, wrapping at midnight (see `localtime_add_nanos`).
pub fn localtime_add_seconds(t: LocalTime, seconds: int) -> LocalTime {
    return localtime_add_nanos(t, seconds * nanos_per_second)
}

// `t` moved by `minutes`, wrapping at midnight.
pub fn localtime_add_minutes(t: LocalTime, minutes: int) -> LocalTime {
    return localtime_add_seconds(t, minutes * 60)
}

// `t` moved by `hours`, wrapping at midnight.
pub fn localtime_add_hours(t: LocalTime, hours: int) -> LocalTime {
    return localtime_add_minutes(t, hours * 60)
}

// The nanoseconds from `b` to `a` within one day: positive when `a` is later. Both are read as
// times of the same day, so the result is in -86399999999999 to 86399999999999.
pub fn localtime_diff_nanos(a: LocalTime, b: LocalTime) -> int {
    return nano_of_day(a) - nano_of_day(b)
}

// Negative, zero or positive as `a` is earlier than, the same as, or later than `b`. This makes
// `LocalTime` `Ord`.
pub fn localtime_compare(a: LocalTime, b: LocalTime) -> int {
    return localtime_diff_nanos(a, b)
}

// `t` rendered with a compiled pattern from `datetime_format_of`. Year, month and day print as
// zeros.
pub fn localtime_format(t: LocalTime, fmt: DateTimeFormat) -> string {
    return format_fields(0, 0, 0, t.hour, t.minute, t.second, t.nano, fmt)
}

// Reads `s` with a compiled pattern; an Err says which part did not match or which field is out of
// range.
pub fn localtime_parse_pattern(s: string, fmt: DateTimeFormat) -> Result<LocalTime, string> {
    val fields_r = parse_fields(s, fmt)
    if Err(e) = fields_r {
        return err(e)
    }
    val f = unwrap(fields_r)
    return localtime_of(f.hour, f.minute, f.second, f.nano)
}

// The fraction of a second in `s`, widened to the nine digits the `.SSSSSSSSS` pattern needs:
// `13:05:09.5Z` and `13:05:09.500Z` both become `13:05:09.500000000Z`. An Err when the fraction has
// no digits or more than nine.
fn widen_fraction(s: string) -> Result<string, string> {
    val dot = index_of(s, ".", 0)
    var end = dot + 1
    while end < byte_len(s) && contains("0123456789", char_at(s, end)) {
        end = end + 1
    }
    val digits = end - dot - 1
    if digits < 1 || digits > 9 {
        return err(format("'{}': the fraction of a second needs 1 to 9 digits, found {}", s, digits))
    }
    val zeros = substring("000000000", 0, 9 - digits)
    return ok(concat(substring(s, 0, end), zeros, substring(s, end, byte_len(s))))
}

// `to_string`'s own output only includes the fractional part when
// `nano != 0` (see localtime_to_string below), so parsing has to
// detect which of the two fixed shapes it's looking at the same way --
// checking for "." is safe here since neither shape ever contains one
// otherwise.
pub fn localtime_from_string(s: string) -> Result<LocalTime, string> {
    if contains(s, ".") {
        return localtime_parse_pattern(try widen_fraction(s), iso_time_nanos_format)
    }
    return localtime_parse_pattern(s, iso_time_format)
}

// `t` as ISO text, `13:05:09`, with `.nnnnnnnnn` after the seconds only when the nanoseconds are not
// zero.
pub fn localtime_to_string(t: LocalTime) -> string {
    return if t.nano == 0 {
        localtime_format(t, iso_time_format)
    } else {
        localtime_format(t, iso_time_nanos_format)
    }
}

// A length of time as `seconds` and `nanos` (0 to 999999999). `seconds` carries the sign, so -0.5 s
// is `{seconds: -1, nanos: 500000000}`. Build one with `duration_of_seconds`, which keeps that form.
pub struct Duration {
    seconds: int
    nanos: int
}

// The one place the {seconds, nanos} invariant (nanos in [0,999999999],
// seconds carries the sign) actually gets enforced -- every public
// Duration/Instant constructor and arithmetic function funnels through
// this instead of building the struct literal directly.
fn normalize(seconds: int, nanos: int) -> Duration {
    var s = seconds
    var n = nanos
    val extra_seconds = n / nanos_per_second
    s = s + extra_seconds
    n = n % nanos_per_second
    if n < 0 {
        n = n + nanos_per_second
        s = s - 1
    }
    return Duration { seconds: s, nanos: n }
}

// The duration `seconds` + `nanos`, with `nanos` allowed outside 0-999999999 and carried into
// `seconds` (`duration_of_seconds(0, -1)` is -1 ns).
pub fn duration_of_seconds(seconds: int, nanos: int) -> Duration {
    return normalize(seconds, nanos)
}

// The empty duration.
pub fn duration_zero() -> Duration {
    return Duration { seconds: 0, nanos: 0 }
}

// The sum of two durations.
pub fn duration_add(a: Duration, b: Duration) -> Duration {
    return normalize(a.seconds + b.seconds, a.nanos + b.nanos)
}

// `d` with its sign flipped.
pub fn duration_negate(d: Duration) -> Duration {
    return normalize(-d.seconds, -d.nanos)
}

// `a` minus `b`.
pub fn duration_subtract(a: Duration, b: Duration) -> Duration {
    return duration_add(a, duration_negate(b))
}

// seconds/nanos direct comparison is sound (not just convenient)
// specifically because of the normalize invariant: nanos is always
// non-negative, so seconds alone is the correct primary ordering key
// and nanos only ever needs to break a tie.
pub fn duration_compare(a: Duration, b: Duration) -> int {
    return if a.seconds != b.seconds { a.seconds - b.seconds } else { a.nanos - b.nanos }
}

// ISO-8601-shaped (PT<seconds>[.<nanos>]S), not full ISO-8601 duration
// support (no PnYnMnDTnHnMnS breakdown) -- nothing needs interop with
// an external system that would require exact compliance. Negative
// durations are shown by their true magnitude with a leading '-'
// (`{seconds: -1, nanos: 500000000}`, i.e. -0.5s, prints "PT-0.5...S",
// not the misleading "PT-1.5...S" a naive field-by-field print would
// give), the same care java.time.Duration.toString() takes. No
// pattern-based `duration_format` -- a total elapsed-seconds count
// isn't a calendar field breakdown the way year/month/day/hour/
// minute/second are, so the pattern language above doesn't fit it;
// `duration_from_string` below is this function's exact inverse instead.
pub fn duration_to_string(d: Duration) -> string {
    if d.seconds >= 0 {
        if d.nanos == 0 {
            return format("PT{}S", d.seconds)
        }
        return format("PT{}.{}S", d.seconds, pad_left(d.nanos, 9))
    }
    if d.nanos == 0 {
        return format("PT-{}S", -d.seconds)
    }
    val mag_seconds = -d.seconds - 1
    val mag_nanos = nanos_per_second - d.nanos
    return format("PT-{}.{}S", mag_seconds, pad_left(mag_nanos, 9))
}

// The exact inverse of duration_to_string, including its negative-
// duration magnitude transform: a negative-with-fraction string stores
// `mag_seconds = -true_seconds - 1` and `mag_nanos = 1e9 - true_nanos`,
// so parsing has to invert that arithmetic rather than just negating
// the parsed seconds -- verified against duration_to_string's own
// worked example (-0.5s prints "PT-0.500000000S") before trusting it.
pub fn duration_from_string(s: string) -> Result<Duration, string> {
    if byte_len(s) < 3 || !starts_with(s, "PT") || !ends_with(s, "S") {
        return err(format("invalid duration '{}': expected PT<seconds>[.<nanos>]S", s))
    }
    val body = substring(s, 2, byte_len(s) - 1)
    var negative = false
    var rest = body
    if starts_with(rest, "-") {
        negative = true
        rest = substring(rest, 1, byte_len(rest))
    }
    val parts = split(rest, ".")
    val mag_seconds_r = parse_int(parts[0])
    if !is_ok(mag_seconds_r) {
        return err(format("invalid duration '{}': bad seconds", s))
    }
    val mag_seconds = unwrap(mag_seconds_r)
    if len(parts) == 1 {
        if negative {
            return ok(normalize(-mag_seconds, 0))
        }
        return ok(normalize(mag_seconds, 0))
    }
    if len(parts) != 2 {
        return err(format("invalid duration '{}'", s))
    }
    val digits = parts[1]
    if byte_len(digits) < 1 || byte_len(digits) > 9 || starts_with(digits, "-") || starts_with(digits, "+") {
        return err(format("invalid duration '{}': the fraction must be 1 to 9 digits", s))
    }
    val mag_nanos_r = parse_int(digits)
    if !is_ok(mag_nanos_r) {
        return err(format("invalid duration '{}': bad nanos", s))
    }
    var mag_nanos = unwrap(mag_nanos_r)
    for _ in byte_len(digits)..9 {
        mag_nanos = mag_nanos * 10
    }
    return if negative {
        ok(normalize(-mag_seconds - 1, nanos_per_second - mag_nanos))
    } else {
        ok(normalize(mag_seconds, mag_nanos))
    }
}

// A date and a time of day with no zone: the wall-clock reading on a calendar. Pair it with a
// `ZoneOffset` (`localdatetime_to_instant`) to place it on the timeline.
pub struct LocalDateTime {
    date: LocalDate
    time: LocalTime
}

// The date-time made of `date` and `time`.
pub fn localdatetime_of(date: LocalDate, time: LocalTime) -> LocalDateTime {
    return LocalDateTime { date: date, time: time }
}

// `dt` moved by `nanos` nanoseconds (negative to go back), carrying into the date.
pub fn localdatetime_add_nanos(dt: LocalDateTime, nanos: int) -> LocalDateTime {
    val total = nano_of_day(dt.time) + nanos
    var day_carry = total / nanos_per_day
    var rem = total % nanos_per_day
    if rem < 0 {
        rem = rem + nanos_per_day
        day_carry = day_carry - 1
    }
    return LocalDateTime { date: localdate_add_days(dt.date, day_carry), time: time_of_nano_of_day(rem) }
}

// `dt` moved by `seconds`, carrying into the date.
pub fn localdatetime_add_seconds(dt: LocalDateTime, seconds: int) -> LocalDateTime {
    return localdatetime_add_nanos(dt, seconds * nanos_per_second)
}

// `dt` moved by `minutes`, carrying into the date.
pub fn localdatetime_add_minutes(dt: LocalDateTime, minutes: int) -> LocalDateTime {
    return localdatetime_add_seconds(dt, minutes * 60)
}

// `dt` moved by `hours`, carrying into the date.
pub fn localdatetime_add_hours(dt: LocalDateTime, hours: int) -> LocalDateTime {
    return localdatetime_add_minutes(dt, hours * 60)
}

// `dt` moved by `days`; the time of day is unchanged.
pub fn localdatetime_add_days(dt: LocalDateTime, days: int) -> LocalDateTime {
    return LocalDateTime { date: localdate_add_days(dt.date, days), time: dt.time }
}

// `dt` moved by `months`; the day is clamped to the target month as in `localdate_add_months`.
pub fn localdatetime_add_months(dt: LocalDateTime, months: int) -> LocalDateTime {
    return LocalDateTime { date: localdate_add_months(dt.date, months), time: dt.time }
}

// `dt` moved by `years`; 29 February becomes the 28th in a non-leap target year.
pub fn localdatetime_add_years(dt: LocalDateTime, years: int) -> LocalDateTime {
    return LocalDateTime { date: localdate_add_years(dt.date, years), time: dt.time }
}

// Negative, zero or positive as `a` is before, the same as, or after `b`. This makes `LocalDateTime`
// `Ord`.
pub fn localdatetime_compare(a: LocalDateTime, b: LocalDateTime) -> int {
    val date_cmp = localdate_compare(a.date, b.date)
    return if date_cmp != 0 { date_cmp } else { localtime_compare(a.time, b.time) }
}

// Treats both sides as wall-clock time with no zone (exactly what
// LocalDateTime means) -- well-defined without needing a ZoneOffset,
// since it's just "elapsed calendar time assuming a fixed calendar",
// not a real elapsed-wall-time-across-zones computation.
pub fn localdatetime_diff(a: LocalDateTime, b: LocalDateTime) -> Duration {
    val day_diff = localdate_diff_days(a.date, b.date)
    val nano_diff = nano_of_day(a.time) - nano_of_day(b.time)
    return normalize(day_diff * seconds_per_day, nano_diff)
}

// `dt` rendered with a compiled pattern from `datetime_format_of`.
pub fn localdatetime_format(dt: LocalDateTime, fmt: DateTimeFormat) -> string {
    return format_fields(
        dt.date.year,
        dt.date.month,
        dt.date.day,
        dt.time.hour,
        dt.time.minute,
        dt.time.second,
        dt.time.nano,
        fmt
    )
}

// Reads `s` with a compiled pattern; an Err says which part did not match or which field is out of
// range.
pub fn localdatetime_parse_pattern(s: string, fmt: DateTimeFormat) -> Result<LocalDateTime, string> {
    val fields_r = parse_fields(s, fmt)
    if Err(e) = fields_r {
        return err(e)
    }
    val f = unwrap(fields_r)
    val date_r = localdate_of(f.year, f.month, f.day)
    if Err(e) = date_r {
        return err(e)
    }
    val time_r = localtime_of(f.hour, f.minute, f.second, f.nano)
    if Err(e) = time_r {
        return err(e)
    }
    return ok(LocalDateTime { date: unwrap(date_r), time: unwrap(time_r) })
}

// Reads an ISO date-time, `2026-09-24T13:05:09` with an optional fraction of 1 to 9 digits; an Err
// otherwise.
pub fn localdatetime_from_string(s: string) -> Result<LocalDateTime, string> {
    if contains(s, ".") {
        return localdatetime_parse_pattern(try widen_fraction(s), iso_datetime_nanos_format)
    }
    return localdatetime_parse_pattern(s, iso_datetime_format)
}

// `dt` as ISO text, `2026-09-24T13:05:09`, with the fraction only when the nanoseconds are not zero.
pub fn localdatetime_to_string(dt: LocalDateTime) -> string {
    return if dt.time.nano == 0 {
        localdatetime_format(dt, iso_datetime_format)
    } else {
        localdatetime_format(dt, iso_datetime_nanos_format)
    }
}

// A fixed offset from UTC in seconds, east positive, at most 18 hours either way. Build one with
// `zoneoffset_of_seconds` or `zoneoffset_of_hours_minutes`.
pub struct ZoneOffset {
    total_seconds: int
}

// The zero offset, written `Z`.
pub fn zoneoffset_utc() -> ZoneOffset {
    return ZoneOffset { total_seconds: 0 }
}

// The offset of `total_seconds` from UTC, or an Err beyond 18 hours (64800 seconds) either way.
pub fn zoneoffset_of_seconds(total_seconds: int) -> Result<ZoneOffset, string> {
    if total_seconds < -max_offset_seconds || total_seconds > max_offset_seconds {
        return err(format("zone offset out of range: {} seconds (must be -64800 to 64800)", total_seconds))
    }
    return ok(ZoneOffset { total_seconds: total_seconds })
}

// The offset of `hours` and `minutes` from UTC, both negative for a west offset (`-5, -30`). An Err
// when they disagree in sign or the total exceeds 18 hours.
pub fn zoneoffset_of_hours_minutes(hours: int, minutes: int) -> Result<ZoneOffset, string> {
    if (hours < 0 && minutes > 0) || (hours > 0 && minutes < 0) {
        return err("hours and minutes must have the same sign")
    }
    return zoneoffset_of_seconds(hours * seconds_per_hour + minutes * 60)
}

// Negative, zero or positive as `a` lies west of, at the same place as, or east of `b`. This makes
// `ZoneOffset` `Ord`.
pub fn zoneoffset_compare(a: ZoneOffset, b: ZoneOffset) -> int {
    return a.total_seconds - b.total_seconds
}

// `z` as `Z` for UTC, otherwise `+HH:MM` or `-HH:MM`.
pub fn zoneoffset_to_string(z: ZoneOffset) -> string {
    if z.total_seconds == 0 {
        return "Z"
    }
    var sign = "+"
    var total = z.total_seconds
    if total < 0 {
        sign = "-"
        total = -total
    }
    return format("{}{}:{}", sign, pad_left(total / seconds_per_hour, 2), pad_left((total % seconds_per_hour) / 60, 2))
}

// The exact inverse of zoneoffset_to_string: "Z" for UTC, otherwise
// exactly "+HH:MM"/"-HH:MM" (6 characters, no seconds component --
// zoneoffset_to_string never emits one either).
pub fn zoneoffset_from_string(s: string) -> Result<ZoneOffset, string> {
    if s == "Z" {
        return ok(zoneoffset_utc())
    }
    if byte_len(s) != 6 {
        return err(format("invalid zone offset '{}': expected 'Z' or '+HH:MM'/'-HH:MM'", s))
    }
    val sign_char = substring(s, 0, 1)
    if sign_char != "+" && sign_char != "-" {
        return err(format("invalid zone offset '{}': expected 'Z' or '+HH:MM'/'-HH:MM'", s))
    }
    if substring(s, 3, 4) != ":" {
        return err(format("invalid zone offset '{}': expected 'Z' or '+HH:MM'/'-HH:MM'", s))
    }
    val hours_r = parse_int(substring(s, 1, 3))
    val minutes_r = parse_int(substring(s, 4, 6))
    if !is_ok(hours_r) || !is_ok(minutes_r) {
        return err(format("invalid zone offset '{}': expected 'Z' or '+HH:MM'/'-HH:MM'", s))
    }
    var hours = unwrap(hours_r)
    var minutes = unwrap(minutes_r)
    // The minutes field is a minutes field, not a count to be carried: `+05:99` used to parse as
    // 5*3600 + 99*60, which is inside the +-18h total and so was accepted, and came back out of
    // `zoneoffset_to_string` as `+06:39`. A timestamp was then stored at a different instant from
    // the one the client wrote, with nothing reporting it (D19).
    if minutes > 59 {
        return err(format("invalid zone offset '{}': minutes must be 00-59", s))
    }
    if hours > 18 {
        return err(format("invalid zone offset '{}': hours must be 00-18", s))
    }
    if sign_char == "-" {
        hours = -hours
        minutes = -minutes
    }
    return zoneoffset_of_hours_minutes(hours, minutes)
}

// A time zone by its IANA name (`UTC`, `Europe/Paris`, `America/New_York`), carrying the rules that
// say which offset from UTC applies at each instant, daylight saving included. Get one with
// `zoneid_of`; `zoneid_utc()` needs no zone files. Its `name` is what is written to JSON and SQL.
pub struct ZoneId {
    name: string
    rules: ZoneRules
}

val utc_rules = ZoneRules {
    transitions: [],
    type_of: [],
    utoffs: [0],
    dsts: [false],
    names: ["UTC"],
    has_rule: false,
    rule: no_rule
}

// The `UTC` zone.
pub fn zoneid_utc() -> ZoneId {
    return ZoneId { name: "UTC", rules: utc_rules }
}

// The zone called `name`, read from the system's IANA time zone files (see `zone`), or an Err
// when the name is unknown or the system has no zone database. `UTC` and `Z` always work.
pub fn zoneid_of(name: string) -> Result<ZoneId, string> {
    if name == "UTC" || name == "Z" {
        return ok(zoneid_utc())
    }
    val rules = try load_rules(name)
    return ok(ZoneId { name: name, rules: rules })
}

// The offset from UTC in force in `z` at the instant `i`: `-05:00` in New York in January,
// `-04:00` in July.
pub fn zoneid_offset_at(z: ZoneId, i: Instant) -> ZoneOffset {
    return ZoneOffset { total_seconds: type_at(z.rules, i.seconds).utoff }
}

// True when `z` is on daylight saving time at the instant `i`.
pub fn zoneid_is_dst_at(z: ZoneId, i: Instant) -> bool {
    return type_at(z.rules, i.seconds).dst
}

// The abbreviation `z` uses at the instant `i`: `EST`, `EDT`, `CET`, or `+03` where the zone has
// no letters.
pub fn zoneid_abbreviation_at(z: ZoneId, i: Instant) -> string {
    return type_at(z.rules, i.seconds).name
}

// The name of `z`.
pub fn zoneid_to_string(z: ZoneId) -> string {
    return z.name
}

// The zone called `s`; the same as `zoneid_of`, named for the `_from_string` convention.
pub fn zoneid_from_string(s: string) -> Result<ZoneId, string> {
    return zoneid_of(s)
}

// A point on the timeline, as `seconds` since 1970-01-01T00:00:00Z and `nanos` (0 to 999999999);
// negative instants are before the epoch. Build one with `instant_of` or `instant_now`.
pub struct Instant {
    seconds: int
    nanos: int
}

// The instant `seconds` + `nanos` after the epoch, with `nanos` allowed outside 0-999999999 and
// carried into `seconds`.
pub fn instant_of(seconds: int, nanos: int) -> Instant {
    val d = normalize(seconds, nanos)
    return Instant { seconds: d.seconds, nanos: d.nanos }
}

// The current time from the system clock. It is the wall clock and can jump when the system time is
// adjusted, so it is not for timing an interval.
pub fn instant_now() -> Instant {
    val raw = now_raw()
    return instant_of(raw[0], raw[1])
}

// `i` moved later by `d` (earlier when `d` is negative).
pub fn instant_add(i: Instant, d: Duration) -> Instant {
    return instant_of(i.seconds + d.seconds, i.nanos + d.nanos)
}

// `i` moved earlier by `d`.
pub fn instant_subtract(i: Instant, d: Duration) -> Instant {
    return instant_add(i, duration_negate(d))
}

// The time from `b` to `a`: positive when `a` is the later instant.
pub fn instant_diff(a: Instant, b: Instant) -> Duration {
    return normalize(a.seconds - b.seconds, a.nanos - b.nanos)
}

// Negative, zero or positive as `a` is before, the same as, or after `b`. This makes `Instant`
// `Ord`.
pub fn instant_compare(a: Instant, b: Instant) -> int {
    return if a.seconds != b.seconds { a.seconds - b.seconds } else { a.nanos - b.nanos }
}

// The wall-clock date and time of `i` under `offset`.
pub fn instant_to_localdatetime(i: Instant, offset: ZoneOffset) -> LocalDateTime {
    val shifted = i.seconds + offset.total_seconds
    var epoch_day = shifted / seconds_per_day
    var sec_of_day = shifted % seconds_per_day
    if sec_of_day < 0 {
        sec_of_day = sec_of_day + seconds_per_day
        epoch_day = epoch_day - 1
    }
    return LocalDateTime {
        date: date_of_epoch_day(epoch_day),
        time: time_of_nano_of_day(sec_of_day * nanos_per_second + i.nanos)
    }
}

// The instant at which a clock in `offset` reads `dt`.
pub fn localdatetime_to_instant(dt: LocalDateTime, offset: ZoneOffset) -> Instant {
    val epoch_day = localdate_to_epoch_day(dt.date)
    val sec_of_day = dt.time.hour * seconds_per_hour + dt.time.minute * 60 + dt.time.second
    val total_seconds = epoch_day * seconds_per_day + sec_of_day - offset.total_seconds
    return instant_of(total_seconds, dt.time.nano)
}

// The current date and time on a clock in `offset`: `instant_to_localdatetime(instant_now(), offset)`.
pub fn localdatetime_now(offset: ZoneOffset) -> LocalDateTime {
    return instant_to_localdatetime(instant_now(), offset)
}

// Today's date on a clock in `offset`.
pub fn localdate_now(offset: ZoneOffset) -> LocalDate {
    return localdatetime_now(offset).date
}

// The current time of day on a clock in `offset`.
pub fn localtime_now(offset: ZoneOffset) -> LocalTime {
    return localdatetime_now(offset).time
}

// The wall-clock date and time in zone `z` at the instant `i`, daylight saving applied.
pub fn instant_to_localdatetime_in(i: Instant, z: ZoneId) -> LocalDateTime {
    return instant_to_localdatetime(i, zoneid_offset_at(z, i))
}

// The instant at which a clock in zone `z` reads `dt`. Two readings need a rule. When the clocks
// go back, `dt` happens twice and the earlier instant is returned. When the clocks go forward,
// `dt` never happens (02:30 on the night the hour 02:00 to 03:00 is skipped) and the result is
// `dt` moved forward by the length of the gap (03:30), as `java.time` does.
pub fn localdatetime_to_instant_in(dt: LocalDateTime, z: ZoneId) -> Instant {
    val as_utc = localdatetime_to_instant(dt, zoneoffset_utc())
    val before = zoneid_offset_at(z, instant_add(as_utc, duration_of_seconds(-seconds_per_day, 0)))
    val after = zoneid_offset_at(z, instant_add(as_utc, duration_of_seconds(seconds_per_day, 0)))
    var best = Option<Instant>.None
    for offset in [before, after] {
        val candidate = instant_add(as_utc, duration_of_seconds(-offset.total_seconds, 0))
        if zoneid_offset_at(z, candidate) == offset {
            if Option.is_None(best) || instant_compare(candidate, Option.unwrap_Some(best)) < 0 {
                best = Option<Instant>.Some(candidate)
            }
        }
    }
    if Some(b) = best {
        return b
    }
    return instant_add(as_utc, duration_of_seconds(-before.total_seconds, 0))
}

// Formats `i` as wall-clock time under `offset` (via
// instant_to_localdatetime), using `fmt` for the calendar part, then
// always appends the offset's own string form -- the same shape
// instant_to_string below already uses, just with `fmt` and `offset`
// as explicit parameters instead of hardcoding
// iso_datetime_format/zoneoffset_utc().
pub fn instant_format(i: Instant, offset: ZoneOffset, fmt: DateTimeFormat) -> string {
    val dt = instant_to_localdatetime(i, offset)
    return concat(localdatetime_format(dt, fmt), zoneoffset_to_string(offset))
}

// `fmt` covers only the calendar part; the zone-offset suffix is
// always parsed separately (via zoneoffset_from_string) and used to convert
// the parsed wall-clock time into an absolute Instant -- not something
// a caller chooses per call, since the string's own suffix already
// says what it is. Slicing at exactly `fmt.width` characters works
// because every pattern token's width is fixed and known at compile
// time (see the pattern-language comment above) -- no need to search
// for where the calendar part ends, and no need to recompute it here.
pub fn instant_parse_pattern(s: string, fmt: DateTimeFormat) -> Result<Instant, string> {
    if byte_len(s) < fmt.width {
        return err(format("'{}' is too short to match the given format", s))
    }
    val datetime_part = substring(s, 0, fmt.width)
    val offset_part = substring(s, fmt.width, byte_len(s))
    val dt_r = localdatetime_parse_pattern(datetime_part, fmt)
    if Err(e) = dt_r {
        return err(e)
    }
    val offset_r = zoneoffset_from_string(offset_part)
    if Err(e) = offset_r {
        return err(e)
    }
    return ok(localdatetime_to_instant(unwrap(dt_r), unwrap(offset_r)))
}

// Accepts either offset shape zoneoffset_from_string does ("Z" or a real
// "+HH:MM"/"-HH:MM"), not just the "Z" instant_to_string always
// produces -- a real external Instant/OffsetDateTime-shaped string
// (from an actual API, not just round-tripping this module's own
// output) may carry a genuine offset, and there's no extra cost to
// accepting it.
pub fn instant_from_string(s: string) -> Result<Instant, string> {
    if contains(s, ".") {
        return instant_parse_pattern(try widen_fraction(s), iso_datetime_nanos_format)
    }
    return instant_parse_pattern(s, iso_datetime_format)
}

// `i` in UTC as `2026-09-24T13:05:09Z`, with a `.nnnnnnnnn` fraction when the nanoseconds are not
// zero.
pub fn instant_to_string(i: Instant) -> string {
    return if i.nanos == 0 {
        instant_format(i, zoneoffset_utc(), iso_datetime_format)
    } else {
        instant_format(i, zoneoffset_utc(), iso_datetime_nanos_format)
    }
}

// Thin wrappers over each type's own _to_string/_from_string pair,
// named to match #[derive(Json)]'s own <type>_to_json/<type>_from_json
// naming convention (src/derive.c's pascal_to_snake -- "local_date",
// not this file's own older "localdate" shortcut) -- so a struct field
// of one of these types resolves here automatically. See
// docs/DESIGN.md's "Attributes and derive" entry.
pub fn local_date_to_json(d: LocalDate) -> Json {
    return Json.JString(localdate_to_string(d))
}

// A `LocalDate` from a JSON string in its ISO form; an Err for any other JSON value or a malformed string.
pub fn local_date_from_json(j: Json) -> Result<LocalDate, string> {
    if JString(s) = j {
        return localdate_from_string(s)
    }
    return err("expected a JSON string for LocalDate")
}

// `LocalTime` as a JSON string in its ISO form.
pub fn local_time_to_json(t: LocalTime) -> Json {
    return Json.JString(localtime_to_string(t))
}

// A `LocalTime` from a JSON string in its ISO form; an Err for any other JSON value or a malformed string.
pub fn local_time_from_json(j: Json) -> Result<LocalTime, string> {
    if JString(s) = j {
        return localtime_from_string(s)
    }
    return err("expected a JSON string for LocalTime")
}

// `Duration` as a JSON string in its ISO form.
pub fn duration_to_json(d: Duration) -> Json {
    return Json.JString(duration_to_string(d))
}

// A `Duration` from a JSON string in its ISO form; an Err for any other JSON value or a malformed string.
pub fn duration_from_json(j: Json) -> Result<Duration, string> {
    if JString(s) = j {
        return duration_from_string(s)
    }
    return err("expected a JSON string for Duration")
}

// `LocalDateTime` as a JSON string in its ISO form.
pub fn local_date_time_to_json(dt: LocalDateTime) -> Json {
    return Json.JString(localdatetime_to_string(dt))
}

// A `LocalDateTime` from a JSON string in its ISO form; an Err for any other JSON value or a malformed string.
