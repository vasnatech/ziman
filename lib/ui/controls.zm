// The widget set: what an input does to a control, and what a control looks like.
//
// docs/reviews/tasks/f269-f277.md F277, first instalment. `widget` builds and places a tree,
// `focus` says what a click lands on, `edit` is a text field's model and `a11y` describes all of it
// -- and none of them turns an event into a new state. That is this module, and the two controls
// here are the ones that need neither text editing nor scrolling, so the model is the subject and
// they are the proof of it.
//
// **The architecture is forced by the language, not chosen.** The usual widget set hands a widget a
// callback -- `on_click: fn()` -- which mutates the application's state. Ziman will not compile
// that: "a lambda cannot capture 'count' because it is a 'var' ... captures are by value, so the
// lambda and the enclosing function never share mutable state". So a control cannot act; it can
// only *answer*. Every update here takes a state and an input and returns a new state together with
// what happened, and the application keeps the state and acts on what happened. `focus.clicked`
// already had exactly that shape, so this is the existing grain of the thing rather than a new idea.
//
// **An application owns its controls' states; this module owns none.** There is no registry of
// widgets here and there cannot be one -- no shared mutable state exists to hold it -- so the
// application holds whatever its window needs, routes an input with `target`, and calls the update
// for the control that input was for.
use edit
use focus
use geom
use geom.Point
use geom.Rect
use math.floor
use paint
use paint.Color
use scene
use shape
use widget
use widget.Insets
use widget.Laid
use widget.Toggle

// ----------------------------------------------------------------- the inputs

pub struct Wheel {
    at: Point
    // Lines, signed: positive is away from the user. The same convention `window.ScrollStep` uses,
    // because converting between two sign conventions is a bug waiting to be written.
    vertical: int
    horizontal: int
}

// A key, as this layer names it.
//
// **Named rather than numbered, and owned here rather than borrowed from a backend.** The first
// version of this took `window.KeyPress` -- a keysym and four flags -- on the argument that a third
// key vocabulary was worse than depending on a module whose types are plain data. That was right
// with one backend and wrong with four: a shared control set cannot import X11, so this is not a
// third copy, it is the one copy, and each backend converts into it.
//
// `Char` carries the character the key sits on unshifted, so a shortcut is `Char("c")` whether or
// not Shift is down -- which is what a program dispatching Ctrl-C wants. `Other` keeps a name the
// backend chose, so an unhandled key can be logged rather than silently dropped.
pub enum Key {
    Enter
    Backspace
    Delete
    Tab
    Escape
    Space
    Left
    Up
    Right
    Down
    PageUp
    PageDown
    Home
    End
    Char(string)
    Other(string)
}

// A key with the modifiers that were down with it.
pub struct Keystroke {
    key: Key
    shift: bool
    control: bool
    alt: bool
    meta: bool
}

// A keystroke with nothing held down.
pub fn keystroke_of(key: Key) -> Keystroke {
    return Keystroke { key: key, shift: false, control: false, alt: false, meta: false }
}

// The character a `Char` key sits on, or "" for every other key -- so a dispatch on a shortcut
// letter needs no nested pattern.
pub fn char_of(k: Key) -> string {
    return switch k {
        Char(c) { c }
        Other(_) { "" }
        Enter { "" }
        Backspace { "" }
        Delete { "" }
        Tab { "" }
        Escape { "" }
        Space { "" }
        Left { "" }
        Up { "" }
        Right { "" }
        Down { "" }
        PageUp { "" }
        PageDown { "" }
        Home { "" }
        End { "" }
    }
}

// One thing the user did.
pub enum Input {
    KeyDown(Keystroke)
    KeyUp(Keystroke)
    // The text the keyboard composed, which is a separate event from the key that composed it --
    // see `window.Event`, where the same split is explained at length.
    Text(string)
    // Text from the system clipboard, **handed in rather than read**: nothing in this module can
    // reach a clipboard, and F273 left owning an X11 selection as platform work beside
    // `native_window.c`. It is a separate variant from `Text` because the two differ in a way a
    // user feels -- a paste is one undo step whatever its length, where typing coalesces a run of
    // keystrokes into one.
    Paste(string)
    Press(Point)
    Release(Point)
    Move(Point)
    Wheel(Wheel)
}

// Which control an input is for: the name, or "" for nobody.
//
// **The three rules here are each one a home-grown toolkit gets wrong.**
//
// A key goes to the focus, which is the easy one.
//
// A press goes to whatever is under the pointer *and moves the focus there* -- `focus.clicked`
// already decides that, including leaving the focus alone when the press landed on nothing.
//
// **A release goes to the focus, not to what is under the pointer**, which looks wrong and is
// right: the press moved the focus to the control being pressed, so routing the release to the
// focus delivers it to the control that was pressed even when the pointer has since moved off. A
// release routed by position instead would never reach a button the user dragged off, and the
// button would stay drawn pressed for ever. The same reasoning covers a move.
//
// **A wheel goes to the control under the pointer and ignores the focus entirely**, because that is
// what a user means: scrolling the list they are pointing at, not the one that happens to have the
// keyboard. Over nothing it goes nowhere rather than to the focus.
//
// **To the nearest *tab stop* under the pointer, not the innermost control**, which is the same
// resolution a press gets and for the same reason. `focus.control_at` answers a list's row or a
// tree's item -- a `part_of`, something a click and a reader can reach and that no application
// holds a state for -- so a wheel routed that way named a control nobody could handle and was
// dropped on the floor. **The wheel had never scrolled a list or a tree in any application.**
// Found by painting a scroll bar: the indicator sat still while the window said it should move.
pub fn target(l: Laid, input: Input, focused: string) -> string {
    return switch input {
        KeyDown(_) { focused }
        KeyUp(_) { focused }
        Text(_) { focused }
        Paste(_) { focused }
        Press(p) { focus.clicked(l, p, focused) }
        Release(_) { focused }
        Move(_) { focused }
        // `""` as the fallback, which is what keeps "over nothing goes nowhere" true: `clicked`
        // answers its third argument when the point is over no tab stop at all.
        Wheel(w) { focus.clicked(l, w.at, "") }
    }
}

// ------------------------------------------------------------------ the button

// A button, and whether it is being held down.
//
// `held` is state and `ButtonStep.activated` is not, which is the distinction the whole model rests
// on: being held is something a user can see and the next frame has to draw, while having fired is
// something that happened once and that the application acts on rather than stores.
pub struct Button {
    name: string
    label: string
    disabled: bool
    held: bool
}

pub fn button_of(name: string, label: string) -> Button {
    return Button { name: name, label: label, disabled: false, held: false }
}

pub struct ButtonStep {
    button: Button
    activated: bool
}

// What an input does to a button.
//
// `bounds` is the rectangle the layout gave it -- `focus.node_of` answers that -- and it is needed
// for one rule: **a press inside followed by a release outside does not fire.** Dragging off a
// button cancels it, which every toolkit does and which is the reason `held` exists at all rather
// than the button simply reporting each click. A button that fired on any release would fire when
// the user changed their mind.
//
// The keyboard mirrors the pointer rather than firing on the way down: **Space arms and fires on
// release**, so it can be cancelled the same way, while **Enter fires immediately**, because Enter
// is the key a default button answers and a user pressing it has already decided. That split is the
// platforms' own and is deliberate here.
pub fn button_input(b: Button, input: Input, bounds: Rect) -> ButtonStep {
    if b.disabled {
        // A disabled button does not even take a press, so it cannot be left held when it is
        // enabled again.
        return still(with b { held: false })
    }
    return switch input {
        Press(p) { still(with b { held: widget.contains(bounds, p) }) }
        Release(p) {
            if b.held && widget.contains(bounds, p) {
                ButtonStep { button: with b { held: false }, activated: true }
            } else {
                still(with b { held: false })
            }
        }
        KeyDown(k) {
            if is_enter(k) {
                ButtonStep { button: b, activated: true }
            } else {
                still(with b { held: b.held || is_space(k) })
            }
        }
        KeyUp(k) {
            if b.held && is_space(k) {
                ButtonStep { button: with b { held: false }, activated: true }
            } else {
                still(b)
            }
        }
        Text(_) { still(b) }
        Paste(_) { still(b) }
        Move(_) { still(b) }
        Wheel(_) { still(b) }
    }
}

fn still(b: Button) -> ButtonStep {
    return ButtonStep { button: b, activated: false }
}

// The button as a widget: a control declaring its role, around a background and its label.
//
// The role and the label are declared here, which is what F275 is for -- a reader announces
// "button, Save" from this one call, and nothing downstream has to guess that a group of rectangles
// was a button.
pub fn button_widget(b: Button, style: Style) -> widget.Widget {
    val ink = if b.disabled { style.disabled_ink } else { style.ink }
    val face = if b.held { style.pressed_face } else { style.face }
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: style.padding,
        background: Option<Color>.Some(face),
        children: [widget.label_of(b.label, style.text_size, ink)],
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: b.name,
        role: widget.Role.Button,
        label: "",
        description: "",
        value: "",
        state: with widget.no_state() { disabled: b.disabled },
        tab_stop: true,
        child: inside
    })
}

// --------------------------------------------------------------- the check box

pub struct CheckBox {
    name: string
    label: string
    disabled: bool
    checked: Toggle
    held: bool
}

pub fn check_box_of(name: string, label: string, checked: Toggle) -> CheckBox {
    return CheckBox { name: name, label: label, disabled: false, checked: checked, held: false }
}

pub struct CheckStep {
    check_box: CheckBox
    toggled: bool
}

// What an input does to a check box: the button's rules, and then the toggle.
//
// **A mixed box becomes checked, never unchecked**, which is not what "toggle" suggests and is what
// every platform does: a mixed box means some of the things under it are on, and a user clicking it
// is asking for all of them, not none. Going to unchecked would throw away the choices that were
// already made.
pub fn check_box_input(c: CheckBox, input: Input, bounds: Rect) -> CheckStep {
    val step = button_input(as_button(c), input, bounds)
    val moved = with c { held: step.button.held }
    if !step.activated {
        return CheckStep { check_box: moved, toggled: false }
    }
    return CheckStep { check_box: with moved { checked: next(c.checked) }, toggled: true }
}

fn as_button(c: CheckBox) -> Button {
    return Button { name: c.name, label: c.label, disabled: c.disabled, held: c.held }
}

fn next(t: Toggle) -> Toggle {
    return switch t {
        Off { Toggle.On }
        On { Toggle.Off }
        Mixed { Toggle.On }
    }
}

// The check box as a widget: the mark, then the label, and the state declared so that a reader says
// "check box, Notify me, partly checked" without anything else being told.
pub fn check_box_widget(c: CheckBox, style: Style) -> widget.Widget {
    val ink = if c.disabled { style.disabled_ink } else { style.ink }
    val face = if c.held { style.pressed_face } else { style.face }
    val box = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.insets_all(1.0),
        background: Option<Color>.Some(face),
        children: [widget.label_of(mark(c.checked), style.text_size, ink)],
        name: ""
    })
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: style.text_size * 0.5,
        padding: style.padding,
        background: Option<Color>.None,
        children: [box, widget.label_of(c.label, style.text_size, ink)],
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: c.name,
        role: widget.Role.CheckBox,
        // Declared rather than taken from the text inside, because the text inside is the mark as
        // well as the label: a reader must not announce "check box, x Notify me".
        label: c.label,
        description: "",
        value: "",
        state: with widget.no_state() {
            disabled: c.disabled,
            checked: Option<Toggle>.Some(c.checked)
        },
        tab_stop: true,
        child: inside
    })
}

// What the box draws. Text rather than a drawn glyph, so that a check box needs no icon set and no
// second rendering path -- F277's later instalments can replace it without the model changing.
fn mark(t: Toggle) -> string {
    return switch t {
        Off { " " }
        On { "x" }
        Mixed { "-" }
    }
}

// ------------------------------------------------------------------ the entry

// A single-line text field.
//
// The editing itself is `lib/ui/edit`: this holds an `Editor` and a `History` and decides which
// input means which edit. Keeping the two apart is what let the grapheme and word rules be tested
// against 32 cases with no widget, no layout and no font in sight.
pub struct Entry {
    name: string
    // What a reader calls the field. **Declared, not taken from the text inside**, because the text
    // inside a field is its *value* -- a field announced by its contents would introduce itself as
    // whatever the user last typed.
    label: string
    editor: edit.Editor
    history: edit.History
    disabled: bool
    // Readable but not editable. The caret still moves and text can still be selected and copied,
    // which is the difference from disabled and the reason both exist.
    readonly: bool
    // A press has happened and the pointer has not come up: a move extends the selection.
    dragging: bool
    // Whether the last change was a typed character, so that a run of them is **one** undo step.
    //
    // Without this, Ctrl-Z after typing a word steps back one letter at a time, which is not what
    // undo means to anyone. The rule is the one editors use: consecutive `Text` inserts coalesce,
    // and anything else -- a delete, a paste, a caret move, a click -- ends the run.
    typing: bool
    // How many lines tall. **1 is a field and anything more is a text area**, and the difference is
    // only three things: Enter inserts a newline instead of being left for a default button, Up and
    // Down move by line instead of doing nothing, and the widget draws a column of lines instead of
    // one run.
    //
    // One control rather than two because the rest -- clusters, words, selection, undo, the click
    // that places a caret -- is identical, and `edit` never cared how many lines its text had: a
    // newline has always been an ordinary character in that string. A separate `TextArea` would have
    // been a second copy of all of it to gain a field.
    rows: int
    // How far the text is scrolled, in points. **A text area scrolls itself**, because the only
    // thing that knows where the caret went is the code that moved it -- a caller would have to
    // recompute the caret's line to follow it, which is the control's own arithmetic done twice.
    // Zero and unused for a one-line field.
    scroll: float
    // Text being composed through an input method, which is **not** in `editor.text` until it is
    // committed -- see `edit.Preedit`. `None` is the ordinary state and the only one most fields
    // are ever in.
    preedit: Option<edit.Preedit>
    // Shown as a run of bullets rather than as itself, and **published to a screen reader the same
    // way**: the real text leaves this module only when the application asks the field for it.
    //
    // A field, not a second control, for `rows`'s reason: everything else about a password field
    // is a text field -- the caret, the selection, the undo, the click that places a caret -- and
    // the three things that differ are what is drawn, what `Role` it declares, and that it will
    // not put its contents on the clipboard.
    masked: bool
}

pub fn entry_of(name: string, label: string, text: string) -> Entry {
    return Entry {
        name: name,
        label: label,
        editor: edit.editor_of(text),
        history: edit.history_of(100),
        disabled: false,
        readonly: false,
        dragging: false,
        typing: false,
        rows: 1,
        scroll: 0.0,
        masked: false,
        preedit: Option<edit.Preedit>.None
    }
}

// A field `rows` lines tall: Enter inserts a newline, Up and Down move by line, and the text is
// drawn a line at a time.
pub fn text_area_of(name: string, label: string, text: string, rows: int) -> Entry {
    return with entry_of(name, label, text) { rows: if rows < 1 { 1 } else { rows } }
}

// A field for a secret: drawn as bullets, announced as a password, and refusing the clipboard.
//
// **One line, always.** A multi-line password is not a thing, and the multi-line widget would draw
// the text, so `entry_widget` sends a masked field down the one-line path whatever `rows` says
// rather than leaving a way to build a field that masks in one place and not the other.
pub fn password_of(name: string, label: string, text: string) -> Entry {
    return with entry_of(name, label, text) { masked: true }
}

// **What is drawn and what is published -- which must be the same string the caret is measured
// against.** A mask is one bullet per character, so every index into the text is the same index
// into this; measuring the real text and drawing the mask would put the caret under the wrong
// bullet in any font where a bullet is not the width of an `e`.
pub fn shown_text(e: Entry) -> string {
    // **The composition first, the mask second.** A field that is both is a password being typed
    // through an input method: the composition still has to be where the caret arithmetic expects
    // it, and it still must not be legible. Masking the spliced text does both.
    val with_composition = edit.shown(e.editor, e.preedit)
    if !e.masked {
        return with_composition
    }
    return join(separator: "", pieces: mutable_array_filled(len(with_composition), bullet))
}

// Where the caret is in what `shown_text` answers: inside the composition while one is open,
// because that is where the user is typing.
fn shown_caret_at(e: Entry) -> int {
    return edit.shown_caret(e.editor, e.preedit)
}

// **How an input method reaches a field, and why it is not an `Input`.** A composition is not
// routed by what is under the pointer or by a focus that falls back; it belongs to whatever holds
// the input-method context, which is the focused text field and nothing else. Making it an
// `Input` would have put two arms on every button, list and tab strip in this module for an event
// none of them can ever receive.
pub fn entry_composing(e: Entry, text: string, caret: int) -> EntryStep {
    val started = edit.compose(e.editor, text, caret)
    return composing_step(e, started)
}

pub fn entry_composing_marked(e: Entry, text: string, caret: int, from: int, to: int) -> EntryStep {
    return composing_step(e, edit.compose_marked(e.editor, text, caret, from, to))
}

fn composing_step(e: Entry, c: edit.Composing) -> EntryStep {
    return EntryStep {
        entry: with e { editor: c.editor, preedit: Option<edit.Preedit>.Some(c.preedit), typing: false },
        copied: "",
        // **Composing is not a change and committing is.** `changed` is what a form watches to
        // know it is dirty, and a half-typed composition has changed nothing a save would write.
        changed: false
    }
}

// What the method finally chose, which replaces the composition. **An empty commit is how a
// composition is abandoned**: the method says it chose nothing, the pre-edit goes, and the text
// is as it was.
pub fn entry_commit(e: Entry, text: string) -> EntryStep {
    switch e.preedit {
        Some(p) {
            val done = edit.commit(e.editor, p, text)
            return EntryStep {
                entry: with e {
                    editor: done,
                    preedit: Option<edit.Preedit>.None,
                    history: edit.record(e.history, e.editor),
                    typing: false
                },
                copied: "",
                changed: text != ""
            }
        }
        // A commit with nothing open is ordinary text, which is what a method sends for a
        // compose sequence that never showed a pre-edit at all.
        None { return typed(e, text) }
    }
}

// U+2022, written as itself because this language has no `\u` escape.
val bullet = "•"

pub struct EntryStep {
    entry: Entry
    // Text the field is asking to be put on the system clipboard, or "". **An output, because this
    // module cannot reach a clipboard** -- the same seam `Input.Paste` is the other half of. An
    // application keeps it in a value of its own until the platform side of F273 exists.
    copied: string
    // Whether the text changed -- not the caret, not the selection. What a form watches to know it
    // is dirty, and the reason it is separate from the new state rather than something a caller
    // works out by comparing two strings.
    changed: bool
}

// What an input does to a field.
//
// `bounds`, `style` and `m` are all here for one reason: a press carries a pixel and a caret is an
// index, so placing the caret where the user clicked needs the same measurement the layout used.
// The scroll a text area needs to keep its caret in view, after whatever just happened to it.
//
// **Applied to every step rather than to the movement keys**, because everything moves the caret:
// typing runs off the bottom of the box as surely as Down does, a click places it, Home and End
// move it, and a delete can pull it up a line. Naming the keys that scroll is how a text area ends
// up with one that does not.
fn following_caret(step: EntryStep, bounds: Rect, style: Style, m: widget.Metrics) -> EntryStep {
    val e = step.entry
    if e.rows <= 1 {
        return step
    }
    val height = m.line_height
    val line = height(style.text_size)
    val at = edit.line_index(e.editor.text, e.editor.caret)
    val view = bounds.height - style.padding.top - style.padding.bottom
    return EntryStep {
        entry: with e {
            scroll: widget.scroll_to_reveal(view, e.scroll, (at as float) * line, line)
        },
        copied: step.copied,
        changed: step.changed
    }
}

pub fn entry_input(e: Entry, input: Input, bounds: Rect, style: Style, m: widget.Metrics) -> EntryStep {
    if e.disabled {
        return kept(with e { dragging: false })
    }
    return following_caret(entry_step(e, input, bounds, style, m), bounds, style, m)
}

fn entry_step(e: Entry, input: Input, bounds: Rect, style: Style, m: widget.Metrics) -> EntryStep {
    // **While a composition is open the pointer does not move the caret**, and the reason is an
    // index rather than a policy: a press is measured against `shown_text`, which has the
    // composition spliced into it, while `place_caret` works in the committed text -- two
    // coordinate spaces that agree exactly until something is being composed. Placing one from
    // the other would put the caret a composition's length away from where it was clicked.
    //
    // Doing nothing is also what a user wants often enough: the input method owns the caret while
    // it is converting, and an application that would rather a click ended the composition calls
    // `entry_commit` first -- which it has to anyway, to decide what a click *means*.
    if Option.is_Some(e.preedit) {
        if pointer_input(input) {
            return kept(e)
        }
    }
    return switch input {
        Text(what) { typed(e, what) }
        Paste(what) { pasted(e, what) }
        KeyDown(k) { entry_key(e, k) }
        KeyUp(_) { kept(e) }
        Press(p) {
            kept(with e {
                editor: edit.place_caret(
                    e.editor,
                    // **`shown_text`, not `e.editor.text`** -- a click lands on the bullet the
                    // user aimed at, which is only the same index if the thing measured is the
                    // thing drawn.
                    caret_at_x(shown_text(e), style.text_size, m, p.x - text_left(bounds, style)),
                    false
                ),
                dragging: true,
                typing: false
            })
        }
        Move(p) {
            if e.dragging {
                kept(with e {
                    editor: edit.place_caret(
                        e.editor,
                        caret_at_x(shown_text(e), style.text_size, m, p.x - text_left(bounds, style)),
                        true
                    )
                })
            } else {
                kept(e)
            }
        }
        Release(_) { kept(with e { dragging: false }) }
        Wheel(_) { kept(e) }
    }
}

fn pointer_input(input: Input) -> bool {
    return switch input {
        Press(_) { true }
        Move(_) { true }
        Release(_) { true }
        KeyDown(_) { false }
        KeyUp(_) { false }
        Text(_) { false }
        Paste(_) { false }
        Wheel(_) { false }
    }
}

fn kept(e: Entry) -> EntryStep {
    return EntryStep { entry: e, copied: "", changed: false }
}

fn edited(e: Entry, editor: edit.Editor, history: edit.History, typing: bool) -> EntryStep {
    return EntryStep {
        entry: with e { editor: editor, history: history, typing: typing },
        copied: "",
        changed: true
    }
}

fn typed(e: Entry, what: string) -> EntryStep {
    if e.readonly {
        return kept(e)
    }
    // Recorded only at the start of a run, which is what makes the run one undo step.
    val history = if e.typing { e.history } else { edit.record(e.history, e.editor) }
    return edited(e, edit.insert(e.editor, what), history, true)
}

fn pasted(e: Entry, what: string) -> EntryStep {
    if e.readonly {
        return kept(e)
    }
    return edited(e, edit.paste(e.editor, what), edit.record(e.history, e.editor), false)
}

// Which edit a keystroke means.
//
// Dispatched on `Key` rather than on a name, so a mistyped case is a compile error instead of a
// shortcut that quietly never fires. The shortcut *letters* are still compared as text, because a
// letter is what they are: `Char("c")` whatever the layout puts on that key.
fn entry_key(e: Entry, k: Keystroke) -> EntryStep {
    val extend = k.shift
    if k.control {
        val letter = char_of(k.key)
        if letter == "a" { return kept(with e { editor: edit.select_all(e.editor), typing: false }) }
        if letter == "c" { return copied_from(e) }
        if letter == "x" { return cut_from(e) }
        if letter == "z" { return undone(e) }
        if letter == "y" { return redone(e) }
        if Key.is_Left(k.key) { return moved(e, edit.move_word_left(e.editor, extend)) }
        if Key.is_Right(k.key) { return moved(e, edit.move_word_right(e.editor, extend)) }
        if Key.is_Backspace(k.key) { return changed_by(e, edit.delete_word_back(e.editor)) }
    }
    if Key.is_Left(k.key) { return moved(e, edit.move_left(e.editor, extend)) }
    if Key.is_Right(k.key) { return moved(e, edit.move_right(e.editor, extend)) }
    if Key.is_Home(k.key) { return moved(e, edit.move_home(e.editor, extend)) }
    if Key.is_End(k.key) { return moved(e, edit.move_end(e.editor, extend)) }
    if Key.is_Backspace(k.key) { return changed_by(e, edit.delete_back(e.editor)) }
    if Key.is_Delete(k.key) { return changed_by(e, edit.delete_forward(e.editor)) }
    // **The three keys a text area answers and a field does not.**
    //
    // Enter is the sharp one: in a one-line field it must fall through untouched, because that is
    // the key a default button answers and a field that swallowed it would break every form. In a
    // text area it is a newline, and nothing else can type one -- the keyboard sends `Enter`, not
    // `Text("\n")`.
    //
    // Up and Down do nothing in a field on purpose rather than by omission: there is nowhere to go,
    // and a field that moved the caret to one end on Up would be surprising in a form where Up is
    // how a user expects to reach the control above.
    if e.rows > 1 {
        if Key.is_Enter(k.key) { return changed_by(e, edit.insert(e.editor, "\n")) }
        if Key.is_Up(k.key) { return moved(e, edit.move_up(e.editor, extend)) }
        if Key.is_Down(k.key) { return moved(e, edit.move_down(e.editor, extend)) }
    }
    return kept(e)
}

// A caret move ends a typing run but is not a change: a form is not dirty because the user pressed
// an arrow key.
fn moved(e: Entry, editor: edit.Editor) -> EntryStep {
    return kept(with e { editor: editor, typing: false })
}

fn changed_by(e: Entry, editor: edit.Editor) -> EntryStep {
    if e.readonly {
        return kept(e)
    }
    return edited(e, editor, edit.record(e.history, e.editor), false)
}

// Copying changes nothing, which is why it answers the text and the same field back.
fn copied_from(e: Entry) -> EntryStep {
    return EntryStep { entry: with e { typing: false }, copied: taken_from(e), changed: false }
}

// What a copy or a cut hands out. **A masked field hands out nothing**, because a control whose
// whole purpose is that its contents are not shown cannot be the thing that puts them on a
// system-wide clipboard every other program can read. The selection still moves and a cut still
// deletes -- what is refused is the copy, not the editing.
fn taken_from(e: Entry) -> string {
    if e.masked {
        return ""
    }
    return edit.copy(e.editor)
}

fn cut_from(e: Entry) -> EntryStep {
    val text = taken_from(e)
    // **A masked field still cuts**, which is why this asks the editor rather than `text`: `text`
    // is "" for one by design, and keying the no-op off it would turn Ctrl-X into a key that does
    // nothing in the one field where deleting a selection matters most.
    if e.readonly || !edit.has_selection(e.editor) {
        // **A read-only field still copies**, and cutting from one is a copy rather than nothing:
        // the user asked for the text, and refusing to give it is not what read-only means.
        return EntryStep { entry: with e { typing: false }, copied: text, changed: false }
    }
    return EntryStep {
        entry: with e {
            editor: edit.cut(e.editor),
            history: edit.record(e.history, e.editor),
            typing: false
        },
        copied: text,
        changed: true
    }
}

fn undone(e: Entry) -> EntryStep {
    val step = edit.undo(e.history, e.editor)
    return EntryStep {
        entry: with e { editor: step.editor, history: step.history, typing: false },
        copied: "",
        changed: step.editor.text != e.editor.text
    }
}

fn redone(e: Entry) -> EntryStep {
    val step = edit.redo(e.history, e.editor)
    return EntryStep {
        entry: with e { editor: step.editor, history: step.history, typing: false },
        copied: "",
        changed: step.editor.text != e.editor.text
    }
}

// Where the text starts inside the field, which is what a click's x has to be measured from.
fn text_left(bounds: Rect, style: Style) -> float {
    return bounds.x + style.padding.left
}

// The caret index a pixel offset into the text means.
//
// **The nearest boundary, not the character the pixel is inside.** Clicking the left half of a
// character puts the caret before it and the right half after it, which is what every text field
// does and what a user means by clicking "between" two letters. Taking the character the pixel
// landed in instead makes the caret feel one place behind the pointer, which is the kind of thing
// nobody reports and everybody notices.
//
// Measured as prefixes rather than as a sum of per-character widths, because a sum ignores kerning
// and would disagree with the layout that drew the text. That makes this O(n^2) in the length of
// the field, which is the right trade for one line of text and the wrong one for a document.
pub fn caret_at_x(text: string, size: float, m: widget.Metrics, x: float) -> int {
    if x <= 0.0 {
        return 0
    }
    val width = m.text_width
    val n = len(text)
    var i = 0
    while i < n {
        val before = width(substring(text, 0, i), size)
        val after = width(substring(text, 0, i + 1), size)
        if x < (before + after) / 2.0 {
            return i
        }
        i = i + 1
    }
    return n
}

// The three runs a field without a composition draws: before the selection, the selection, after
// it -- with the caret standing in for the selection when there is none.
fn selected_runs(e: Entry, text: string, ink: Color, style: Style, line: float) -> [widget.Widget] {
    val from = edit.selection_start(e.editor)
    val to = edit.selection_end(e.editor)
    val middle = if edit.has_selection(e.editor) {
        tinted(substring(text, from, to), style.pressed_face, ink, style, "selection")
    } else {
        caret_box(ink, line)
    }
    return [
        widget.label_of(substring(text, 0, from), style.text_size, ink),
        middle,
        widget.label_of(substring(text, to, len(text)), style.text_size, ink)
    ]
}

// A field with a composition open: the committed text either side of it, the composition tinted,
// the run being converted tinted more strongly, and the caret **inside** the composition.
//
// **Built from `shown_text` and `edit.shown_caret` and nothing else**, which is the rule that
// keeps a caret where it looks: the press that places one measures the same string this draws, so
// the two cannot disagree about where a character begins.
fn composed_runs(e: Entry, text: string, ink: Color, style: Style, line: float) -> [widget.Widget] {
    val out = mutable_array_new<widget.Widget>()
    val caret = shown_caret_at(e)
    val span = edit.shown_highlight(e.editor, e.preedit)
    val marks = switch span {
        Some(one) { [one.start, one.end] }
        None { [caret, caret] }
    }
    val starts = composition_bounds(e, text)
    // Every boundary the runs are cut at, in order: the composition's ends, the marked run's
    // ends, and the caret.
    var cut = 0
    for edge in sorted_edges([starts[0], starts[1], marks[0], marks[1], caret], len(text)) {
        if edge > cut {
            push(out, run_between(e, text, cut, edge, starts, marks, ink, style))
            cut = edge
        }
        if edge == caret {
            push(out, caret_box(ink, line))
        }
    }
    if cut < len(text) {
        push(out, run_between(e, text, cut, len(text), starts, marks, ink, style))
    }
    return snapshot(out)
}

// Where the composition sits in what is shown.
fn composition_bounds(e: Entry, text: string) -> [int] {
    switch e.preedit {
        Some(p) {
            val at = if p.at > len(e.editor.text) { len(e.editor.text) } else { p.at }
            return [at, at + len(p.text)]
        }
        None { return [0, 0] }
    }
}

fn run_between(
    e: Entry,
    text: string,
    from: int,
    to: int,
    starts: [int],
    marks: [int],
    ink: Color,
    style: Style
) -> widget.Widget {
    val piece = substring(text, from, to)
    if from >= marks[0] && to <= marks[1] && marks[0] != marks[1] {
        return tinted(piece, style.converting_face, ink, style, "converting")
    }
    if from >= starts[0] && to <= starts[1] {
        return tinted(piece, style.composing_face, ink, style, "composing")
    }
    return widget.label_of(piece, style.text_size, ink)
}

fn tinted(piece: string, face: Color, ink: Color, style: Style, name: string) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        background: Option<Color>.Some(face),
        children: [widget.label_of(piece, style.text_size, ink)],
        name: name
    })
}

fn caret_box(ink: Color, line: float) -> widget.Widget {
    return widget.fixed_of(1.0, line, widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        background: Option<Color>.Some(ink),
        children: [],
        name: caret_name
    }))
}

// The cut points in order and without repeats, clamped into the text. Small and sorted by hand:
// there are five of them and they are nearly sorted already.
fn sorted_edges(edges: [int], n: int) -> [int] {
    val kept = mutable_array_new<int>()
    var value = 0
    while value <= n {
        for edge in edges {
            if edge == value && !contains(kept, value) {
                push(kept, value)
            }
        }
        value = value + 1
    }
    return snapshot(kept)
}

// The name the caret's box carries in the laid-out tree, so that a test can find it and an
// application can draw attention to it.
pub val caret_name = "caret"

// The field as a widget.
//
// **The caret is placed by the layout rather than computed.** The row is the text before the caret,
// then a one-unit box, then the text after it -- so the same metrics that measure the text place the
// caret, and the two cannot drift apart. Computing a caret's x separately is how a caret ends up
// half a character off in one font and right in another.
//
// A selection is the same trick: the selected run is its own label with a background behind it.
//
// Takes a `Metrics` where `button_widget` does not, because a caret's height is a text measurement
// and guessing it from the em size is wrong for any face whose line height is not 1.2.
// One line of a multi-line field: the part before the selection, the selected part or the caret,
// and the part after -- the same three pieces `entry_widget` lays out for a single line, clamped to
// this line's range.
fn entry_line(
    e: Entry,
    from_at: int,
    to_at: int,
    on_this_line: bool,
    ink: Color,
    style: Style,
    line: float
) -> widget.Widget {
    val text = e.editor.text
    val sel_from = edit.selection_start(e.editor)
    val sel_to = edit.selection_end(e.editor)
    val selected = edit.has_selection(e.editor)
    // The selection clipped to this line. Both ends are pinned inside it, so a selection that
    // starts above and ends below colours the whole line and one that misses it entirely collapses
    // to nothing.
    val lo = if sel_from < from_at { from_at } else { if sel_from > to_at { to_at } else { sel_from } }
    val hi = if sel_to < from_at { from_at } else { if sel_to > to_at { to_at } else { sel_to } }
    val pieces = mutable_array_new<widget.Widget>()
    if selected && hi > lo {
        push(pieces, widget.label_of(substring(text, from_at, lo), style.text_size, ink))
        push(pieces, widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Row,
            spacing: 0.0,
            padding: widget.no_insets(),
            background: Option<Color>.Some(style.pressed_face),
            children: [widget.label_of(substring(text, lo, hi), style.text_size, ink)],
            name: "selection"
        }))
        push(pieces, widget.label_of(substring(text, hi, to_at), style.text_size, ink))
    } else {
        if !selected && on_this_line {
            val caret = e.editor.caret
            push(pieces, widget.label_of(substring(text, from_at, caret), style.text_size, ink))
            push(pieces, widget.fixed_of(1.0, line, widget.Widget.Group(widget.Stack {
                direction: widget.Direction.Row,
                spacing: 0.0,
                padding: widget.no_insets(),
                background: Option<Color>.Some(ink),
                children: [],
                name: caret_name
            })))
            push(pieces, widget.label_of(substring(text, caret, to_at), style.text_size, ink))
        } else {
            push(pieces, widget.label_of(substring(text, from_at, to_at), style.text_size, ink))
        }
    }
    return widget.fixed_of(0.0, line, widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        background: Option<Color>.None,
        children: snapshot(pieces),
        name: ""
    }))
}

fn multi_line_widget(e: Entry, style: Style, m: widget.Metrics) -> widget.Widget {
    val ink = if e.disabled { style.disabled_ink } else { style.ink }
    val height = m.line_height
    val line = height(style.text_size)
    val text = e.editor.text
    val caret_line = edit.line_index(text, e.editor.caret)
    val lines = mutable_array_new<widget.Widget>()
    var at = 0
    var index = 0
    // Walks the text by line rather than splitting it, because the widget needs each line's
    // *indices* and not just its characters: the caret and the selection are positions in the whole
    // string, and a split would throw away the only thing that relates them to a line.
    var more = true
    while more {
        val stop = edit.line_end(text, at)
        push(lines, entry_line(e, at, stop, index == caret_line, ink, style, line))
        if stop >= len(text) {
            more = false
        } else {
            at = stop + 1
            index = index + 1
        }
    }
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: style.padding,
        background: Option<Color>.Some(style.face),
        children: snapshot(lines),
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: e.name,
        role: widget.Role.TextField,
        label: e.label,
        description: "",
        value: text,
        state: with widget.no_state() { disabled: e.disabled, readonly: e.readonly, multiline: true },
        tab_stop: true,
        child: widget.named_scroll(concat(e.name, "-scroll"), 0.0, e.scroll, inside)
    })
}

pub fn entry_widget(e: Entry, style: Style, m: widget.Metrics) -> widget.Widget {
    // **A masked field takes the one-line path whatever `rows` says.** A multi-line password is
    // not a thing, and `multi_line_widget` draws the text -- so leaving `rows` able to decide
    // would leave a way to build a field that masks in one place and not the other.
    if e.rows > 1 && !e.masked {
        return multi_line_widget(e, style, m)
    }
    val ink = if e.disabled { style.disabled_ink } else { style.ink }
    val height = m.line_height
    val line = height(style.text_size)
    val text = shown_text(e)
    // **A field is never selecting and composing at once**, which is not a simplification taken
    // but one the model gives: `edit.compose` deletes a selection before it opens a composition,
    // because that is what typing over one does. So the runs below are one case or the other.
    val runs = if Option.is_Some(e.preedit) {
        composed_runs(e, text, ink, style, line)
    } else {
        selected_runs(e, text, ink, style, line)
    }
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        // Zero, and it has to be: any spacing here would push the caret off the boundary it marks.
        spacing: 0.0,
        padding: style.padding,
        background: Option<Color>.Some(style.face),
        children: runs,
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: e.name,
        role: if e.masked { widget.Role.Password } else { widget.Role.TextField },
        label: e.label,
        description: "",
        // The field's content, which is what a reader says after the name -- and for a masked
        // field that is `text`, which is already the bullets. **The secret never enters the
        // accessibility tree at all**, rather than entering it and being filtered somewhere
        // downstream: a reader, a remote bridge and a test dump all read this one string, and
        // there is no second place to remember.
        value: text,
        state: with widget.no_state() { disabled: e.disabled, readonly: e.readonly },
        tab_stop: true,
        child: inside
    })
}

// -------------------------------------------------------------------- the list

// A list of rows, one of them selected, scrolled by itself.
//
// **One tab stop with two hundred accessibility nodes.** The list takes the focus; the arrow keys
// move the selection inside it; each row is a `widget.part_of` -- a control a click and a reader can
// reach and Tab cannot. That distinction did not exist before this widget needed it, and the
// alternative was a list that either put two hundred stops in the tab order or announced all two
// hundred rows as its own name.
pub struct List {
    name: string
    label: string
    items: [string]
    // The selected row, or -1 for none -- which is a real state, not an error: an empty list has no
    // selection, and neither does one the user has not touched.
    selected: int
    // How far the rows have scrolled, in the same units the layout uses. Not a row index: a list
    // scrolled by whole rows cannot show half of one, and half of one is what tells a user there is
    // more below.
    offset: float
    row_height: float
    disabled: bool
    // What a reader calls this and its rows.
    //
    // **Fields rather than constants, so a menu can be a list.** A menu's popup is a list of rows
    // with one highlighted, scrolled when it is long, driven by the same arrows -- all of which is
    // `List` already. The only honest difference is what a screen reader should call it, so that is
    // the only thing a menu has to change. Duplicating the selection, the scrolling and the key
    // handling to rename two roles would have been the alternative.
    role: widget.Role
    item_role: widget.Role
    // The drag state of the bar down its right edge, as a tree has.
    bar: ScrollBar
}

pub fn list_of(name: string, label: string, items: [string]) -> List {
    return List {
        name: name,
        label: label,
        items: items,
        selected: if len(items) == 0 { 0 - 1 } else { 0 },
        offset: 0.0,
        row_height: 20.0,
        disabled: false,
        role: widget.Role.List,
        item_role: widget.Role.ListItem,
        bar: scroll_bar_of(concat(name, "/bar"), 20.0)
    }
}

pub struct ListStep {
    list: List
    // The selection changed. An output, as `ButtonStep.activated` is: the application acts on it
    // and stores the list.
    moved: bool
    // A row was chosen -- Enter on the selection. Separate from `moved`, because selecting a row and
    // opening it are different intentions and a list that conflated them would open on every arrow
    // key.
    activated: bool
}

// What an input does to a list.
//
// `bounds` is the box the layout gave it, needed for two things: turning a click's y into a row,
// and knowing how far one page is.
pub fn list_input(l: List, input: Input, bounds: Rect) -> ListStep {
    if l.disabled {
        return held_still(l)
    }
    // The bar first, and a drag in progress before anything else -- see `tree_input`, which has
    // the same three lines for the same reasons.
    if Option.is_Some(l.bar.grabbed) || list_for_the_bar(l, input, bounds) {
        return list_bar_step(l, input, bounds)
    }
    val last = len(l.items) - 1
    return switch input {
        // **The wheel scrolls and does not move the selection.** Every list does this and it is
        // easy to get wrong by routing a wheel to whatever has the keyboard: a user scrolling to
        // look at something further down has not asked to select it, and a list that moved the
        // selection under them would lose the row they were about to act on.
        Wheel(w) { scrolled(l, l.offset - (w.vertical as float) * l.row_height, bounds) }
        Press(p) {
            val row = floor((p.y - bounds.y + l.offset) / l.row_height)
            if row < 0 || row > last {
                held_still(l)
            } else {
                ListStep { list: with l { selected: row }, moved: row != l.selected, activated: false }
            }
        }
        KeyDown(k) { list_key(l, k, bounds) }
        KeyUp(_) { held_still(l) }
        Text(_) { held_still(l) }
        Paste(_) { held_still(l) }
        Release(_) { held_still(l) }
        Move(_) { held_still(l) }
    }
}

fn list_for_the_bar(l: List, input: Input, bounds: Rect) -> bool {
    if Press(p) = input {
        return on_the_bar(bounds, p, list_content(l), bounds.height)
    }
    return false
}

fn list_content(l: List) -> float {
    return (len(l.items) as float) * l.row_height
}

fn list_bar_step(l: List, input: Input, bounds: Rect) -> ListStep {
    val taken = scroll_bar_input(l.bar, input, bar_box(bounds), list_content(l), bounds.height, l.offset)
    // A bar moves the view and never the selection, as a tree's does.
    return ListStep {
        list: with l { bar: taken.bar, offset: taken.offset },
        moved: false,
        activated: false
    }
}

fn list_key(l: List, k: Keystroke, bounds: Rect) -> ListStep {
    val last = len(l.items) - 1
    if last < 0 {
        return held_still(l)
    }
    val per_page = page_rows(l, bounds)
    if Key.is_Down(k.key) { return selected_to(l, l.selected + 1, bounds) }
    if Key.is_Up(k.key) { return selected_to(l, l.selected - 1, bounds) }
    if Key.is_PageDown(k.key) { return selected_to(l, l.selected + per_page, bounds) }
    if Key.is_PageUp(k.key) { return selected_to(l, l.selected - per_page, bounds) }
    if Key.is_Home(k.key) { return selected_to(l, 0, bounds) }
    if Key.is_End(k.key) { return selected_to(l, last, bounds) }
    if Key.is_Enter(k.key) || Key.is_Space(k.key) {
        if l.selected >= 0 {
            return ListStep { list: l, moved: false, activated: true }
        }
    }
    return held_still(l)
}

// At least one row a page, so a list shorter than one row still moves rather than sticking.
fn page_rows(l: List, bounds: Rect) -> int {
    val fits = floor(bounds.height / l.row_height)
    return if fits < 1 { 1 } else { fits }
}

// Moves the selection and **brings it into view by the least that works**, which is what makes
// arrowing down a long list creep by a row at the bottom edge instead of jumping a page at a time.
fn selected_to(l: List, want: int, bounds: Rect) -> ListStep {
    val last = len(l.items) - 1
    val row = if want < 0 { 0 } else { if want > last { last } else { want } }
    val revealed = widget.scroll_to_reveal(
        bounds.height,
        l.offset,
        (row as float) * l.row_height,
        l.row_height
    )
    return ListStep {
        list: with l { selected: row, offset: clamped(l, revealed, bounds) },
        moved: row != l.selected,
        activated: false
    }
}

fn scrolled(l: List, offset: float, bounds: Rect) -> ListStep {
    return ListStep { list: with l { offset: clamped(l, offset, bounds) }, moved: false, activated: false }
}

fn clamped(l: List, offset: float, bounds: Rect) -> float {
    return widget.clamp_offset(offset, bounds.height, (len(l.items) as float) * l.row_height)
}

fn held_still(l: List) -> ListStep {
    return ListStep { list: l, moved: false, activated: false }
}

// The list as a widget: a control holding a viewport of rows, each row a part of the list.
//
// **The rows carry `selected` rather than the list carrying an index**, because that is what a
// reader reads: it announces "list item, Ada, selected", and an index on the container would make
// every adapter work out for itself which child the number meant.
pub fn list_widget(l: List, style: Style) -> widget.Widget {
    val ink = if l.disabled { style.disabled_ink } else { style.ink }
    val rows = mutable_array_new<widget.Widget>()
    var i = 0
    while i < len(l.items) {
        val chosen = i == l.selected
        val face = if chosen { style.pressed_face } else { style.face }
        val row = widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Row,
            spacing: 0.0,
            padding: widget.insets_of(4.0, 2.0, 4.0, 2.0),
            background: Option<Color>.Some(face),
            children: [widget.label_of(l.items[i], style.text_size, ink)],
            name: ""
        })
        push(rows, widget.fixed_of(
            0.0,
            l.row_height,
            widget.part_of(
                row_name(l, i),
                l.item_role,
                l.items[i],
                with widget.no_state() { selected: chosen, disabled: l.disabled },
                row
            )
        ))
        i = i + 1
    }
    return widget.Widget.Control(widget.Focusable {
        name: l.name,
        role: l.role,
        label: l.label,
        description: "",
        value: "",
        state: with widget.no_state() { disabled: l.disabled },
        tab_stop: true,
        child: widget.named_scroll("", 0.0, l.offset, widget.column_of(0.0, snapshot(rows)))
    })
}

// A row's name, which focus and accessibility both address it by. The list's name and the index,
// because a row has no name of its own and an index alone would collide with another list's.
pub fn row_name(l: List, index: int) -> string {
    return concat(l.name, "/", str(index))
}

// -------------------------------------------------------------------- the tabs

// A strip of tabs, one of them selected, choosing what is shown beneath it.
//
// **Selection follows the focus.** Arrowing along the strip changes what is shown, with no second
// keystroke to confirm -- the automatic-activation model, which is the one to use unless revealing
// a panel is expensive. So `TabStep` reports only that the selection `moved`, and there is no
// `activated` beside it: a tab that had to be opened as well as reached is the manual model, and
// nothing has asked for it.
//
// **One tab stop, as a list is**: Tab reaches the strip and the arrows move within it, so a window
// with four tabs does not spend four stops on them. Each tab is a `widget.part_of` -- something a
// click and a reader can reach and Tab cannot.
//
// **Not a `List` with another role**, though a menu is one. A menu differs from a list only in what
// a reader calls it, which is why `List.role` is a field; a tab strip differs in three ways -- it
// runs along a row, its arrows are Left and Right, and it does not scroll -- and three differences
// is a control.
pub struct Tabs {
    name: string
    label: string
    items: [string]
    // The selected tab. **Not -1**, unlike a list's: a strip says what is shown beneath it, and
    // "nothing is shown" is not a state a tab strip can be in. A strip with no tabs is the one
    // exception, and an application with no tabs should not be building one.
    selected: int
    // The width of every tab. **One number, used by both the widget and the hit test**, which is
    // what keeps a click landing on the tab it looks like it landed on: tabs measured to fit their
    // own labels would need the font metrics in `tabs_input` as well, and a layout computed twice
    // is a layout that can disagree with itself. A caller wanting a snug strip sets this to fit
    // the longest label.
    tab_width: float
    disabled: bool
}

pub fn tabs_of(name: string, label: string, items: [string]) -> Tabs {
    return Tabs {
        name: name,
        label: label,
        items: items,
        selected: 0,
        tab_width: 100.0,
        disabled: false
    }
}

pub struct TabStep {
    tabs: Tabs
    // The selection changed, so what is beneath the strip has to change with it.
    moved: bool
}

// What an input does to a tab strip.
//
// `bounds` is the box the layout gave the strip, which turns a press's x into a tab -- the same
// trick `list_input` plays with y and `row_height`, and sound for the same reason: the widget lays
// every tab out at `tab_width` from the strip's left edge, so the arithmetic here is the layout's
// own and not a guess at it.
//
// **A press selects, where a button fires on the release.** Dragging off a tab and letting go still
// leaves it chosen, which is what every tab strip does and what a list does here: a tab is a place
// to be rather than an action to commit to, so there is nothing to cancel.
pub fn tabs_input(t: Tabs, input: Input, bounds: Rect) -> TabStep {
    if t.disabled {
        return tabs_still(t)
    }
    return switch input {
        Press(p) {
            val at = floor((p.x - bounds.x) / t.tab_width)
            if at < 0 || at >= len(t.items) {
                tabs_still(t)
            } else {
                tabs_to(t, at)
            }
        }
        KeyDown(k) { tabs_key(t, k) }
        KeyUp(_) { tabs_still(t) }
        Text(_) { tabs_still(t) }
        Paste(_) { tabs_still(t) }
        Release(_) { tabs_still(t) }
        Move(_) { tabs_still(t) }
        // **A wheel over a tab strip does nothing.** Some toolkits cycle the tabs with it; the
        // result is a user scrolling a page and changing what the page is.
        Wheel(_) { tabs_still(t) }
    }
}

fn tabs_key(t: Tabs, k: Keystroke) -> TabStep {
    val last = len(t.items) - 1
    if last < 0 {
        return tabs_still(t)
    }
    if Key.is_Right(k.key) { return tabs_to(t, t.selected + 1) }
    if Key.is_Left(k.key) { return tabs_to(t, t.selected - 1) }
    if Key.is_Home(k.key) { return tabs_to(t, 0) }
    if Key.is_End(k.key) { return tabs_to(t, last) }
    return tabs_still(t)
}

// Clamped rather than wrapped, as the list's arrows are. The end of a strip is a place a user can
// feel, and a Right that jumped back to the first tab takes that away to save one keystroke.
fn tabs_to(t: Tabs, want: int) -> TabStep {
    val last = len(t.items) - 1
    val at = if want < 0 { 0 } else { if want > last { last } else { want } }
    return TabStep { tabs: with t { selected: at }, moved: at != t.selected }
}

fn tabs_still(t: Tabs) -> TabStep {
    return TabStep { tabs: t, moved: false }
}

// The strip as a widget: a `TabList` control holding one `Tab` part per label.
//
// The parts carry `selected`, as a list's rows do, because that is what a reader reads -- "tab,
// History, selected" -- and an index on the container would make every adapter work out for itself
// which child the number meant.
pub fn tabs_widget(t: Tabs, style: Style) -> widget.Widget {
    val ink = if t.disabled { style.disabled_ink } else { style.ink }
    val cells = mutable_array_new<widget.Widget>()
    var i = 0
    while i < len(t.items) {
        val chosen = i == t.selected
        val face = if chosen { style.pressed_face } else { style.face }
        val cell = widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Row,
            spacing: 0.0,
            padding: style.padding,
            background: Option<Color>.Some(face),
            children: [widget.label_of(t.items[i], style.text_size, ink)],
            name: ""
        })
        push(cells, widget.fixed_of(
            t.tab_width,
            0.0,
            widget.part_of(
                tab_name(t, i),
                widget.Role.Tab,
                t.items[i],
                with widget.no_state() { selected: chosen, disabled: t.disabled },
                cell
            )
        ))
        i = i + 1
    }
    return widget.Widget.Control(widget.Focusable {
        name: t.name,
        role: widget.Role.TabList,
        label: t.label,
        description: "",
        value: "",
        state: with widget.no_state() { disabled: t.disabled },
        tab_stop: true,
        // **No spacing between the tabs**, because the hit test divides the strip by `tab_width`
        // and a gap would put a dead stripe between two tabs that the arithmetic here cannot see.
        child: widget.row_of(0.0, snapshot(cells))
    })
}

// A tab's name, which focus and accessibility both address it by. The strip's name and the index,
// as a list's rows are: a tab has no name of its own and a bare index would collide with another
// strip's.
pub fn tab_name(t: Tabs, index: int) -> string {
    return concat(t.name, "/", str(index))
}

// -------------------------------------------------------------------- the tree

// A row of a tree, as the application hands it over.
//
// **Flat with a depth, not nested.** A nested structure would have to be walked to draw, walked to
// hit-test and walked again to move the selection, and every one of those walks is the same
// projection -- the rows in order, with the ones under a closed branch left out. Doing it once, as
// a list, is what lets the rest of this control be the list's code with an indent.
pub struct TreeRow {
    label: string
    // How deep, 0 at the top.
    depth: int
    // Whether it can be opened. **Declared rather than worked out from the next row's depth**,
    // because a branch with nothing in it yet is still a branch: a tree that inferred this would
    // draw an empty folder as a leaf, and a user would have no way to see that it is empty rather
    // than missing.
    expandable: bool
    expanded: bool
}

pub fn tree_row(label: string, depth: int) -> TreeRow {
    return TreeRow { label: label, depth: depth, expandable: false, expanded: false }
}

pub fn tree_branch(label: string, depth: int, expanded: bool) -> TreeRow {
    return TreeRow { label: label, depth: depth, expandable: true, expanded: expanded }
}

// A tree: rows at depths, branches that open and close, one selected.
//
// **One tab stop and a node per visible row**, which is `List`'s bargain again. Not a `List` with
// a depth, though: the arrows mean different things here -- Left closes a branch or climbs to its
// parent, Right opens one or steps into it -- and that contract is the difference between a tree
// and an indented list.
pub struct Tree {
    name: string
    label: string
    rows: [TreeRow]
    // The selected row, **as an index into `rows` and not into the visible ones**. Collapsing a
    // branch must not silently move the selection onto a different thing, and an index into a
    // projection does exactly that.
    selected: int
    offset: float
    row_height: float
    // How far one level indents, and the width of the mark a branch draws -- one number, because
    // the press that toggles a branch has to find the mark where the widget drew it. The hit test
    // and the layout each compute it from this, as the tab strip's `tab_width` is shared.
    indent: float
    // The drag state of the bar down its right edge. **Only the drag**: where the thumb sits
    // comes from `offset` and the row count, which this already has, and a second copy of either
    // is a second thing to keep in step.
    bar: ScrollBar
    disabled: bool
}

pub fn tree_of(name: string, label: string, rows: [TreeRow]) -> Tree {
    return Tree {
        name: name,
        label: label,
        rows: rows,
        selected: if len(rows) == 0 { 0 - 1 } else { 0 },
        offset: 0.0,
        row_height: 20.0,
        indent: 16.0,
        bar: scroll_bar_of(concat(name, "/bar"), 20.0),
        disabled: false
    }
}

// The rows that are on screen, in order, as indices into `rows`: everything except what sits under
// a closed branch. **One pass, not a visibility test per row** -- the test is "is any ancestor
// closed", and walking back up from each row to answer it is the same walk done n times.
pub fn visible_rows(t: Tree) -> [int] {
    val out = mutable_array_new<int>()
    // The depth of the closed branch currently hiding things, or -1.
    var hidden_under = 0 - 1
    var i = 0
    while i < len(t.rows) {
        val row = t.rows[i]
        if hidden_under >= 0 && row.depth > hidden_under {
            i = i + 1
        } else {
            hidden_under = 0 - 1
            push(out, i)
            if row.expandable && !row.expanded {
                hidden_under = row.depth
            }
            i = i + 1
        }
    }
    return snapshot(out)
}

pub struct TreeStep {
    tree: Tree
    // The selection changed.
    moved: bool
    // A row was chosen -- Enter or Space on it. A branch opening is not a choice.
    activated: bool
    // A branch was opened or closed, which is a different thing from either: what is on screen
    // changed and the selection did not.
    toggled: bool
}

// What an input does to a tree.
//
// `bounds` turns a press into a row the way the list does, and into a *column* besides: a press on
// the mark at the left of a branch opens or closes it, and a press anywhere else on the row selects
// it. Both computed from `indent`, which the widget also lays out by.
pub fn tree_input(t: Tree, input: Input, bounds: Rect) -> TreeStep {
    if t.disabled {
        return tree_still(t)
    }
    // **The bar first, and a drag in progress before anything else.** A press that took hold of
    // the thumb moved the focus to the tree, so the moves and the release that follow are routed
    // here -- and they have to reach the bar wherever the pointer has wandered to, or a thumb
    // dragged off the strip is left holding on while the rows move under the pointer instead.
    if dragging_bar(t) || for_the_bar(t, input, bounds) {
        return bar_step(t, input, bounds)
    }
    return switch input {
        Wheel(w) { tree_scrolled(t, t.offset - (w.vertical as float) * t.row_height, bounds) }
        Press(p) { tree_pressed(t, p, bounds) }
        KeyDown(k) { tree_key(t, k, bounds) }
        KeyUp(_) { tree_still(t) }
        Text(_) { tree_still(t) }
        Paste(_) { tree_still(t) }
        Release(_) { tree_still(t) }
        Move(_) { tree_still(t) }
    }
}

fn dragging_bar(t: Tree) -> bool {
    return Option.is_Some(t.bar.grabbed)
}

// Only a press decides: a wheel over the strip should scroll the tree the ordinary way, and a key
// is aimed at nothing in particular.
fn for_the_bar(t: Tree, input: Input, bounds: Rect) -> bool {
    if Press(p) = input {
        return on_the_bar(bounds, p, tree_content(t), bounds.height)
    }
    return false
}

fn tree_content(t: Tree) -> float {
    return (len(visible_rows(t)) as float) * t.row_height
}

fn bar_step(t: Tree, input: Input, bounds: Rect) -> TreeStep {
    val taken = scroll_bar_input(t.bar, input, bar_box(bounds), tree_content(t), bounds.height, t.offset)
    return TreeStep {
        tree: with t { bar: taken.bar, offset: taken.offset },
        // **A bar moves the view, never the selection.** Dragging a scrollbar in any list on any
        // platform leaves the highlighted row where it was, and moving it here would make a drag
        // a destructive gesture in a tree whose selection loads a request.
        moved: false,
        activated: false,
        toggled: false
    }
}

// The strip the bar lives in, which is where `paint_scroll_bars` draws it.
fn bar_box(bounds: Rect) -> Rect {
    return geom.rect_of(
        bounds.x + bounds.width - bar_thickness,
        bounds.y,
        bar_thickness,
        bounds.height
    )
}

fn tree_pressed(t: Tree, p: Point, bounds: Rect) -> TreeStep {
    val shown = visible_rows(t)
    val at = floor((p.y - bounds.y + t.offset) / t.row_height)
    if at < 0 || at >= len(shown) {
        return tree_still(t)
    }
    val which = shown[at]
    val row = t.rows[which]
    // The mark sits in the one indent-wide column at this row's own depth.
    val mark_from = bounds.x + (row.depth as float) * t.indent
    if row.expandable && p.x >= mark_from && p.x < mark_from + t.indent {
        return tree_toggled(t, which)
    }
    return TreeStep {
        tree: with t { selected: which },
        moved: which != t.selected,
        activated: false,
        toggled: false
    }
}

fn tree_key(t: Tree, k: Keystroke, bounds: Rect) -> TreeStep {
    val shown = visible_rows(t)
    if len(shown) == 0 {
        return tree_still(t)
    }
    val per_page = tree_page_rows(t, bounds)
    val here = shown_index_of(shown, t.selected)
    if Key.is_Down(k.key) { return tree_to(t, shown, here + 1, bounds) }
    if Key.is_Up(k.key) { return tree_to(t, shown, here - 1, bounds) }
    if Key.is_PageDown(k.key) { return tree_to(t, shown, here + per_page, bounds) }
    if Key.is_PageUp(k.key) { return tree_to(t, shown, here - per_page, bounds) }
    if Key.is_Home(k.key) { return tree_to(t, shown, 0, bounds) }
    if Key.is_End(k.key) { return tree_to(t, shown, len(shown) - 1, bounds) }
    // **Right opens a branch, and opens it only once**: on a branch already open it steps to the
    // first child, which is what every tree does and what makes Right-Right-Right walk downwards
    // rather than stopping on the first folder.
    if Key.is_Right(k.key) {
        if t.selected >= 0 && t.selected < len(t.rows) {
            val row = t.rows[t.selected]
            if row.expandable && !row.expanded {
                return tree_toggled(t, t.selected)
            }
            if row.expandable && row.expanded {
                return tree_to(t, shown, here + 1, bounds)
            }
        }
        return tree_still(t)
    }
    // **Left closes a branch, and from a leaf climbs to the parent**, which is the move that makes
    // a deep tree navigable: without it the only way out of a folder is Up past every sibling.
    if Key.is_Left(k.key) {
        if t.selected >= 0 && t.selected < len(t.rows) {
            val row = t.rows[t.selected]
            if row.expandable && row.expanded {
                return tree_toggled(t, t.selected)
            }
            val up = parent_of(t, t.selected)
            if up >= 0 {
                return tree_to(t, shown, shown_index_of(shown, up), bounds)
            }
        }
        return tree_still(t)
    }
    if Key.is_Enter(k.key) || Key.is_Space(k.key) {
        if t.selected >= 0 {
            return TreeStep { tree: t, moved: false, activated: true, toggled: false }
        }
    }
    return tree_still(t)
}

// The row this one hangs under: the nearest earlier row one level shallower. -1 at the top.
pub fn parent_of(t: Tree, index: int) -> int {
    if index < 0 || index >= len(t.rows) {
        return 0 - 1
    }
    val want = t.rows[index].depth - 1
    if want < 0 {
        return 0 - 1
    }
    var at = index - 1
    while at >= 0 {
        if t.rows[at].depth == want {
            return at
        }
        at = at - 1
    }
    return 0 - 1
}

// Where the selection sits among the visible rows, or 0 when it is not visible at all -- which can
// happen only if a caller collapsed a branch over it, and landing on the top is better than
// answering -1 and having every arrow key do nothing.
fn shown_index_of(shown: [int], selected: int) -> int {
    var i = 0
    while i < len(shown) {
        if shown[i] == selected {
            return i
        }
        i = i + 1
    }
    return 0
}

fn tree_to(t: Tree, shown: [int], want: int, bounds: Rect) -> TreeStep {
    val last = len(shown) - 1
    val at = if want < 0 { 0 } else { if want > last { last } else { want } }
    val which = shown[at]
    val revealed = widget.clamp_offset(
        widget.scroll_to_reveal(bounds.height, t.offset, (at as float) * t.row_height, t.row_height),
        bounds.height,
        (len(shown) as float) * t.row_height
    )
    return TreeStep {
        tree: with t { selected: which, offset: revealed },
        moved: which != t.selected,
        activated: false,
        toggled: false
    }
}

// Opening or closing one branch. **The selection does not move** -- a user who opened a folder is
// still on the folder, and a tree that jumped into it would make Right-then-Left not a round trip.
fn tree_toggled(t: Tree, index: int) -> TreeStep {
    val rows = mutable_array_new<TreeRow>()
    var i = 0
    while i < len(t.rows) {
        val row = t.rows[i]
        push(rows, if i == index { with row { expanded: !row.expanded } } else { row })
        i = i + 1
    }
    return TreeStep {
        tree: with t { rows: snapshot(rows), selected: index },
        moved: index != t.selected,
        activated: false,
        toggled: true
    }
}

fn tree_page_rows(t: Tree, bounds: Rect) -> int {
    val fits = floor(bounds.height / t.row_height)
    return if fits < 1 { 1 } else { fits }
}

fn tree_scrolled(t: Tree, want: float, bounds: Rect) -> TreeStep {
    val content = (len(visible_rows(t)) as float) * t.row_height
    return TreeStep {
        tree: with t { offset: widget.clamp_offset(want, bounds.height, content) },
        moved: false,
        activated: false,
        toggled: false
    }
}

fn tree_still(t: Tree) -> TreeStep {
    return TreeStep { tree: t, moved: false, activated: false, toggled: false }
}

// The tree as a widget: a `Tree` control over one `TreeItem` part per visible row.
//
// **The parts nest, though the rows are flat and the layout is a plain column.** A reader asks a
// node for its children, so a branch whose rows were siblings of it would tell a user that seven
// things exist and nothing about which is inside which -- an indented list again, from the one
// side that cannot see the indent. The first version of this did exactly that and the AT-SPI dump
// showed it: seven tree items in a row under the tree.
//
// Nesting costs nothing in layout, because a part adds no box of its own and the rows keep their
// absolute indent: a column of columns of fixed-height rows stacks exactly as one column of them
// does, which is what keeps the hit test's `y / row_height` true.
pub fn tree_widget(t: Tree, style: Style) -> widget.Widget {
    val shown = visible_rows(t)
    val built = tree_level(t, shown, 0, 0, style)
    return widget.Widget.Control(widget.Focusable {
        name: t.name,
        role: widget.Role.Tree,
        label: t.label,
        description: "",
        value: "",
        state: with widget.no_state() { disabled: t.disabled },
        tab_stop: true,
        child: widget.named_scroll("", 0.0, t.offset, widget.column_of(0.0, built.rows))
    })
}

// The widgets for one level, and the index after them. A struct because the walk has to answer
// both and this language has no tuples.
struct TreeLevel {
    rows: [widget.Widget]
    next: int
}

fn tree_level(t: Tree, shown: [int], from: int, depth: int, style: Style) -> TreeLevel {
    val out = mutable_array_new<widget.Widget>()
    var i = from
    while i < len(shown) && t.rows[shown[i]].depth >= depth {
        val which = shown[i]
        val row = t.rows[which]
        // **Children are taken relative to this row's own depth, not the level it was met at.**
        // The two differ whenever a tree's rows skip a level -- rows that all sit at depth 1, or
        // a depth-2 row under a depth-0 one -- and the first version of this walk guarded that
        // case by *advancing past the row*, so a tree whose rows never reached depth 0 drew
        // nothing at all. Every sidebar built here starts at 0, which is why no test and no
        // screenshot showed it; a profiler reporting that a layout benchmark had no work to do
        // is what showed it.
        val kids = tree_level(t, shown, i + 1, row.depth + 1, style)
        i = kids.next
        val own = tree_row_box(t, which, row, style)
        val inside = if len(kids.rows) == 0 {
            own
        } else {
            widget.column_of(0.0, concat([own], kids.rows))
        }
        push(out, widget.part_of(
            tree_row_name(t, which),
            widget.Role.TreeItem,
            row.label,
            with widget.no_state() {
                selected: which == t.selected,
                disabled: t.disabled,
                // **Declared only for a branch.** `Some(false)` on a leaf publishes EXPANDABLE,
                // and a reader would offer to open a thing that cannot be opened.
                expanded: if row.expandable {
                    Option<bool>.Some(row.expanded)
                } else {
                    Option<bool>.None
                }
            },
            inside
        ))
    }
    return TreeLevel { rows: snapshot(out), next: i }
}

// One row: its indent, the mark a branch draws, and its label. **The indent is absolute rather
// than one level per nesting**, so the column the hit test computes from `depth * indent` is the
// column the mark was drawn in whatever the parts do around it.
fn tree_row_box(t: Tree, which: int, row: TreeRow, style: Style) -> widget.Widget {
    val ink = if t.disabled { style.disabled_ink } else { style.ink }
    val face = if which == t.selected { style.pressed_face } else { style.face }
    val mark = if row.expandable {
        if row.expanded { style.expanded_mark } else { style.collapsed_mark }
    } else {
        ""
    }
    return widget.fixed_of(0.0, t.row_height, widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.insets_of(0.0, 2.0, 4.0, 2.0),
        background: Option<Color>.Some(face),
        children: [
            widget.fixed_of((row.depth as float) * t.indent, 0.0, widget.flex()),
            widget.fixed_of(t.indent, 0.0, widget.label_of(mark, style.text_size, ink)),
            widget.label_of(row.label, style.text_size, ink)
        ],
        name: ""
    }))
}

// A row's name. The tree's name and the index **into `rows`, not into the visible ones**, so that
// opening a branch above a row does not rename it.
pub fn tree_row_name(t: Tree, index: int) -> string {
    return concat(t.name, "/", str(index))
}

// -------------------------------------------------------------- the scroll bar

// Where a scrolled view is, and how much of it there is, drawn beside what it scrolls.
//
// **A view of someone else's offset, not the owner of one.** The offset lives in the control that
// scrolls -- a `List`, a `Tree`, an `Entry` -- and a bar keeping a second copy is two numbers that
// can disagree about one thing. So this holds only what a bar has that nothing else does: whether
// a drag is in progress and where the thumb was taken hold of. Everything else is passed in and
// handed back.
//
// **Beside what it scrolls, never over it.** An overlaid bar is inside the scrolled control's own
// box, so a press on the bar is a press the control reads as a row -- and the control would have
// to know the bar's width to tell them apart, which is the bar's geometry computed in two places.
// Laid out as a sibling, the two boxes do not overlap and neither has to know about the other.
//
// **Not a tab stop.** Every platform agrees: the content takes the focus and its arrows scroll it,
// so a scrollbar in the tab order is a stop that does nothing a keyboard user needs. It is also
// why this control publishes no value -- a reader walks the rows, which this layer publishes
// whether they are scrolled into view or not, so the bar is an affordance for the eye and the one
// reader who needs it is the one who cannot see.
pub struct ScrollBar {
    name: string
    // Where in the thumb the pointer took hold, measured from the thumb's start, or `None` when
    // nothing is being dragged.
    grabbed: Option<float>
    // What one notch of the wheel moves. **Given rather than guessed**, because the only sensible
    // amount is a row of whatever is being scrolled and this control cannot know what that is.
    step: float
    disabled: bool
}

pub fn scroll_bar_of(name: string, step: float) -> ScrollBar {
    return ScrollBar { name: name, grabbed: Option<float>.None, step: step, disabled: false }
}

// How tall the thumb is and where it starts, inside a track of `track` points.
//
// **One function, used by the widget and by every gesture**, which is the rule this layer keeps
// learning: a thumb drawn by one calculation and dragged by another is a thumb that jumps under
// the pointer. `length` is the view's share of the content, floored at `min_thumb` so that a very
// long list still leaves something to take hold of; `start` is the offset's share of the overhang,
// spread over the track that is left.
pub struct Thumb {
    start: float
    length: float
}

// The shortest a thumb may be drawn. Below about this there is nothing to aim at with a pointer.
pub val min_thumb = 20.0

// How wide a bar is, **as one number shared by everything that draws or touches one**. The
// painter lays the track out from it and a scrolled control decides from it whether a press was
// meant for the bar or for a row; two numbers here would be a bar you can see in one place and
// grab in another, which is the failure this module keeps designing against.
pub val bar_thickness = 8.0

pub fn thumb_of(track: float, content: float, view: float, offset: float) -> Thumb {
    if content <= view || track <= 0.0 {
        return Thumb { start: 0.0, length: track }
    }
    val share = track * view / content
    val length = if share < min_thumb {
        if min_thumb > track { track } else { min_thumb }
    } else {
        share
    }
    val overhang = content - view
    val room = track - length
    val at = if overhang <= 0.0 || room <= 0.0 { 0.0 } else { room * offset / overhang }
    return Thumb { start: at, length: length }
}

// Whether a point is in the strip a bar is drawn in, down the inside of a box's right edge.
//
// **Over the content, not beside it**, which is what overlay bars do everywhere and what keeps
// this from being a layout change: a gutter reserved in a control's own box would have to be
// reserved by the control, measured by the painter and subtracted by the hit test, and the three
// would be three chances to disagree about one number. What it costs is the last few points of a
// row, which on a list of text is the empty end of a line.
pub fn on_the_bar(bounds: Rect, p: Point, content: float, view: float) -> bool {
    if !scrolls(content, view) {
        return false
    }
    return p.x >= bounds.x + bounds.width - bar_thickness
}

// Whether there is anything to scroll. An application asks before placing a bar at all; a bar with
// nothing to do draws an empty track rather than vanishing, so the layout does not move when a
// list grows past its box.
pub fn scrolls(content: float, view: float) -> bool {
    return content > view
}

pub struct ScrollBarStep {
    bar: ScrollBar
    // The offset the scrolled control should take. Handed back rather than stored, because the
    // control owns it.
    offset: float
    moved: bool
}

// What an input does to a bar, given the numbers whose owner is elsewhere.
//
// A press on the thumb takes hold of it; a press on the track above or below pages towards the
// pointer by a viewful, which is what a track click does everywhere; a move while held drags; a
// release lets go. A wheel scrolls by `step`.
pub fn scroll_bar_input(
    b: ScrollBar,
    input: Input,
    bounds: Rect,
    content: float,
    view: float,
    offset: float
) -> ScrollBarStep {
    if b.disabled {
        return bar_still(b, offset)
    }
    val thumb = thumb_of(bounds.height, content, view, offset)
    return switch input {
        Press(p) {
            if !widget.contains(bounds, p) {
                bar_still(b, offset)
            } else {
                val from = p.y - bounds.y
                if from < thumb.start {
                    bar_to(b, offset - view, view, content, offset)
                } else {
                    if from >= thumb.start + thumb.length {
                        bar_to(b, offset + view, view, content, offset)
                    } else {
                        ScrollBarStep {
                            bar: with b { grabbed: Option<float>.Some(from - thumb.start) },
                            offset: offset,
                            moved: false
                        }
                    }
                }
            }
        }
        Move(p) {
            switch b.grabbed {
                Some(held) {
                    val room = bounds.height - thumb.length
                    val overhang = content - view
                    if room <= 0.0 || overhang <= 0.0 {
                        bar_still(b, offset)
                    } else {
                        bar_to(b, (p.y - bounds.y - held) * overhang / room, view, content, offset)
                    }
                }
                None { bar_still(b, offset) }
            }
        }
        // **A release lets go wherever it happens**, as a button's does: a drag that ended off the
        // bar is still a drag that ended, and a thumb left holding on would follow the pointer
        // around the window.
        Release(_) { ScrollBarStep { bar: with b { grabbed: Option<float>.None }, offset: offset, moved: false } }
        Wheel(w) { bar_to(b, offset - (w.vertical as float) * b.step, view, content, offset) }
        KeyDown(_) { bar_still(b, offset) }
        KeyUp(_) { bar_still(b, offset) }
        Text(_) { bar_still(b, offset) }
        Paste(_) { bar_still(b, offset) }
    }
}

fn bar_to(b: ScrollBar, want: float, view: float, content: float, was: float) -> ScrollBarStep {
    val at = widget.clamp_offset(want, view, content)
    return ScrollBarStep { bar: b, offset: at, moved: at != was }
}

fn bar_still(b: ScrollBar, offset: float) -> ScrollBarStep {
    return ScrollBarStep { bar: b, offset: offset, moved: false }
}

// The bar as a widget: a track with the thumb inside it.
//
// The thumb is a fixed box above a flexible one, which is what places it without arithmetic the
// hit test would have to repeat -- the space above the thumb is `thumb_of`'s `start`, drawn as a
// gap, so the layout and `scroll_bar_input` are reading the one calculation.
pub fn scroll_bar_widget(
    b: ScrollBar,
    style: Style,
    width: float,
    track: float,
    content: float,
    view: float,
    offset: float
) -> widget.Widget {
    val thumb = thumb_of(track, content, view, offset)
    val face = if b.disabled { style.disabled_ink } else { style.ink }
    val parts = mutable_array_new<widget.Widget>()
    push(parts, widget.fixed_of(0.0, thumb.start, widget.flex()))
    if scrolls(content, view) {
        push(parts, widget.fixed_of(0.0, thumb.length, widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Column,
            spacing: 0.0,
            padding: widget.insets_of(2.0, 0.0, 2.0, 0.0),
            background: Option<Color>.Some(face),
            children: [],
            name: thumb_name
        })))
    }
    push(parts, widget.expand(widget.flex()))
    return widget.Widget.Control(widget.Focusable {
        name: b.name,
        role: widget.Role.ScrollBar,
        label: "",
        description: "",
        value: "",
        state: with widget.no_state() { disabled: b.disabled },
        // See the type's own note: the content takes the focus, and a stop here would do nothing.
        tab_stop: false,
        child: widget.fixed_of(width, track, widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Column,
            spacing: 0.0,
            padding: widget.no_insets(),
            background: Option<Color>.Some(style.face),
            children: snapshot(parts),
            name: ""
        }))
    })
}

// The name the thumb's box carries in the laid-out tree, so a test can find it.
pub val thumb_name = "thumb"

// Every viewport in a laid-out tree gets a bar, painted over the scene that is already there.
//
// **A pass over the laid tree, not a widget**, and that is the whole answer to the question F284
// could not settle: a thumb's length is the view's share of the content, and nothing knows the
// view extent until the layout has run. Measuring that by laying the window out twice costs 5 ms
// a frame at 200 rows. Here the number is simply there -- a viewport's own box is the view, the
// box its child was placed in is the content, and `Viewport.offset_y` is where it sits. This is
// the seam `widget.paint_focused` already uses for the focus ring, which could not be known at
// widget-build time either.
//
// **An indicator, not a control.** It says there is more and where you are; the wheel and the
// arrows are what move it. Dragging needs the bar to have a box of its own that a press can be
// routed to, which means the scrolled control reserving a gutter in its own layout -- a different
// change, with `scroll_bar_input` already written and tested for when it happens.
//
// Drawn **inside** the viewport's right edge, which is where an overlay bar goes and why it is
// translucent: a few points of the content are behind it, and over a list of text that is the
// trailing end of a line nobody reads.
pub fn paint_scroll_bars(l: Laid, over: scene.Scene, style: Style) -> scene.Scene {
    val ops = mutable_array_new<scene.Op>()
    for op in over.ops {
        push(ops, op)
    }
    collect_bars(l, style, ops)
    return scene.with_ops(over, snapshot(ops))
}

fn collect_bars(l: Laid, style: Style, ops: MutableArray<scene.Op>) {
    if Scroll(it) = l.widget {
        if len(l.children) > 0 {
            val view = l.bounds.height
            val content = l.children[0].bounds.height
            if scrolls(content, view) {
                val thumb = thumb_of(view, content, view, it.offset_y)
                val x = l.bounds.x + l.bounds.width - bar_thickness
                push(ops, scene.fill(
                    shape.rect_path(geom.rect_of(x, l.bounds.y, bar_thickness, view)),
                    paint.Paint.Solid(style.face)
                ))
                push(ops, scene.fill(
                    shape.rect_path(geom.rect_of(
                        x + 1.0,
                        l.bounds.y + thumb.start,
                        bar_thickness - 2.0,
                        thumb.length
                    )),
                    paint.Paint.Solid(style.disabled_ink)
                ))
            }
        }
    }
    for child in l.children {
        collect_bars(child, style, ops)
    }
}

// -------------------------------------------------------- menus and dialogs

// A title on a menu bar and the items that drop from it.
//
// **A menu is a title and a `List`**, not a new widget with its own selection and scrolling. The
// popup is a list of rows with one highlighted, scrolled when it is long, moved by the same arrows;
// the only honest difference is what a reader calls it, which is why `List.role` is a field.
pub struct Menu {
    name: string
    // What the collapsed control shows. For a menu it is the menu's name ("File"); for a choice it
    // is **not used** -- `collapsed_text` reads the selection instead, so the two cannot disagree.
    title: string
    // What a reader calls it. The same as `title` for a menu, and a fixed name for a choice, whose
    // title changes as the user picks: a control that introduced itself as its own current value
    // would announce "staging, combo box, staging".
    label: string
    items: List
    open: bool
    disabled: bool
    // `Menu` for a list of commands, `ComboBox` for a picker of values. One structure, because a
    // dropdown *is* a popup list with a collapsed title and building a second one would have been a
    // copy of the popup, the keyboard handling and the dismissal to change two role names.
    role: widget.Role
}

pub fn menu_of(name: string, title: string, items: [string]) -> Menu {
    val inner = with list_of(concat(name, "/items"), title, items) {
        role: widget.Role.Menu,
        item_role: widget.Role.MenuItem
    }
    return Menu {
        name: name,
        title: title,
        label: title,
        items: inner,
        open: false,
        disabled: false,
        role: widget.Role.Menu
    }
}

// A dropdown: pick one of `items`, showing the one picked.
//
// **The same control as a menu, announcing differently** -- a menu offers commands and this offers
// values, which a reader distinguishes and a user does too. `selected` is an index into `items`, or
// -1 for nothing chosen yet, in which case the collapsed control shows `label`.
//
// The chosen value is **read from the list's selection rather than stored**, so there is no second
// place for it to be wrong: `menu_input` moves the selection and the collapsed text follows.
pub fn choice_of(name: string, label: string, items: [string], selected: int) -> Menu {
    val inner = with list_of(concat(name, "/items"), label, items) {
        role: widget.Role.List,
        item_role: widget.Role.ListItem,
        selected: if selected < 0 || selected >= len(items) { 0 - 1 } else { selected }
    }
    return Menu {
        name: name,
        title: label,
        label: label,
        items: inner,
        open: false,
        disabled: false,
        role: widget.Role.ComboBox
    }
}

// What the collapsed control shows: the chosen value for a choice, the title for a menu.
pub fn collapsed_text(m: Menu) -> string {
    if !widget.Role.is_ComboBox(m.role) {
        return m.title
    }
    val at = m.items.selected
    if at < 0 || at >= len(m.items.items) {
        return m.label
    }
    return m.items.items[at]
}

// The value a choice is showing, or "" when nothing is chosen. A menu has none.
pub fn chosen_value(m: Menu) -> string {
    if !widget.Role.is_ComboBox(m.role) {
        return ""
    }
    val at = m.items.selected
    if at < 0 || at >= len(m.items.items) {
        return ""
    }
    return m.items.items[at]
}

pub struct MenuStep {
    menu: Menu
    // The item chosen, or -1. An output: the application acts on it and stores the menu.
    chosen: int
    // The menu closed without choosing -- Escape, or a click away from it. Separate from `chosen`,
    // because a caller that treated them alike would act on a dismissal.
    dismissed: bool
}

// What an input does to a menu.
//
// `title_bounds` is the box of the title on the bar and `popup_bounds` the box of the open popup,
// both needed because **a click's meaning depends on which of the two it is in** -- and on neither,
// which is a dismissal.
//
// The popup is not a child of the title, so this cannot find either box itself: `widget.layer_at`
// explains why an overlay lives in the root's layer list, and the caller that put it there is the
// one that knows where it went.
pub fn menu_input(m: Menu, input: Input, title_bounds: Rect, popup_bounds: Rect) -> MenuStep {
    if m.disabled {
        return menu_unchanged(m)
    }
    if !m.open {
        return closed_menu_input(m, input, title_bounds)
    }
    return open_menu_input(m, input, title_bounds, popup_bounds)
}

fn closed_menu_input(m: Menu, input: Input, title_bounds: Rect) -> MenuStep {
    return switch input {
        // A click on the title opens it. On the way *down*, not up: a menu bar opens on press, which
        // is what lets a user press and drag onto an item in one gesture.
        Press(p) {
            if widget.contains(title_bounds, p) {
                opened(m)
            } else {
                menu_unchanged(m)
            }
        }
        KeyDown(k) {
            if Key.is_Down(k.key) || Key.is_Enter(k.key) || Key.is_Space(k.key) {
                opened(m)
            } else {
                menu_unchanged(m)
            }
        }
        KeyUp(_) { menu_unchanged(m) }
        Text(_) { menu_unchanged(m) }
        Paste(_) { menu_unchanged(m) }
        Release(_) { menu_unchanged(m) }
        Move(_) { menu_unchanged(m) }
        Wheel(_) { menu_unchanged(m) }
    }
}

fn open_menu_input(m: Menu, input: Input, title_bounds: Rect, popup_bounds: Rect) -> MenuStep {
    // `Other("")` for an input that is not a keystroke, so the tests below read as one list rather
    // than as a key check wrapped in an input check.
    val pressed = switch input {
        KeyDown(k) { k.key }
        KeyUp(_) { Key.Other("") }
        Text(_) { Key.Other("") }
        Paste(_) { Key.Other("") }
        Press(_) { Key.Other("") }
        Release(_) { Key.Other("") }
        Move(_) { Key.Other("") }
        Wheel(_) { Key.Other("") }
    }
    // **Escape closes without choosing, and that is a dismissal rather than a choice of nothing.**
    if Key.is_Escape(pressed) {
        return dismissed_menu(m)
    }
    if Key.is_Enter(pressed) || Key.is_Space(pressed) {
        if m.items.selected >= 0 {
            return MenuStep { menu: with m { open: false }, chosen: m.items.selected, dismissed: false }
        }
        return dismissed_menu(m)
    }
    // **A click outside both boxes dismisses it**, which is what placed layers letting clicks
    // through is for: the click also reaches whatever was under it, and the menu closing is this
    // module's half of that.
    if Press(p) = input {
        if !widget.contains(popup_bounds, p) && !widget.contains(title_bounds, p) {
            return dismissed_menu(m)
        }
        // On the title again: a second press closes it, as every menu bar does.
        if widget.contains(title_bounds, p) {
            return dismissed_menu(m)
        }
    }
    // **A release over a row chooses it, which is what makes a menu usable with a mouse at all.**
    //
    // Until this, choosing was keyboard-only: a press on a row fell through to the list below and
    // moved the selection, and nothing ever turned that into a choice -- so a user could open a
    // menu, click an item, and watch the item highlight and the menu stay open. Found by a real
    // application rather than by a test, because every test here chose with Enter.
    //
    // **On the release rather than the press**, which makes both gestures work with one rule: a
    // menu-bar press-drag-release lands its release on the item it ended over, and an ordinary
    // click is a press and a release on the same row. It also means a press that opened the menu
    // cannot immediately choose, since that release lands on the title.
    if Release(p) = input {
        if widget.contains(popup_bounds, p) && m.items.selected >= 0 {
            return MenuStep { menu: with m { open: false }, chosen: m.items.selected, dismissed: false }
        }
    }
    // Everything else is the list's: arrows, Home, End, the wheel, and a press on a row.
    val step = list_input(m.items, input, popup_bounds)
    return MenuStep { menu: with m { items: step.list }, chosen: 0 - 1, dismissed: false }
}

fn opened(m: Menu) -> MenuStep {
    // Opens on the first item rather than on nothing, so the keyboard has somewhere to be.
    return MenuStep {
        menu: with m { open: true, items: with m.items { selected: if len(m.items.items) == 0 { 0 - 1 } else { 0 } } },
        chosen: 0 - 1,
        dismissed: false
    }
}

fn dismissed_menu(m: Menu) -> MenuStep {
    return MenuStep { menu: with m { open: false }, chosen: 0 - 1, dismissed: true }
}

fn menu_unchanged(m: Menu) -> MenuStep {
    return MenuStep { menu: m, chosen: 0 - 1, dismissed: false }
}

// The title as it sits on the bar. A control in its own right, so Tab reaches the menu and a reader
// announces it.
pub fn menu_title_widget(m: Menu, style: Style) -> widget.Widget {
    val ink = if m.disabled { style.disabled_ink } else { style.ink }
    val face = if m.open { style.pressed_face } else { style.face }
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: style.padding,
        background: Option<Color>.Some(face),
        children: [widget.label_of(collapsed_text(m), style.text_size, ink)],
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: m.name,
        role: m.role,
        label: m.label,
        description: "",
        // **A choice announces its value and a menu has none to announce.** This is the whole
        // behavioural difference between the two once the role is right: a reader says the label,
        // then what it is, then what it holds.
        value: chosen_value(m),
        state: with widget.no_state() {
            disabled: m.disabled,
            expanded: Option<bool>.Some(m.open)
        },
        tab_stop: true,
        child: inside
    })
}

// The open popup, as a layer for the **root's** layer list.
//
// `at` is where the caller decided it goes, from the title's laid bounds -- see `widget.layer_at`
// for why it cannot be a child of the title. A placed layer, so a click away from it falls through
// to what is beneath as well as closing the menu.
//
// Takes the keyboard while it is open, because an open menu owns the arrows.
pub fn menu_popup_layer(m: Menu, style: Style, at: Rect) -> widget.Layer {
    return widget.layer_at(at, true, list_widget(m.items, style))
}

// ------------------------------------------------------------------ dialogs

// What a dialog's keys mean. Returned rather than acted on, for the reason everything here is: this
// module cannot close a window or save a record.
pub enum DialogAnswer {
    Confirm
    Cancel
    Nothing
}

// **Escape cancels and Enter confirms**, which are the two keys a dialog owes a user who never
// reaches for the mouse. Everything else belongs to whatever is inside it.
//
// Enter is deliberately not "the focused button": a dialog's default action is the dialog's, not the
// focus's, or tabbing to Cancel and pressing Enter would confirm.
pub fn dialog_keys(input: Input) -> DialogAnswer {
    if KeyDown(k) = input {
        if Key.is_Escape(k.key) {
            return DialogAnswer.Cancel
        }
        if Key.is_Enter(k.key) {
            return DialogAnswer.Confirm
        }
    }
    return DialogAnswer.Nothing
}

// A modal layer holding `content` under a title.
//
// **Modal, so the geometry shuts the pointer out and `takes_keys` shuts Tab out** -- a click beside
// the dialog lands on the layer, finds no control, and goes nowhere, and the tab order holds only
// what is inside. `widget.modal_layer` is where both of those are explained.
//
// The content is the caller's: a dialog is a frame and a pair of keys, not a thing that knows what
// it is asking.
pub fn dialog_layer(name: string, title: string, content: widget.Widget, style: Style) -> widget.Layer {
    val framed = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: style.text_size * 0.5,
        padding: style.padding,
        background: Option<Color>.Some(style.face),
        children: [widget.label_of(title, style.text_size, style.ink), content],
        name: ""
    })
    val titled = widget.Widget.Control(widget.Focusable {
        name: name,
        role: widget.Role.Dialog,
        label: title,
        description: "",
        value: "",
        state: widget.no_state(),
        tab_stop: false,
        child: framed
    })
    // Centred with flexible space, which the box model already does -- a dialog needs no absolute
    // positioning to sit in the middle of a window.
    //
    // **Over a scrim, which it did not have.** A modal layer took the keys and drew nothing, so a
    // dialog was text floating on top of the window it was blocking: nothing said which half was
    // live. Found by the first application to open one. The scrim is part of the dialog rather than
    // something a caller adds, because a dialog without one is not a thing worth being able to make.
    return widget.modal_layer(widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.no_insets(),
        background: Option<Color>.Some(style.scrim),
        children: [
            widget.flex(),
            widget.row_of(0.0, [widget.flex(), titled, widget.flex()]),
            widget.flex()
        ],
        name: "scrim"
    }))
}

// ------------------------------------------------------------------- the style

// How a control is drawn. Injected rather than global, for the reason `widget.Metrics` is: a module
// that reads a theme from somewhere cannot be tested against two themes, and an application with
// two panels cannot style them differently.
pub struct Style {
    text_size: float
    padding: Insets
    ink: Color
    face: Color
    pressed_face: Color
    disabled_ink: Color
    // Under the text being composed through an input method, and under the run of it the method
    // is converting right now. **Two, because they mean different things to the person typing**:
    // the first says "this is not committed yet" and the second says "this is the part your next
    // keystroke changes", and a field that drew them alike would lose the distinction a candidate
    // list is navigated by.
    composing_face: Color
    converting_face: Color
    // The marks a tree's branch draws when it is closed and when it is open.
    //
    // **In the style rather than written into the control**, because this layer is handed whatever
    // font bytes an application found and cannot know what is in them: a face without triangles
    // would draw two empty boxes and leave every folder looking identical. An application that
    // knows its font can put anything here, including `">"` and `"v"`.
    collapsed_mark: string
    expanded_mark: string
    // What covers the window behind a dialog. **Translucent rather than opaque**, because a modal
    // dialog should say "this is waiting for you" and not "the window is gone" -- a user needs to
    // see what they were doing to decide what to answer.
    scrim: Color
}

// A plain light style. **Not a theme and not a design** -- F277 says in as many words that pixel
// parity with a platform's widgets is not a goal, so this is a legible default and the thing an
// application replaces.
pub fn default_style() -> Style {
    return Style {
        text_size: 12.0,
        padding: widget.insets_of(8.0, 4.0, 8.0, 4.0),
        ink: paint.rgb(0.1, 0.1, 0.1),
        face: paint.rgb(0.9, 0.9, 0.9),
        pressed_face: paint.rgb(0.75, 0.75, 0.78),
        disabled_ink: paint.rgb(0.6, 0.6, 0.6),
        composing_face: paint.rgb(0.88, 0.91, 0.97),
        converting_face: paint.rgb(0.70, 0.78, 0.93),
        collapsed_mark: "▸",
        expanded_mark: "▾",
        scrim: paint.rgba(0.0, 0.0, 0.0, 0.35)
    }
}

// ------------------------------------------------------------------ the keys

fn is_space(k: Keystroke) -> bool {
    return Key.is_Space(k.key)
}

fn is_enter(k: Keystroke) -> bool {
    return Key.is_Enter(k.key)
}

// Whether this input could move a caret or change text -- what the next instalment's entry asks
// before handing an input to `edit`, and here rather than there because the answer is about `Input`.
pub fn is_text_input(input: Input) -> bool {
    return switch input {
        Text(_) { true }
        Paste(_) { true }
        KeyDown(_) { true }
        KeyUp(_) { false }
        Press(_) { false }
        Release(_) { false }
        Move(_) { false }
        Wheel(_) { false }
    }
}
