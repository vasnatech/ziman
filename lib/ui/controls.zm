// The widget set: what an input does to a control, and what a control looks like.
//
// docs/reviews/tasks/f269-f277.md F277, first instalment. `widget` builds and places a tree,
// `focus` says what a click lands on, `edit` is a text field's model and `a11y` describes all of it
// -- and none of them turns an event into a new state. That is this module, and the two controls
// here are the ones that need neither text editing nor scrolling, so the model is the subject and
// they are the proof of it.
//
// **The architecture is forced by the language, not chosen.** The usual widget set hands a widget a
// callback -- `on_click: fn()` -- which mutates the application's state. Ziman will not compile
// that: "a lambda cannot capture 'count' because it is a 'var' ... captures are by value, so the
// lambda and the enclosing function never share mutable state". So a control cannot act; it can
// only *answer*. Every update here takes a state and an input and returns a new state together with
// what happened, and the application keeps the state and acts on what happened. `focus.clicked`
// already had exactly that shape, so this is the existing grain of the thing rather than a new idea.
//
// **An application owns its controls' states; this module owns none.** There is no registry of
// widgets here and there cannot be one -- no shared mutable state exists to hold it -- so the
// application holds whatever its window needs, routes an input with `target`, and calls the update
// for the control that input was for.
use edit
use focus
use geom
use geom.Point
use geom.Rect
use math.floor
use paint
use paint.Color
use paint.Paint
use scene
use shape
use widget
use widget.Insets
use widget.Laid
use widget.Toggle
use widget.caret_name

// ----------------------------------------------------------------- the inputs

pub struct Wheel {
    at: Point
    // Lines, signed: positive is away from the user. The same convention `window.ScrollStep` uses,
    // because converting between two sign conventions is a bug waiting to be written.
    vertical: int
    horizontal: int
}

// A key, as this layer names it.
//
// **Named rather than numbered, and owned here rather than borrowed from a backend.** The first
// version of this took `window.KeyPress` -- a keysym and four flags -- on the argument that a third
// key vocabulary was worse than depending on a module whose types are plain data. That was right
// with one backend and wrong with four: a shared control set cannot import X11, so this is not a
// third copy, it is the one copy, and each backend converts into it.
//
// `Char` carries the character the key sits on unshifted, so a shortcut is `Char("c")` whether or
// not Shift is down -- which is what a program dispatching Ctrl-C wants. `Other` keeps a name the
// backend chose, so an unhandled key can be logged rather than silently dropped.
pub enum Key {
    Enter
    Backspace
    Delete
    Tab
    Escape
    Space
    Left
    Up
    Right
    Down
    PageUp
    PageDown
    Home
    End
    Char(string)
    Other(string)
}

// A key with the modifiers that were down with it.
pub struct Keystroke {
    key: Key
    shift: bool
    control: bool
    alt: bool
    meta: bool
}

// A keystroke with nothing held down.
pub fn keystroke_of(key: Key) -> Keystroke {
    return Keystroke { key: key, shift: false, control: false, alt: false, meta: false }
}

// The character a `Char` key sits on, or "" for every other key -- so a dispatch on a shortcut
// letter needs no nested pattern.
pub fn char_of(k: Key) -> string {
    return switch k {
        Char(c) { c }
        Other(_) { "" }
        Enter { "" }
        Backspace { "" }
        Delete { "" }
        Tab { "" }
        Escape { "" }
        Space { "" }
        Left { "" }
        Up { "" }
        Right { "" }
        Down { "" }
        PageUp { "" }
        PageDown { "" }
        Home { "" }
        End { "" }
    }
}

// One thing the user did.
pub enum Input {
    KeyDown(Keystroke)
    KeyUp(Keystroke)
    // The text the keyboard composed, which is a separate event from the key that composed it --
    // see `window.Event`, where the same split is explained at length.
    Text(string)
    // Text from the system clipboard, **handed in rather than read**: nothing in this module can
    // reach a clipboard, and F273 left owning an X11 selection as platform work beside
    // `native_window.c`. It is a separate variant from `Text` because the two differ in a way a
    // user feels -- a paste is one undo step whatever its length, where typing coalesces a run of
    // keystrokes into one.
    Paste(string)
    Press(Point)
    Release(Point)
    Move(Point)
    Wheel(Wheel)
}

// Which control an input is for: the name, or "" for nobody.
//
// **The three rules here are each one a home-grown toolkit gets wrong.**
//
// A key goes to the focus, which is the easy one.
//
// A press goes to whatever is under the pointer *and moves the focus there* -- `focus.clicked`
// already decides that, including leaving the focus alone when the press landed on nothing.
//
// **A release and a move go to whatever took the press** -- the pointer grab -- and to the focus
// only when no button is down. Routing them by position instead would never reach a button the
// user dragged off, and the button would stay drawn pressed for ever.
//
// **This used to route them to the focus alone, and that silently broke every control Tab cannot
// reach.** The reasoning was that a press moves the focus to the control being pressed, so the
// focus *is* what was pressed -- true only for a tab stop. A scroll bar is not one (`focus.clicked`
// leaves the focus where it was), so the bar took the press, set `grabbed`, and then every move
// went to some control elsewhere on screen: the thumb could be grabbed and not dragged, measured
// in the gallery as a thumb that stayed at pixel 126 through a 230-pixel drag. The split pane's
// divider is in the same position. Both are exactly the controls a pointer works and a keyboard
// does not, which is the set this rule was least able to serve.
//
// `pressed` is the name this function last answered for a `Press`, which the application holds
// between frames -- `pressed_after` is the one-liner that maintains it.
//
// **A wheel goes to the control under the pointer and ignores the focus entirely**, because that is
// what a user means: scrolling the list they are pointing at, not the one that happens to have the
// keyboard. Over nothing it goes nowhere rather than to the focus.
//
// **To the nearest *tab stop* under the pointer, not the innermost control**, which is the same
// resolution a press gets and for the same reason. `focus.control_at` answers a list's row or a
// tree's item -- a `part_of`, something a click and a reader can reach and that no application
// holds a state for -- so a wheel routed that way named a control nobody could handle and was
// dropped on the floor. **The wheel had never scrolled a list or a tree in any application.**
// Found by painting a scroll bar: the indicator sat still while the window said it should move.
pub fn target(l: Laid, input: Input, focused: string, pressed: string) -> string {
    return switch input {
        KeyDown(_) { focused }
        KeyUp(_) { focused }
        Text(_) { focused }
        Paste(_) { focused }
        // **The control under the pointer, or nobody.** This asked `focus.clicked`, which
        // answers the *current focus* when a press lands on no tab stop -- right for deciding
        // where the focus goes, and wrong for deciding who gets the press: a press on a bare
        // scroll bar, or on the background, was delivered to whatever happened to be focused
        // somewhere else on screen. In the gallery that meant clicking a scroll bar changed the
        // selection in the catalogue tree, which is a control the pointer was nowhere near.
        //
        // **The tab stop first and the control only if there is none**, which is the part a
        // first attempt got wrong by asking `control_at` alone: a list's rows and a tree's rows
        // are controls too -- parts, declared for a reader and a click -- so the innermost
        // control under a row is the *row*, and routing to it meant the list never heard the
        // press at all. A tab stop is the thing that owns its parts' input. Falling through to
        // `control_at` is what keeps a bare scroll bar reachable, since it is the one control
        // here that a pointer can work and Tab cannot reach.
        //
        // Where the focus goes is still `focus.clicked`'s answer, which a caller asks separately.
        Press(p) {
            switch focus.tab_stop_at(l, p) {
                Some(one) { one.name }
                None {
                    switch focus.control_at(l, p) {
                        Some(one) { one.name }
                        None { "" }
                    }
                }
            }
        }
        Release(_) { if pressed == "" { focused } else { pressed } }
        Move(_) { if pressed == "" { focused } else { pressed } }
        // `""` as the fallback, which is what keeps "over nothing goes nowhere" true: `clicked`
        // answers its third argument when the point is over no tab stop at all.
        Wheel(w) { focus.clicked(l, w.at, "") }
    }
}

// The pointer grab after this input: the name `target` answered for a press, held until the
// release.
//
// **Held by the application, because a control cannot act.** Nothing in this module remembers
// anything between two inputs; an application already keeps `focused` for the same reason, and
// this is its twin for the pointer. `name` is what `target` just answered, so the pair is always
// used together:
//
//     val name = controls.target(laid, input, focused, s.pressed)
//     val next = with s { pressed: controls.pressed_after(s.pressed, input, name) }
//
// **A release clears it even when it lands on nothing**, which is what stops a grab from outliving
// the gesture that made it -- a bar left grabbed would swallow every later move in the window.
pub fn pressed_after(pressed: string, input: Input, name: string) -> string {
    return switch input {
        Press(_) { name }
        Release(_) { "" }
        Move(_) { pressed }
        Wheel(_) { pressed }
        KeyDown(_) { pressed }
        KeyUp(_) { pressed }
        Text(_) { pressed }
        Paste(_) { pressed }
    }
}

// The pointer's shape over this point, from whatever control is under it.
//
// **A window-wide question answered from the tree, so every application gets it without wiring
// one.** An application calls this on each move and hands the answer to `desktop.set_cursor`; the
// gallery showed an arrow over everything until it did, including over a split pane's divider,
// which is the one control whose whole affordance *is* the cursor -- a line you cannot tell is
// draggable until you are already dragging it.
//
// **Decided by the control's role**, which is the same table accessibility reads, so a control
// that declares itself properly gets a cursor for nothing and one that does not is visibly
// ordinary. That is the right pressure: `a11y` and the pointer should not disagree about what a
// thing is.
//
// **A separator's direction comes from its own box, not from a second field.** A divider between
// two columns is tall and thin and moves sideways; one between two rows is wide and short and
// moves up and down. The box is the fact, already laid out and exact -- where an orientation flag
// would be a second copy of it, free to disagree, which is the mistake `thumb_of` and `split_at`
// exist to avoid.
//
// **A column header is left to `table_cursor`.** Its shape depends on *where in the header* the
// pointer is -- an edge resizes, the middle sorts -- which is a question about one control's
// geometry rather than about which control is under the pointer, so it does not belong here.
pub fn cursor_at(l: Laid, at: Point) -> widget.Cursor {
    return switch focus.control_at(l, at) {
        Some(node) { cursor_for(node) }
        None { widget.Cursor.Arrow }
    }
}

fn cursor_for(node: Laid) -> widget.Cursor {
    return switch widget.role_of(node) {
        TextField { widget.Cursor.Text }
        Password { widget.Cursor.Text }
        Link { widget.Cursor.Hand }
        Separator {
            if node.bounds.height >= node.bounds.width {
                widget.Cursor.ResizeAcross
            } else {
                widget.Cursor.ResizeDown
            }
        }
        Button { widget.Cursor.Arrow }
        CheckBox { widget.Cursor.Arrow }
        Switch { widget.Cursor.Arrow }
        ProgressBar { widget.Cursor.Arrow }
        SpinButton { widget.Cursor.Text }
        RadioButton { widget.Cursor.Arrow }
        Slider { widget.Cursor.Arrow }
        List { widget.Cursor.Arrow }
        ListItem { widget.Cursor.Arrow }
        Tree { widget.Cursor.Arrow }
        TreeItem { widget.Cursor.Arrow }
        Tab { widget.Cursor.Arrow }
        TabList { widget.Cursor.Arrow }
        Menu { widget.Cursor.Arrow }
        MenuItem { widget.Cursor.Arrow }
        ComboBox { widget.Cursor.Arrow }
        ScrollBar { widget.Cursor.Arrow }
        Table { widget.Cursor.Arrow }
        TableRow { widget.Cursor.Arrow }
        ColumnHeader { widget.Cursor.Arrow }
        SplitPane { widget.Cursor.Arrow }
        Dialog { widget.Cursor.Arrow }
        Group { widget.Cursor.Arrow }
        Label { widget.Cursor.Arrow }
        Image { widget.Cursor.Arrow }
        Window { widget.Cursor.Arrow }
        Unknown { widget.Cursor.Arrow }
    }
}

// ------------------------------------------------------------------ the button

// A button, and whether it is being held down.
//
// `held` is state and `ButtonStep.activated` is not, which is the distinction the whole model rests
// on: being held is something a user can see and the next frame has to draw, while having fired is
// something that happened once and that the application acts on rather than stores.
pub struct Button {
    name: string
    label: string
    // What the button shows beside its label, if anything.
    //
    // **A field rather than a widget in the label slot**, which is the decision recorded in
    // `widget.Icon`: it is what lets a design file name an icon without the dialect reaching
    // inside a control, and it is why the icon has no size of its own -- `button_widget` derives
    // one from `Style.text_size` below.
    //
    // **A button with no label is announced by its icon's name**, which is the one case where an
    // icon is not decoration. A button with both says only its label.
    icon: Option<widget.Icon>
    disabled: bool
    held: bool
}

pub fn button_of(name: string, label: string) -> Button {
    return Button {
        name: name,
        label: label,
        icon: Option<widget.Icon>.None,
        disabled: false,
        held: false
    }
}

// A button with an icon before its label: `with button_of(..) { icon: .. }` says the same thing,
// and this is here because an icon button is common enough to deserve one call.
pub fn icon_button_of(name: string, label: string, icon: widget.Icon) -> Button {
    return with button_of(name, label) { icon: Option<widget.Icon>.Some(icon) }
}

pub struct ButtonStep {
    button: Button
    activated: bool
}

// What an input does to a button.
//
// `bounds` is the rectangle the layout gave it -- `focus.node_of` answers that -- and it is needed
// for one rule: **a press inside followed by a release outside does not fire.** Dragging off a
// button cancels it, which every toolkit does and which is the reason `held` exists at all rather
// than the button simply reporting each click. A button that fired on any release would fire when
// the user changed their mind.
//
// The keyboard mirrors the pointer rather than firing on the way down: **Space arms and fires on
// release**, so it can be cancelled the same way, while **Enter fires immediately**, because Enter
// is the key a default button answers and a user pressing it has already decided. That split is the
// platforms' own and is deliberate here.
pub fn button_input(b: Button, input: Input, bounds: Rect) -> ButtonStep {
    if b.disabled {
        // A disabled button does not even take a press, so it cannot be left held when it is
        // enabled again.
        return still(with b { held: false })
    }
    return switch input {
        Press(p) { still(with b { held: widget.contains(bounds, p) }) }
        Release(p) {
            if b.held && widget.contains(bounds, p) {
                ButtonStep { button: with b { held: false }, activated: true }
            } else {
                still(with b { held: false })
            }
        }
        KeyDown(k) {
            if is_enter(k) {
                ButtonStep { button: b, activated: true }
            } else {
                still(with b { held: b.held || is_space(k) })
            }
        }
        KeyUp(k) {
            if b.held && is_space(k) {
                ButtonStep { button: with b { held: false }, activated: true }
            } else {
                still(b)
            }
        }
        Text(_) { still(b) }
        Paste(_) { still(b) }
        Move(_) { still(b) }
        Wheel(_) { still(b) }
    }
}

fn still(b: Button) -> ButtonStep {
    return ButtonStep { button: b, activated: false }
}

// The button as a widget: a control declaring its role, around a background and its label.
//
// The role and the label are declared here, which is what F275 is for -- a reader announces
// "button, Save" from this one call, and nothing downstream has to guess that a group of rectangles
// was a button.
// What a reader says for this button: its words, or its icon's name when it has none.
//
// **Declared rather than left to be gathered, and a glyph icon is why.** `a11y` builds a name
// from the text inside a control when nothing is declared, which gave the right answer for every
// button that existed before icons: the only text in one was its label. A `Drawing` has no text,
// so a drawn icon stayed silent by itself -- but a **glyph** icon *is* text, and a button with one
// was announced as "A Done", the private-use character read out in front of the word. A test
// caught it the same hour the source was added.
//
// So the control says its own name in every case. The icon is silent beside words because nothing
// is gathered at all, and it speaks without them because that is the one case where an icon is
// not decoration.
fn announced_name(b: Button) -> string {
    if b.label != "" {
        return b.label
    }
    return switch b.icon {
        Some(icon) { icon.name }
        None { "" }
    }
}

pub fn button_widget(b: Button, f: Frame) -> widget.Widget {
    val style = f.style
    // **One question, asked once**: `held` is the button's own fact, the pointer's name comes
    // from the frame, and the row decides everything that follows.
    val parts = parts_for(style, mood_of(b.disabled, b.held, false, hovered_in(f, b.name)))
    val ink = parts.ink
    // **The icon is inked with the label and sized from the text**, which is what makes it part of
    // the control rather than a picture beside it: a disabled button's icon greys with its words,
    // and a theme that sets a larger `text_size` gets a larger icon without saying so.
    val content = mutable_array_new<widget.Widget>()
    val label = widget.label_in_face(b.label, style.text.label.size, ink, style.text.label.face)
    switch b.icon {
        Some(icon) {
            val mark = widget.icon_widget(icon, style.text.label.size, ink, style.icon_font)
            // A label-less button is just the icon: no gap, and nothing to put one between.
            if b.label == "" {
                push(content, mark)
            } else {
                switch icon.side {
                    Leading {
                        push(content, mark)
                        push(content, label)
                    }
                    Trailing {
                        push(content, label)
                        push(content, mark)
                    }
                }
            }
        }
        None { push(content, label) }
    }
    // **The gap is the stack's own spacing, not a widget between the two.** An empty label would
    // measure zero and still read as a child to a reader; `Stack.spacing` is what exists for the
    // space between children, and it is zero when there is only one of them.
    val gap = if prelude.len(content) > 1 { style.icon_gap } else { 0.0 }
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: gap,
        padding: padded_for(style),
        surface: surface_of(style, parts),
        // **Centred, which it could not be until `widget` had an alignment rule.** A button given
        // more width than its text -- one in a row of equal columns, one stretched to a panel's
        // edge -- put its label hard against the left padding, and had since F271. It was never
        // seen because `curly gui` puts `widget.expand` on the field beside its buttons, so they
        // take exactly the width of their text and the spare room that shows the bug is zero.
        align: widget.centred(),
        children: prelude.snapshot(content),
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: b.name,
        role: widget.Role.Button,
        // **A button says its own name**, words or icon -- see `announced_name`, which explains
        // why this is declared rather than gathered from the text inside.
        label: announced_name(b),
        description: "",
        value: "",
        state: with widget.no_state() { disabled: b.disabled },
        focus_part: "",
        tab_stop: true,
        child: inside
    })
}

// --------------------------------------------------------------- the check box

pub struct CheckBox {
    name: string
    label: string
    disabled: bool
    checked: Toggle
    held: bool
}

pub fn check_box_of(name: string, label: string, checked: Toggle) -> CheckBox {
    return CheckBox { name: name, label: label, disabled: false, checked: checked, held: false }
}

pub struct CheckStep {
    check_box: CheckBox
    toggled: bool
}

// What an input does to a check box: the button's rules, and then the toggle.
//
// **A mixed box becomes checked, never unchecked**, which is not what "toggle" suggests and is what
// every platform does: a mixed box means some of the things under it are on, and a user clicking it
// is asking for all of them, not none. Going to unchecked would throw away the choices that were
// already made.
pub fn check_box_input(c: CheckBox, input: Input, bounds: Rect) -> CheckStep {
    val step = button_input(as_button(c), input, bounds)
    val moved = with c { held: step.button.held }
    if !step.activated {
        return CheckStep { check_box: moved, toggled: false }
    }
    return CheckStep { check_box: with moved { checked: next(c.checked) }, toggled: true }
}

// A check box as a button, for the input rules the two share -- press, drag off, Space, Enter.
//
// **Built with `button_of` and `with` rather than a field-by-field literal**, which is what it was
// until `Button` gained `icon` and this stopped compiling. A literal names every field, so it
// breaks on every addition; `with` over the constructor takes the new field's default and says
// only what differs, which is all this adapter has to say.
fn as_button(c: CheckBox) -> Button {
    return with button_of(c.name, c.label) {
        disabled: c.disabled,
        held: c.held
    }
}

fn next(t: Toggle) -> Toggle {
    return switch t {
        Off { Toggle.On }
        On { Toggle.Off }
        Mixed { Toggle.On }
    }
}

// The check box as a widget: the mark, then the label, and the state declared so that a reader says
// "check box, Notify me, partly checked" without anything else being told.
pub fn check_box_widget(c: CheckBox, f: Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    val parts = parts_for(style, mood_of(c.disabled, c.held, false, hovered_in(f, c.name)))
    val ink = parts.ink
    // **A square, and it takes the metrics to be one.** The mark box used to be a stack holding
    // one glyph, so it measured one glyph's advance wide and one line tall -- 9x22 points at the
    // default style, because a glyph is always narrower than a line is tall. Nothing noticed while
    // it was a flat grey rectangle; F286's rounded theme drew it as a capsule, which is how the
    // shape was found.
    //
    // **One line tall, which is the only side that needs no guess.** `style.text.label.size` would be
    // metric-free and wrong: the mark's own line box is `line_height(text_size)`, and the painter
    // puts a glyph's baseline a full line below its box's top -- so a square smaller than that
    // hangs the mark out of the bottom of the box it is supposed to sit in. Asking the metrics is
    // also what makes the box exactly as tall as the label beside it, which is the relationship a
    // check box has on every platform. `entry_widget` and `multi_line_widget` already take a
    // `Metrics` for the same kind of reason, so this is the pattern rather than a new one.
    val side = line_for(m, style.text.label)
    val box = widget.fixed_of(side, side, widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        // **No cap of its own any more.** This used to pass its own side in so that a theme's
        // radius could be capped against it, because one absolute number rounded a 16-point square
        // into a blob. That cap is now what `widget.Radius.Points` *means*, applied against
        // whatever box is painted, so the check box is an ordinary face again -- and a theme asking
        // for a capsule (`Fraction(0.5)`) gets one here too, which the old cap made impossible.
        surface: surface_of(style, parts),
        // Centred both ways inside the square -- which is the thing F287 existed to make possible
        // and the reason this could not be fixed before it.
        align: widget.centred(),
        // **Centred by geometry.** A `Drawn` is scaled into the box it is given, so the mark is
        // in the middle of the square because the square is what it was given -- where a glyph
        // was in the middle of a *line*, which is a different thing and sits lower.
        children: [mark_widget(c.checked, ink, side)],
        name: ""
    }))
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: style.text.label.size * 0.5,
        padding: padded_for(style),
        surface: widget.no_surface(),
        // **`Across.Centre` rather than the default, or the square is not square.** A stretched
        // row hands every child its full height, so the fixed box would come out `side` wide and
        // as tall as the row -- a stack cannot be given a square child, it can only be told not to
        // stretch it. It also centres the mark against the label, which is where it belongs.
        align: widget.Alignment { across: widget.Across.Centre, along: widget.Along.Start },
        children: [box, widget.label_in_face(c.label, style.text.label.size, ink, style.text.label.face)],
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: c.name,
        role: widget.Role.CheckBox,
        // Declared rather than taken from the text inside, because the text inside is the mark as
        // well as the label: a reader must not announce "check box, x Notify me".
        label: c.label,
        description: "",
        value: "",
        state: with widget.no_state() {
            disabled: c.disabled,
            checked: Option<Toggle>.Some(c.checked)
        },
        focus_part: "",
        tab_stop: true,
        child: inside
    })
}

// ---------------------------------------------------------------- the switch

// A setting that takes effect as it moves.
//
// **Not a check box that looks different**, which is the whole reason it is here. A check box is a
// choice a user makes and commits with the rest of a form; a switch is the state of something, and
// moving it *is* the action -- which is why every platform gives the two different roles and why a
// reader says "on" for one and "checked" for the other. A dialog's "Remember me" is a check box; a
// window's "Dark mode" is a switch.
//
// Same shape as `CheckBox` otherwise, down to `held`: it is a button that carries a `Toggle`.
pub struct Switch {
    name: string
    label: string
    disabled: bool
    on: Toggle
    held: bool
}

// **The field is `control` and not `switch`**, which is a keyword here and cannot be a field name.
// Every other step names its field after its control -- `check_box`, `button`, `entry` -- so this
// is the one place that convention cannot be followed, rather than a different idea.
pub struct SwitchStep {
    control: Switch
    toggled: bool
}

pub fn switch_of(name: string, label: string, on: Toggle) -> Switch {
    return Switch { name: name, label: label, disabled: false, on: on, held: false }
}

fn switch_as_button(s: Switch) -> Button {
    return with button_of(s.name, s.label) {
        disabled: s.disabled,
        held: s.held
    }
}

// A press or Space moves it, exactly as it does a check box: the difference between the two
// controls is what it means, not how it is worked.
pub fn switch_input(s: Switch, input: Input, bounds: Rect) -> SwitchStep {
    val step = button_input(switch_as_button(s), input, bounds)
    val moved = with s { held: step.button.held }
    if !step.activated {
        return SwitchStep { control: moved, toggled: false }
    }
    return SwitchStep { control: with moved { on: next(s.on) }, toggled: true }
}

// **The track is the accent when it is on**, which is what `accent` and `on_accent` are for: the
// one colour a look is recognised by, and what reads on it. The five state rows still govern the
// off track and the ink, so a hovered or disabled switch is the look's hovered or disabled face --
// but an *on* switch is not a state of the control, it is its value, and a value that said
// `states.selected.face` would be a pale tint of the accent where every platform draws a solid one.
pub fn switch_widget(s: Switch, f: Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    val parts = parts_for(style, mood_of(s.disabled, s.held, false, hovered_in(f, s.name)))
    val on = Toggle.is_On(s.on)
    // One line tall and twice as wide, for the check box's reason: the line box is the only
    // measurement that makes the control exactly as tall as the label beside it.
    val tall = line_for(m, style.text.label)
    val wide = tall * 2.0
    val knob = tall - style.space.xs * 2.0
    val track_ink = if s.disabled {
        style.states.disabled.ink
    } else {
        if on { style.accent } else { paint.flat_of(parts.face) }
    }
    val knob_ink = if on && !s.disabled { style.on_accent } else { style.panel }
    // **A capsule whichever shape scale is in force.** A switch that is not a capsule is a check
    // box drawn wide, so this is `Fraction(0.5)` rather than `shape.full` -- the one control whose
    // roundness is what tells it apart, the way a radio's circle is.
    val track = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.insets_of(style.space.xs, style.space.xs, style.space.xs, style.space.xs),
        surface: widget.Surface {
            inset: 0.0,
            fill: Option<Paint>.Some(Paint.Solid(track_ink)),
            border: parts.border,
            corner: widget.Radius.Fraction(0.5),
            corners: widget.Corners.All,
            shadow: Option<widget.Shadow>.None
        },
        // **The thumb is placed by a flexible gap, not by arithmetic.** `Along.Start` with the gap
        // after it puts the knob left, `Along.End` puts it right; either way the track decides
        // where its own ends are, so the knob stays inside a track of any width at any density.
        align: widget.Alignment {
            across: widget.Across.Centre,
            along: if on { widget.Along.End } else { widget.Along.Start }
        },
        children: [widget.fixed_of(knob, knob, widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Row,
            spacing: 0.0,
            padding: widget.no_insets(),
            surface: widget.Surface {
                inset: 0.0,
                fill: Option<Paint>.Some(Paint.Solid(knob_ink)),
                border: Option<widget.Border>.None,
                corner: widget.Radius.Fraction(0.5),
                corners: widget.Corners.All,
                shadow: Option<widget.Shadow>.None
            },
            align: widget.stretched(),
            children: [],
            name: ""
        }))],
        name: ""
    })
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: style.text.label.size * 0.5,
        padding: padded_for(style),
        surface: widget.no_surface(),
        // The check box's reason: a stretched row would hand the track the row's full height and
        // the capsule would stop being one.
        align: widget.Alignment { across: widget.Across.Centre, along: widget.Along.Start },
        children: [
            widget.fixed_of(wide, tall, track),
            widget.label_in_face(s.label, style.text.label.size, parts.ink, style.text.label.face)
        ],
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: s.name,
        role: widget.Role.Switch,
        // Declared, for the check box's reason: the text inside would otherwise be read as part of
        // the name, and here there is none at all to take.
        label: s.label,
        description: "",
        value: "",
        state: with widget.no_state() {
            disabled: s.disabled,
            checked: Option<Toggle>.Some(s.on)
        },
        focus_part: "",
        tab_stop: true,
        child: inside
    })
}

// What the box draws. Text rather than a drawn glyph, so that a check box needs no icon set and no
// second rendering path -- F277's later instalments can replace it without the model changing.
// A check box's mark, as a path in the unit box `widget.Drawn` scales into.
//
// **Drawn and not typed, which is two problems at once.** As a glyph it was placed on a baseline:
// a font puts its ink between the baseline and the x-height and leaves the descender empty, so a
// tick centred as a *box* sits visibly low in a square. Geometry has no such opinion -- a path
// given the box is centred in the box. And a glyph has to exist: a check box drawing "✓" on a
// face that lacks it draws `.notdef`, which is why the gallery and curly both replace the tree's
// marks with ASCII before they open a window. A path needs no font at all.
//
// The tree's arrows are still strings, and this is the argument that they should not be.
// The mark, or nothing at all for an unchecked box -- which draws no node rather than an empty
// one, since `Nothing` is the honest answer for "there is no mark here".
// **It has to be given a size, because a drawing measures nothing.** `Drawn`'s own comment says
// so -- a mark is sized by the control it belongs to -- which means a path handed to a stack that
// centres rather than stretches is laid out zero by zero and draws nothing at all. The box is a
// square of `side`, so the mark is too, and the path's own margins inside the unit box keep it
// off the edges.
fn mark_widget(t: Toggle, ink: Color, side: float) -> widget.Widget {
    return switch mark_path(t) {
        Some(path) { widget.fixed_of(side, side, widget.drawn_of(path, ink)) }
        None { widget.Widget.Nothing }
    }
}

fn mark_path(t: Toggle) -> Option<shape.Path> {
    return switch t {
        Off { Option<shape.Path>.None }
        On { Option<shape.Path>.Some(tick()) }
        Mixed { Option<shape.Path>.Some(dash()) }
    }
}

// How thick a mark's stroke is, as a fraction of the box it is drawn in. **A fraction, so it
// scales**: the same mark at eleven points and at twenty-two is the same shape, which a stroke
// width in points would not be.
val mark_weight = 0.14

// A tick, as a stroked polyline turned into an area: down to the left foot, up to the right
// shoulder. **Built as an outline rather than stroked**, because `scene` strokes a path with a
// pen and this layer wants a filled shape it can hand to `Drawn` -- which takes a path and a
// colour and nothing about a pen.
fn tick() -> shape.Path {
    val b = shape.path_builder()
    shape.move_to(b, geom.point_of(0.22, 0.52))
    shape.line_to(b, geom.point_of(0.42, 0.72))
    shape.line_to(b, geom.point_of(0.78, 0.30))
    shape.line_to(b, geom.point_of(0.78 - mark_weight * 0.4, 0.30 - mark_weight))
    shape.line_to(b, geom.point_of(0.42, 0.72 - mark_weight * 1.4))
    shape.line_to(b, geom.point_of(0.22 + mark_weight, 0.52 - mark_weight))
    shape.close_path(b)
    return shape.path_of(snapshot(b.segments), shape.Winding.NonZero)
}

// The third state: a bar across the middle, which is what every platform draws for "some of the
// things under this are on".
fn dash() -> shape.Path {
    return shape.rect_path(geom.rect_of(0.22, 0.5 - mark_weight * 0.5, 0.56, mark_weight))
}

// A disclosure arrow, in the unit box a `Drawn` scales into: pointing down when the thing it
// belongs to is open, right when it is shut.
//
// **Drawn, and this is the argument the check box's mark made coming true a second time.** These
// were `Style.collapsed_mark` and `Style.expanded_mark`, two strings holding "\u25b8" and
// "\u25be" -- and a face that lacks those code points draws `.notdef`, a hollow box. Liberation
// Sans lacks them, so on a machine where that is the first font found *every combo box and every
// tree row in the window drew a box*. The library's answer was a comment saying applications
// should replace the marks, and both applications did: five `with style { collapsed_mark: ">",
// expanded_mark: "v" }` across two repositories, each a thing somebody had to know.
//
// A path needs no font, so there is nothing to know and nothing to replace. Two fields that could
// be set wrong left `Style` with them.
fn chevron(down: bool) -> shape.Path {
    val b = shape.path_builder()
    if down {
        shape.move_to(b, geom.point_of(0.25, 0.4))
        shape.line_to(b, geom.point_of(0.75, 0.4))
        shape.line_to(b, geom.point_of(0.5, 0.68))
    } else {
        shape.move_to(b, geom.point_of(0.38, 0.25))
        shape.line_to(b, geom.point_of(0.38, 0.75))
        shape.line_to(b, geom.point_of(0.66, 0.5))
    }
    shape.close_path(b)
    return shape.path_of(snapshot(b.segments), shape.Winding.NonZero)
}

// The arrow at the size the text beside it is, so it grows with a theme that sets a larger type
// scale -- the icon's rule, for the icon's reason.
fn chevron_widget(down: bool, ink: Color, side: float) -> widget.Widget {
    return widget.fixed_of(side, side, widget.drawn_of(chevron(down), ink))
}

// A radio's dot: a circle, because a radio is a circle and the thing inside it is too.
fn dot() -> shape.Path {
    return shape.ellipse_path(geom.rect_of(0.3, 0.3, 0.4, 0.4))
}

// ---------------------------------------------------------- the progress bar

// How far along something is, or only that it is going on at all.
//
// **Two cases, not a number with a sentinel.** A bar whose value is `-1.0` or `None` for "I do not
// know" is a bar every caller must remember to check, and the one that forgets draws a job that is
// finished as a job that has not started. They are also announced differently -- a determinate bar
// has a percentage to read and an indeterminate one has only "busy" -- so the difference has to
// survive as far as the reader, which a sentinel does not.
//
// `Busy` carries a **phase**, 0 to 1, and the application advances it. `lib/ui` has no clock and is
// not going to grow one: a library that reads the time cannot be tested by handing it a value, and
// every animation here is already a function of a number somebody else owns.
pub enum Progress {
    Fraction(float)
    Busy(float)
}

pub struct ProgressBar {
    name: string
    label: string
    progress: Progress
}

// **A name it can be announced by, and no input function at all.** A progress bar is the one
// control here that a user cannot operate -- there is nothing to press and no state to change --
// so it has no `*_input`, is not a tab stop, and still has to be in the accessibility tree,
// because "is it still going?" is exactly the question a reader has to be able to answer.
pub fn progress_bar_of(name: string, label: string, fraction: float) -> ProgressBar {
    return ProgressBar { name: name, label: label, progress: Progress.Fraction(fraction) }
}

pub fn busy_bar_of(name: string, label: string, phase: float) -> ProgressBar {
    return ProgressBar { name: name, label: label, progress: Progress.Busy(phase) }
}

fn held_to_unit(v: float) -> float {
    if v < 0.0 {
        return 0.0
    }
    if v > 1.0 {
        return 1.0
    }
    return v
}

// How much of the bar the indeterminate segment covers.
val busy_share = 0.3

// **The fill is a hard-stopped gradient, and that is not a trick -- it is the only thing the model
// can say.** A progress fill is a *proportion* of whatever width the bar is given, and the widget
// tree has no proportional container: `Flex` is empty space and `Sized` is absolute, so a nested
// box cannot be 40% of its parent. A gradient's endpoints, since F294, are fractions of the box
// being painted -- so two stops at the same offset put the edge of the fill at exactly 40% of any
// width, at any density, with no arithmetic and no second node. The fraction ends up literally in
// the paint, which is also what lets a test read it back out.
fn progress_stops(p: Progress, done: Color, rest: Color) -> [paint.Stop] {
    return switch p {
        Fraction(v) {
            val at = held_to_unit(v)
            [paint.stop_of(0.0, done), paint.stop_of(at, done), paint.stop_of(at, rest), paint.stop_of(1.0, rest)]
        }
        Busy(phase) {
            // The segment travels from just off the left to just off the right, so the ends of the
            // cycle look like the middle of it: a segment that stopped at the edges would read as
            // the job having stalled twice per pass.
            val travel = held_to_unit(phase) * (1.0 + busy_share) - busy_share
            val lo = held_to_unit(travel)
            val hi = held_to_unit(travel + busy_share)
            if hi <= lo {
                [paint.stop_of(0.0, rest), paint.stop_of(1.0, rest)]
            } else {
                [
                    paint.stop_of(0.0, rest),
                    paint.stop_of(lo, rest),
                    paint.stop_of(lo, done),
                    paint.stop_of(hi, done),
                    paint.stop_of(hi, rest),
                    paint.stop_of(1.0, rest)
                ]
            }
        }
    }
}

pub fn progress_bar_widget(b: ProgressBar, f: Frame) -> widget.Widget {
    val style = f.style
    // The accent for the done part, as the switch's on track is: being 40% along is the bar's
    // value, and the state rows are about a control's state. The rest is the track the slider
    // uses, so a bar and a slider in one window read as the same family of thing.
    val stops = progress_stops(b.progress, style.accent, style.states.disabled.ink)
    val bar = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.Surface {
            inset: 0.0,
            // Left to right across the middle, in the box's own fractions.
            fill: Option<Paint>.Some(Paint.LinearGradient(paint.Linear {
                from: geom.point_of(0.0, 0.5),
                to: geom.point_of(1.0, 0.5),
                stops: stops
            })),
            border: Option<widget.Border>.None,
            // A capsule, so the fill's own end is rounded by the bar it is clipped to -- which is
            // the other thing a nested box would have had to round for itself.
            corner: widget.Radius.Fraction(0.5),
            corners: widget.Corners.All,
            shadow: Option<widget.Shadow>.None
        },
        align: widget.stretched(),
        children: [],
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: b.name,
        role: widget.Role.ProgressBar,
        label: b.label,
        description: "",
        // **"busy" is the value, because there is no state that says it.** An indeterminate bar has
        // no percentage to read and a reader that said only "progress bar, Uploading" would have
        // described a control that might as well be finished. This is what every platform does
        // when a bar has no value of its own.
        value: said_progress(b.progress),
        state: widget.no_state(),
        focus_part: "",
        tab_stop: false,
        // **A height and no width**, which is what a bar is: as wide as it is given, and a fixed
        // few points tall. `0.0` is `fixed_of`'s "do not constrain this side", as the slider's
        // track also uses.
        child: widget.fixed_of(0.0, style.space.s, bar)
    })
}

fn said_progress(p: Progress) -> string {
    return switch p {
        Fraction(v) { concat(str(floor(held_to_unit(v) * 100.0)), "%") }
        Busy(_) { "busy" }
    }
}

// ---------------------------------------------------------- the number field

// A field that only ever holds something on its way to being a number, with a pair of steppers.
//
// **It carries text, not a number, and that is the decision the control exists to get right.** A
// field holding a `float` cannot represent what a user is in the middle of typing: `-` is not a
// number and is on the way to one, so is `1.`, so is an empty field. The spin buttons that
// infuriate on every platform are the ones that store the number -- they rewrite `-` to `0`, or
// refuse the keystroke, and either way the field cannot be typed into backwards.
//
// So the text is the truth while typing and the number is derived. **Nothing is clamped until it is
// committed**, because clamping each keystroke makes a range impossible to type into: into a field
// bounded 10 to 20, typing `1` would clamp to `10` and the `5` after it would arrive at `105`.
pub struct NumberField {
    entry: Entry
    least: float
    most: float
    // What a stepper, an arrow key and a wheel notch move by.
    step: float
}

pub struct NumberStep {
    field: NumberField
    // Whether the number this field holds is different from the one it held. **Not whether the text
    // changed**: moving the caret through `100` changes neither, and typing the `.` of `1.5` changes
    // the text while the number is still on its way.
    changed: bool
}

pub fn number_field_of(
    name: string,
    label: string,
    value: float,
    least: float,
    most: float,
    step: float
) -> NumberField {
    return NumberField {
        entry: entry_of(name, label, number_text(value)),
        least: least,
        most: most,
        step: step
    }
}

// **The shortest text that is exactly this number**, so a field stepping by 0.5 reads 1, 1.5, 2
// rather than 1.0, 1.5, 2.0 -- and a port field never shows 8080.0.
//
// Local, and deliberately not `number.format`: that module is about locales, and a grouping
// separator or a decimal comma in a field would be text `parse_float` cannot read back. A field is
// not a label.
fn number_text(v: float) -> string {
    if v < 1.0e15 && v > 0.0 - 1.0e15 && v == (floor(v) as float) {
        return str(v as int)
    }
    return str(v)
}

// The number the field holds, or nothing while its text is on the way to one.
//
// **An `Option`, because "no number yet" is a real state and zero is a lie.** A field showing `-`
// has no value, and a caller handed `0.0` for it would write a port of zero into a config.
pub fn number_in(n: NumberField) -> Option<float> {
    return switch parse_float(n.entry.editor.text) {
        Ok(v) { Option<float>.Some(v) }
        Err(_) { Option<float>.None }
    }
}

pub fn number_or(n: NumberField, fallback: float) -> float {
    return switch number_in(n) {
        Some(v) { v }
        None { fallback }
    }
}

fn held_between(v: float, least: float, most: float) -> float {
    if most <= least {
        return least
    }
    if v < least {
        return least
    }
    if v > most {
        return most
    }
    return v
}

// Whether this text could still become a number, which is **the one rule the field applies to
// every edit**.
//
// A character whitelist was the obvious alternative and it is wrong in both directions: it lets
// `--` and `1.2.3` through, and it has to special-case the sign and the point anyway. Asking
// whether the text could still parse handles those, and has a property a whitelist does not --
// `inf` and `nan` are unreachable by typing, because `i` and `n` are not on the way to anything.
fn could_still_be_a_number(t: string) -> bool {
    // Empty and a lone sign are on the way; so is a trailing point, which `parse_float` may not
    // take, so it is asked about the number that point is on the way to.
    if t == "" || t == "-" || t == "+" {
        return true
    }
    if ends_with(t, ".") {
        return switch parse_float(concat(t, "0")) {
            Ok(_) { true }
            Err(_) { false }
        }
    }
    return switch parse_float(t) {
        Ok(_) { true }
        Err(_) { false }
    }
}

// The field with its value moved by `by` steps, clamped and rewritten.
//
// **A stepper commits**, which is why it clamps where typing does not: pressing it is not being in
// the middle of anything, so there is no half-typed state to protect. From a field whose text is
// not a number at all it starts from the low end, which is the only answer that is not a guess.
pub fn stepped(n: NumberField, by: float) -> NumberField {
    val from = number_or(n, n.least)
    val to = held_between(from + by * n.step, n.least, n.most)
    return with n {
        entry: with n.entry {
            editor: edit.editor_of(number_text(to)),
            typing: false
        }
    }
}

// The field with its text clamped into range and rewritten in the canonical form: what Enter and
// losing the focus do.
//
// **Empty stays empty.** A field a user cleared has not been given an out-of-range number, and
// filling it with the minimum on the way past would overwrite what they were about to type.
pub fn committed(n: NumberField) -> NumberField {
    if n.entry.editor.text == "" {
        return n
    }
    return switch number_in(n) {
        Some(v) { stepped_to(n, held_between(v, n.least, n.most)) }
        // Text that is on its way and got no further -- `-`, `1.` -- is not a number, and the
        // honest thing is to leave it alone rather than invent one.
        None { n }
    }
}

fn stepped_to(n: NumberField, v: float) -> NumberField {
    return with n {
        entry: with n.entry {
            editor: edit.editor_of(number_text(v)),
            typing: false
        }
    }
}

// Where the two steppers are: a column at the trailing edge, the up half above the down half.
//
// **Computed from the control's own bounds**, which is the scroll bar's pattern rather than a new
// one: one control, one set of bounds, and the parts worked out from the style that drew them. The
// alternative -- routing a press by a part's name -- would make this the only control whose input
// function needs to be told which part was hit.
fn stepper_width(style: Style) -> float {
    return style.space.l
}

fn up_box(bounds: Rect, style: Style) -> Rect {
    val w = stepper_width(style)
    return geom.rect_of(bounds.x + bounds.width - w, bounds.y, w, bounds.height * 0.5)
}

fn down_box(bounds: Rect, style: Style) -> Rect {
    val w = stepper_width(style)
    val half = bounds.height * 0.5
    return geom.rect_of(bounds.x + bounds.width - w, bounds.y + half, w, bounds.height - half)
}

fn number_still(n: NumberField) -> NumberStep {
    return NumberStep { field: n, changed: false }
}

// **Only a change in the number counts as a change.** A caret that moved and a `.` that was typed
// both leave the value where it was, and an application that saved on every `changed` would write a
// half-typed number to disk.
fn number_moved(before: NumberField, after: NumberField) -> NumberStep {
    return NumberStep { field: after, changed: number_or(before, 0.0) != number_or(after, 0.0) }
}

pub fn number_field_input(n: NumberField, input: Input, bounds: Rect, f: Frame) -> NumberStep {
    val style = f.style
    if n.entry.disabled {
        return number_still(n)
    }
    // The steppers first, because a press on one is not a press in the text.
    if Some(p) = press_at(input) {
        if widget.contains(up_box(bounds, style), p) {
            return number_moved(n, stepped(n, 1.0))
        }
        if widget.contains(down_box(bounds, style), p) {
            return number_moved(n, stepped(n, 0.0 - 1.0))
        }
    }
    if Some(k) = key_down(input) {
        if Key.is_Up(k.key) {
            return number_moved(n, stepped(n, 1.0))
        }
        if Key.is_Down(k.key) {
            return number_moved(n, stepped(n, 0.0 - 1.0))
        }
        // Enter commits, as it does in any field that validates: it is the keystroke that means
        // "I have finished".
        if is_enter(k) {
            return number_moved(n, committed(n))
        }
    }
    if Some(w) = wheel_on(input, bounds) {
        return number_moved(n, stepped(n, w as float))
    }
    // **Everything else is the text field's, and then vetoed.** The editor handles the keystroke --
    // a selection replaced, a paste, a delete, a caret moved -- and the result is kept only if it
    // could still become a number. Predicting the text a keystroke would produce would have been a
    // second copy of `edit`, wrong in a different way for each input.
    val step = entry_input(n.entry, input, bounds, f)
    if !could_still_be_a_number(step.entry.editor.text) {
        return number_still(n)
    }
    return number_moved(n, with n { entry: step.entry })
}

fn press_at(input: Input) -> Option<Point> {
    return switch input {
        Press(p) { Option<Point>.Some(p) }
        KeyDown(_) { Option<Point>.None }
        KeyUp(_) { Option<Point>.None }
        Text(_) { Option<Point>.None }
        Paste(_) { Option<Point>.None }
        Release(_) { Option<Point>.None }
        Move(_) { Option<Point>.None }
        Wheel(_) { Option<Point>.None }
    }
}

fn key_down(input: Input) -> Option<Keystroke> {
    return switch input {
        KeyDown(k) { Option<Keystroke>.Some(k) }
        Press(_) { Option<Keystroke>.None }
        KeyUp(_) { Option<Keystroke>.None }
        Text(_) { Option<Keystroke>.None }
        Paste(_) { Option<Keystroke>.None }
        Release(_) { Option<Keystroke>.None }
        Move(_) { Option<Keystroke>.None }
        Wheel(_) { Option<Keystroke>.None }
    }
}

// A wheel notch, but **only over the field**: a wheel anywhere else belongs to whatever is
// scrolling, and a number field that answered every wheel event would change a value while the
// user was scrolling the page it sits on.
fn wheel_on(input: Input, bounds: Rect) -> Option<int> {
    return switch input {
        Wheel(w) {
            if widget.contains(bounds, w.at) {
                Option<int>.Some(w.vertical)
            } else {
                Option<int>.None
            }
        }
        Press(_) { Option<int>.None }
        KeyDown(_) { Option<int>.None }
        KeyUp(_) { Option<int>.None }
        Text(_) { Option<int>.None }
        Paste(_) { Option<int>.None }
        Release(_) { Option<int>.None }
        Move(_) { Option<int>.None }
    }
}

pub fn number_field_widget(n: NumberField, f: Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    val up_name = concat(n.entry.name, "-up")
    val down_name = concat(n.entry.name, "-down")
    val w = stepper_width(style)
    // **Half the field's own box each, so the two of them are exactly as tall as it is.** Worked
    // out rather than given: the column cannot ask the field how tall it came out, and a stack
    // shares leftover space only with `Flex`, which is empty space and cannot be a stepper. So
    // both halves are measured from the same line box and the same padding the field is built
    // from -- which is also what keeps them matching it at any density.
    val pad = padded_for(style)
    val half = (line_for(m, style.text.body) + pad.top + pad.bottom) * 0.5
    val parts = parts_for(style, mood_of(n.entry.disabled, false, false, hovered_in(f, n.entry.name)))
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: widget.stretched(),
        children: [
            // **The text box takes the leftover and the steppers keep their width**, which is
            // what makes a number field given a width actually use it: without this the row is as
            // wide as the digits in it, so `wide_of(160.0, field)` drew a 160-point box with a
            // 50-point control sitting at its left-hand end.
            //
            // The field's own box, under this control rather than under a `TextField` of its own:
            // two nested controls would be two tab stops and two things for a reader to announce.
            widget.expand(entry_inside(field_runs(n.entry, style, parts, m), style, parts)),
            // **`wide_of` and not `fixed_of(w, 0.0, ..)`**, which means a height of zero: it
            // survives only while some parent stretches it back out, and this column's own
            // children are sized rather than flexible. The library has lost nine controls to that
            // spelling; see `widget.Fixed.constrains`.
            widget.wide_of(w, widget.Widget.Group(widget.Stack {
                direction: widget.Direction.Column,
                spacing: 0.0,
                padding: widget.no_insets(),
                surface: widget.no_surface(),
                align: widget.stretched(),
                children: [
                    stepper_widget(up_name, true, w, half, n, f),
                    stepper_widget(down_name, false, w, half, n, f)
                ],
                name: ""
            }))
        ],
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: n.entry.name,
        role: widget.Role.SpinButton,
        label: n.entry.label,
        // **The range, said once.** A user typing into a field bounded 1 to 65535 cannot see the
        // bounds, and finding them by being corrected is how a form teaches nothing. A reader says
        // a description last, after the value, which is where help text belongs.
        description: concat("from ", number_text(n.least), " to ", number_text(n.most)),
        value: n.entry.editor.text,
        state: with widget.no_state() { disabled: n.entry.disabled, readonly: n.entry.readonly },
        focus_part: "",
        tab_stop: true,
        child: inside
    })
}

fn stepper_widget(name: string, up: bool, wide: float, tall: float, n: NumberField, f: Frame) -> widget.Widget {
    val style = f.style
    val parts = parts_for(style, mood_of(n.entry.disabled, pressed_in(f, name), false, hovered_in(f, name)))
    return widget.tall_of(tall, widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: surface_of(style, parts),
        align: widget.centred(),
        children: [widget.fixed_of(wide * 0.5, tall * 0.5, widget.drawn_of(arrow_path(up), parts.ink))],
        name: name
    }))
}

// A stepper's arrow: a triangle in the unit box `widget.Drawn` scales into, pointing up or down.
//
// **Drawn and not typed**, for the check box's mark's reason: a glyph is placed on a baseline and
// sits visibly low in the box it is centred in, where a path is centred by its own geometry.
fn arrow_path(up: bool) -> shape.Path {
    val b = shape.path_builder()
    if up {
        shape.move_to(b, geom.point_of(0.5, 0.25))
        shape.line_to(b, geom.point_of(0.85, 0.7))
        shape.line_to(b, geom.point_of(0.15, 0.7))
    } else {
        shape.move_to(b, geom.point_of(0.5, 0.75))
        shape.line_to(b, geom.point_of(0.85, 0.3))
        shape.line_to(b, geom.point_of(0.15, 0.3))
    }
    shape.close_path(b)
    return shape.path_of(snapshot(b.segments), shape.Winding.NonZero)
}

// -------------------------------------------------------------- the tooltip

// How long the pointer has been still on one control.
//
// **The application's number, because `lib/ui` has no clock and is not going to grow one.** A
// library that read the time could not be tested by handing it a value, and the pause before a
// tooltip is the one thing about a tooltip that a test has to be able to control. So the window
// says how much time has passed and this says what that means.
//
// It is a value threaded through the loop, like the focus: there is exactly one pointer, so there
// is exactly one of these, and no two controls can both believe they are being hovered.
pub struct Hover {
    // The control the pointer is on, "" for none.
    on: string
    // Milliseconds the pointer has been on it without moving to another control.
    waited: int
}

pub fn no_hover() -> Hover {
    return Hover { on: "", waited: 0 }
}

// The hover after another `by` milliseconds, with the pointer now on `name`.
//
// **Moving to another control starts the wait again**, which is the behaviour that makes a tooltip
// bearable: a pointer crossing a toolbar of eight buttons must not leave eight tips behind it, and
// it will not, because each one resets the count the previous was accumulating.
pub fn hovering(h: Hover, name: string, by: int) -> Hover {
    if name != h.on {
        return Hover { on: name, waited: 0 }
    }
    return Hover { on: name, waited: h.waited + by }
}

// Whether a tip should be showing: the pointer is on something and has been for long enough.
pub fn tip_due(h: Hover, after: int) -> bool {
    return h.on != "" && h.waited >= after
}

// The words to show for the control the hover is on, or "" when there are none.
//
// **"" is a real answer and the common one.** Most controls carry their name in their own face, and
// a tip repeating a label a user is already reading is noise with a delay on it. So a tip appears
// for a control whose words are not already on screen -- an icon button, a field with a range --
// and for nothing else, without anything having to be switched off per control.
pub fn tip_words(h: Hover, laid: Laid) -> string {
    if h.on == "" {
        return ""
    }
    return switch focus.node_of(laid, h.on) {
        Some(node) { words_unless_shown(node) }
        None { "" }
    }
}

// A control's tip, unless the control is already showing those very words.
fn words_unless_shown(node: Laid) -> string {
    val words = widget.tip_in(node)
    if words == "" {
        return ""
    }
    if shows_text(node, words) {
        return ""
    }
    return words
}

// Whether this node, or anything under it, draws exactly this text.
fn shows_text(node: Laid, words: string) -> bool {
    if widget.text_of(node) == words {
        return true
    }
    for c in node.children {
        if shows_text(c, words) {
            return true
        }
    }
    return false
}

// How far a tip sits from the control it describes, and how far from the window's edge.
val tip_gap = 6.0

// A tooltip over the window: the words in a raised panel, below the control if it fits and above it
// if it does not.
//
// **It takes no keys, and it is static text rather than a control.** A layer that took the
// keyboard would let a tooltip steal the focus by appearing, which is the one thing it must never
// do -- it is a consequence of the pointer resting, and the user never asked for it.
//
// Its words are in the accessibility tree the way any drawn text is, and there is **no
// `Role.Tooltip`** -- deliberately, not by omission. A tooltip here shows what the control already
// declares (see `widget.tip_in`), so a reader gets those words from the control itself, announced
// when the control is reached. A role of its own would add a second thing in the tree saying the
// same sentence, and nothing would be reachable that is not reachable now.
pub fn tip_layer(words: string, over: Rect, within: Rect, f: Frame) -> widget.Layer {
    val style = f.style
    val m = f.metrics
    val pad = style.space.s
    val wide = widget.width_in(m, face_for(m, style.text.caption.face), words, style.text.caption.size) + pad * 2.0
    val tall = line_for(m, style.text.caption) + pad * 2.0
    // Left-aligned with the control, then pushed back inside the window: a tip hanging off the
    // right-hand edge is a tip with its last word missing, which is the half it was needed for.
    val x = held_within(over.x, wide, within.x, within.width)
    // Below, unless below is off the bottom -- in which case above, which is where a tip for a
    // control near the foot of a window has to go.
    val below = over.y + over.height + tip_gap
    val y = if below + tall <= within.y + within.height {
        below
    } else {
        over.y - tall - tip_gap
    }
    return widget.layer_at(
        geom.rect_of(x, y, wide, tall),
        false,
        widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Row,
            spacing: 0.0,
            padding: widget.insets_of(pad, pad, pad, pad),
            surface: raised_of(style, style.panel),
            align: widget.centred(),
            children: [widget.label_in_face(
                words,
                style.text.caption.size,
                style.ink,
                style.text.caption.face
            )],
            name: ""
        })
    )
}

fn held_within(at: float, size: float, least: float, span: float) -> float {
    val most = least + span - size
    if most < least {
        return least
    }
    if at < least {
        return least
    }
    if at > most {
        return most
    }
    return at
}
// ------------------------------------------------------------------ the entry

// A single-line text field.
//
// The editing itself is `lib/ui/edit`: this holds an `Editor` and a `History` and decides which
// input means which edit. Keeping the two apart is what let the grapheme and word rules be tested
// against 32 cases with no widget, no layout and no font in sight.
// A run of a field's text drawn in a colour of its own.
//
// **Presentation, not model.** `edit` owns the text and knows nothing about this; a field with no
// inks draws exactly as it always did, byte for byte, which is why `inked_run` answers a single
// label when the list is empty. What it buys is the one thing a text pane could not do -- show
// code as code -- without a second text stack beside `Entry`, which would have cost the caret, the
// keyboard and the accessibility that made the response pane a field in the first place.
//
// `from` and `to` are character indices into the field's text, the same units `edit` counts in.
// The spans must be **in order and must not overlap**: a colourer walks the text once and that is
// what walking it once produces, so sorting here would be paying every frame for a mistake nobody
// makes.
pub struct Ink {
    from: int
    to: int
    colour: Color
}

pub struct Entry {
    name: string
    // What a reader calls the field. **Declared, not taken from the text inside**, because the text
    // inside a field is its *value* -- a field announced by its contents would introduce itself as
    // whatever the user last typed.
    label: string
    editor: edit.Editor
    history: edit.History
    disabled: bool
    // Readable but not editable. The caret still moves and text can still be selected and copied,
    // which is the difference from disabled and the reason both exist.
    readonly: bool
    // A press has happened and the pointer has not come up: a move extends the selection.
    dragging: bool
    // Whether the last change was a typed character, so that a run of them is **one** undo step.
    //
    // Without this, Ctrl-Z after typing a word steps back one letter at a time, which is not what
    // undo means to anyone. The rule is the one editors use: consecutive `Text` inserts coalesce,
    // and anything else -- a delete, a paste, a caret move, a click -- ends the run.
    typing: bool
    // How many lines tall. **1 is a field and anything more is a text area**, and the difference is
    // only three things: Enter inserts a newline instead of being left for a default button, Up and
    // Down move by line instead of doing nothing, and the widget draws a column of lines instead of
    // one run.
    //
    // One control rather than two because the rest -- clusters, words, selection, undo, the click
    // that places a caret -- is identical, and `edit` never cared how many lines its text had: a
    // newline has always been an ordinary character in that string. A separate `TextArea` would have
    // been a second copy of all of it to gain a field.
    rows: int
    // How far the text is scrolled, in points. **A text area scrolls itself**, because the only
    // thing that knows where the caret went is the code that moved it -- a caller would have to
    // recompute the caret's line to follow it, which is the control's own arithmetic done twice.
    // Zero and unused for a one-line field.
    scroll: float
    // Text being composed through an input method, which is **not** in `editor.text` until it is
    // committed -- see `edit.Preedit`. `None` is the ordinary state and the only one most fields
    // are ever in.
    preedit: Option<edit.Preedit>
    // Shown as a run of bullets rather than as itself, and **published to a screen reader the same
    // way**: the real text leaves this module only when the application asks the field for it.
    //
    // A field, not a second control, for `rows`'s reason: everything else about a password field
    // is a text field -- the caret, the selection, the undo, the click that places a caret -- and
    // the three things that differ are what is drawn, what `Role` it declares, and that it will
    // not put its contents on the clipboard.
    masked: bool
    // Runs of the text drawn in their own colour -- syntax colouring, and anything else that
    // paints a span rather than changing it. Empty for every ordinary field. See `Ink`.
    //
    // **Ignored by a masked field.** The indices count characters of the text, and a masked field
    // draws bullets instead -- so a span would colour the wrong ones, and there is nothing in a
    // password worth colouring.
    inks: [Ink]
}

pub fn entry_of(name: string, label: string, text: string) -> Entry {
    return Entry {
        name: name,
        label: label,
        editor: edit.editor_of(text),
        history: edit.history_of(100),
        disabled: false,
        readonly: false,
        dragging: false,
        typing: false,
        rows: 1,
        scroll: 0.0,
        masked: false,
        preedit: Option<edit.Preedit>.None,
        inks: []
    }
}

// A field `rows` lines tall: Enter inserts a newline, Up and Down move by line, and the text is
// drawn a line at a time.
pub fn text_area_of(name: string, label: string, text: string, rows: int) -> Entry {
    return with entry_of(name, label, text) { rows: if rows < 1 { 1 } else { rows } }
}

// A field for a secret: drawn as bullets, announced as a password, and refusing the clipboard.
//
// **One line, always.** A multi-line password is not a thing, and the multi-line widget would draw
// the text, so `entry_widget` sends a masked field down the one-line path whatever `rows` says
// rather than leaving a way to build a field that masks in one place and not the other.
pub fn password_of(name: string, label: string, text: string) -> Entry {
    return with entry_of(name, label, text) { masked: true }
}

// **What is drawn and what is published -- which must be the same string the caret is measured
// against.** A mask is one bullet per character, so every index into the text is the same index
// into this; measuring the real text and drawing the mask would put the caret under the wrong
// bullet in any font where a bullet is not the width of an `e`.
pub fn shown_text(e: Entry) -> string {
    // **The composition first, the mask second.** A field that is both is a password being typed
    // through an input method: the composition still has to be where the caret arithmetic expects
    // it, and it still must not be legible. Masking the spliced text does both.
    val with_composition = edit.shown(e.editor, e.preedit)
    if !e.masked {
        return with_composition
    }
    return join(separator: "", pieces: mutable_array_filled(len(with_composition), bullet))
}

// Where the caret is in what `shown_text` answers: inside the composition while one is open,
// because that is where the user is typing.
fn shown_caret_at(e: Entry) -> int {
    return edit.shown_caret(e.editor, e.preedit)
}

// **How an input method reaches a field, and why it is not an `Input`.** A composition is not
// routed by what is under the pointer or by a focus that falls back; it belongs to whatever holds
// the input-method context, which is the focused text field and nothing else. Making it an
// `Input` would have put two arms on every button, list and tab strip in this module for an event
// none of them can ever receive.
pub fn entry_composing(e: Entry, text: string, caret: int) -> EntryStep {
    val started = edit.compose(e.editor, text, caret)
    return composing_step(e, started)
}

pub fn entry_composing_marked(e: Entry, text: string, caret: int, from: int, to: int) -> EntryStep {
    return composing_step(e, edit.compose_marked(e.editor, text, caret, from, to))
}

fn composing_step(e: Entry, c: edit.Composing) -> EntryStep {
    return EntryStep {
        entry: with e { editor: c.editor, preedit: Option<edit.Preedit>.Some(c.preedit), typing: false },
        copied: "",
        // **Composing is not a change and committing is.** `changed` is what a form watches to
        // know it is dirty, and a half-typed composition has changed nothing a save would write.
        changed: false
    }
}

// What the method finally chose, which replaces the composition. **An empty commit is how a
// composition is abandoned**: the method says it chose nothing, the pre-edit goes, and the text
// is as it was.
pub fn entry_commit(e: Entry, text: string) -> EntryStep {
    switch e.preedit {
        Some(p) {
            val done = edit.commit(e.editor, p, text)
            return EntryStep {
                entry: with e {
                    editor: done,
                    preedit: Option<edit.Preedit>.None,
                    history: edit.record(e.history, e.editor),
                    typing: false
                },
                copied: "",
                changed: text != ""
            }
        }
        // A commit with nothing open is ordinary text, which is what a method sends for a
        // compose sequence that never showed a pre-edit at all.
        None { return typed(e, text) }
    }
}

// U+2022, written as itself because this language has no `\u` escape.
val bullet = "•"

pub struct EntryStep {
    entry: Entry
    // Text the field is asking to be put on the system clipboard, or "". **An output, because this
    // module cannot reach a clipboard** -- the same seam `Input.Paste` is the other half of. An
    // application keeps it in a value of its own until the platform side of F273 exists.
    copied: string
    // Whether the text changed -- not the caret, not the selection. What a form watches to know it
    // is dirty, and the reason it is separate from the new state rather than something a caller
    // works out by comparing two strings.
    changed: bool
}

// What an input does to a field.
//
// `bounds`, `style` and `m` are all here for one reason: a press carries a pixel and a caret is an
// index, so placing the caret where the user clicked needs the same measurement the layout used.
// The scroll a text area needs to keep its caret in view, after whatever just happened to it.
//
// **Applied to every step rather than to the movement keys**, because everything moves the caret:
// typing runs off the bottom of the box as surely as Down does, a click places it, Home and End
// move it, and a delete can pull it up a line. Naming the keys that scroll is how a text area ends
// up with one that does not.
fn following_caret(step: EntryStep, bounds: Rect, style: Style, m: widget.Metrics) -> EntryStep {
    val e = step.entry
    if e.rows <= 1 {
        return step
    }
    val line = line_for(m, style.text.body)
    val at = edit.line_index(e.editor.text, e.editor.caret)
    val view = bounds.height - style.padding.top - style.padding.bottom
    return EntryStep {
        entry: with e {
            scroll: widget.scroll_to_reveal(view, e.scroll, (at as float) * line, line)
        },
        copied: step.copied,
        changed: step.changed
    }
}

pub fn entry_input(e: Entry, input: Input, bounds: Rect, f: Frame) -> EntryStep {
    val style = f.style
    val m = f.metrics
    if e.disabled {
        return kept(with e { dragging: false })
    }
    return following_caret(entry_step(e, input, bounds, style, m), bounds, style, m)
}

fn entry_step(e: Entry, input: Input, bounds: Rect, style: Style, m: widget.Metrics) -> EntryStep {
    // **While a composition is open the pointer does not move the caret**, and the reason is an
    // index rather than a policy: a press is measured against `shown_text`, which has the
    // composition spliced into it, while `place_caret` works in the committed text -- two
    // coordinate spaces that agree exactly until something is being composed. Placing one from
    // the other would put the caret a composition's length away from where it was clicked.
    //
    // Doing nothing is also what a user wants often enough: the input method owns the caret while
    // it is converting, and an application that would rather a click ended the composition calls
    // `entry_commit` first -- which it has to anyway, to decide what a click *means*.
    if Option.is_Some(e.preedit) {
        if pointer_input(input) {
            return kept(e)
        }
    }
    return switch input {
        Text(what) { typed(e, what) }
        Paste(what) { pasted(e, what) }
        KeyDown(k) { entry_key(e, k) }
        KeyUp(_) { kept(e) }
        Press(p) {
            kept(with e {
                // **`shown_text`, not `e.editor.text`** for a one-line field -- a click lands
                // on the bullet the user aimed at, which is only the same index if the thing
                // measured is the thing drawn. `caret_for` makes that choice and reads `y` when
                // the field has lines.
                editor: edit.place_caret(e.editor, caret_for(e, style, m, bounds, p), false),
                dragging: true,
                typing: false
            })
        }
        Move(p) {
            if e.dragging {
                kept(with e {
                    editor: edit.place_caret(e.editor, caret_for(e, style, m, bounds, p), true)
                })
            } else {
                kept(e)
            }
        }
        Release(_) { kept(with e { dragging: false }) }
        Wheel(_) { kept(e) }
    }
}

fn pointer_input(input: Input) -> bool {
    return switch input {
        Press(_) { true }
        Move(_) { true }
        Release(_) { true }
        KeyDown(_) { false }
        KeyUp(_) { false }
        Text(_) { false }
        Paste(_) { false }
        Wheel(_) { false }
    }
}

fn kept(e: Entry) -> EntryStep {
    return EntryStep { entry: e, copied: "", changed: false }
}

fn edited(e: Entry, editor: edit.Editor, history: edit.History, typing: bool) -> EntryStep {
    return EntryStep {
        entry: with e { editor: editor, history: history, typing: typing },
        copied: "",
        changed: true
    }
}

fn typed(e: Entry, what: string) -> EntryStep {
    if e.readonly {
        return kept(e)
    }
    // Recorded only at the start of a run, which is what makes the run one undo step.
    val history = if e.typing { e.history } else { edit.record(e.history, e.editor) }
    return edited(e, edit.insert(e.editor, what), history, true)
}

fn pasted(e: Entry, what: string) -> EntryStep {
    if e.readonly {
        return kept(e)
    }
    return edited(e, edit.paste(e.editor, what), edit.record(e.history, e.editor), false)
}

// Which edit a keystroke means.
//
// Dispatched on `Key` rather than on a name, so a mistyped case is a compile error instead of a
// shortcut that quietly never fires. The shortcut *letters* are still compared as text, because a
// letter is what they are: `Char("c")` whatever the layout puts on that key.
fn entry_key(e: Entry, k: Keystroke) -> EntryStep {
    val extend = k.shift
    if k.control {
        val letter = char_of(k.key)
        if letter == "a" { return kept(with e { editor: edit.select_all(e.editor), typing: false }) }
        if letter == "c" { return copied_from(e) }
        if letter == "x" { return cut_from(e) }
        if letter == "z" { return undone(e) }
        if letter == "y" { return redone(e) }
        if Key.is_Left(k.key) { return moved(e, edit.move_word_left(e.editor, extend)) }
        if Key.is_Right(k.key) { return moved(e, edit.move_word_right(e.editor, extend)) }
        if Key.is_Backspace(k.key) { return changed_by(e, edit.delete_word_back(e.editor)) }
    }
    if Key.is_Left(k.key) { return moved(e, edit.move_left(e.editor, extend)) }
    if Key.is_Right(k.key) { return moved(e, edit.move_right(e.editor, extend)) }
    if Key.is_Home(k.key) { return moved(e, edit.move_home(e.editor, extend)) }
    if Key.is_End(k.key) { return moved(e, edit.move_end(e.editor, extend)) }
    if Key.is_Backspace(k.key) { return changed_by(e, edit.delete_back(e.editor)) }
    if Key.is_Delete(k.key) { return changed_by(e, edit.delete_forward(e.editor)) }
    // **The three keys a text area answers and a field does not.**
    //
    // Enter is the sharp one: in a one-line field it must fall through untouched, because that is
    // the key a default button answers and a field that swallowed it would break every form. In a
    // text area it is a newline, and nothing else can type one -- the keyboard sends `Enter`, not
    // `Text("\n")`.
    //
    // Up and Down do nothing in a field on purpose rather than by omission: there is nowhere to go,
    // and a field that moved the caret to one end on Up would be surprising in a form where Up is
    // how a user expects to reach the control above.
    if e.rows > 1 {
        if Key.is_Enter(k.key) { return changed_by(e, edit.insert(e.editor, "\n")) }
        if Key.is_Up(k.key) { return moved(e, edit.move_up(e.editor, extend)) }
        if Key.is_Down(k.key) { return moved(e, edit.move_down(e.editor, extend)) }
    }
    return kept(e)
}

// A caret move ends a typing run but is not a change: a form is not dirty because the user pressed
// an arrow key.
fn moved(e: Entry, editor: edit.Editor) -> EntryStep {
    return kept(with e { editor: editor, typing: false })
}

fn changed_by(e: Entry, editor: edit.Editor) -> EntryStep {
    if e.readonly {
        return kept(e)
    }
    return edited(e, editor, edit.record(e.history, e.editor), false)
}

// Copying changes nothing, which is why it answers the text and the same field back.
fn copied_from(e: Entry) -> EntryStep {
    return EntryStep { entry: with e { typing: false }, copied: taken_from(e), changed: false }
}

// What a copy or a cut hands out. **A masked field hands out nothing**, because a control whose
// whole purpose is that its contents are not shown cannot be the thing that puts them on a
// system-wide clipboard every other program can read. The selection still moves and a cut still
// deletes -- what is refused is the copy, not the editing.
fn taken_from(e: Entry) -> string {
    if e.masked {
        return ""
    }
    return edit.copy(e.editor)
}

fn cut_from(e: Entry) -> EntryStep {
    val text = taken_from(e)
    // **A masked field still cuts**, which is why this asks the editor rather than `text`: `text`
    // is "" for one by design, and keying the no-op off it would turn Ctrl-X into a key that does
    // nothing in the one field where deleting a selection matters most.
    if e.readonly || !edit.has_selection(e.editor) {
        // **A read-only field still copies**, and cutting from one is a copy rather than nothing:
        // the user asked for the text, and refusing to give it is not what read-only means.
        return EntryStep { entry: with e { typing: false }, copied: text, changed: false }
    }
    return EntryStep {
        entry: with e {
            editor: edit.cut(e.editor),
            history: edit.record(e.history, e.editor),
            typing: false
        },
        copied: text,
        changed: true
    }
}

fn undone(e: Entry) -> EntryStep {
    val step = edit.undo(e.history, e.editor)
    return EntryStep {
        entry: with e { editor: step.editor, history: step.history, typing: false },
        copied: "",
        changed: step.editor.text != e.editor.text
    }
}

fn redone(e: Entry) -> EntryStep {
    val step = edit.redo(e.history, e.editor)
    return EntryStep {
        entry: with e { editor: step.editor, history: step.history, typing: false },
        copied: "",
        changed: step.editor.text != e.editor.text
    }
}

// Where the text starts inside the field, which is what a click's x has to be measured from.
fn text_left(bounds: Rect, style: Style) -> float {
    return bounds.x + style.padding.left
}

// Where a press lands in a field: the caret index it means.
//
// **`y` was not read at all**, which is the defect this exists for. A press placed the caret with
// `caret_at_x` over `shown_text` -- correct for one line and nonsense for a text area, where the
// whole text was measured as if it were a single line, so a click on the third row put the caret
// somewhere in the first. Typing then appeared where the user had not clicked.
//
// **The multi-line test is `entry_widget`'s own**, written the same way on purpose: the function
// that decides which widget is built and the function that decides where a press lands must agree
// about what kind of field this is, or a masked field with `rows: 3` would be drawn one way and
// clicked the other.
fn caret_for(e: Entry, style: Style, m: widget.Metrics, bounds: Rect, p: Point) -> int {
    if e.rows > 1 && !e.masked {
        return caret_at_point(e, style, m, bounds, p)
    }
    return caret_at_x(
        shown_text(e),
        style.text.body.size,
        m,
        p.x - text_left(bounds, style),
        style.text.body.face
    )
}

// The caret a point means in a multi-line field: the line from `y`, the column from `x`.
//
// **Every number here is `multi_line_widget`'s own** -- the same line height, the same top inset,
// the same scroll offset -- because a hit test that computed the layout a second time is the bug
// this module keeps designing against. The lines are walked rather than split for that function's
// stated reason: a split throws away the one thing that relates a line to the whole string.
fn caret_at_point(e: Entry, style: Style, m: widget.Metrics, bounds: Rect, p: Point) -> int {
    val line = line_for(m, style.text.body)
    if line <= 0.0 {
        return e.editor.caret
    }
    // The scroll offset, because the first line drawn is not the first line of the text once the
    // field has been scrolled -- and a press is in window coordinates either way.
    val top = bounds.y + style.padding.top - e.scroll
    val text = e.editor.text
    var which = if p.y <= top { 0 } else { ((p.y - top) / line) as int }
    val last = line_count_of(text) - 1
    if which > last {
        which = last
    }
    val start = line_start_of(text, which)
    val stop = edit.line_end(text, start)
    return start +
        caret_at_x(
            substring(text, start, stop),
            style.text.body.size,
            m,
            p.x - text_left(bounds, style),
            style.text.body.face
        )
}

// How many lines the text has: one more than the newlines in it, so an empty string is one line
// and not none.
fn line_count_of(text: string) -> int {
    var at = 0
    var count = 1
    while true {
        val stop = edit.line_end(text, at)
        if stop >= len(text) {
            return count
        }
        at = stop + 1
        count = count + 1
    }
    return count
}

// The index the `which`th line starts at, counting from zero. Clamped to the last line's start
// rather than refusing, because a caller that asked for a line past the end has already been
// clamped by `caret_at_point` and anything else is a caller mistake this cannot repair.
fn line_start_of(text: string, which: int) -> int {
    var at = 0
    var i = 0
    while i < which {
        val stop = edit.line_end(text, at)
        if stop >= len(text) {
            return at
        }
        at = stop + 1
        i = i + 1
    }
    return at
}

// The caret index a pixel offset into the text means.
//
// **The nearest boundary, not the character the pixel is inside.** Clicking the left half of a
// character puts the caret before it and the right half after it, which is what every text field
// does and what a user means by clicking "between" two letters. Taking the character the pixel
// landed in instead makes the caret feel one place behind the pointer, which is the kind of thing
// nobody reports and everybody notices.
//
// Measured as prefixes rather than as a sum of per-character widths, because a sum ignores kerning
// and would disagree with the layout that drew the text. That makes this O(n^2) in the length of
// the field, which is the right trade for one line of text and the wrong one for a document.
pub fn caret_at_x(text: string, size: float, m: widget.Metrics, x: float) -> int {
    return caret_at_x(text, size, m, x, 0)
}

// The same, measuring in a named face.
//
// **A fifth argument rather than a changed signature**: the four-argument form is what a caller
// with one face wants, which is most of them, and an entry in a second face is the one that has to
// say so. `entry_input` passes `style.text.body.face`, so a field drawn in a face measures its clicks
// in the same one -- a caret placed by the wrong face's widths lands between the wrong letters,
// and only on the text where the two faces differ.
pub fn caret_at_x(text: string, size: float, m: widget.Metrics, x: float, face: int) -> int {
    if x <= 0.0 {
        return 0
    }
    val n = len(text)
    var i = 0
    while i < n {
        val before = widget.width_in(m, face, substring(text, 0, i), size)
        val after = widget.width_in(m, face, substring(text, 0, i + 1), size)
        if x < (before + after) / 2.0 {
            return i
        }
        i = i + 1
    }
    return n
}

// The three runs a field without a composition draws: before the selection, the selection, after
// it -- with the caret standing in for the selection when there is none.
// One run of a field's text, split wherever an `Ink` covers part of it.
//
// **Every piece of text a field draws goes through here**, which is the point: the selection, the
// caret's two halves and a whole line are each a range of the text, and colouring is a property of
// the text rather than of why it was cut. A run with no ink in it is a single label and not a
// group of one, so a field that uses no colour lays out exactly as it did before this existed.
fn inked_run(e: Entry, text: string, from_at: int, to_at: int, ink: Color, style: Style) -> widget.Widget {
    if len(e.inks) == 0 || e.masked || to_at <= from_at {
        return widget.label_in_face(substring(text, from_at, to_at), style.text.body.size, ink, style.text.body.face)
    }
    val parts = mutable_array_new<widget.Widget>()
    var at = from_at
    var i = 0
    while i < len(e.inks) {
        val span = e.inks[i]
        val lo = if span.from < at { at } else { span.from }
        val hi = if span.to > to_at { to_at } else { span.to }
        if hi > lo && lo >= at {
            if lo > at {
                push(
                    parts,
                    widget.label_in_face(substring(text, at, lo), style.text.body.size, ink, style.text.body.face)
                )
            }
            push(
                parts,
                widget.label_in_face(substring(text, lo, hi), style.text.body.size, span.colour, style.text.body.face)
            )
            at = hi
        }
        i = i + 1
    }
    if at < to_at {
        push(parts, widget.label_in_face(substring(text, at, to_at), style.text.body.size, ink, style.text.body.face))
    }
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        // Zero, as the row above it is: any spacing here would put a gap inside a word.
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: widget.stretched(),
        children: snapshot(parts),
        name: ""
    })
}

fn selected_runs(e: Entry, text: string, ink: Color, style: Style, line: float) -> [widget.Widget] {
    val from = edit.selection_start(e.editor)
    val to = edit.selection_end(e.editor)
    val middle = if edit.has_selection(e.editor) {
        tinted(
            substring(text, from, to),
            // **A colour, because this tints a run of glyphs** rather than filling a box: see
            // `paint.flat_of`, which is for exactly the callers a gradient buys nothing.
            paint.flat_of(style.states.selected.face),
            style.states.selected.ink,
            style,
            "selection"
        )
    } else {
        caret_box(ink, line)
    }
    return [
        inked_run(e, text, 0, from, ink, style),
        middle,
        inked_run(e, text, to, len(text), ink, style)
    ]
}

// A field with a composition open: the committed text either side of it, the composition tinted,
// the run being converted tinted more strongly, and the caret **inside** the composition.
//
// **Built from `shown_text` and `edit.shown_caret` and nothing else**, which is the rule that
// keeps a caret where it looks: the press that places one measures the same string this draws, so
// the two cannot disagree about where a character begins.
fn composed_runs(e: Entry, text: string, ink: Color, style: Style, line: float) -> [widget.Widget] {
    val out = mutable_array_new<widget.Widget>()
    val caret = shown_caret_at(e)
    val span = edit.shown_highlight(e.editor, e.preedit)
    val marks = switch span {
        Some(one) { [one.start, one.end] }
        None { [caret, caret] }
    }
    val starts = composition_bounds(e, text)
    // Every boundary the runs are cut at, in order: the composition's ends, the marked run's
    // ends, and the caret.
    var cut = 0
    for edge in sorted_edges([starts[0], starts[1], marks[0], marks[1], caret], len(text)) {
        if edge > cut {
            push(out, run_between(e, text, cut, edge, starts, marks, ink, style))
            cut = edge
        }
        if edge == caret {
            push(out, caret_box(ink, line))
        }
    }
    if cut < len(text) {
        push(out, run_between(e, text, cut, len(text), starts, marks, ink, style))
    }
    return snapshot(out)
}

// Where the composition sits in what is shown.
fn composition_bounds(e: Entry, text: string) -> [int] {
    switch e.preedit {
        Some(p) {
            val at = if p.at > len(e.editor.text) { len(e.editor.text) } else { p.at }
            return [at, at + len(p.text)]
        }
        None { return [0, 0] }
    }
}

fn run_between(
    e: Entry,
    text: string,
    from: int,
    to: int,
    starts: [int],
    marks: [int],
    ink: Color,
    style: Style
) -> widget.Widget {
    val piece = substring(text, from, to)
    if from >= marks[0] && to <= marks[1] && marks[0] != marks[1] {
        return tinted(piece, style.converting_face, ink, style, "converting")
    }
    if from >= starts[0] && to <= starts[1] {
        return tinted(piece, style.composing_face, ink, style, "composing")
    }
    return widget.label_in_face(piece, style.text.body.size, ink, style.text.body.face)
}

fn tinted(piece: string, face: Color, ink: Color, style: Style, name: string) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.filled(face),
        align: widget.stretched(),
        children: [widget.label_in_face(piece, style.text.body.size, ink, style.text.body.face)],
        name: name
    })
}

fn caret_box(ink: Color, line: float) -> widget.Widget {
    return widget.fixed_of(1.0, line, widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.filled(ink),
        align: widget.stretched(),
        children: [],
        name: caret_name
    }))
}

// The cut points in order and without repeats, clamped into the text. Small and sorted by hand:
// there are five of them and they are nearly sorted already.
fn sorted_edges(edges: [int], n: int) -> [int] {
    val kept = mutable_array_new<int>()
    var value = 0
    while value <= n {
        for edge in edges {
            if edge == value && !contains(kept, value) {
                push(kept, value)
            }
        }
        value = value + 1
    }
    return snapshot(kept)
}

// **`caret_name` moved to `widget` on 2026-11-15** and is `widget.caret_name`. It names the box
// this module puts in the tree, but what reads it is the painter -- a caret is drawn only for the
// control that has the focus -- so the constant belongs to the layer that decides.

// The field as a widget.
//
// **The caret is placed by the layout rather than computed.** The row is the text before the caret,
// then a one-unit box, then the text after it -- so the same metrics that measure the text place the
// caret, and the two cannot drift apart. Computing a caret's x separately is how a caret ends up
// half a character off in one font and right in another.
//
// A selection is the same trick: the selected run is its own label with a background behind it.
//
// Takes a `Metrics` where `button_widget` does not, because a caret's height is a text measurement
// and guessing it from the em size is wrong for any face whose line height is not 1.2.
// One line of a multi-line field: the part before the selection, the selected part or the caret,
// and the part after -- the same three pieces `entry_widget` lays out for a single line, clamped to
// this line's range.
fn entry_line(
    e: Entry,
    from_at: int,
    to_at: int,
    on_this_line: bool,
    ink: Color,
    style: Style,
    line: float
) -> widget.Widget {
    val text = e.editor.text
    val sel_from = edit.selection_start(e.editor)
    val sel_to = edit.selection_end(e.editor)
    val selected = edit.has_selection(e.editor)
    // The selection clipped to this line. Both ends are pinned inside it, so a selection that
    // starts above and ends below colours the whole line and one that misses it entirely collapses
    // to nothing.
    val lo = if sel_from < from_at { from_at } else { if sel_from > to_at { to_at } else { sel_from } }
    val hi = if sel_to < from_at { from_at } else { if sel_to > to_at { to_at } else { sel_to } }
    val pieces = mutable_array_new<widget.Widget>()
    if selected && hi > lo {
        push(pieces, inked_run(e, text, from_at, lo, ink, style))
        push(pieces, widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Row,
            spacing: 0.0,
            padding: widget.no_insets(),
            surface: widget.filled(paint.flat_of(style.states.selected.face)),
            align: widget.stretched(),
            children: [inked_run(e, text, lo, hi, ink, style)],
            name: "selection"
        }))
        push(pieces, inked_run(e, text, hi, to_at, ink, style))
    } else {
        if !selected && on_this_line {
            val caret = e.editor.caret
            push(pieces, inked_run(e, text, from_at, caret, ink, style))
            push(pieces, widget.fixed_of(1.0, line, widget.Widget.Group(widget.Stack {
                direction: widget.Direction.Row,
                spacing: 0.0,
                padding: widget.no_insets(),
                surface: widget.filled(ink),
                align: widget.stretched(),
                children: [],
                name: caret_name
            })))
            push(pieces, inked_run(e, text, caret, to_at, ink, style))
        } else {
            push(pieces, inked_run(e, text, from_at, to_at, ink, style))
        }
    }
    return widget.fixed_of(0.0, line, widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: widget.stretched(),
        children: snapshot(pieces),
        name: ""
    }))
}

fn multi_line_widget(e: Entry, style: Style, parts: Parts, m: widget.Metrics) -> widget.Widget {
    val ink = parts.ink
    val line = line_for(m, style.text.body)
    val text = e.editor.text
    val caret_line = edit.line_index(text, e.editor.caret)
    val lines = mutable_array_new<widget.Widget>()
    var at = 0
    var index = 0
    // Walks the text by line rather than splitting it, because the widget needs each line's
    // *indices* and not just its characters: the caret and the selection are positions in the whole
    // string, and a split would throw away the only thing that relates them to a line.
    var more = true
    while more {
        val stop = edit.line_end(text, at)
        push(lines, entry_line(e, at, stop, index == caret_line, ink, style, line))
        if stop >= len(text) {
            more = false
        } else {
            at = stop + 1
            index = index + 1
        }
    }
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: padded_for(style),
        surface: surface_of(style, parts),
        align: widget.stretched(),
        children: snapshot(lines),
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: e.name,
        role: widget.Role.TextField,
        label: e.label,
        description: "",
        value: text,
        state: with widget.no_state() { disabled: e.disabled, readonly: e.readonly, multiline: true },
        focus_part: "",
        tab_stop: true,
        child: widget.named_scroll(concat(e.name, "-scroll"), 0.0, e.scroll, inside)
    })
}

// The box a field's text is drawn in, without the control around it.
//
// **Separate so that a field can be something other than a text field.** The number field is a
// text field in everything but what it draws beside itself, what `Role` it declares and what it
// accepts -- which is the argument `masked` and `rows` already make -- so it needs this box under
// a `SpinButton` rather than a second copy of the caret, the selection and the preedit.
fn entry_inside(runs: [widget.Widget], style: Style, parts: Parts) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        // Zero, and it has to be: any spacing here would push the caret off the boundary it marks.
        spacing: 0.0,
        padding: padded_for(style),
        surface: surface_of(style, parts),
        align: widget.stretched(),
        children: runs,
        name: ""
    })
}

// The runs a one-line field draws: its text, its selection and its caret. Shared with the number
// field, which draws the same text in the same way under a different role.
fn field_runs(e: Entry, style: Style, parts: Parts, m: widget.Metrics) -> [widget.Widget] {
    val line = line_for(m, style.text.body)
    val text = shown_text(e)
    if Option.is_Some(e.preedit) {
        return composed_runs(e, text, parts.ink, style, line)
    }
    return selected_runs(e, text, parts.ink, style, line)
}

pub fn entry_widget(e: Entry, f: Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    // **A masked field takes the one-line path whatever `rows` says.** A multi-line password is
    // not a thing, and `multi_line_widget` draws the text -- so leaving `rows` able to decide
    // would leave a way to build a field that masks in one place and not the other.
    val parts = parts_for(style, mood_of(e.disabled, false, false, hovered_in(f, e.name)))
    if e.rows > 1 && !e.masked {
        return multi_line_widget(e, style, parts, m)
    }
    // **A field is never selecting and composing at once**, which is not a simplification taken
    // but one the model gives: `edit.compose` deletes a selection before it opens a composition,
    // because that is what typing over one does. So the runs are one case or the other.
    val text = shown_text(e)
    val runs = field_runs(e, style, parts, m)
    val inside = entry_inside(runs, style, parts)
    return widget.Widget.Control(widget.Focusable {
        name: e.name,
        role: if e.masked { widget.Role.Password } else { widget.Role.TextField },
        label: e.label,
        description: "",
        // The field's content, which is what a reader says after the name -- and for a masked
        // field that is `text`, which is already the bullets. **The secret never enters the
        // accessibility tree at all**, rather than entering it and being filtered somewhere
        // downstream: a reader, a remote bridge and a test dump all read this one string, and
        // there is no second place to remember.
        value: text,
        state: with widget.no_state() { disabled: e.disabled, readonly: e.readonly },
        focus_part: "",
        tab_stop: true,
        child: inside
    })
}

// -------------------------------------------------------------------- the list

// A list of rows, one of them selected, scrolled by itself.
//
// **One tab stop with two hundred accessibility nodes.** The list takes the focus; the arrow keys
// move the selection inside it; each row is a `widget.part_of` -- a control a click and a reader can
// reach and Tab cannot. That distinction did not exist before this widget needed it, and the
// alternative was a list that either put two hundred stops in the tab order or announced all two
// hundred rows as its own name.
pub struct List {
    name: string
    label: string
    items: [string]
    // The selected row, or -1 for none -- which is a real state, not an error: an empty list has no
    // selection, and neither does one the user has not touched.
    selected: int
    // How far the rows have scrolled, in the same units the layout uses. Not a row index: a list
    // scrolled by whole rows cannot show half of one, and half of one is what tells a user there is
    // more below.
    offset: float
    disabled: bool
    // What a reader calls this and its rows.
    //
    // **Fields rather than constants, so a menu can be a list.** A menu's popup is a list of rows
    // with one highlighted, scrolled when it is long, driven by the same arrows -- all of which is
    // `List` already. The only honest difference is what a screen reader should call it, so that is
    // the only thing a menu has to change. Duplicating the selection, the scrolling and the key
    // handling to rename two roles would have been the alternative.
    role: widget.Role
    item_role: widget.Role
    // The drag state of the bar down its right edge, as a tree has.
    bar: ScrollBar
}

pub fn list_of(name: string, label: string, items: [string]) -> List {
    return List {
        name: name,
        label: label,
        items: items,
        selected: if len(items) == 0 { 0 - 1 } else { 0 },
        offset: 0.0,
        disabled: false,
        role: widget.Role.List,
        item_role: widget.Role.ListItem,
        bar: scroll_bar_of(concat(name, "/bar"), 20.0)
    }
}

pub struct ListStep {
    list: List
    // The selection changed. An output, as `ButtonStep.activated` is: the application acts on it
    // and stores the list.
    moved: bool
    // A row was chosen -- Enter on the selection. Separate from `moved`, because selecting a row and
    // opening it are different intentions and a list that conflated them would open on every arrow
    // key.
    activated: bool
}

// What an input does to a list.
//
// `bounds` is the box the layout gave it, needed for two things: turning a click's y into a row,
// and knowing how far one page is. `m` is what a row is measured with: see `row_height`, which the
// widget lays the rows out by, so the hit test and the layout cannot disagree.
pub fn list_input(l: List, input: Input, bounds: Rect, f: Frame) -> ListStep {
    val style = f.style
    val m = f.metrics
    if l.disabled {
        return held_still(l)
    }
    val tall = row_height(m, style)
    // The bar first, and a drag in progress before anything else -- see `tree_input`, which has
    // the same three lines for the same reasons.
    if Option.is_Some(l.bar.grabbed) || list_for_the_bar(l, input, style, bounds, tall) {
        return list_bar_step(l, input, bounds, tall, f)
    }
    val last = len(l.items) - 1
    return switch input {
        // **The wheel scrolls and does not move the selection.** Every list does this and it is
        // easy to get wrong by routing a wheel to whatever has the keyboard: a user scrolling to
        // look at something further down has not asked to select it, and a list that moved the
        // selection under them would lose the row they were about to act on.
        Wheel(w) { scrolled(l, l.offset - (w.vertical as float) * tall, bounds, tall) }
        Press(p) {
            val row = floor((p.y - bounds.y + l.offset) / tall)
            if row < 0 || row > last {
                held_still(l)
            } else {
                ListStep { list: with l { selected: row }, moved: row != l.selected, activated: false }
            }
        }
        KeyDown(k) { list_key(l, k, bounds, tall) }
        KeyUp(_) { held_still(l) }
        Text(_) { held_still(l) }
        Paste(_) { held_still(l) }
        Release(_) { held_still(l) }
        Move(_) { held_still(l) }
    }
}

fn list_for_the_bar(l: List, input: Input, style: Style, bounds: Rect, tall: float) -> bool {
    if Press(p) = input {
        return on_the_bar(style, bounds, p, list_content(l, tall), bounds.height)
    }
    return false
}

fn list_content(l: List, tall: float) -> float {
    return (len(l.items) as float) * tall
}

fn list_bar_step(l: List, input: Input, bounds: Rect, tall: float, f: Frame) -> ListStep {
    val style = f.style
    val taken = scroll_bar_input(
        l.bar,
        input,
        bar_box(style, bounds),
        list_content(l, tall),
        bounds.height,
        l.offset,
        f
    )
    // A bar moves the view and never the selection, as a tree's does.
    return ListStep {
        list: with l { bar: taken.bar, offset: taken.offset },
        moved: false,
        activated: false
    }
}

fn list_key(l: List, k: Keystroke, bounds: Rect, tall: float) -> ListStep {
    val last = len(l.items) - 1
    if last < 0 {
        return held_still(l)
    }
    val per_page = page_rows(l, bounds, tall)
    if Key.is_Down(k.key) { return selected_to(l, l.selected + 1, bounds, tall) }
    if Key.is_Up(k.key) { return selected_to(l, l.selected - 1, bounds, tall) }
    if Key.is_PageDown(k.key) { return selected_to(l, l.selected + per_page, bounds, tall) }
    if Key.is_PageUp(k.key) { return selected_to(l, l.selected - per_page, bounds, tall) }
    if Key.is_Home(k.key) { return selected_to(l, 0, bounds, tall) }
    if Key.is_End(k.key) { return selected_to(l, last, bounds, tall) }
    if Key.is_Enter(k.key) || Key.is_Space(k.key) {
        if l.selected >= 0 {
            return ListStep { list: l, moved: false, activated: true }
        }
    }
    return held_still(l)
}

// At least one row a page, so a list shorter than one row still moves rather than sticking.
fn page_rows(l: List, bounds: Rect, tall: float) -> int {
    val fits = floor(bounds.height / tall)
    return if fits < 1 { 1 } else { fits }
}

// Moves the selection and **brings it into view by the least that works**, which is what makes
// arrowing down a long list creep by a row at the bottom edge instead of jumping a page at a time.
fn selected_to(l: List, want: int, bounds: Rect, tall: float) -> ListStep {
    val last = len(l.items) - 1
    val row = if want < 0 { 0 } else { if want > last { last } else { want } }
    val revealed = widget.scroll_to_reveal(
        bounds.height,
        l.offset,
        (row as float) * tall,
        tall
    )
    return ListStep {
        list: with l { selected: row, offset: clamped(l, revealed, bounds, tall) },
        moved: row != l.selected,
        activated: false
    }
}

fn scrolled(l: List, offset: float, bounds: Rect, tall: float) -> ListStep {
    return ListStep {
        list: with l { offset: clamped(l, offset, bounds, tall) },
        moved: false,
        activated: false
    }
}

fn clamped(l: List, offset: float, bounds: Rect, tall: float) -> float {
    return widget.clamp_offset(offset, bounds.height, (len(l.items) as float) * tall)
}

fn held_still(l: List) -> ListStep {
    return ListStep { list: l, moved: false, activated: false }
}

// The list as a widget: a control holding a viewport of rows, each row a part of the list.
//
// **The rows carry `selected` rather than the list carrying an index**, because that is what a
// reader reads: it announces "list item, Ada, selected", and an index on the container would make
// every adapter work out for itself which child the number meant.
pub fn list_widget(l: List, f: Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    val tall = row_height(m, style)
    val rows = mutable_array_new<widget.Widget>()
    var i = 0
    while i < len(l.items) {
        val chosen = i == l.selected
        val row_parts = parts_for(
            style,
            mood_of(
                l.disabled,
                pressed_in(f, row_name(l, i)),
                chosen,
                hovered_in(f, row_name(l, i))
            )
        )
        val row = widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Row,
            spacing: 0.0,
            // **The row's own air, on the space scale** -- `s` beside the text and half of it above
            // and below, which is the 4/2/4/2 this was written as and now follows the density. It
            // is also what keeps a row from clipping its label: `row_height` is a line plus `s`,
            // and `xs` twice is `s` on any scale where `xs` is half of it.
            padding: widget.insets_of(style.space.s, style.space.xs, style.space.s, style.space.xs),
            surface: band_of(style, row_parts),
            align: widget.stretched(),
            // **The row's own ink, not the list's.** A face from one row and a word from another
            // is the half-implemented state the rows exist to prevent -- and a look whose
            // selection is the accent needs `on_accent` here or the text vanishes into it.
            children: [widget.label_in_face(l.items[i], style.text.body.size, row_parts.ink, style.text.body.face)],
            name: ""
        })
        push(rows, widget.fixed_of(
            0.0,
            tall,
            widget.part_of(
                row_name(l, i),
                l.item_role,
                l.items[i],
                with widget.no_state() { selected: chosen, disabled: l.disabled },
                row
            )
        ))
        i = i + 1
    }
    return widget.Widget.Control(widget.Focusable {
        name: l.name,
        role: l.role,
        label: l.label,
        description: "",
        value: "",
        state: with widget.no_state() { disabled: l.disabled },
        focus_part: "",
        tab_stop: true,
        child: widget.named_scroll("", 0.0, l.offset, widget.column_of(0.0, snapshot(rows)))
    })
}

// A row's name, which focus and accessibility both address it by. The list's name and the index,
// because a row has no name of its own and an index alone would collide with another list's.
pub fn row_name(l: List, index: int) -> string {
    return concat(l.name, "/", str(index))
}

// -------------------------------------------------------------------- the tabs

// A strip of tabs, one of them selected, choosing what is shown beneath it.
//
// **Selection follows the focus.** Arrowing along the strip changes what is shown, with no second
// keystroke to confirm -- the automatic-activation model, which is the one to use unless revealing
// a panel is expensive. So `TabStep` reports only that the selection `moved`, and there is no
// `activated` beside it: a tab that had to be opened as well as reached is the manual model, and
// nothing has asked for it.
//
// **One tab stop, as a list is**: Tab reaches the strip and the arrows move within it, so a window
// with four tabs does not spend four stops on them. Each tab is a `widget.part_of` -- something a
// click and a reader can reach and Tab cannot.
//
// **Not a `List` with another role**, though a menu is one. A menu differs from a list only in what
// a reader calls it, which is why `List.role` is a field; a tab strip differs in three ways -- it
// runs along a row, its arrows are Left and Right, and it does not scroll -- and three differences
// is a control.
pub struct Tabs {
    name: string
    label: string
    items: [string]
    // The selected tab. **Not -1**, unlike a list's: a strip says what is shown beneath it, and
    // "nothing is shown" is not a state a tab strip can be in. A strip with no tabs is the one
    // exception, and an application with no tabs should not be building one.
    selected: int
    // The width of every tab. **One number, used by both the widget and the hit test**, which is
    // what keeps a click landing on the tab it looks like it landed on: tabs measured to fit their
    // own labels would need the font metrics in `tabs_input` as well, and a layout computed twice
    // is a layout that can disagree with itself. A caller wanting a snug strip sets this to fit
    // the longest label.
    tab_width: float
    disabled: bool
}

pub fn tabs_of(name: string, label: string, items: [string]) -> Tabs {
    return Tabs {
        name: name,
        label: label,
        items: items,
        selected: 0,
        tab_width: 100.0,
        disabled: false
    }
}

pub struct TabStep {
    tabs: Tabs
    // The selection changed, so what is beneath the strip has to change with it.
    moved: bool
}

// What an input does to a tab strip.
//
// `bounds` is the box the layout gave the strip, which turns a press's x into a tab -- the same
// trick `list_input` plays with y and `row_height`, and sound for the same reason: the widget lays
// every tab out at `tab_width` from the strip's left edge, so the arithmetic here is the layout's
// own and not a guess at it.
//
// **A press selects, where a button fires on the release.** Dragging off a tab and letting go still
// leaves it chosen, which is what every tab strip does and what a list does here: a tab is a place
// to be rather than an action to commit to, so there is nothing to cancel.
pub fn tabs_input(t: Tabs, input: Input, bounds: Rect) -> TabStep {
    if t.disabled {
        return tabs_still(t)
    }
    return switch input {
        Press(p) {
            val at = floor((p.x - bounds.x) / t.tab_width)
            if at < 0 || at >= len(t.items) {
                tabs_still(t)
            } else {
                tabs_to(t, at)
            }
        }
        KeyDown(k) { tabs_key(t, k) }
        KeyUp(_) { tabs_still(t) }
        Text(_) { tabs_still(t) }
        Paste(_) { tabs_still(t) }
        Release(_) { tabs_still(t) }
        Move(_) { tabs_still(t) }
        // **A wheel over a tab strip does nothing.** Some toolkits cycle the tabs with it; the
        // result is a user scrolling a page and changing what the page is.
        Wheel(_) { tabs_still(t) }
    }
}

fn tabs_key(t: Tabs, k: Keystroke) -> TabStep {
    val last = len(t.items) - 1
    if last < 0 {
        return tabs_still(t)
    }
    if Key.is_Right(k.key) { return tabs_to(t, t.selected + 1) }
    if Key.is_Left(k.key) { return tabs_to(t, t.selected - 1) }
    if Key.is_Home(k.key) { return tabs_to(t, 0) }
    if Key.is_End(k.key) { return tabs_to(t, last) }
    return tabs_still(t)
}

// Clamped rather than wrapped, as the list's arrows are. The end of a strip is a place a user can
// feel, and a Right that jumped back to the first tab takes that away to save one keystroke.
fn tabs_to(t: Tabs, want: int) -> TabStep {
    val last = len(t.items) - 1
    val at = if want < 0 { 0 } else { if want > last { last } else { want } }
    return TabStep { tabs: with t { selected: at }, moved: at != t.selected }
}

fn tabs_still(t: Tabs) -> TabStep {
    return TabStep { tabs: t, moved: false }
}

// The strip as a widget: a `TabList` control holding one `Tab` part per label.
//
// The parts carry `selected`, as a list's rows do, because that is what a reader reads -- "tab,
// History, selected" -- and an index on the container would make every adapter work out for itself
// which child the number meant.
pub fn tabs_widget(t: Tabs, f: Frame) -> widget.Widget {
    val style = f.style
    val cells = mutable_array_new<widget.Widget>()
    var i = 0
    while i < len(t.items) {
        val chosen = i == t.selected
        val tab_parts = parts_for(
            style,
            mood_of(t.disabled, pressed_in(f, tab_name(t, i)), chosen, hovered_in(f, tab_name(t, i)))
        )
        // **A card, not a face.** See `tab_face_of`: the chosen tab wears the body's own colour
        // and is rounded along its top only, which is what makes a strip read as index cards
        // instead of as a segmented button.
        val cell = widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Row,
            spacing: 0.0,
            // **Shallower than a button's**, by the spacing step: a tab is a label on a card and
            // a button is a target, and a strip of button-sized tabs is a toolbar. The sides keep
            // the theme's padding so the titles do not crowd each other.
            padding: widget.insets_of(
                style.padding.left,
                style.padding.top - style.space.s,
                style.padding.right,
                style.padding.bottom - style.space.s
            ),
            surface: tab_face_of(style, tab_parts, chosen),
            align: widget.stretched(),
            children: [widget.label_in_face(t.items[i], style.text.label.size, tab_parts.ink, style.text.label.face)],
            name: ""
        })
        // **`wide_of`, not `fixed_of(width, 0)`.** A tab states its width so the strip divides
        // evenly and measures its own height from its label and padding; written the other way it
        // is a tab of no height that looks right only inside a parent that stretches it, which is
        // how the strip vanished the moment a design file stopped forcing a row height.
        push(cells, widget.wide_of(
            t.tab_width,
            widget.part_of(
                tab_name(t, i),
                widget.Role.Tab,
                t.items[i],
                with widget.no_state() { selected: chosen, disabled: t.disabled },
                cell
            )
        ))
        i = i + 1
    }
    return widget.Widget.Control(widget.Focusable {
        name: t.name,
        role: widget.Role.TabList,
        label: t.label,
        description: "",
        value: "",
        state: with widget.no_state() { disabled: t.disabled },
        // **The chosen tab, not the strip.** One control takes the focus and Left and Right move
        // along it, so a ring around the whole strip says all four tabs are focused when one of
        // them is.
        focus_part: tab_name(t, t.selected),
        tab_stop: true,
        // **No spacing between the tabs**, because the hit test divides the strip by `tab_width`
        // and a gap would put a dead stripe between two tabs that the arithmetic here cannot see.
        child: widget.row_of(0.0, snapshot(cells))
    })
}

// A tab's name, which focus and accessibility both address it by. The strip's name and the index,
// as a list's rows are: a tab has no name of its own and a bare index would collide with another
// strip's.
pub fn tab_name(t: Tabs, index: int) -> string {
    return concat(t.name, "/", str(index))
}

// -------------------------------------------------------------------- the tree

// A row of a tree, as the application hands it over.
//
// **Flat with a depth, not nested.** A nested structure would have to be walked to draw, walked to
// hit-test and walked again to move the selection, and every one of those walks is the same
// projection -- the rows in order, with the ones under a closed branch left out. Doing it once, as
// a list, is what lets the rest of this control be the list's code with an indent.
pub struct TreeRow {
    label: string
    // How deep, 0 at the top.
    depth: int
    // Whether it can be opened. **Declared rather than worked out from the next row's depth**,
    // because a branch with nothing in it yet is still a branch: a tree that inferred this would
    // draw an empty folder as a leaf, and a user would have no way to see that it is empty rather
    // than missing.
    expandable: bool
    expanded: bool
}

pub fn tree_row(label: string, depth: int) -> TreeRow {
    return TreeRow { label: label, depth: depth, expandable: false, expanded: false }
}

pub fn tree_branch(label: string, depth: int, expanded: bool) -> TreeRow {
    return TreeRow { label: label, depth: depth, expandable: true, expanded: expanded }
}

// A tree: rows at depths, branches that open and close, one selected.
//
// **One tab stop and a node per visible row**, which is `List`'s bargain again. Not a `List` with
// a depth, though: the arrows mean different things here -- Left closes a branch or climbs to its
// parent, Right opens one or steps into it -- and that contract is the difference between a tree
// and an indented list.
pub struct Tree {
    name: string
    label: string
    rows: [TreeRow]
    // The selected row, **as an index into `rows` and not into the visible ones**. Collapsing a
    // branch must not silently move the selection onto a different thing, and an index into a
    // projection does exactly that.
    selected: int
    offset: float
    // The drag state of the bar down its right edge. **Only the drag**: where the thumb sits
    // comes from `offset` and the row count, which this already has, and a second copy of either
    // is a second thing to keep in step.
    bar: ScrollBar
    disabled: bool
}

pub fn tree_of(name: string, label: string, rows: [TreeRow]) -> Tree {
    return Tree {
        name: name,
        label: label,
        rows: rows,
        selected: if len(rows) == 0 { 0 - 1 } else { 0 },
        offset: 0.0,
        bar: scroll_bar_of(concat(name, "/bar"), 20.0),
        disabled: false
    }
}

// The rows that are on screen, in order, as indices into `rows`: everything except what sits under
// a closed branch. **One pass, not a visibility test per row** -- the test is "is any ancestor
// closed", and walking back up from each row to answer it is the same walk done n times.
pub fn visible_rows(t: Tree) -> [int] {
    val out = mutable_array_new<int>()
    // The depth of the closed branch currently hiding things, or -1.
    var hidden_under = 0 - 1
    var i = 0
    while i < len(t.rows) {
        val row = t.rows[i]
        if hidden_under >= 0 && row.depth > hidden_under {
            i = i + 1
        } else {
            hidden_under = 0 - 1
            push(out, i)
            if row.expandable && !row.expanded {
                hidden_under = row.depth
            }
            i = i + 1
        }
    }
    return snapshot(out)
}

pub struct TreeStep {
    tree: Tree
    // The selection changed.
    moved: bool
    // A row was chosen -- Enter or Space on it. A branch opening is not a choice.
    activated: bool
    // A branch was opened or closed, which is a different thing from either: what is on screen
    // changed and the selection did not.
    toggled: bool
}

// What an input does to a tree.
//
// `bounds` turns a press into a row the way the list does, and into a *column* besides: a press on
// the mark at the left of a branch opens or closes it, and a press anywhere else on the row selects
// it. Both computed from `indent_for`, which the widget also lays out by, as `row_height` is for
// the rows -- and `m` is what measures a row: see `row_height`.
pub fn tree_input(t: Tree, input: Input, bounds: Rect, f: Frame) -> TreeStep {
    val style = f.style
    val m = f.metrics
    if t.disabled {
        return tree_still(t)
    }
    val tall = row_height(m, style)
    // **The bar first, and a drag in progress before anything else.** A press that took hold of
    // the thumb moved the focus to the tree, so the moves and the release that follow are routed
    // here -- and they have to reach the bar wherever the pointer has wandered to, or a thumb
    // dragged off the strip is left holding on while the rows move under the pointer instead.
    if dragging_bar(t) || for_the_bar(t, input, style, bounds, tall) {
        return bar_step(t, input, bounds, tall, f)
    }
    return switch input {
        Wheel(w) { tree_scrolled(t, t.offset - (w.vertical as float) * tall, bounds, tall) }
        Press(p) { tree_pressed(t, p, style, bounds, tall) }
        KeyDown(k) { tree_key(t, k, bounds, tall) }
        KeyUp(_) { tree_still(t) }
        Text(_) { tree_still(t) }
        Paste(_) { tree_still(t) }
        Release(_) { tree_still(t) }
        Move(_) { tree_still(t) }
    }
}

fn dragging_bar(t: Tree) -> bool {
    return Option.is_Some(t.bar.grabbed)
}

// Only a press decides: a wheel over the strip should scroll the tree the ordinary way, and a key
// is aimed at nothing in particular.
fn for_the_bar(t: Tree, input: Input, style: Style, bounds: Rect, tall: float) -> bool {
    if Press(p) = input {
        return on_the_bar(style, bounds, p, tree_content(t, tall), bounds.height)
    }
    return false
}

fn tree_content(t: Tree, tall: float) -> float {
    return (len(visible_rows(t)) as float) * tall
}

fn bar_step(t: Tree, input: Input, bounds: Rect, tall: float, f: Frame) -> TreeStep {
    val style = f.style
    val taken = scroll_bar_input(
        t.bar,
        input,
        bar_box(style, bounds),
        tree_content(t, tall),
        bounds.height,
        t.offset,
        f
    )
    return TreeStep {
        tree: with t { bar: taken.bar, offset: taken.offset },
        // **A bar moves the view, never the selection.** Dragging a scrollbar in any list on any
        // platform leaves the highlighted row where it was, and moving it here would make a drag
        // a destructive gesture in a tree whose selection loads a request.
        moved: false,
        activated: false,
        toggled: false
    }
}

// The strip the bar lives in, which is where `paint_scroll_bars` draws it.
fn bar_box(style: Style, bounds: Rect) -> Rect {
    return geom.rect_of(
        bounds.x + bounds.width - style.space.m,
        bounds.y,
        style.space.m,
        bounds.height
    )
}

fn tree_pressed(t: Tree, p: Point, style: Style, bounds: Rect, tall: float) -> TreeStep {
    val shown = visible_rows(t)
    val at = floor((p.y - bounds.y + t.offset) / tall)
    if at < 0 || at >= len(shown) {
        return tree_still(t)
    }
    val which = shown[at]
    val row = t.rows[which]
    val indent = indent_for(style)
    // The mark sits in the one indent-wide column at this row's own depth.
    val mark_from = bounds.x + (row.depth as float) * indent
    if row.expandable && p.x >= mark_from && p.x < mark_from + indent {
        return tree_toggled(t, which)
    }
    return TreeStep {
        tree: with t { selected: which },
        moved: which != t.selected,
        activated: false,
        toggled: false
    }
}

fn tree_key(t: Tree, k: Keystroke, bounds: Rect, tall: float) -> TreeStep {
    val shown = visible_rows(t)
    if len(shown) == 0 {
        return tree_still(t)
    }
    val per_page = tree_page_rows(t, bounds, tall)
    val here = shown_index_of(shown, t.selected)
    if Key.is_Down(k.key) { return tree_to(t, shown, here + 1, bounds, tall) }
    if Key.is_Up(k.key) { return tree_to(t, shown, here - 1, bounds, tall) }
    if Key.is_PageDown(k.key) { return tree_to(t, shown, here + per_page, bounds, tall) }
    if Key.is_PageUp(k.key) { return tree_to(t, shown, here - per_page, bounds, tall) }
    if Key.is_Home(k.key) { return tree_to(t, shown, 0, bounds, tall) }
    if Key.is_End(k.key) { return tree_to(t, shown, len(shown) - 1, bounds, tall) }
    // **Right opens a branch, and opens it only once**: on a branch already open it steps to the
    // first child, which is what every tree does and what makes Right-Right-Right walk downwards
    // rather than stopping on the first folder.
    if Key.is_Right(k.key) {
        if t.selected >= 0 && t.selected < len(t.rows) {
            val row = t.rows[t.selected]
            if row.expandable && !row.expanded {
                return tree_toggled(t, t.selected)
            }
            if row.expandable && row.expanded {
                return tree_to(t, shown, here + 1, bounds, tall)
            }
        }
        return tree_still(t)
    }
    // **Left closes a branch, and from a leaf climbs to the parent**, which is the move that makes
    // a deep tree navigable: without it the only way out of a folder is Up past every sibling.
    if Key.is_Left(k.key) {
        if t.selected >= 0 && t.selected < len(t.rows) {
            val row = t.rows[t.selected]
            if row.expandable && row.expanded {
                return tree_toggled(t, t.selected)
            }
            val up = parent_of(t, t.selected)
            if up >= 0 {
                return tree_to(t, shown, shown_index_of(shown, up), bounds, tall)
            }
        }
        return tree_still(t)
    }
    if Key.is_Enter(k.key) || Key.is_Space(k.key) {
        if t.selected >= 0 {
            return TreeStep { tree: t, moved: false, activated: true, toggled: false }
        }
    }
    return tree_still(t)
}

// The row this one hangs under: the nearest earlier row one level shallower. -1 at the top.
pub fn parent_of(t: Tree, index: int) -> int {
    if index < 0 || index >= len(t.rows) {
        return 0 - 1
    }
    val want = t.rows[index].depth - 1
    if want < 0 {
        return 0 - 1
    }
    var at = index - 1
    while at >= 0 {
        if t.rows[at].depth == want {
            return at
        }
        at = at - 1
    }
    return 0 - 1
}

// Where the selection sits among the visible rows, or 0 when it is not visible at all -- which can
// happen only if a caller collapsed a branch over it, and landing on the top is better than
// answering -1 and having every arrow key do nothing.
fn shown_index_of(shown: [int], selected: int) -> int {
    var i = 0
    while i < len(shown) {
        if shown[i] == selected {
            return i
        }
        i = i + 1
    }
    return 0
}

fn tree_to(t: Tree, shown: [int], want: int, bounds: Rect, tall: float) -> TreeStep {
    val last = len(shown) - 1
    val at = if want < 0 { 0 } else { if want > last { last } else { want } }
    val which = shown[at]
    val revealed = widget.clamp_offset(
        widget.scroll_to_reveal(bounds.height, t.offset, (at as float) * tall, tall),
        bounds.height,
        (len(shown) as float) * tall
    )
    return TreeStep {
        tree: with t { selected: which, offset: revealed },
        moved: which != t.selected,
        activated: false,
        toggled: false
    }
}

// Opening or closing one branch. **The selection does not move** -- a user who opened a folder is
// still on the folder, and a tree that jumped into it would make Right-then-Left not a round trip.
fn tree_toggled(t: Tree, index: int) -> TreeStep {
    val rows = mutable_array_new<TreeRow>()
    var i = 0
    while i < len(t.rows) {
        val row = t.rows[i]
        push(rows, if i == index { with row { expanded: !row.expanded } } else { row })
        i = i + 1
    }
    return TreeStep {
        tree: with t { rows: snapshot(rows), selected: index },
        moved: index != t.selected,
        activated: false,
        toggled: true
    }
}

fn tree_page_rows(t: Tree, bounds: Rect, tall: float) -> int {
    val fits = floor(bounds.height / tall)
    return if fits < 1 { 1 } else { fits }
}

fn tree_scrolled(t: Tree, want: float, bounds: Rect, tall: float) -> TreeStep {
    val content = (len(visible_rows(t)) as float) * tall
    return TreeStep {
        tree: with t { offset: widget.clamp_offset(want, bounds.height, content) },
        moved: false,
        activated: false,
        toggled: false
    }
}

fn tree_still(t: Tree) -> TreeStep {
    return TreeStep { tree: t, moved: false, activated: false, toggled: false }
}

// The tree as a widget: a `Tree` control over one `TreeItem` part per visible row.
//
// **The parts nest, though the rows are flat and the layout is a plain column.** A reader asks a
// node for its children, so a branch whose rows were siblings of it would tell a user that seven
// things exist and nothing about which is inside which -- an indented list again, from the one
// side that cannot see the indent. The first version of this did exactly that and the AT-SPI dump
// showed it: seven tree items in a row under the tree.
//
// Nesting costs nothing in layout, because a part adds no box of its own and the rows keep their
// absolute indent: a column of columns of fixed-height rows stacks exactly as one column of them
// does, which is what keeps the hit test's `y / row_height` true.
pub fn tree_widget(t: Tree, f: Frame) -> widget.Widget {
    val shown = visible_rows(t)
    val built = tree_level(t, shown, 0, 0, f)
    return widget.Widget.Control(widget.Focusable {
        name: t.name,
        role: widget.Role.Tree,
        label: t.label,
        description: "",
        value: "",
        state: with widget.no_state() { disabled: t.disabled },
        focus_part: "",
        tab_stop: true,
        child: widget.named_scroll("", 0.0, t.offset, widget.column_of(0.0, built.rows))
    })
}

// The widgets for one level, and the index after them. A struct because the walk has to answer
// both and this language has no tuples.
struct TreeLevel {
    rows: [widget.Widget]
    next: int
}

fn tree_level(t: Tree, shown: [int], from: int, depth: int, f: Frame) -> TreeLevel {
    val out = mutable_array_new<widget.Widget>()
    var i = from
    while i < len(shown) && t.rows[shown[i]].depth >= depth {
        val which = shown[i]
        val row = t.rows[which]
        // **Children are taken relative to this row's own depth, not the level it was met at.**
        // The two differ whenever a tree's rows skip a level -- rows that all sit at depth 1, or
        // a depth-2 row under a depth-0 one -- and the first version of this walk guarded that
        // case by *advancing past the row*, so a tree whose rows never reached depth 0 drew
        // nothing at all. Every sidebar built here starts at 0, which is why no test and no
        // screenshot showed it; a profiler reporting that a layout benchmark had no work to do
        // is what showed it.
        val kids = tree_level(t, shown, i + 1, row.depth + 1, f)
        i = kids.next
        val own = tree_row_box(t, which, row, f)
        val inside = if len(kids.rows) == 0 {
            own
        } else {
            widget.column_of(0.0, concat([own], kids.rows))
        }
        push(out, widget.part_of(
            tree_row_name(t, which),
            widget.Role.TreeItem,
            row.label,
            with widget.no_state() {
                selected: which == t.selected,
                disabled: t.disabled,
                // **Declared only for a branch.** `Some(false)` on a leaf publishes EXPANDABLE,
                // and a reader would offer to open a thing that cannot be opened.
                expanded: if row.expandable {
                    Option<bool>.Some(row.expanded)
                } else {
                    Option<bool>.None
                }
            },
            inside
        ))
    }
    return TreeLevel { rows: snapshot(out), next: i }
}

// One row: its indent, the mark a branch draws, and its label. **The indent is absolute rather
// than one level per nesting**, so the column the hit test computes from `depth * indent` is the
// column the mark was drawn in whatever the parts do around it.
fn tree_row_box(t: Tree, which: int, row: TreeRow, f: Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    val parts = parts_for(
        style,
        mood_of(
            t.disabled,
            pressed_in(f, tree_row_name(t, which)),
            which == t.selected,
            hovered_in(f, tree_row_name(t, which))
        )
    )
    val ink = parts.ink
    val mark = if row.expandable {
        chevron_widget(row.expanded, ink, line_for(m, style.text.body))
    } else {
        widget.Widget.Nothing
    }
    val indent = indent_for(style)
    return widget.fixed_of(0.0, row_height(m, style), widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        // **A left inset, because the focus ring is drawn inside the control's own box.** With
        // none, a row at depth zero put its mark at the very first point of the tree -- under the
        // two-point ring, which paints after the rows and so over them. The arrow was there and
        // the ring was on top of it.
        padding: widget.insets_of(style.space.s, style.space.xs, style.space.s, style.space.xs),
        surface: band_of(style, parts),
        align: widget.stretched(),
        children: [
            widget.fixed_of((row.depth as float) * indent, 0.0, widget.flex()),
            widget.fixed_of(indent, 0.0, mark),
            widget.label_in_face(row.label, style.text.body.size, ink, style.text.body.face)
        ],
        name: ""
    }))
}

// A row's name. The tree's name and the index **into `rows`, not into the visible ones**, so that
// opening a branch above a row does not rename it.
pub fn tree_row_name(t: Tree, index: int) -> string {
    return concat(t.name, "/", str(index))
}

// -------------------------------------------------------------- the scroll bar

// Where a scrolled view is, and how much of it there is, drawn beside what it scrolls.
//
// **A view of someone else's offset, not the owner of one.** The offset lives in the control that
// scrolls -- a `List`, a `Tree`, an `Entry` -- and a bar keeping a second copy is two numbers that
// can disagree about one thing. So this holds only what a bar has that nothing else does: whether
// a drag is in progress and where the thumb was taken hold of. Everything else is passed in and
// handed back.
//
// **Beside what it scrolls, never over it.** An overlaid bar is inside the scrolled control's own
// box, so a press on the bar is a press the control reads as a row -- and the control would have
// to know the bar's width to tell them apart, which is the bar's geometry computed in two places.
// Laid out as a sibling, the two boxes do not overlap and neither has to know about the other.
//
// **Not a tab stop.** Every platform agrees: the content takes the focus and its arrows scroll it,
// so a scrollbar in the tab order is a stop that does nothing a keyboard user needs. It is also
// why this control publishes no value -- a reader walks the rows, which this layer publishes
// whether they are scrolled into view or not, so the bar is an affordance for the eye and the one
// reader who needs it is the one who cannot see.
pub struct ScrollBar {
    name: string
    // Where in the thumb the pointer took hold, measured from the thumb's start, or `None` when
    // nothing is being dragged.
    grabbed: Option<float>
    // What one notch of the wheel moves. **Given rather than guessed**, because the only sensible
    // amount is a row of whatever is being scrolled and this control cannot know what that is.
    step: float
    disabled: bool
}

pub fn scroll_bar_of(name: string, step: float) -> ScrollBar {
    return ScrollBar { name: name, grabbed: Option<float>.None, step: step, disabled: false }
}

// How tall the thumb is and where it starts, inside a track of `track` points.
//
// **One function, used by the widget and by every gesture**, which is the rule this layer keeps
// learning: a thumb drawn by one calculation and dragged by another is a thumb that jumps under
// the pointer. `length` is the view's share of the content, floored at `min_thumb` so that a very
// long list still leaves something to take hold of; `start` is the offset's share of the overhang,
// spread over the track that is left.
pub struct Thumb {
    start: float
    length: float
}

// The shortest a thumb may be drawn. Below about this there is nothing to aim at with a pointer.

// How wide a bar is, **as one number shared by everything that draws or touches one**. The
// painter lays the track out from it and a scrolled control decides from it whether a press was
// meant for the bar or for a row; two numbers here would be a bar you can see in one place and
// grab in another, which is the failure this module keeps designing against.

pub fn thumb_of(style: Style, track: float, content: float, view: float, offset: float) -> Thumb {
    if content <= view || track <= 0.0 {
        return Thumb { start: 0.0, length: track }
    }
    val share = track * view / content
    val length = if share < style.minimum.thumb {
        if style.minimum.thumb > track { track } else { style.minimum.thumb }
    } else {
        share
    }
    val overhang = content - view
    val room = track - length
    val at = if overhang <= 0.0 || room <= 0.0 { 0.0 } else { room * offset / overhang }
    return Thumb { start: at, length: length }
}

// Whether a point is in the strip a bar is drawn in, down the inside of a box's right edge.
//
// **Over the content, not beside it**, which is what overlay bars do everywhere and what keeps
// this from being a layout change: a gutter reserved in a control's own box would have to be
// reserved by the control, measured by the painter and subtracted by the hit test, and the three
// would be three chances to disagree about one number. What it costs is the last few points of a
// row, which on a list of text is the empty end of a line.
pub fn on_the_bar(style: Style, bounds: Rect, p: Point, content: float, view: float) -> bool {
    if !scrolls(content, view) {
        return false
    }
    return p.x >= bounds.x + bounds.width - style.space.m
}

// Whether there is anything to scroll. An application asks before placing a bar at all; a bar with
// nothing to do draws an empty track rather than vanishing, so the layout does not move when a
// list grows past its box.
pub fn scrolls(content: float, view: float) -> bool {
    return content > view
}

pub struct ScrollBarStep {
    bar: ScrollBar
    // The offset the scrolled control should take. Handed back rather than stored, because the
    // control owns it.
    offset: float
    moved: bool
}

// What an input does to a bar, given the numbers whose owner is elsewhere.
//
// A press on the thumb takes hold of it; a press on the track above or below pages towards the
// pointer by a viewful, which is what a track click does everywhere; a move while held drags; a
// release lets go. A wheel scrolls by `step`.
pub fn scroll_bar_input(
    b: ScrollBar,
    input: Input,
    bounds: Rect,
    content: float,
    view: float,
    offset: float,
    f: Frame
) -> ScrollBarStep {
    val style = f.style
    if b.disabled {
        return bar_still(b, offset)
    }
    val thumb = thumb_of(style, bounds.height, content, view, offset)
    return switch input {
        Press(p) {
            if !widget.contains(bounds, p) {
                bar_still(b, offset)
            } else {
                val from = p.y - bounds.y
                if from < thumb.start {
                    bar_to(b, offset - view, view, content, offset)
                } else {
                    if from >= thumb.start + thumb.length {
                        bar_to(b, offset + view, view, content, offset)
                    } else {
                        ScrollBarStep {
                            bar: with b { grabbed: Option<float>.Some(from - thumb.start) },
                            offset: offset,
                            moved: false
                        }
                    }
                }
            }
        }
        Move(p) {
            switch b.grabbed {
                Some(held) {
                    val room = bounds.height - thumb.length
                    val overhang = content - view
                    if room <= 0.0 || overhang <= 0.0 {
                        bar_still(b, offset)
                    } else {
                        bar_to(b, (p.y - bounds.y - held) * overhang / room, view, content, offset)
                    }
                }
                None { bar_still(b, offset) }
            }
        }
        // **A release lets go wherever it happens**, as a button's does: a drag that ended off the
        // bar is still a drag that ended, and a thumb left holding on would follow the pointer
        // around the window.
        Release(_) { ScrollBarStep { bar: with b { grabbed: Option<float>.None }, offset: offset, moved: false } }
        Wheel(w) { bar_to(b, offset - (w.vertical as float) * b.step, view, content, offset) }
        KeyDown(_) { bar_still(b, offset) }
        KeyUp(_) { bar_still(b, offset) }
        Text(_) { bar_still(b, offset) }
        Paste(_) { bar_still(b, offset) }
    }
}

fn bar_to(b: ScrollBar, want: float, view: float, content: float, was: float) -> ScrollBarStep {
    val at = widget.clamp_offset(want, view, content)
    return ScrollBarStep { bar: b, offset: at, moved: at != was }
}

fn bar_still(b: ScrollBar, offset: float) -> ScrollBarStep {
    return ScrollBarStep { bar: b, offset: offset, moved: false }
}

// The bar as a widget: a track with the thumb inside it.
//
// The thumb is a fixed box above a flexible one, which is what places it without arithmetic the
// hit test would have to repeat -- the space above the thumb is `thumb_of`'s `start`, drawn as a
// gap, so the layout and `scroll_bar_input` are reading the one calculation.
pub fn scroll_bar_widget(
    b: ScrollBar,
    width: float,
    track: float,
    content: float,
    view: float,
    offset: float,
    f: Frame
) -> widget.Widget {
    val style = f.style
    val thumb = thumb_of(style, track, content, view, offset)
    // **The thumb is drawn in the ink and not in a face**, so its state comes from the row's ink:
    // a thumb the colour of a button would disappear into the trough behind it.
    val face = parts_for(style, mood_of(b.disabled, grabbing(b.grabbed), false, hovered_in(f, b.name))).ink
    val parts = mutable_array_new<widget.Widget>()
    push(parts, widget.fixed_of(0.0, thumb.start, widget.flex()))
    if scrolls(content, view) {
        push(parts, widget.fixed_of(0.0, thumb.length, widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Column,
            spacing: 0.0,
            padding: widget.insets_of(2.0, 0.0, 2.0, 0.0),
            surface: highlight_of(style, face),
            align: widget.stretched(),
            children: [],
            name: thumb_name
        })))
    }
    push(parts, widget.expand(widget.flex()))
    return widget.Widget.Control(widget.Focusable {
        name: b.name,
        role: widget.Role.ScrollBar,
        label: "",
        description: "",
        value: "",
        state: with widget.no_state() { disabled: b.disabled },
        // See the type's own note: the content takes the focus, and a stop here would do nothing.
        focus_part: "",
        tab_stop: false,
        child: widget.fixed_of(width, track, widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Column,
            spacing: 0.0,
            padding: widget.no_insets(),
            surface: surface_of(style, parts_for(style, mood_of(false, false, false, false))),
            align: widget.stretched(),
            children: snapshot(parts),
            name: ""
        }))
    })
}

// The name the thumb's box carries in the laid-out tree, so a test can find it.
pub val thumb_name = "thumb"

// Every viewport in a laid-out tree gets a bar, painted over the scene that is already there.
//
// **A pass over the laid tree, not a widget**, and that is the whole answer to the question F284
// could not settle: a thumb's length is the view's share of the content, and nothing knows the
// view extent until the layout has run. Measuring that by laying the window out twice costs 5 ms
// a frame at 200 rows. Here the number is simply there -- a viewport's own box is the view, the
// box its child was placed in is the content, and `Viewport.offset_y` is where it sits. This is
// the seam `widget.paint_focused` already uses for the focus ring, which could not be known at
// widget-build time either.
//
// **An indicator, not a control.** It says there is more and where you are; the wheel and the
// arrows are what move it. Dragging needs the bar to have a box of its own that a press can be
// routed to, which means the scrolled control reserving a gutter in its own layout -- a different
// change, with `scroll_bar_input` already written and tested for when it happens.
//
// Drawn **inside** the viewport's right edge, which is where an overlay bar goes and why it is
// translucent: a few points of the content are behind it, and over a list of text that is the
// trailing end of a line nobody reads.
pub fn paint_scroll_bars(l: Laid, over: scene.Scene, f: Frame) -> scene.Scene {
    val style = f.style
    val ops = mutable_array_new<scene.Op>()
    for op in over.ops {
        push(ops, op)
    }
    collect_bars(l, style, ops)
    return scene.with_ops(over, snapshot(ops))
}

fn collect_bars(l: Laid, style: Style, ops: MutableArray<scene.Op>) {
    if Scroll(it) = l.widget {
        if len(l.children) > 0 {
            val view = l.bounds.height
            val content = l.children[0].bounds.height
            if scrolls(content, view) {
                val thumb = thumb_of(style, view, content, view, it.offset_y)
                val x = l.bounds.x + l.bounds.width - style.space.m
                push(ops, scene.fill(
                    shape.rect_path(geom.rect_of(x, l.bounds.y, style.space.m, view)),
                    paint.Paint.Solid(style.face)
                ))
                push(ops, scene.fill(
                    shape.rect_path(geom.rect_of(
                        x + 1.0,
                        l.bounds.y + thumb.start,
                        style.space.m - style.space.xs,
                        thumb.length
                    )),
                    paint.Paint.Solid(style.states.disabled.ink)
                ))
            }
        }
    }
    for child in l.children {
        collect_bars(child, style, ops)
    }
}

// -------------------------------------------------------- menus and dialogs

// A title on a menu bar and the items that drop from it.
//
// **A menu is a title and a `List`**, not a new widget with its own selection and scrolling. The
// popup is a list of rows with one highlighted, scrolled when it is long, moved by the same arrows;
// the only honest difference is what a reader calls it, which is why `List.role` is a field.
pub struct Menu {
    name: string
    // What the collapsed control shows: the menu's name, "File".
    title: string
    // What a reader calls it, which for a menu is the same thing.
    //
    // **Two fields for one string, which a combo box is why.** This struct held both menus and
    // value pickers until 2026-11-16, and a picker's collapsed box shows its *value* while a reader
    // must still hear a fixed name -- "staging, combo box" and not "staging, combo box, staging".
    // The picker is `ComboBox` now and the two fields are the same here, kept because a menu whose
    // accessible name differs from its title is a thing an application may yet want.
    label: string
    items: List
    open: bool
    disabled: bool
}

pub fn menu_of(name: string, title: string, items: [string]) -> Menu {
    val inner = with list_of(concat(name, "/items"), title, items) {
        role: widget.Role.Menu,
        item_role: widget.Role.MenuItem
    }
    return Menu {
        name: name,
        title: title,
        label: title,
        items: inner,
        open: false,
        disabled: false
    }
}

// **`choice_of` was here and is `combo_box_of` (2026-11-16).** It built a `Menu` carrying
// `Role.ComboBox`, which made a value picker out of a command list by relabelling it -- and left
// the picker with a menu's keyboard, so a closed one could not change its value with the arrows at
// all. See `ComboBox`, which is the control that question wanted.

// What the collapsed control shows: the chosen value for a choice, the title for a menu.
pub fn collapsed_text(m: Menu) -> string {
    return m.title
}

// **`chosen_value` was here and is `combo_box_value` (2026-11-16).** It answered the value a
// picker was showing and "" for a menu, which is a function whose answer is decided by a role
// field -- the shape the split removed. A menu has no value and now cannot be asked for one.

// ---------------------------------------------------------------- the combo box

// **A picker of values: a collapsed box showing the current one, and a popup list to change it.**
//
// **Its own control since 2026-11-16, where it was a `Menu` carrying `Role.ComboBox` before.** The
// `Menu` struct's comment argued the other way and is worth answering rather than deleting: "one
// structure, because a dropdown *is* a popup list with a collapsed title, and building a second one
// would have been a copy of the popup, the keyboard handling and the dismissal to change two role
// names". The first half of that is right and this control depends on it -- the popup, the
// dismissal and the open keyboard are **shared**, not copied, through `open_popup_input` and
// `list_widget`. The second half was not: a menu and a combo box differ in the half that was never
// examined, which is what happens when the control is **closed**.
//
//     closed         menu                    combo box
//     Up / Down      nothing                 change the value, without opening
//     Home / End     nothing                 first / last value
//     a letter       nothing                 jump to the next value starting with it
//     Enter, Space   open                    open
//     Alt+Down       nothing                 open
//
// A menu has nothing to change while closed -- its items are commands and picking one runs it. A
// combo box holds a value, and every platform lets the arrows move it without the list ever
// appearing. That is not a role name; it is a different control, and it was missing: `curly gui`
// showed it as a method picker whose Down key opened a list instead of selecting `POST`.
//
// **Not editable.** The value is always one of `items`. An editable combo box -- a text field with
// a dropdown attached -- is a different control again, joining this to the whole of `Entry`
// (caret, selection, input method), and it is deliberately left for when something asks.
pub struct ComboBox {
    name: string
    // What a reader calls it, and it does **not** change with the value: a control that introduced
    // itself as its own current value would announce "staging, combo box, staging". What the
    // collapsed box *shows* is the value; what it is *called* is this.
    label: string
    items: List
    open: bool
    disabled: bool
}

pub struct ComboBoxStep {
    combo: ComboBox
    // The item now chosen, or -1 when the value did not change.
    //
    // **Set by a closed arrow key as well as by the popup**, which is the whole difference from
    // `MenuStep.chosen`: a combo box changes value without ever opening, so an application that
    // only watched the popup would miss most of the changes a keyboard user makes.
    chosen: int
    // The popup closed without choosing. Separate from `chosen` for `MenuStep`'s reason.
    dismissed: bool
}

pub fn combo_box_of(name: string, label: string, items: [string], selected: int) -> ComboBox {
    return ComboBox {
        name: name,
        label: label,
        items: with list_of(concat(name, "/items"), label, items) {
            selected: if selected < 0 || selected >= len(items) { 0 - 1 } else { selected }
        },
        open: false,
        disabled: false
    }
}

// The value it is showing, or "" when nothing is chosen -- which an empty item list makes real.
pub fn combo_box_value(c: ComboBox) -> string {
    val at = c.items.selected
    if at < 0 || at >= len(c.items.items) {
        return ""
    }
    return c.items.items[at]
}

// **What the collapsed box shows: the value, or the label when nothing is chosen.**
//
// A picker that rendered blank looks broken rather than unset, and an empty selection is real --
// `combo_box_of` stores -1 for an index outside the items. Separate from `combo_box_value`, which
// answers "" in that case and is what the accessibility node publishes: a reader must hear that
// nothing is chosen, where an eye needs something in the box to read.
pub fn combo_box_text(c: ComboBox) -> string {
    val shown = combo_box_value(c)
    return if shown == "" { c.label } else { shown }
}

// The collapsed control: what it shows, and the same face every other control wears.
pub fn combo_box_widget(c: ComboBox, f: Frame) -> widget.Widget {
    val style = f.style
    val parts = parts_for(style, mood_of(c.disabled, c.open, false, hovered_in(f, c.name)))
    val ink = parts.ink
    // **A mark at the trailing edge, which says the box opens.** A collapsed combo box drawn as a
    // plain filled rectangle is a disabled text field to anyone who has not been told otherwise --
    // the arrow is the only thing on screen that says this one can be opened, and it was missing.
    //
    // **The downward arrow, the tree's own**: it means "this opens downward" in a tree and it means
    // the same here, so there is one shape rather than two that could drift apart.
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: padded_for(style),
        surface: surface_of(style, parts),
        align: widget.Alignment { across: widget.Across.Centre, along: widget.Along.Start },
        children: [
            widget.label_in_face(combo_box_text(c), style.text.label.size, ink, style.text.label.face),
            widget.flex(),
            chevron_widget(true, ink, line_for(f.metrics, style.text.label))
        ],
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: c.name,
        role: widget.Role.ComboBox,
        label: c.label,
        description: "",
        // **The value, which is what a reader says after the name.** A combo box that published no
        // value would announce "Method, combo box" and leave the user to open it to find out.
        value: combo_box_value(c),
        state: with widget.no_state() {
            disabled: c.disabled,
            expanded: Option<bool>.Some(c.open)
        },
        focus_part: "",
        tab_stop: true,
        child: inside
    })
}

// The popup, as a layer. The same one a menu uses -- a list is a list.
pub fn combo_box_popup_layer(c: ComboBox, at: Rect, f: Frame) -> widget.Layer {
    val style = f.style
    return widget.layer_at(at, true, popped(list_widget(c.items, f), style))
}

// A popup's own surface: a panel with the theme's shadow behind it.
//
// **A list had none**, which is the thing a shadow made visible rather than caused: a popup drew
// its rows and nothing else, so what was behind it showed between them and at its edges. It read
// as a popup only because the rows happened to be filled. Now it is a panel that is in front of
// the window, which is what it always was.
fn popped(inner: widget.Widget, style: Style) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: raised_of(style, style.panel),
        align: widget.stretched(),
        // **`expand`, because a list measures as nothing.** Its contents are a `Viewport`, which
        // takes the box it is given rather than asking for one -- so as the plain child of a
        // column it is laid out zero points tall and the popup draws a panel with no rows in it.
        // The table's header band, the link, the slider's thumb and this have now all been the
        // same sentence.
        children: [widget.expand(inner)],
        name: ""
    })
}

fn combo_unchanged(c: ComboBox) -> ComboBoxStep {
    return ComboBoxStep { combo: c, chosen: 0 - 1, dismissed: false }
}

// Moves the selection by `by`, clamped. **No wrap**, which is what a closed combo box does
// everywhere: wrapping from the last value to the first on one keypress is a surprise when the
// list is not visible to explain it.
fn combo_moved(c: ComboBox, to: int) -> ComboBoxStep {
    val n = len(c.items.items)
    if n == 0 {
        return combo_unchanged(c)
    }
    var at = to
    if at < 0 {
        at = 0
    }
    if at >= n {
        at = n - 1
    }
    if at == c.items.selected {
        return combo_unchanged(c)
    }
    return ComboBoxStep {
        combo: with c { items: with c.items { selected: at } },
        chosen: at,
        dismissed: false
    }
}

// **Type-ahead: the next value starting with `typed`, wrapping once.** From *after* the current
// selection, so pressing `p` twice over POST, PUT and PATCH walks them rather than sticking on the
// first. Case-insensitive, because a value list is written for reading and a user types in haste.
fn combo_typed(c: ComboBox, typed: string) -> ComboBoxStep {
    val n = len(c.items.items)
    if n == 0 || typed == "" {
        return combo_unchanged(c)
    }
    // **The one-argument `to_lower`**, which folds without a locale. A combo box's items are
    // whatever an application put in them, in whatever language, and this control cannot know the
    // user's locale -- naming one here would be guessing. Type-ahead that is occasionally wrong in
    // Turkish is better than a dependency on a locale nobody passed.
    val want = to_lower(typed)
    var step = 1
    while step <= n {
        val at = (c.items.selected + step) % n
        if starts_with(to_lower(c.items.items[at]), want) {
            return combo_moved(c, at)
        }
        step = step + 1
    }
    return combo_unchanged(c)
}

fn combo_opened(c: ComboBox) -> ComboBoxStep {
    return ComboBoxStep { combo: with c { open: true }, chosen: 0 - 1, dismissed: false }
}

// One keystroke against a **closed** combo box, which is the whole of what makes it not a menu.
//
// Statements rather than an `if`/`else` chain used as a value, because the last test binds -- a
// `Char` carries the letter that type-ahead needs, and a pattern `if` is a statement in this
// language. Written as early returns, so each key reads as its own line.
fn closed_combo_key(c: ComboBox, k: Keystroke) -> ComboBoxStep {
    // **Alt+Down opens where a bare Down changes the value** -- the one place the two gestures have
    // to be told apart, and the modifier is how every platform tells them. Tested first for that
    // reason: the bare `Down` below would otherwise swallow it.
    if Key.is_Down(k.key) && k.alt {
        return combo_opened(c)
    }
    if Key.is_Enter(k.key) || Key.is_Space(k.key) {
        return combo_opened(c)
    }
    if Key.is_Down(k.key) {
        return combo_moved(c, c.items.selected + 1)
    }
    if Key.is_Up(k.key) {
        return combo_moved(c, c.items.selected - 1)
    }
    if Key.is_Home(k.key) {
        return combo_moved(c, 0)
    }
    if Key.is_End(k.key) {
        return combo_moved(c, len(c.items.items) - 1)
    }
    if Char(ch) = k.key {
        return combo_typed(c, ch)
    }
    return combo_unchanged(c)
}

fn closed_combo_input(c: ComboBox, input: Input, at: Rect) -> ComboBoxStep {
    return switch input {
        // A press on the collapsed box opens it, on the way down as a menu title does.
        Press(p) {
            if widget.contains(at, p) {
                combo_opened(c)
            } else {
                combo_unchanged(c)
            }
        }
        KeyDown(k) { closed_combo_key(c, k) }
        // Text arrives for a typed character on the platforms that send it rather than a `Char`
        // keystroke, and type-ahead is what a closed combo box does with it.
        Text(t) { combo_typed(c, t) }
        KeyUp(_) { combo_unchanged(c) }
        Paste(_) { combo_unchanged(c) }
        Release(_) { combo_unchanged(c) }
        Move(_) { combo_unchanged(c) }
        Wheel(_) { combo_unchanged(c) }
    }
}

pub fn combo_box_input(
    c: ComboBox,
    input: Input,
    at: Rect,
    popup_at: Rect,
    f: Frame
) -> ComboBoxStep {
    if c.disabled {
        return combo_unchanged(c)
    }
    if !c.open {
        return closed_combo_input(c, input, at)
    }
    // **Open, it is a popup list and behaves exactly like one** -- Escape dismisses, Enter chooses
    // the highlight, a click outside dismisses, a release over a row chooses it, and the arrows
    // belong to the list. Shared with `Menu` rather than copied, which is the half of that struct's
    // old argument this control keeps.
    val step = open_popup_input(c.items, input, at, popup_at, f)
    return ComboBoxStep {
        combo: with c { items: step.items, open: step.open },
        chosen: step.chosen,
        dismissed: step.dismissed
    }
}

pub struct MenuStep {
    menu: Menu
    // The item chosen, or -1. An output: the application acts on it and stores the menu.
    chosen: int
    // The menu closed without choosing -- Escape, or a click away from it. Separate from `chosen`,
    // because a caller that treated them alike would act on a dismissal.
    dismissed: bool
}

// What an input does to a menu.
//
// `title_bounds` is the box of the title on the bar and `popup_bounds` the box of the open popup,
// both needed because **a click's meaning depends on which of the two it is in** -- and on neither,
// which is a dismissal.
//
// The popup is not a child of the title, so this cannot find either box itself: `widget.layer_at`
// explains why an overlay lives in the root's layer list, and the caller that put it there is the
// one that knows where it went.
pub fn menu_input(
    menu: Menu,
    input: Input,
    title_bounds: Rect,
    popup_bounds: Rect,
    f: Frame
) -> MenuStep {
    if menu.disabled {
        return menu_unchanged(menu)
    }
    if !menu.open {
        return closed_menu_input(menu, input, title_bounds)
    }
    return open_menu_input(menu, input, title_bounds, popup_bounds, f)
}

fn closed_menu_input(m: Menu, input: Input, title_bounds: Rect) -> MenuStep {
    return switch input {
        // A click on the title opens it. On the way *down*, not up: a menu bar opens on press, which
        // is what lets a user press and drag onto an item in one gesture.
        Press(p) {
            if widget.contains(title_bounds, p) {
                opened(m)
            } else {
                menu_unchanged(m)
            }
        }
        KeyDown(k) {
            if Key.is_Down(k.key) || Key.is_Enter(k.key) || Key.is_Space(k.key) {
                opened(m)
            } else {
                menu_unchanged(m)
            }
        }
        KeyUp(_) { menu_unchanged(m) }
        Text(_) { menu_unchanged(m) }
        Paste(_) { menu_unchanged(m) }
        Release(_) { menu_unchanged(m) }
        Move(_) { menu_unchanged(m) }
        Wheel(_) { menu_unchanged(m) }
    }
}

// What an **open popup list** does, for both the controls that have one.
//
// **Shared rather than copied**, which is the half of `Menu`'s old one-structure argument that
// survives: a dropdown really is a popup list with a collapsed thing above it, and the open half --
// Escape dismisses, Enter chooses the highlight, a click outside dismisses, a release over a row
// chooses it, and everything else is the list's -- is identical whether the collapsed thing is a
// menu title or a value. Only the *closed* half differs, and that is where the two controls part.
struct PopupStep {
    items: List
    open: bool
    chosen: int
    dismissed: bool
}

fn popup_held(l: List) -> PopupStep {
    return PopupStep { items: l, open: true, chosen: 0 - 1, dismissed: false }
}

fn popup_dismissed(l: List) -> PopupStep {
    return PopupStep { items: l, open: false, chosen: 0 - 1, dismissed: true }
}

fn open_popup_input(
    items: List,
    input: Input,
    title_bounds: Rect,
    popup_bounds: Rect,
    f: Frame
) -> PopupStep {
    // `Other("")` for an input that is not a keystroke, so the tests below read as one list rather
    // than as a key check wrapped in an input check.
    val pressed = switch input {
        KeyDown(k) { k.key }
        KeyUp(_) { Key.Other("") }
        Text(_) { Key.Other("") }
        Paste(_) { Key.Other("") }
        Press(_) { Key.Other("") }
        Release(_) { Key.Other("") }
        Move(_) { Key.Other("") }
        Wheel(_) { Key.Other("") }
    }
    // **Escape closes without choosing, and that is a dismissal rather than a choice of nothing.**
    if Key.is_Escape(pressed) {
        return popup_dismissed(items)
    }
    if Key.is_Enter(pressed) || Key.is_Space(pressed) {
        if items.selected >= 0 {
            return PopupStep { items: items, open: false, chosen: items.selected, dismissed: false }
        }
        return popup_dismissed(items)
    }
    // **A click outside both boxes dismisses it**, which is what placed layers letting clicks
    // through is for: the click also reaches whatever was under it, and the popup closing is this
    // module's half of that.
    if Press(p) = input {
        if !widget.contains(popup_bounds, p) && !widget.contains(title_bounds, p) {
            return popup_dismissed(items)
        }
        // On the collapsed control again: a second press closes it, as every menu bar does.
        if widget.contains(title_bounds, p) {
            return popup_dismissed(items)
        }
    }
    // **A release over a row chooses it, which is what makes this usable with a mouse at all.**
    //
    // Until this, choosing was keyboard-only: a press on a row fell through to the list below and
    // moved the selection, and nothing ever turned that into a choice -- so a user could open a
    // menu, click an item, and watch the item highlight and the menu stay open. Found by a real
    // application rather than by a test, because every test here chose with Enter.
    //
    // **On the release rather than the press**, which makes both gestures work with one rule: a
    // menu-bar press-drag-release lands its release on the item it ended over, and an ordinary
    // click is a press and a release on the same row. It also means a press that opened it cannot
    // immediately choose, since that release lands on the collapsed control.
    if Release(p) = input {
        if widget.contains(popup_bounds, p) && items.selected >= 0 {
            return PopupStep { items: items, open: false, chosen: items.selected, dismissed: false }
        }
    }
    // Everything else is the list's: arrows, Home, End, the wheel, and a press on a row.
    val step = list_input(items, input, popup_bounds, f)
    return popup_held(step.list)
}

// The menu's open half, which is `open_popup_input` and nothing else. It kept its own name
// because `menu_input` reads better dispatching to a pair than to one shared function and one
// inline branch, and because the closed half beside it is where a menu's behaviour actually is.
fn open_menu_input(
    menu: Menu,
    input: Input,
    title_bounds: Rect,
    popup_bounds: Rect,
    f: Frame
) -> MenuStep {
    val step = open_popup_input(menu.items, input, title_bounds, popup_bounds, f)
    return MenuStep {
        menu: with menu { items: step.items, open: step.open },
        chosen: step.chosen,
        dismissed: step.dismissed
    }
}

fn opened(m: Menu) -> MenuStep {
    // Opens on the first item rather than on nothing, so the keyboard has somewhere to be.
    return MenuStep {
        menu: with m { open: true, items: with m.items { selected: if len(m.items.items) == 0 { 0 - 1 } else { 0 } } },
        chosen: 0 - 1,
        dismissed: false
    }
}

fn dismissed_menu(m: Menu) -> MenuStep {
    return MenuStep { menu: with m { open: false }, chosen: 0 - 1, dismissed: true }
}

fn menu_unchanged(m: Menu) -> MenuStep {
    return MenuStep { menu: m, chosen: 0 - 1, dismissed: false }
}

// The title as it sits on the bar. A control in its own right, so Tab reaches the menu and a reader
// announces it.
pub fn menu_title_widget(menu: Menu, f: Frame) -> widget.Widget {
    val style = f.style
    // **An open menu is a pressed menu.** Its title stays held down for as long as its popup is
    // up, which is what every menu bar does and what `open` already recorded.
    val parts = parts_for(style, mood_of(menu.disabled, menu.open, false, hovered_in(f, menu.name)))
    val ink = parts.ink
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: padded_for(style),
        surface: surface_of(style, parts),
        align: widget.stretched(),
        children: [widget.label_in_face(collapsed_text(menu), style.text.label.size, ink, style.text.label.face)],
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: menu.name,
        role: widget.Role.Menu,
        label: menu.label,
        description: "",
        // **A choice announces its value and a menu has none to announce.** This is the whole
        // behavioural difference between the two once the role is right: a reader says the label,
        // then what it is, then what it holds.
        // A menu has no value -- it is a list of commands, and the thing it is *called* is all a
        // reader needs. A picker's value is `combo_box_value`, on the control that has one.
        value: "",
        state: with widget.no_state() {
            disabled: menu.disabled,
            expanded: Option<bool>.Some(menu.open)
        },
        focus_part: "",
        tab_stop: true,
        child: inside
    })
}

// The open popup, as a layer for the **root's** layer list.
//
// `at` is where the caller decided it goes, from the title's laid bounds -- see `widget.layer_at`
// for why it cannot be a child of the title. A placed layer, so a click away from it falls through
// to what is beneath as well as closing the menu.
//
// Takes the keyboard while it is open, because an open menu owns the arrows.
pub fn menu_popup_layer(menu: Menu, at: Rect, f: Frame) -> widget.Layer {
    val style = f.style
    return widget.layer_at(at, true, popped(list_widget(menu.items, f), style))
}

// ------------------------------------------------------------------ dialogs

// What a dialog's keys mean. Returned rather than acted on, for the reason everything here is: this
// module cannot close a window or save a record.
pub enum DialogAnswer {
    Confirm
    Cancel
    Nothing
}

// **Escape cancels and Enter confirms**, which are the two keys a dialog owes a user who never
// reaches for the mouse. Everything else belongs to whatever is inside it.
//
// Enter is deliberately not "the focused button": a dialog's default action is the dialog's, not the
// focus's, or tabbing to Cancel and pressing Enter would confirm.
pub fn dialog_keys(input: Input) -> DialogAnswer {
    if KeyDown(k) = input {
        if Key.is_Escape(k.key) {
            return DialogAnswer.Cancel
        }
        if Key.is_Enter(k.key) {
            return DialogAnswer.Confirm
        }
    }
    return DialogAnswer.Nothing
}

// A modal layer holding `content` under a title.
//
// **Modal, so the geometry shuts the pointer out and `takes_keys` shuts Tab out** -- a click beside
// the dialog lands on the layer, finds no control, and goes nowhere, and the tab order holds only
// what is inside. `widget.modal_layer` is where both of those are explained.
//
// The content is the caller's: a dialog is a frame and a pair of keys, not a thing that knows what
// it is asking.
pub fn dialog_layer(name: string, title: string, content: widget.Widget, f: Frame) -> widget.Layer {
    val style = f.style
    val framed = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: style.text.body.size * 0.5,
        padding: padded_for(style),
        // **The panel, not a face.** See `Style.panel`: a dialog whose panel is the colour of a
        // button is a dialog whose buttons cannot be seen. Raised, because a modal dialog is the
        // thing in front of everything -- the scrim says the window is blocked and the shadow says
        // which of the two layers you are looking at.
        surface: raised_of(style, style.panel),
        align: widget.stretched(),
        children: [widget.label_in_face(title, style.text.body.size, style.ink, style.text.body.face), content],
        name: ""
    })
    val titled = widget.Widget.Control(widget.Focusable {
        name: name,
        role: widget.Role.Dialog,
        label: title,
        description: "",
        value: "",
        state: widget.no_state(),
        focus_part: "",
        tab_stop: false,
        child: framed
    })
    // Centred with flexible space, which the box model already does -- a dialog needs no absolute
    // positioning to sit in the middle of a window.
    //
    // **Over a scrim, which it did not have.** A modal layer took the keys and drew nothing, so a
    // dialog was text floating on top of the window it was blocking: nothing said which half was
    // live. Found by the first application to open one. The scrim is part of the dialog rather than
    // something a caller adds, because a dialog without one is not a thing worth being able to make.
    return widget.modal_layer(widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.filled(style.scrim),
        align: widget.stretched(),
        children: [
            widget.flex(),
            widget.row_of(0.0, [widget.flex(), titled, widget.flex()]),
            widget.flex()
        ],
        name: "scrim"
    }))
}

// ------------------------------------------------------------- the split pane

// How thick a divider is drawn, and how wide a target it is to grab.
//
// **One number, shared by the widget, the hit test and the arithmetic that places the panes** --
// `bar_thickness`'s rule for `bar_thickness`'s reason: a divider you can see in one place and take
// hold of in another is the failure this module keeps designing against.

// What one arrow key moves the divider by.
//
// **A module val rather than a field, unlike `ScrollBar.step`.** A scroll bar's step is a row of
// something this module cannot see, so it has to be given one; a divider moves in points, and a
// point is a point whatever is either side of it.
pub val divider_step = 10.0

// How wide the **line** down the middle of a divider is, where `divider_thickness` is how wide the
// thing you can grab is.
//
// **Two numbers because a divider is two things**, which is what every toolkit does and what
// looking at the first one running made obvious: a six-point bar filled with `style.face` is
// invisible for most of its length, because the control on at least one side of it is drawn in
// `style.face` too. A divider has to read as a *line* -- so the grab area paints nothing and a
// narrow line is centred in it. Four points of nothing either side is also why a 6-point target is
// enough to hit.

// Two panes with a divider between them, which the user can drag.
//
// **The first control here that owns a layout rather than filling one**, and it is still not a
// layout container: `split_pane_widget` takes the two panes as widgets and returns a widget, so
// `widget` keeps every placement rule and this keeps the state and the gestures. A `Stack` whose
// children's sizes came from a control's state would have put a control inside the box model.
//
// **The position is points from the start, not a fraction of the box.** A fraction would need no
// extent at all -- two `Expanded` weights say it, and the first draft was written that way -- and
// it is the wrong model: it makes a sidebar grow when the window grows, where every file browser
// ever written keeps the sidebar's width and gives the new room to the document. Points cost this
// control the one thing a fraction had for free, which is that a number in points has to be
// clamped against an extent the state does not know, and that is what `split_at` is for.
//
// **`position` is written only by a gesture, and read through `split_at`.** So a window squeezed
// narrow enough to push the divider does not overwrite what the user chose: the clamp happens on
// the way out, the stored number survives, and widening the window again puts the divider back
// where they left it. Storing the clamped value instead -- which is what writing it on every
// layout would do -- loses that, and it is the complaint `JSplitPane` keeps a `lastDividerLocation`
// to answer.
pub struct SplitPane {
    name: string
    label: string
    // Which way the panes sit: `Row` is two panes side by side with an upright divider, `Column`
    // one above the other. **The direction of the stack, not of the divider**, which is the
    // confusion `JSplitPane.HORIZONTAL_SPLIT` is famous for -- a "horizontal split" there is a
    // *vertical* divider. This field is the stack's direction and nothing else, so there is
    // nothing to get backwards.
    direction: widget.Direction
    // Where the divider starts, in points from the box's start along `direction`. Read it through
    // `split_at`, never directly: this is what the user asked for and that is what they can have.
    position: float
    // The least either pane may be squeezed to, in points. Zero lets a pane be dragged away
    // entirely, which is what a plain pane does everywhere and is why it is the default.
    first_min: float
    second_min: float
    // Where in the divider the pointer took hold, measured from the divider's start, or `None`
    // when nothing is being dragged. `ScrollBar.grabbed` carries the same thing for the same
    // reason: a divider that jumped so its start met the pointer would move the moment it was
    // touched, before anything was dragged.
    grabbed: Option<float>
    disabled: bool
}

pub fn split_pane_of(name: string, label: string, direction: widget.Direction, position: float) -> SplitPane {
    return SplitPane {
        name: name,
        label: label,
        direction: direction,
        position: position,
        first_min: 0.0,
        second_min: 0.0,
        grabbed: Option<float>.None,
        disabled: false
    }
}

// The divider's own name, which focus and accessibility address it by.
//
// **The divider takes the focus, not the pane.** A pane that was a tab stop would be a stop in
// front of whatever is inside it, so Tab would reach the split before reaching the tree in its
// first half; and the thing a keyboard user wants to move is the divider. Same construction as
// `row_name`: the control's name and a suffix, because a part has no name of its own.
pub fn divider_name(s: SplitPane) -> string {
    return concat(s.name, "/divider")
}

// Where the divider starts, in points from the start of a box `extent` long.
//
// **One function, read by the widget and by every gesture** -- `thumb_of`'s rule. A divider drawn
// at one number and dragged by another is a divider that jumps out from under the pointer on the
// first press.
pub fn split_at(s: SplitPane, style: Style, extent: float) -> float {
    val room = extent - style.space.m
    if room <= 0.0 {
        return 0.0
    }
    val least = if s.first_min < 0.0 { 0.0 } else { s.first_min }
    val keep = if s.second_min < 0.0 { 0.0 } else { s.second_min }
    val most = room - keep
    // **When both minimums cannot be met, neither is**: the room is shared in the ratio they
    // asked for. Refusing to lay out is not something a box model can do, and honouring one
    // minimum would make which pane gets squeezed depend on which field was written first --
    // invisible in a wide window and arbitrary in a narrow one.
    if least > most {
        val total = least + keep
        if total <= 0.0 {
            return 0.0
        }
        return room * least / total
    }
    if s.position < least {
        return least
    }
    if s.position > most {
        return most
    }
    return s.position
}

// The box the divider occupies, which is what a press is tested against.
pub fn divider_rect(s: SplitPane, style: Style, bounds: Rect) -> Rect {
    val at = split_at(s, style, split_extent(s, bounds))
    return switch s.direction {
        Row {
            geom.rect_of(bounds.x + at, bounds.y, style.space.m, bounds.height)
        }
        Column {
            geom.rect_of(bounds.x, bounds.y + at, bounds.width, style.space.m)
        }
    }
}

// How long the box is along the direction the panes are stacked in.
fn split_extent(s: SplitPane, bounds: Rect) -> float {
    return switch s.direction {
        Row { bounds.width }
        Column { bounds.height }
    }
}

// How far along that direction a point is, measured from the box's start.
fn split_along(s: SplitPane, bounds: Rect, p: Point) -> float {
    return switch s.direction {
        Row { p.x - bounds.x }
        Column { p.y - bounds.y }
    }
}

pub struct SplitStep {
    split: SplitPane
    // Whether the divider ended up somewhere else. **Where it ended up is on `split`**, unlike
    // `ScrollBarStep.offset`: a scroll bar reports an offset whose owner is the control being
    // scrolled, where a split pane owns its own divider and has nobody to hand the number to.
    moved: bool
}

fn split_still(s: SplitPane) -> SplitStep {
    return SplitStep { split: s, moved: false }
}

// Moves the divider to `want`, clamped by `split_at` -- so a gesture can ask for anything and the
// stored position is always one the box can honour.
fn split_to(s: SplitPane, want: float, style: Style, extent: float) -> SplitStep {
    val was = split_at(s, style, extent)
    val now = split_at(with s { position: want }, style, extent)
    return SplitStep { split: with s { position: now }, moved: now != was }
}

// What an input does to a split pane, given the box the whole pane occupies.
//
// A press on the divider takes hold of it, a move while held drags it, a release lets go. A press
// anywhere else does nothing -- **the panes' own contents are not this control's business**, and
// `target` has already decided that an input landing inside a pane belongs to whatever is in
// there. The arrows move the divider by `divider_step`, Home and End push it as far as the
// minimums allow.
//
// **The arrows that move it are the ones that lie along the stack**: Left and Right for a `Row`,
// Up and Down for a `Column`. The other pair is left alone rather than treated as the same thing,
// because a divider that moved sideways when you pressed Down would be reporting that this control
// does not know which way it is facing.
pub fn split_pane_input(s: SplitPane, input: Input, bounds: Rect, f: Frame) -> SplitStep {
    val style = f.style
    if s.disabled {
        return split_still(s)
    }
    val extent = split_extent(s, bounds)
    return switch input {
        Press(p) {
            if !widget.contains(divider_rect(s, style, bounds), p) {
                split_still(s)
            } else {
                SplitStep {
                    split: with s {
                        grabbed: Option<float>.Some(split_along(s, bounds, p) - split_at(s, style, extent))
                    },
                    moved: false
                }
            }
        }
        Move(p) {
            switch s.grabbed {
                Some(held) { split_to(s, split_along(s, bounds, p) - held, style, extent) }
                None { split_still(s) }
            }
        }
        // A release lets go wherever it happens, for the reason `scroll_bar_input` gives: a drag
        // that ended off the divider is still a drag that ended.
        Release(_) { SplitStep { split: with s { grabbed: Option<float>.None }, moved: false } }
        KeyDown(k) { split_key(s, k, style, extent) }
        KeyUp(_) { split_still(s) }
        Text(_) { split_still(s) }
        Paste(_) { split_still(s) }
        // **A wheel over the divider scrolls nothing**, rather than moving it. A divider is six
        // points wide and the wheel is aimed at content; a pane that resized because the pointer
        // was two points off the list it was over is a surprise with no way to undo it.
        Wheel(_) { split_still(s) }
    }
}

fn split_key(s: SplitPane, k: Keystroke, style: Style, extent: float) -> SplitStep {
    val at = split_at(s, style, extent)
    val back = switch s.direction {
        Row { Key.is_Left(k.key) }
        Column { Key.is_Up(k.key) }
    }
    val on = switch s.direction {
        Row { Key.is_Right(k.key) }
        Column { Key.is_Down(k.key) }
    }
    if back {
        return split_to(s, at - divider_step, style, extent)
    }
    if on {
        return split_to(s, at + divider_step, style, extent)
    }
    // Asking for 0 and for the whole extent, and letting `split_at` turn both into what the
    // minimums allow -- so Home and End need to know nothing about the minimums.
    if Key.is_Home(k.key) {
        return split_to(s, 0.0, style, extent)
    }
    if Key.is_End(k.key) {
        return split_to(s, extent, style, extent)
    }
    return split_still(s)
}

// The line a divider is seen as.
//
// **`disabled_ink` rather than a colour of its own**, which is a deliberate reuse and not a
// shortcut: `Style` has no divider colour, and adding one would make every theme answer a
// question most themes do not care about. It is the one grey in the palette darker than a face,
// which is what a line between two faces has to be. A theme that wants more says so by making
// this darker, and if one ever needs the line a different colour from its disabled text, *that*
// is when `Style` grows a field.
//
// **It darkens to the ink while it is held**, because a drag with no feedback leaves a user
// unsure whether they took hold of anything -- the divider is the one control here with no other
// way to show that it is being used.
fn divider_line_widget(s: SplitPane, style: Style, held: bool) -> widget.Widget {
    val colour = if held { style.ink } else { style.states.disabled.ink }
    val line = widget.Widget.Group(widget.Stack {
        direction: s.direction,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: highlight_of(style, colour),
        align: widget.stretched(),
        children: [],
        name: ""
    })
    return switch s.direction {
        Row { widget.fixed_of(style.stroke.line, 0.0, line) }
        Column { widget.fixed_of(0.0, style.stroke.line, line) }
    }
}

// The pane as a widget: the first pane at its size, the divider, and the second pane taking what
// is left.
//
// **`extent` is given rather than measured**, which is the one thing this control asks of its
// application that no other control here does. The box model places a tree it is handed; a
// position in points cannot be turned into a layout without knowing how much room there is, and
// the application already holds that number because it is the `bounds` it passes to
// `split_pane_input`. Passing last frame's extent is exactly right: it is the extent the user was
// looking at when they dragged.
//
// **The second pane is `expand`ed rather than sized.** The first pane and the divider are fixed,
// so whatever rounding is left over goes to the second pane and there is no seam -- where two
// fixed sizes that did not add up to the box would leave a line of background showing between
// them, on some window widths and not others.
pub fn split_pane_widget(
    s: SplitPane,
    extent: float,
    first: widget.Widget,
    second: widget.Widget,
    f: Frame
) -> widget.Widget {
    val style = f.style
    val at = split_at(s, style, extent)
    val held = switch s.grabbed {
        Some(_) { true }
        None { false }
    }
    val divider = widget.Widget.Control(widget.Focusable {
        name: divider_name(s),
        role: widget.Role.Separator,
        label: s.label,
        description: "",
        // Where the split sits, in points, which is what AT-SPI asks a split pane for and the one
        // thing a reader can say about a divider that is worth hearing.
        value: str(floor(at)),
        state: with widget.no_state() { disabled: s.disabled },
        focus_part: "",
        tab_stop: true,
        // **The grab area paints nothing and the line inside it does.** Filling the whole six
        // points makes a divider that disappears against any control drawn in the same face, which
        // is what the first application to use one showed in its first frame.
        child: widget.Widget.Group(widget.Stack {
            direction: s.direction,
            spacing: 0.0,
            padding: widget.no_insets(),
            surface: widget.no_surface(),
            // Centred **along** the stack and stretched across it, which places the line in the
            // middle of the grab area in either direction without this function knowing which one
            // it is in.
            align: widget.Alignment { across: widget.Across.Stretch, along: widget.Along.Centre },
            children: [divider_line_widget(s, style, held)],
            name: ""
        })
    })
    val panes = switch s.direction {
        Row {
            [
                widget.fixed_of(at, 0.0, first),
                widget.fixed_of(style.space.m, 0.0, divider),
                widget.expand(second)
            ]
        }
        Column {
            [
                widget.fixed_of(0.0, at, first),
                widget.fixed_of(0.0, style.space.m, divider),
                widget.expand(second)
            ]
        }
    }
    // A declared group rather than a tab stop: it gives a reader the node that contains both
    // halves, and gives Tab nothing to stop on. See `divider_name`.
    return widget.part_of(
        s.name,
        widget.Role.SplitPane,
        s.label,
        with widget.no_state() { disabled: s.disabled },
        widget.Widget.Group(widget.Stack {
            direction: s.direction,
            spacing: 0.0,
            padding: widget.no_insets(),
            surface: widget.no_surface(),
            align: widget.stretched(),
            children: panes,
            name: ""
        })
    )
}

// ----------------------------------------------------------------- the table

// The least a column may be dragged down to. Below this there is no room for even an ellipsis, and
// a column with nothing in it is a column a user cannot find again to drag back.

// How thick a grid line is. **One point, shared by both directions**, which is what makes a table
// read as a grid rather than as two sets of lines that happen to cross.

// How close to a column's trailing edge a press has to be to take hold of it.
//
// **Both sides of the edge, so the grip is twice this wide.** A one-point target is a target
// nobody hits; the number is the one every table uses and it is the reason the cursor changes
// shape there.

// One column of a table.
pub struct Column {
    title: string
    width: float
    // Where this column's cells sit in it: text reads from the start, a number from the end.
    //
    // **On the column, not on the cell**, which is what Swing's renderer-per-column and JIDE's
    // `CellStyleTable` both say in their own way. A column of numbers with one of them centred is
    // a mistake every time, so the model does not let it be said.
    align: widget.Along
}

pub fn column_of(title: string, width: float) -> Column {
    return Column { title: title, width: width, align: widget.Along.Start }
}

// A column of numbers, which read from the right so their digits line up. The reason this is worth
// a second constructor rather than a field to set: a table of measurements has one of these per
// column and spelling out a struct literal each time is how a right-aligned column gets forgotten.
pub fn numeric_column_of(title: string, width: float) -> Column {
    return Column { title: title, width: width, align: widget.Along.End }
}

// A grid of cells, a header over it, one row selected.
//
// **What this is, by JIDE's own division of its product line**: `JideTable` -- a table with a
// header, selection, scrolling in both directions and columns the user can resize. Sorting,
// filtering, cell spanning, a tree in the first column and a nested table in a row are all things
// JIDE layers *over* that base, and they are deferred here in the same order and for the same
// reason: each is a model on top of the rows, and a base that cannot show rows well makes none of
// them better.
//
// **The header is outside the scrolled view, vertically, and inside it horizontally.** That is the
// whole of what makes a table a table rather than a list of rows -- the titles stay while the rows
// go by -- and it is the one thing that complicates the arithmetic, because the view the rows
// scroll in is *not* the control's box. Everything that needs that box goes through `table_body`
// rather than working it out again, which is `thumb_of`'s rule: five copies of
// `bounds.height - header_height` is five chances to forget one.
pub struct Table {
    name: string
    label: string
    columns: [Column]
    // The cells, a row at a time.
    //
    // **A row shorter than `columns` is not an error**: `cell_at` answers "" past its end. A table
    // built from a query has a missing value in it sooner or later, and the alternative is every
    // caller padding its rows or this control raising on data it could simply draw.
    rows: [[string]]
    // The selected row, or -1 for none -- a real state, as `List.selected` explains at length.
    selected: int
    // Whether the strip of column titles is drawn at all.
    //
    // **A flag, where this was `header_height: 0.0`.** A grid of values inside a dialog has
    // nothing to put in a header, and that is still this table rather than a second control -- but
    // the height is `header_height(m, style)` now and no longer a number a caller can zero. Saying
    // it in a bool says the thing itself: a table either has titles over its columns or it does
    // not, and a caller that wanted a shorter band was never what the zero meant.
    headers: bool
    // How far the rows have scrolled down.
    offset: float
    // How far the columns have scrolled sideways. **One number, read by the header and by the
    // body**, which is what locks the two together: a header scrolling on its own offset is a
    // header that drifts from its columns, and it drifts by exactly the bug you cannot see in a
    // screenshot.
    offset_x: float
    // Which column's trailing edge is being dragged, or -1.
    resizing: int
    // How far the pointer was from that edge when it took hold, so a resize does not snap the edge
    // to the pointer on the first press. `ScrollBar.grabbed` and `SplitPane.grabbed` carry the same
    // thing for the same reason.
    grabbed: Option<float>
    bar: ScrollBar
    disabled: bool
}

pub fn table_of(name: string, label: string, columns: [Column], rows: [[string]]) -> Table {
    return Table {
        name: name,
        label: label,
        columns: columns,
        rows: rows,
        selected: if len(rows) == 0 { 0 - 1 } else { 0 },
        headers: true,
        offset: 0.0,
        offset_x: 0.0,
        resizing: 0 - 1,
        grabbed: Option<float>.None,
        bar: scroll_bar_of(concat(name, "/bar"), 20.0),
        disabled: false
    }
}

// What is in a cell, or "" for a cell that is not there. See `Table.rows`.
pub fn cell_at(t: Table, row: int, column: int) -> string {
    if row < 0 || row >= len(t.rows) {
        return ""
    }
    val cells = t.rows[row]
    if column < 0 || column >= len(cells) {
        return ""
    }
    return cells[column]
}

// A row as a reader hears it: its cells in order, comma separated.
//
// **The columns' order, not the row's length**, so a short row is read as the empty cells it has
// rather than stopping early -- a reader that said "Aspirin, 100mg" where the screen shows an
// empty dose column has told the user the wrong thing about the data.
pub fn row_label(t: Table, row: int) -> string {
    val parts = mutable_array_new<string>()
    var i = 0
    while i < len(t.columns) {
        push(parts, cell_at(t, row, i))
        i = i + 1
    }
    return join(Option<string>.None, Option<string>.None, Option<string>.Some(", "), parts)
}

// Where a column starts, measured from the start of the first one and before any sideways scroll.
//
// **Defined up to and including `len(columns)`**, where it answers the width of them all -- so the
// trailing edge of column `i` is `column_x(t, i + 1)` and the hit test, the header and the rows
// are reading one function rather than three loops that must agree.
pub fn column_x(t: Table, index: int) -> float {
    var sum = 0.0
    var i = 0
    while i < index && i < len(t.columns) {
        sum = sum + t.columns[i].width
        i = i + 1
    }
    return sum
}

pub fn columns_width(t: Table) -> float {
    return column_x(t, len(t.columns))
}

// The box the rows are in: the control's box without the header.
//
// **Every calculation about rows goes through here** -- the press that picks a row, the page a
// PageDown moves, the reveal that brings a selection into view, the scroll bar's track and
// whether a press landed on it. The header is the only thing between them and `bounds`, and it is
// the kind of subtraction that gets written four times and forgotten once.
pub fn table_body(t: Table, style: Style, bounds: Rect, m: widget.Metrics) -> Rect {
    val top = band_height(t, style, m)
    val height = bounds.height - top
    return geom.rect_of(bounds.x, bounds.y + top, bounds.width, if height < 0.0 { 0.0 } else { height })
}

// How tall the header band is here: the theme's header height, or nothing at all when this table
// has no titles. **One function, so that the widget, the body and the hit test cannot disagree**
// -- which is `table_body`'s own rule one level down.
fn band_height(t: Table, style: Style, m: widget.Metrics) -> float {
    return if t.headers { header_height(m, style) } else { 0.0 }
}

// Which column's trailing edge is under this point, or -1 for none.
//
// **Only in the header**, which is where a resize grip belongs: a drag starting over the rows is a
// selection in every table ever written, and treating a press four points from a column boundary
// in the middle of the data as a resize would make selecting a row a gamble.
//
// **The last column's edge is not a grip.** There is nothing to its right to give or take the
// points, so dragging it would either do nothing or resize a different column -- and a grip that
// does nothing is worse than no grip, because the pointer changed shape and promised otherwise.
pub fn edge_at(t: Table, style: Style, bounds: Rect, p: Point, m: widget.Metrics) -> int {
    val band = band_height(t, style, m)
    if band <= 0.0 || len(t.columns) < 2 {
        return 0 - 1
    }
    if p.y < bounds.y || p.y >= bounds.y + band {
        return 0 - 1
    }
    var i = 0
    while i < len(t.columns) - 1 {
        val edge = bounds.x + column_x(t, i + 1) - t.offset_x
        if p.x >= edge - style.space.s && p.x < edge + style.space.s {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

pub fn table_row_name(t: Table, row: int) -> string {
    return concat(t.name, "/row/", str(row))
}

pub fn column_header_name(t: Table, column: int) -> string {
    return concat(t.name, "/column/", str(column))
}

pub struct TableStep {
    table: Table
    // The selection changed.
    moved: bool
    // A row was chosen -- Enter or Space on the selection. Separate from `moved` for `ListStep`'s
    // reason: arrowing to a row and opening it are different intentions.
    activated: bool
    // A column's width changed. **A third output rather than folded into `moved`**, because an
    // application that saves its column widths wants to know about this and does not want to write
    // a file every time the user arrows down a row.
    resized: bool
}

fn table_still(t: Table) -> TableStep {
    return TableStep { table: t, moved: false, activated: false, resized: false }
}

// What an input does to a table.
//
// **Three gestures in order of who owns the pointer**, the opening `list_input` has for the same
// reason: a resize in progress keeps it, then the scroll bar, then the rows. A press that is none
// of those -- on a header, on empty space below the last row -- does nothing at all.
pub fn table_input(t: Table, input: Input, bounds: Rect, f: Frame) -> TableStep {
    val style = f.style
    val m = f.metrics
    if t.disabled {
        return table_still(t)
    }
    val tall = row_height(m, style)
    val body = table_body(t, style, bounds, m)
    if Option.is_Some(t.grabbed) {
        return table_resized(t, input, style, bounds)
    }
    if Option.is_Some(t.bar.grabbed) || table_for_the_bar(t, style, body, input, tall) {
        return table_bar_step(t, input, body, tall, f)
    }
    val last = len(t.rows) - 1
    return switch input {
        Press(p) {
            val edge = edge_at(t, style, bounds, p, m)
            if edge >= 0 {
                val at = bounds.x + column_x(t, edge + 1) - t.offset_x
                TableStep {
                    table: with t { resizing: edge, grabbed: Option<float>.Some(p.x - at) },
                    moved: false,
                    activated: false,
                    resized: false
                }
            } else {
                if !widget.contains(body, p) {
                    table_still(t)
                } else {
                    val row = floor((p.y - body.y + t.offset) / tall)
                    if row < 0 || row > last {
                        table_still(t)
                    } else {
                        TableStep {
                            table: with t { selected: row },
                            moved: row != t.selected,
                            activated: false,
                            resized: false
                        }
                    }
                }
            }
        }
        // **A sideways wheel scrolls the columns and a vertical one the rows**, and the sideways
        // one is checked first: a trackpad sends both at once on a diagonal flick, and a table
        // that answered the vertical component first would never scroll sideways on hardware that
        // can do it.
        Wheel(w) {
            if w.horizontal != 0 {
                scrolled_sideways(t, t.offset_x + (w.horizontal as float) * tall, body)
            } else {
                scrolled_down(t, t.offset - (w.vertical as float) * tall, body, tall)
            }
        }
        KeyDown(k) { table_key(t, k, body, tall) }
        KeyUp(_) { table_still(t) }
        Text(_) { table_still(t) }
        Paste(_) { table_still(t) }
        Release(_) { table_still(t) }
        Move(_) { table_still(t) }
    }
}

fn table_for_the_bar(t: Table, style: Style, body: Rect, input: Input, tall: float) -> bool {
    if Press(p) = input {
        // **In the body, not merely in the bar's column of x.** `on_the_bar` answers from x alone,
        // which is right for a list whose whole box is rows; here the same x in the header is over
        // a column title, and this function's name is "is this press for the bar".
        //
        // **It changes no behaviour today and is kept anyway**, which a mutation proved rather than
        // guessed: dropping it, a press in the header at the bar's x does reach `table_bar_step`,
        // and `scroll_bar_input` then bounds-checks the press against `bar_box(body)` itself and
        // answers that nothing moved. So the guard is the second of two, and the reason to keep it
        // is that the first one is the one that is *about* this table -- a predicate that answers
        // "yes, that press was for the scroll bar" about a point in the header is wrong on its
        // face, whatever the code downstream does with the answer.
        return widget.contains(body, p) && on_the_bar(style, body, p, table_content(t, tall), body.height)
    }
    return false
}

fn table_content(t: Table, tall: float) -> float {
    return (len(t.rows) as float) * tall
}

fn table_bar_step(t: Table, input: Input, body: Rect, tall: float, f: Frame) -> TableStep {
    val style = f.style
    val taken = scroll_bar_input(
        t.bar,
        input,
        bar_box(style, body),
        table_content(t, tall),
        body.height,
        t.offset,
        f
    )
    return TableStep {
        table: with t { bar: taken.bar, offset: taken.offset },
        moved: false,
        activated: false,
        resized: false
    }
}

// A column being dragged wider or narrower.
//
// **The width is set from where the edge would land, not from how far the pointer moved**, which
// is the same choice `scroll_bar_input` makes for the thumb: accumulating deltas drifts, and a
// drag that leaves the window and comes back has no delta to add.
fn table_resized(t: Table, input: Input, style: Style, bounds: Rect) -> TableStep {
    val held = switch t.grabbed {
        Some(h) { h }
        None { 0.0 }
    }
    return switch input {
        Move(p) {
            if t.resizing < 0 || t.resizing >= len(t.columns) {
                table_still(t)
            } else {
                val start = bounds.x + column_x(t, t.resizing) - t.offset_x
                val want = p.x - held - start
                val now = if want < style.minimum.target { style.minimum.target } else { want }
                val was = t.columns[t.resizing].width
                val widths = mutable_array_new<Column>()
                var i = 0
                while i < len(t.columns) {
                    push(widths, if i == t.resizing { with t.columns[i] { width: now } } else { t.columns[i] })
                    i = i + 1
                }
                TableStep {
                    table: with t { columns: snapshot(widths) },
                    moved: false,
                    activated: false,
                    resized: now != was
                }
            }
        }
        // A release lets go wherever it happens, as a bar's and a divider's do.
        Release(_) {
            TableStep {
                table: with t { grabbed: Option<float>.None, resizing: 0 - 1 },
                moved: false,
                activated: false,
                resized: false
            }
        }
        Press(_) { table_still(t) }
        Wheel(_) { table_still(t) }
        KeyDown(_) { table_still(t) }
        KeyUp(_) { table_still(t) }
        Text(_) { table_still(t) }
        Paste(_) { table_still(t) }
    }
}

fn table_key(t: Table, k: Keystroke, body: Rect, tall: float) -> TableStep {
    val last = len(t.rows) - 1
    // **Sideways first, because it works on an empty table.** A table with no rows still has
    // columns, and a user who cannot see the last one should still be able to scroll to it.
    if Key.is_Left(k.key) {
        return scrolled_sideways(t, t.offset_x - tall, body)
    }
    if Key.is_Right(k.key) {
        return scrolled_sideways(t, t.offset_x + tall, body)
    }
    if last < 0 {
        return table_still(t)
    }
    val per_page = table_page(t, body, tall)
    if Key.is_Down(k.key) { return table_to(t, t.selected + 1, body, tall) }
    if Key.is_Up(k.key) { return table_to(t, t.selected - 1, body, tall) }
    if Key.is_PageDown(k.key) { return table_to(t, t.selected + per_page, body, tall) }
    if Key.is_PageUp(k.key) { return table_to(t, t.selected - per_page, body, tall) }
    if Key.is_Home(k.key) { return table_to(t, 0, body, tall) }
    if Key.is_End(k.key) { return table_to(t, last, body, tall) }
    if Key.is_Enter(k.key) || Key.is_Space(k.key) {
        if t.selected >= 0 {
            return TableStep { table: t, moved: false, activated: true, resized: false }
        }
    }
    return table_still(t)
}

fn table_page(t: Table, body: Rect, tall: float) -> int {
    val fits = floor(body.height / tall)
    return if fits < 1 { 1 } else { fits }
}

// Moves the selection and brings it into view by the least that works, as a list's does -- against
// the **body's** height, which is the whole reason `table_body` exists.
fn table_to(t: Table, want: int, body: Rect, tall: float) -> TableStep {
    val last = len(t.rows) - 1
    val row = if want < 0 { 0 } else { if want > last { last } else { want } }
    val revealed = widget.scroll_to_reveal(
        body.height,
        t.offset,
        (row as float) * tall,
        tall
    )
    return TableStep {
        table: with t { selected: row, offset: down_clamped(t, revealed, body, tall) },
        moved: row != t.selected,
        activated: false,
        resized: false
    }
}

fn scrolled_down(t: Table, offset: float, body: Rect, tall: float) -> TableStep {
    return TableStep {
        table: with t { offset: down_clamped(t, offset, body, tall) },
        moved: false,
        activated: false,
        resized: false
    }
}

fn scrolled_sideways(t: Table, offset: float, body: Rect) -> TableStep {
    return TableStep {
        table: with t { offset_x: widget.clamp_offset(offset, body.width, columns_width(t)) },
        moved: false,
        activated: false,
        resized: false
    }
}

fn down_clamped(t: Table, offset: float, body: Rect, tall: float) -> float {
    return widget.clamp_offset(offset, body.height, table_content(t, tall))
}

// A line of the grid, a point thick, filling whatever box it is given.
fn rule(style: Style) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.filled(style.grid),
        align: widget.stretched(),
        children: [],
        name: ""
    })
}

// One cell, drawn where its column says, with the grid line at its trailing edge.
//
// **The line is inside the column's width, not beside it.** A line added outside would make every
// column a point wider than the width it was dragged to, so the number a user set and the number
// the table used would differ by one -- and by one more every time a column was added.
fn cell_widget(t: Table, style: Style, column: int, text: string, ink: Color) -> widget.Widget {
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        // **On the space scale, as a list's and a tree's rows are**: the 6/2/6/2 this was written
        // as is the same air by a different route, and a cell that kept its points would clip its
        // own text at a compact density, where `row_height` is a line plus a smaller `s`.
        padding: widget.insets_of(style.space.s, style.space.xs, style.space.s, style.space.xs),
        surface: widget.no_surface(),
        align: widget.Alignment { across: widget.Across.Centre, along: t.columns[column].align },
        children: [widget.label_in_face(text, style.text.body.size, ink, style.text.body.face)],
        name: ""
    })
    return widget.fixed_of(t.columns[column].width, 0.0, widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: widget.stretched(),
        children: [widget.expand(inside), widget.fixed_of(style.stroke.hair, 0.0, rule(style))],
        name: ""
    }))
}

// The header: a strip of titles, scrolled sideways with the body and not vertically with it.
fn header_widget(t: Table, style: Style, ink: Color, m: widget.Metrics) -> widget.Widget {
    val cells = mutable_array_new<widget.Widget>()
    var i = 0
    while i < len(t.columns) {
        push(cells, widget.part_of(
            column_header_name(t, i),
            widget.Role.ColumnHeader,
            t.columns[i].title,
            with widget.no_state() { disabled: t.disabled },
            cell_widget(t, style, i, t.columns[i].title, ink)
        ))
        i = i + 1
    }
    // **The face is on the strip, not on the cells**, which is not a tidying: a viewport lays its
    // child out at the child's natural size, so a header built only of cells is exactly as wide as
    // the columns -- and a table narrower than its pane then draws a header band that stops in the
    // middle of the window while the rows below it run to the edge. The band is the strip; the
    // cells scroll inside it.
    // **`expand`, because a viewport measures as nothing.** A `Scroll` is a window onto something
    // larger and takes the box it is given rather than asking for one -- so as the plain child of
    // a row it is laid out zero points wide and the whole header disappears, band and titles
    // alike. It was the Fixed's job to give it a width before the band existed; now it has to ask
    // for the leftover.
    val titles = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: widget.stretched(),
        children: [widget.expand(widget.named_scroll(
            concat(t.name, "/header"),
            t.offset_x,
            0.0,
            widget.row_of(0.0, snapshot(cells))
        ))],
        name: ""
    })
    return widget.fixed_of(0.0, header_height(m, style), widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: surface_of(style, parts_for(style, mood_of(false, false, false, false))),
        align: widget.stretched(),
        // The band, then the line that separates it from the rows -- which is the one grid line a
        // table must have even when the others are too quiet to see.
        children: [widget.expand(titles), widget.fixed_of(0.0, style.stroke.hair, rule(style))],
        name: ""
    }))
}

// The table as a widget: a header over a viewport of rows.
//
// **One control and one tab stop**, as a list is: Tab reaches the table and the arrows move within
// it. The rows are `part_of` -- something a click and a reader reach and Tab does not -- and so are
// the column headers, which is what will make a header sortable without a second tab stop per
// column.
pub fn table_widget(t: Table, f: Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    val ink = parts_for(style, mood_of(t.disabled, false, false, false)).ink
    val tall = row_height(m, style)
    val rows = mutable_array_new<widget.Widget>()
    var r = 0
    while r < len(t.rows) {
        val chosen = r == t.selected
        val row_parts = parts_for(
            style,
            mood_of(
                t.disabled,
                pressed_in(f, table_row_name(t, r)),
                chosen,
                hovered_in(f, table_row_name(t, r))
            )
        )
        val cells = mutable_array_new<widget.Widget>()
        var c = 0
        while c < len(t.columns) {
            // **The row's ink, so a cell's text follows the band under it.** A chosen row on an
            // accented selection needs `on_accent` here, and the table was the one control that
            // drew its words from the control and its band from the row.
            push(cells, cell_widget(t, style, c, cell_at(t, r, c), row_parts.ink))
            c = c + 1
        }
        val body = widget.part_of(
            table_row_name(t, r),
            widget.Role.TableRow,
            row_label(t, r),
            with widget.no_state() { selected: chosen, disabled: t.disabled },
            widget.Widget.Group(widget.Stack {
                direction: widget.Direction.Row,
                spacing: 0.0,
                padding: widget.no_insets(),
                surface: if chosen {
                    band_of(style, row_parts)
                } else {
                    widget.no_surface()
                },
                align: widget.stretched(),
                children: snapshot(cells),
                name: ""
            })
        )
        // **The line is under the row and inside its height**, for the reason the cell's is inside
        // its width: a row that grew a point would make `row_height` a lie, and every press that
        // divides by it would land a row lower further down the table.
        push(rows, widget.fixed_of(0.0, tall, widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Column,
            spacing: 0.0,
            padding: widget.no_insets(),
            surface: widget.no_surface(),
            align: widget.stretched(),
            children: [widget.expand(body), widget.fixed_of(0.0, style.stroke.hair, rule(style))],
            name: ""
        })))
        r = r + 1
    }
    val body = widget.expand(widget.named_scroll(
        concat(t.name, "/body"),
        t.offset_x,
        t.offset,
        widget.column_of(0.0, snapshot(rows))
    ))
    val parts = if t.headers {
        [header_widget(t, style, ink, m), body]
    } else {
        [body]
    }
    return widget.Widget.Control(widget.Focusable {
        name: t.name,
        role: widget.Role.Table,
        label: t.label,
        description: "",
        value: "",
        state: with widget.no_state() { disabled: t.disabled },
        focus_part: "",
        tab_stop: true,
        child: widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Column,
            spacing: 0.0,
            padding: widget.no_insets(),
            surface: widget.no_surface(),
            align: widget.stretched(),
            children: parts,
            name: ""
        })
    })
}

// ------------------------------------------------------- radio buttons

// How tall one option is. **A val rather than a field**, as `bar_thickness` is: a group whose
// options were different heights would be a list, and a list is a different control.

// A choice of one from several.
//
// **The control is the group, not the button**, which is the whole difference from a check box. A
// lone radio button is a control a user cannot undo: there is no gesture that unselects one, so a
// single radio is a switch that can only ever be turned on. What a user is choosing is which of N,
// and that is one piece of state, so it is one control with one tab stop and one name -- which is
// also what makes the arrows work, since a group is the only thing that knows what "the next one"
// is.
//
// **A column, and only a column.** A row of options needs every option to be the same width to be
// hit-tested -- the compromise `Tabs.tab_width` makes -- and an option's label is a sentence where
// a tab's is a word. A row of two short options is a real layout and this does not do it yet.
pub struct Radios {
    name: string
    label: string
    items: [string]
    // The chosen option, or -1 for none. **A real state**: a group a user has not touched and that
    // was given no default has nothing chosen, and inventing one would answer a question nobody
    // asked.
    selected: int
    disabled: bool
}

pub fn radios_of(name: string, label: string, items: [string], selected: int) -> Radios {
    return Radios {
        name: name,
        label: label,
        items: items,
        selected: if selected < 0 || selected >= len(items) { 0 - 1 } else { selected },
        disabled: false
    }
}

// An option's own name, which focus and accessibility address it by.
pub fn radio_name(r: Radios, index: int) -> string {
    return concat(r.name, "/", str(index))
}

pub struct RadioStep {
    radios: Radios
    moved: bool
}

fn radios_still(r: Radios) -> RadioStep {
    return RadioStep { radios: r, moved: false }
}

fn radio_to(r: Radios, want: int) -> RadioStep {
    val last = len(r.items) - 1
    if last < 0 {
        return radios_still(r)
    }
    val at = if want < 0 { 0 } else { if want > last { last } else { want } }
    return RadioStep { radios: with r { selected: at }, moved: at != r.selected }
}

// What an input does to a group.
//
// **The arrows select, they do not merely move.** That is what a radio group does everywhere and
// it is the opposite of a list: there is no second keystroke to confirm, because a radio group
// *is* the confirmation -- it has no state between "looking at" and "chosen". A group that needed
// Space after an arrow would leave a keyboard user with a selection the screen disagrees with.
//
// **Both pairs of arrows, unlike a split pane.** A column of options is navigated with Up and Down
// by every keyboard user and with Left and Right by every one who learned radios on a form where
// they were in a row; neither is wrong about what "the next option" means.
pub fn radios_input(r: Radios, input: Input, bounds: Rect, f: Frame) -> RadioStep {
    val style = f.style
    if r.disabled {
        return radios_still(r)
    }
    val last = len(r.items) - 1
    return switch input {
        Press(p) {
            if !widget.contains(bounds, p) {
                radios_still(r)
            } else {
                val row = floor((p.y - bounds.y) / style.minimum.target)
                if row < 0 || row > last {
                    radios_still(r)
                } else {
                    radio_to(r, row)
                }
            }
        }
        KeyDown(k) { radios_key(r, k) }
        KeyUp(_) { radios_still(r) }
        Text(_) { radios_still(r) }
        Paste(_) { radios_still(r) }
        Release(_) { radios_still(r) }
        Move(_) { radios_still(r) }
        // **A wheel over a group chooses nothing.** A user scrolling a form past a group of
        // options has not asked to change their answer, and a group that changed it would be a
        // form that fills itself in wrong as you read it.
        Wheel(_) { radios_still(r) }
    }
}

fn radios_key(r: Radios, k: Keystroke) -> RadioStep {
    val last = len(r.items) - 1
    if last < 0 {
        return radios_still(r)
    }
    // **From the first option when nothing is chosen**, whichever arrow is pressed: a group with
    // no selection has no "next", and starting at the top is what a user pressing Down expects
    // where starting at the bottom is a surprise.
    val here = if r.selected < 0 { 0 } else { r.selected }
    if Key.is_Down(k.key) || Key.is_Right(k.key) {
        return radio_to(r, if r.selected < 0 { 0 } else { here + 1 })
    }
    if Key.is_Up(k.key) || Key.is_Left(k.key) {
        return radio_to(r, if r.selected < 0 { 0 } else { here - 1 })
    }
    if Key.is_Home(k.key) {
        return radio_to(r, 0)
    }
    if Key.is_End(k.key) {
        return radio_to(r, last)
    }
    // Space chooses the option the group is on, which is already chosen -- so it reports nothing
    // and exists only so that a user who presses it is not told their keyboard is broken.
    if Key.is_Space(k.key) && r.selected >= 0 {
        return radios_still(r)
    }
    return radios_still(r)
}

// The group as a widget: an option per row, each a part of the group.
//
// **The options carry `checked`, and the group carries nothing**, which is what a reader reads:
// it announces "radio button, Weekly, checked" for the one you are on. A group holding an index
// would make every adapter work out for itself which child the number meant.
pub fn radios_widget(r: Radios, f: Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    val ink = parts_for(style, mood_of(r.disabled, false, false, false)).ink
    val side = line_for(m, style.text.label)
    val rows = mutable_array_new<widget.Widget>()
    var i = 0
    while i < len(r.items) {
        val chosen = i == r.selected
        // **Each option is its own control for the purpose of a state**, which is why the mood
        // is computed per option and not per group: one of five circles is chosen, one may be
        // under the pointer, and they are rarely the same one.
        val chosen_parts = parts_for(
            style,
            mood_of(r.disabled, pressed_in(f, radio_name(r, i)), chosen, hovered_in(f, radio_name(r, i)))
        )
        val dot = widget.fixed_of(side, side, widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Row,
            spacing: 0.0,
            padding: widget.no_insets(),
            // **A circle, always, whatever the theme's corner is.** A square radio button is the
            // one shape a user reads as a check box, and the difference between the two controls
            // is the difference between "some of these" and "one of these" -- which is worth more
            // than a theme's consistency. `Fraction(0.5)` is a capsule of any size, and the box
            // is a square, so it is a circle.
            surface: widget.Surface {
                // **Zero, because a circle is an ornament and not the control's frame.** The row a
                // radio is in expands if a look says so; the dot inside it does not.
                inset: 0.0,
                fill: Option<Paint>.Some(chosen_parts.face),
                border: chosen_parts.border,
                corner: style.shape.full,
                corners: widget.Corners.All,
                shadow: Option<widget.Shadow>.None
            },
            align: widget.centred(),
            // A path, for the check box's reasons: centred by geometry rather than by a
            // baseline, and needing no glyph to exist in whatever face the window loaded.
            children: [
                if chosen {
                    widget.fixed_of(side, side, widget.drawn_of(dot(), ink))
                } else {
                    widget.Widget.Nothing
                }
            ],
            name: ""
        }))
        val row = widget.Widget.Group(widget.Stack {
            direction: widget.Direction.Row,
            spacing: style.text.label.size * 0.5,
            // **A left inset, because the focus ring is drawn inside the control's own box.** With
            // none, the first option's circle sat at the very first point of the group -- under
            // the two-point ring, which paints after the options and so over them. The tree had
            // exactly this and for exactly this reason.
            padding: widget.insets_of(4.0, 2.0, 0.0, 2.0),
            surface: widget.no_surface(),
            align: widget.Alignment { across: widget.Across.Centre, along: widget.Along.Start },
            children: [dot,
                widget.label_in_face(r.items[i], style.text.label.size, chosen_parts.ink, style.text.label.face)],
            name: ""
        })
        push(rows, widget.fixed_of(0.0, style.minimum.target, widget.part_of(
            radio_name(r, i),
            widget.Role.RadioButton,
            r.items[i],
            with widget.no_state() {
                disabled: r.disabled,
                checked: Option<Toggle>.Some(if chosen { Toggle.On } else { Toggle.Off })
            },
            row
        )))
        i = i + 1
    }
    return widget.Widget.Control(widget.Focusable {
        name: r.name,
        // **A group, which is what AT-SPI calls the container of a set of radio buttons.** It is
        // not itself a radio button, and a reader that announced it as one would be describing a
        // control that cannot be operated.
        role: widget.Role.Group,
        label: r.label,
        description: "",
        value: "",
        state: with widget.no_state() { disabled: r.disabled },
        focus_part: "",
        tab_stop: true,
        child: widget.column_of(0.0, snapshot(rows))
    })
}

// ------------------------------------------------------------- the slider

// How thick the track is, and how wide the thumb is. **Shared by the widget and the hit test**,
// which is `bar_thickness`'s rule.
pub val thumb_width = 14.0
// How tall the thumb is drawn.
//
// **Given rather than taken from the row**, because a thumb is a thing of its own size: a slider
// in a 60-point row should not have a 60-point thumb. The first version placed it in a layer of
// height zero -- a rect `layer_at` honoured exactly -- so the slider drew a track and nothing to
// drag, which is the same mistake the link made with a `Fixed` of height zero on the same
// afternoon. A box whose size nobody states is a box of nothing.
pub val thumb_height = 18.0

// A number chosen by dragging.
//
// **The range and the step are the control's, not the application's.** A slider that took a
// fraction and left the arithmetic outside would make every caller write the same three lines,
// and get the clamp wrong in at least one of them -- which is the shape `scroll_to_reveal` and
// `clamp_offset` already exist to prevent elsewhere.
pub struct Slider {
    name: string
    label: string
    value: float
    least: float
    most: float
    // What one arrow key moves, and what the value is snapped to. **Zero means no snapping**,
    // which is a continuous slider and a real thing to want -- a colour picker's hue has no
    // steps.
    step: float
    // Where in the thumb the pointer took hold, measured from the thumb's start, or `None` when
    // nothing is being dragged.
    //
    // **A distance and not a flag**, which is what makes a drag resume from where the thumb
    // already is: a slider that recomputed the value from the pointer alone jumped the thumb's
    // own width the instant it was touched, and then tracked the pointer from there. `ScrollBar`
    // and `SplitPane` carry the same offset for the same reason.
    grabbed: Option<float>
    disabled: bool
}

pub fn slider_of(name: string, label: string, least: float, most: float, value: float) -> Slider {
    return with Slider {
        name: name,
        label: label,
        value: value,
        least: least,
        most: if most < least { least } else { most },
        step: 1.0,
        grabbed: Option<float>.None,
        disabled: false
    } {
        value: snapped_value(least, if most < least { least } else { most }, 1.0, value)
    }
}

// A value clamped into the range and snapped to the step.
//
// **One function, used by every gesture and by the constructor**, so a slider can never hold a
// value it would refuse to be dragged to -- which is the state that makes a control look broken
// the first time a user touches it.
pub fn snapped_value(least: float, most: float, step: float, want: float) -> float {
    val held = if want < least { least } else { if want > most { most } else { want } }
    if step <= 0.0 {
        return held
    }
    val steps = (held - least) / step
    val whole = (floor(steps + 0.5) as float) * step
    val landed = least + whole
    return if landed > most { most } else { landed }
}

// Where the thumb's left edge sits, in points from the start of the track.
//
// **One function, read by the widget and by every gesture** -- `thumb_of`'s rule, for the reason
// it keeps being restated: a thumb drawn by one calculation and dragged by another jumps under
// the pointer.
pub fn slider_at(s: Slider, width: float) -> float {
    val room = width - thumb_width
    if room <= 0.0 || s.most <= s.least {
        return 0.0
    }
    return room * (s.value - s.least) / (s.most - s.least)
}

// The value a thumb whose left edge is at `left` would be showing, before it is snapped.
//
// **The thumb's edge and not the pointer**, which is what `grabbed` is subtracted for: every
// gesture turns a pointer into a thumb position first, so a drag that took hold two points into
// the thumb keeps those two points for as long as it is held.
fn value_for_thumb(s: Slider, bounds: Rect, left: float) -> float {
    val room = bounds.width - thumb_width
    if room <= 0.0 {
        return s.least
    }
    return s.least + (s.most - s.least) * (left - bounds.x) / room
}

pub struct SliderStep {
    slider: Slider
    moved: bool
}

fn slider_still(s: Slider) -> SliderStep {
    return SliderStep { slider: s, moved: false }
}

fn slider_to(s: Slider, want: float) -> SliderStep {
    val now = snapped_value(s.least, s.most, s.step, want)
    return SliderStep { slider: with s { value: now }, moved: now != s.value }
}

// What an input does to a slider.
//
// **A press anywhere on the track takes the value under it**, rather than paging towards it as a
// scroll bar does. The two look alike and mean different things: a scroll bar moves a view and a
// page is the unit a reader moves by, where a slider *is* the value and a user pressing at the
// three-quarter mark is asking for three quarters. It takes hold at the same time, so a press and
// a drag are one gesture.
pub fn slider_input(s: Slider, input: Input, bounds: Rect) -> SliderStep {
    if s.disabled {
        return slider_still(s)
    }
    return switch input {
        // **A press on the thumb takes hold of it where it was pressed; a press on the track
        // jumps.** Both end up dragging, and the difference is the one a hand feels: dragging the
        // thumb must not move it before the hand does, where pressing the track at the
        // three-quarter mark is asking for three quarters and should go there at once.
        Press(p) {
            if !widget.contains(bounds, p) {
                slider_still(s)
            } else {
                val at = bounds.x + slider_at(s, bounds.width)
                if p.x >= at && p.x < at + thumb_width {
                    SliderStep { slider: with s { grabbed: Option<float>.Some(p.x - at) }, moved: false }
                } else {
                    // Taken by its middle, so the thumb lands centred under the pointer and the
                    // drag that follows is relative from there like any other.
                    val taken = slider_to(s, value_for_thumb(s, bounds, p.x - thumb_width / 2.0))
                    SliderStep {
                        slider: with taken.slider { grabbed: Option<float>.Some(thumb_width / 2.0) },
                        moved: taken.moved
                    }
                }
            }
        }
        Move(p) {
            switch s.grabbed {
                Some(held) { slider_to(s, value_for_thumb(s, bounds, p.x - held)) }
                None { slider_still(s) }
            }
        }
        Release(_) { SliderStep { slider: with s { grabbed: Option<float>.None }, moved: false } }
        KeyDown(k) { slider_key(s, k) }
        KeyUp(_) { slider_still(s) }
        Text(_) { slider_still(s) }
        Paste(_) { slider_still(s) }
        // **The wheel moves it**, unlike a list's selection and unlike a split pane's divider: a
        // slider under the pointer is the thing the pointer is for, and every volume control ever
        // built answers the wheel.
        Wheel(w) { slider_to(s, s.value + (w.vertical as float) * slider_step(s)) }
    }
}

// What one keypress or notch moves. The step when there is one, and a hundredth of the range when
// there is not -- a continuous slider still has to be usable from the keyboard.
fn slider_step(s: Slider) -> float {
    if s.step > 0.0 {
        return s.step
    }
    return (s.most - s.least) / 100.0
}

fn slider_key(s: Slider, k: Keystroke) -> SliderStep {
    val one = slider_step(s)
    // A page is a tenth of the range, floored at one step, which is what makes PageUp useful on a
    // slider of 1000 and harmless on a slider of 5.
    val page = if (s.most - s.least) / 10.0 > one { (s.most - s.least) / 10.0 } else { one }
    if Key.is_Right(k.key) || Key.is_Up(k.key) {
        return slider_to(s, s.value + one)
    }
    if Key.is_Left(k.key) || Key.is_Down(k.key) {
        return slider_to(s, s.value - one)
    }
    if Key.is_PageUp(k.key) {
        return slider_to(s, s.value + page)
    }
    if Key.is_PageDown(k.key) {
        return slider_to(s, s.value - page)
    }
    if Key.is_Home(k.key) {
        return slider_to(s, s.least)
    }
    if Key.is_End(k.key) {
        return slider_to(s, s.most)
    }
    return slider_still(s)
}

// The slider as a widget: a track with a thumb on it.
//
// **It is not told how wide it is, and that is the fix for a real defect.** This took a `width`
// and placed the thumb at `slider_at(s, width)` -- while `slider_input` computed the same
// position from the `bounds` the layout actually gave the control. Two numbers for one thing, and
// they agreed only while a caller passed the width it then laid the slider out in. The gallery
// put one in a `widget.expand`, so the drawn thumb and the one the press looked for were hundreds
// of points apart: taking hold of the thumb you could see was a press on the track, and the
// slider jumped. This module keeps relearning the same rule -- `thumb_of` states it, `split_at`
// states it -- and this time the answer is to remove the second number rather than to document
// it.
//
// **The thumb is placed by two flexible spaces instead**, whose weights are the value's share of
// the range and the rest of it. A stack divides its leftover room in the ratio of its flexible
// children, and the leftover room here is exactly the track less the thumb -- so the thumb lands
// where `slider_at` says in whatever box the layout gives it, by construction, with no width for
// anyone to pass wrongly.
pub fn slider_widget(s: Slider, f: Frame) -> widget.Widget {
    val style = f.style
    val held = switch s.grabbed {
        Some(_) { true }
        None { false }
    }
    val parts = parts_for(style, mood_of(s.disabled, held, false, hovered_in(f, s.name)))
    val track = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: highlight_of(style, style.states.disabled.ink),
        align: widget.stretched(),
        children: [],
        name: ""
    })
    val thumb = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: surface_of(style, parts),
        align: widget.stretched(),
        children: [],
        name: ""
    })
    // How far along the range the value sits, as a fraction: the first weight. **Clamped and
    // guarded**, because a range of nothing is a slider with one value and a weight of zero over
    // zero is not a number.
    val along = if s.most <= s.least {
        0.0
    } else {
        val share = (s.value - s.least) / (s.most - s.least)
        if share < 0.0 { 0.0 } else { if share > 1.0 { 1.0 } else { share } }
    }
    // **The thumb's height is still stated, because a row does not know it.** `Across.Centre` does
    // not stretch, so a `Fixed` of height zero here would be zero -- which is how this drew a
    // track and nothing to drag the first time.
    val over = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: widget.Alignment { across: widget.Across.Centre, along: widget.Along.Start },
        children: [
            widget.flex_of(along),
            widget.fixed_of(thumb_width, thumb_height, thumb),
            widget.flex_of(1.0 - along)
        ],
        name: ""
    })
    val lane = widget.Widget.Layered(widget.Stacked {
        name: "",
        layers: [
            // The track is centred in the lane, so the thumb overhangs it either side.
            widget.base_layer(widget.column_of(0.0, [
                widget.flex(),
                widget.fixed_of(0.0, style.space.s, track),
                widget.flex()
            ])),
            widget.base_layer(over)
        ]
    })
    return widget.Widget.Control(widget.Focusable {
        name: s.name,
        role: widget.Role.Slider,
        label: s.label,
        description: "",
        // **The value, which is the whole of what a slider is.** A reader that said "Volume,
        // slider" and stopped would have told the user nothing they could not have guessed.
        value: str(floor(s.value)),
        state: with widget.no_state() { disabled: s.disabled },
        focus_part: "",
        tab_stop: true,
        child: lane
    })
}

// --------------------------------------------------------------- the link

// Text that goes somewhere.
//
// **A control, not a label**, which is the point: a link has to be reachable by Tab, operable by
// Enter, and announced as a link, and a coloured label is none of those. What it does *not* do is
// go anywhere -- this layer has no browser and no idea what a URL means -- so it answers that it
// was activated and the application decides.
pub struct Link {
    name: string
    // What it says.
    label: string
    // Where it goes, which this layer never reads. It is handed back on activation so an
    // application does not have to keep a second table from names to destinations.
    href: string
    held: bool
    disabled: bool
}

// How thick the underline is and how far under the words it sits. **Two numbers shared by the
// widget and by the height it asks for**, which is the only way the box can be exactly as tall as
// what goes in it.

pub fn link_of(name: string, label: string, href: string) -> Link {
    return Link { name: name, label: label, href: href, held: false, disabled: false }
}

pub struct LinkStep {
    link: Link
    // **Followed, not clicked**: a press that drags off and releases elsewhere is not a follow,
    // which is `ButtonStep.activated`'s rule and the reason this is built on a button.
    followed: bool
}

pub fn link_input(l: Link, input: Input, bounds: Rect) -> LinkStep {
    val step = button_input(with button_of(l.name, l.label) { disabled: l.disabled, held: l.held }, input, bounds)
    return LinkStep { link: with l { held: step.button.held }, followed: step.activated }
}

// The link as a widget: its text, underlined.
//
// **The underline is the signal, not the colour.** A link told apart from body text by hue alone
// is a link a colour-blind reader cannot find, and `Style` has no link colour to set -- which is
// the right way round: the underline works in every theme and on every display, where a blue that
// reads on white is a blue that vanishes on navy. A theme that wants a coloured link is the
// argument for a `Style.link` field, and nothing has made that argument yet.
//
// **It measures its own text, which is why it takes a `Metrics`.** The first version put the
// label and the rule in a stretched column and said in a comment that the column would be as wide
// as its widest child -- and a column is as wide as the box it is *given*, which at the root of a
// layout is the whole window. So the underline ran the width of the pane with the words at one
// end of it. A control that wants to be the size of its text has to ask how wide its text is;
// `check_box_widget` takes a `Metrics` to make a square for the same kind of reason.
pub fn link_widget(l: Link, f: Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    // A link shows its states with a band rather than a face: see the surface below.
    val mood = mood_of(l.disabled, l.held, false, hovered_in(f, l.name))
    val parts = parts_for(style, mood)
    val ink = parts.ink
    val rule = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: widget.no_insets(),
        surface: widget.filled(ink),
        align: widget.stretched(),
        children: [],
        name: ""
    })
    // The text's own width, which is what the rule under it is fixed to, and its own height,
    // which it has to be told.
    //
    // **A `Fixed` of zero on an axis is zero unless its parent stretches it**, and the row below
    // centres across rather than stretching -- so the first version of this measured zero high and
    // the link drew nothing at all: no rule, no words, no error. The check box learned the same
    // thing from the other side, where a stretched row made its square a rectangle. A stack can be
    // told not to stretch a child; it cannot be given one whose size it does not know.
    val words = widget.width_in(m, style.text.body.face, l.label, style.text.body.size)
    val tall = line_for(m, style.text.body) + style.stroke.hair * 2.0
    val underlined = widget.fixed_of(words, tall, widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: style.stroke.hair,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: widget.stretched(),
        children: [
            widget.label_in_face(l.label, style.text.body.size, ink, style.text.body.face),
            widget.fixed_of(0.0, style.stroke.hair, rule)
        ],
        name: ""
    }))
    val inside = widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: 0.0,
        padding: padded_for(style),
        surface: if marked(mood) { band_of(style, parts) } else { widget.no_surface() },
        // **`Along.Start`, so the text stays at the start of whatever box the link is given.** A
        // link centred in a wide row would be a link that moves when the window is resized.
        align: widget.Alignment { across: widget.Across.Centre, along: widget.Along.Start },
        children: [underlined],
        name: ""
    })
    return widget.Widget.Control(widget.Focusable {
        name: l.name,
        role: widget.Role.Link,
        label: l.label,
        // **The destination is not announced.** A reader that read every URL aloud would be
        // unusable on a page of links, and what a user needs to hear is where it goes in words,
        // which is the label's job. An application with a reason to say more sets a description of
        // its own.
        description: "",
        value: "",
        state: with widget.no_state() { disabled: l.disabled },
        focus_part: "",
        tab_stop: true,
        child: inside
    })
}

// --------------------------------------------------------- what the pointer is over

// The shape the pointer should take over a split pane's box.
//
// **Asked of the control rather than worked out by the application**, which is the whole reason
// it is here: where the divider is is `split_at`'s answer, and an application computing it a
// second time to decide a cursor would be the two-calculations bug this module keeps designing
// against -- a cursor that changes shape a few points away from the line it belongs to.
pub fn split_pane_cursor(s: SplitPane, style: Style, bounds: Rect, p: Point) -> widget.Cursor {
    if s.disabled || !widget.contains(divider_rect(s, style, bounds), p) {
        return widget.Cursor.Arrow
    }
    return switch s.direction {
        Row { widget.Cursor.ResizeAcross }
        Column { widget.Cursor.ResizeDown }
    }
}

// The shape the pointer should take over a table's box: the resize arrows over a column's
// trailing edge in the header, and nothing anywhere else.
//
// **`edge_at` is the same function the press uses**, so the shape and the gesture agree by
// construction: the pointer cannot show arrows where a drag would select a row.
pub fn table_cursor(t: Table, style: Style, bounds: Rect, p: Point, m: widget.Metrics) -> widget.Cursor {
    if t.disabled || edge_at(t, style, bounds, p, m) < 0 {
        return widget.Cursor.Arrow
    }
    return widget.Cursor.ResizeAcross
}

// ------------------------------------------------------------------- the style

// How a control is drawn. Injected rather than global, for the reason `widget.Metrics` is: a module
// that reads a theme from somewhere cannot be tested against two themes, and an application with
// two panels cannot style them differently.
// The spacing scale a theme sets and the control set indexes.
//
// **Six steps, as Material and most design systems ship**, so a scale maps one-to-one onto what a
// design tool exports. `controls` says **once** which step each control uses, and a theme never
// names a control -- which is the whole shape of this layer and the reason a selector language
// would have nothing to select.
//
// **This replaced eleven numbers rather than one.** Every control here invented its own insets --
// the tree 4 and 2, the table 6 and 2, a radio 4 and 2, a cell 6 and 2 -- so a theme asking for
// more room had nothing to set. The single `space` token that stood here before was the step of a
// scale whose other steps did not exist.
// The corner roundings a theme sets and the control set indexes.
//
// **Four steps, every one with a reader.** D1's sketch had five, with a `none`; it was dropped
// rather than shipped empty, because a look that wants square corners says `Square` in each of
// these and a step nothing reads is a decision a look author has to make for nothing.
//
// **`full` is a role rather than a preference.** A radio's dot is a circle in every look here,
// including the square one, because round-against-square is how a user tells a radio from a check
// box -- so `plain` sets `full` to `Fraction(0.5)` while setting every other step to `Square`. A
// look may square it and would be wrong to.
// One role of a theme's type scale: which face it is drawn in, how big, and how far apart lines of
// it sit.
//
// **`line` is a multiplier, not a height.** `widget.FaceMetrics.line_height` is a function of size
// computed from the font and it stays authoritative; a theme may only stretch it. The precedent is
// in the same struct: `FaceMetrics.ascent` exists because "a baseline cannot be guessed from a line
// height", and every glyph in this widget set was once drawn a descent too low with every box
// correct. The font knows its own ascent, descent and gap, and a theme written against a Latin face
// does not know what CJK or Devanagari need. See D14 in docs/design/look-and-feel.md.
//
// **`face` is an index into the faces an application loaded**, and it is clamped rather than
// trusted: see `face_for`.
pub struct Type {
    face: int
    size: float
    line: float
}

// The type scale a theme sets and its readers index.
//
// **Five roles, and the library reads two of them.** `body` is text a control *contains* -- a
// field's content, a list's rows, a table's cells, a link -- and `label` is a control's own name:
// a button, a tab, a menu's title, a check box, a radio. The other three have **application**
// readers rather than control ones, and that is not an oversight: a heading is not a control, which
// is why `controls` was never going to draw one.
//
// **That gap is why this exists.** `Style` used to carry `heading_size` and `small_size` and
// **nothing read either of them** -- while the gallery's design files and curly's each declared
// `val heading_size = 12.0` and `val small_size = 11.0` for themselves, at 12 where the theme said
// 16. Two applications invented a type scale because the one in the theme was unreachable from
// where they needed it. The sizes here are what those applications actually draw, so adopting the
// scale moves no pixels; see Q7/D17.
pub struct TypeScale {
    // An application's own headings. No control draws one.
    heading: Type
    // Text a control contains, and **every caret calculation**: a caret measured in one role and
    // drawn in another drifts by a character per character, which `Style.text_font` already caused
    // once.
    body: Type
    // A control's own name: a button's words, a tab's title, a check box's label.
    label: Type
    // A hint, a footnote, a count beside a heading.
    caption: Type
    // A monospaced pane. The gallery's Code tab is the first caller this layer ever had for a
    // second face, and it used to reach it by overriding `text_font` at the call site.
    code: Type
}

pub struct Shape {
    // A chosen row in a list, a tree or a table: a subtler shape than a control's own face.
    small: widget.Radius
    // A control's face: a button, a field, a tab, a menu's title, a scroll bar's thumb.
    medium: widget.Radius
    // What stands in front of the window: a menu's popup, a combo box's list, a dialog's panel.
    // **Rounded further than a face**, which is what every system does -- Material puts a dialog at
    // 28 and a button at 20 -- and what the single `corner` token could not say.
    large: widget.Radius
    // As round as the box allows: a radio's dot, a capsule.
    full: widget.Radius
}

pub struct Space {
    none: float
    xs: float
    s: float
    m: float
    l: float
    xl: float
}

// The sizes a density may not go below.
//
// **Its own group precisely so that density cannot reach it.** `target` is 24 points, which is also
// WCAG 2.2's minimum target size (SC 2.5.8) -- and two of the three numbers that became this were
// already exactly 24. Had a compact density scaled them, the library's densest mode would have been
// the one that fails an accessibility criterion, and the gate would have had to be told to permit
// it. Compact tightens padding and gaps; a scroll thumb and a radio stay grabbable.
pub struct Minimum {
    // The least a control the pointer must hit may measure on either axis.
    target: float
    // The shortest a scroll bar's thumb may become, however long the content is. A thumb that
    // shrank without limit would vanish on exactly the document it matters most on.
    thumb: float
}

// The widths of the lines the control set draws.
//
// **Not on the space scale, because a hairline is a hairline at every density.** A grid line that
// doubled in a spacious theme would stop being a grid line and start being a border.
pub struct Stroke {
    // One device line: a table's grid, a link's underline, and the gap between the two -- the rule
    // sits one hairline below the text, so the gap and the line move together.
    hair: float
    // A line meant to be read *as* a line: a split pane's divider.
    line: float
}

pub struct Style {
    padding: Insets
    ink: Color
    face: Color
    // The surface a control is drawn **on**, as against `face`, which is what a control is drawn
    // **as**.
    //
    // **Added because there was no such distinction and a dialog proved it.** A dialog's panel was
    // `style.face`, and so is every button's face -- so the buttons in the first dialog anyone
    // looked at were invisible: the text was there, floating, with no edge or fill to say it could
    // be pressed. The same shape had already cost a split pane's divider, drawn in `face` beside
    // a control in `face`. Two colours for two things is what every other widget set has, and one
    // colour for both is a default that hides controls.
    //
    // **So the plain look does not keep its pixels here**, where F286 deliberately did: a look
    // that cannot show a button on a panel is not a look to preserve.
    panel: Color
    // What the window itself is painted, behind every control.
    //
    // **A look and feel could not say what colour the window was**, which is the same gap
    // `accent` had: the gallery wrote `rgb8(246, 247, 249)` into its own `raster.Options` and
    // curly wrote `rgb(0.98, 0.98, 0.99)` into its own, so the one colour with the largest area in
    // the window was the one the theme did not own. It is the reason a dark look and feel was not
    // expressible here before -- dark controls on a white window is not a dark theme, it is a
    // mistake.
    //
    // **Not drawn by any control**, because no control owns the window: an application passes this
    // to `raster.Options.background` (or fills with it) and the controls sit on top. That is the
    // one token here with a caller-side obligation, and `lib/ui/theme`'s header says so too.
    window: Color
    // The lines between a table's cells.
    //
    // **A table without them is a list with gaps in it.** Rows of numbers in columns need
    // something to tell the eye which cell a figure belongs to -- which is what every spreadsheet
    // and every table in every toolkit draws, and what this one was missing. Light enough to
    // recede, dark enough to be a line: it has to read against both the row's own face and the
    // window behind it.
    grid: Color
    // Under the text being composed through an input method, and under the run of it the method
    // is converting right now. **Two, because they mean different things to the person typing**:
    // the first says "this is not committed yet" and the second says "this is the part your next
    // keystroke changes", and a field that drew them alike would lose the distinction a candidate
    // list is navigated by.
    composing_face: Color
    converting_face: Color
    // The marks a tree's branch draws when it is closed and when it is open.
    //
    // **In the style rather than written into the control**, because this layer is handed whatever
    // font bytes an application found and cannot know what is in them: a face without triangles
    // would draw two empty boxes and leave every folder looking identical. An application that
    // knows its font can put anything here, including `">"` and `"v"`.
    // What covers the window behind a dialog. **Translucent rather than opaque**, because a modal
    // dialog should say "this is waiting for you" and not "the window is gone" -- a user needs to
    // see what they were doing to decide what to answer.
    scrim: Color
    // The one colour a look and feel is recognised by: a focus ring, a selected row, whatever a
    // theme wants to say is *this application's*.
    //
    // **`Style` had none, which is why the gallery hard-coded a blue into its own paint call.**
    // Every system has this token and calls it something different -- primary, accent, brand --
    // and the thing they agree on is that it is one colour, named once, and that everything
    // identifying belongs to it. Without it a theme can be a different grey and nothing more.
    accent: Color
    // What reads **on** the accent: a primary button's words, a selected row's text. Not derived,
    // because a light accent wants dark text and a dark one wants light, and guessing from
    // luminance is how a theme ends up with grey-on-grey at exactly one value.
    on_accent: Color
    // The five state rows: what this control is drawn as at rest, hovered, pressed, disabled and
    // selected. See `States`, and D5 in docs/design/look-and-feel.md.
    //
    // **This replaced four loose fields** -- `pressed_face`, `disabled_ink`, `selection` and
    // `hover_tint` -- and `face_border` with them, because an edge is part of what a state looks
    // like and two sources for one border is a disagreement waiting to happen. Each of the four
    // could say one thing about one state: a fill, or a text colour, or a translucent veil painted
    // over a finished scene that could change neither an edge nor a word.
    states: States
    // The spacing scale, the floors density may not cross, and the widths of lines. See each
    // struct above: they are three groups rather than one because only the first scales.
    space: Space
    minimum: Minimum
    stroke: Stroke
    // What falls behind a surface that is in front of the window: a menu's popup, a combo box's
    // list, a dialog's panel.
    //
    // **Only those three, and that is the rule rather than an omission.** A shadow says "this is
    // in front of that", so a window where every control had one would be saying nothing at all --
    // and would pay eight extra fills per control to say it. `None` turns it off for a flat look
    // and feel, which is what a theme following GNOME's Adwaita would want.
    //
    // **Not a state's business**, unlike the border and the corner `Parts` carries: a popup is in
    // front of the window whatever the pointer is doing.
    raised: Option<widget.Shadow>
    // The rounding scale. **This was one number**, shared by every control's face and by a list's
    // and a tree's chosen row, on the argument that a theme with four-point buttons and square
    // selection is not a theme but two. The argument was right and the conclusion too narrow: a
    // scale the *library* indexes keeps the coherence (nothing can disagree, because nothing but
    // `controls` chooses) while letting a look be rounder on a dialog than on a button, which every
    // system is. See D1 in docs/design/look-and-feel.md.
    //
    // **A `widget.Radius` rather than a number**, because a number could not serve the sizes a
    // theme has to cover at once: `Points(6)` is right on a button and nearly circular on a check
    // box, which is why the check box used to carry a cap of its own. The cap is now part of what
    // `Points` means, and a theme that wants a capsule says `Fraction(0.5)` -- see
    // `widget.Radius`, which has the whole argument.
    shape: Shape
    // The type scale. **This was four loose fields** -- `text_size`, `heading_size`, `small_size`
    // and `text_font` -- of which two, `heading_size` and `small_size`, were read by nothing at all
    // while two applications wrote their own. See `TypeScale`.
    text: TypeScale
    // Which face an icon *glyph* comes from: an index into the faces a window gave
    // `widget.Metrics` and `raster.Options.fonts`.
    //
    // **Not a role in the type scale**, because an icon is not text: it has no line height to
    // stretch, and its size is an em square taken from whatever role is drawing beside it.
    //
    // Named by purpose here so that no control writes a literal index. `widget` works in indices
    // because the renderer does; meaning belongs at this layer.
    icon_font: int
    // The space between an icon and the label it sits beside.
    //
    // **One number, like `corner_radius` above and for the same reason**: a theme with a wide gap
    // on buttons and a tight one everywhere else is not a theme, it is two. It is spacing rather
    // than the icon's size, which comes from `text_size` -- an icon is an em square, the rule an
    // icon font follows, so it grows with the text instead of with the padding.
    icon_gap: float
}

// **The looks themselves live in `lib/ui/theme`**, not here. `default_style` and
// `modern_style` were at this point in the file until 2026-11-17, which made the control set the
// home of both the vocabulary above and every word spoken in it -- two things with different
// readers, in one 5,000-line file. `controls` defines `Style` and never builds one, so the
// dependency points one way and the split cost nothing: `theme.plain()` is what the one
// called `default_style` was, and `theme.modern()` what `modern_style` was.

// The look, the window's measurements, and the three names the window holds: everything a control
// needs to draw itself that is not the control.
//
// **One value rather than a longer parameter list, and this is the third time the question came
// up.** D16 gave twenty functions a `Style` when a look had to reach them; D18 gave thirteen of
// them a `widget.Metrics` when a row's height became a measurement rather than a number; F294
// needed the pointer to reach a paint function, and F296 (the desktop's scheme) and F297 (the
// designer's live overrides) each want to hand one more fact down the same path. A fourth and a
// fifth parameter is not a design, it is a queue -- so the facts travel together and the signature
// stops moving. Those later tasks add a **field** here.
//
// **The three names, and why they are names.** Hover, the press and the focus are facts about the
// pointer and the keyboard rather than about any widget: a `hovered` flag inside the tree would be
// a second copy of each, free to disagree, and a control left lit after the pointer had gone is
// exactly how that disagreement shows. The window holds one of each and they arrive here, which is
// what `widget.paint_hovered` used to do for the one case a translucent veil could serve. See D5
// and D19 in docs/design/look-and-feel.md.
//
// **`pressed` is for the controls that do not model their own press.** A button, a check box and a
// link carry `held`, and a scroll bar, a split pane, a table's column edge and a slider carry a
// `grabbed` that holds the grab's offset and not merely a bool -- those read their own field. A
// menu's item, a list's row and a tab have no such field and read this one. One source each, never
// both: `mood_of` is handed a bool either way.
pub struct Frame {
    style: Style
    metrics: widget.Metrics
    hovered: string
    pressed: string
    focused: string
}

// A frame with nothing hovered, pressed or focused: what a control looks like at rest.
//
// **The resting frame is the one tests and one-shot renderers want**, and naming it here keeps the
// three empty strings out of thirty call sites. An application fills the names in from what it
// already holds: `with controls.frame_of(style, m) { hovered: st.hovered, pressed: st.pressed,
// focused: st.focused }`.
pub fn frame_of(style: Style, m: widget.Metrics) -> Frame {
    return Frame { style: style, metrics: m, hovered: "", pressed: "", focused: "" }
}

// What a control is drawn as in one state: its fill, its text, its edge, and the two shape
// properties a state is allowed to change.
//
// **One struct, so a state cannot be half-implemented.** Before this, a state was whichever of
// four loose fields happened to cover it: `pressed_face` was a fill and could not say the text
// changed, `disabled_ink` was a text colour and could not say the fill receded -- which is why a
// disabled button kept a live-looking face and merely greyed its words, something no platform
// does. A look that sets a row sets all of it.
pub struct Parts {
    // **A paint, not a colour** (D10): a look can name a span of its own ramp as a face, and
    // `from == to` is a flat fill -- so solid and gradient are one form with no `Option` and no
    // second field. What a look *writes* is `theme.Fill`, two step numbers and an angle; this is
    // what `derive` builds from it and what a control draws.
    face: Paint
    ink: Color
    border: Option<widget.Border>
    // How far the drawn frame grows beyond its resting inset. **Paint time only**: see
    // `widget.Surface.inset` and the invariant in D5 -- no state may change a control's bounds,
    // because a hit test has to read the same calculation the layout did.
    expansion: float
    // This state's own rounding, where it differs from the shape scale. `None` is the scale's
    // answer, which is what every state wants until one does not.
    corner: Option<widget.Radius>
}

// The five states a control can be in, each with its own parts.
//
// **Five rows and one question.** Every paint function asks `parts_for` once -- what are my parts
// in this state -- rather than reaching for a different field per state, so a look cannot forget
// one and a control cannot invent its own answer. See D5 in docs/design/look-and-feel.md.
//
// **Focus and emphasis are deliberately not rows here.** A control can be focused *and* hovered
// *and* pressed at once, so focus cannot be one of five exclusive rows: it stays a ring drawn over
// whatever state applies, from `accent`. Emphasis is an axis over a whole look -- a primary button
// is emphasised at rest, hovered, pressed and disabled alike.
pub struct States {
    rest: Parts
    hovered: Parts
    pressed: Parts
    disabled: Parts
    selected: Parts
}

// Which row a control is in. **Exclusive, which is the point**: one question with one answer, so
// two states cannot both be half-painted.
pub enum Mood {
    Rest
    Hovered
    Pressed
    Disabled
    Selected
}

// The one place the precedence lives.
//
// **`disabled` beats `pressed` beats `selected` beats `hovered`.** With five exclusive rows one of
// them has to win, and each of these is the answer a desktop gives: a disabled control is disabled
// whatever the pointer is doing; a press is the most recent thing the user did; and **a selected
// row keeps its colour while the pointer crosses it**, because a selection that vanishes under the
// pointer reads as the selection being lost -- GTK and macOS both keep it.
//
// Every control calls this with its own four facts, so the ordering cannot drift between two
// controls that happen to disagree about which matters more.
pub fn mood_of(disabled: bool, pressed: bool, selected: bool, hovered: bool) -> Mood {
    if disabled {
        return Mood.Disabled
    }
    if pressed {
        return Mood.Pressed
    }
    if selected {
        return Mood.Selected
    }
    if hovered {
        return Mood.Hovered
    }
    return Mood.Rest
}

// The parts of a control in one mood: an index into the look's five rows, and nothing else.
pub fn parts_for(style: Style, mood: Mood) -> Parts {
    return switch mood {
        Rest { style.states.rest }
        Hovered { style.states.hovered }
        Pressed { style.states.pressed }
        Disabled { style.states.disabled }
        Selected { style.states.selected }
    }
}

// Whether the pointer is on the control with this name.
//
// **A comparison rather than a flag**, which is the whole reason the frame carries names: the
// window holds one name and every control compares itself against it, so no two controls can both
// think they are hovered and none can be left lit after the pointer has gone.
pub fn hovered_in(f: Frame, name: string) -> bool {
    return f.hovered == name
}

// The ring of room a control leaves for a state that wants a bigger frame: the largest expansion
// any of the five rows asks for.
//
// **Derived rather than a token**, for D18's reason: a number a look had to set is a number a look
// could set wrong -- too small and a hovered frame clips, too large and every control grows for
// nothing -- and the rows already say how far they expand. It is also what makes
// `reserve_of(style) - p.expansion` non-negative for every row, which **is** the expansion
// invariant: no state can push a frame outside the box its layout claimed.
pub fn reserve_of(style: Style) -> float {
    var most = style.states.rest.expansion
    if most < style.states.hovered.expansion {
        most = style.states.hovered.expansion
    }
    if most < style.states.pressed.expansion {
        most = style.states.pressed.expansion
    }
    if most < style.states.disabled.expansion {
        most = style.states.disabled.expansion
    }
    if most < style.states.selected.expansion {
        most = style.states.selected.expansion
    }
    return most
}

// The control's own padding with that ring added.
//
// **This is how a drawn frame grows while the box stays put.** The room is claimed once, inside the
// control, and a state that expands spends it outwards from the resting inset -- so layout and the
// hit test read one geometry whatever the pointer is doing. A look whose rows expand by nothing
// reserves nothing, which is why no pixel in either shipped look moves.
fn padded_for(style: Style) -> Insets {
    val ring = reserve_of(style)
    if ring == 0.0 {
        return style.padding
    }
    return widget.insets_of(
        style.padding.left + ring,
        style.padding.top + ring,
        style.padding.right + ring,
        style.padding.bottom + ring
    )
}

// Whether a grab is in hand. **Four controls model their press as the offset they were grabbed
// at** -- a scroll bar, a split pane, a table's column edge and a slider -- because a drag has to
// remember where it started; this is that fact as the bool `mood_of` asks for.
fn grabbing(g: Option<float>) -> bool {
    return switch g {
        Some(_) { true }
        None { false }
    }
}

// Whether this mood is one a control marks with a band of its own: a link's highlight, a row's.
// **Rest and disabled draw nothing extra** -- a link at rest is text, and a disabled one says so
// with its ink rather than by lighting up.
fn marked(mood: Mood) -> bool {
    return switch mood {
        Rest { false }
        Hovered { true }
        Pressed { true }
        Disabled { false }
        Selected { true }
    }
}

// Whether the pointer is being held on the control with this name. For the controls that do not
// model their own press -- a menu's item, a list's row, a tab. A button, a check box and a link
// carry `held`, and a scroll bar, a split pane, a table's column and a slider carry a `grabbed`
// that holds the grab's offset: those read their own field, and never this.
pub fn pressed_in(f: Frame, name: string) -> bool {
    return f.pressed == name
}

// A control's own face: its fill, edged and rounded as the style asks.
//
// **Every control that has a face goes through here**, which is the point: a look and feel set on
// `Style` reaches a button, a field, a tab, a menu title, a dialog's panel and a scroll bar's thumb
// without each of them being taught about borders. A control that painted its own
// `widget.filled(...)` would be the one that stayed flat when the theme changed, and the way that
// bug presents is one widget out of fifteen looking wrong.
// A face index an application actually loaded.
//
// **Clamped rather than trusted, which the gallery had to work around.** `gallery.zm` records that
// the renderer "refuses a run naming a face the options do not hold", and loads its text face twice
// so that index 1 is always real. With a clamp a single-face application renders a look that asks
// for bold -- it renders it regular, which is the right failure and the one D9 chose.
pub fn face_for(m: widget.Metrics, want: int) -> int {
    if want >= 0 && want < len(m.faces) {
        return want
    }
    return 0
}

// How tall one line of a role is: **the font's own line height, stretched by the theme's factor.**
// One function, so that a caret and the box it sits in cannot read different numbers.
pub fn line_for(m: widget.Metrics, t: Type) -> float {
    return widget.height_in(m, face_for(m, t.face), t.size) * t.line
}

// How tall one row of a list, a tree or a table is: **a line of body text, with the small step of
// the space scale around it.**
//
// **Derived rather than a field on the control, which is what it was** -- `List`, `Tree` and
// `Table` each carried `row_height: 20.0`, set by nothing but their own constructors. Twenty is a
// line of twelve-point text and a little air, written down once as a number and thereafter true
// only by coincidence: a look that enlarged its type clipped its own rows, and `at_density`
// tightened every padding and gap in the window and left every row exactly twenty points tall.
// A row is the one box in this library whose height *is* a line of text, so it is measured like
// one -- by `line_for`, which is also what the row's label is laid out with, so the box and the
// text in it cannot read different numbers. See Q8 in docs/design/look-and-feel.md.
//
// **Not a theme token either.** A token set to 20 is the same number in a different place: it can
// still disagree with the face the theme asks for, and nothing would say so.
pub fn row_height(m: widget.Metrics, style: Style) -> float {
    return line_for(m, style.text.body) + style.space.s
}

// How tall a table's header band is: a line of **label** text -- the role a column title is drawn
// in -- with the medium step around it.
//
// **A step wider than a row's**, which is what every table does and what the old pair of numbers
// said too (22 against 20): the header is a band rather than a row, and the air around the titles
// is what separates them from the data.
pub fn header_height(m: widget.Metrics, style: Style) -> float {
    return line_for(m, style.text.label) + style.space.m
}

// How far one level of a tree indents, and the width of the mark a branch draws.
//
// **`space.xl`, which had no other caller**: sixteen points was the indent and sixteen points is
// the top of the space scale, so the scale already held the number the tree was keeping for
// itself. Density reaches it through `space` like everything else.
pub fn indent_for(style: Style) -> float {
    return style.space.xl
}

fn surface_of(style: Style, p: Parts) -> widget.Surface {
    return widget.Surface {
        // The resting frame sits inside the reserved ring; a state that expands spends it,
        // and `reserve_of` is the largest any row asks for, so this is never negative.
        inset: reserve_of(style) - p.expansion,
        fill: Option<Paint>.Some(p.face),
        border: p.border,
        // **The state's own radius where it has one, the scale's where it has not.** A state that
        // wanted to round a corner had no way to say so, and a scale that every state had to share
        // could not express a look whose pressed state squares off.
        corner: switch p.corner {
            Some(r) { r }
            None { style.shape.medium }
        },
        corners: widget.Corners.All,
        shadow: Option<widget.Shadow>.None
    }
}

// The band a row, a menu's item, a link or a selected run of text is drawn on: the same parts, at
// the smaller radius of the shape scale, and never edged.
//
// **A row is not a face.** Rounding a row the way a button is rounded leaves gaps the eye reads as
// stripes down a list, and an edge round every row is a table nobody asked for -- which is why
// this was a second function before the rows existed and stays one now.
fn band_of(style: Style, p: Parts) -> widget.Surface {
    return widget.Surface {
        // The resting frame sits inside the reserved ring; a state that expands spends it,
        // and `reserve_of` is the largest any row asks for, so this is never negative.
        inset: reserve_of(style) - p.expansion,
        fill: Option<Paint>.Some(p.face),
        border: Option<widget.Border>.None,
        corner: switch p.corner {
            Some(r) { r }
            None { style.shape.small }
        },
        corners: widget.Corners.All,
        shadow: Option<widget.Shadow>.None
    }
}

// A surface that is in front of the window: a face, with whatever the theme casts behind it.
//
// **A third function beside `face_of` and `highlight_of` rather than a flag on the first**, for
// the reason those two are separate: what makes a surface raised is not a property of its colour,
// and a caller that had to remember to pass `false` everywhere would eventually not.
fn raised_of(style: Style, colour: Color) -> widget.Surface {
    // **The resting row in a colour of its own.** A popup's panel has no states -- nothing hovers
    // a panel -- but it wants the look's edge, and the resting row is where that edge lives now.
    return with surface_of(style, with style.states.rest { face: Paint.Solid(colour) }) {
        shadow: style.raised,
        corner: style.shape.large
    }
}

// A tab's face: a card, rounded along its top and square where it meets the page.
//
// **A tab is not a button, and drawing it as one is what it looked like.** Every tab was a face
// with the theme's rounding on all four corners, in a row with no spacing, floating above the
// content -- so a strip read as a segmented button and the selected tab as the one that was
// pressed. What makes an index card is three things together, and this is all three:
//
//   * **rounded at the top only** (`widget.Corners.Top`), so the bottom edge is a straight line
//     along the strip rather than two notches of background;
//   * **the chosen tab wears the panel's colour**, not a selection tint, so it is the same surface
//     as the body under it and the two read as one shape with a tab on top;
//   * **the others are sunk**, a shade off the panel, so the strip has a front and a back.
//
// The body has to be `Style.panel` for the join to land, which is what `lib/ui` draws a tabbed
// pane's body in -- an application that puts something else under a strip gets a card on a
// different colour, which is a look rather than a defect.
fn tab_face_of(style: Style, p: Parts, chosen: bool) -> widget.Surface {
    return widget.Surface {
        inset: reserve_of(style) - p.expansion,
        // **A chosen tab is the panel's colour and not the selection's**, which is the one place
        // the `selected` row is deliberately overruled: a tab strip says which pane you are
        // looking at by being continuous with it, so the chosen tab has to be the colour of the
        // thing below it. The row still governs its ink, its hover and its disabled state.
        fill: Option<Paint>.Some(if chosen { Paint.Solid(style.panel) } else { p.face }),
        // **No border on a chosen tab.** An edge all the way round it would draw a line between
        // the tab and the body it is supposed to be continuous with, which is the one line that
        // has to not be there.
        border: if chosen { Option<widget.Border>.None } else { p.border },
        corner: switch p.corner {
            Some(r) { r }
            None { style.shape.medium }
        },
        corners: widget.Corners.Top,
        shadow: Option<widget.Shadow>.None
    }
}

// A selected row's highlight: rounded like a face, but **never edged**.
//
// A border round a list's selected row is a box drawn inside a box, and in a list of twenty rows it
// reads as a table rather than a selection -- where the rounded pill is what a modern look and feel
// actually does. So these two share the radius and part company over the border, which is why this
// is a second function rather than a parameter on the first.
// A flat band in a colour of its own: a slider's track, a scroll bar's trough -- an ornament
// inside a control rather than the control's face. **Not a state row**, because none of these has
// five states: a track looks the same whatever the thumb is doing.
fn highlight_of(style: Style, colour: Color) -> widget.Surface {
    return widget.Surface {
        inset: 0.0,
        fill: Option<Paint>.Some(Paint.Solid(colour)),
        border: Option<widget.Border>.None,
        corner: style.shape.small,
        corners: widget.Corners.All,
        shadow: Option<widget.Shadow>.None
    }
}

// ------------------------------------------------------------------ the keys

fn is_space(k: Keystroke) -> bool {
    return Key.is_Space(k.key)
}

fn is_enter(k: Keystroke) -> bool {
    return Key.is_Enter(k.key)
}

// Whether this input could move a caret or change text -- what the next instalment's entry asks
// before handing an input to `edit`, and here rather than there because the answer is about `Input`.
pub fn is_text_input(input: Input) -> bool {
    return switch input {
        Text(_) { true }
        Paste(_) { true }
        KeyDown(_) { true }
        KeyUp(_) { false }
        Press(_) { false }
        Release(_) { false }
        Move(_) { false }
        Wheel(_) { false }
    }
}
