// modern.zm -- a look built from every token this layer has, rather than the fewest.
//
// **`plain` is the reference and this is the demonstration.** The default is deliberately the
// plainest thing that is legible; this one is what the vocabulary is *for*: a surface that is
// nearly white and edged rather than grey and flat, a corner radius, an accent that the focus ring
// and the selection are both drawn from, and a shadow under the things that are in front.
//
// Its numbers come from the systems that publish them. The padding is Fluent's medium button, 8 by
// 14 at 12 point. The shadow sits between Fluent's `$shadow8` and `$shadow16`, which in its own
// units is a blur of 8 to 16 and an opacity of 14 to 24 per cent -- 14 and 16 here. The accent is
// this project's own.
//
// **What it does not do is a gradient**, and that is a choice rather than a limit: since F295 a
// `Fill` can name two ramp steps and `Surface` takes a paint, so a gradient face costs a look one
// line. Flat surfaces with elevation and a state layer is what every current system does, and a
// gradient on a control face is the one thing that would date this on sight.
//
// **Since F295 the colours are two seeds** (D8), and what is left below is the measurement D8 asks
// for: three overrides, none of them a colour. Padding, shape and depth are what this look says
// that `plain` does not -- they are its vocabulary, not a correction to the derivation.

fn modern_seeds() -> Seeds {
    return Seeds {
        // Barely grey, and cool: the window, the panel and the face are three steps of this, which
        // is what makes a white panel and a nearly white face both read as something laid *on* the
        // window rather than as the window itself.
        neutral: paint.oklch(0.5, 0.012, 265.0),
        accent: paint.oklch(0.55, 0.215, 263.0),
        // **White cards on a grey canvas**: the panel and the face take the top two steps and the
        // window sits below them. The one thing a monotone ramp could not say, and the reason
        // `Toward` exists -- see its comment, which carries the measurement.
        surfaces: Toward.Away,
        edged: true
    }
}

pub fn modern() -> controls.Style {
    return with derive(modern_seeds(), Scheme.Light) {
        // **Room, which is the token nothing had.** Eight by four is a button of twenty-two points
        // at 12 point text; Fluent's medium is eight by fourteen, which is what a control needs
        // before it reads as something you are meant to press rather than something written down.
        padding: widget.insets_of(14.0, 8.0, 14.0, 8.0),
        // Six on a face, four on a chosen row, eight on what floats in front of the window -- the
        // differences the single `corner` token could not express.
        shape: controls.Shape {
            small: widget.Radius.Points(4.0),
            medium: widget.Radius.Points(6.0),
            large: widget.Radius.Points(8.0),
            full: widget.Radius.Fraction(0.5)
        },
        raised: Option<widget.Shadow>.Some(widget.shadow_of(3.0, 14.0, 0.16))
    }
}

// The same look on a dark window.
//
// **A dark look is not an inversion of a light one**, and this file used to be the proof: eleven
// colours written out again, four of which were the things an inversion gets wrong. It is the
// scheme now. On white a control is *paler* than its surround and a panel is paler still; on black
// the same three steps come out darker than the window and the elevation reads the same way round
// -- the further forward a thing is, the lighter it gets, which is Material's elevation overlay
// stated as a ramp index.
pub fn modern_dark() -> controls.Style {
    return with derive(modern_seeds(), Scheme.Dark) {
        padding: widget.insets_of(14.0, 8.0, 14.0, 8.0),
        shape: controls.Shape {
            small: widget.Radius.Points(4.0),
            medium: widget.Radius.Points(6.0),
            large: widget.Radius.Points(8.0),
            full: widget.Radius.Fraction(0.5)
        },
        raised: Option<widget.Shadow>.Some(widget.shadow_of(3.0, 14.0, 0.45))
    }
}
