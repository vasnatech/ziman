// A text field's state and every edit you can make to it: a caret, a selection, and the moves.
//
// docs/reviews/tasks/f269-f277.md F273. **Pure values and pure functions**, so every behaviour a
// text field has is checkable without a window, a font or a keyboard -- which matters more here
// than anywhere else in `lib/ui`, because a text field that is subtly wrong is worse than no text
// field, and "subtly wrong" is exactly what a screenshot cannot show.
//
// **Positions are code-point indices**, matching `chars`, `char_at` and `substring`, which is what
// the language gives. They are *not* byte offsets and *not* grapheme indices: a caret moves by
// grapheme (see `cluster_before`), but it is stored as the code-point index that movement lands on,
// so a caret can never sit inside a multi-byte character and `substring` can always be used
// directly.
//
// **What is here and what is not.** The editing model is complete: insert, delete, move by
// character, word and line, select, and undo. The **system clipboard is not**, and that is a
// platform job rather than a missing function here -- owning a selection on X11 means answering
// `SelectionRequest` events with a list of targets and an INCR protocol for large transfers, which
// belongs beside `src/native_window.c`. `cut` and `copy` answer the text, and a caller hands it
// wherever it keeps it; `paste` takes text back.
// A field's whole state.
//
// `caret` is where the next character goes. `anchor` is the other end of the selection: equal to
// `caret` when nothing is selected, which is why there is no separate `has_selection` flag to keep
// in step with it.
pub struct Editor {
    text: string
    caret: int
    anchor: int
}

pub fn editor_of(text: string) -> Editor {
    val n = len(text)
    return Editor { text: text, caret: n, anchor: n }
}

pub fn empty_editor() -> Editor {
    return Editor { text: "", caret: 0, anchor: 0 }
}

// Where the selection starts and ends, low first. Equal when there is no selection.
pub fn selection_start(e: Editor) -> int {
    return if e.caret < e.anchor { e.caret } else { e.anchor }
}

pub fn selection_end(e: Editor) -> int {
    return if e.caret < e.anchor { e.anchor } else { e.caret }
}

pub fn has_selection(e: Editor) -> bool {
    return e.caret != e.anchor
}

pub fn selected_text(e: Editor) -> string {
    return substring(e.text, selection_start(e), selection_end(e))
}

// ---------------------------------------------------------------- grapheme clusters

// Where a backspace at `at` should delete back to: the start of the grapheme cluster that ends
// there.
//
// **This is a deliberate subset of UAX #29, not an implementation of it**, and the difference is
// worth stating because the alternative was moving by code point and calling it done. Four rules,
// chosen because they cover what a user actually types:
//
//   * a CRLF is one cluster, so a caret never lands between the two halves of a line break;
//   * a combining mark joins the character before it, so `e` followed by U+0301 deletes as one
//     `é` rather than leaving a floating accent;
//   * a zero-width joiner joins what is on either side of it, which is how emoji are composed;
//   * two regional indicators are one flag.
//
// What it gets wrong: the mark ranges below are the main Unicode blocks of combining marks rather
// than the full `Grapheme_Extend` property, so a rare mark outside them is treated as its own
// cluster -- the caret stops in a place a user would not expect, which is a visible but recoverable
// wrongness. Hangul syllable sequences and Indic conjuncts are also not handled. Doing this
// properly needs character property tables the language does not have yet, and a half-table that
// claimed to be UAX #29 would be worse than a rule that says what it is.
pub fn cluster_before(text: string, at: int) -> int {
    if at <= 0 {
        return 0
    }
    var i = at - 1
    // A CRLF is one cluster.
    if i > 0 && code_of(char_at(text, i)) == 10 && code_of(char_at(text, i - 1)) == 13 {
        return i - 1
    }
    // Walk back over combining marks, and over the joiners that bind what follows them.
    while i > 0 && is_extend(code_of(char_at(text, i))) {
        i = i - 1
    }
    // A zero-width joiner means the thing before it is part of the same cluster, so keep going.
    while i > 0 && code_of(char_at(text, i - 1)) == 8205 {
        i = i - 2
        if i < 0 {
            return 0
        }
        while i > 0 && is_extend(code_of(char_at(text, i))) {
            i = i - 1
        }
    }
    // A pair of regional indicators is one flag.
    if i > 0 && is_regional(code_of(char_at(text, i))) && is_regional(code_of(char_at(text, i - 1))) {
        return i - 1
    }
    return i
}

// Where a forward delete at `at` should delete up to: the end of the cluster that starts there.
pub fn cluster_after(text: string, at: int) -> int {
    val n = len(text)
    if at >= n {
        return n
    }
    var i = at + 1
    if at + 1 < n && code_of(char_at(text, at)) == 13 && code_of(char_at(text, at + 1)) == 10 {
        return at + 2
    }
    if is_regional(code_of(char_at(text, at))) && i < n && is_regional(code_of(char_at(text, i))) {
        i = i + 1
    }
    while i < n && is_extend(code_of(char_at(text, i))) {
        i = i + 1
    }
    // A joiner takes the next cluster with it.
    while i + 1 < n && code_of(char_at(text, i)) == 8205 {
        i = i + 2
        while i < n && is_extend(code_of(char_at(text, i))) {
            i = i + 1
        }
    }
    return i
}

// The combining marks, as blocks rather than as a property table -- see `cluster_before` for what
// that costs. Also the variation selectors and the zero-width joiner, which behave the same way
// for this purpose.
fn is_extend(cp: int) -> bool {
    if cp >= 768 && cp <= 879 {
        return true
    }
    if cp >= 1425 && cp <= 1479 {
        return true
    }
    if cp >= 1552 && cp <= 1631 {
        return true
    }
    if cp >= 2304 && cp <= 2307 {
        return true
    }
    if cp >= 7616 && cp <= 7679 {
        return true
    }
    if cp >= 8400 && cp <= 8432 {
        return true
    }
    if cp == 8205 {
        return true
    }
    if cp >= 65024 && cp <= 65039 {
        return true
    }
    if cp >= 917760 && cp <= 917999 {
        return true
    }
    return false
}

fn is_regional(cp: int) -> bool {
    return cp >= 127462 && cp <= 127487
}

// A code point from a one-character string. Computed from the bytes rather than taken from
// `graphics/font`, which has the same arithmetic: a text field should not depend on the drawing
// stack to know what a character is.
fn code_of(ch: string) -> int {
    val b = to_bytes(ch)
    if len(b) == 0 {
        return 0 - 1
    }
    val b0 = b[0] as int
    if b0 < 128 {
        return b0
    }
    if b0 < 224 && len(b) >= 2 {
        return (b0 - 192) * 64 + ((b[1] as int) - 128)
    }
    if b0 < 240 && len(b) >= 3 {
        return (b0 - 224) * 4096 + ((b[1] as int) - 128) * 64 + ((b[2] as int) - 128)
    }
    if len(b) >= 4 {
        return (b0 - 240) * 262144 + ((b[1] as int) - 128) * 4096 + ((b[2] as int) - 128) * 64 +
            ((b[3] as int) - 128)
    }
    return 0 - 1
}

// ---------------------------------------------------------------- moving

// Collapses the selection to the caret, or extends it, depending on whether Shift was held. Every
// move goes through here, which is what keeps "Shift extends" from being re-decided per key.
fn moved(e: Editor, to: int, extend: bool) -> Editor {
    val at = clamped(e, to)
    return Editor { text: e.text, caret: at, anchor: if extend { e.anchor } else { at } }
}

fn clamped(e: Editor, at: int) -> int {
    if at < 0 {
        return 0
    }
    val n = len(e.text)
    return if at > n { n } else { at }
}

// **An unextended left press with a selection goes to the selection's start, not one before the
// caret.** Every editor behaves this way and it is easy to get wrong: a user who has selected a
// word and presses Left expects the caret at its beginning, not inside it.
pub fn move_left(e: Editor, extend: bool) -> Editor {
    if has_selection(e) && !extend {
        return moved(e, selection_start(e), false)
    }
    return moved(e, cluster_before(e.text, e.caret), extend)
}

pub fn move_right(e: Editor, extend: bool) -> Editor {
    if has_selection(e) && !extend {
        return moved(e, selection_end(e), false)
    }
    return moved(e, cluster_after(e.text, e.caret), extend)
}

pub fn move_home(e: Editor, extend: bool) -> Editor {
    return moved(e, 0, extend)
}

pub fn move_end(e: Editor, extend: bool) -> Editor {
    return moved(e, len(e.text), extend)
}

pub fn select_all(e: Editor) -> Editor {
    return Editor { text: e.text, caret: len(e.text), anchor: 0 }
}

// The caret moved to an index, as a click does. `extend` is a shift-click, which keeps the anchor.
pub fn place_caret(e: Editor, at: int, extend: bool) -> Editor {
    return moved(e, at, extend)
}

// ---------------------------------------------------------------- words

// What kind of run a character belongs to. **Three kinds, not two**: letters-and-digits, spaces,
// and everything else. Two kinds would make `foo.bar` one word, and double-clicking it would select
// the whole thing where every editor selects `foo`.
enum Kind {
    Word
    Space
    Other
}

// **Not locale-aware, and the task asked for locale-aware.** This is the practical rule every
// editor's double-click uses: a run of letters and digits, a run of whitespace, or a run of
// anything else. Real word segmentation is UAX #29 again -- it needs to know that a Thai string has
// word boundaries with no spaces in it -- and that needs tables the language does not have. Stated
// here rather than implied, because a user of a language that needs it should not have to discover
// this by trying it.
fn kind_of(cp: int) -> Kind {
    if cp == 32 || cp == 9 || cp == 10 || cp == 13 {
        return Kind.Space
    }
    if cp >= 48 && cp <= 57 {
        return Kind.Word
    }
    if cp >= 65 && cp <= 90 {
        return Kind.Word
    }
    if cp >= 97 && cp <= 122 {
        return Kind.Word
    }
    // Everything above ASCII is treated as a word character: an accented letter, a Greek letter or
    // a CJK ideograph is part of a word, and treating it as punctuation would be worse than
    // treating a rare symbol as a letter.
    if cp > 127 {
        return Kind.Word
    }
    return Kind.Other
}

fn same_kind(a: Kind, b: Kind) -> bool {
    return switch a {
        Word { Kind.is_Word(b) }
        Space { Kind.is_Space(b) }
        Other { Kind.is_Other(b) }
    }
}

// The start of the word at or before `at`: Ctrl-Left.
pub fn word_before(text: string, at: int) -> int {
    var i = at
    if i <= 0 {
        return 0
    }
    // Skip whitespace immediately behind the caret, then the run it lands in -- so Ctrl-Left from
    // after "foo   " lands at the start of "foo" rather than at the end of the spaces.
    while i > 0 && Kind.is_Space(kind_of(code_of(char_at(text, i - 1)))) {
        i = i - 1
    }
    if i <= 0 {
        return 0
    }
    val kind = kind_of(code_of(char_at(text, i - 1)))
    while i > 0 && same_kind(kind_of(code_of(char_at(text, i - 1))), kind) {
        i = i - 1
    }
    return i
}

// The end of the word at or after `at`: Ctrl-Right.
pub fn word_after(text: string, at: int) -> int {
    val n = len(text)
    var i = at
    if i >= n {
        return n
    }
    val kind = kind_of(code_of(char_at(text, i)))
    while i < n && same_kind(kind_of(code_of(char_at(text, i))), kind) {
        i = i + 1
    }
    // Then the whitespace after it, so the caret lands at the next word rather than before the gap.
    while i < n && Kind.is_Space(kind_of(code_of(char_at(text, i)))) {
        i = i + 1
    }
    return i
}

pub fn move_word_left(e: Editor, extend: bool) -> Editor {
    return moved(e, word_before(e.text, e.caret), extend)
}

pub fn move_word_right(e: Editor, extend: bool) -> Editor {
    return moved(e, word_after(e.text, e.caret), extend)
}

// The word under an index, selected: a double click.
//
// Selects the run the index is *in*, including a run of spaces -- double-clicking the gap between
// two words selects the gap, which is what a user who then types expects to replace.
pub fn select_word_at(e: Editor, at: int) -> Editor {
    val n = len(e.text)
    if n == 0 {
        return e
    }
    val index = if at >= n { n - 1 } else { if at < 0 { 0 } else { at } }
    val kind = kind_of(code_of(char_at(e.text, index)))
    var from = index
    while from > 0 && same_kind(kind_of(code_of(char_at(e.text, from - 1))), kind) {
        from = from - 1
    }
    var to = index
    while to < n && same_kind(kind_of(code_of(char_at(e.text, to))), kind) {
        to = to + 1
    }
    return Editor { text: e.text, caret: to, anchor: from }
}

// ---------------------------------------------------------------- changing the text

// Replaces the selection with `what`, or inserts at the caret when there is none.
pub fn insert(e: Editor, what: string) -> Editor {
    val from = selection_start(e)
    val to = selection_end(e)
    val before = substring(e.text, 0, from)
    val after = substring(e.text, to, len(e.text))
    val at = from + len(what)
    return Editor { text: concat(before, what, after), caret: at, anchor: at }
}

// Backspace: the selection if there is one, otherwise the grapheme before the caret.
pub fn delete_back(e: Editor) -> Editor {
    if has_selection(e) {
        return insert(e, "")
    }
    if e.caret <= 0 {
        return e
    }
    val from = cluster_before(e.text, e.caret)
    return Editor {
        text: concat(substring(e.text, 0, from), substring(e.text, e.caret, len(e.text))),
        caret: from,
        anchor: from
    }
}

// Delete: the selection if there is one, otherwise the grapheme after the caret.
pub fn delete_forward(e: Editor) -> Editor {
    if has_selection(e) {
        return insert(e, "")
    }
    val n = len(e.text)
    if e.caret >= n {
        return e
    }
    val to = cluster_after(e.text, e.caret)
    return Editor {
        text: concat(substring(e.text, 0, e.caret), substring(e.text, to, n)),
        caret: e.caret,
        anchor: e.caret
    }
}

pub fn delete_word_back(e: Editor) -> Editor {
    if has_selection(e) {
        return insert(e, "")
    }
    val from = word_before(e.text, e.caret)
    return Editor {
        text: concat(substring(e.text, 0, from), substring(e.text, e.caret, len(e.text))),
        caret: from,
        anchor: from
    }
}

// ---------------------------------------------------------------- the clipboard, as far as this goes

// What a copy would put on the clipboard: the selection, or "" when there is none.
//
// **This does not touch the system clipboard** -- see the module header. A caller holds the text
// and hands it back to `paste`, and a platform layer that owns a real selection plugs in at that
// seam rather than inside the editor.
pub fn copy(e: Editor) -> string {
    return selected_text(e)
}

// Cut answers the text and leaves the editor without it. Two functions rather than one returning
// both, because the language has no tuples and a struct for this would be read once and never
// again: `copy(e)` then `cut(e)` is the pair, and `cut` alone is the common case.
pub fn cut(e: Editor) -> Editor {
    if !has_selection(e) {
        return e
    }
    return insert(e, "")
}

pub fn paste(e: Editor, what: string) -> Editor {
    return insert(e, what)
}

// ---------------------------------------------------------------- undo

// A stack of states, newest last, with the redo side kept separately.
//
// **States, not operations.** An undo stack of inverse operations is smaller and is the wrong
// trade here: a text field's whole state is a string and two integers, and a stack of them cannot
// disagree with the document, which is the bug every operation-based undo eventually has.
pub struct History {
    past: [Editor]
    future: [Editor]
    limit: int
}

pub fn history_of(limit: int) -> History {
    val none: [Editor] = []
    return History { past: none, future: none, limit: if limit < 1 { 1 } else { limit } }
}

// Records `before` as a state to come back to. Called with the state *before* a change, by whatever
// applies the change.
//
// **Recording clears the redo side**, which is what every editor does: once you have typed
// something new, the future you undid is not reachable any more and offering it would re-apply an
// edit to a document it no longer fits.
pub fn record(h: History, before: Editor) -> History {
    val past = mutable_array_new<Editor>()
    val start = if len(h.past) >= h.limit { len(h.past) - h.limit + 1 } else { 0 }
    var i = start
    while i < len(h.past) {
        push(past, h.past[i])
        i = i + 1
    }
    push(past, before)
    val none: [Editor] = []
    return History { past: snapshot(past), future: none, limit: h.limit }
}

pub fn can_undo(h: History) -> bool {
    return len(h.past) > 0
}

pub fn can_redo(h: History) -> bool {
    return len(h.future) > 0
}

// The state to go back to, and the history with that step moved to the redo side. `current` is
// where the editor is now, which is what becomes redoable.
pub struct Step {
    editor: Editor
    history: History
}

pub fn undo(h: History, current: Editor) -> Step {
    if len(h.past) == 0 {
        return Step { editor: current, history: h }
    }
    val back = h.past[len(h.past) - 1]
    val past = slice(h.past, 0, len(h.past) - 1)
    val future = mutable_array_new<Editor>()
    push(future, current)
    for one in h.future {
        push(future, one)
    }
    return Step {
        editor: back,
        history: History { past: past, future: snapshot(future), limit: h.limit }
    }
}

pub fn redo(h: History, current: Editor) -> Step {
    if len(h.future) == 0 {
        return Step { editor: current, history: h }
    }
    val forward = h.future[0]
    val future = slice(h.future, 1, len(h.future))
    val past = mutable_array_new<Editor>()
    for one in h.past {
        push(past, one)
    }
    push(past, current)
    return Step {
        editor: forward,
        history: History { past: snapshot(past), future: future, limit: h.limit }
    }
}
