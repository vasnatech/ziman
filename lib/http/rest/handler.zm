// -------------------------------------------------------------- typed endpoints
//
// An endpoint is a method, a pattern and a handler over *typed* values instead of requests and responses:
// the handler takes the decoded request body and returns a `Result` of the answer or an error of the
// application's own type, and the library does what depends on the media type -- it checks the request's
// `Content-Type` (415), negotiates the answer against `Accept` (406), decodes the body (400), and encodes the
// answer with a `Writer` for the negotiated type and the status the endpoint declares. A `Reader` and a `Writer`
// pair a media type with the function that decodes or encodes it, so this module knows no format: JSON, YAML
// or CSV come from the application's own functions.
//
//     // no input: handler; input in the path: path_handler; a request body: body_handler -- each `public_` or `secure_`
//     val patients = server.routes<Ctx>([
//         Endpoint<Ctx> { method: HttpMethod.Post, pattern: "/patients",
//             handler: secure_body_handler<Ctx, Principal, PatientRequest, Patient, ApiError>(who: bearer,
//                 decoders: [json_in], encoders: [json_out], status: 201, run: create_patient, api: api) }
//     ])
//     server.dispatch<Ctx>(patients, ctx, req, fault)
//
// `routes` compiles the table once (build it as a module-level `val`); `dispatch` then does no per-request
// parsing of patterns and looks at only the endpoints with the request's method and number of path segments.
//
// `fault(status, message)` builds the response for what the library itself rejects (400, 404, 405, 406, 415),
// so an application's error bodies have one shape.

// A route: the handler, already adapted to requests and responses, for `method` on `pattern`.
pub struct Endpoint<C> {
    method: HttpMethod
    pattern: string
    handler: fn(C, Request, Params) -> Response
}

// The encoder the client most wants, or `None` -- a 406 -- when it wants none of them.
//
// **The client's `q` weights decide, not the order the endpoint lists its encoders in**, which is the whole
// point: an endpoint that can write `text/plain` and `text/csv` answers `Accept: text/csv, text/plain;q=0.5`
// with CSV, where listing `text_out` first used to win regardless of what the client asked for. The
// endpoint's order still breaks a tie, so it remains the server's preference among equals -- and since
// nothing is chosen at weight zero, `q=0` is a refusal rather than a last resort.
fn negotiate<O>(encoders: [codec.Encoder<O>], req: Request) -> Option<codec.Encoder<O>> {
    var best = Option<codec.Encoder<O>>.None
    var best_q = 0.0
    for w in encoders {
        val q = quality(req.headers, w.media)
        if q > best_q {
            best_q = q
            best = Option<codec.Encoder<O>>.Some(w)
        }
    }
    return best
}

// The first decoder whose media type the request's `Content-Type` is.
fn select_decoder<I>(decoders: [codec.Decoder<I>], req: Request) -> Option<codec.Decoder<I>> {
    if Some(sent) = content_type(req.headers) {
        for r in decoders {
            if mime.matches(r.media, sent) {
                return Option<codec.Decoder<I>>.Some(r)
            }
        }
    }
    return Option<codec.Decoder<I>>.None
}

fn consumed_types<I>(decoders: [codec.Decoder<I>]) -> string {
    val names = mutable_array_new<string>()
    for r in decoders {
        push(names, mime.essence(r.media))
    }
    return join(separator: " or ", pieces: snapshot(names))
}

fn produced_types<O>(encoders: [codec.Encoder<O>]) -> string {
    val names = mutable_array_new<string>()
    for w in encoders {
        push(names, mime.essence(w.media))
    }
    return join(separator: ", ", pieces: snapshot(names))
}

// The answer for `result`: written with `encoder` when there is one, or an empty body when the endpoint has no encoders
// (a 204, say).
fn answer<O, E>(
    result: Result<O, E>,
    encoder: Option<codec.Encoder<O>>,
    status: int,
    failure: fn(E) -> Response
) -> Response {
    val fail = failure
    if Err(e) = result {
        return fail(e)
    }
    if Some(w) = encoder {
        val encode = w.encode
        return server.media_response(status, encode(unwrap(result)), w.media)
    }
    return server.response(status, [])
}

// Why a caller was refused before an endpoint ran: not identified (`Unauthenticated`, answered 401), identified but not
// allowed (`Forbidden`, 403), or identifying them failed for a reason that is the server's (`Failed`, 500).
pub enum Denied {
    Unauthenticated(string)
    Forbidden(string)
    Failed(string)
}

fn denied_response(d: Denied, fault: fn(int, string) -> Response) -> Response {
    return switch d {
        Unauthenticated(message) { fault(status_unauthorized, message) }
        Forbidden(message) { fault(status_forbidden, message) }
        Failed(message) { fault(status_internal_server_error, message) }
    }
}

// What an endpoint that anyone may call is given as its caller. Never seen by application code: the `public_*`
// builders adapt a `run` that does not take one.
struct Anonymous {
    anonymous: bool
}

// The `who` of every `public_*` builder: nobody is asked who they are.
fn anyone<C>(ctx: C, req: Request) -> Result<Anonymous, Denied> {
    return ok(Anonymous { anonymous: true })
}

// **The typed `Decoder`/`Encoder` pair is `codec`'s, not this module's** (2026-10-31). Nothing in
// either type mentions a request or a response -- a media type and a function over a value is
// serialization, and a tool with a `--format` flag wants the same thing. What is HTTP, and stays
// here, is *choosing* between several of them from an `Accept` header.
//
// `codec.encoder_of(format, to_json)` is the one worth knowing: an endpoint can offer JSON, YAML,
// TOML, NDJSON and CSV for a `#[derive(Json)]` type without writing an encoder per format, and the
// client picks with `Accept`. `codec.encoders_of(to_json)` is all five at once.

// ---- what every endpoint of an application shares

// How an application answers what goes wrong, given once and passed to every builder below as `api:`. `failure(e)` builds
// the response for an `Err` of the endpoint's own error type `E`, and `fault(status, message)` the one for what the library
// itself rejects (400, 404, 405, 406, 415), so an application's error bodies have one shape:
// `val api = server.Api<ApiError> { failure: failure, fault: fault }`.
pub struct Api<E> {
    failure: fn(E) -> Response
    fault: fn(int, string) -> Response
}

// Where an endpoint's input value comes from, which is one thing rather than a combination of
// optional ones: nowhere at all, a request body decoded by its media type, or a
// `multipart/form-data` body read as its parts.
//
// **This was two parameters until a form needed a third.** `endpoint_core` took
// `decoders: Option<[codec.Decoder<I>]>` beside `blank: Option<I>` -- the value handed to `run` by
// an endpoint with no input at all -- and "exactly one of these is set" was a convention its
// callers kept rather than something the types said. A form cannot be a `codec.Decoder`: a decoder
// is `[byte] -> T` and the boundary a multipart body is split on is in the `Content-Type` header,
// which a decoder never sees. Three states is where the enum is cheaper than the convention.
enum Input<I> {
    // No input: `I` is `unit`, and this carries the `unit` that `run` is still passed.
    Blank(I)
    // A request body, decoded by whichever of these the request's `Content-Type` is -- a 415 when
    // it is none of them, a 400 when the decoding fails.
    Decoded([codec.Decoder<I>])
    // A `multipart/form-data` body, read by a function over the whole request; `named_part` is the
    // reader worth knowing. **A request that is not multipart at all is a 415 and everything the
    // reader rejects is a 400**, which is the split `multipart_boundary` exists for -- so the
    // media check stays in `endpoint_core` beside the other one and the reader only ever reports
    // what is wrong with the body.
    Form(fn(Request) -> Result<I, string>)
}

// ---- the input kinds, each in a `secure_` form (the caller is identified first) and a `public_` one.
//
// `who(ctx, req)` identifies the caller from the request (its headers, usually) and returns a `U`, or a `Denied` that is
// answered before anything else happens: before the answer is negotiated, before the body is read. `run` then takes that
// `U` as its second argument, so an endpoint that needs a caller cannot be written without saying how to find one. A
// `public_*` builder is the explicit way to say nobody needs to be identified. `status` is the status of a successful
// answer and may be left out of a named call: it is then 200.
//
// The builders are the combinations of three independent choices -- a caller, an input from the path or the query, and
// an input from the body, which is either decoded by its media type or read as a `multipart/form-data` form -- and each
// is a few lines over one private `endpoint_core`, which does the steps in one order: identify the caller, check the
// body's media type (415), negotiate the answer (406), read the path or query input (400), read the body (400), run. A
// builder cannot be one function with optional parts, because `run`'s own parameter list (and the type parameters behind
// it) differs with which parts there are.
//
// **Sixteen combinations have a name here and the rest do not**, because nothing has wanted them: a query beside a body,
// or beside a form, is the pair `#![derive(Routes)]` refuses by naming the constructor that would be here -- which is
// how `secure_path_query_handler` came to exist rather than being guessed at.

fn no_path(params: Params) -> Result<unit, string> {
    return ok(unit)
}

fn no_query(req: Request) -> Result<unit, string> {
    return ok(unit)
}

// Every builder's one implementation. The parts an endpoint does not have are `unit`: `no_path`/`no_query` read `unit`
// from nothing, `input` says where the one input value comes from -- `Blank(unit)` for an endpoint that has none, and
// that `unit` is what `run` is handed in its place -- and `run` is the builder's own `run` wrapped to ignore the `unit`s.
fn endpoint_core<C, U, P, Q, I, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    path: fn(Params) -> Result<P, string>,
    query: fn(Request) -> Result<Q, string>,
    input: Input<I>,
    encoders: [codec.Encoder<O>],
    status: int,
    run: fn(C, U, P, Q, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val fault = api.fault
    return fn(ctx: C, req: Request, params: Params) -> Response {
        val identify = who
        val caller = identify(ctx, req)
        if Err(refusal) = caller {
            return denied_response(refusal, fault)
        }
        var decoder = Option<codec.Decoder<I>>.None
        if Decoded(all) = input {
            decoder = select_decoder<I>(all, req)
            if !is_Some(decoder) {
                return fault(
                    status_unsupported_media_type,
                    format("unsupported media type: send {}", consumed_types<I>(all))
                )
            }
        }
        // A form's media type is checked here, beside the decoded body's, so that the two rejections
        // a client can cause keep the statuses they should have: a body that is not multipart at all
        // is a 415 like a body of the wrong format, and everything about the body itself is the
        // reader's own 400.
        if Form(_) = input {
            if !is_Some(server.multipart_boundary(req)) {
                return fault(
                    status_unsupported_media_type,
                    "unsupported media type: send multipart/form-data"
                )
            }
        }
        val encoder = negotiate<O>(encoders, req)
        if len(encoders) > 0 && !is_Some(encoder) {
            return fault(
                status_not_acceptable,
                format("not acceptable: this route produces {}", produced_types<O>(encoders))
            )
        }
        val locate = path
        val located = locate(params)
        if Err(message) = located {
            return fault(status_bad_request, message)
        }
        val read = query
        val queried = read(req)
        if Err(message) = queried {
            return fault(status_bad_request, message)
        }
        var held = Option<I>.None
        if Blank(nothing) = input {
            held = Option<I>.Some(nothing)
        }
        if Some(chosen) = decoder {
            val decode = chosen.decode
            val decoded = decode(req.body)
            if Err(message) = decoded {
                return fault(status_bad_request, message)
            }
            held = Option<I>.Some(unwrap(decoded))
        }
        if Form(read) = input {
            val got = read(req)
            if Err(message) = got {
                return fault(status_bad_request, message)
            }
            held = Option<I>.Some(unwrap(got))
        }
        return answer<O, E>(
            run(ctx, unwrap(caller), unwrap(located), unwrap(queried), unwrap_Some(held)),
            encoder,
            status,
            api.failure
        )
    }
}

// A secured endpoint with no input: `run(ctx, caller)` returns the answer or an error; the answer is written with the
// first of `encoders` the client's `Accept` allows, with `status`.
pub fn secure_handler<C, U, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, U) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, unit, unit, unit, O, E>(
        who: who,
        path: no_path,
        query: no_query,
        input: Input<unit>.Blank(unit),
        encoders: encoders,
        status: get_or(status, 200),
        run: fn(ctx: C, caller: U, id: unit, filter: unit, input: unit) -> Result<O, E> { return go(ctx, caller) },
        api: api
    )
}

// A secured endpoint whose input is in the path: `path` turns the captured parameters into a `P` (an `Err` message is
// answered 400, so a bad id never reaches `run`), and `run(ctx, caller, input)` returns the answer or an error.
pub fn secure_path_handler<C, U, P, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    path: fn(Params) -> Result<P, string>,
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, U, P) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, P, unit, unit, O, E>(
        who: who,
        path: path,
        query: no_query,
        input: Input<unit>.Blank(unit),
        encoders: encoders,
        status: get_or(status, 200),
        run: fn(ctx: C, caller: U, id: P, filter: unit, input: unit) -> Result<O, E> { return go(ctx, caller, id) },
        api: api
    )
}

// A secured endpoint with **both** a path segment and something read off the request:
// `GET /orders/{id}?currency=EUR`, or a path id beside a header. `run(ctx, caller, id, filter)`.
//
// **The pair was the one hole in this matrix and `endpoint_core` always took both.** It stayed
// unbuilt while nothing needed it, and `#![derive(Routes)]` refused such a route by naming the
// constructor that would be here -- which is how the gap was found rather than guessed. The first
// caller is a shared health record: a token in the path, a password in a header, and an answer
// whose media type the route decides.
pub fn secure_path_query_handler<C, U, P, Q, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    path: fn(Params) -> Result<P, string>,
    query: fn(Request) -> Result<Q, string>,
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, U, P, Q) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, P, Q, unit, O, E>(
        who: who,
        path: path,
        query: query,
        input: Input<unit>.Blank(unit),
        encoders: encoders,
        status: get_or(status, 200),
        run: fn(ctx: C, caller: U, id: P, filter: Q, input: unit) -> Result<O, E> {
            return go(ctx, caller, id, filter)
        },
        api: api
    )
}

// A secured endpoint whose input is in the query string (`GET /things?type=x`): `query` reads what it wants from the request, for
// which `query_param` is the tool, and turns it into a `Q` (an `Err` message is answered 400, so a bad value never reaches `run`);
// `run(ctx, caller, input)` returns the answer or an error.
pub fn secure_query_handler<C, U, Q, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    query: fn(Request) -> Result<Q, string>,
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, U, Q) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, unit, Q, unit, O, E>(
        who: who,
        path: no_path,
        query: query,
        input: Input<unit>.Blank(unit),
        encoders: encoders,
        status: get_or(status, 200),
        run: fn(ctx: C, caller: U, id: unit, filter: Q, input: unit) -> Result<O, E> { return go(ctx, caller, filter) },
        api: api
    )
}

// `secure_query_handler` without the caller: an endpoint whose only input is its query string and
// which anyone may ask. **Its absence was an asymmetry, not a decision** -- `#[route]`'s parameter
// bindings asked for it by name the first time a query endpoint was written without a
// `#[principal]`, which is how it was noticed.
pub fn public_query_handler<C, Q, O, E>(
    query: fn(Request) -> Result<Q, string>,
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, Q) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_query_handler<C, Anonymous, Q, O, E>(
        who: anyone<C>,
        query: query,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, caller: Anonymous, filter: Q) -> Result<O, E> { return go(ctx, filter) },
        api: api
    )
}

// A secured endpoint with a request body: it must arrive as one of `decoders`' media types (else 415), the answer is
// negotiated (else 406), the body is decoded with the decoder for its type (a failure is 400), and
// `run(ctx, caller, input)` returns the answer or an error.
pub fn secure_body_handler<C, U, I, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    decoders: [codec.Decoder<I>],
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, U, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, unit, unit, I, O, E>(
        who: who,
        path: no_path,
        query: no_query,
        input: Input<I>.Decoded(decoders),
        encoders: encoders,
        status: get_or(status, 200),
        run: fn(ctx: C, caller: U, id: unit, filter: unit, input: I) -> Result<O, E> { return go(ctx, caller, input) },
        api: api
    )
}

// A secured endpoint with both an id in the path and a request body (a `PUT /things/{id}`): `path` decodes the parameters
// into a `P` and the body is decoded with the decoder for its media type; `run(ctx, caller, path_input, body_input)`
// returns the answer or an error. Either input failing to decode is a 400.
pub fn secure_path_body_handler<C, U, P, I, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    path: fn(Params) -> Result<P, string>,
    decoders: [codec.Decoder<I>],
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, U, P, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, P, unit, I, O, E>(
        who: who,
        path: path,
        query: no_query,
        input: Input<I>.Decoded(decoders),
        encoders: encoders,
        status: get_or(status, 200),
        run: fn(ctx: C, caller: U, id: P, filter: unit, input: I) -> Result<O, E> { return go(ctx, caller, id, input) },
        api: api
    )
}

// A secured endpoint whose input is an uploaded file: the body has to arrive as `multipart/form-data`
// (else 415), `form` reads what the endpoint wants out of it (an `Err` is a 400, so a body that is not
// what this route needs never reaches `run`), and `run(ctx, caller, input)` returns the answer or an
// error. `named_part("file")` is the reader for the one-file form, and `optional_part` for a file a
// form need not carry.
//
// **This is Spring's `@RequestPart MultipartFile`, and it is a reader rather than one more decoder**
// because a `codec.Decoder` is `[byte] -> T`: the boundary a multipart body is split on is written in
// the `Content-Type` header, which a decoder is never shown. Everything else an endpoint does -- who
// the caller is, negotiating the answer, the status, the application's own error shape -- is unchanged,
// which is the point of putting the form behind `Input` instead of beside the table.
pub fn secure_form_handler<C, U, I, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    form: fn(Request) -> Result<I, string>,
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, U, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, unit, unit, I, O, E>(
        who: who,
        path: no_path,
        query: no_query,
        input: Input<I>.Form(form),
        encoders: encoders,
        status: get_or(status, 200),
        run: fn(ctx: C, caller: U, id: unit, filter: unit, sent: I) -> Result<O, E> { return go(ctx, caller, sent) },
        api: api
    )
}

// A secured endpoint with both an id in the path and an uploaded file (`POST /records/{id}/attachments`):
// `run(ctx, caller, path_input, form_input)`.
pub fn secure_path_form_handler<C, U, P, I, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    path: fn(Params) -> Result<P, string>,
    form: fn(Request) -> Result<I, string>,
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, U, P, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, P, unit, I, O, E>(
        who: who,
        path: path,
        query: no_query,
        input: Input<I>.Form(form),
        encoders: encoders,
        status: get_or(status, 200),
        run: fn(ctx: C, caller: U, id: P, filter: unit, sent: I) -> Result<O, E> {
            return go(ctx, caller, id, sent)
        },
        api: api
    )
}

// A public endpoint with no input: `run(ctx)`. Anyone may call it.
pub fn public_handler<C, O, E>(
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_handler<C, Anonymous, O, E>(
        who: anyone<C>,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, nobody: Anonymous) -> Result<O, E> { return go(ctx) },
        api: api
    )
}

// A public endpoint whose input is in the path: `run(ctx, input)`.
pub fn public_path_handler<C, P, O, E>(
    path: fn(Params) -> Result<P, string>,
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, P) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_path_handler<C, Anonymous, P, O, E>(
        who: anyone<C>,
        path: path,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, nobody: Anonymous, id: P) -> Result<O, E> { return go(ctx, id) },
        api: api
    )
}

// The same, open to anyone: a path segment and something off the request, with no caller.
// `run(ctx, id, filter)`.
pub fn public_path_query_handler<C, P, Q, O, E>(
    path: fn(Params) -> Result<P, string>,
    query: fn(Request) -> Result<Q, string>,
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, P, Q) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_path_query_handler<C, Anonymous, P, Q, O, E>(
        who: anyone<C>,
        path: path,
        query: query,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, nobody: Anonymous, id: P, filter: Q) -> Result<O, E> {
            return go(ctx, id, filter)
        },
        api: api
    )
}

// A public endpoint with a request body: `run(ctx, input)`.
pub fn public_body_handler<C, I, O, E>(
    decoders: [codec.Decoder<I>],
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_body_handler<C, Anonymous, I, O, E>(
        who: anyone<C>,
        decoders: decoders,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, nobody: Anonymous, input: I) -> Result<O, E> { return go(ctx, input) },
        api: api
    )
}

// A public endpoint with both an id in the path and a request body: `run(ctx, path_input, body_input)`.
pub fn public_path_body_handler<C, P, I, O, E>(
    path: fn(Params) -> Result<P, string>,
    decoders: [codec.Decoder<I>],
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, P, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_path_body_handler<C, Anonymous, P, I, O, E>(
        who: anyone<C>,
        path: path,
        decoders: decoders,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, nobody: Anonymous, id: P, input: I) -> Result<O, E> { return go(ctx, id, input) },
        api: api
    )
}

// A public endpoint whose input is an uploaded file: `run(ctx, input)`. An upload nobody has to be
// identified for -- a report sent in against a share token, say, where the token is the path.
pub fn public_form_handler<C, I, O, E>(
    form: fn(Request) -> Result<I, string>,
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_form_handler<C, Anonymous, I, O, E>(
        who: anyone<C>,
        form: form,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, nobody: Anonymous, sent: I) -> Result<O, E> { return go(ctx, sent) },
        api: api
    )
}

// A public endpoint with both an id in the path and an uploaded file: `run(ctx, path_input, form_input)`.
pub fn public_path_form_handler<C, P, I, O, E>(
    path: fn(Params) -> Result<P, string>,
    form: fn(Request) -> Result<I, string>,
    encoders: [codec.Encoder<O>],
    status: Option<int>,
    run: fn(C, P, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_path_form_handler<C, Anonymous, P, I, O, E>(
        who: anyone<C>,
        path: path,
        form: form,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, nobody: Anonymous, id: P, sent: I) -> Result<O, E> { return go(ctx, id, sent) },
        api: api
    )
}

// ---- when the answer is somewhere else ---------------------------------------------------------

// Where to go instead of a document: an endpoint answering this is answered `302 Found` with this
// `Location` and an empty body.
//
// **A type rather than a header the handler sets**, because a handler does not build its own
// response here -- a builder does, from what `run` returns -- and a redirect is an *answer*, not a
// decoration on one. `as_attachment` is a wrapper for the opposite reason: a filename is fixed for
// the life of the endpoint, where a location is computed per request from what the handler found.
//
// **What wants it**: an OAuth callback. The provider sends the browser to the server with a `code`
// in the query, and the server has to put the browser back where it came from -- the application's
// own page, or a mobile application's custom scheme -- carrying whether the connection worked. The
// answer is read by a browser following it, so there is nothing to negotiate and nothing to encode.
pub struct Redirect {
    location: string
}

// An endpoint anyone may call that reads its request off the query string and answers a redirect:
// `run(ctx, query)` says where to go, and the response is a 302 with that `Location`.
//
// **The one shape that answers a `Redirect` today**, and the shape every OAuth callback has. The
// builders in this module arrived as something needed one; `#![derive(Routes)]` refuses a redirect
// on any other shape by name rather than generating a call to a builder that does not exist.
//
// Written out rather than over `endpoint_core`, which negotiates an encoder, selects a decoder and
// checks a body's media type -- none of which a redirect has. What is left is the query read, whose
// `Err` is the same 400 it is everywhere else.
//
// **A location holding a control character is refused by `write_response`**, not here: a header
// value is checked on the way out, so a `Location` built from something a caller sent cannot end
// the header and begin another one. That check is the server's and applies to every header.
pub fn public_query_redirect_handler<C, Q, E>(
    query: fn(Request) -> Result<Q, string>,
    run: fn(C, Q) -> Result<Redirect, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    val fault = api.fault
    val fail = api.failure
    return fn(ctx: C, req: Request, params: Params) -> Response {
        val read = query
        val queried = read(req)
        if Err(message) = queried {
            return fault(status_bad_request, message)
        }
        val answered = go(ctx, unwrap(queried))
        if Err(e) = answered {
            return fail(e)
        }
        val going = unwrap(answered)
        return server.with_header(server.response(status_found, []), "Location", going.location)
    }
}

// ---- what the answer is called when it is a download ------------------------------------------

// The same endpoint, answering `Content-Disposition: attachment; filename="..."` -- which is what
// makes a browser save a file under the name the server chose instead of guessing from the URL. A
// `GET /api/me/export/pdf` is otherwise saved as `pdf`.
//
// **A wrapper rather than an argument of all sixteen builders**, and that is the whole reason it is
// shaped this way: an endpoint's handler is `fn(C, Request, Params) -> Response`, so this composes
// with every builder, with a hand-written handler, and with whatever is built next, while a
// `disposition:` parameter would have had to be threaded through `endpoint_core` and every
// constructor over it. It also cannot be a property of the `codec.Encoder`: an encoder is a media
// type and a function over a value, and what a *file* is called is HTTP's business, not the
// format's.
//
// **Only a successful answer carries it.** A 404 or a 400 from this route answers the
// application's own error body, and labelling that as an attachment named `health-record.pdf`
// would have a browser save the error as the file the caller asked for. Spring sets the header on
// its `ResponseEntity.ok()` path for the same reason.
pub fn as_attachment<C>(
    handler: fn(C, Request, Params) -> Response,
    filename: string
) -> fn(C, Request, Params) -> Response {
    val answer_with = handler
    // Built once, here, rather than per request: the name is fixed for the life of the endpoint.
    val disposition = attachment_value(filename)
    return fn(ctx: C, req: Request, params: Params) -> Response {
        val answer = answer_with(ctx, req, params)
        // 2xx only, and 300 is written out: `http` has no `status_multiple_choices`, and adding a
        // constant nothing else wants would be the wrong half of this change.
        if answer.status >= status_ok && answer.status < 300 {
            return server.with_header(answer, "Content-Disposition", disposition)
        }
        return answer
    }
}

// `attachment; filename="health-record.pdf"`, as RFC 6266 spells it.
//
// **The name is a value this module did not choose**, so it is escaped rather than trusted: a
// filename holding a CR or LF would end the header and begin another one, which is the response
// half of the request smuggling the server already refuses, and a `"` or a `\` would end the
// quoted string early. Control characters go, and the two delimiters are backslash-escaped.
//
// **A non-ASCII name also gets `filename*=UTF-8''..`**, which is the only form that carries one:
// `filename=` is a quoted *ISO-8859-1* string, so a Turkish or Greek name cannot be spelled in it.
// The quoted form is kept beside it with every non-ASCII byte replaced by `_`, because a client
// that does not understand the extended parameter has to be left with something -- and RFC 6266
// says a client that understands both prefers `filename*`.
pub fn attachment_value(filename: string) -> string {
    val cleaned = without_control_characters(filename)
    val quoted = concat("attachment; filename=\"", escaped(ascii_only(cleaned)), "\"")
    if byte_len(cleaned) == len(cleaned) {
        return quoted
    }
    return concat(quoted, "; filename*=UTF-8''", url.percent_encode(cleaned, false))
}

// Every character a header value may not carry: CR and LF, which would inject a header, and the
// other C0 controls and DEL, which no filesystem has and no client should be asked to parse.
fn without_control_characters(text: string) -> string {
    val out = mutable_string_new()
    for c in chars(text) {
        if !is_control(c) {
            append(out, c)
        }
    }
    return snapshot(out)
}

// **A character is ASCII exactly when it is one byte**, which is what UTF-8 means, and is why none
// of this needs a codepoint: `byte_len` of one character answers the question.
fn is_control(c: string) -> bool {
    if byte_len(c) != 1 {
        return false
    }
    val code = to_bytes(c)[0] as int
    return code < 32 || code == 127
}

// The ASCII fallback for the quoted form: one `_` per non-ASCII character, since the quoted string
// cannot carry one, and dropping it silently would rename `rapor-ozet.pdf` to `rapor-zet.pdf`
// instead of showing that something was lost.
fn ascii_only(text: string) -> string {
    val out = mutable_string_new()
    for c in chars(text) {
        if byte_len(c) == 1 {
            append(out, c)
        } else {
            append(out, "_")
        }
    }
    return snapshot(out)
}

// A backslash and a double quote are the quoted-string's own two delimiters, so each is escaped
// with a backslash.
fn escaped(text: string) -> string {
    val out = mutable_string_new()
    for c in chars(text) {
        if is_delimiter(c) {
            append(out, "\\")
        }
        append(out, c)
    }
    return snapshot(out)
}

fn is_delimiter(c: string) -> bool {
    return c == "\\" || c == "\""
}

// A table of endpoints compiled for dispatching: each pattern split once, and the endpoints grouped by method
// and number of path segments (in the order they were given) so a request only meets the ones that could match.
// Build it once with `routes`.
pub struct Routes<C> {
    endpoints: [Endpoint<C>]
    patterns: [Pattern]
    by_method: Map<string, [int]>
    by_length: Map<int, [int]>
    // Whether `dispatch` records a metric per request. Set by `metered_routes`, not by `routes`:
    // the matched pattern is known here and nowhere else, which is the one label worth having and
    // the reason this lives on the table rather than in `ServeOptions`.
    meter: bool
}
