// server.zm -- an HTTP/1.1 *server* toolkit, written in Ziman on top of
// `net`: parse a request off a socket, route it, write a response.
// Two ways to use it. `serve(listener, ctx, handler, options)` runs the accept
// loop and the per-connection loop for you and calls your handler -- a
// function value -- for each request (see "serve" at the end of this file).
// Or write your own accept loop and connection loop and call the pieces:
// `read_request`, `write_response`, the response builders, and route matching
// that extracts path parameters (`route`, `param`). A handler cannot capture
// (function values are references to named functions or lambdas), so what it needs
// besides the request travels as an explicit context value.
//
// What it speaks: HTTP/1.1 and 1.0 requests with a request line, headers
// and an optional body (`Content-Length`, or `Transfer-Encoding: chunked`, decoded); keep-alive
// across requests on one connection (including pipelined requests already in the buffer);
// `Expect: 100-continue`; `HEAD` (headers only). Every response carries `Date` and `X-Content-Type-Options: nosniff`, and none says
// what server it is (a `Server` header only tells an attacker what to look for); a handler that sets either header itself is not overridden. What it
// does not: other transfer encodings (answered 501), HTTP/2, and
// request trailers (read and ignored). `multipart/form-data` bodies are read on request (see
// `multipart`) and responses are gzipped on request (see `compressed`); neither happens unasked. TLS is the socket's business: hand `serve` a listener from
// `net.listen_tls` and every connection is HTTPS. Request and response bodies are `[byte]` and may
// hold any byte, including a NUL -- only the request line and headers are read as text, so a NUL
// there (not in the body) is what gets a 400 (a Ziman `string` cannot hold one).
//
// Bounded by design: headers may total at most 16 KiB and a body at most
// 1 MiB, so a client can't make a handler thread buffer without limit;
// exceeding them is `HeadersTooLarge`/`BodyTooLarge` (431/413). Set a read
// timeout on the socket (`net.set_timeout`) so an idle or stalled client
// can't hold a thread forever: a timed-out read is `Err(Timeout)`. A per-read
// timeout alone does not stop a client that sends a byte just inside it, again
// and again (slowloris), so `open_session_with_timeouts` (which `serve` uses,
// with `idle_timeout_ms`) also bounds the whole request -- head and body --
// from its first byte. A request's head has a shorter limit of its own (`header_timeout_ms`, from its first byte to the blank line), and so does
// a new connection's first byte: a client that opens a connection and says nothing, or sends its head a byte at a time, is let go
// after that long rather than after `idle_timeout_ms`, so a handful of them cannot keep every connection slot from real clients.
//
// Strict where a proxy in front might be lenient, because a difference between the
// two is how requests get smuggled: a request whose `Content-Length` values differ,
// or is not plain digits (`+5`), or that has two `Transfer-Encoding` or `Host`
// headers, or an HTTP/1.1 request with no `Host`, or a header name that is not a
// token, or a header line with a bare CR or LF or another control character, is a
// 400. Response headers are checked on the way out: `write_response` refuses a
// header whose name is not a token or whose value has a control character (CRLF
// injection through a value an application took from a client) and sends a 500.

val read_chunk_bytes = 4096
val accept_error_backoff_ms = 10

// How long the poller waits on a batch of idle connections before looking around again. Bounded for
// the same reason `accept` polls in slices underneath: a shutdown has to be noticed, and there is no
// way to interrupt a wait told to last forever. 250ms matches what accept_raw uses.
val poll_slice_ms = 250

// How long a worker waits for a keep-alive connection's next request before handing it back to the
// poller. Small on purpose: it is a bet that a busy connection's next request is already arriving,
// and the cost of losing the bet is one wasted wait, where the cost of not betting is a thread
// spawn and two channel hops per request (see serve_burst).
val keepalive_grace_ms = 5
val http_1_0 = "HTTP/1.0"
val http_1_1 = "HTTP/1.1"
val continue_response = "HTTP/1.1 100 Continue\r\n\r\n"

use clock
use compress
use http.Header
use http.HttpMethod
use http.Request
use http.Response
use http.content_type
use http.header
use http.header_value
use http.is_field_value
use http.is_token
use http.method_name
use http.method_parse
use http.percent_decode
use http.quality
use http.status_accepted
use http.status_bad_request
use http.status_conflict
use http.status_continue
use http.status_created
use http.status_forbidden
use http.status_found
use http.status_header_fields_too_large
use http.status_internal_server_error
use http.status_method_not_allowed
use http.status_moved_permanently
use http.status_no_content
use http.status_not_acceptable
use http.status_not_found
use http.status_not_implemented
use http.status_not_modified
use http.status_ok
use http.status_payload_too_large
use http.status_request_timeout
use http.status_service_unavailable
use http.status_too_many_requests
use http.status_unauthorized
use http.status_unprocessable_entity
use http.status_unsupported_media_type
use json.Json
use json.json_to_bytes
use json.parse_json_bytes
use metrics
use mime
use net
use net.Listener
use net.NetError
use net.Socket
use net.net_error_message
use number.byte_from_hex
use number.byte_to_hex
use number.int_from_hex
use os

// The `{name}` captures of a matched route, by position.
pub struct Params {
    names: [string]
    values: [string]
}

// Why reading a request failed: malformed (`BadRequest`), too large (`BodyTooLarge`,
// `HeadersTooLarge`), unsupported (`NotImplemented`), a stalled client (`Timeout`), a peer that
// went away (`Closed`) or a socket error (`Io`). `serve` answers each with the matching status
// where the peer is still there.
pub enum HttpError {
    BadRequest(string)
    BodyTooLarge
    HeadersTooLarge
    NotImplemented(string)
    Timeout
    Closed
    Io(string)
}

// One client connection's read state: the socket, plus any bytes already
// read past the end of the last request (the start of the next, when a
// client pipelines). Values are immutable, so `read_request` returns the
// updated session rather than changing this one.
pub struct Session {
    sock: Socket
    buffer: [byte]
    timeout_ms: int
    head_timeout_ms: int
    fresh: bool
    // The largest request body `read_request` will accept, or 0 for this module's 1 MiB default.
    // `serve` fills it from `ServeOptions.max_body_bytes`; the `open_session*` constructors leave it
    // 0, so a caller reading requests off its own socket keeps the default until it says otherwise.
    //
    // It is here rather than only on `ServeOptions` because `read_request(session)` is the public
    // entry point and the North Star backend calls it directly -- a limit the server knows has to
    // reach it somehow, and widening that signature would break every such caller (D21, D22).
    max_body_bytes: int
}

// One request read from a connection, with the session to read the next one from.
pub struct Exchange {
    request: Request
    session: Session
}

val max_header_bytes = 16384
val max_body_bytes = 1048576
val max_chunk_line_bytes = 1024

// ------------------------------------------------------------ helpers

fn lift<T>(r: Result<T, NetError>) -> Result<T, HttpError> {
    if Err(e2) = r {
        val e = e2
        if NetError.is_Timeout(e) {
            return err(HttpError.Timeout)
        }
        if NetError.is_Closed(e) {
            return err(HttpError.Closed)
        }
        return err(HttpError.Io(net_error_message(e)))
    }
    return unwrap(r)
}

fn text_of(b: [byte], start: int, end: int) -> Result<string, HttpError> {
    if Ok(s) = bytes_to_string(slice<byte>(b, start, end)) {
        return s
    }
    return err(HttpError.BadRequest("request contains a NUL byte"))
}

val crlf: [byte] = [13b, 10b]
val crlf_crlf: [byte] = [13b, 10b, 13b, 10b]

// Index just past the first CRLF CRLF, or -1.
fn find_head_end(buf: [byte]) -> int {
    val at = bytes_index_of(buf, crlf_crlf, 0)
    return if at < 0 { -1 } else { at + 4 }
}

// A new connection's read state: the socket and nothing buffered yet. Reads are bounded only by
// the socket's own timeout, one read at a time.
pub fn open_session(sock: Socket) -> Session {
    return Session { sock: sock, buffer: [], timeout_ms: 0, head_timeout_ms: 0, fresh: false, max_body_bytes: 0 }
}

// Like `open_session`, and the whole of each request (head and body, from its first byte) must
// arrive within `timeout_ms` (a stalled or dripping client gets `Err(Timeout)`, answered 408), on top
// of the socket's per-read timeout, which it sets and resets itself: set none yourself. `serve` opens
// its sessions this way with `idle_timeout_ms`.
#[deprecated("use open_session_with_timeouts, which also bounds the request head")]
pub fn open_session_with_timeout(sock: Socket, timeout_ms: int) -> Session {
    return Session {
        sock: sock,
        buffer: [],
        timeout_ms: timeout_ms,
        head_timeout_ms: 0,
        fresh: false,
        max_body_bytes: 0
    }
}

// Like `open_session_with_timeout`, and the head of each request -- from its first byte to the blank line that ends it -- must also arrive within
// `head_timeout_ms` (a client that is honest sends it at once). For a session on a new connection the socket's own timeout must already be
// `head_timeout_ms`, which is then also how long the first byte may take; once the first request is read, the socket goes back to `timeout_ms`, the wait
// between requests of a keep-alive connection. `serve` opens its sessions this way with `ServeOptions.header_timeout_ms`.
pub fn open_session_with_timeouts(sock: Socket, timeout_ms: int, head_timeout_ms: int) -> Session {
    return Session {
        sock: sock,
        buffer: [],
        timeout_ms: timeout_ms,
        head_timeout_ms: head_timeout_ms,
        fresh: true,
        max_body_bytes: 0
    }
}

// ------------------------------------------------------------- reading

fn parse_header_line(line: string) -> Result<Header, HttpError> {
    if len(line) == 0 || starts_with(line, " ") || starts_with(line, "\t") {
        return err(HttpError.BadRequest("malformed header line"))
    }
    if Some(parts) = split_once(line, ":") {
        val name = parts[0]
        if !is_token(name) {
            return err(HttpError.BadRequest("malformed header name"))
        }
        if !is_field_value(parts[1]) {
            return err(HttpError.BadRequest("a header value has a control character"))
        }
        return Header { name: name, value: trim(parts[1]) }
    }
    return err(HttpError.BadRequest(concat("header line has no ':': ", line)))
}

// A request body sent with `Transfer-Encoding: chunked`, decoded, and the bytes read past its end
// (the start of the next pipelined request).
struct ChunkedBody {
    body: [byte]
    rest: [byte]
}

// One read of at most `max` bytes. With a `limit_ms` and a `started` (the monotonic time the request's
// first byte arrived; -1 before that) the read is held to what is left of the request's time -- the socket's
// timeout is lowered to it -- and a request already past it is `Err(Timeout)`.
fn read_within(sock: Socket, max: int, limit_ms: int, started: int) -> Result<[byte], HttpError> {
    if limit_ms > 0 && started >= 0 {
        val left = limit_ms - (clock.monotonic_millis() - started)
        if left <= 0 {
            return err(HttpError.Timeout)
        }
        try lift<unit>(net.set_timeout(sock, left))
    }
    return lift<[byte]>(net.read(sock, max))
}

// Puts the socket's timeout back to `limit_ms` after `read_within` lowered it, so the response write and
// the wait for the next request get the full timeout again.
fn restore_timeout(sock: Socket, limit_ms: int, lowered: bool) -> Result<unit, HttpError> {
    if lowered && limit_ms > 0 {
        try lift<unit>(net.set_timeout(sock, limit_ms))
    }
    return ok(unit)
}

// Reads more bytes from the socket onto `buf`.
fn fill(sock: Socket, buf: [byte], limit_ms: int, started: int) -> Result<[byte], HttpError> {
    return bytes_concat(buf, try read_within(sock, read_chunk_bytes, limit_ms, started))
}

// Decodes a chunked body (RFC 7230 section 4.1): `size-in-hex [;extension] CRLF data CRLF`
// repeated, a `0` chunk, optional trailer lines (skipped), and a final blank line. `start` holds
// what was already read past the request head. The decoded body is limited to `cap`.
fn read_chunked(sock: Socket, start: [byte], limit_ms: int, started: int, cap: int) -> Result<ChunkedBody, HttpError> {
    var buf = start
    val body = mutable_array_new<byte>()
    var total = 0
    while true {
        var eol = bytes_index_of(buf, crlf, 0)
        while eol < 0 {
            if len(buf) > max_chunk_line_bytes {
                return err(HttpError.BadRequest("chunk size line is too long"))
            }
            val more = try fill(sock, buf, limit_ms, started)
            buf = more
            eol = bytes_index_of(buf, crlf, 0)
        }
        val size_line = try text_of(buf, 0, eol)
        val size_text = trim(split(size_line, ";")[0])
        val n = switch int_from_hex(size_text) {
            Ok(v) {
                if v < 0 || len(size_text) > 8 {
                    return err(HttpError.BadRequest(format("invalid chunk size '{}'", size_line)))
                }
                v
            }
            Err(_) { return err(HttpError.BadRequest(format("invalid chunk size '{}'", size_line))) }
        }
        buf = slice<byte>(buf, eol + 2, len(buf))
        if n == 0 {
            // trailers: header lines up to a blank line, all ignored
            var trailer_end = bytes_index_of(buf, crlf, 0)
            while trailer_end != 0 {
                while trailer_end < 0 {
                    if len(buf) > max_header_bytes {
                        return err(HttpError.HeadersTooLarge)
                    }
                    val more = try fill(sock, buf, limit_ms, started)
                    buf = more
                    trailer_end = bytes_index_of(buf, crlf, 0)
                }
                if trailer_end != 0 {
                    buf = slice<byte>(buf, trailer_end + 2, len(buf))
                    trailer_end = bytes_index_of(buf, crlf, 0)
                }
            }
            return ChunkedBody { body: snapshot(body), rest: slice<byte>(buf, 2, len(buf)) }
        }
        total = total + n
        if total > cap {
            return err(HttpError.BodyTooLarge)
        }
        while len(buf) < n + 2 {
            val more = try fill(sock, buf, limit_ms, started)
            buf = more
        }
        if buf[n] != 13b || buf[n + 1] != 10b {
            return err(HttpError.BadRequest("a chunk is not followed by CRLF"))
        }
        mutable_array_push(body, slice<byte>(buf, 0, n))
        buf = slice<byte>(buf, n + 2, len(buf))
    }
    return err(HttpError.BadRequest("unreachable"))
}

// Reads the next request off the session. `Err(Closed)` when the client
// closed the connection between requests (the normal way a keep-alive
// connection ends); other errors mean the request itself was unusable --
// `error_response` maps one to the HTTP response to send before closing.
pub fn read_request(session: Session) -> Result<Exchange, HttpError> {
    val sock = session.sock
    // 0 means "the library's default", so a session built by one of the `open_session*`
    // constructors keeps the 1 MiB cap and `serve` can override it from its options (D22).
    val body_cap = if session.max_body_bytes > 0 { session.max_body_bytes } else { max_body_bytes }
    val limit_ms = session.timeout_ms
    val head_limit_ms = if session.head_timeout_ms > 0 && (limit_ms <= 0 || session.head_timeout_ms < limit_ms) {
        session.head_timeout_ms
    } else {
        limit_ms
    }
    var buf = session.buffer
    var lowered = false
    var started = if len(buf) > 0 { clock.monotonic_millis() } else { -1 }
    var head_end = find_head_end(buf)
    while head_end < 0 {
        if len(buf) > max_header_bytes {
            return err(HttpError.HeadersTooLarge)
        }
        val continuing = started >= 0
        val chunk = try read_within(sock, read_chunk_bytes, head_limit_ms, started)
        if continuing {
            lowered = true
        } else {
            started = clock.monotonic_millis()
        }
        buf = bytes_concat(buf, chunk)
        head_end = find_head_end(buf)
    }
    if head_end > max_header_bytes {
        return err(HttpError.HeadersTooLarge)
    }

    val head_text = try text_of(buf, 0, head_end - 4)
    val lines = split(head_text, "\r\n")
    var first = 0
    while first < len(lines) && lines[first] == "" {
        first = first + 1
    }
    if first >= len(lines) {
        return err(HttpError.BadRequest("empty request"))
    }
    if !is_field_value(lines[first]) {
        return err(HttpError.BadRequest("the request line has a control character"))
    }
    val request_line = split(lines[first], " ")
    if len(request_line) != 3 {
        return err(HttpError.BadRequest("malformed request line"))
    }
    val method_text = request_line[0]
    val target = request_line[1]
    val version = request_line[2]
    if version != http_1_1 && version != http_1_0 {
        return err(HttpError.BadRequest(concat("unsupported HTTP version: ", version)))
    }
    if !is_token(method_text) || (!starts_with(target, "/") && target != "*") {
        return err(HttpError.BadRequest("malformed request target"))
    }

    val headers = mutable_array_new<Header>()
    var i = first + 1
    while i < len(lines) {
        val h = try parse_header_line(lines[i])
        mutable_array_push(headers, h)
        i = i + 1
    }
    val header_list = snapshot(headers)

    // What a proxy in front might read differently from this server is what request smuggling uses:
    // so a request that says the same thing twice, or two different things, is refused outright.
    var host_count = 0
    var length_count = 0
    var length_text = ""
    var encoding_count = 0
    for h in header_list {
        if equals_ignore_case(h.name, "Host") {
            host_count = host_count + 1
        } else if equals_ignore_case(h.name, "Content-Length") {
            if length_count > 0 && h.value != length_text {
                return err(HttpError.BadRequest("conflicting Content-Length headers"))
            }
            length_text = h.value
            length_count = length_count + 1
        } else if equals_ignore_case(h.name, "Transfer-Encoding") {
            encoding_count = encoding_count + 1
        }
    }
    if host_count > 1 {
        return err(HttpError.BadRequest("more than one Host header"))
    }
    if host_count == 0 && version == http_1_1 {
        return err(HttpError.BadRequest("an HTTP/1.1 request needs a Host header"))
    }
    if encoding_count > 1 {
        return err(HttpError.BadRequest("more than one Transfer-Encoding header"))
    }

    var path = target
    var query = ""
    val tq = split_once(target, "?")
    if Some(parts) = tq {
        path = parts[0]
        query = parts[1]
    }

    val transfer_encoding = header_value(header_list, "Transfer-Encoding")
    val is_chunked = switch transfer_encoding {
        Some(te) { equals_ignore_case(trim(te), "chunked") }
        None { false }
    }
    if Some(te) = transfer_encoding && !is_chunked {
        return err(HttpError.NotImplemented(format("unsupported Transfer-Encoding '{}'", te)))
    }
    if is_chunked && Option.is_Some(header_value(header_list, "Content-Length")) {
        return err(HttpError.BadRequest("both Transfer-Encoding and Content-Length are set"))
    }
    if is_chunked {
        val expect_chunked = header_value(header_list, "Expect")
        if Some(expect_chunked) = expect_chunked && equals_ignore_case(expect_chunked, "100-continue") {
            try lift<int>(net.write_text(sock, continue_response))
        }
        val decoded = try read_chunked(sock, slice<byte>(buf, head_end, len(buf)), limit_ms, started, body_cap)
        try restore_timeout(sock, limit_ms, true)
        val chunked_request = Request {
            method: method_parse(method_text),
            target: target,
            path: path,
            query: query,
            version: version,
            headers: header_list,
            body: decoded.body,
            peer: net.peer_address(sock)
        }
        return Exchange {
            request: chunked_request,
            session: Session {
                sock: sock,
                buffer: decoded.rest,
                timeout_ms: limit_ms,
                head_timeout_ms: session.head_timeout_ms,
                fresh: false,
                max_body_bytes: session.max_body_bytes
            }
        }
    }
    var content_length = 0
    val cl = header_value(header_list, "Content-Length")
    if Some(cl) = cl {
        val cl_text = trim(cl)
        content_length = switch parse_int(cl_text) {
            Ok(v) {
                if starts_with(cl_text, "+") || starts_with(cl_text, "-") {
                    return err(HttpError.BadRequest("invalid Content-Length"))
                }
                v
            }
            Err(_) { return err(HttpError.BadRequest("invalid Content-Length")) }
        }
    }
    if content_length > body_cap {
        return err(HttpError.BodyTooLarge)
    }

    var rest = slice<byte>(buf, head_end, len(buf))
    if content_length > len(rest) {
        val expect = header_value(header_list, "Expect")
        if Some(expect) = expect && equals_ignore_case(expect, "100-continue") {
            try lift<int>(net.write_text(sock, continue_response))
        }
        // `bytes_concat` in this loop re-copied everything read so far on every chunk, which is
        // quadratic in the body size: a 1 MiB body arriving in 4 KiB reads is about 128 MiB of
        // copying. A byte builder appends into packed storage, so each chunk is one memcpy and the
        // body is copied once at the end (D22).
        val acc = mutable_array_new<byte>()
        concat(acc, rest)
        while len(acc) < content_length {
            val more = try read_within(sock, content_length - len(acc), limit_ms, started)
            lowered = true
            concat(acc, more)
        }
        rest = snapshot(acc)
    }
    try restore_timeout(sock, limit_ms, lowered || session.fresh)
    val body = slice<byte>(rest, 0, content_length)
    val leftover = slice<byte>(rest, content_length, len(rest))

    val request = Request {
        method: method_parse(method_text),
        target: target,
        path: path,
        query: query,
        version: version,
        headers: header_list,
        body: body,
        peer: net.peer_address(sock)
    }
    return Exchange {
        request: request,
        session: Session {
            sock: sock,
            buffer: leftover,
            timeout_ms: limit_ms,
            head_timeout_ms: session.head_timeout_ms,
            fresh: false,
            max_body_bytes: session.max_body_bytes
        }
    }
}

// ------------------------------------------------------------ responses

fn reason(status: int) -> string {
    if status == status_continue { return "Continue" }
    if status == status_ok { return "OK" }
    if status == status_created { return "Created" }
    if status == status_accepted { return "Accepted" }
    if status == status_no_content { return "No Content" }
    if status == status_moved_permanently { return "Moved Permanently" }
    if status == status_found { return "Found" }
    if status == status_not_modified { return "Not Modified" }
    if status == status_bad_request { return "Bad Request" }
    if status == status_unauthorized { return "Unauthorized" }
    if status == status_forbidden { return "Forbidden" }
    if status == status_not_found { return "Not Found" }
    if status == status_method_not_allowed { return "Method Not Allowed" }
    if status == status_not_acceptable { return "Not Acceptable" }
    if status == status_request_timeout { return "Request Timeout" }
    if status == status_conflict { return "Conflict" }
    if status == status_payload_too_large { return "Payload Too Large" }
    if status == status_unsupported_media_type { return "Unsupported Media Type" }
    if status == status_unprocessable_entity { return "Unprocessable Entity" }
    if status == status_too_many_requests { return "Too Many Requests" }
    if status == status_header_fields_too_large { return "Request Header Fields Too Large" }
    if status == status_internal_server_error { return "Internal Server Error" }
    if status == status_not_implemented { return "Not Implemented" }
    if status == status_service_unavailable { return "Service Unavailable" }
    return "Status"
}

// A response with `status`, no headers and `body`.
pub fn response(status: int, body: [byte]) -> Response {
    return Response { status: status, headers: [], body: body }
}

// `r` with one more header (added after any it already has; nothing is replaced).
pub fn with_header(r: Response, name: string, value: string) -> Response {
    return Response { status: r.status, headers: push(r.headers, Header { name: name, value: value }), body: r.body }
}

// A response with `status` and `body`, `Content-Type` set to `media` (parameters such as a charset included).
pub fn media_response(status: int, body: [byte], media: mime.MediaType) -> Response {
    return with_header(response(status, body), "Content-Type", mime.to_string(media))
}

// A response with `status` and `body`, `Content-Type: application/json`.
pub fn json_response(status: int, body: string) -> Response {
    return media_response(status, string_to_bytes(body), mime.application_json())
}

// A response with `status` and `body`, `Content-Type: text/plain; charset=utf-8`.
pub fn text_response(status: int, body: string) -> Response {
    return media_response(status, string_to_bytes(body), mime.with_param(mime.text_plain(), "charset", "utf-8"))
}

// `text` as a JSON string literal, quotes included: `"` and `\` and the control characters escaped, every
// other byte (UTF-8 included) as it is. Written here so the server needs nothing but its own error replies.
fn json_quoted(text: string) -> string {
    val out = mutable_string_new()
    mutable_string_append(out, "\"")
    for b in string_to_bytes(text) {
        if b == 34b {
            mutable_string_append(out, "\\\"")
        } else if b == 92b {
            mutable_string_append(out, "\\\\")
        } else if b == 10b {
            mutable_string_append(out, "\\n")
        } else if b == 13b {
            mutable_string_append(out, "\\r")
        } else if b == 9b {
            mutable_string_append(out, "\\t")
        } else if b == 8b {
            mutable_string_append(out, "\\b")
        } else if b == 12b {
            mutable_string_append(out, "\\f")
        } else if (b as int) < 32 {
            mutable_string_append(out, "\\u00", byte_to_hex(b))
        } else {
            mutable_string_append_byte(out, b)
        }
    }
    mutable_string_append(out, "\"")
    return snapshot(out)
}

fn error_body(status: int, message: string) -> string {
    return format("{}\"status\":{},\"error\":{}{}", "{", status, json_quoted(message), "}")
}

fn error_reply(status: int, message: string) -> Response {
    return json_response(status, error_body(status, message))
}

// A 400 response with a JSON body `{"status":400,"error":message}`.
pub fn bad_request(message: string) -> Response {
    return error_reply(status_bad_request, message)
}

// A 404 response with a JSON body `{"status":404,"error":"not found"}`.
pub fn not_found() -> Response {
    return error_reply(status_not_found, "not found")
}

// A 405 response with an `Allow` header listing `allowed`, and a JSON error body.
pub fn method_not_allowed(allowed: variadic string) -> Response {
    return with_header(
        error_reply(status_method_not_allowed, "method not allowed"),
        "Allow",
        join(separator: ", ", pieces: allowed)
    )
}

// The response to send for a request that couldn't be read. (`Closed` and
// `Io` mean there is nobody to answer; the caller just closes.)
pub fn error_response(e: HttpError) -> Response {
    return error_reply(error_status(e), error_text(e))
}

// The status a rejection of `e` carries, and the sentence that goes with it. These exist so an application can
// render the server's own rejections in its own error shape: `error_response` is the library's rendering of the
// same pair, and `ServeOptions.fault` is given these two rather than the `HttpError`, so an application does not
// have to match on a library enum to answer a 413.
pub fn error_status(e: HttpError) -> int {
    return switch e {
        BadRequest(_) { status_bad_request }
        BodyTooLarge { status_payload_too_large }
        HeadersTooLarge { status_header_fields_too_large }
        NotImplemented(_) { status_not_implemented }
        Timeout { status_request_timeout }
        Closed { status_internal_server_error }
        Io(_) { status_internal_server_error }
    }
}

pub fn error_text(e: HttpError) -> string {
    return switch e {
        BadRequest(msg) { msg }
        BodyTooLarge { "request body too large" }
        HeadersTooLarge { "request headers too large" }
        NotImplemented(msg) { msg }
        Timeout { "request timed out" }
        Closed { "internal error" }
        Io(_) { "internal error" }
    }
}

// HTTP/1.1 defaults to keep-alive unless told to close; HTTP/1.0 is the other way around, defaulting
// to close unless told to keep-alive.
fn connection_close_requested(req: Request) -> bool {
    val c = header(req, "Connection")
    if Some(c) = c {
        val v = to_lower(c)
        if contains(v, "close") {
            return true
        }
        if contains(v, "keep-alive") {
            return false
        }
    }
    return req.version == http_1_0
}

// Serialises and sends `resp` (adding Content-Length and Connection), and
// says whether the connection stays open for another request: HTTP/1.1
// keeps alive unless either side asked to close, HTTP/1.0 only if the
// client asked to keep it. A `HEAD` request gets the headers, with the
// Content-Length the body would have had, and no body.
pub fn write_response(sock: Socket, req: Request, response: Response) -> Result<bool, HttpError> {
    var resp = response
    var refused = false
    for h in response.headers {
        if !is_token(h.name) || !is_field_value(h.value) {
            refused = true
        }
    }
    if refused {
        // A CR, LF or other control character in a header name or value would end the header line and
        // let the rest pass for another header or a body (an application putting client text in a
        // header without checking it). Fail closed; say so on stderr, without the offending text.
        os.write_stderr("ziman: a response header has a name that is not a token or a value with a control character; the response is replaced by a 500\n")
        resp = error_reply(status_internal_server_error, "internal error")
    }
    var keep = !refused && !connection_close_requested(req)
    for h in resp.headers {
        if equals_ignore_case(h.name, "connection") && contains(to_lower(h.value), "close") {
            keep = false
        }
    }
    val sb = mutable_string_new()
    mutable_string_append(sb, format("HTTP/1.1 {} {}\r\n", resp.status, reason(resp.status)))
    var has_date = false
    var has_nosniff = false
    for h in resp.headers {
        val lname = to_lower(h.name)
        if lname == "date" {
            has_date = true
        }
        if lname == "x-content-type-options" {
            has_nosniff = true
        }
        // Content-Length and Connection are always written below from resp.body and keep, so a
        // caller-supplied one here would just be a duplicate.
        if lname != "content-length" && lname != "connection" {
            mutable_string_append(sb, h.name, ": ", h.value, "\r\n")
        }
    }
    if !has_date {
        mutable_string_append(sb, "Date: ", clock.now_http_date(), "\r\n")
    }
    if !has_nosniff {
        mutable_string_append(sb, "X-Content-Type-Options: nosniff\r\n")
    }
    mutable_string_append(sb, format("Content-Length: {}\r\n", len(resp.body)))
    if keep {
        mutable_string_append(sb, "Connection: keep-alive\r\n")
    } else {
        mutable_string_append(sb, "Connection: close\r\n")
    }
    mutable_string_append(sb, "\r\n")
    val head = string_to_bytes(snapshot(sb))
    val sent = if HttpMethod.is_Head(req.method) { head } else { bytes_concat(head, resp.body) }
    try lift<int>(net.write(sock, sent))
    return keep
}

// ------------------------------------------------------------ response compression
//
// `resp` with its body gzipped, when that is both allowed and worth doing; `resp` unchanged
// otherwise. A separate function rather than something `write_response` does for you, for the same
// reason the CORS pair is two functions: it composes with `serve`, a hand-written loop or a static
// file handler by sitting in front of whichever one writes.
//
// **Off unless asked for** (`ServeOptions.compress_responses`), and that default is a security choice, not
// caution about the CPU. Compressing a response that holds a secret alongside attacker-influenced
// text leaks the secret through the compressed length -- the BREACH class -- and an API whose login
// answer carries a JWT is exactly that shape. A server that wants the bandwidth asks for it; no
// existing server gets a compression oracle switched on underneath it.
//
// Four conditions, all of which have to hold:
//   * the request's `Accept-Encoding` offers gzip (`identity` and absence both mean no),
//   * the handler has not already set `Content-Encoding` -- it may be sending something already
//     compressed, and gzipping that twice is slower and larger,
//   * the body is at least `min_bytes`; under a packet's worth there is nothing to win and gzip's
//     own header can make it bigger,
//   * and the result is actually smaller than the input, which incompressible bodies (a JPEG, an
//     already-encrypted blob) fail -- checked rather than assumed.
//
// `Vary: Accept-Encoding` goes on every answer this touches, compressed or not, for the same reason
// `cors_apply` sets `Vary: Origin`: whether the body is gzipped is what varies by the header, so a
// shared cache without it can hand a gzipped body to a client that never asked for one
// (tasks.md F61, and F59 for the identical hazard with Origin).
pub fn compressed(req: Request, resp: Response, min_bytes: int) -> Response {
    for h in resp.headers {
        if equals_ignore_case(h.name, "Content-Encoding") {
            return resp
        }
    }
    val varied = with_header(resp, "Vary", "Accept-Encoding")
    if !accepts_gzip(req) || len(resp.body) < min_bytes {
        return varied
    }
    val packed = compress.gzip(resp.body)
    if len(packed) >= len(resp.body) {
        return varied
    }
    return Response {
        status: varied.status,
        headers: push(varied.headers, Header { name: "Content-Encoding", value: "gzip" }),
        body: packed
    }
}

// Whether `req` says it will take gzip. A q-value of 0 is a refusal -- `gzip;q=0` means "not gzip"
// -- so it is read rather than ignored; anything else offering gzip counts. Full q-value ranking is
// its own roadmap item and this needs none of it: the only question here is yes or no.
fn accepts_gzip(req: Request) -> bool {
    val offered = switch header(req, "Accept-Encoding") {
        Some(value) { to_lower(value) }
        None { return false }
    }
    for piece in split(offered, ",") {
        val spec = trim(piece)
        if starts_with(spec, "gzip") {
            if contains(spec, "q=0") && !contains(spec, "q=0.") {
                return false
            }
            return true
        }
    }
    return false
}

// Sends the response for a request that couldn't be read (see
// `error_response`) and closes the exchange: there is no parsed Request to
// consult, so it always says `Connection: close`. Nothing to send for
// `Closed`/`Io` -- the peer is gone -- so it succeeds without writing.
pub fn write_error(sock: Socket, e: HttpError) -> Result<bool, HttpError> {
    val none: Option<fn(int, string) -> Response> = None
    return write_error_with(sock, e, none)
}

// `write_error`, but rendering the rejection through `fault` when there is one -- see `ServeOptions.fault`. The
// application gets the status and the sentence, not the `HttpError`, and what it returns is written as-is, so its
// body shape and any header it adds (an HSTS header, say) are on the rejection too.
pub fn write_error_with(
    sock: Socket,
    e: HttpError,
    fault: Option<fn(int, string) -> Response>
) -> Result<bool, HttpError> {
    if HttpError.is_Closed(e) || HttpError.is_Io(e) {
        return false
    }
    val stub = Request {
        method: HttpMethod.Get,
        target: "/",
        path: "/",
        query: "",
        version: http_1_0,
        headers: [],
        body: [],
        peer: None
    }
    val reply = switch fault {
        Some(render) { render(error_status(e), error_text(e)) }
        None { error_response(e) }
    }
    return write_response(sock, stub, reply)
}

// -------------------------------------------------------------- routing

// Matches `path` against `pattern`: literal segments must be equal, and a
// `{name}` segment captures any non-empty segment (percent-decoded). A
// trailing slash is ignored on both sides. `None` if it doesn't match.
pub fn path_params(pattern: string, path: string) -> Option<Params> {
    return capture(compile_pattern(pattern), segments_of(path))
}

// A route pattern split into its segments once, so matching never splits or re-parses it: `parts[i]` is a
// literal segment's text, or a `{name}` segment's name, and `is_param[i]` says which.
struct Pattern {
    parts: [string]
    is_param: [bool]
}

// `path` without a trailing slash (the bare "/" stays) split on "/": what a path and a pattern are both
// matched as.
fn segments_of(path: string) -> [string] {
    var p = path
    if len(p) > 1 && ends_with(p, "/") {
        p = substring(p, 0, len(p) - 1)
    }
    return split(p, "/")
}

fn compile_pattern(pattern: string) -> Pattern {
    val parts = mutable_array_new<string>()
    val is_param = mutable_array_new<bool>()
    for segment in segments_of(pattern) {
        if len(segment) >= 3 && starts_with(segment, "{") && ends_with(segment, "}") {
            mutable_array_push(parts, substring(segment, 1, len(segment) - 1))
            mutable_array_push(is_param, true)
        } else {
            mutable_array_push(parts, segment)
            mutable_array_push(is_param, false)
        }
    }
    return Pattern { parts: snapshot(parts), is_param: snapshot(is_param) }
}

// Whether the split path `got` has this pattern's shape: as many segments, every literal equal, every
// `{name}` segment non-empty. Allocates nothing; percent-decoding a captured segment waits for `capture`.
fn shape_matches(p: Pattern, got: [string]) -> bool {
    if len(p.parts) != len(got) {
        return false
    }
    var i = 0
    while i < len(got) {
        if p.is_param[i] {
            if got[i] == "" {
                return false
            }
        } else if p.parts[i] != got[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// The captures of the split path `got` under `p`, percent-decoded, or None if it does not match (a
// captured segment that is not valid percent-encoding is no match).
fn capture(p: Pattern, got: [string]) -> Option<Params> {
    if !shape_matches(p, got) {
        return Option<Params>.None
    }
    val names = mutable_array_new<string>()
    val values = mutable_array_new<string>()
    var i = 0
    while i < len(got) {
        if p.is_param[i] {
            if Ok(decoded) = percent_decode(got[i], false) {
                mutable_array_push(names, p.parts[i])
                mutable_array_push(values, decoded)
            } else {
                return Option<Params>.None
            }
        }
        i = i + 1
    }
    return Option<Params>.Some(Params { names: snapshot(names), values: snapshot(values) })
}

// `Some(params)` if the request's method is `method` and its path matches
// `pattern`, else `None` -- the one-line test a route function is built
// from: `val m = server.route(req, HttpMethod.Get, "/patients/{id}")`.
pub fn route(req: Request, method: HttpMethod, pattern: string) -> Option<Params> {
    if req.method != method {
        return Option<Params>.None
    }
    return path_params(pattern, req.path)
}

// A captured parameter by name. Asking for a name the pattern doesn't
// have is a bug in the route function, so it is a fatal error rather than
// a value to check.
pub fn param(p: Params, name: string) -> string {
    var i = 0
    while i < len(p.names) {
        if p.names[i] == name {
            return p.values[i]
        }
        i = i + 1
    }
    val missing: Result<string, string> = err(concat("no route parameter named ", name))
    return unwrap(missing)
}

// What to answer when no route matched. `routes` lists every route as
// "METHOD /pattern": if the path matches some route under a *different*
// method the answer is 405 with an Allow header, otherwise 404.
pub fn not_found_or_method_not_allowed(req: Request, routes: [string]) -> Response {
    val allowed = mutable_array_new<string>()
    for r in routes {
        val parts = split(r, " ")
        if len(parts) == 2 && Option.is_Some(path_params(parts[1], req.path)) {
            mutable_array_push(allowed, parts[0])
        }
    }
    val methods = snapshot(allowed)
    return if len(methods) > 0 { method_not_allowed(methods) } else { not_found() }
}

// A query-string value by name, percent-decoded ("+" is a space); the
// first one if it is repeated. `None` if absent.
pub fn query_param(req: Request, name: string) -> Option<string> {
    for pair in split(req.query, "&") {
        val kv = split_once(pair, "=")
        if Some(parts) = kv {
            if Ok(key) = percent_decode(parts[0], true) {
                if key == name {
                    if Ok(value) = percent_decode(parts[1], true) {
                        return Option<string>.Some(value)
                    }
                }
            }
        } else if pair == name {
            return Option<string>.Some("")
        }
    }
    return Option<string>.None
}

// -------------------------------------------------------------- multipart/form-data
//
// A `multipart/form-data` body is a sequence of parts separated by a boundary the client chose and
// named in the `Content-Type`. Each part has its own small header block -- a `Content-Disposition`
// naming the form field, a filename when it is an upload, and an optional `Content-Type` -- then a
// blank line, then bytes. `multipart` reads one into `Part` values; the bytes stay bytes, so a part
// may hold a NUL, invalid UTF-8, or a whole image.
//
//     if Some(_) = server.multipart_boundary(req) {
//         switch server.multipart(req) {
//             Ok(parts) {
//                 if Some(p) = server.part(parts, "report") { store(p.filename, p.body) }
//             }
//             Err(e) { return server.error_response(e) }   // a malformed body is a 400
//         }
//     } else {
//         return fault(status_unsupported_media_type, "expected multipart/form-data")
//     }
//
// The whole body is already in memory -- `read_request` caps it at this module's `max_body_bytes`,
// 1 MiB -- so this parses it in one pass and streams nothing. `multipart` stops at `multipart_max_parts`
// parts, since a body of nothing but boundary lines would otherwise make one value per 40 bytes.

// One part of a `multipart/form-data` body: the form field's `name`, a `filename` that is `Some` only for
// an upload, the `Content-Type` the part declared, and its bytes.
//
// `filename` and `content_type` are **the client's claims about its own data**, not facts. The filename is
// the name some other machine's filesystem had: show it, store it as text, but never open it as a path --
// it may be `../../etc/passwd`, an absolute path, or 300 bytes of control characters. The content type is
// likewise a claim; sniff the bytes if what they are matters.
//
// `body` is bytes rather than a string because a part may be a file: it can hold a NUL, invalid UTF-8 or a
// JPEG, and nothing here decodes or validates it.
pub struct Part {
    name: string
    filename: Option<string>
    content_type: Option<string>
    body: [byte]
}

// How many parts `multipart` reads before it refuses the body; `multipart_with` takes another limit. A body
// of nothing but boundary lines would otherwise make one value per 40 bytes of request.
pub val multipart_max_parts = 128

// The boundary from the request's `Content-Type`, when that is a `multipart/form-data` giving one; `None`
// otherwise.
//
// This is separate from `multipart` so a handler can tell two different answers apart: a request that is
// not multipart at all is a **415**, while everything `multipart` rejects is about the body and is a
// **400**. Check this first when that difference matters -- `multipart` on a JSON body reports a 400,
// since a body is all it is ever asked about.
pub fn multipart_boundary(req: Request) -> Option<string> {
    if Some(media) = content_type(req.headers) {
        // `mime.parse` has already lowered the type, the subtype and the parameter names; a boundary's
        // value it leaves alone, which it must, since a boundary is matched byte for byte.
        if media.type == "multipart" && media.subtype == "form-data" {
            if Some(b) = mime.param(media, "boundary") {
                if len(b) > 0 {
                    return Option<string>.Some(b)
                }
            }
        }
    }
    return Option<string>.None
}

// The value of parameter `key` in a `Content-Disposition` line (`form-data; name="f"; filename="a;b.txt"`).
// Scans the line rather than splitting it on ";", so a quoted value may hold a separator, and `\"` inside
// one is an escaped quote. Names are matched without regard to case. `None` when the parameter is absent --
// including RFC 2231's `filename*=`, which is a different name, and whose encoding this does not decode.
fn disposition_param(line: string, key: string) -> Option<string> {
    val n = len(line)
    var i = 0
    while i < n {
        if char_at(line, i) != ";" {
            i = i + 1
            continue
        }
        i = i + 1
        while i < n && (char_at(line, i) == " " || char_at(line, i) == "\t") {
            i = i + 1
        }
        val eq = index_of(line, "=", i)
        if eq < 0 {
            return Option<string>.None
        }
        val name = trim(substring(line, i, eq))
        i = eq + 1
        var value = ""
        if i < n && char_at(line, i) == "\"" {
            i = i + 1
            val out = mutable_string_new()
            while i < n && char_at(line, i) != "\"" {
                if char_at(line, i) == "\\" && i + 1 < n {
                    i = i + 1
                }
                mutable_string_append(out, char_at(line, i))
                i = i + 1
            }
            i = i + 1
            value = snapshot(out)
        } else {
            var end = i
            while end < n && char_at(line, end) != ";" {
                end = end + 1
            }
            value = trim(substring(line, i, end))
            i = end
        }
        if equals_ignore_case(name, key) {
            return Option<string>.Some(value)
        }
    }
    return Option<string>.None
}

// A header's value out of a part's own header block, matched without regard to case; "" when absent.
fn part_header(block: string, name: string) -> string {
    for line in split(block, "\r\n") {
        val colon = index_of(line, ":", 0)
        if colon > 0 && equals_ignore_case(trim(substring(line, 0, colon)), name) {
            return trim(substring(line, colon + 1, len(line)))
        }
    }
    return ""
}

// One part, from its headers through to the end of its bytes.
fn part_of(chunk: [byte]) -> Result<Part, HttpError> {
    val blank = bytes_index_of(chunk, string_to_bytes("\r\n\r\n"), 0)
    if blank < 0 {
        return err(HttpError.BadRequest("a multipart part has no blank line after its headers"))
    }
    val block = switch bytes_to_string(slice<byte>(chunk, 0, blank)) {
        Ok(text) { text }
        Err(_) { return err(HttpError.BadRequest("a multipart part's headers are not text")) }
    }
    val disposition = part_header(block, "Content-Disposition")
    val name = switch disposition_param(disposition, "name") {
        Some(n) { n }
        None { return err(HttpError.BadRequest("a multipart part has no name in its Content-Disposition")) }
    }
    val declared = part_header(block, "Content-Type")
    return ok(Part {
        name: name,
        filename: disposition_param(disposition, "filename"),
        content_type: if len(declared) > 0 { Option<string>.Some(declared) } else { Option<string>.None },
        body: slice<byte>(chunk, blank + 4, len(chunk))
    })
}

// The parts of a `multipart/form-data` request body, up to `multipart_max_parts` of them. Every `Err` is a
// `BadRequest`, so `error_response` answers it 400: the `Content-Type` gave no boundary, the body contained
// none, it ran out before the closing `--boundary--`, a part had no blank line after its headers or no
// `name` in its `Content-Disposition`, or there were more parts than the limit.
//
// The whole body is already in memory -- `read_request` caps it at this module's `max_body_bytes`,
// a fixed 1 MiB -- so this is one pass over bytes and streams nothing. The cap applies to the
// encoded body, boundaries included.
//
// The cap is **not** configurable today: it is this module's constant, not a `ServeOptions` field,
// which is what these two comments used to say it was -- published advice to raise something a
// caller has no way to reach (D21). Making it a field is D22, and changes either `read_request`'s
// public signature or `Session`'s shape, which is why it is not done here.
//
// What it handles, because a real client sends it: a preamble before the first boundary and an epilogue
// after the last (RFC 2046 says to ignore both); parts with no `Content-Type`; empty parts; header and
// parameter names in any case; parameter values quoted or bare; and a quoted `filename` holding a `;` or an
// escaped `\"`, which is why the `Content-Disposition` line is scanned rather than split on ";". What it
// does not: RFC 2231's `filename*=` extended form is a different parameter name, so it reads as absent
// rather than being decoded, and a nested `multipart/mixed` part is returned as the bytes it is.
pub fn multipart(req: Request) -> Result<[Part], HttpError> {
    return multipart_with(req, multipart_max_parts)
}

// `multipart` with its own limit on how many parts to read.
pub fn multipart_with(req: Request, max_parts: int) -> Result<[Part], HttpError> {
    val boundary = switch multipart_boundary(req) {
        Some(b) { b }
        None { return err(HttpError.BadRequest("expected a multipart/form-data Content-Type with a boundary")) }
    }
    // Every boundary but the first is preceded by a CRLF that belongs to the delimiter, not to the part
    // before it. Prepending one lets the first be found the same way instead of as a special case, and
    // costs a copy of a body already bounded by `max_body_bytes`.
    val body = concat([string_to_bytes("\r\n"), req.body])
    val delim = string_to_bytes(concat("\r\n--", boundary))
    val close = string_to_bytes("--")
    val line_end = string_to_bytes("\r\n")
    val out = mutable_array_new<Part>()
    var at = bytes_index_of(body, delim, 0)
    if at < 0 {
        return err(HttpError.BadRequest("the multipart body contains no boundary"))
    }
    while true {
        var from = at + len(delim)
        // `--boundary--` ends the body. Anything after it is an epilogue, which RFC 2046 says to ignore.
        if from + 2 <= len(body) && slice<byte>(body, from, from + 2) == close {
            return ok(snapshot(out))
        }
        val next = bytes_index_of(body, delim, from)
        if next < 0 {
            return err(HttpError.BadRequest("the multipart body ends without a closing boundary"))
        }
        if len(out) >= max_parts {
            return err(HttpError.BadRequest(concat("a multipart body of more than ", str(max_parts), " parts")))
        }
        // The CRLF that ends the boundary line is not part of the part's headers.
        if from + 2 <= len(body) && slice<byte>(body, from, from + 2) == line_end {
            from = from + 2
        }
        mutable_array_push(out, try part_of(slice<byte>(body, from, next)))
        at = next
    }
    return ok(snapshot(out))
}

// The first part with that field name, since a form may repeat one.
pub fn part(parts: [Part], name: string) -> Option<Part> {
    for p in parts {
        if p.name == name {
            return Option<Part>.Some(p)
        }
    }
    return Option<Part>.None
}

// The first part named `name` as text: `Ok(None)` when no part has that name, and `Err` when the part is
// there but its bytes are not text. The error is the outer answer so a caller that is already returning a
// `Result` can `try` this and go on with an `Option<string>`; an absent field and a field holding a JPEG
// are different things, and neither is silently the other.
pub fn part_text(parts: [Part], name: string) -> Result<Option<string>, string> {
    if Some(p) = part(parts, name) {
        return ok(Option<string>.Some(try bytes_to_string(p.body)))
    }
    return ok(Option<string>.None)
}

// -------------------------------------------------------------- typed endpoints
//
// An endpoint is a method, a pattern and a handler over *typed* values instead of requests and responses:
// the handler takes the decoded request body and returns a `Result` of the answer or an error of the
// application's own type, and the library does what depends on the media type -- it checks the request's
// `Content-Type` (415), negotiates the answer against `Accept` (406), decodes the body (400), and encodes the
// answer with a `Writer` for the negotiated type and the status the endpoint declares. A `Reader` and a `Writer`
// pair a media type with the function that decodes or encodes it, so this module knows no format: JSON, YAML
// or CSV come from the application's own functions.
//
//     // no input: handler; input in the path: path_handler; a request body: body_handler -- each `public_` or `secure_`
//     val patients = server.routes<Ctx>([
//         Endpoint<Ctx> { method: HttpMethod.Post, pattern: "/patients",
//             handler: secure_body_handler<Ctx, Principal, PatientRequest, Patient, ApiError>(who: bearer,
//                 decoders: [json_in], encoders: [json_out], status: 201, run: create_patient, api: api) }
//     ])
//     server.dispatch<Ctx>(patients, ctx, req, fault)
//
// `routes` compiles the table once (build it as a module-level `val`); `dispatch` then does no per-request
// parsing of patterns and looks at only the endpoints with the request's method and number of path segments.
//
// `fault(status, message)` builds the response for what the library itself rejects (400, 404, 405, 406, 415),
// so an application's error bodies have one shape.

// A route: the handler, already adapted to requests and responses, for `method` on `pattern`.
pub struct Endpoint<C> {
    method: HttpMethod
    pattern: string
    handler: fn(C, Request, Params) -> Response
}

// How to decode a request body of type `media` into an `I`; an `Err` message is answered 400. Build one with `decoder`
// (a function over the body's bytes) or `text_decoder` (over its text).
pub struct Decoder<I> {
    media: mime.MediaType
    decode: fn([byte]) -> Result<I, string>
}

// How to encode an answer `O` as `media`. Build one with `encoder` (to bytes) or `text_encoder` (to text).
//
// An endpoint may list several, and **which one answers is the client's choice, not the order here**: each
// one's media type gets the request's `Accept` weight (`http.quality`) and the heaviest wins, so an endpoint
// offering `text/plain` and `text/csv` answers `Accept: text/csv, text/plain;q=0.5` with CSV. This order
// breaks a tie, which makes it the server's preference among types the client likes equally. A type the
// client gave `q=0` is refused rather than used as a last resort, and an endpoint whose every encoder is
// refused answers 406.
pub struct Encoder<O> {
    media: mime.MediaType
    encode: fn(O) -> [byte]
}

// A decoder for bodies of `media`, from the body's bytes.
pub fn decoder<I>(media: mime.MediaType, decode: fn([byte]) -> Result<I, string>) -> Decoder<I> {
    return Decoder<I> { media: media, decode: decode }
}

// A decoder for bodies of `media` that are text: the body is turned into a string first (an `Err`, so a 400, when it
// holds a NUL byte) and `decode` reads that.
pub fn text_decoder<I>(media: mime.MediaType, decode: fn(string) -> Result<I, string>) -> Decoder<I> {
    val go = decode
    return Decoder<I> {
        media: media,
        decode: fn(data: [byte]) -> Result<I, string> {
            return switch bytes_to_string(data) {
                Ok(text) { go(text) }
                Err(reason) { err(format("the body is not text ({})", reason)) }
            }
        }
    }
}

// An encoder for answers of `media`, to bytes.
pub fn encoder<O>(media: mime.MediaType, encode: fn(O) -> [byte]) -> Encoder<O> {
    return Encoder<O> { media: media, encode: encode }
}

// ---- JSON endpoints, from a `#[derive(Json)]` pair ----
//
// `#[derive(Json)]` already gives a type its `<snake_type>_to_json` and `<snake_type>_from_json`;
// these three turn one of those into the `Decoder`/`Encoder` an endpoint wants, so a typed JSON
// endpoint is one call per direction instead of a closure spelled out at every route.
//
// Promoted out of the reference backend rather than invented here: it had written `json_encoder`,
// `list_encoder` and `json_decoder` itself, and its own comment records why -- "every endpoint
// below used to spell these out, **105 times** between them", with the list form running to seven
// lines each, "which is 105 places for the media type or the JSON writing to drift apart". Any
// second JSON service would have written the same three functions, which is what makes them the
// library's job (ROADMAP.md's content-types entry, tasks.md F43).
//
// `media` is `application/json` and not an argument: an endpoint that answers some other media type
// wants `encoder`/`decoder` directly, and offering a media parameter here would only let these two
// disagree about what they are for.
pub fn json_decoder<I>(from_json: fn(Json) -> Result<I, string>) -> Decoder<I> {
    val read = from_json
    return decoder<I>(mime.application_json(), fn(data: [byte]) -> Result<I, string> {
        return switch parse_json_bytes(data) {
            // Distinguished on purpose: a body that is not JSON at all and a body that is JSON but
            // not this model are different mistakes by the caller, and only the first is worth
            // naming the parser's own message for.
            Ok(tree) { read(tree) }
            Err(message) { err(concat("malformed JSON: ", message)) }
        }
    })
}

pub fn json_encoder<O>(to_json: fn(O) -> Json) -> Encoder<O> {
    val write = to_json
    return encoder<O>(mime.application_json(), fn(value: O) -> [byte] {
        return json_to_bytes(write(value))
    })
}

// The list counterpart, which is the one worth having: written out it is a `map` into a
// `JArray` at every route that answers a collection.
pub fn json_list_encoder<O>(to_json: fn(O) -> Json) -> Encoder<[O]> {
    val write = to_json
    return encoder<[O]>(mime.application_json(), fn(items: [O]) -> [byte] {
        return json_to_bytes(Json.JArray(map<O, Json>(items, write)))
    })
}

// An encoder for answers of `media` that are text: `encode` writes a string and the encoder turns it into bytes.
pub fn text_encoder<O>(media: mime.MediaType, encode: fn(O) -> string) -> Encoder<O> {
    val go = encode
    return Encoder<O> { media: media, encode: fn(value: O) -> [byte] { return string_to_bytes(go(value)) } }
}

// The encoder the client most wants, or `None` -- a 406 -- when it wants none of them.
//
// **The client's `q` weights decide, not the order the endpoint lists its encoders in**, which is the whole
// point: an endpoint that can write `text/plain` and `text/csv` answers `Accept: text/csv, text/plain;q=0.5`
// with CSV, where listing `text_out` first used to win regardless of what the client asked for. The
// endpoint's order still breaks a tie, so it remains the server's preference among equals -- and since
// nothing is chosen at weight zero, `q=0` is a refusal rather than a last resort.
fn negotiate<O>(encoders: [Encoder<O>], req: Request) -> Option<Encoder<O>> {
    var best = Option<Encoder<O>>.None
    var best_q = 0.0
    for w in encoders {
        val q = quality(req.headers, w.media)
        if q > best_q {
            best_q = q
            best = Option<Encoder<O>>.Some(w)
        }
    }
    return best
}

// The first decoder whose media type the request's `Content-Type` is.
fn select_decoder<I>(decoders: [Decoder<I>], req: Request) -> Option<Decoder<I>> {
    if Some(sent) = content_type(req.headers) {
        for r in decoders {
            if mime.matches(r.media, sent) {
                return Option<Decoder<I>>.Some(r)
            }
        }
    }
    return Option<Decoder<I>>.None
}

fn consumed_types<I>(decoders: [Decoder<I>]) -> string {
    val names = mutable_array_new<string>()
    for r in decoders {
        mutable_array_push(names, mime.essence(r.media))
    }
    return join(separator: " or ", pieces: snapshot(names))
}

fn produced_types<O>(encoders: [Encoder<O>]) -> string {
    val names = mutable_array_new<string>()
    for w in encoders {
        mutable_array_push(names, mime.essence(w.media))
    }
    return join(separator: ", ", pieces: snapshot(names))
}

// The answer for `result`: written with `encoder` when there is one, or an empty body when the endpoint has no encoders
// (a 204, say).
fn answer<O, E>(
    result: Result<O, E>,
    encoder: Option<Encoder<O>>,
    status: int,
    failure: fn(E) -> Response
) -> Response {
    val fail = failure
    if Err(e) = result {
        return fail(e)
    }
    if Some(w) = encoder {
        val encode = w.encode
        return media_response(status, encode(unwrap(result)), w.media)
    }
    return response(status, [])
}

// Why a caller was refused before an endpoint ran: not identified (`Unauthenticated`, answered 401), identified but not
// allowed (`Forbidden`, 403), or identifying them failed for a reason that is the server's (`Failed`, 500).
pub enum Denied {
    Unauthenticated(string)
    Forbidden(string)
    Failed(string)
}

fn denied_response(d: Denied, fault: fn(int, string) -> Response) -> Response {
    return switch d {
        Unauthenticated(message) { fault(status_unauthorized, message) }
        Forbidden(message) { fault(status_forbidden, message) }
        Failed(message) { fault(status_internal_server_error, message) }
    }
}

// What an endpoint that anyone may call is given as its caller. Never seen by application code: the `public_*`
// builders adapt a `run` that does not take one.
struct Anonymous {
    anonymous: bool
}

// The `who` of every `public_*` builder: nobody is asked who they are.
fn anyone<C>(ctx: C, req: Request) -> Result<Anonymous, Denied> {
    return ok(Anonymous { anonymous: true })
}

// ---- what every endpoint of an application shares

// How an application answers what goes wrong, given once and passed to every builder below as `api:`. `failure(e)` builds
// the response for an `Err` of the endpoint's own error type `E`, and `fault(status, message)` the one for what the library
// itself rejects (400, 404, 405, 406, 415), so an application's error bodies have one shape:
// `val api = server.Api<ApiError> { failure: failure, fault: fault }`.
pub struct Api<E> {
    failure: fn(E) -> Response
    fault: fn(int, string) -> Response
}

// ---- the input kinds, each in a `secure_` form (the caller is identified first) and a `public_` one.
//
// `who(ctx, req)` identifies the caller from the request (its headers, usually) and returns a `U`, or a `Denied` that is
// answered before anything else happens: before the answer is negotiated, before the body is read. `run` then takes that
// `U` as its second argument, so an endpoint that needs a caller cannot be written without saying how to find one. A
// `public_*` builder is the explicit way to say nobody needs to be identified. `status` is the status of a successful
// answer and may be left out of a named call: it is then 200.
//
// The nine builders are the combinations of three independent choices -- a caller, an input from the path or the query,
// an input from the body -- and each is a few lines over one private `endpoint_core`, which does the steps in one order:
// identify the caller, check the body's media type (415), negotiate the answer (406), read the path or query input (400),
// decode the body (400), run. A builder cannot be one function with optional parts, because `run`'s own parameter list
// (and the type parameters behind it) differs with which parts there are.

fn no_path(params: Params) -> Result<unit, string> {
    return ok(unit)
}

fn no_query(req: Request) -> Result<unit, string> {
    return ok(unit)
}

// Every builder's one implementation. The parts an endpoint does not have are `unit`: `no_path`/`no_query` read `unit`
// from nothing, `decoders: None` means no body is read and `blank` (`Some(unit)`) is what `run` gets in its place, and
// `run` is the builder's own `run` wrapped to ignore the `unit`s. With a body, `decoders` is `Some` and `blank` `None`.
fn endpoint_core<C, U, P, Q, I, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    path: fn(Params) -> Result<P, string>,
    query: fn(Request) -> Result<Q, string>,
    decoders: Option<[Decoder<I>]>,
    blank: Option<I>,
    encoders: [Encoder<O>],
    status: int,
    run: fn(C, U, P, Q, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val fault = api.fault
    return fn(ctx: C, req: Request, params: Params) -> Response {
        val identify = who
        val caller = identify(ctx, req)
        if Err(refusal) = caller {
            return denied_response(refusal, fault)
        }
        var decoder = Option<Decoder<I>>.None
        if Some(all) = decoders {
            decoder = select_decoder<I>(all, req)
            if !is_Some(decoder) {
                return fault(
                    status_unsupported_media_type,
                    format("unsupported media type: send {}", consumed_types<I>(all))
                )
            }
        }
        val encoder = negotiate<O>(encoders, req)
        if len(encoders) > 0 && !is_Some(encoder) {
            return fault(
                status_not_acceptable,
                format("not acceptable: this route produces {}", produced_types<O>(encoders))
            )
        }
        val locate = path
        val located = locate(params)
        if Err(message) = located {
            return fault(status_bad_request, message)
        }
        val read = query
        val queried = read(req)
        if Err(message) = queried {
            return fault(status_bad_request, message)
        }
        var input = blank
        if Some(chosen) = decoder {
            val decode = chosen.decode
            val decoded = decode(req.body)
            if Err(message) = decoded {
                return fault(status_bad_request, message)
            }
            input = Option<I>.Some(unwrap(decoded))
        }
        return answer<O, E>(
            run(ctx, unwrap(caller), unwrap(located), unwrap(queried), unwrap_Some(input)),
            encoder,
            status,
            api.failure
        )
    }
}

// A secured endpoint with no input: `run(ctx, caller)` returns the answer or an error; the answer is written with the
// first of `encoders` the client's `Accept` allows, with `status`.
pub fn secure_handler<C, U, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    encoders: [Encoder<O>],
    status: Option<int>,
    run: fn(C, U) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, unit, unit, unit, O, E>(
        who: who,
        path: no_path,
        query: no_query,
        decoders: Option<[Decoder<unit>]>.None,
        blank: Option<unit>.Some(unit),
        encoders: encoders,
        status: option_unwrap_or<int>(status, 200),
        run: fn(ctx: C, caller: U, id: unit, filter: unit, input: unit) -> Result<O, E> { return go(ctx, caller) },
        api: api
    )
}

// A secured endpoint whose input is in the path: `path` turns the captured parameters into a `P` (an `Err` message is
// answered 400, so a bad id never reaches `run`), and `run(ctx, caller, input)` returns the answer or an error.
pub fn secure_path_handler<C, U, P, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    path: fn(Params) -> Result<P, string>,
    encoders: [Encoder<O>],
    status: Option<int>,
    run: fn(C, U, P) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, P, unit, unit, O, E>(
        who: who,
        path: path,
        query: no_query,
        decoders: Option<[Decoder<unit>]>.None,
        blank: Option<unit>.Some(unit),
        encoders: encoders,
        status: option_unwrap_or<int>(status, 200),
        run: fn(ctx: C, caller: U, id: P, filter: unit, input: unit) -> Result<O, E> { return go(ctx, caller, id) },
        api: api
    )
}

// A secured endpoint whose input is in the query string (`GET /things?type=x`): `query` reads what it wants from the request, for
// which `query_param` is the tool, and turns it into a `Q` (an `Err` message is answered 400, so a bad value never reaches `run`);
// `run(ctx, caller, input)` returns the answer or an error.
pub fn secure_query_handler<C, U, Q, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    query: fn(Request) -> Result<Q, string>,
    encoders: [Encoder<O>],
    status: Option<int>,
    run: fn(C, U, Q) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, unit, Q, unit, O, E>(
        who: who,
        path: no_path,
        query: query,
        decoders: Option<[Decoder<unit>]>.None,
        blank: Option<unit>.Some(unit),
        encoders: encoders,
        status: option_unwrap_or<int>(status, 200),
        run: fn(ctx: C, caller: U, id: unit, filter: Q, input: unit) -> Result<O, E> { return go(ctx, caller, filter) },
        api: api
    )
}

// A secured endpoint with a request body: it must arrive as one of `decoders`' media types (else 415), the answer is
// negotiated (else 406), the body is decoded with the decoder for its type (a failure is 400), and
// `run(ctx, caller, input)` returns the answer or an error.
pub fn secure_body_handler<C, U, I, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    decoders: [Decoder<I>],
    encoders: [Encoder<O>],
    status: Option<int>,
    run: fn(C, U, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, unit, unit, I, O, E>(
        who: who,
        path: no_path,
        query: no_query,
        decoders: Option<[Decoder<I>]>.Some(decoders),
        blank: Option<I>.None,
        encoders: encoders,
        status: option_unwrap_or<int>(status, 200),
        run: fn(ctx: C, caller: U, id: unit, filter: unit, input: I) -> Result<O, E> { return go(ctx, caller, input) },
        api: api
    )
}

// A secured endpoint with both an id in the path and a request body (a `PUT /things/{id}`): `path` decodes the parameters
// into a `P` and the body is decoded with the decoder for its media type; `run(ctx, caller, path_input, body_input)`
// returns the answer or an error. Either input failing to decode is a 400.
pub fn secure_path_body_handler<C, U, P, I, O, E>(
    who: fn(C, Request) -> Result<U, Denied>,
    path: fn(Params) -> Result<P, string>,
    decoders: [Decoder<I>],
    encoders: [Encoder<O>],
    status: Option<int>,
    run: fn(C, U, P, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return endpoint_core<C, U, P, unit, I, O, E>(
        who: who,
        path: path,
        query: no_query,
        decoders: Option<[Decoder<I>]>.Some(decoders),
        blank: Option<I>.None,
        encoders: encoders,
        status: option_unwrap_or<int>(status, 200),
        run: fn(ctx: C, caller: U, id: P, filter: unit, input: I) -> Result<O, E> { return go(ctx, caller, id, input) },
        api: api
    )
}

// A public endpoint with no input: `run(ctx)`. Anyone may call it.
pub fn public_handler<C, O, E>(
    encoders: [Encoder<O>],
    status: Option<int>,
    run: fn(C) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_handler<C, Anonymous, O, E>(
        who: anyone<C>,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, nobody: Anonymous) -> Result<O, E> { return go(ctx) },
        api: api
    )
}

// A public endpoint whose input is in the path: `run(ctx, input)`.
pub fn public_path_handler<C, P, O, E>(
    path: fn(Params) -> Result<P, string>,
    encoders: [Encoder<O>],
    status: Option<int>,
    run: fn(C, P) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_path_handler<C, Anonymous, P, O, E>(
        who: anyone<C>,
        path: path,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, nobody: Anonymous, id: P) -> Result<O, E> { return go(ctx, id) },
        api: api
    )
}

// A public endpoint with a request body: `run(ctx, input)`.
pub fn public_body_handler<C, I, O, E>(
    decoders: [Decoder<I>],
    encoders: [Encoder<O>],
    status: Option<int>,
    run: fn(C, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_body_handler<C, Anonymous, I, O, E>(
        who: anyone<C>,
        decoders: decoders,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, nobody: Anonymous, input: I) -> Result<O, E> { return go(ctx, input) },
        api: api
    )
}

// A public endpoint with both an id in the path and a request body: `run(ctx, path_input, body_input)`.
pub fn public_path_body_handler<C, P, I, O, E>(
    path: fn(Params) -> Result<P, string>,
    decoders: [Decoder<I>],
    encoders: [Encoder<O>],
    status: Option<int>,
    run: fn(C, P, I) -> Result<O, E>,
    api: Api<E>
) -> fn(C, Request, Params) -> Response {
    val go = run
    return secure_path_body_handler<C, Anonymous, P, I, O, E>(
        who: anyone<C>,
        path: path,
        decoders: decoders,
        encoders: encoders,
        status: status,
        run: fn(ctx: C, nobody: Anonymous, id: P, input: I) -> Result<O, E> { return go(ctx, id, input) },
        api: api
    )
}

// A table of endpoints compiled for dispatching: each pattern split once, and the endpoints grouped by method
// and number of path segments (in the order they were given) so a request only meets the ones that could match.
// Build it once with `routes`.
pub struct Routes<C> {
    endpoints: [Endpoint<C>]
    patterns: [Pattern]
    by_method: Map<string, [int]>
    by_length: Map<int, [int]>
    // Whether `dispatch` records a metric per request. Set by `metered_routes`, not by `routes`:
    // the matched pattern is known here and nowhere else, which is the one label worth having and
    // the reason this lives on the table rather than in `ServeOptions`.
    meter: bool
}

// Caps how many malloc arenas glibc will create, unless `MALLOC_ARENA_MAX` is already set in the
// environment, in which case the operator has decided and this leaves it alone. See
// src/native_http.c for the measurements; the short version is that this server is
// thread-per-connection, a password hash asks OpenSSL for a ~19 MiB buffer, and glibc keeps that
// buffer in the arena of whichever thread allocated it -- so every connection that ever
// authenticated left 19 MiB behind. 48 registrations at 16 concurrent grew resident memory by
// 307 MB; capped from here, 136 MB. `MALLOC_ARENA_MAX=1` in the environment reaches 98 MB, because
// glibc reads that at the process's first allocation while this can only bound arenas made after
// `serve` starts -- which is why an operator's setting wins and is worth keeping as the documented
// way to go further.
native fn bound_malloc_arenas(n: int) -> bool

// ---------------------------------------------------------------- rate limiting

native fn rate_allow_raw(bucket: string, key: string, limit: int, window_seconds: int, now_seconds: int) -> bool

native fn rate_reset_raw()

native fn conn_acquire_raw(key: string, limit: int) -> bool

native fn conn_release_raw(key: string)

native fn conn_count_raw(key: string) -> int

// Whether this event is within `limit` for `key` in the last `window_seconds` -- and asking counts it,
// so ask exactly once per event. `bucket` separates unrelated limits that share a key: `"login"` and
// `"register"` keyed by the same address are two allowances, not one.
//
// What it is for: making an unauthenticated flood expensive. Per-account lockout already covers a
// password guessed at one account (and throttles the email tried whether or not the account exists);
// what it cannot cover is volume from one source against many accounts, or against an endpoint that
// does real work for an anonymous caller -- registration above all, which asks OpenSSL for a ~19 MiB
// Argon2id buffer before it knows who is asking (B10).
//
// Fixed window, not a token bucket: a client can spend its whole allowance at the end of one window
// and again at the start of the next, so the honest worst case is twice `limit` over a window's width.
// That is stated rather than hidden because it is the kind of thing a reader should not have to derive.
//
// At most 4096 distinct keys are tracked at once. Past that, an entry whose window has expired is
// reused, and failing that the oldest window is replaced -- so a determined flood can push a
// legitimate caller's count out and hand them a fresh allowance. That is a bounded loss of accuracy,
// chosen over refusing everyone (a denial of service) or allowing everyone (no protection at all);
// src/native_http.c says why at more length.
pub fn rate_allow(bucket: string, key: string, limit: int, window_seconds: int) -> bool {
    return rate_allow_at(bucket, key, limit, window_seconds, clock.monotonic_millis() / 1000)
}

// `rate_allow` with the clock supplied, the same way `jwt.verify_at` takes the time rather than reading
// it. A test can then show a window expiring without waiting for one, and a caller with its own idea of
// now -- a replayed log, a simulation -- can use that instead. `now_seconds` must not go backwards for a
// given key: a window is "has `now` passed `window_start + window_seconds`", so a clock that jumps back
// extends the current window rather than opening a new one.
pub fn rate_allow_at(bucket: string, key: string, limit: int, window_seconds: int, now_seconds: int) -> bool {
    return rate_allow_raw(bucket, key, limit, window_seconds, now_seconds)
}

// Forgets every counter. For a test that wants a known starting point -- a server calling this would
// hand every client a fresh allowance.
pub fn rate_reset() {
    rate_reset_raw()
}

// How many connections `address` holds open right now. For a test; a server has no reason to ask.
pub fn open_connections_of(address: string) -> int {
    return conn_count_raw(address)
}

// The address to rate-limit a request by, for a server that sits behind proxies **it owns**.
//
// `trusted_hops` is how many proxies of your own are in front of this server. Read it that way and
// nothing else: the function takes the entry that many places from the *right* of `X-Forwarded-For`,
// because each proxy appends the address it saw and only the rightmost entries were written by
// machines you control. Everything to the left of those was supplied by the client, which can write
// whatever it likes there.
//
// So `trusted_hops: 0` returns `req.peer` and ignores the header entirely, which is the right answer
// when nothing is in front. `trusted_hops: 1` behind one proxy of yours returns the address that proxy
// saw. Getting the number too *high* is the dangerous direction: it starts trusting entries the client
// wrote, which is how a rate limit becomes decoration. Too low merely limits the proxy instead of the
// client, which is visible immediately.
//
// There is no default and no auto-detection on purpose. A library cannot know what is in front of a
// server, and guessing would mean every deployment that is *not* behind a proxy accepts a header its
// clients control.
pub fn forwarded_for(req: Request, trusted_hops: int) -> Option<string> {
    if trusted_hops < 1 {
        return req.peer
    }
    val hops = mutable_array_new<string>()
    for h in req.headers {
        if equals_ignore_case(h.name, "X-Forwarded-For") {
            for part in split(h.value, ",") {
                val trimmed = trim(part)
                if trimmed != "" {
                    mutable_array_push(hops, trimmed)
                }
            }
        }
    }
    val list = snapshot(hops)
    // The transport peer is the last hop of all: it is the proxy that actually connected here, and it
    // never appears in the header it wrote.
    val index = len(list) - trusted_hops
    if index < 0 || len(list) == 0 {
        // Fewer entries than hops claimed: the request did not come through the chain this server was
        // told to expect, so the only address that is certainly not forged is the one on the socket.
        return req.peer
    }
    return Some(list[index])
}

// ---------------------------------------------------------------- metrics

val requests_metric = "http_requests_total"
val latency_metric = "http_request_seconds"
val connections_metric = "http_open_connections"
val received_metric = "http_received_bytes_total"
val sent_metric = "http_sent_bytes_total"

// Declares what `metered_routes` and `ServeOptions.metrics` record. Calling it again is a no-op, so
// an application that wants the names documented before any request may call it itself.
//
// The latency buckets are seconds, by Prometheus convention. Note the resolution they are measured
// at: `clock.monotonic_millis` is the finest clock Ziman has, so every request faster than a
// millisecond lands in the first bucket and a latency histogram cannot tell 100us from 900us. For
// a handler doing real work that is unimportant; for one answering from memory it means the
// histogram says "fast" and nothing finer.
pub fn declare_metrics() {
    val _ = metrics.counter(requests_metric, "Requests answered, by method, matched route and status.")
    val _ = metrics.histogram(
        latency_metric,
        "How long a request took, in seconds, by method and matched route.",
        [0.001, 0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0]
    )
    val _ = metrics.gauge(connections_metric, "Connections being served right now.")
    val _ = metrics.counter(received_metric, "Request bytes read.")
    val _ = metrics.counter(sent_metric, "Response bytes written.")
}

// The label key for one request. Built by hand rather than through `metrics.series`, which sorts
// and escapes: these three values are a method name, a route pattern and a status, none of which can
// contain a quote, a backslash or a newline, and the names are already in increasing order.
//
// `route` is the *matched pattern*, never the request's path. A path carries ids, so labelling by it
// would grow the registry until the series cap dropped everything after the first 128 -- which is
// the usual way a metrics integration takes a service down. A request that matched nothing is
// labelled `<unmatched>` for the same reason.
// Everything recorded so far, as the body of a `/metrics` endpoint -- the content type Prometheus
// expects, and the version it has used since 0.0.4. Mount it in one line:
//
//     server.Endpoint<Ctx> { method: HttpMethod.Get, pattern: "/metrics", handler: server.metrics_handler<Ctx> }
//
// Nothing here restricts who may read it. A metrics page tells a reader the shape of your traffic
// and which routes exist, so put it behind the same `who` as the rest of an internal API, or on a
// listener that only your network can reach.
pub fn metrics_response() -> Response {
    // Samples the runtime's own gauges first, so a scrape carries the collector's heap and
    // collection count, the thread count and the open descriptors alongside the application's own
    // numbers without every application remembering to ask (ROADMAP.md's metrics item 3). This is
    // what Prometheus' own client libraries do with their process and GC collectors. An application
    // that does not want them can render `metrics.render()` itself.
    metrics.record_runtime()
    return with_header(
        response(status_ok, string_to_bytes(metrics.render())),
        "Content-Type",
        "text/plain; version=0.0.4; charset=utf-8"
    )
}

pub fn metrics_handler<C>(ctx: C, req: Request, params: Params) -> Response {
    return metrics_response()
}

fn request_key(method: HttpMethod, route: string, status: int) -> string {
    return concat(
        "method=\"",
        method_name(method),
        "\",route=\"",
        route,
        "\",status=\"",
        str(status),
        "\""
    )
}

fn latency_key(method: HttpMethod, route: string) -> string {
    return concat("method=\"", method_name(method), "\",route=\"", route, "\"")
}

fn connection_closed(meter: bool) {
    if meter {
        metrics.gauge_add(connections_metric, -1.0)
    }
}

fn record_request(method: HttpMethod, route: string, status: int, millis: int) {
    metrics.increment_at(metrics.series_of(key_name: requests_metric, key: request_key(method, route, status)))
    metrics.observe_at(
        metrics.series_of(key_name: latency_metric, key: latency_key(method, route)),
        (millis as float) / 1000.0
    )
}

fn method_key(m: HttpMethod, length: int) -> string {
    return format("{} {}", method_name(m), length)
}

// Compiles `endpoints` for `dispatch`. Do it once, at start-up (a module-level `val`), not per request. The order
// is what `dispatch` tries them in: the first endpoint that matches wins, so a `/items/{id}` listed before
// `/items/new` answers for `/items/new`.
fn routes_with<C>(endpoints: [Endpoint<C>], meter: bool) -> Routes<C> {
    val patterns = mutable_array_new<Pattern>()
    val methods = mutable_map_new<string, [int]>()
    val lengths = mutable_map_new<int, [int]>()
    val none: [int] = []
    var i = 0
    for e in endpoints {
        val p = compile_pattern(e.pattern)
        mutable_array_push(patterns, p)
        val key = method_key(e.method, len(p.parts))
        set(
            methods,
            key,
            push(option_unwrap_or<[int]>(get(methods, key), none), i)
        )
        set(
            lengths,
            len(p.parts),
            push(option_unwrap_or<[int]>(get(lengths, len(p.parts)), none), i)
        )
        i = i + 1
    }
    return Routes<C> {
        meter: meter,
        endpoints: endpoints,
        patterns: snapshot(patterns),
        by_method: snapshot(methods),
        by_length: snapshot(lengths)
    }
}

pub fn routes<C>(endpoints: [Endpoint<C>]) -> Routes<C> {
    return routes_with<C>(endpoints, false)
}

// `routes`, and `dispatch` on the result records `http_requests_total` and `http_request_seconds`
// for every request, labelled with the method, the pattern that matched and the status. One line to
// turn on, and the pattern is a label only something that did the matching can supply.
pub fn metered_routes<C>(endpoints: [Endpoint<C>]) -> Routes<C> {
    declare_metrics()
    return routes_with<C>(endpoints, true)
}

// ------------------------------------------------------------ CORS
//
// Browser-facing servers all write the same thirty lines: answer the preflight, and put
// `Access-Control-Allow-Origin` on everything else -- but only for an origin on the list, because a
// wildcard with credentials is the one combination browsers refuse outright. These two functions are that,
// generalised from the reference backend's own `route_cors`.
//
// Two functions rather than one wrapper taking a handler: a wrapper would have to return a closure and
// allocate one per request, and this composes with anything -- `dispatch`, a hand-written router, a static
// file handler -- by sitting either side of it.

// Which origins may see an answer, and what a preflight is told the browser may then send. `allowed_origins`
// is matched exactly; a single `"*"` allows any origin, which is only sound without credentials (a browser
// rejects `*` together with `Access-Control-Allow-Credentials`, so `allow_credentials` is ignored then).
pub struct CorsPolicy {
    allowed_origins: [string]
    allowed_methods: string
    allowed_headers: string
    max_age_seconds: int
    allow_credentials: bool
}

// A policy for `origins` with the defaults a JSON API wants: the usual methods, `Authorization` and
// `Content-Type` when the browser does not say which headers it needs, a one-hour preflight cache, and
// credentials allowed. Override what differs with `with`.
pub fn cors_policy(origins: [string]) -> CorsPolicy {
    return CorsPolicy {
        allowed_origins: origins,
        allowed_methods: "GET, POST, PUT, PATCH, DELETE, OPTIONS",
        allowed_headers: "Authorization, Content-Type",
        max_age_seconds: 3600,
        allow_credentials: true
    }
}

// `Vary: Origin`, unless the policy is a wildcard and so genuinely does not depend on the origin.
// One function rather than the same `if` in two places, because the preflight refusal and the
// ordinary answer must not drift apart on this.
fn cors_vary(policy: CorsPolicy, answer: Response) -> Response {
    if cors_wildcard(policy) {
        return answer
    }
    return with_header(answer, "Vary", "Origin")
}

fn cors_origin_allowed(policy: CorsPolicy, origin: string) -> bool {
    for allowed in policy.allowed_origins {
        if allowed == "*" || allowed == origin {
            return true
        }
    }
    return false
}

fn cors_wildcard(policy: CorsPolicy) -> bool {
    for allowed in policy.allowed_origins {
        if allowed == "*" {
            return true
        }
    }
    return false
}

// The answer to a browser's preflight (`OPTIONS` carrying `Access-Control-Request-Method`), or None when
// `req` is not one and should be routed normally. A preflight from an origin not on the list is
// `fault(403, ...)` rather than a bare rejection, so it looks like every other refusal this server makes.
pub fn cors_preflight(policy: CorsPolicy, req: Request, fault: fn(int, string) -> Response) -> Option<Response> {
    val origin = switch header(req, "Origin") {
        Some(value) { value }
        None { return None }
    }
    if !HttpMethod.is_Options(req.method) || Option.is_None(header(req, "Access-Control-Request-Method")) {
        return None
    }
    if !cors_origin_allowed(policy, origin) {
        // The refusal varies by origin too -- this same request from an allowed origin is a 204 --
        // so it carries `Vary: Origin` like every other answer here, which is what stops a shared
        // cache serving this 403 to an origin that should have been allowed.
        return Some(cors_vary(policy, fault(status_forbidden, "Invalid CORS request")))
    }
    val requested = switch header(req, "Access-Control-Request-Headers") {
        Some(value) { value }
        None { policy.allowed_headers }
    }
    val answer = with_header(
        with_header(
            with_header(response(status_no_content, []), "Access-Control-Allow-Methods", policy.allowed_methods),
            "Access-Control-Allow-Headers",
            requested
        ),
        "Access-Control-Max-Age",
        str(policy.max_age_seconds)
    )
    return Some(cors_apply(policy, req, answer))
}

// `answer` with the CORS headers a browser needs to hand it to the page, when the request carried an `Origin`
// on the list. Without an `Origin`, or from an origin not on it, `answer` is returned untouched -- which is
// what makes the browser withhold it, and is the whole mechanism: a server does not refuse the request, it
// declines to say the answer may be read.
pub fn cors_apply(policy: CorsPolicy, req: Request, answer: Response) -> Response {
    // `Vary: Origin` on every answer this touches, not only the ones that end up carrying
    // `Access-Control-Allow-Origin` -- because whether that header is there *is* what varies by
    // origin, so a shared cache that stores one answer and serves it to a different origin is wrong
    // either way: it can hand an allowed origin's `Access-Control-Allow-Origin` to a page that must
    // not see the answer (the hazard worth caring about), or hand a cached refusal to an origin that
    // should have been allowed. Omitted only for a wildcard policy, where the answer genuinely does
    // not depend on the origin.
    //
    // Appended rather than replacing any `Vary` the handler already set: several `Vary` fields mean
    // the same thing as one comma-joined list, so this composes with a handler that varies on
    // `Accept-Encoding` without having to know about it.
    //
    // The reference backend's own `route_cors` set this header; the first generalisation of that
    // code into this module dropped it, and nothing noticed because the backend went on running its
    // own copy (tasks.md F59).
    val varied = cors_vary(policy, answer)
    val origin = switch header(req, "Origin") {
        Some(value) { value }
        None { return varied }
    }
    if !cors_origin_allowed(policy, origin) {
        return varied
    }
    // `*` is echoed as `*`, not as the origin: echoing turns a public API into one that looks
    // origin-specific, and a browser will not accept `*` with credentials anyway.
    val allow = if cors_wildcard(policy) { "*" } else { origin }
    val with_origin = with_header(varied, "Access-Control-Allow-Origin", allow)
    if policy.allow_credentials && !cors_wildcard(policy) {
        return with_header(with_origin, "Access-Control-Allow-Credentials", "true")
    }
    return with_origin
}

// Calls the handler of the first endpoint whose method and pattern match `req`. When none does, the answer is
// `fault(404, ...)`, or `fault(405, ...)` with an `Allow` header when the path exists under another method.
//
// A `HEAD` that matches nothing is tried again as `GET`, since RFC 9110 makes HEAD a GET without a body and a
// path serving GET has to serve HEAD; the GET handler's body comes back as usual and `write_response` withholds
// it on the wire while keeping the `Content-Length` it would have had. `Allow` therefore names HEAD wherever
// GET is served.
pub fn dispatch<C>(table: Routes<C>, ctx: C, req: Request, fault: fn(int, string) -> Response) -> Response {
    if table.meter {
        // Timed and counted around the same work, so every exit -- a handler, the HEAD fallback, a
        // 405, a 404 -- is recorded exactly once. `dispatch_inner` is the whole of what this used to
        // be; nothing is recorded when a table is not metered, not even the clock read.
        val start = clock.monotonic_millis()
        val answer = dispatch_inner<C>(table, ctx, req, fault)
        record_request(
            req.method,
            matched_pattern<C>(table, req),
            answer.status,
            clock.monotonic_millis() - start
        )
        return answer
    }
    return dispatch_inner<C>(table, ctx, req, fault)
}

// The pattern a request matched, as a label: the registered pattern itself, or `<unmatched>` when
// nothing took it. Never the request's path, which carries ids and would grow the registry past its
// series cap. This repeats `dispatch_inner`'s matching rather than threading a value out of it,
// which costs one more walk of a short list on a metered table only, and keeps the matching in one
// place instead of two that could disagree about what `{id}` matched.
fn matched_pattern<C>(table: Routes<C>, req: Request) -> string {
    val got = segments_of(req.path)
    val none: [int] = []
    for i in get_or(table.by_method, method_key(req.method, len(got)), none) {
        if table.endpoints[i].method == req.method {
            if Option.is_Some(capture(table.patterns[i], got)) {
                return table.endpoints[i].pattern
            }
        }
    }
    if HttpMethod.is_Head(req.method) {
        for i in get_or(table.by_method, method_key(HttpMethod.Get, len(got)), none) {
            if HttpMethod.is_Get(table.endpoints[i].method) {
                if Option.is_Some(capture(table.patterns[i], got)) {
                    return table.endpoints[i].pattern
                }
            }
        }
    }
    return "<unmatched>"
}

fn dispatch_inner<C>(table: Routes<C>, ctx: C, req: Request, fault: fn(int, string) -> Response) -> Response {
    val got = segments_of(req.path)
    val none: [int] = []
    for i in get_or(table.by_method, method_key(req.method, len(got)), none) {
        val e = table.endpoints[i]
        if e.method == req.method {
            if Some(params) = capture(table.patterns[i], got) {
                val h = e.handler
                return h(ctx, req, params)
            }
        }
    }
    // No route took it as the method asked for. HEAD is the one method that must still be answered: RFC 9110
    // makes it GET without a body, so a server that serves GET on a path has to serve HEAD on it too, and
    // answering 405 there breaks caches and link checkers that use HEAD to ask whether a resource exists. The
    // GET handler runs and returns its body as usual -- `write_response` withholds it for a HEAD request while
    // still writing the `Content-Length` the body would have had, which is what RFC 9110 asks for, so there is
    // nothing to strip here. The exact-method loop above ran first, so an application that registers its own
    // HEAD route keeps it.
    if HttpMethod.is_Head(req.method) {
        for i in get_or(table.by_method, method_key(HttpMethod.Get, len(got)), none) {
            val e = table.endpoints[i]
            if HttpMethod.is_Get(e.method) {
                if Some(params) = capture(table.patterns[i], got) {
                    val h = e.handler
                    return h(ctx, req, params)
                }
            }
        }
    }
    val allowed = mutable_array_new<string>()
    var serves_get = false
    var serves_head = false
    for i in get_or(table.by_length, len(got), none) {
        if Option.is_Some(capture(table.patterns[i], got)) {
            val m = table.endpoints[i].method
            mutable_array_push(allowed, method_name(m))
            if HttpMethod.is_Get(m) { serves_get = true }
            if HttpMethod.is_Head(m) { serves_head = true }
        }
    }
    // `Allow` has to name HEAD when the path serves GET, because the fallback above means it really is allowed;
    // listing only GET would tell a client the opposite of what the server does.
    if serves_get && !serves_head {
        mutable_array_push(allowed, "HEAD")
    }
    val methods = snapshot(allowed)
    val unmatched = if len(methods) > 0 { method_not_allowed(methods) } else { not_found() }
    val message = if unmatched.status == status_method_not_allowed { "method not allowed" } else { "not found" }
    val reply = fault(unmatched.status, message)
    val allow = header_value(unmatched.headers, "Allow")
    return switch allow {
        Some(names) { with_header(reply, "Allow", names) }
        None { reply }
    }
}

// ------------------------------------------------------------------- serve
//
// The accept loop and the per-connection request loop, so an application only
// supplies its handler. A handler is a *function value*: a named function, or a
// lambda that captures what it needs (a database connection, a configuration):
//
//     server.serve(listener, fn(req) { route(conn, req) }, options)
//
// One thread per connection, at most `max_connections` at once (the limit is a
// channel used as a counting semaphore: a client past it waits in the kernel's
// accept queue). `serve` returns when a shutdown has been requested
// (`os.install_shutdown_handler()` makes SIGINT/SIGTERM do that) and every
// connection already being served has finished -- an idle keep-alive
// connection ends at `idle_timeout_ms` at the latest. It does not close the
// listener or install the signal handler; the caller owns both.
//
// `idle_timeout_ms` is how long a client may take over anything else: a keep-alive connection waiting for its next request, a body, a
// stalled read. `header_timeout_ms` (use a few seconds; it should not exceed `idle_timeout_ms`) is how long a new connection may take to send its first byte, and any
// request to send its head once it has begun: an honest client needs milliseconds, so a client that opens connections and dawdles is dropped fast and cannot hold
// every one of the `max_connections` slots for `idle_timeout_ms` at a time. It cannot tell one client from another, so a determined flood from many
// addresses is a job for a firewall or the proxy in front (see the roadmap).
// One finished exchange, for `ServeOptions.on_request`.
//
// A struct rather than a handful of parameters **because the library builds it and the application
// only reads it**: a field added here later cannot break a caller, which is the opposite of the
// `ServeOptions` literal problem F61 ran into, where every field of a struct the *caller* builds is
// required. So this is a shape that can grow.
//
// `duration_ms` is the time to *serve*: from the request being fully read to its response being
// written. It deliberately excludes the client's own slowness in sending and the idle wait on a
// keep-alive connection, neither of which is work this server did -- a log line blaming the server
// for a client typing slowly would be worse than no line at all.
//
// `response_bytes` is the body's size, which is what a `HEAD` request reports without sending, and
// is measured *after* `compressed` has had its say, so it is what went on the wire.
//
// `peer` is the transport address, `None` on a request that did not come off a socket. It is not
// `X-Forwarded-For`, which is `forwarded_for`'s job and a different question.
pub struct RequestLog {
    method: HttpMethod
    target: string
    status: int
    duration_ms: int
    response_bytes: int
    peer: Option<string>
}

pub struct ServeOptions {
    idle_timeout_ms: int
    header_timeout_ms: int
    // The most requests served at once -- not the most clients connected. A connection holds one
    // of these only while it is actually serving a request; between requests it is parked with the
    // poller and holds nothing, so a server can hold far more keep-alive clients than this number
    // (`net.wait_readable`, and `park_loop` below).
    //
    // It used to mean the other thing, and the difference is worth knowing if you are carrying a
    // size forward: a connection held a slot for its whole life, so under keep-alive an occupant
    // kept one through `idle_timeout_ms` of doing nothing and a 65th client against a cap of 64
    // waited for a *timeout* rather than for a request. 256 keep-alive clients against a cap of 64
    // took one full idle timeout whatever the request count -- 31.5s -- where they now take
    // 1.5-2.0s and a cap of 64 measures the same as a cap of 256 (docs/reviews/tasks.md F139).
    //
    // So size it by the concurrency of *work* you want to admit, which is what a thread-per-request
    // server can usefully run at once, and let the client count follow from sockets.
    max_connections: int
    log_requests: bool
    // The largest request body to accept, or 0 for the library's 1 MiB default. A body over it is
    // refused with 413 before the handler is reached, and the limit applies to what arrives on the
    // wire -- the encoded body, `multipart` boundaries included.
    max_body_bytes: int
    // How to render a rejection the server makes before the handler is ever reached -- a 400 for a malformed
    // request line, a 408 when the client stops mid-request, a 413 for too large a body, a 431 for too large a
    // header block, a 501 for a method the parser will not take. `None` uses the library's own JSON shape.
    //
    // Pass the same renderer the application gives `dispatch`, and a client sees one error shape from the whole
    // server instead of two: a browser that cannot read the body of its own 413 because it arrived in a
    // different shape with none of the application's headers is the reason this exists. Whatever it returns is
    // written as-is, so an HSTS header it adds is on the rejection too.
    //
    // It gets a status and a sentence, not the Request: these failures happen while the request is being read,
    // so there may be no parsed request to pass -- which is also why a per-request header like
    // `Access-Control-Allow-Origin` cannot be set here, there being no `Origin` to answer.
    fault: Option<fn(int, string) -> Response>
    // Called once per finished exchange, with everything the server knows about it. This is the
    // composable half of request logging: `log_requests` gives the library's one fixed line, and
    // this gives the application the fields to write its own -- through the `log` module, as JSON,
    // with a request id, or wherever its logs actually go. The two are independent; setting both
    // prints the built-in line *and* calls this.
    //
    // A field on the options, not a wrapper around `dispatch` as the roadmap first imagined: a
    // wrapper would have to return a closure and allocate one per request, which is the same reason
    // the CORS pair is two plain functions (tasks.md F59). One function value is stored here once.
    //
    // **Only completed exchanges.** A request the server rejects before parsing one -- a malformed
    // request line, a client that stops mid-head, a body over the cap -- never reaches this, because
    // there is no request to describe; the same reason `fault` above takes a status and a sentence
    // rather than a `Request`. Those rejections are `fault`'s to render.
    //
    // Typed `fn(RequestLog)` and not `fn(RequestLog) -> unit`: a void function's type *is* the
    // former, so an application writes `fn note(entry: RequestLog) { ... }` and passes it, with no
    // `-> unit` to remember. This is the library's first callback that returns nothing, so the
    // spelling is set here.
    on_request: Option<fn(RequestLog)>
    // Whether to record `http_open_connections` and the two byte counters. Per-request metrics are
    // separate, on the route table (`metered_routes`), because only something that matched the request
    // knows the pattern to label it with -- and a pattern is the only label worth having.
    metrics: bool
    // Gzip a response when the client offers it and the body is at least 1 KiB -- see `compressed`,
    // which this simply turns on. Off by default on purpose: compressing a response that carries a
    // secret alongside attacker-influenced text leaks it through the length (BREACH), and an API
    // whose login answer holds a JWT is that shape. Ask for it per server rather than inheriting it.
    compress_responses: bool
    // How many connections one address may hold at once. 0 is off, and is the default a server should keep
    // unless it is reached directly by clients: behind a reverse proxy every connection carries the
    // proxy's address, so any cap would be a cap on the proxy.
    //
    // This is the half a request throttle cannot cover. A client that opens connections and never sends a
    // request is counted by no rate limit, and can fill every `max_connections` slot;
    // `header_timeout_ms` frees such a slot within seconds, which bounds how long the flood holds one, not
    // how many it holds at once. A refusal here closes the socket without writing anything -- answering
    // would mean writing to a flooding client from the accept loop, where one slow read stalls every other
    // connection's accept.
    //
    // The address is the socket's, necessarily: at accept time there is no request yet, so there is no
    // `X-Forwarded-For` to consult even if it were trustworthy. That is the same reason the default is off.
    max_connections_per_client: int
}

// What a connection's thread does when a runtime error in the handler (or anywhere in the thread) ends it: the error goes to stderr, and the client is answered
// `500` with a generic body, as best it can be (the connection may be half way through a response) -- nothing about the error reaches the client. The thread's
// own deferred calls (giving its slot back, closing the socket) run after this, and the server goes on serving everyone else.
// A connection the poller is holding: everything about it that outlives a single request, which is
// more than the socket. `client_key` is what the per-client cap counted it under and must be
// released exactly once; `deadline_ms` is when an idle connection has waited long enough.
struct Parked {
    session: Session
    client_key: string
    deadline_ms: int
}

// What one burst of serving answers: the connection as it now stands, and whether it should stay
// open. Two values, so a struct -- `open` cannot be folded into the session, since a connection
// that must close still has one.
struct Served {
    conn: Parked
    open: bool
}

fn fail_connection(sock: Socket, message: string) {
    os.write_stderr(format(
        "ziman: {}\nziman: a request handler failed; the client is answered 500 and the server goes on\n",
        message
    ))
    val body = "{\"status\":500,\"message\":\"An unexpected error occurred\"}"
    val head = format(
        "HTTP/1.1 500 Internal Server Error\r\nContent-Type: application/json\r\nX-Content-Type-Options: nosniff\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
        len(body)
    )
    val _ = net.write_text(sock, concat(head, body))
}

// The key a connection is counted under: its address, or "" when the cap is off. Empty rather than an
// Option so `serve_connection`'s release is unconditional -- a `defer` that has to ask whether to run is
// how a release gets skipped on the path nobody tested.
fn connection_key(sock: Socket, limit: int) -> string {
    if limit < 1 {
        return ""
    }
    return option_unwrap_or<string>(net.peer_address(sock), "")
}

// One burst of serving on a connection the poller handed over: requests are served while the next
// one is already buffered, and the moment nothing more is there this returns rather than blocking
// on a read. That return is the whole point -- a connection waiting for its next keep-alive request
// goes back to the poller and costs no thread, where this function used to sit in `read_request`
// holding one for up to `idle_timeout_ms` (docs/reviews/tasks.md F139).
//
// Draining the buffer before returning is not an optimisation but a correctness requirement: a
// pipelined request is already *in* the session's buffer, so a connection parked with bytes pending
// would wait for the socket to become readable again and might wait forever.
fn serve_burst(
    start: Parked,
    handler: fn(Request) -> Response,
    log_requests: bool,
    compress_responses: bool,
    fault: Option<fn(int, string) -> Response>,
    on_request: Option<fn(RequestLog)>,
    meter: bool
) -> Served {
    var conn = start
    var sock = conn.session.sock
    var session = conn.session
    var open = true
    while open {
        val next = read_request(session)
        if Err(e) = next {
            val _ = write_error_with(sock, e, fault)  // 400/408/413/431/501, or nothing if the peer is gone
            open = false
        } else {
            val exchange = unwrap(next)
            session = exchange.session  // carries any bytes read past this request
            // The clock starts once the request is *read*, so the idle wait on a keep-alive
            // connection and a client that drips its request are not counted as time this server
            // spent. What is left is the work: the handler, and writing the answer.
            val serve_started = clock.monotonic_millis()
            if meter {
                metrics.add(received_metric, (len(exchange.request.body) as float))
            }
            val response = handler(exchange.request)
            if meter {
                metrics.add(sent_metric, (len(response.body) as float))
            }
            // 1 KiB: below a packet's worth there is nothing to win, and gzip's own 18-byte
            // header plus a short body can come out larger -- which `compressed` checks anyway.
            val to_send = if compress_responses {
                compressed(exchange.request, response, 1024)
            } else {
                response
            }
            switch write_response(sock, exchange.request, to_send) {
                Ok(k) {
                    if !k {
                        open = false
                    }
                }
                Err(_) { open = false }
            }
            // Reported after the write, not before it: only here are the status and the bytes that
            // actually went out both known, `compressed` having possibly replaced the body. The
            // built-in line and the hook describe the same completed exchange, so neither can
            // disagree with the other about what happened.
            if log_requests {
                printf(
                    "{} {} -> {}\n",
                    method_name(exchange.request.method),
                    exchange.request.target,
                    to_send.status
                )
            }
            if Some(report) = on_request {
                report(RequestLog {
                    method: exchange.request.method,
                    target: exchange.request.target,
                    status: to_send.status,
                    duration_ms: clock.monotonic_millis() - serve_started,
                    response_bytes: len(to_send.body),
                    peer: exchange.request.peer
                })
            }
        }
        // Nothing more is buffered. Before giving the connection back to the poller, wait a
        // moment to see whether the next request is already on its way -- which on a keep-alive
        // connection doing back-to-back requests it almost always is.
        //
        // This is what keeps the parking cheap. Handing every request through the poller costs a
        // thread spawn and two channel hops, and paying that per *request* rather than per
        // *connection* measured at 9,876 -> 3,000 rps on 256 keep-alive clients. A few
        // milliseconds of grace amortises it back across a busy connection's requests while a
        // connection that is genuinely idle still parks and still costs no thread.
        //
        // `wait_readable` rather than a short read: a read that times out is indistinguishable
        // from a client that stalled mid-request, and `read_request` would answer that with a 408.
        // Peeking asks the question without consuming anything or deciding anything.
        if open && len(session.buffer) == 0 {
            if len(net.wait_readable([sock], keepalive_grace_ms)) == 0 {
                return Served { conn: with conn { session: session }, open: true }
            }
        }
    }
    return Served { conn: with conn { session: session }, open: false }
}

// A worker: holds one of `slots` for exactly as long as it is serving, which is what makes
// `max_connections` a limit on concurrent *requests* rather than on connected clients. Parks the
// connection back with the poller when it stays open, and owns closing it when it does not --
// including the per-client release and the gauge, each of which must happen once per connection and
// so cannot live in `serve_burst`, which may run many times for one connection.
fn worker(
    conn: Parked,
    handler: fn(Request) -> Response,
    returns: Channel<Parked>,
    slots: Channel<int>,
    idle_timeout_ms: int,
    log_requests: bool,
    compress_responses: bool,
    fault: Option<fn(int, string) -> Response>,
    on_request: Option<fn(RequestLog)>,
    meter: bool
) {
    defer send(slots, 1)
    val served = serve_burst(conn, handler, log_requests, compress_responses, fault, on_request, meter)
    if served.open {
        send(returns, with served.conn { deadline_ms: clock.monotonic_millis() + idle_timeout_ms })
        return
    }
    net.close(served.conn.session.sock)
    conn_release_raw(served.conn.client_key)
    connection_closed(meter)
}

// The poller, and the reason `serve` can now hold more connections than it has threads: it owns
// every parked connection and spends a thread on one only when a request has actually arrived.
//
// It owns them because it must: `parked` is a `MutableArray`, which is `#[thread_bound]`, so one
// thread has to be the single place connections live. Workers hand them over on `returns`, which
// is also what keeps this loop from having to lock anything. A *newly accepted* connection never
// comes here -- see the accept loop for why.
//
// Three things are checked every cycle, in this order. Connections that have waited past their
// deadline are closed -- that is where `idle_timeout_ms` is now enforced, rather than inside a
// blocking read. Connections whose next request is already buffered are ready without asking the
// socket at all. And the rest are handed to `net.wait_readable` in a bounded slice, so a shutdown
// is noticed between slices exactly as `accept` manages underneath.
//
// A slot is taken with `try_receive`, never `receive`: blocking here would stop the poller
// reaping idle connections while every slot was busy, which is the failure this whole change is
// about. A connection that finds no slot simply stays parked and is tried again next cycle.
fn park_loop(
    returns: Channel<Parked>,
    slots: Channel<int>,
    handler: fn(Request) -> Response,
    idle_timeout_ms: int,
    log_requests: bool,
    compress_responses: bool,
    fault: Option<fn(int, string) -> Response>,
    on_request: Option<fn(RequestLog)>,
    meter: bool
) {
    val parked = mutable_array_new<Parked>()
    var running = true
    while running {
        var taking = true
        while taking {
            switch try_receive(returns) {
                Some(c) { mutable_array_push(parked, c) }
                None { taking = false }
            }
        }
        if os.shutdown_requested() && len(parked) == 0 {
            running = false
        }
        val now = clock.monotonic_millis()
        // Highest index first, so removing one does not shift the next one being examined.
        var i = len(parked) - 1
        while i >= 0 {
            val c = mutable_array_get(parked, i)
            val buffered = len(c.session.buffer) > 0
            val expired = now >= c.deadline_ms
            if expired && !buffered {
                mutable_array_remove(parked, i)
                net.close(c.session.sock)
                conn_release_raw(c.client_key)
                connection_closed(meter)
            } else if buffered {
                if Some(_) = try_receive(slots) {
                    mutable_array_remove(parked, i)
                    spawn worker(
                        c,
                        handler,
                        returns,
                        slots,
                        idle_timeout_ms,
                        log_requests,
                        compress_responses,
                        fault,
                        on_request,
                        meter
                    ) on_error fn(message: string) {
                        // A handler that failed leaves the connection ours to finish. The worker's own
                        // `defer` still returns the slot -- a defer runs even when a spawned function
                        // aborts -- but closing the socket, releasing the per-client count and
                        // decrementing the gauge each happen exactly once per connection, and the path
                        // that would have done them did not run.
                        fail_connection(c.session.sock, message)
                        net.close(c.session.sock)
                        conn_release_raw(c.client_key)
                        connection_closed(meter)
                    }
                }
            }
            i = i - 1
        }
        if len(parked) > 0 {
            var socks: [Socket] = []
            for idx, c in snapshot(parked) {
                socks = push(socks, c.session.sock)
            }
            val ready = net.wait_readable(socks, poll_slice_ms)
            // Again highest first: these are indices into `parked` and removal shifts the rest.
            var r = len(ready) - 1
            while r >= 0 {
                val at = ready[r]
                if at < len(parked) {
                    val c = mutable_array_get(parked, at)
                    if Some(_) = try_receive(slots) {
                        mutable_array_remove(parked, at)
                        spawn worker(
                            c,
                            handler,
                            returns,
                            slots,
                            idle_timeout_ms,
                            log_requests,
                            compress_responses,
                            fault,
                            on_request,
                            meter
                        ) on_error fn(message: string) {
                            // A handler that failed leaves the connection ours to finish. The worker's own
                            // `defer` still returns the slot -- a defer runs even when a spawned function
                            // aborts -- but closing the socket, releasing the per-client count and
                            // decrementing the gauge each happen exactly once per connection, and the path
                            // that would have done them did not run.
                            fail_connection(c.session.sock, message)
                            net.close(c.session.sock)
                            conn_release_raw(c.client_key)
                            connection_closed(meter)
                        }
                    }
                }
                r = r - 1
            }
        } else if running {
            clock.sleep_millis(poll_slice_ms)  // nothing parked: do not spin
        }
    }
}
// Serves `listener` until a shutdown is requested, answering each request with `handler`; see
// `ServeOptions` for the limits and the description above for how connections and shutdown behave.
// `ServeOptions` with defaults a small server can take as they are, to be narrowed with `with`:
//
//     server.serve(listener, handler, with server.serve_options() { log_requests: true })
//
// Prefer this to writing the struct out. Every field of a struct literal is required, so a server
// that lists all of them stops compiling the day this struct gains one -- which is exactly what
// happened to four fixtures and the reference backend when `compress_responses` was added
// (tasks.md F61). Built with `with`, the same code keeps working and picks up the new field's
// default.
//
// The defaults, and why: a 30-second idle timeout and 10-second header timeout, which are long
// enough for a slow mobile client and short enough that a stalled one frees its thread; 64
// connections -- which since F139 is a limit on requests in flight rather than on connected
// clients, so it no longer caps how many clients a server can hold; no request logging, because a
// log line per request is a
// decision about volume; no `fault` renderer, so the library's own JSON shape is used; no metrics
// and no response compression, both off for the reasons their own comments give; and no per-client
// connection cap, which is wrong by default behind a reverse proxy where every connection carries
// the proxy's address.
pub fn serve_options() -> ServeOptions {
    return ServeOptions {
        idle_timeout_ms: 30000,
        header_timeout_ms: 10000,
        max_connections: 64,
        log_requests: false,
        max_body_bytes: 0,
        compress_responses: false,
        fault: Option<fn(int, string) -> Response>.None,
        on_request: Option<fn(RequestLog)>.None,
        metrics: false,
        max_connections_per_client: 0
    }
}

pub fn serve(listener: Listener, handler: fn(Request) -> Response, options: ServeOptions) {
    // Here rather than at interpreter start-up, so only a program that actually serves adopts it: this
    // is a policy for thread-per-connection code that hashes passwords, not for every Ziman program.
    // Ziman's own allocation does not use glibc's arenas at all (zgc.h routes it through Boehm, which
    // takes memory from mmap), so what this caps is what third-party C libraries allocate -- which is
    // exactly the Argon2id buffer being retained. Measured at every concurrency before being made a
    // default: an authenticated read was 3.8% slower at 16 clients, 1.7% faster at 32, 7% faster at
    // 64, and registrations were unchanged. The result is ignored: a server can do nothing useful
    // about a failure, and on a platform without glibc there is nothing to fail.
    //
    // This cannot reach what the environment variable reaches (136 MB against 98 MB on the same run),
    // because three threads are alive before `serve` is called and `mallopt` does not merge arenas that
    // already exist. Taking the rest would mean doing this at interpreter start-up, which is the global
    // policy for every Ziman program that this placement exists to avoid.
    val _ = bound_malloc_arenas(1)
    var limit = options.max_connections
    if limit < 1 {
        limit = 1
    }
    val slots: Channel<int> = channel_new()
    for i in 0..limit {
        send(slots, 1)
    }
    // Connections live with the poller, not with a thread each. This loop only admits them.
    val returns: Channel<Parked> = channel_new()
    val head_ms = if options.header_timeout_ms > 0 && options.header_timeout_ms < options.idle_timeout_ms {
        options.header_timeout_ms
    } else {
        options.idle_timeout_ms
    }
    spawn park_loop(
        returns,
        slots,
        handler,
        options.idle_timeout_ms,
        options.log_requests,
        options.compress_responses,
        options.fault,
        options.on_request,
        options.metrics
    ) on_error fn(message: string) {
        os.write_stderr(format("ziman: the connection poller failed: {}\n", message))
    }
    while !os.shutdown_requested() {
        val client = net.accept(listener)
        if Ok(accepted) = client {
            // Decided here, before a slot is taken and before a thread exists: the whole point of a
            // connection cap is that refusing costs less than admitting, and that is only true if the
            // refusal happens before either. Closed without a reply, for the reason on
            // `max_connections_per_client`.
            val client_key = connection_key(accepted, options.max_connections_per_client)
            if !conn_acquire_raw(client_key, options.max_connections_per_client) {
                net.close(accepted)
                continue
            }
            if options.metrics {
                metrics.gauge_add(connections_metric, 1.0)
            }
            unwrap(net.set_timeout(accepted, head_ms))
            // Served directly, not handed to the poller: a connection that has just been accepted
            // has a request on its way, so there is nothing to park and nothing to wait for. Only
            // a connection that has *finished* a request and may get another one goes to the
            // poller. Routing new connections through it instead cost up to a `poll_slice_ms`
            // of latency each -- the poller can be part-way through its wait when one arrives --
            // which collapsed throughput on connection-per-request load badly enough that
            // tests/bench/server_concurrency.sh stopped finishing inside ten minutes.
            //
            // So this blocks on a slot exactly as it did before the poller existed, and that is
            // the right back-pressure now that a slot means "a request in flight" rather than "a
            // client connected": connections past it wait in the kernel's accept queue.
            val _ = receive(slots)
            val fresh_conn = Parked {
                session: with open_session_with_timeouts(accepted, options.idle_timeout_ms, head_ms) {
                    max_body_bytes: options.max_body_bytes
                },
                client_key: client_key,
                deadline_ms: clock.monotonic_millis() + options.idle_timeout_ms
            }
            spawn worker(
                fresh_conn,
                handler,
                returns,
                slots,
                options.idle_timeout_ms,
                options.log_requests,
                options.compress_responses,
                options.fault,
                options.on_request,
                options.metrics
            ) on_error fn(message: string) {
                fail_connection(accepted, message)
                net.close(accepted)
                conn_release_raw(client_key)
                connection_closed(options.metrics)
            }
        } else if !os.shutdown_requested() {
            clock.sleep_millis(accept_error_backoff_ms)  // an accept error must not become a busy loop
        }
    }
    for i in 0..limit {
        val _ = receive(slots)  // every slot back means every connection is done
    }
}
