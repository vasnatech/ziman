// `#![derive(Routes)]` on a module, and `#[route(..)]` on the functions it routes to: the endpoint
// table written from the handlers' own signatures.
//
//     #![derive(Routes)]
//
//     #[route(method: POST, path: "/api/orders", status: 201)]
//     pub fn handle_create(ctx: Ctx, who: Principal, data: model.OrderRequest)
//         -> Result<model.OrderResponse, ApiError> { .. }
//
// writes `pub val <module>_routes: [server.Endpoint<Ctx>]`, which the application appends to its
// own table. One attribute per handler replaces about ten lines of `server.Endpoint` literal.
//
// **Almost all of it comes from the signature, not the attribute.** Whether the endpoint is
// secured is whether its second parameter is a `Principal`; whether its input is in the path or
// the body is whether it takes a `Uuid` or a struct; and those three facts choose one of
// `server`'s eight handler constructors. The answer's encoder comes from the return type -- a
// `[T]` takes `json_list_encoder`, a `unit` takes none at all, a `Json` and an `int` take
// `codec`'s two builders that hold no converter (`json_value_encoder()` and `count_encoder()`,
// the second being what a count endpoint answers), anything else takes `json_encoder`. The decoder and encoder *functions* are named from the types as the
// source spells them: `meta` carries `Named("model.OrderRequest")`, alias and all, so
// `model.order_request_from_json` is `#[derive(Json)]`'s own convention read backwards.
//
// **Four things no signature holds, so the attribute carries them:**
//
//   * `method:` and `path:`, which are its whole content.
//   * `consumes:` and `produces:`, Spring's words, naming `codec`'s formats -- `"json"`, `"yaml"`,
//     `"toml"`, `"ndjson"`, `"csv"`, `"xml"`, or `"all"`. Omitted means JSON. Which of them a
//     shape can carry *is* derivable and is checked here, so `produces: "toml"` on a list is
//     refused at the attribute rather than on the request that asks for it.
//
//     **`"xml"` is spelled like the others and reached differently**, because XML is not a
//     `codec.TreeFormat`: `xml.parse` answers a `Document`, with attributes, namespaces and
//     element order that no `Json` carries, so there is no `xml_format()` to pass. What makes it
//     nameable here is `#[derive(Xml)]` (2026-10-31), which gives a type a `_to_xml`/`_from_xml`
//     pair the way `#[derive(Json)]` gives it a `_to_json`/`_from_json` one -- so this emits
//     `xml_encoder(model.order_to_xml)` where a tree format gets
//     `encoder_of(json_format(), model.order_to_json)`. A model named with `"xml"` has to derive
//     `Xml` as well as `Json`; if it does not, the generated call does not resolve and says so.
//
//     **`"all"` does not include XML**, deliberately: it means every format the type's JSON
//     derive already provides, so adding `produces: "all"` never demands a second derive. XML is
//     named explicitly.
//   * `who:`, because two authorisation functions have the same signature. Defaults to
//     `authenticated`.
//   * `status:`, because 201-versus-200 on a create is a decision, not a type.
//   * `label:`, the noun in a bad-id message ("invalid order id"), defaulting to the module's own
//     name with underscores as spaces -- which is what an application names them anyway.
//
// **What the application must have in scope where this is spliced**: `Ctx` (its context type),
// `api` (its `server.Api`, which says how its own error type renders), the `who` function each
// route names, and the four names below from `codec` and `server` -- `json_decoder`,
// `json_encoder`, `json_list_encoder`, `uuid_param`/`named_uuid_param`. They are emitted bare rather than qualified
// so that an application is free to bring them in by per-name import, and so that this module
// invents no vocabulary for an application's error type (user-generators.md §5c).
#![generator(Routes)]

use meta
use template

// What it writes for a module with three routes -- a list, a create with a body and a 201, and a
// delete with a path id and a 204, each offering XML beside the tree formats. The module is
// `tests/lang/derive_routes/main.zm`, which pins this text:
//
//     pub val main_routes: [server.Endpoint<Ctx>] = [
//         server.Endpoint<Ctx> {
//             method: http.HttpMethod.Get,
//             pattern: "/api/orders",
//             handler: server.secure_handler(
//                 who: authenticated,
//                 encoders: [
//                     list_encoder_of(json_format(), model.order_response_to_json),
//                     list_encoder_of(yaml_format(), model.order_response_to_json),
//                     list_encoder_of(ndjson_format(), model.order_response_to_json),
//                     list_encoder_of(csv_format(), model.order_response_to_json),
//                     xml_list_encoder("orderResponseList", model.order_response_to_xml)
//                 ],
//                 run: handle_list,
//                 api: api
//             )
//         },
//         server.Endpoint<Ctx> {
//             method: http.HttpMethod.Post,
//             pattern: "/api/orders",
//             handler: server.secure_body_handler(
//                 who: authenticated,
//                 decoders: [
//                     decoder_of(json_format(), model.order_request_from_json),
//                     decoder_of(yaml_format(), model.order_request_from_json),
//                     xml_decoder(model.order_request_from_xml)
//                 ],
//                 encoders: [
//                     encoder_of(json_format(), model.order_response_to_json),
//                     encoder_of(yaml_format(), model.order_response_to_json),
//                     xml_encoder(model.order_response_to_xml)
//                 ],
//                 status: 201,
//                 run: handle_create,
//                 api: api
//             )
//         },
//         server.Endpoint<Ctx> {
//             method: http.HttpMethod.Delete,
//             pattern: "/api/orders/{id}",
//             handler: server.secure_path_handler(
//                 who: authenticated,
//                 path: uuid_param("order"),
//                 encoders: [],
//                 status: 204,
//                 run: handle_delete,
//                 api: api
//             )
//         }
//     ]
//
// -- `secure_handler` versus `secure_body_handler` versus `secure_path_handler`, which builder each
// encoder needs, and `order_request_from_json`/`order_response_to_json` are all read off the
// handlers' signatures. What was written is the method, the path, the two statuses, the `"order"`
// label, and the `consumes:`/`produces:` that say which media types each endpoint speaks.
//
// **XML is the one format whose builder takes no format**, because it is not a `codec.TreeFormat`:
// `xml_encoder(model.order_response_to_xml)` stands where a tree format gets
// `encoder_of(json_format(), ..)`, and a list gets `xml_list_encoder("orderResponseList", ..)`
// because an array has no element name of its own.
val sheet = template.must_parse("""
@template bound_struct
struct @{name} {
@for f in fields
    @{f.name}: @{f.type}
@end
}

@end

@template path_reader_fn
fn @{name}(params: server.Params) -> Result<@{holds}, string> {
    return ok(@{build})
}

@end

@template query_reader_fn
fn @{name}(req: http.Request) -> Result<@{holds}, string> {
@for f in reads
@yield f.read
@end
    return ok(@{build})
}

@end

@template adapter
fn @{name}(@{params}) -> @{returns} {
@if validated
    if Some(problem) = invalid(@{violations}(@{body_param})) {
        return err(problem)
    }
@end
    return @{call}
}

@end

@template table
pub val @{module}_routes: [server.Endpoint<Ctx>] = [
@for e in endpoints
    server.Endpoint<Ctx> {
        method: http.HttpMethod.@{e.method},
        pattern: "@{e.path}",
        handler: server.@{e.flavour}(
@if e.secured
            who: @{e.who},
@end
@if e.has_path
            path: @{e.path_reader},
@end
@if e.has_query
            query: @{e.query_reader},
@end
@if e.has_body
            decoders: @{e.decoders},
@end
            encoders: @{e.encoders},
@if e.has_status
            status: @{e.status},
@end
            run: @{e.run},
            api: api
        )
    }@{e.comma}
@end
]

@end
""")

pub fn attributes() -> [meta.AttrSpec] {
    return [
        meta.attr_spec(
            "route",
            "method:name,path:string,who:name?,status:int?,label:string?," \
                "consumes:string?,produces:string?",
            "function"
        ),
        // **The parameter attributes** (2026-11-01), which are Spring's `@PathVariable`,
        // `@RequestParam`, `@RequestHeader`, `@RequestBody` and `@Valid` -- 96, 61, 4, 69 and 54
        // uses in the backend this answers to. Before them a route that read anything but one
        // `{id}` needed a struct and a reader function per endpoint; these bind one request value
        // per parameter and the generator writes the struct and the reader.
        //
        // `#[body]` and `#[principal]` are the two that were already derived -- a struct parameter
        // was the body, a `Principal` at position 1 meant secured. They are declarable now so a
        // signature can say what it is rather than leaving a reader to count positions; both stay
        // optional and the inference is unchanged when they are absent.
        meta.attr_spec("path", "name:string?,label:string?", "parameter"),
        meta.attr_spec("query", "name:string?,default:string?", "parameter"),
        meta.attr_spec("header", "name:string?,default:string?", "parameter"),
        meta.attr_spec("body", "", "parameter"),
        meta.attr_spec("principal", "", "parameter"),
        // `@Valid`'s equivalent, on the body. The violations come from `#[derive(Validate)]`'s
        // `<snake>_violations`, which 24 of this application's request structs already have, and
        // turning them into the error type is the application's `invalid` -- emitted bare, as
        // `api` and the `who` functions are, because only the application knows how its own error
        // carries per-field messages.
        meta.attr_spec("valid", "", "parameter")
    ]
}

pub fn generate_module(m: meta.ModuleTarget) -> Result<string, string> {
    val routed = meta.functions_with(m, "route")
    // A module carrying the attribute but no routed function writes nothing, which is a legitimate
    // answer rather than an error: the attribute may have been added before the handlers.
    if prelude.len(routed) == 0 {
        return ok("")
    }
    val rows = mutable_array_new<template.Row>()
    val decls = mutable_string_new()
    for i, f in routed {
        val last = i == prelude.len(routed) - 1
        val w = try wiring_for(f, m.name)
        append(decls, w.decls)
        push(rows, try row_for(f, m.name, w, if last { "" } else { "," }))
    }
    // **The bindings' structs, readers and adapters come first**, because the table's `run:`,
    // `path:` and `query:` name them. A generated val is spliced before the module's own vals and
    // a generated function before its own functions, so this order is the one that holds.
    val table = try template.render(sheet, "table", [
        template.text("module", m.name),
        template.rows("endpoints", snapshot(rows))
    ])
    return ok(concat(snapshot(decls), table))
}

// ---- binding one request value per parameter --------------------------------------------------
//
// **What a parameter attribute buys over a struct and a reader function.** `server`'s handler
// constructors take one path value and one query value, so an endpoint reading two path segments
// needed a struct to hold them and a `fn(Params) -> Result<That, string>` to fill it -- written by
// hand, per endpoint, in the module that assembled the table. The parameters say it instead, and
// this writes the struct and the reader.
//
// Three shapes come out, and only the last one is new work:
//
//   * **one `#[path] id: Uuid`** -- unchanged. `path: uuid_param("label")`, exactly what the
//     `{id}` inference already produced, so the attribute is documentation in the common case.
//   * **one `#[query] q: T`** -- no struct either: `Q` is the scalar, and the reader is a
//     generated function of one line.
//   * **two or more of either** -- a generated struct, a generated reader, and a generated adapter
//     that destructures it back into the handler's own parameters.

struct Binding {
    // "path", "query", "header", "body", "principal" or "" for an unannotated parameter.
    role: string
    // The parameter's own name, which the adapter passes through.
    param: string
    // The name on the wire: `camel_case` of the parameter for a path or query, `Title-Kebab` for a
    // header, or whatever `name:` said.
    wire: string
    type: meta.Type
    // The type inside an `Option<..>`, or the type itself.
    inner: meta.Type
    optional: bool
    default_text: Option<string>
    // `#[path(label: "dose log")]`, the noun for this one segment's message.
    label: Option<string>
    validated: bool
}

val binding_roles = ["path", "query", "header", "body", "principal"]

fn bindings_of(f: meta.Function) -> Result<[Binding], string> {
    val out = mutable_array_new<Binding>()
    for p in f.params {
        val role = get_or(meta.param_role(p, binding_roles), "")
        var inner = p.type
        var optional = false
        if Optional(elem) = p.type {
            inner = elem
            optional = true
        }
        val given = if role == "header" { header_name(p.name) } else { camel_case(p.name) }
        push(out, Binding {
            role: role,
            param: p.name,
            wire: get_or(meta.param_attr_value(p, role, "name"), given),
            type: p.type,
            inner: inner,
            optional: optional,
            default_text: meta.param_attr_value(p, role, "default"),
            label: meta.param_attr_value(p, "path", "label"),
            validated: meta.param_has_attr(p, "valid")
        })
    }
    return check_bindings(f, snapshot(out))
}

// `accept_language` -> `Accept-Language`. A header name is neither snake nor camel, and all three
// this backend reads (`Accept-Language`, `X-Share-Password`, `X-Timezone`) come out right.
fn header_name(param: string) -> string {
    val parts = split(param, "_")
    val out = mutable_array_new<string>()
    for one in parts {
        push(out, capitalise(one))
    }
    return join(separator: "-", pieces: snapshot(out))
}

// **The check that is the reason to do this in a compiler.** A `{doseLogId}` the signature does not
// bind, or a `#[path]` naming no placeholder, is a mistake Spring discovers on the request.
fn check_bindings(f: meta.Function, bs: [Binding]) -> Result<[Binding], string> {
    val declared = mutable_array_new<string>()
    for b in bs {
        if b.role == "path" {
            if b.optional {
                return err(prelude.format(
                    "#[route] on '{}': '{}' is a path segment and an Option -- a pattern only " \
                        "matches when every segment is there, so a path binding is never absent",
                    f.name,
                    b.param
                ))
            }
            push(declared, b.wire)
        }
        if b.role != "" && b.role != "body" && b.role != "principal" {
            try check_bindable(f, b)
        }
        if b.validated && b.role != "body" && b.role != "" {
            return err(prelude.format(
                "#[route] on '{}': '{}' carries #[valid] and is the {} -- validation is for the " \
                    "request body, whose rules #[derive(Validate)] writes",
                f.name,
                b.param,
                b.role
            ))
        }
    }
    val holes = placeholders(arg_or(f, "path", "/"))
    val bound = snapshot(declared)
    // Only checked when the signature binds any path parameter at all: a route written the old way
    // (one `{id}`, no attribute) still infers, and must keep working.
    if prelude.len(bound) > 0 {
        for h in holes {
            if !contains(bound, h) {
                return err(prelude.format(
                    "#[route] on '{}': the path captures '{{{}}}' and no parameter binds it -- add " \
                        "#[path] to the parameter, or #[path(name: \"{}\")] when its own name " \
                        "differs",
                    f.name,
                    h,
                    h
                ))
            }
        }
        for b in bound {
            if !contains(holes, b) {
                return err(prelude.format(
                    "#[route] on '{}': a parameter binds the path segment '{}' and the pattern " \
                        "'{}' has no such capture",
                    f.name,
                    b,
                    arg_or(f, "path", "/")
                ))
            }
        }
    }
    return ok(bs)
}

// What a request value can be bound as: whatever `server`'s `as_*` helpers read, plus a string,
// which needs no conversion. Everything else is refused by name rather than bound as its text.
fn check_bindable(f: meta.Function, b: Binding) -> Result<unit, string> {
    if Some(_) = reader_of(b.inner, "x", "y") {
        return unit
    }
    return err(prelude.format(
        "#[route] on '{}': '{}' is a {} of type '{}', which cannot be read from a request -- a " \
            "binding takes a string, an int, a float, a bool or a Uuid (or an Option of one for a " \
            "query or a header)",
        f.name,
        b.param,
        b.role,
        meta.type_text(b.inner)
    ))
}

// The call that turns one piece of request text into the bound type. `None` for a type no helper
// reads, which is what `check_bindable` asks.
fn reader_of(t: meta.Type, text: string, name: string) -> Option<string> {
    if String = t {
        return Option<string>.Some(text)
    }
    if Int = t {
        return Option<string>.Some(concat("try server.as_int(", text, ", \"", name, "\")"))
    }
    if Float = t {
        return Option<string>.Some(concat("try server.as_float(", text, ", \"", name, "\")"))
    }
    if Bool = t {
        return Option<string>.Some(concat("try server.as_bool(", text, ", \"", name, "\")"))
    }
    if Some(named) = named_of(t) {
        if meta.bare_name(named) == "Uuid" {
            return Option<string>.Some(concat("try server.as_uuid(", text, ", \"", name, "\")"))
        }
    }
    return Option<string>.None
}

fn of_role(bs: [Binding], role: string) -> [Binding] {
    val out = mutable_array_new<Binding>()
    for b in bs {
        if b.role == role {
            push(out, b)
        }
    }
    return snapshot(out)
}

// Everything one routed function needs, which is a record rather than eight return values.
struct Wiring {
    // The structs, readers and adapter this endpoint needs, spliced ahead of the table.
    decls: string
    has_path: bool
    path_reader: string
    has_query: bool
    query_reader: string
    has_body: bool
    body_type: string
    // The name the table's `run:` points at: the handler itself, or a generated adapter.
    run: string
}

// **One code path, and the old inference feeds it.** A signature with no parameter attribute has
// its roles filled in by the rules that were there before them -- position 1 a `Principal` is the
// caller, a `Uuid` is the path, another struct is the body -- so a route written either way goes
// through the same generation and cannot drift.
fn roles_filled(f: meta.Function, bs: [Binding], module_name: string) -> [Binding] {
    val holes = placeholders(arg_or(f, "path", "/"))
    val out = mutable_array_new<Binding>()
    for i in 0..prelude.len(bs) {
        val b = bs[i]
        // **Per parameter, not per signature.** A route that annotates its query parameters and
        // leaves `principal: Principal` bare is the natural way to write one, and filling roles
        // only when *nothing* was declared made that endpoint public -- it asked `server` for a
        // `public_query_handler` and said so, which is how this was found rather than shipped.
        if b.role != "" {
            push(out, b)
            continue
        }
        var role = ""
        var wire = b.wire
        if i == 1 && is_principal(b.type) {
            role = "principal"
        } else if i > 0 && is_uuid(b.type) {
            role = "path"
            wire = if prelude.len(holes) == 1 { holes[0] } else { "id" }
        } else if i > 0 && Some(_) = named_of(b.type) {
            role = "body"
        }
        push(out, with b { role: role, wire: wire })
    }
    return snapshot(out)
}

fn wiring_for(f: meta.Function, module_name: string) -> Result<Wiring, string> {
    val bs = roles_filled(f, try bindings_of(f), module_name)
    val paths = of_role(bs, "path")
    val queries = concat_bindings(of_role(bs, "query"), of_role(bs, "header"))
    val bodies = of_role(bs, "body")
    val secured = prelude.len(of_role(bs, "principal")) > 0
    val label = arg_or(f, "label", replace(module_name, "_", " "))

    if prelude.len(paths) > 0 && prelude.len(queries) > 0 {
        return err(prelude.format(
            "#[route] on '{}' binds both a path segment and a query parameter, and `server` has no " \
                "constructor for the pair -- `endpoint_core` takes both, so the missing piece is a " \
                "`{}_path_query_handler` beside the other nine",
            f.name,
            if secured { "secure" } else { "public" }
        ))
    }
    if prelude.len(queries) > 0 && prelude.len(bodies) > 0 {
        return err(prelude.format(
            "#[route] on '{}' binds both a query parameter and a request body, and `server` has no " \
                "constructor for the pair",
            f.name
        ))
    }
    if prelude.len(bodies) > 1 {
        return err(prelude.format("#[route] on '{}' has more than one #[body]", f.name))
    }

    val decls = mutable_string_new()
    var path_reader = ""
    var query_reader = ""
    var adapter_needed = false
    var validated = Option<Binding>.None
    for b in bodies {
        if b.validated {
            validated = Option<Binding>.Some(b)
            adapter_needed = true
        }
    }

    // ---- the path
    if prelude.len(paths) == 1 {
        val one = paths[0]
        if is_uuid(one.inner) {
            // Exactly what the `{id}` inference produced, so an annotated route and an inferred
            // one generate the same text.
            val noun = get_or(segment_label(one, true), label)
            path_reader = if one.wire == "id" {
                concat("uuid_param(\"", noun, "\")")
            } else {
                concat("named_uuid_param(\"", one.wire, "\", \"", noun, "\")")
            }
        } else {
            path_reader = concat(f.name, "_path_of")
            append(decls, try template.render(sheet, "path_reader_fn", [
                template.text("name", path_reader),
                template.text("holds", meta.type_text(one.inner)),
                template.text("build", try read_path(one, get_or(segment_label(one, true), label)))
            ]))
        }
    } else if prelude.len(paths) > 1 {
        adapter_needed = true
        val holder = holder_name(f.name, "path")
        path_reader = concat(f.name, "_path_of")
        append(decls, try bound_struct(holder, paths))
        val fields = mutable_array_new<string>()
        for b in paths {
            push(fields, concat(b.param, ": ", try read_path(b, get_or(segment_label(b, false), label))))
        }
        append(decls, try template.render(sheet, "path_reader_fn", [
            template.text("name", path_reader),
            template.text("holds", holder),
            template.text("build", concat(
                holder,
                " {\n        ",
                join(separator: ",\n        ", pieces: snapshot(fields)),
                "\n    }"
            ))
        ]))
    }

    // ---- the query (and headers, which read the same way from a different place)
    if prelude.len(queries) == 1 {
        query_reader = concat(f.name, "_query_of")
        append(decls, try query_reader_fn(query_reader, meta.type_text(queries[0].type), queries, true))
    } else if prelude.len(queries) > 1 {
        adapter_needed = true
        val holder = holder_name(f.name, "query")
        query_reader = concat(f.name, "_query_of")
        append(decls, try bound_struct(holder, queries))
        append(decls, try query_reader_fn(query_reader, holder, queries, false))
    }

    // ---- the adapter, when the handler's parameters are not what the constructor passes
    var run = f.name
    if adapter_needed {
        run = concat(f.name, "_route")
        append(decls, try adapter(f, run, bs, paths, queries, bodies, validated))
    }
    return ok(Wiring {
        decls: snapshot(decls),
        has_path: prelude.len(paths) > 0,
        path_reader: path_reader,
        has_query: prelude.len(queries) > 0,
        query_reader: query_reader,
        has_body: prelude.len(bodies) > 0,
        body_type: if prelude.len(bodies) > 0 { get_or(named_of(bodies[0].type), "") } else { "" },
        run: run
    })
}

// The noun in **this segment's** message ("invalid order id"), where the route's `label:` names the
// endpoint's resource. A pattern with two captures needs two nouns, and the parameter already
// carries one: `order_id` is "order", `dose_log_id` is "dose log" -- which is what the hand-written
// `named_uuid_param("medicationId", "medication")` calls said. `#[path(label: "..")]` overrides it.
//
// **`None` only when there is one segment**, where the route's own `label:` is the better answer
// and is what the `{id}` inference already used.
fn segment_label(b: Binding, only: bool) -> Option<string> {
    if Some(given) = b.label {
        return Option<string>.Some(given)
    }
    if only {
        return Option<string>.None
    }
    var name = b.param
    if ends_with(name, "_id") {
        name = substring(name, 0, prelude.len(name) - 3)
    }
    return Option<string>.Some(replace(name, "_", " "))
}

// The struct a multi-segment path or a multi-parameter query is held in. **Two names are reserved
// per routed function** -- `HandleGetPath` and `HandleGetQuery` for `handle_get` -- and a module
// that already defines one is told so rather than finding out from a redefinition error in
// generated code it did not write.
fn holder_name(fn_name: string, kind: string) -> string {
    // Not `capitalise(camel_case(..))`: `capitalise` lowercases the tail, because the thing it was
    // written for is `GET` -> `Get`. Each underscore-separated part is capitalised instead.
    val out = mutable_array_new<string>()
    for part in split(concat(fn_name, "_", kind), "_") {
        push(out, capitalise(part))
    }
    return join(separator: "", pieces: snapshot(out))
}

fn concat_bindings(a: [Binding], b: [Binding]) -> [Binding] {
    val out = mutable_array_new<Binding>()
    for one in a {
        push(out, one)
    }
    for one in b {
        push(out, one)
    }
    return snapshot(out)
}

fn bound_struct(name: string, bs: [Binding]) -> Result<string, string> {
    val fields = mutable_array_new<template.Row>()
    for b in bs {
        push(fields, template.row([
            template.text("name", b.param),
            template.text("type", meta.type_text(b.type))
        ]))
    }
    return template.render(sheet, "bound_struct", [
        template.text("name", name),
        template.rows("fields", snapshot(fields))
    ])
}

// A path segment is always there -- the router only matches when every segment is -- so no
// `required`, just the conversion.
fn read_path(b: Binding, label: string) -> Result<string, string> {
    val text = concat("server.param(params, \"", b.wire, "\")")
    switch reader_of(b.inner, text, if is_uuid(b.inner) { label } else { b.wire }) {
        Some(call) { return ok(call) }
        None { return err(concat("derive(Routes) cannot read a path segment as '", meta.type_text(b.inner), "'")) }
    }
}

// A query or header value may be absent, so each one is a statement before the struct is built:
// required, defaulted, or an `Option` left as `None`.
fn query_reader_fn(name: string, holds: string, bs: [Binding], scalar: bool) -> Result<string, string> {
    val reads = mutable_array_new<template.Row>()
    val fields = mutable_array_new<string>()
    for b in bs {
        push(reads, template.row([template.text("read", trim_end(try read_query(b)))]))
        push(fields, concat(b.param, ": ", b.param))
    }
    val build = if scalar {
        bs[0].param
    } else {
        concat(holds, " {\n        ", join(separator: ",\n        ", pieces: snapshot(fields)), "\n    }")
    }
    return template.render(sheet, "query_reader_fn", [
        template.text("name", name),
        template.text("holds", holds),
        template.rows("reads", snapshot(reads)),
        template.text("build", build)
    ])
}

// A yielded block ends with its own newline and `@yield` supplies one, so the trailing one goes.
fn trim_end(text: string) -> string {
    return substring(text, 0, prelude.len(text) - 1)
}

fn read_query(b: Binding) -> Result<string, string> {
    val source = if b.role == "header" {
        concat("http.header(req, \"", b.wire, "\")")
    } else {
        concat("server.query_param(req, \"", b.wire, "\")")
    }
    if b.optional {
        // An absent one is the `Option`'s `None`, and a present one still has to convert.
        val inner = meta.type_text(b.inner)
        switch reader_of(b.inner, "raw", b.wire) {
            Some(call) {
                return ok(concat(
                    "    var ",
                    b.param,
                    " = Option<",
                    inner,
                    ">.None\n",
                    "    if Some(raw) = ",
                    source,
                    " {\n",
                    "        ",
                    b.param,
                    " = Option<",
                    inner,
                    ">.Some(",
                    call,
                    ")\n",
                    "    }\n"
                ))
            }
            None { return err(concat("derive(Routes) cannot read '", inner, "' from a request")) }
        }
    }
    val text = switch b.default_text {
        Some(given) { concat("server.given_or(", source, ", \"", given, "\")") }
        None { concat("try server.required(", source, ", \"", b.wire, "\")") }
    }
    switch reader_of(b.inner, text, b.wire) {
        Some(call) { return ok(concat("    val ", b.param, " = ", call, "\n")) }
        None { return err(concat("derive(Routes) cannot read '", meta.type_text(b.inner), "' from a request")) }
    }
}

// The adapter: the constructor hands one path value, one query value and one body, and the handler
// wants its own parameters back. This is the function that destructures.
fn adapter(
    f: meta.Function,
    name: string,
    bs: [Binding],
    paths: [Binding],
    queries: [Binding],
    bodies: [Binding],
    validated: Option<Binding>
) -> Result<string, string> {
    val params = mutable_array_new<string>()
    val args = mutable_array_new<string>()
    var i = 0
    for b in bs {
        if i == 0 {
            push(params, concat(b.param, ": ", meta.type_text(b.type)))
            push(args, b.param)
        } else if b.role == "principal" {
            push(params, concat(b.param, ": ", meta.type_text(b.type)))
            push(args, b.param)
        }
        i = i + 1
    }
    if prelude.len(paths) > 1 {
        push(params, concat("bound_path: ", holder_name(f.name, "path")))
    }
    if prelude.len(queries) > 1 {
        push(params, concat("bound_query: ", holder_name(f.name, "query")))
    }
    for b in bodies {
        push(params, concat(b.param, ": ", meta.type_text(b.type)))
    }
    // The handler's own argument order is the order of its parameters.
    val call_args = mutable_array_new<string>()
    var n = 0
    for b in bs {
        if n == 0 || b.role == "principal" {
            push(call_args, b.param)
        } else if b.role == "path" {
            push(call_args, if prelude.len(paths) > 1 { concat("bound_path.", b.param) } else { b.param })
        } else if b.role == "query" || b.role == "header" {
            push(call_args, if prelude.len(queries) > 1 { concat("bound_query.", b.param) } else { b.param })
        } else {
            push(call_args, b.param)
        }
        n = n + 1
    }
    var violations = ""
    var body_param = ""
    if Some(b) = validated {
        body_param = b.param
        violations = concat(json_stem(get_or(named_of(b.type), "")), "_violations")
    }
    return template.render(sheet, "adapter", [
        template.text("name", name),
        template.text("params", join(separator: ", ", pieces: snapshot(params))),
        template.text("returns", meta.type_text(f.returns)),
        template.flag("validated", Option.is_Some(validated)),
        template.text("violations", violations),
        template.text("body_param", body_param),
        template.text("call", concat(f.name, "(", join(separator: ", ", pieces: snapshot(call_args)), ")"))
    ])
}

fn row_for(
    f: meta.Function,
    module_name: string,
    w: Wiring,
    comma: string
) -> Result<template.Row, string> {
    val secured = prelude.len(of_role(roles_filled(f, try bindings_of(f), module_name), "principal")) > 0
    var decoders = "[]"
    if w.has_body {
        decoders = try decoders_for(f, w.body_type)
    }
    return ok(template.row([
        template.text("method", capitalise(arg_or(f, "method", "GET"))),
        template.text("path", arg_or(f, "path", "/")),
        template.text("flavour", flavour(secured, w.has_path, w.has_query, w.has_body)),
        template.flag("secured", secured),
        template.text("who", arg_or(f, "who", "authenticated")),
        template.flag("has_path", w.has_path),
        template.text("path_reader", w.path_reader),
        template.flag("has_query", w.has_query),
        template.text("query_reader", w.query_reader),
        template.flag("has_body", w.has_body),
        template.text("body", w.body_type),
        template.text("decoders", decoders),
        template.text("encoders", try encoders_for(f)),
        template.flag("has_status", Option.is_Some(meta.fn_attr_arg(f, "route", "status"))),
        template.text("status", arg_or(f, "status", "")),
        template.text("run", w.run),
        template.text("comma", comma)
    ]))
}

// **`consumes:` and `produces:`, as Spring spells them**, naming `codec`'s formats: `"json"`,
// `"yaml"`, `"toml"`, `"ndjson"`, `"csv"`, `"xml"`, or `"all"` for every one the shape allows.
// Omitted means JSON, which is what every route wrote before these existed.
//
// **Which formats a shape allows is checked here, when the code is generated**, not at run time:
// a lone object cannot be NDJSON (a sequence of documents) or CSV (a table), and an array cannot
// be TOML (a document is a table at the top). Spring would accept `produces` it cannot honour and
// fail on the request; this refuses the attribute and names the format.
fn formats_named(spelt: string, allowed: [string], what: string, fn_name: string) -> Result<[string], string> {
    val wanted = mutable_array_new<string>()
    for piece in split(replace(spelt, ",", " "), " ") {
        val one = trim(piece)
        if prelude.len(one) == 0 {
            continue
        }
        // **`all` is every format the JSON derive already provides**, which is why XML is not in
        // it: `"all"` on a route whose model derives only `Json` must keep working, and including
        // XML would make the word demand a second derive of every type that used it.
        //
        // **It contributes to the list rather than replacing it**, which it did until 2026-10-31 --
        // `all` returned on the spot, so `produces: "all, xml"` silently dropped the `xml` and
        // offered four formats where five were asked for. Nothing wrote it before XML existed,
        // because `"all"` plus a name it already covered said nothing new.
        if one == "all" {
            for each in from_json_only(allowed) {
                add_once(wanted, each)
            }
            continue
        }
        if !contains(allowed, one) {
            return err(try refusal(one, allowed, what, fn_name))
        }
        add_once(wanted, one)
    }
    if prelude.len(wanted) == 0 {
        return ok(["json"])
    }
    return ok(snapshot(wanted))
}

// A format named twice -- `"all, json"`, or plain repetition -- is one encoder, not two. Negotiation
// takes the first match, so a duplicate was never wrong, only dead weight in generated code that
// someone has to read.
fn add_once(wanted: MutableArray<string>, one: string) {
    if !contains(wanted, one) {
        push(wanted, one)
    }
}

// **Two reasons a name is refused, and they are two different mistakes**: a format that exists but
// cannot carry this shape, and a word that is not a format at all. There were three until
// 2026-10-31 -- `"xml"` had its own message, because XML was a format this mechanism could not
// reach. `#[derive(Xml)]` made it reachable, so the message became an answer instead.
fn refusal(one: string, allowed: [string], what: string, fn_name: string) -> Result<string, string> {
    val subject = if what == "consumes" { "a request body" } else { "an answer" }
    if contains(known_formats(), one) {
        return ok(prelude.format(
            "#[route] on '{}' says {}: \"{}\", and {} cannot be written as {} -- it takes {}",
            fn_name,
            what,
            one,
            subject,
            one,
            join(separator: ", ", pieces: allowed)
        ))
    }
    return ok(prelude.format(
        "#[route] on '{}' says {}: \"{}\", which is not a format -- `codec`'s are {}, and {} " \
            "takes {}",
        fn_name,
        what,
        one,
        join(separator: ", ", pieces: known_formats()),
        subject,
        join(separator: ", ", pieces: allowed)
    ))
}

// Every format `codec` has, as `consumes:`/`produces:` spell them -- so a name that is one of
// these but wrong for the shape gets a different sentence from a name that is not one at all.
fn known_formats() -> [string] {
    return ["json", "yaml", "toml", "ndjson", "csv", "xml"]
}

// The formats a lone tree can be written as, and the ones an array can. **XML is in both**: it is
// not a tree format, but a document holds one object or a list of them equally well, and which it
// is here is decided by the signature rather than by the format.
fn tree_names() -> [string] {
    return ["json", "yaml", "toml", "xml"]
}

fn sequence_names() -> [string] {
    return ["json", "yaml", "ndjson", "csv", "xml"]
}

// What `"all"` expands to: the named formats minus the ones needing a derive of their own.
fn from_json_only(allowed: [string]) -> [string] {
    val out = mutable_array_new<string>()
    for one in allowed {
        if one != "xml" {
            push(out, one)
        }
    }
    return snapshot(out)
}

// The list literal the template drops in. One entry stays on its line; several wrap, because a
// route offering four formats otherwise writes a line nobody can read -- and generated code is
// read, by whoever is working out what an endpoint does.
fn as_list(items: [string]) -> string {
    if prelude.len(items) < 2 {
        return join(prefix: "[", suffix: "]", separator: ", ", pieces: items)
    }
    return join(
        prefix: "[\n                ",
        suffix: "\n            ]",
        separator: ",\n                ",
        pieces: items
    )
}

// What encodes the answer: the return type decides the shape and the builder, `produces:` the
// formats.
fn encoders_for(f: meta.Function) -> Result<string, string> {
    if ResultOf(r) = f.returns {
        if Array(inner) = r.ok {
            // **An array of a scalar**, which `#[derive(Json)]`'s own converters cover: `[string]`
            // takes `string_to_json`, the same name a derived struct's field of that type is
            // written with. An admin endpoint answering log lines is `Result<[string], E>`, and
            // refusing it would have been the generator not looking up a name it already imports.
            if Some(stem) = scalar_stem(inner) {
                val names = try formats_named(
                    arg_or(f, "produces", "json"),
                    sequence_names(),
                    "produces",
                    f.name
                )
                if contains(names, "xml") {
                    return err(prelude.format(
                        "#[route] on '{}' says produces: \"xml\" and answers an array of '{}' -- " \
                            "#[derive(Xml)] writes a document for a struct, and a bare scalar has " \
                            "no element name to give its items",
                        f.name,
                        meta.type_text(inner)
                    ))
                }
                val out = mutable_array_new<string>()
                for n in names {
                    push(out, concat("list_encoder_of(", n, "_format(), ", stem, "_to_json)"))
                }
                return ok(as_list(snapshot(out)))
            }
            // `[Json]` has no converter to derive either, and a list of trees needs its own
            // builder rather than `list_encoder_of` with an identity function spelled out.
            if Some(name) = named_of(inner) {
                if meta.bare_name(name) == "Json" {
                    try only_json(f, "json_value_list_encoder()")
                    return ok("[json_value_list_encoder()]")
                }
                val names = try formats_named(
                    arg_or(f, "produces", "json"),
                    sequence_names(),
                    "produces",
                    f.name
                )
                return ok(as_list(built(names, "list_encoder_of", name, "_to_json")))
            }
        }
        // A `unit` answer has no body, which is what a 204 means -- and nothing to negotiate, so
        // `produces:` on one is a mistake worth naming rather than ignoring.
        if Unit = r.ok {
            if Some(_) = meta.fn_attr_arg(f, "route", "produces") {
                return err(prelude.format(
                    "#[route] on '{}' says produces:, and it answers unit -- there is no body to " \
                        "encode, which is what its 204 means",
                    f.name
                ))
            }
            return ok("[]")
        }
        // **Two answers that are not a model, and `codec` has a builder for each.** A `Json` is a
        // tree the handler passes through rather than a type of its own, and an `int` is what a
        // count endpoint answers -- Spring returns a bare `Long` there and a client reading it
        // wants the scalar, not an object wrapping one.
        //
        // Both were refusals until 2026-10-31, and the `Json` one was the bad kind: `named_of`
        // answers `"Json"` like any other type name, so this emitted
        // `encoder_of(json_format(), json_to_json)` and the error was an unresolved name rather
        // than a sentence about the shape. Found by classifying the North Star's 110 hand-written
        // endpoints before converting them.
        if Some(builder) = fixed_encoder(r.ok) {
            try only_json(f, builder)
            return ok(concat("[", builder, "]"))
        }
        if Some(name) = named_of(r.ok) {
            val names = try formats_named(
                arg_or(f, "produces", "json"),
                tree_names(),
                "produces",
                f.name
            )
            return ok(as_list(built(names, "encoder_of", name, "_to_json")))
        }
    }
    return err(prelude.format(
        "#[route] on '{}' cannot see what encodes its answer: it has to return a Result whose " \
            "success is a struct, an array of one, a Json, an int, or unit",
        f.name
    ))
}

// The `<stem>_to_json` name a scalar's converter has, which `#[derive(Json)]` imports for every
// field of that type. `None` for anything that is not one.
fn scalar_stem(t: meta.Type) -> Option<string> {
    if String = t {
        return Option<string>.Some("string")
    }
    if Int = t {
        return Option<string>.Some("int")
    }
    if Float = t {
        return Option<string>.Some("float")
    }
    if Bool = t {
        return Option<string>.Some("bool")
    }
    if Bigint = t {
        return Option<string>.Some("bigint")
    }
    if Decimal = t {
        return Option<string>.Some("decimal")
    }
    return Option<string>.None
}

// The answers `codec` encodes without a derived converter, because there is nothing to derive one
// from: a `Json` is already the tree, and an `int` is one number.
fn fixed_encoder(ok_type: meta.Type) -> Option<string> {
    if Int = ok_type {
        return Option<string>.Some("count_encoder()")
    }
    if Some(name) = named_of(ok_type) {
        if meta.bare_name(name) == "Json" {
            return Option<string>.Some("json_value_encoder()")
        }
    }
    return Option<string>.None
}

// Neither builder has a format to choose, so `produces:` on one is asking for something it cannot
// give. Refused rather than ignored, which is the rule `unit` already follows.
fn only_json(f: meta.Function, builder: string) -> Result<unit, string> {
    if Some(spelt) = meta.fn_attr_arg(f, "route", "produces") {
        if trim(spelt) != "json" {
            return err(prelude.format(
                "#[route] on '{}' says produces: \"{}\", and it answers {} -- `{}` writes JSON " \
                    "and nothing else, because there is no derived converter to write another " \
                    "format with",
                f.name,
                spelt,
                if builder == "count_encoder()" { "an int" } else { "a Json" },
                builder
            ))
        }
    }
    return unit
}

// What decodes the body. A body is one value, so the tree formats are the candidates: CSV parses
// to an array and NDJSON to a sequence, neither of which is a lone model.
fn decoders_for(f: meta.Function, body: string) -> Result<string, string> {
    val names = try formats_named(arg_or(f, "consumes", "json"), tree_names(), "consumes", f.name)
    return ok(as_list(built(names, "decoder_of", body, "_from_json")))
}

// `decoder_of(json_format(), model.order_request_from_json)`, one per format named -- except XML,
// which is reached by its own builder.
fn built(names: [string], builder: string, type_name: string, suffix: string) -> [string] {
    val out = mutable_array_new<string>()
    for n in names {
        if n == "xml" {
            push(out, xml_built(builder, type_name))
        } else {
            push(out, concat(builder, "(", n, "_format(), ", json_stem(type_name), suffix, ")"))
        }
    }
    return snapshot(out)
}

// **XML passes no format, because there is no `xml_format()` to pass** -- it is not a
// `codec.TreeFormat` and deliberately never became one. So `codec` gives it three builders of its
// own that take the derived function directly, and this writes those.
//
// **The list case has to name the collection**, where a JSON array needs no name at all: a list
// has no element of its own, and `<orderResponseList><orderResponse/>..</orderResponseList>` is
// the shape a client reads. Each item keeps the element name its own `_to_xml` writes; the
// collection is that plus `List`, because **an English plural is not computable** --
// "person"/"people", "analysis"/"analyses" -- and a generator that guessed one would be wrong
// often and silently. Jackson's `XmlMapper` names the container after its class for the same
// reason. An endpoint that wants `<orders>` writes its own `codec.xml_list_encoder` and leaves
// `produces:` alone, which is what this attribute is a shortcut for rather than a replacement of.
fn xml_built(builder: string, type_name: string) -> string {
    val stem = json_stem(type_name)
    if builder == "decoder_of" {
        return concat("xml_decoder(", stem, "_from_xml)")
    }
    if builder == "list_encoder_of" {
        return concat("xml_list_encoder(\"", element_name(type_name), "List\", ", stem, "_to_xml)")
    }
    return concat("xml_encoder(", stem, "_to_xml)")
}

// The element `#[derive(Xml)]` names a value of this type after: `model.OrderResponse` ->
// `orderResponse`, the module qualifier dropped because an element name is not a Ziman name.
fn element_name(qualified: string) -> string {
    val parts = split(qualified, ".")
    return camel_case(snake_case(parts[prelude.len(parts) - 1]))
}

// The type as the source wrote it, which is what generated text repeats: `model.OrderResponse`
// stays qualified, because the generated code sits in the module that wrote that `use`.
fn named_of(t: meta.Type) -> Option<string> {
    if Named(n) = t {
        return Option<string>.Some(n.name)
    }
    return Option<string>.None
}

// `model.OrderResponse` -> `model.order_response`, the stem both derived JSON functions are named
// from. The qualifier passes through untouched; only the type's own name is recased.
fn json_stem(qualified: string) -> string {
    if prelude.len(qualified) == 0 {
        return ""
    }
    val parts = split(qualified, ".")
    val bare = parts[prelude.len(parts) - 1]
    val snake = snake_case(bare)
    if prelude.len(parts) == 1 {
        return snake
    }
    return concat(substring(qualified, 0, prelude.len(qualified) - prelude.len(bare)), snake)
}

// **By suffix, not by equality.** A loaded module's declarations are self-qualified, so the type
// arrives as `common::Principal` from one file and `common.Principal` from another.
fn is_principal(t: meta.Type) -> bool {
    if Some(name) = named_of(t) {
        return ends_with(name, "Principal")
    }
    return false
}

fn is_uuid(t: meta.Type) -> bool {
    if Some(name) = named_of(t) {
        return ends_with(name, "Uuid")
    }
    return false
}

fn arg_or(f: meta.Function, name: string, fallback: string) -> string {
    if Some(v) = meta.fn_attr_arg(f, "route", name) {
        return v
    }
    return fallback
}

// **Which `Uuid` reader a path needs is in the path**, so neither is an attribute argument.
// `uuid_param` reads the segment captured as `{id}`; a pattern that captures it under another name
// -- `/api/me/medications/{medicationId}/doses`, where `{id}` would be the dose and the id in the
// path is the medication's -- needs `named_uuid_param` with that name. The generator read the
// pattern already, to no purpose; two of the North Star's endpoints were hand-written only because
// it did not look.
//
// More than one placeholder means a path *struct* and a reader written by hand, which an attribute
// cannot carry -- it holds values, not functions. Those keep their literal endpoint, and
// `has_path` is false for them because the signature takes a struct rather than a `Uuid`.
fn path_reader(pattern: string, label: string) -> string {
    val captured = placeholders(pattern)
    if prelude.len(captured) == 1 && captured[0] != "id" {
        return concat("named_uuid_param(\"", captured[0], "\", \"", label, "\")")
    }
    return concat("uuid_param(\"", label, "\")")
}

// The names between braces, in order: `/a/{x}/b/{y}` gives `["x", "y"]`.
fn placeholders(pattern: string) -> [string] {
    val out = mutable_array_new<string>()
    val letters = chars(pattern)
    var at = 0
    while at < prelude.len(letters) {
        if letters[at] == "{" {
            val name = mutable_string_new()
            at = at + 1
            while at < prelude.len(letters) && letters[at] != "}" {
                append(name, letters[at])
                at = at + 1
            }
            push(out, snapshot(name))
        }
        at = at + 1
    }
    return snapshot(out)
}

// `secure_path_body_handler` and its seven siblings, named from the three facts that pick one.
fn flavour(secured: bool, has_path: bool, has_query: bool, has_body: bool) -> string {
    val parts = mutable_array_new<string>()
    push(parts, if secured { "secure" } else { "public" })
    if has_path {
        push(parts, "path")
    }
    // A query never appears beside a path or a body -- `wiring_for` refuses both pairs, because
    // `server` has no constructor for either.
    if has_query {
        push(parts, "query")
    }
    if has_body {
        push(parts, "body")
    }
    push(parts, "handler")
    return join(separator: "_", pieces: snapshot(parts))
}

// `GET` -> `Get`, which is how `http.HttpMethod`'s variants are spelled.
fn capitalise(word: string) -> string {
    if prelude.len(word) == 0 {
        return word
    }
    return concat(to_upper(substring(word, 0, 1)), to_lower(substring(word, 1, prelude.len(word))))
}
