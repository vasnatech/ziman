// `#![derive(Routes)]` on a module, and `#[route(..)]` on the functions it routes to: the endpoint
// table written from the handlers' own signatures.
//
//     #![derive(Routes)]
//
//     #[route(method: POST, path: "/api/orders", status: 201)]
//     pub fn handle_create(ctx: Ctx, who: Principal, data: model.OrderRequest)
//         -> Result<model.OrderResponse, ApiError> { .. }
//
// writes `pub val <module>_routes: [server.Endpoint<Ctx>]`, which the application appends to its
// own table. One attribute per handler replaces about ten lines of `server.Endpoint` literal.
//
// **Almost all of it comes from the signature, not the attribute.** Whether the endpoint is
// secured is whether its second parameter is a `Principal`; whether its input is in the path or
// the body is whether it takes a `Uuid` or a struct; and those three facts choose one of
// `server`'s eight handler constructors. The answer's encoder comes from the return type -- a
// `[T]` takes `json_list_encoder`, a `unit` takes none at all, anything else takes
// `json_encoder` -- `codec`'s. The decoder and encoder *functions* are named from the types as the
// source spells them: `meta` carries `Named("model.OrderRequest")`, alias and all, so
// `model.order_request_from_json` is `#[derive(Json)]`'s own convention read backwards.
//
// **Four things no signature holds, so the attribute carries them:**
//
//   * `method:` and `path:`, which are its whole content.
//   * `consumes:` and `produces:`, Spring's words, naming `codec`'s formats -- `"json"`, `"yaml"`,
//     `"toml"`, `"ndjson"`, `"csv"`, `"xml"`, or `"all"`. Omitted means JSON. Which of them a
//     shape can carry *is* derivable and is checked here, so `produces: "toml"` on a list is
//     refused at the attribute rather than on the request that asks for it.
//
//     **`"xml"` is spelled like the others and reached differently**, because XML is not a
//     `codec.TreeFormat`: `xml.parse` answers a `Document`, with attributes, namespaces and
//     element order that no `Json` carries, so there is no `xml_format()` to pass. What makes it
//     nameable here is `#[derive(Xml)]` (2026-10-31), which gives a type a `_to_xml`/`_from_xml`
//     pair the way `#[derive(Json)]` gives it a `_to_json`/`_from_json` one -- so this emits
//     `xml_encoder(model.order_to_xml)` where a tree format gets
//     `encoder_of(json_format(), model.order_to_json)`. A model named with `"xml"` has to derive
//     `Xml` as well as `Json`; if it does not, the generated call does not resolve and says so.
//
//     **`"all"` does not include XML**, deliberately: it means every format the type's JSON
//     derive already provides, so adding `produces: "all"` never demands a second derive. XML is
//     named explicitly.
//   * `who:`, because two authorisation functions have the same signature. Defaults to
//     `authenticated`.
//   * `status:`, because 201-versus-200 on a create is a decision, not a type.
//   * `label:`, the noun in a bad-id message ("invalid order id"), defaulting to the module's own
//     name with underscores as spaces -- which is what an application names them anyway.
//
// **What the application must have in scope where this is spliced**: `Ctx` (its context type),
// `api` (its `server.Api`, which says how its own error type renders), the `who` function each
// route names, and the four names below from `codec` and `server` -- `json_decoder`,
// `json_encoder`, `json_list_encoder`, `uuid_param`. They are emitted bare rather than qualified
// so that an application is free to bring them in by per-name import, and so that this module
// invents no vocabulary for an application's error type (user-generators.md §5c).
#![generator(Routes)]

use meta
use template

// What it writes for a module with three routes -- a list, a create with a body and a 201, and a
// delete with a path id and a 204. The module is `tests/lang/derive_routes/main.zm`, which pins
// this text:
//
//     pub val main_routes: [server.Endpoint<Ctx>] = [
//         server.Endpoint<Ctx> {
//             method: http.HttpMethod.Get,
//             pattern: "/api/orders",
//             handler: server.secure_handler(
//                 who: authenticated,
//                 encoders: [
//                     list_encoder_of(json_format(), model.order_response_to_json),
//                     list_encoder_of(yaml_format(), model.order_response_to_json),
//                     list_encoder_of(ndjson_format(), model.order_response_to_json),
//                     list_encoder_of(csv_format(), model.order_response_to_json)
//                 ],
//                 run: handle_list,
//                 api: api
//             )
//         },
//         server.Endpoint<Ctx> {
//             method: http.HttpMethod.Post,
//             pattern: "/api/orders",
//             handler: server.secure_body_handler(
//                 who: authenticated,
//                 decoders: [
//                     decoder_of(json_format(), model.order_request_from_json),
//                     decoder_of(yaml_format(), model.order_request_from_json)
//                 ],
//                 encoders: [
//                     encoder_of(json_format(), model.order_response_to_json),
//                     encoder_of(yaml_format(), model.order_response_to_json)
//                 ],
//                 status: 201,
//                 run: handle_create,
//                 api: api
//             )
//         },
//         server.Endpoint<Ctx> {
//             method: http.HttpMethod.Delete,
//             pattern: "/api/orders/{id}",
//             handler: server.secure_path_handler(
//                 who: authenticated,
//                 path: uuid_param("order"),
//                 encoders: [],
//                 status: 204,
//                 run: handle_delete,
//                 api: api
//             )
//         }
//     ]
//
// -- `secure_handler` versus `secure_body_handler` versus `secure_path_handler`, which builder each
// encoder needs, and `order_request_from_json`/`order_response_to_json` are all read off the
// handlers' signatures. What was written is the method, the path, the two statuses, the `"order"`
// label, and the `consumes:`/`produces:` that say which media types each endpoint speaks.
val sheet = template.must_parse("""
@template table
pub val @{module}_routes: [server.Endpoint<Ctx>] = [
@for e in endpoints
    server.Endpoint<Ctx> {
        method: http.HttpMethod.@{e.method},
        pattern: "@{e.path}",
        handler: server.@{e.flavour}(
@if e.secured
            who: @{e.who},
@end
@if e.has_path
            path: uuid_param("@{e.label}"),
@end
@if e.has_body
            decoders: @{e.decoders},
@end
            encoders: @{e.encoders},
@if e.has_status
            status: @{e.status},
@end
            run: @{e.run},
            api: api
        )
    }@{e.comma}
@end
]

@end
""")

pub fn attributes() -> [meta.AttrSpec] {
    return [
        meta.attr_spec(
            "route",
            "method:name,path:string,who:name?,status:int?,label:string?," \
                "consumes:string?,produces:string?",
            "function"
        )
    ]
}

pub fn generate_module(m: meta.ModuleTarget) -> Result<string, string> {
    val routed = meta.functions_with(m, "route")
    // A module carrying the attribute but no routed function writes nothing, which is a legitimate
    // answer rather than an error: the attribute may have been added before the handlers.
    if prelude.len(routed) == 0 {
        return ok("")
    }
    val rows = mutable_array_new<template.Row>()
    for i, f in routed {
        val last = i == prelude.len(routed) - 1
        push(rows, try row_for(f, m.name, if last { "" } else { "," }))
    }
    return template.render(sheet, "table", [
        template.text("module", m.name),
        template.rows("endpoints", snapshot(rows))
    ])
}

fn row_for(f: meta.Function, module_name: string, comma: string) -> Result<template.Row, string> {
    // Position 0 is the context. Position 1 is a `Principal` on a secured endpoint, and whatever
    // follows is the input: a `Uuid` is the path, a struct is the body.
    val secured = prelude.len(f.params) > 1 && is_principal(f.params[1].type)
    val first_input = if secured { 2 } else { 1 }
    var has_path = false
    var body = Option<string>.None
    for i in first_input..prelude.len(f.params) {
        val t = f.params[i].type
        if is_uuid(t) {
            has_path = true
        } else if Some(name) = named_of(t) {
            body = Option<string>.Some(name)
        }
    }
    val encoders = try encoders_for(f)
    var body_name = ""
    var decoders = "[]"
    if Some(name) = body {
        body_name = name
        decoders = try decoders_for(f, name)
    }
    return ok(template.row([
        template.text("method", capitalise(arg_or(f, "method", "GET"))),
        template.text("path", arg_or(f, "path", "/")),
        template.text("flavour", flavour(secured, has_path, Option.is_Some(body))),
        template.flag("secured", secured),
        template.text("who", arg_or(f, "who", "authenticated")),
        template.flag("has_path", has_path),
        template.text("label", arg_or(f, "label", replace(module_name, "_", " "))),
        template.flag("has_body", Option.is_Some(body)),
        template.text("body", body_name),
        template.text("decoders", decoders),
        template.text("encoders", encoders),
        template.flag("has_status", Option.is_Some(meta.fn_attr_arg(f, "route", "status"))),
        template.text("status", arg_or(f, "status", "")),
        template.text("run", f.name),
        template.text("comma", comma)
    ]))
}

// **`consumes:` and `produces:`, as Spring spells them**, naming `codec`'s formats: `"json"`,
// `"yaml"`, `"toml"`, `"ndjson"`, `"csv"`, `"xml"`, or `"all"` for every one the shape allows.
// Omitted means JSON, which is what every route wrote before these existed.
//
// **Which formats a shape allows is checked here, when the code is generated**, not at run time:
// a lone object cannot be NDJSON (a sequence of documents) or CSV (a table), and an array cannot
// be TOML (a document is a table at the top). Spring would accept `produces` it cannot honour and
// fail on the request; this refuses the attribute and names the format.
fn formats_named(spelt: string, allowed: [string], what: string, fn_name: string) -> Result<[string], string> {
    val wanted = mutable_array_new<string>()
    for piece in split(replace(spelt, ",", " "), " ") {
        val one = trim(piece)
        if prelude.len(one) == 0 {
            continue
        }
        // **`all` is every format the JSON derive already provides**, which is why XML is not in
        // it: `"all"` on a route whose model derives only `Json` must keep working, and including
        // XML would make the word demand a second derive of every type that used it.
        //
        // **It contributes to the list rather than replacing it**, which it did until 2026-10-31 --
        // `all` returned on the spot, so `produces: "all, xml"` silently dropped the `xml` and
        // offered four formats where five were asked for. Nothing wrote it before XML existed,
        // because `"all"` plus a name it already covered said nothing new.
        if one == "all" {
            for each in from_json_only(allowed) {
                add_once(wanted, each)
            }
            continue
        }
        if !contains(allowed, one) {
            return err(try refusal(one, allowed, what, fn_name))
        }
        add_once(wanted, one)
    }
    if prelude.len(wanted) == 0 {
        return ok(["json"])
    }
    return ok(snapshot(wanted))
}

// A format named twice -- `"all, json"`, or plain repetition -- is one encoder, not two. Negotiation
// takes the first match, so a duplicate was never wrong, only dead weight in generated code that
// someone has to read.
fn add_once(wanted: MutableArray<string>, one: string) {
    if !contains(wanted, one) {
        push(wanted, one)
    }
}

// **Two reasons a name is refused, and they are two different mistakes**: a format that exists but
// cannot carry this shape, and a word that is not a format at all. There were three until
// 2026-10-31 -- `"xml"` had its own message, because XML was a format this mechanism could not
// reach. `#[derive(Xml)]` made it reachable, so the message became an answer instead.
fn refusal(one: string, allowed: [string], what: string, fn_name: string) -> Result<string, string> {
    val subject = if what == "consumes" { "a request body" } else { "an answer" }
    if contains(known_formats(), one) {
        return ok(prelude.format(
            "#[route] on '{}' says {}: \"{}\", and {} cannot be written as {} -- it takes {}",
            fn_name,
            what,
            one,
            subject,
            one,
            join(separator: ", ", pieces: allowed)
        ))
    }
    return ok(prelude.format(
        "#[route] on '{}' says {}: \"{}\", which is not a format -- `codec`'s are {}, and {} " \
            "takes {}",
        fn_name,
        what,
        one,
        join(separator: ", ", pieces: known_formats()),
        subject,
        join(separator: ", ", pieces: allowed)
    ))
}

// Every format `codec` has, as `consumes:`/`produces:` spell them -- so a name that is one of
// these but wrong for the shape gets a different sentence from a name that is not one at all.
fn known_formats() -> [string] {
    return ["json", "yaml", "toml", "ndjson", "csv", "xml"]
}

// The formats a lone tree can be written as, and the ones an array can. **XML is in both**: it is
// not a tree format, but a document holds one object or a list of them equally well, and which it
// is here is decided by the signature rather than by the format.
fn tree_names() -> [string] {
    return ["json", "yaml", "toml", "xml"]
}

fn sequence_names() -> [string] {
    return ["json", "yaml", "ndjson", "csv", "xml"]
}

// What `"all"` expands to: the named formats minus the ones needing a derive of their own.
fn from_json_only(allowed: [string]) -> [string] {
    val out = mutable_array_new<string>()
    for one in allowed {
        if one != "xml" {
            push(out, one)
        }
    }
    return snapshot(out)
}

// The list literal the template drops in. One entry stays on its line; several wrap, because a
// route offering four formats otherwise writes a line nobody can read -- and generated code is
// read, by whoever is working out what an endpoint does.
fn as_list(items: [string]) -> string {
    if prelude.len(items) < 2 {
        return join(prefix: "[", suffix: "]", separator: ", ", pieces: items)
    }
    return join(
        prefix: "[\n                ",
        suffix: "\n            ]",
        separator: ",\n                ",
        pieces: items
    )
}

// What encodes the answer: the return type decides the shape and the builder, `produces:` the
// formats.
fn encoders_for(f: meta.Function) -> Result<string, string> {
    if ResultOf(r) = f.returns {
        if Array(inner) = r.ok {
            if Some(name) = named_of(inner) {
                val names = try formats_named(
                    arg_or(f, "produces", "json"),
                    sequence_names(),
                    "produces",
                    f.name
                )
                return ok(as_list(built(names, "list_encoder_of", name, "_to_json")))
            }
        }
        // A `unit` answer has no body, which is what a 204 means -- and nothing to negotiate, so
        // `produces:` on one is a mistake worth naming rather than ignoring.
        if Unit = r.ok {
            if Some(_) = meta.fn_attr_arg(f, "route", "produces") {
                return err(prelude.format(
                    "#[route] on '{}' says produces:, and it answers unit -- there is no body to " \
                        "encode, which is what its 204 means",
                    f.name
                ))
            }
            return ok("[]")
        }
        if Some(name) = named_of(r.ok) {
            val names = try formats_named(
                arg_or(f, "produces", "json"),
                tree_names(),
                "produces",
                f.name
            )
            return ok(as_list(built(names, "encoder_of", name, "_to_json")))
        }
    }
    return err(prelude.format(
        "#[route] on '{}' cannot see what encodes its answer: it has to return a Result whose " \
            "success is a struct, an array of one, or unit",
        f.name
    ))
}

// What decodes the body. A body is one value, so the tree formats are the candidates: CSV parses
// to an array and NDJSON to a sequence, neither of which is a lone model.
fn decoders_for(f: meta.Function, body: string) -> Result<string, string> {
    val names = try formats_named(arg_or(f, "consumes", "json"), tree_names(), "consumes", f.name)
    return ok(as_list(built(names, "decoder_of", body, "_from_json")))
}

// `decoder_of(json_format(), model.order_request_from_json)`, one per format named -- except XML,
// which is reached by its own builder.
fn built(names: [string], builder: string, type_name: string, suffix: string) -> [string] {
    val out = mutable_array_new<string>()
    for n in names {
        if n == "xml" {
            push(out, xml_built(builder, type_name))
        } else {
            push(out, concat(builder, "(", n, "_format(), ", json_stem(type_name), suffix, ")"))
        }
    }
    return snapshot(out)
}

// **XML passes no format, because there is no `xml_format()` to pass** -- it is not a
// `codec.TreeFormat` and deliberately never became one. So `codec` gives it three builders of its
// own that take the derived function directly, and this writes those.
//
// **The list case has to name the collection**, where a JSON array needs no name at all: a list
// has no element of its own, and `<orderResponseList><orderResponse/>..</orderResponseList>` is
// the shape a client reads. Each item keeps the element name its own `_to_xml` writes; the
// collection is that plus `List`, because **an English plural is not computable** --
// "person"/"people", "analysis"/"analyses" -- and a generator that guessed one would be wrong
// often and silently. Jackson's `XmlMapper` names the container after its class for the same
// reason. An endpoint that wants `<orders>` writes its own `codec.xml_list_encoder` and leaves
// `produces:` alone, which is what this attribute is a shortcut for rather than a replacement of.
fn xml_built(builder: string, type_name: string) -> string {
    val stem = json_stem(type_name)
    if builder == "decoder_of" {
        return concat("xml_decoder(", stem, "_from_xml)")
    }
    if builder == "list_encoder_of" {
        return concat("xml_list_encoder(\"", element_name(type_name), "List\", ", stem, "_to_xml)")
    }
    return concat("xml_encoder(", stem, "_to_xml)")
}

// The element `#[derive(Xml)]` names a value of this type after: `model.OrderResponse` ->
// `orderResponse`, the module qualifier dropped because an element name is not a Ziman name.
fn element_name(qualified: string) -> string {
    val parts = split(qualified, ".")
    return camel_case(snake_case(parts[prelude.len(parts) - 1]))
}

// The type as the source wrote it, which is what generated text repeats: `model.OrderResponse`
// stays qualified, because the generated code sits in the module that wrote that `use`.
fn named_of(t: meta.Type) -> Option<string> {
    if Named(n) = t {
        return Option<string>.Some(n.name)
    }
    return Option<string>.None
}

// `model.OrderResponse` -> `model.order_response`, the stem both derived JSON functions are named
// from. The qualifier passes through untouched; only the type's own name is recased.
fn json_stem(qualified: string) -> string {
    if prelude.len(qualified) == 0 {
        return ""
    }
    val parts = split(qualified, ".")
    val bare = parts[prelude.len(parts) - 1]
    val snake = snake_case(bare)
    if prelude.len(parts) == 1 {
        return snake
    }
    return concat(substring(qualified, 0, prelude.len(qualified) - prelude.len(bare)), snake)
}

// **By suffix, not by equality.** A loaded module's declarations are self-qualified, so the type
// arrives as `common::Principal` from one file and `common.Principal` from another.
fn is_principal(t: meta.Type) -> bool {
    if Some(name) = named_of(t) {
        return ends_with(name, "Principal")
    }
    return false
}

fn is_uuid(t: meta.Type) -> bool {
    if Some(name) = named_of(t) {
        return ends_with(name, "Uuid")
    }
    return false
}

fn arg_or(f: meta.Function, name: string, fallback: string) -> string {
    if Some(v) = meta.fn_attr_arg(f, "route", name) {
        return v
    }
    return fallback
}

// `secure_path_body_handler` and its seven siblings, named from the three facts that pick one.
fn flavour(secured: bool, has_path: bool, has_body: bool) -> string {
    val parts = mutable_array_new<string>()
    push(parts, if secured { "secure" } else { "public" })
    if has_path {
        push(parts, "path")
    }
    if has_body {
        push(parts, "body")
    }
    push(parts, "handler")
    return join(separator: "_", pieces: snapshot(parts))
}

// `GET` -> `Get`, which is how `http.HttpMethod`'s variants are spelled.
fn capitalise(word: string) -> string {
    if prelude.len(word) == 0 {
        return word
    }
    return concat(to_upper(substring(word, 0, 1)), to_lower(substring(word, 1, prelude.len(word))))
}
