// client.zm -- an HTTP/1.1 *client*, written in Ziman on top of `net`, so a Ziman program can
// call another service (the server side is `server`; the types they share are in `http`).
//
//   val r = client.get("https://example.com/api/items?limit=5")
//   val resp = client.request(method: HttpMethod.Post, url: u, body: "{\"a\":1}",
//                                 headers: [http.Header { name: "Content-Type", value: "application/json" }])
//
// `http://` and `https://` URLs (TLS with full certificate verification). What it does for you:
//   * keep-alive: an idle connection is reused for the next request to the same place (and a request
//     that finds the parked connection dead is sent again on a fresh one);
//   * compression: it asks for `gzip`/`deflate` and decodes the body (see `compress`);
//   * redirects: 301/302/303/307/308, up to `max_redirects` (default 5; 0 = don't follow); 303 and a
//     301/302 answering a POST are re-sent as GET without a body, and an `Authorization` header is not
//     sent to a different host;
//   * proxies: `HTTP_PROXY` / `HTTPS_PROXY` / `NO_PROXY` from the environment, or the `proxy` argument;
//     https goes through a CONNECT tunnel;
//   * cookies: with a `CookieJar` (`request_with_jar`), cookies a server sets are sent back;
//   * credentials in the URL (`https://user:pass@host/`) become a Basic `Authorization` header.
// Bodies are read by `Content-Length`, `Transfer-Encoding: chunked`, or until the server closes.
//
// A response comes back as an `http.Response` whose `body` is `[byte]`: images, files and other binary data as they are,
// and text through `http.response_text` (or `bytes_to_string`). **Any** status, including 404 or 500, is `Ok` -- an `Err`
// means the exchange itself failed (bad URL, network, timeout, malformed response, too large). Bodies are capped at 8 MiB
// after decompression (`TooLarge`). Not yet: request bodies streamed from a file, HTTP/2, streaming responses.

use clock.now_raw
use compress.decompress
use compress.inflate_raw
use crypto.base64_encode
use http.Header
use http.HttpMethod
use http.Response
use http.method_name
use http.percent_decode
use http.percent_encode
use mime
use net
use net.NetError
use net.Socket
use net.net_error_message
use number.int_from_hex
use os
use time.localdate_of
use time.localdate_to_epoch_day

// Why an exchange failed (any HTTP status, even 500, is a success).
pub enum ClientError {
    BadUrl(string)
    Network(string)
    Timeout
    BadResponse(string)
    TooLarge
    TooManyRedirects
}

// The error as one line of text, for logging or showing to a user. Named `client_error_message`,
// matching `net_error_message`/`db_error_message`/`jwt_error_message`'s own convention (and
// freeing the bare `error_message` name for the builtin of that name, which dispatches to this
// exact function for a `ClientError` -- see docs/DESIGN.md's "A unified error_message builtin").
pub fn client_error_message(e: ClientError) -> string {
    return switch e {
        BadUrl(text) { concat("bad URL: ", text) }
        Network(text) { text }
        Timeout { "request timed out" }
        BadResponse(text) { concat("bad response: ", text) }
        TooLarge { "response body is too large" }
        TooManyRedirects { "too many redirects" }
    }
}

// A parsed `http://` or `https://` URL. `target` is the path and query as they go on the request line
// ("/" if the URL has none); a #fragment is dropped; `userinfo` is the raw `user:password` before an
// `@` in the authority ("" if none).
pub struct Url {
    secure: bool
    host: string
    port: int
    target: string
    userinfo: string
}

val max_body_bytes = 8388608
val max_header_bytes = 65536
val default_timeout_ms = 30000
val read_chunk_bytes = 8192
val max_chunk_size_line_bytes = 1024
val max_port = 65535
val default_http_port = 80
val default_https_port = 443
val default_max_redirects = 5
val status_no_content = 204
val status_moved_permanently = 301
val status_found = 302
val status_see_other = 303
val status_not_modified = 304
val status_temporary_redirect = 307
val status_permanent_redirect = 308
val crlf: [byte] = [13b, 10b]
val crlf_crlf: [byte] = [13b, 10b, 13b, 10b]

// Parses an `http://` or `https://` URL. An Err says what is wrong: another scheme, a missing host, an
// unterminated `[` in an IPv6 host, a bad port.
pub fn parse_url(url: string) -> Result<Url, string> {
    var secure = false
    var rest = ""
    if starts_with(url, "http://") {
        rest = substring(url, 7, len(url))
    } else {
        if starts_with(url, "https://") {
            secure = true
            rest = substring(url, 8, len(url))
        } else {
            return err("only http:// and https:// URLs are supported")
        }
    }
    val no_fragment = split(rest, "#")[0]
    var authority = no_fragment
    var target = "/"
    val slash = index_of(no_fragment, "/", 0)
    val qmark = index_of(no_fragment, "?", 0)
    var cut = slash
    if cut < 0 || (qmark >= 0 && qmark < cut) {
        cut = qmark
    }
    if cut >= 0 {
        authority = substring(no_fragment, 0, cut)
        target = substring(no_fragment, cut, len(no_fragment))
        if !starts_with(target, "/") {
            target = concat("/", target)
        }
    }
    var userinfo = ""
    val at = last_index_of(authority, "@")
    if at >= 0 {
        userinfo = substring(authority, 0, at)
        authority = substring(authority, at + 1, len(authority))
    }
    if authority == "" {
        return err("missing host")
    }
    var host = authority
    var port = default_http_port
    if secure {
        port = default_https_port
    }
    var port_text = ""
    if starts_with(authority, "[") {
        val close = index_of(authority, "]", 0)
        if close < 0 {
            return err("unterminated [ in host")
        }
        host = substring(authority, 1, close)
        val after = substring(authority, close + 1, len(authority))
        if after != "" {
            if !starts_with(after, ":") {
                return err("unexpected text after ] in host")
            }
            port_text = substring(after, 1, len(after))
        }
    } else {
        val colon = last_index_of(authority, ":")
        if colon >= 0 {
            host = substring(authority, 0, colon)
            port_text = substring(authority, colon + 1, len(authority))
        }
    }
    if host == "" {
        return err("missing host")
    }
    if port_text != "" {
        val p = parse_int(port_text)
        if !is_ok(p) || unwrap(p) < 1 || unwrap(p) > max_port {
            return err(concat("invalid port: ", port_text))
        }
        port = unwrap(p)
    }
    return ok(Url { secure: secure, host: host, port: port, target: target, userinfo: userinfo })
}

// ------------------------------------------------------------ reading

fn lift<T>(r: Result<T, NetError>) -> Result<T, ClientError> {
    return switch r {
        Ok(v) { ok(v) }
        Err(e) {
            if NetError.is_Timeout(e) {
                return err(ClientError.Timeout)
            }
            return err(ClientError.Network(net_error_message(e)))
        }
    }
}

fn text_of(b: [byte]) -> Result<string, ClientError> {
    val s = bytes_to_string(b)
    if !is_ok(s) {
        return err(ClientError.BadResponse("body contains a NUL byte"))
    }
    return unwrap(s)
}

fn header_value(headers: [Header], name: string) -> Option<string> {
    for h in headers {
        if equals_ignore_case(h.name, name) {
            return Option<string>.Some(h.value)
        }
    }
    return Option<string>.None
}

// The first header called `name` (any case) of a response, or None.
pub fn response_header(r: Response, name: string) -> Option<string> {
    return header_value(r.headers, name)
}

// Reads at least one more byte from the socket onto `buf`.
fn more(sock: Socket, buf: [byte]) -> Result<[byte], ClientError> {
    return bytes_concat(buf, try lift<[byte]>(net.read(sock, read_chunk_bytes)))
}

// A status line and headers, and the bytes read past them.
struct Head {
    status: int
    status_line: string
    headers: [Header]
    rest: [byte]
}

// A body, and whether the connection can be reused afterwards (the body was framed by length, and
// nothing is left unread).
struct Body {
    bytes: [byte]
    clean: bool
}

// Reads a response head: everything up to the blank line, parsed. `first_byte_seen` is false until at
// least one byte arrived (a reused connection that answers with a close before any byte is retried).
fn read_head(sock: Socket) -> Result<Head, ClientError> {
    var buf: [byte] = []
    var head_end = -1
    while head_end < 0 {
        if len(buf) > max_header_bytes {
            return err(ClientError.BadResponse("response headers are too large"))
        }
        val step = try more(sock, buf)
        buf = step
        val at = bytes_index_of(buf, crlf_crlf, 0)
        head_end = if at < 0 { -1 } else { at + 4 }
    }
    val head = try text_of(slice<byte>(buf, 0, head_end - 4))
    val lines = split(head, "\r\n")
    val status_parts = split(lines[0], " ")
    if len(status_parts) < 2 || !starts_with(status_parts[0], "HTTP/1.") {
        return err(ClientError.BadResponse(concat("malformed status line: ", lines[0])))
    }
    val status_parsed = parse_int(status_parts[1])
    if !is_ok(status_parsed) {
        return err(ClientError.BadResponse(concat("malformed status line: ", lines[0])))
    }
    val headers = ab_new<Header>()
    var i = 1
    while i < len(lines) {
        val pair = split_once(lines[i], ":")
        if !Option.is_Some(pair) {
            return err(ClientError.BadResponse(concat("malformed header line: ", lines[i])))
        }
        ab_append(
            headers,
            Header { name: Option.unwrap_Some(pair)[0], value: trim(Option.unwrap_Some(pair)[1]) }
        )
        i = i + 1
    }
    return ok(Head {
        status: unwrap(status_parsed),
        status_line: lines[0],
        headers: ab_to_array(headers),
        rest: slice<byte>(buf, head_end, len(buf))
    })
}

// The body of a chunked response, through the last chunk and the trailers, so the connection is left
// at the start of whatever comes next. `start` holds what was already read past the head.
fn read_chunked(sock: Socket, start: [byte]) -> Result<Body, ClientError> {
    var buf = start
    val body = ab_new<byte>()
    var total = 0
    while true {
        var eol = bytes_index_of(buf, crlf, 0)
        while eol < 0 {
            if len(buf) > max_chunk_size_line_bytes {
                return err(ClientError.BadResponse("chunk size line is too long"))
            }
            val step = try more(sock, buf)
            buf = step
            eol = bytes_index_of(buf, crlf, 0)
        }
        val line = try text_of(slice<byte>(buf, 0, eol))
        val size_text = trim(split(line, ";")[0])
        val size_parsed = int_from_hex(size_text)
        if !is_ok(size_parsed) || unwrap(size_parsed) < 0 {
            return err(ClientError.BadResponse(concat("invalid chunk size: ", size_text)))
        }
        val size = unwrap(size_parsed)
        buf = slice<byte>(buf, eol + 2, len(buf))
        if size == 0 {
            var trailer_end = bytes_index_of(buf, crlf, 0)
            while trailer_end != 0 {
                while trailer_end < 0 {
                    if len(buf) > max_header_bytes {
                        return err(ClientError.BadResponse("response trailers are too large"))
                    }
                    val step = try more(sock, buf)
                    buf = step
                    trailer_end = bytes_index_of(buf, crlf, 0)
                }
                if trailer_end != 0 {
                    buf = slice<byte>(buf, trailer_end + 2, len(buf))
                    trailer_end = bytes_index_of(buf, crlf, 0)
                }
            }
            return ok(Body { bytes: ab_to_array(body), clean: len(buf) == 2 })
        }
        total = total + size
        if total > max_body_bytes {
            return err(ClientError.TooLarge)
        }
        while len(buf) < size + 2 {
            val step = try more(sock, buf)
            buf = step
        }
        ab_append(body, slice<byte>(buf, 0, size))
        buf = slice<byte>(buf, size + 2, len(buf))
    }
    return ok(Body { bytes: [], clean: false })
}

// A body that runs until the server closes the connection (so the connection cannot be reused).
fn read_to_close(sock: Socket, start: [byte]) -> Result<Body, ClientError> {
    val body = ab_new<byte>()
    ab_append(body, start)
    while true {
        if ab_len(body) > max_body_bytes {
            return err(ClientError.TooLarge)
        }
        val chunk = net.read(sock, read_chunk_bytes)
        if !is_ok(chunk) {
            val e = unwrap_err(chunk)
            if NetError.is_Closed(e) {
                return ok(Body { bytes: ab_to_array(body), clean: false })
            }
            if NetError.is_Timeout(e) {
                return err(ClientError.Timeout)
            }
            return err(ClientError.Network(net_error_message(e)))
        }
        ab_append(body, unwrap(chunk))
    }
    return err(ClientError.Timeout)
}

// Reads the body the head announces.
fn read_body(sock: Socket, head: Head, head_only: bool) -> Result<Body, ClientError> {
    val status = head.status
    val no_body = head_only || status < 200 || status == status_no_content || status == status_not_modified
    if no_body {
        return ok(Body { bytes: [], clean: len(head.rest) == 0 })
    }
    val te = header_value(head.headers, "Transfer-Encoding")
    val cl = header_value(head.headers, "Content-Length")
    if Some(te) = te && contains(to_lower(te), "chunked") {
        return read_chunked(sock, head.rest)
    }
    if Some(cl) = cl {
        val n = parse_int(trim(cl))
        if !is_ok(n) || unwrap(n) < 0 {
            return err(ClientError.BadResponse("invalid Content-Length"))
        }
        if unwrap(n) > max_body_bytes {
            return err(ClientError.TooLarge)
        }
        if unwrap(n) > len(head.rest) {
            return ok(Body {
                bytes: bytes_concat(head.rest, try lift<[byte]>(net.read_exact(sock, unwrap(n) - len(head.rest)))),
                clean: true
            })
        }
        return ok(Body { bytes: slice<byte>(head.rest, 0, unwrap(n)), clean: len(head.rest) == unwrap(n) })
    }
    return read_to_close(sock, head.rest)
}

// Undoes `Content-Encoding: gzip` / `deflate`, dropping the two headers the encoding made untrue. An
// encoding this client does not know is left alone.
fn decode_body(status: int, headers: [Header], body: [byte]) -> Result<Response, ClientError> {
    val enc = header_value(headers, "Content-Encoding")
    if !Option.is_Some(enc) || len(body) == 0 {
        return ok(Response { status: status, headers: headers, body: body })
    }
    val name = to_lower(trim(Option.unwrap_Some(enc)))
    if name != "gzip" && name != "x-gzip" && name != "deflate" {
        return ok(Response { status: status, headers: headers, body: body })
    }
    var decoded = decompress(body, max_body_bytes)
    if !is_ok(decoded) && name == "deflate" && unwrap_err(decoded) == "compressed data is corrupt" {
        decoded = inflate_raw(body, max_body_bytes)
    }
    if !is_ok(decoded) {
        val why = unwrap_err(decoded)
        if why == "decompressed data is too large" {
            return err(ClientError.TooLarge)
        }
        return err(ClientError.BadResponse(format("cannot decode {} body: {}", name, why)))
    }
    val kept = ab_new<Header>()
    for h in headers {
        val lname = to_lower(h.name)
        if lname != "content-encoding" && lname != "content-length" {
            ab_append(kept, h)
        }
    }
    return ok(Response { status: status, headers: ab_to_array(kept), body: unwrap(decoded) })
}

// ------------------------------------------------------------ proxies

// The proxy to use for `u`: `explicit` if given ("" means none at all), else the environment
// (`HTTPS_PROXY` for https, `HTTP_PROXY` for http, either case), skipped for hosts `NO_PROXY` lists.
fn proxy_for(u: Url, explicit: Option<string>) -> Result<Option<Url>, ClientError> {
    var text = ""
    if Some(t) = explicit {
        text = t
    } else {
        val upper = os.getenv(if u.secure { "HTTPS_PROXY" } else { "HTTP_PROXY" })
        val lower = os.getenv(if u.secure { "https_proxy" } else { "http_proxy" })
        text = option_unwrap_or<string>(upper, option_unwrap_or<string>(lower, ""))
        if len(text) > 0 && no_proxy_matches(u.host) {
            text = ""
        }
    }
    if len(text) == 0 {
        return ok(Option<Url>.None)
    }
    val parsed = parse_url(if contains(text, "://") { text } else { concat("http://", text) })
    if !is_ok(parsed) {
        return err(ClientError.BadUrl(concat("proxy: ", unwrap_err(parsed))))
    }
    if unwrap(parsed).secure {
        return err(ClientError.BadUrl("proxy: an https:// proxy is not supported (use http://)"))
    }
    return ok(Option<Url>.Some(unwrap(parsed)))
}

// True if `NO_PROXY` (a comma-separated list of hosts, `.suffixes` and `*`) covers `host`.
fn no_proxy_matches(host: string) -> bool {
    val upper = os.getenv("NO_PROXY")
    val list = option_unwrap_or<string>(upper, option_unwrap_or<string>(os.getenv("no_proxy"), ""))
    for raw in split(list, ",") {
        val entry = to_lower(trim(raw))
        if entry == "*" {
            return true
        }
        if len(entry) > 0 {
            val bare = if starts_with(entry, ".") { substring(entry, 1, len(entry)) } else { entry }
            if to_lower(host) == bare || ends_with(to_lower(host), concat(".", bare)) {
                return true
            }
        }
    }
    return false
}

// ------------------------------------------------------------ sending

fn host_header(u: Url) -> string {
    var host = u.host
    if contains(host, ":") {
        host = format("[{}]", host)
    }
    return if (u.secure && u.port == default_https_port) || (!u.secure && u.port == default_http_port) {
        host
    } else {
        format("{}:{}", host, u.port)
    }
}

// `Basic base64(user:password)` for the raw `user:password` of a URL or proxy (percent-decoded).
fn basic_auth(userinfo: string) -> string {
    val decoded = percent_decode(userinfo, false)
    return concat("Basic ", base64_encode(string_to_bytes(if is_ok(decoded) { unwrap(decoded) } else { userinfo })))
}

// Where connections to `u` are parked for reuse: the scheme, host and port, and the proxy if any.
fn cache_key(u: Url, proxy: Option<Url>) -> string {
    val base = format("{}://{}:{}", if u.secure { "https" } else { "http" }, u.host, u.port)
    return switch proxy {
        Some(p) { format("{} via {}:{}", base, p.host, p.port) }
        None { base }
    }
}

fn fail_closed(s: Socket, e: ClientError) -> Result<Socket, ClientError> {
    net.close(s)
    return err(e)
}

// Connects to `u`, directly or through `proxy` (an https target through a CONNECT tunnel).
fn open_socket(u: Url, proxy: Option<Url>, ca_file: Option<string>, timeout_ms: int) -> Result<Socket, ClientError> {
    if !Option.is_Some(proxy) {
        val direct = try lift<Socket>(if u.secure {
            net.connect_tls_with(u.host, u.port, net.TlsVerify.Full, ca_file)
        } else {
            net.connect(u.host, u.port)
        })
        return ok(direct)
    }
    val p = Option.unwrap_Some(proxy)
    val sock = try lift<Socket>(net.connect(p.host, p.port))
    if !u.secure {
        return ok(sock)
    }
    val timeout_set = net.set_timeout(sock, timeout_ms)
    val target = format("{}:{}", u.host, u.port)
    val request = format(
        "CONNECT {} HTTP/1.1\r\nHost: {}\r\n{}\r\n",
        target,
        target,
        if len(p.userinfo) > 0 { format("Proxy-Authorization: {}\r\n", basic_auth(p.userinfo)) } else { "" }
    )
    val sent = lift<int>(net.write_text(sock, request))
    if !is_ok(sent) {
        return fail_closed(sock, unwrap_err(sent))
    }
    val head = read_head(sock)
    if !is_ok(head) {
        return fail_closed(sock, unwrap_err(head))
    }
    if unwrap(head).status != 200 {
        return fail_closed(sock, ClientError.Network(format("proxy refused the tunnel: {}", unwrap(head).status_line)))
    }
    return switch lift<unit>(net.start_tls_with(sock, u.host, net.TlsVerify.Full, ca_file)) {
        Ok(_) { ok(sock) }
        Err(e) { fail_closed(sock, e) }
    }
}

// What one exchange produced: the response, and whether the connection is fit for reuse.
struct Reply {
    response: Response
    reusable: bool
}

// Writes a request on `s`: the request line, the headers this client always sets, the caller's headers,
// and the body.
fn write_request(
    s: Socket,
    method: HttpMethod,
    u: Url,
    proxy: Option<Url>,
    headers: [Header],
    body: Option<[byte]>,
    want_compression: bool,
    keep_alive: bool
) -> Result<int, ClientError> {
    val via_http_proxy = Option.is_Some(proxy) && !u.secure
    val request_target = if via_http_proxy {
        format("http://{}{}", host_header(u), u.target)
    } else {
        u.target
    }
    val out = ab_new<string>()
    ab_append(out, format("{} {} HTTP/1.1\r\n", method_name(method), request_target))
    var has_ua = false
    var has_accept = false
    var has_encoding = false
    var has_auth = false
    for h in headers {
        val lname = to_lower(h.name)
        if lname == "user-agent" {
            has_ua = true
        }
        if lname == "accept" {
            has_accept = true
        }
        if lname == "accept-encoding" {
            has_encoding = true
        }
        if lname == "authorization" {
            has_auth = true
        }
        if lname != "host" && lname != "content-length" && lname != "connection" {
            ab_append(out, format("{}: {}\r\n", h.name, h.value))
        }
    }
    ab_append(out, format("Host: {}\r\n", host_header(u)))
    if !has_ua {
        ab_append(out, "User-Agent: ziman\r\n")
    }
    if !has_accept {
        ab_append(out, "Accept: */*\r\n")
    }
    if !has_encoding {
        ab_append(
            out,
            if want_compression { "Accept-Encoding: gzip, deflate\r\n" } else { "Accept-Encoding: identity\r\n" }
        )
    }
    if !has_auth && len(u.userinfo) > 0 {
        ab_append(out, format("Authorization: {}\r\n", basic_auth(u.userinfo)))
    }
    if via_http_proxy && Option.unwrap_Some(proxy).userinfo != "" {
        ab_append(
            out,
            format("Proxy-Authorization: {}\r\n", basic_auth(Option.unwrap_Some(proxy).userinfo))
        )
    }
    ab_append(out, if keep_alive { "Connection: keep-alive\r\n" } else { "Connection: close\r\n" })
    if Some(body) = body {
        ab_append(out, format("Content-Length: {}\r\n", len(body)))
    } else {
        if method == HttpMethod.Post || method == HttpMethod.Put || method == HttpMethod.Patch {
            ab_append(out, "Content-Length: 0\r\n")
        }
    }
    ab_append(out, "\r\n")
    try lift<int>(net.write_text(s, join(pieces: ab_to_array(out), separator: "")))
    if Some(body) = body && len(body) > 0 {
        try lift<int>(net.write(s, body))
    }
    return ok(0)
}

// Writes the request on `s` and reads the response.
fn exchange(
    s: Socket,
    method: HttpMethod,
    u: Url,
    proxy: Option<Url>,
    headers: [Header],
    body: Option<[byte]>,
    want_compression: bool,
    keep_alive: bool
) -> Result<Reply, ClientError> {
    try write_request(s, method, u, proxy, headers, body, want_compression, keep_alive)
    val head = try read_head(s)
    val payload = try read_body(s, head, method == HttpMethod.Head)
    val decoded = try decode_body(head.status, head.headers, payload.bytes)
    val connection = header_value(head.headers, "Connection")
    val server_closes = switch connection {
        Some(c) { contains(to_lower(c), "close") }
        None { false }
    }
    val http_1_1 = starts_with(head.status_line, "HTTP/1.1")
    return ok(Reply { response: decoded, reusable: payload.clean && !server_closes && http_1_1 && keep_alive })
}

fn take_or_open(
    parked: Option<Socket>,
    u: Url,
    proxy: Option<Url>,
    ca_file: Option<string>,
    timeout_ms: int
) -> Result<Socket, ClientError> {
    if Some(sock) = parked {
        return ok(sock)
    }
    return open_socket(u, proxy, ca_file, timeout_ms)
}

// One request on one connection: a parked one if `reuse` and there is one (retrying on a fresh
// connection if it turns out to be dead), else a new one. The connection is parked again when the
// exchange left it clean.
fn send_once(
    method: HttpMethod,
    u: Url,
    proxy: Option<Url>,
    headers: [Header],
    body: Option<[byte]>,
    timeout_ms: int,
    ca_file: Option<string>,
    want_compression: bool,
    reuse: bool
) -> Result<Response, ClientError> {
    val key = cache_key(u, proxy)
    var attempt = 0
    while attempt < 2 {
        val parked = if reuse && attempt == 0 { net.idle_take(key) } else { Option<Socket>.None }
        val reused = Option.is_Some(parked)
        val sock = take_or_open(parked, u, proxy, ca_file, timeout_ms)
        if !is_ok(sock) {
            return err(unwrap_err(sock))
        }
        val s = unwrap(sock)
        val timeout_set = net.set_timeout(s, timeout_ms)
        val result = exchange(s, method, u, proxy, headers, body, want_compression, reuse)
        if is_ok(result) {
            val reply = unwrap(result)
            if reply.reusable && reuse {
                net.idle_put(key, s)
            } else {
                net.close(s)
            }
            return ok(reply.response)
        }
        net.close(s)
        val why = unwrap_err(result)
        if !(reused && ClientError.is_Network(why)) {
            return err(why)
        }
        attempt = attempt + 1
    }
    return err(ClientError.Network("the connection was closed"))
}

// Closes every parked keep-alive connection.
pub fn close_idle() {
    net.idle_clear()
}

fn location_of(r: Response) -> Option<string> {
    return header_value(r.headers, "Location")
}

// Resolves a redirect's Location against the URL it came from: an absolute URL, a path ("/x"), or
// (rare) a relative one ("x", resolved against the directory).
fn resolve_location(base: Url, location: string) -> Result<Url, string> {
    if starts_with(location, "http://") || starts_with(location, "https://") {
        return parse_url(location)
    }
    val scheme = if base.secure { "https" } else { "http" }
    val authority = host_header(base)
    if starts_with(location, "//") {
        return parse_url(format("{}:{}", scheme, location))
    }
    if starts_with(location, "/") {
        return parse_url(format("{}://{}{}", scheme, authority, location))
    }
    val path_only = split(split(base.target, "?")[0], "#")[0]
    val dir_end = last_index_of(path_only, "/")
    return parse_url(format("{}://{}{}{}", scheme, authority, substring(path_only, 0, dir_end + 1), location))
}

// ------------------------------------------------------------ cookies
//
// A `CookieJar` is a value: `request_with_jar` takes one and returns the updated one (the jar you
// passed is unchanged), so keep the newest. It follows RFC 6265 for what matters in practice: `Domain`
// (a suffix match; without it the cookie is for that host only), `Path`, `Secure` (only sent over
// https), `Max-Age` and `Expires` (an expired cookie removes the one it replaces), session cookies.
// `HttpOnly` and `SameSite` are ignored (they govern browsers).

// One stored cookie. `expires` is seconds since the epoch, -1 for a session cookie.
pub struct Cookie {
    name: string
    value: string
    domain: string
    path: string
    secure: bool
    host_only: bool
    expires: int
}

// The cookies a client is holding, passed to `request_with_jar` and returned updated. Make an
// empty one with `cookie_jar()`.
pub struct CookieJar {
    cookies: [Cookie]
}

// A jar with no cookies.
pub fn cookie_jar() -> CookieJar {
    return CookieJar { cookies: [] }
}

// A response together with the cookie jar as the exchange left it.
pub struct JarResponse {
    response: Response
    jar: CookieJar
}

// The directory of a request target: "/a/b?x" is "/a", "/x" is "/".
fn default_path(target: string) -> string {
    val path = split(target, "?")[0]
    val slash = last_index_of(path, "/")
    return if slash <= 0 { "/" } else { substring(path, 0, slash) }
}

val month_names: [string] = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]

// Seconds since the epoch of an HTTP date ("Thu, 24 Sep 2026 12:00:00 GMT", also with dashes), or -1.
fn parse_http_date(text: string) -> int {
    val parts = split(replace(trim(text), "-", " "), " ")
    val fields = ab_new<string>()
    for p in parts {
        if len(p) > 0 {
            ab_append(fields, p)
        }
    }
    val f = ab_to_array(fields)
    if len(f) < 5 {
        return -1
    }
    val day = parse_int(f[1])
    val year_parsed = parse_int(f[3])
    val clock_parts = split(f[4], ":")
    if !is_ok(day) || !is_ok(year_parsed) || len(clock_parts) != 3 {
        return -1
    }
    var month = 0
    for i in 0..12 {
        if to_lower(substring(f[2], 0, 3)) == month_names[i] {
            month = i + 1
        }
    }
    val hh = parse_int(clock_parts[0])
    val mm = parse_int(clock_parts[1])
    val ss = parse_int(clock_parts[2])
    if month == 0 || !is_ok(hh) || !is_ok(mm) || !is_ok(ss) {
        return -1
    }
    var year = unwrap(year_parsed)
    if year < 100 {
        year = if year < 70 { 2000 + year } else { 1900 + year }
    }
    val date = localdate_of(year, month, unwrap(day))
    if !is_ok(date) {
        return -1
    }
    return localdate_to_epoch_day(unwrap(date)) * 86400 + unwrap(hh) * 3600 + unwrap(mm) * 60 + unwrap(ss)
}

// A `Set-Cookie` header value as a cookie set by the response to a request for `u` (None if it is
// malformed or names another domain).
fn parse_set_cookie(value: string, u: Url, now: int) -> Option<Cookie> {
    val pieces = split(value, ";")
    val name_value = split_once(trim(pieces[0]), "=")
    if !Option.is_Some(name_value) || len(Option.unwrap_Some(name_value)[0]) == 0 {
        return Option<Cookie>.None
    }
    var domain = to_lower(u.host)
    var host_only = true
    var path = default_path(u.target)
    var secure = false
    var expires = -1
    var max_age_seen = false
    for i in 1..len(pieces) {
        val attr = trim(pieces[i])
        val kv = split_once(attr, "=")
        val key = to_lower(switch kv {
            Some(pair) { pair[0] }
            None { attr }
        })
        val val_text = switch kv {
            Some(pair) { trim(pair[1]) }
            None { "" }
        }
        if key == "domain" && len(val_text) > 0 {
            val wanted = to_lower(if starts_with(
                val_text,
                "."
            ) { substring(val_text, 1, len(val_text)) } else { val_text })
            if wanted != domain && !ends_with(domain, concat(".", wanted)) {
                return Option<Cookie>.None
            }
            domain = wanted
            host_only = false
        } else if key == "path" && starts_with(val_text, "/") {
            path = val_text
        } else if key == "secure" {
            secure = true
        } else if key == "max-age" {
            val n = parse_int(val_text)
            if is_ok(n) {
                expires = now + unwrap(n)
                max_age_seen = true
            }
        } else if key == "expires" && !max_age_seen {
            expires = parse_http_date(val_text)
        }
    }
    return Option<Cookie>.Some(Cookie {
        name: trim(Option.unwrap_Some(name_value)[0]),
        value: trim(Option.unwrap_Some(name_value)[1]),
        domain: domain,
        path: path,
        secure: secure,
        host_only: host_only,
        expires: expires
    })
}

fn same_cookie(a: Cookie, b: Cookie) -> bool {
    return a.name == b.name && a.domain == b.domain && a.path == b.path
}

// The jar with the cookies in a response's `Set-Cookie` headers stored (replacing ones of the same
// name, domain and path; an already expired one deletes it). `u` is the URL that was requested.
pub fn jar_store(jar: CookieJar, u: Url, headers: [Header]) -> CookieJar {
    val now = now_raw()[0]
    var current = jar.cookies
    for h in headers {
        if equals_ignore_case(h.name, "Set-Cookie") {
            if Some(c) = parse_set_cookie(h.value, u, now) {
                val kept = ab_new<Cookie>()
                for old in current {
                    if !same_cookie(old, c) && (old.expires < 0 || old.expires > now) {
                        ab_append(kept, old)
                    }
                }
                if c.expires < 0 || c.expires > now {
                    ab_append(kept, c)
                }
                current = ab_to_array(kept)
            }
        }
    }
    return CookieJar { cookies: current }
}

fn cookie_matches(c: Cookie, u: Url, now: int) -> bool {
    if c.expires >= 0 && c.expires <= now {
        return false
    }
    if c.secure && !u.secure {
        return false
    }
    val host = to_lower(u.host)
    val domain_ok = if c.host_only { host == c.domain } else { host == c.domain || ends_with(
        host,
        concat(".", c.domain)
    ) }
    if !domain_ok {
        return false
    }
    val path = split(u.target, "?")[0]
    if c.path == path || c.path == "/" {
        return true
    }
    return starts_with(path, c.path) && (ends_with(c.path, "/") || is_char_at(path, len(c.path), "/"))
}

// The `Cookie` header value for a request to `u` -- `a=1; b=2` -- from the jar's matching cookies (longer
// paths first), or None if none match.
pub fn jar_header(jar: CookieJar, u: Url) -> Option<string> {
    val now = now_raw()[0]
    val chosen = ab_new<Cookie>()
    for c in jar.cookies {
        if cookie_matches(c, u, now) {
            ab_append(chosen, c)
        }
    }
    val matched = ab_to_array(chosen)
    if len(matched) == 0 {
        return Option<string>.None
    }
    val ordered = sort_matches(matched)
    val parts = ab_new<string>()
    for c in ordered {
        ab_append(parts, format("{}={}", c.name, c.value))
    }
    return Option<string>.Some(join(separator: "; ", pieces: ab_to_array(parts)))
}

// Stable order: longer paths first.
fn sort_matches(cookies: [Cookie]) -> [Cookie] {
    val lengths = ab_new<int>()
    for c in cookies {
        ab_append(lengths, len(c.path))
    }
    return permute<Cookie>(cookies, sort_scalar_order<int>(ab_to_array(lengths), true))
}

// ------------------------------------------------------------ requests

// What a finished exchange (following redirects) produced.
struct Outcome {
    response: Response
    jar: CookieJar
}

// The engine behind every request function: redirects, cookies, credentials, proxies.
fn run(
    method: HttpMethod,
    url: string,
    headers: [Header],
    body: Option<[byte]>,
    timeout: int,
    limit: int,
    ca_file: Option<string>,
    proxy_arg: Option<string>,
    want_compression: bool,
    reuse: bool,
    jar: CookieJar
) -> Result<Outcome, ClientError> {
    val parsed = parse_url(url)
    if !is_ok(parsed) {
        return err(ClientError.BadUrl(unwrap_err(parsed)))
    }
    var current = unwrap(parsed)
    var m = method
    var b = body
    var hs = headers
    var cookies = jar
    var hops = 0
    while true {
        val proxy = try proxy_for(current, proxy_arg)
        val cookie_value = jar_header(cookies, current)
        val sent_headers = switch cookie_value {
            Some(v) {
                if Option.is_Some(header_value(hs, "Cookie")) { hs } else { push(
                    hs,
                    Header { name: "Cookie", value: v }
                ) }
            }
            None { hs }
        }
        val resp = try send_once(m, current, proxy, sent_headers, b, timeout, ca_file, want_compression, reuse)
        cookies = jar_store(cookies, current, resp.headers)
        val s = resp.status
        val redirect = s == status_moved_permanently || s == status_found || s == status_see_other || s == status_temporary_redirect ||
            s == status_permanent_redirect
        if !redirect || limit == 0 || !Option.is_Some(location_of(resp)) {
            return ok(Outcome { response: resp, jar: cookies })
        }
        if hops >= limit {
            return err(ClientError.TooManyRedirects)
        }
        val next = resolve_location(current, Option.unwrap_Some(location_of(resp)))
        if !is_ok(next) {
            return err(ClientError.BadResponse(concat("bad redirect location: ", unwrap_err(next))))
        }
        val moved_away = unwrap(next).host != current.host || unwrap(next).port != current.port || unwrap(next).secure != current.secure
        if moved_away {
            val kept = ab_new<Header>()
            for h in hs {
                if !equals_ignore_case(h.name, "Authorization") && !equals_ignore_case(h.name, "Cookie") {
                    ab_append(kept, h)
                }
            }
            hs = ab_to_array(kept)
        }
        current = unwrap(next)
        if s == status_see_other || ((s == status_moved_permanently || s == status_found) && m == HttpMethod.Post) {
            m = HttpMethod.Get
            b = Option<[byte]>.None
        }
        hops = hops + 1
    }
    return err(ClientError.TooManyRedirects)
}

// Sends one request and returns the (final) response, its body as bytes.
//   method        an `http.HttpMethod` (`HttpMethod.Get`, `HttpMethod.Post`, ...)
//   headers       extra request headers; Host, Content-Length and Connection are always set by the client
//   body          the request body, if any, as bytes (`string_to_bytes(text)` for text)
//   timeout_ms    per read/write, default 30000
//   max_redirects redirects to follow, default 5 (0 = return the 3xx as it is)
//   ca_file       a PEM file of trusted CAs for https, instead of the system store (a private CA, a test
//                 certificate); the certificate is always verified
//   proxy         a proxy URL (`http://host:port`, optionally `user:pass@`); "" for none; if omitted, the
//                 `HTTP_PROXY` / `HTTPS_PROXY` / `NO_PROXY` environment variables decide
//   compress      ask for gzip/deflate and decode the body (default true)
//   reuse         keep the connection for the next request to the same place (default true)
pub fn request(
    method: HttpMethod,
    url: string,
    headers: Option<[Header]>,
    body: Option<[byte]>,
    timeout_ms: Option<int>,
    max_redirects: Option<int>,
    ca_file: Option<string>,
    proxy: Option<string>,
    compress: Option<bool>,
    reuse: Option<bool>
) -> Result<Response, ClientError> {
    val outcome = try run(
        method,
        url,
        option_unwrap_or<[Header]>(headers, []),
        body,
        option_unwrap_or<int>(timeout_ms, default_timeout_ms),
        option_unwrap_or<int>(max_redirects, default_max_redirects),
        ca_file,
        proxy,
        option_unwrap_or<bool>(compress, true),
        option_unwrap_or<bool>(reuse, true),
        cookie_jar()
    )
    return ok(outcome.response)
}

// `request`, with cookies: the jar's matching cookies are sent (on every redirect hop too), and the
// cookies the responses set are stored. Returns the response and the updated jar; pass that jar to the
// next call to stay "logged in". Other arguments as for `request`.
pub fn request_with_jar(
    jar: CookieJar,
    method: HttpMethod,
    url: string,
    headers: Option<[Header]>,
    body: Option<[byte]>,
    timeout_ms: Option<int>,
    max_redirects: Option<int>,
    ca_file: Option<string>,
    proxy: Option<string>,
    compress: Option<bool>,
    reuse: Option<bool>
) -> Result<JarResponse, ClientError> {
    val outcome = try run(
        method,
        url,
        option_unwrap_or<[Header]>(headers, []),
        body,
        option_unwrap_or<int>(timeout_ms, default_timeout_ms),
        option_unwrap_or<int>(max_redirects, default_max_redirects),
        ca_file,
        proxy,
        option_unwrap_or<bool>(compress, true),
        option_unwrap_or<bool>(reuse, true),
        jar
    )
    return ok(JarResponse { response: outcome.response, jar: outcome.jar })
}

// GET `url`.
pub fn get(url: string) -> Result<Response, ClientError> {
    return request(method: HttpMethod.Get, url: url)
}

// HEAD `url`: the status and headers, no body.
pub fn head(url: string) -> Result<Response, ClientError> {
    return request(method: HttpMethod.Head, url: url)
}

// DELETE `url`.
pub fn delete(url: string) -> Result<Response, ClientError> {
    return request(method: HttpMethod.Delete, url: url)
}

// POST with a JSON body: sets `Content-Type: application/json`.
pub fn post_json(url: string, body: string) -> Result<Response, ClientError> {
    return request(
        method: HttpMethod.Post,
        url: url,
        body: string_to_bytes(body),
        headers: [Header { name: "Content-Type", value: mime.to_string(mime.application_json()) }]
    )
}

// PUT with a JSON body: sets `Content-Type: application/json`.
pub fn put_json(url: string, body: string) -> Result<Response, ClientError> {
    return request(
        method: HttpMethod.Put,
        url: url,
        body: string_to_bytes(body),
        headers: [Header { name: "Content-Type", value: mime.to_string(mime.application_json()) }]
    )
}

// The fields as an `application/x-www-form-urlencoded` body: `a=1&b=x+y`, names and values
// percent-encoded, in the map's insertion order.
pub fn form_encode(fields: Map<string, string>) -> string {
    val parts = ab_new<string>()
    for name, value in fields {
        ab_append(parts, format("{}={}", percent_encode(name, true), percent_encode(value, true)))
    }
    return join(separator: "&", pieces: ab_to_array(parts))
}

// POST an HTML-form-style body built from `fields` (`Content-Type: application/x-www-form-urlencoded`).
pub fn post_form(url: string, fields: Map<string, string>) -> Result<Response, ClientError> {
    return request(
        method: HttpMethod.Post,
        url: url,
        body: string_to_bytes(form_encode(fields)),
        headers: [Header { name: "Content-Type", value: mime.to_string(mime.application_form()) }]
    )
}

// ---------------------------------------------------------------- streaming a response body

// A response whose body has not been read yet: the status and headers, and the body as an `Iter` of blocks
// of bytes read as a `for` loop asks for them.
pub struct StreamResponse {
    status: int
    headers: [Header]
    body: Iter<Result<[byte], ClientError>>
}

// How the body is framed, and how much of it is left, for the streaming reader. `mode` is 0 for a body of
// known length (`left` bytes remain), 1 for a chunked one (`left` bytes remain in the current chunk;
// `after_chunk` means the CRLF that ends a chunk is still to be read) and 2 for one that runs until the
// server closes. `buffer` holds bytes already read but not yet handed out.
struct BodyState {
    buffer: [byte]
    mode: int
    left: int
    after_chunk: bool
    finished: bool
}

fn body_block(bytes: [byte]) -> Option<Result<[byte], ClientError>> {
    val block: Result<[byte], ClientError> = bytes
    return Option<Result<[byte], ClientError>>.Some(block)
}

fn body_failure(e: ClientError) -> Option<Result<[byte], ClientError>> {
    val failure: Result<[byte], ClientError> = e
    return Option<Result<[byte], ClientError>>.Some(failure)
}

fn body_end() -> Option<Result<[byte], ClientError>> {
    return Option<Result<[byte], ClientError>>.None
}

// The next piece of the body: up to `read_chunk_bytes` of what remains, from the buffer or the socket.
fn next_body_block(s: Socket, cell: Channel<BodyState>) -> Option<Result<[byte], ClientError>> {
    val st = receive(cell)
    if st.finished {
        send(cell, st)
        return body_end()
    }
    val finished = BodyState { buffer: [], mode: st.mode, left: 0, after_chunk: false, finished: true }
    if st.mode == 1 && st.left == 0 {
        // between chunks: the CRLF that ended the last one, then the next size line
        var buf = st.buffer
        if st.after_chunk {
            while len(buf) < 2 {
                val more_bytes = more(s, buf)
                if !is_ok(more_bytes) {
                    send(cell, finished)
                    return body_failure(unwrap_err(more_bytes))
                }
                buf = unwrap(more_bytes)
            }
            buf = slice<byte>(buf, 2, len(buf))
        }
        var eol = bytes_index_of(buf, crlf, 0)
        while eol < 0 {
            if len(buf) > max_chunk_size_line_bytes {
                send(cell, finished)
                return body_failure(ClientError.BadResponse("chunk size line is too long"))
            }
            val more_bytes = more(s, buf)
            if !is_ok(more_bytes) {
                send(cell, finished)
                return body_failure(unwrap_err(more_bytes))
            }
            buf = unwrap(more_bytes)
            eol = bytes_index_of(buf, crlf, 0)
        }
        val line = text_of(slice<byte>(buf, 0, eol))
        if !is_ok(line) {
            send(cell, finished)
            return body_failure(unwrap_err(line))
        }
        val size_text = trim(split(unwrap(line), ";")[0])
        val size = int_from_hex(size_text)
        if !is_ok(size) || unwrap(size) < 0 {
            send(cell, finished)
            return body_failure(ClientError.BadResponse(concat("invalid chunk size: ", size_text)))
        }
        buf = slice<byte>(buf, eol + 2, len(buf))
        if unwrap(size) == 0 {
            send(cell, finished)
            return body_end()
        }
        send(cell, BodyState { buffer: buf, mode: 1, left: unwrap(size), after_chunk: false, finished: false })
        return next_body_block(s, cell)
    }
    if st.mode != 2 && st.left == 0 {
        send(cell, finished)
        return body_end()
    }
    // hand out buffered bytes first, else read
    var block = st.buffer
    var rest: [byte] = []
    if len(block) == 0 {
        val got = net.read(s, read_chunk_bytes)
        if !is_ok(got) {
            val e = unwrap_err(got)
            send(cell, finished)
            if st.mode == 2 && NetError.is_Closed(e) {
                return body_end()
            }
            if NetError.is_Timeout(e) {
                return body_failure(ClientError.Timeout)
            }
            return body_failure(ClientError.Network(net_error_message(e)))
        }
        block = unwrap(got)
    }
    if st.mode != 2 && len(block) > st.left {
        rest = slice<byte>(block, st.left, len(block))
        block = slice<byte>(block, 0, st.left)
    }
    var left = st.left - len(block)
    if st.mode == 2 {
        left = 0
    }
    send(cell, BodyState {
        buffer: rest,
        mode: st.mode,
        left: left,
        after_chunk: st.mode == 1 && left == 0,
        finished: false
    })
    return body_block(block)
}

// Sends one request and returns the status and headers as soon as they arrive, with the body left on the
// connection to be read lazily -- for a large download, or a response that never ends. The body is an
// `Iter` of `Result<[byte], ClientError>` blocks of at most 8192 bytes, read as a `for` loop asks for
// them: `val r = try client.stream(method: HttpMethod.Get, url: u)` then `for block in r.body { val bytes =
// try block ... }`. A read error, or a timeout waiting for the next block, is a last Err item. The body comes
// as sent: this asks for no compression (`Accept-Encoding: identity`), and a server that compresses anyway
// is not decoded. No redirects are followed and no cookies are sent (a 3xx is returned as it is), nothing
// is limited to 8 MiB, and the connection is not reused: it is closed when the body is finished, when the
// loop is left early or with `iter_close(r.body)`, and a stream dropped unfinished is closed when its
// socket is collected. Arguments as for `request`: `headers`, `body`, `timeout_ms`, `ca_file`,
// `proxy`.
pub fn stream(
    method: HttpMethod,
    url: string,
    headers: Option<[Header]>,
    body: Option<[byte]>,
    timeout_ms: Option<int>,
    ca_file: Option<string>,
    proxy: Option<string>
) -> Result<StreamResponse, ClientError> {
    val parsed = parse_url(url)
    if !is_ok(parsed) {
        return err(ClientError.BadUrl(unwrap_err(parsed)))
    }
    val u = unwrap(parsed)
    val timeout = option_unwrap_or<int>(timeout_ms, default_timeout_ms)
    val via = try proxy_for(u, proxy)
    val sock = try open_socket(u, via, ca_file, timeout)
    val _ = net.set_timeout(sock, timeout)
    val sent = write_request(sock, method, u, via, option_unwrap_or<[Header]>(headers, []), body, false, false)
    if !is_ok(sent) {
        net.close(sock)
        return err(unwrap_err(sent))
    }
    val read = read_head(sock)
    if !is_ok(read) {
        net.close(sock)
        return err(unwrap_err(read))
    }
    val head = unwrap(read)
    val te = header_value(head.headers, "Transfer-Encoding")
    val cl = header_value(head.headers, "Content-Length")
    val status = head.status
    val no_body = method == HttpMethod.Head || status < 200 || status == status_no_content || status == status_not_modified
    var state = BodyState { buffer: head.rest, mode: 2, left: 0, after_chunk: false, finished: no_body }
    if Some(te) = te && contains(to_lower(te), "chunked") {
        state = BodyState { buffer: head.rest, mode: 1, left: 0, after_chunk: false, finished: no_body }
    } else if Some(cl) = cl {
        val n = parse_int(trim(cl))
        if !is_ok(n) || unwrap(n) < 0 {
            net.close(sock)
            return err(ClientError.BadResponse("invalid Content-Length"))
        }
        state = BodyState { buffer: head.rest, mode: 0, left: unwrap(n), after_chunk: false, finished: no_body }
    }
    val cell: Channel<BodyState> = channel_new()
    send(cell, state)
    val blocks = iter_from<Result<[byte], ClientError>>(fn() -> Option<Result<[byte], ClientError>> {
        next_body_block(sock, cell)
    }, fn() { net.close(sock) })
    return ok(StreamResponse { status: head.status, headers: head.headers, body: blocks })
}
