// ------------------------------------------------------------ responses

fn reason(status: int) -> string {
    if status == status_continue { return "Continue" }
    if status == status_ok { return "OK" }
    if status == status_created { return "Created" }
    if status == status_accepted { return "Accepted" }
    if status == status_no_content { return "No Content" }
    if status == status_moved_permanently { return "Moved Permanently" }
    if status == status_found { return "Found" }
    if status == status_not_modified { return "Not Modified" }
    if status == status_bad_request { return "Bad Request" }
    if status == status_unauthorized { return "Unauthorized" }
    if status == status_forbidden { return "Forbidden" }
    if status == status_not_found { return "Not Found" }
    if status == status_method_not_allowed { return "Method Not Allowed" }
    if status == status_not_acceptable { return "Not Acceptable" }
    if status == status_request_timeout { return "Request Timeout" }
    if status == status_conflict { return "Conflict" }
    if status == status_payload_too_large { return "Payload Too Large" }
    if status == status_unsupported_media_type { return "Unsupported Media Type" }
    if status == status_unprocessable_entity { return "Unprocessable Entity" }
    if status == status_too_many_requests { return "Too Many Requests" }
    if status == status_header_fields_too_large { return "Request Header Fields Too Large" }
    if status == status_internal_server_error { return "Internal Server Error" }
    if status == status_not_implemented { return "Not Implemented" }
    if status == status_service_unavailable { return "Service Unavailable" }
    return "Status"
}

// A response with `status`, no headers and `body`.
pub fn response(status: int, body: [byte]) -> Response {
    return Response { status: status, headers: [], body: body }
}

// `r` with one more header (added after any it already has; nothing is replaced).
pub fn with_header(r: Response, name: string, value: string) -> Response {
    return Response { status: r.status, headers: push(r.headers, Header { name: name, value: value }), body: r.body }
}

// A response with `status` and `body`, `Content-Type` set to `media` (parameters such as a charset included).
pub fn media_response(status: int, body: [byte], media: mime.MediaType) -> Response {
    return with_header(response(status, body), "Content-Type", mime.format(media))
}

// A response with `status` and `body`, `Content-Type: application/json`.
pub fn json_response(status: int, body: string) -> Response {
    return media_response(status, to_bytes(body), mime.application_json())
}

// A response with `status` and `body`, `Content-Type: text/plain; charset=utf-8`.
pub fn text_response(status: int, body: string) -> Response {
    return media_response(status, to_bytes(body), mime.with_param(mime.text_plain(), "charset", "utf-8"))
}

// `text` as a JSON string literal, quotes included: `"` and `\` and the control characters escaped, every
// other byte (UTF-8 included) as it is. Written here so the server needs nothing but its own error replies.
fn json_quoted(text: string) -> string {
    val out = mutable_string_new()
    append(out, "\"")
    for b in to_bytes(text) {
        if b == 34b {
            append(out, "\\\"")
        } else if b == 92b {
            append(out, "\\\\")
        } else if b == 10b {
            append(out, "\\n")
        } else if b == 13b {
            append(out, "\\r")
        } else if b == 9b {
            append(out, "\\t")
        } else if b == 8b {
            append(out, "\\b")
        } else if b == 12b {
            append(out, "\\f")
        } else if (b as int) < 32 {
            append(out, "\\u00", to_hex(b))
        } else {
            append_byte(out, b)
        }
    }
    append(out, "\"")
    return snapshot(out)
}

fn error_body(status: int, message: string) -> string {
    return format("{}\"status\":{},\"error\":{}{}", "{", status, json_quoted(message), "}")
}

fn error_reply(status: int, message: string) -> Response {
    return json_response(status, error_body(status, message))
}

// A 400 response with a JSON body `{"status":400,"error":message}`.
pub fn bad_request(message: string) -> Response {
    return error_reply(status_bad_request, message)
}

// A 404 response with a JSON body `{"status":404,"error":"not found"}`.
pub fn not_found() -> Response {
    return error_reply(status_not_found, "not found")
}

// A 405 response with an `Allow` header listing `allowed`, and a JSON error body.
pub fn method_not_allowed(allowed: variadic string) -> Response {
    return with_header(
        error_reply(status_method_not_allowed, "method not allowed"),
        "Allow",
        join(separator: ", ", pieces: allowed)
    )
}

// The response to send for a request that couldn't be read. (`Closed` and
// `Io` mean there is nobody to answer; the caller just closes.)
pub fn error_response(e: HttpError) -> Response {
    return error_reply(error_status(e), error_text(e))
}

// The status a rejection of `e` carries, and the sentence that goes with it. These exist so an application can
// render the server's own rejections in its own error shape: `error_response` is the library's rendering of the
// same pair, and `ServeOptions.fault` is given these two rather than the `HttpError`, so an application does not
// have to match on a library enum to answer a 413.
pub fn error_status(e: HttpError) -> int {
    return switch e {
        BadRequest(_) { status_bad_request }
        BodyTooLarge { status_payload_too_large }
        HeadersTooLarge { status_header_fields_too_large }
        NotImplemented(_) { status_not_implemented }
        Timeout { status_request_timeout }
        Closed { status_internal_server_error }
        Io(_) { status_internal_server_error }
    }
}

pub fn error_text(e: HttpError) -> string {
    return switch e {
        BadRequest(msg) { msg }
        BodyTooLarge { "request body too large" }
        HeadersTooLarge { "request headers too large" }
        NotImplemented(msg) { msg }
        Timeout { "request timed out" }
        Closed { "internal error" }
        Io(_) { "internal error" }
    }
}

// HTTP/1.1 defaults to keep-alive unless told to close; HTTP/1.0 is the other way around, defaulting
// to close unless told to keep-alive.
fn connection_close_requested(req: Request) -> bool {
    val c = header(req, "Connection")
    if Some(c) = c {
        val v = to_lower(c, invariant)
        if contains(v, "close") {
            return true
        }
        if contains(v, "keep-alive") {
            return false
        }
    }
    return req.version == http_1_0
}

// Serialises and sends `resp` (adding Content-Length and Connection), and
// says whether the connection stays open for another request: HTTP/1.1
// keeps alive unless either side asked to close, HTTP/1.0 only if the
// client asked to keep it. A `HEAD` request gets the headers, with the
// Content-Length the body would have had, and no body.
pub fn write_response(sock: Socket, req: Request, response: Response) -> Result<bool, HttpError> {
    var resp = response
    var refused = false
    for h in response.headers {
        if !is_token(h.name) || !is_field_value(h.value) {
            refused = true
        }
    }
    if refused {
        // A CR, LF or other control character in a header name or value would end the header line and
        // let the rest pass for another header or a body (an application putting client text in a
        // header without checking it). Fail closed; say so on stderr, without the offending text.
        os.write_stderr("ziman: a response header has a name that is not a token or a value with a control character; the response is replaced by a 500\n")
        resp = error_reply(status_internal_server_error, "internal error")
    }
    var keep = !refused && !connection_close_requested(req)
    for h in resp.headers {
        if equals_ignore_case(h.name, "connection", invariant) && contains(to_lower(h.value, invariant), "close") {
            keep = false
        }
    }
    val sb = mutable_string_new()
    append(sb, format("HTTP/1.1 {} {}\r\n", resp.status, reason(resp.status)))
    var has_date = false
    var has_nosniff = false
    for h in resp.headers {
        val lname = to_lower(h.name, invariant)
        if lname == "date" {
            has_date = true
        }
        if lname == "x-content-type-options" {
            has_nosniff = true
        }
        // Content-Length and Connection are always written below from resp.body and keep, so a
        // caller-supplied one here would just be a duplicate.
        if lname != "content-length" && lname != "connection" {
            append(sb, h.name, ": ", h.value, "\r\n")
        }
    }
    if !has_date {
        append(sb, "Date: ", clock.now_http_date(), "\r\n")
    }
    if !has_nosniff {
        append(sb, "X-Content-Type-Options: nosniff\r\n")
    }
    append(sb, format("Content-Length: {}\r\n", len(resp.body)))
    if keep {
        append(sb, "Connection: keep-alive\r\n")
    } else {
        append(sb, "Connection: close\r\n")
    }
    append(sb, "\r\n")
    val head = to_bytes(snapshot(sb))
    val sent = if HttpMethod.is_Head(req.method) { head } else { concat(head, resp.body) }
    try lift<int>(net.write(sock, sent))
    return keep
}

// ------------------------------------------------------------ response compression
//
// `resp` with its body gzipped, when that is both allowed and worth doing; `resp` unchanged
// otherwise. A separate function rather than something `write_response` does for you, for the same
// reason the CORS pair is two functions: it composes with `serve`, a hand-written loop or a static
// file handler by sitting in front of whichever one writes.
//
// **Off unless asked for** (`ServeOptions.compress_responses`), and that default is a security choice, not
// caution about the CPU. Compressing a response that holds a secret alongside attacker-influenced
// text leaks the secret through the compressed length -- the BREACH class -- and an API whose login
// answer carries a JWT is exactly that shape. A server that wants the bandwidth asks for it; no
// existing server gets a compression oracle switched on underneath it.
//
// Four conditions, all of which have to hold:
//   * the request's `Accept-Encoding` offers gzip (`identity` and absence both mean no),
//   * the handler has not already set `Content-Encoding` -- it may be sending something already
//     compressed, and gzipping that twice is slower and larger,
//   * the body is at least `min_bytes`; under a packet's worth there is nothing to win and gzip's
//     own header can make it bigger,
//   * and the result is actually smaller than the input, which incompressible bodies (a JPEG, an
//     already-encrypted blob) fail -- checked rather than assumed.
//
// `Vary: Accept-Encoding` goes on every answer this touches, compressed or not, for the same reason
// `cors_apply` sets `Vary: Origin`: whether the body is gzipped is what varies by the header, so a
// shared cache without it can hand a gzipped body to a client that never asked for one
// (tasks.md F61, and F59 for the identical hazard with Origin).
pub fn compressed(req: Request, resp: Response, min_bytes: int) -> Response {
    for h in resp.headers {
        if equals_ignore_case(h.name, "Content-Encoding", invariant) {
            return resp
        }
    }
    val varied = with_header(resp, "Vary", "Accept-Encoding")
    if !accepts_gzip(req) || len(resp.body) < min_bytes {
        return varied
    }
    val packed = compress.gzip(resp.body)
    if len(packed) >= len(resp.body) {
        return varied
    }
    return Response {
        status: varied.status,
        headers: push(varied.headers, Header { name: "Content-Encoding", value: "gzip" }),
        body: packed
    }
}

// Whether `req` says it will take gzip. A q-value of 0 is a refusal -- `gzip;q=0` means "not gzip"
// -- so it is read rather than ignored; anything else offering gzip counts. Full q-value ranking is
// its own roadmap item and this needs none of it: the only question here is yes or no.
fn accepts_gzip(req: Request) -> bool {
    val offered = switch header(req, "Accept-Encoding") {
        Some(value) { to_lower(value, invariant) }
        None { return false }
    }
    for piece in split(offered, ",") {
        val spec = trim(piece)
        if starts_with(spec, "gzip") {
            if contains(spec, "q=0") && !contains(spec, "q=0.") {
                return false
            }
            return true
        }
    }
    return false
}

// Sends the response for a request that couldn't be read (see
// `error_response`) and closes the exchange: there is no parsed Request to
// consult, so it always says `Connection: close`. Nothing to send for
// `Closed`/`Io` -- the peer is gone -- so it succeeds without writing.
pub fn write_error(sock: Socket, e: HttpError) -> Result<bool, HttpError> {
    val none: Option<fn(int, string) -> Response> = None
    return write_error_with(sock, e, none)
}

// `write_error`, but rendering the rejection through `fault` when there is one -- see `ServeOptions.fault`. The
// application gets the status and the sentence, not the `HttpError`, and what it returns is written as-is, so its
// body shape and any header it adds (an HSTS header, say) are on the rejection too.
pub fn write_error_with(
    sock: Socket,
    e: HttpError,
    fault: Option<fn(int, string) -> Response>
) -> Result<bool, HttpError> {
    if HttpError.is_Closed(e) || HttpError.is_Io(e) {
        return false
    }
    val stub = Request {
        method: HttpMethod.Get,
        target: "/",
        path: "/",
        query: "",
        version: http_1_0,
        headers: [],
        body: [],
        peer: None
    }
    val reply = switch fault {
        Some(render) { render(error_status(e), error_text(e)) }
        None { error_response(e) }
    }
    return write_response(sock, stub, reply)
}
