// -------------------------------------------------------------- routing

// Matches `path` against `pattern`: literal segments must be equal, and a
// `{name}` segment captures any non-empty segment (percent-decoded). A
// trailing slash is ignored on both sides. `None` if it doesn't match.
pub fn path_params(pattern: string, path: string) -> Option<Params> {
    return capture(compile_pattern(pattern), segments_of(path))
}

// A route pattern split into its segments once, so matching never splits or re-parses it: `parts[i]` is a
// literal segment's text, or a `{name}` segment's name, and `is_param[i]` says which.
struct Pattern {
    parts: [string]
    is_param: [bool]
}

// `path` without a trailing slash (the bare "/" stays) split on "/": what a path and a pattern are both
// matched as.
fn segments_of(path: string) -> [string] {
    var p = path
    if len(p) > 1 && ends_with(p, "/") {
        p = substring(p, 0, len(p) - 1)
    }
    return split(p, "/")
}

fn compile_pattern(pattern: string) -> Pattern {
    val parts = mutable_array_new<string>()
    val is_param = mutable_array_new<bool>()
    for segment in segments_of(pattern) {
        if len(segment) >= 3 && starts_with(segment, "{") && ends_with(segment, "}") {
            push(parts, substring(segment, 1, len(segment) - 1))
            push(is_param, true)
        } else {
            push(parts, segment)
            push(is_param, false)
        }
    }
    return Pattern { parts: snapshot(parts), is_param: snapshot(is_param) }
}

// Whether the split path `got` has this pattern's shape: as many segments, every literal equal, every
// `{name}` segment non-empty. Allocates nothing; percent-decoding a captured segment waits for `capture`.
fn shape_matches(p: Pattern, got: [string]) -> bool {
    if len(p.parts) != len(got) {
        return false
    }
    var i = 0
    while i < len(got) {
        if p.is_param[i] {
            if got[i] == "" {
                return false
            }
        } else if p.parts[i] != got[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// The captures of the split path `got` under `p`, percent-decoded, or None if it does not match (a
// captured segment that is not valid percent-encoding is no match).
fn capture(p: Pattern, got: [string]) -> Option<Params> {
    if !shape_matches(p, got) {
        return Option<Params>.None
    }
    val names = mutable_array_new<string>()
    val values = mutable_array_new<string>()
    var i = 0
    while i < len(got) {
        if p.is_param[i] {
            if Ok(decoded) = percent_decode(got[i], false) {
                push(names, p.parts[i])
                push(values, decoded)
            } else {
                return Option<Params>.None
            }
        }
        i = i + 1
    }
    return Option<Params>.Some(Params { names: snapshot(names), values: snapshot(values) })
}

// `Some(params)` if the request's method is `method` and its path matches
// `pattern`, else `None` -- the one-line test a route function is built
// from: `val m = server.route(req, HttpMethod.Get, "/patients/{id}")`.
pub fn route(req: Request, method: HttpMethod, pattern: string) -> Option<Params> {
    if req.method != method {
        return Option<Params>.None
    }
    return path_params(pattern, req.path)
}

// A captured parameter by name. Asking for a name the pattern doesn't
// have is a bug in the route function, so it is a fatal error rather than
// a value to check.
pub fn param(p: Params, name: string) -> string {
    var i = 0
    while i < len(p.names) {
        if p.names[i] == name {
            return p.values[i]
        }
        i = i + 1
    }
    val missing: Result<string, string> = err(concat("no route parameter named ", name))
    return unwrap(missing)
}

// What to answer when no route matched. `routes` lists every route as
// "METHOD /pattern": if the path matches some route under a *different*
// method the answer is 405 with an Allow header, otherwise 404.
pub fn not_found_or_method_not_allowed(req: Request, routes: [string]) -> Response {
    val allowed = mutable_array_new<string>()
    for r in routes {
        val parts = split(r, " ")
        if len(parts) == 2 && Option.is_Some(path_params(parts[1], req.path)) {
            push(allowed, parts[0])
        }
    }
    val methods = snapshot(allowed)
    return if len(methods) > 0 { method_not_allowed(methods) } else { not_found() }
}

// A query-string value by name, percent-decoded ("+" is a space); the
// first one if it is repeated. `None` if absent.
pub fn query_param(req: Request, name: string) -> Option<string> {
    for pair in split(req.query, "&") {
        val kv = split_once(pair, "=")
        if Some(parts) = kv {
            if Ok(key) = percent_decode(parts[0], true) {
                if key == name {
                    if Ok(value) = percent_decode(parts[1], true) {
                        return Option<string>.Some(value)
                    }
                }
            }
        } else if pair == name {
            return Option<string>.Some("")
        }
    }
    return Option<string>.None
}

// ---- binding one request value at a time ----
//
// **These are what `#[path]`, `#[query]` and `#[header]` generate calls to**, and they are
// deliberately small and composable rather than one function per source times type times
// required-ness, which would have been thirty-six. A generated reader reads like the hand-written
// one it replaces:
//
//     entity_type: try server.required(server.query_param(req, "entityType"), "entityType"),
//     entity_id: try server.as_uuid(try server.required(server.query_param(req, "entityId"), "entityId"), "entityId")
//
// A **path** parameter never needs `required`: the router only matches a pattern when every
// segment is there, so a captured name always has a value. A **query** or **header** one may be
// absent, which is what `required` and `given_or` are for.

// The value, or `"<name> is required"` -- the message `read_query`'s hand-written version answered,
// which `src/test/other` holds the API to.
pub fn required(given: Option<string>, name: string) -> Result<string, string> {
    switch given {
        // `ok(..)` spelled out: `Result<string, string>` has the same success and error type, so a
        // bare string here is ambiguous and the compiler says so.
        Some(value) { return ok(value) }
        None { return err(format("{} is required", name)) }
    }
}

// The value or a default, for `@RequestParam(defaultValue = "30")`'s equivalent. No `Result`: a
// default means absence is not a failure.
pub fn given_or(given: Option<string>, fallback: string) -> string {
    switch given {
        Some(value) { return value }
        None { return fallback }
    }
}

// `text` as an int, or `"<name> must be a whole number: <text>"`.
pub fn as_int(text: string, name: string) -> Result<int, string> {
    return switch parse_int(text) {
        Ok(n) { n }
        Err(_) { format("{} must be a whole number: {}", name, text) }
    }
}

// `text` as a `Uuid`. **The message is `uuid_param`'s** -- "invalid <what> id: <text>" -- because a
// client that matches on it should not be able to tell a generated binding from the hand-written
// reader it replaced.
pub fn as_uuid(text: string, what: string) -> Result<Uuid, string> {
    return switch uuid.parse(text) {
        Ok(id) { id }
        Err(_) { format("invalid {} id: {}", what, text) }
    }
}

// `text` as a bool, in any of the spellings the web actually sends. **Wider than
// `xml.parse_bool`'s four on purpose**: that one implements `xs:boolean`, where the lexical space
// is defined and `on` is not in it. A query parameter has no such definition, an HTML checkbox
// sends `on`, and a hand-written reader in the North Star already took `on`/`off`/`yes`/`no` --
// so binding to this must not be the thing that silently narrows what a client may say.
//
// Case-insensitive for the same reason. Anything else is an `Err`, which a 400 carries:
// `?includeDismissed=maybe` is a request to fix, not a false.
pub fn as_bool(text: string, name: string) -> Result<bool, string> {
    val t = to_lower(trim(text))
    if t == "true" || t == "1" || t == "on" || t == "yes" {
        return ok(true)
    }
    if t == "false" || t == "0" || t == "off" || t == "no" {
        return ok(false)
    }
    return err(format("{} must be true or false: {}", name, text))
}

// `text` as a float, for a measurement or a threshold a client sends as a query parameter.
pub fn as_float(text: string, name: string) -> Result<float, string> {
    return switch parse_float(text) {
        Ok(n) { n }
        Err(_) { format("{} must be a number: {}", name, text) }
    }
}

// ---- path parameters as values ----
//
// A captured segment is a string; these turn one into a `Uuid` and answer a message a 400 can
// carry. **Beside `param`, which is what they call** -- they were a module of their own for a day
// (`lib/http/endpoint.zm`), which was one module for two functions about this one's own `Params`.

// A `{id}` path parameter is just a string; this turns it into a `Uuid`, and a bad one is answered 400
// before the endpoint runs. `kind` names what the id belongs to, for the message ("invalid order id").
pub fn uuid_param(kind: string) -> fn(Params) -> Result<Uuid, string> {
    return fn(params: Params) -> Result<Uuid, string> {
        val text = param(params, "id")
        return switch uuid.parse(text) {
            Ok(id) { id }
            Err(_) { format("invalid {} id: {}", kind, text) }
        }
    }
}

// The same as `uuid_param`, but for a captured segment named something other than `{id}`: a pattern with
// two captures (`{orderId}/items/{itemId}`) needs to say which it means.
pub fn named_uuid_param(name: string, kind: string) -> fn(Params) -> Result<Uuid, string> {
    return fn(params: Params) -> Result<Uuid, string> {
        val text = param(params, name)
        return switch uuid.parse(text) {
            Ok(id) { id }
            Err(_) { format("invalid {} id: {}", kind, text) }
        }
    }
}
