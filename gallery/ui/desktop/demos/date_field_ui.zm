// The Date field demo, as design.
use controls
use widget

val gap = 10.0
val field_width = 180.0

pub struct Screen {
    field: widget.Widget
    said: string
}

// **The width is set in a row, not in the column.** A column stretches its children across, which
// overrides a `wide_of` -- so `field_width` sitting straight in the column was a number a designer
// could set that did nothing, and the box drew the full width of the pane. The trailing `flex` is
// what gives the spare room somewhere to go.
pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(0.0, [widget.wide_of(field_width, it.field), widget.flex()]),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}
