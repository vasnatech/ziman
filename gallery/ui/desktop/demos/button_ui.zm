// The Button demo, as design.
use controls
use widget

val gap = 8.0
val button_width = 130.0

pub struct Screen {
    press: controls.Button
    stamped: controls.Button
    off: controls.Button
    said: string
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(gap, [
            widget.wide_of(button_width, controls.button_widget(it.press, style)),
            widget.wide_of(button_width, controls.button_widget(it.stamped, style)),
            widget.wide_of(button_width, controls.button_widget(it.off, style)),
            widget.expand(widget.flex())
        ]),
        widget.label_of(it.said, style.text.caption.size, style.ink)
    ])
}
