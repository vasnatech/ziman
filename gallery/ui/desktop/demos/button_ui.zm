// The Button demo, as design.
use controls
use widget

val gap = 8.0
val row_height = 30.0
val button_width = 130.0
val said_height = 20.0
val small_size = 11.0

pub struct Screen {
    press: controls.Button
    stamped: controls.Button
    off: controls.Button
    said: string
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        widget.fixed_of(0.0, row_height, widget.row_of(gap, [
            widget.fixed_of(button_width, 0.0, controls.button_widget(it.press, style)),
            widget.fixed_of(button_width, 0.0, controls.button_widget(it.stamped, style)),
            widget.fixed_of(button_width, 0.0, controls.button_widget(it.off, style)),
            widget.expand(widget.flex())
        ])),
        widget.fixed_of(0.0, said_height, widget.label_of(it.said, small_size, style.ink))
    ])
}
