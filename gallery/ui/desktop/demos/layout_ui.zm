// The Layout demo, as design.
use controls
use widget

val gap = 8.0
val row_height = 30.0
val label_width = 110.0
val picker_width = 160.0
val band_height = 60.0
val said_height = 20.0
val small_size = 11.0

pub struct Screen {
    picker: widget.Widget
    row: widget.Widget
    column: widget.Widget
    said: string
}

// A box with a word in it, so the parts of a layout can be told apart.
pub fn block(title: string, colour: controls.Style) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.insets_of(gap, 4.0, gap, 4.0),
        surface: widget.filled(colour.face),
        align: widget.centred(),
        children: [widget.label_of(title, small_size, colour.ink)],
        name: ""
    })
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        widget.fixed_of(0.0, row_height, widget.row_of(gap, [
            widget.fixed_of(label_width, 0.0, widget.label_of("Along the row", small_size, style.ink)),
            widget.fixed_of(picker_width, 0.0, it.picker),
            widget.expand(widget.flex())
        ])),
        widget.fixed_of(0.0, band_height, it.row),
        widget.fixed_of(0.0, band_height, it.column),
        widget.fixed_of(0.0, said_height, widget.label_of(it.said, small_size, style.ink))
    ])
}
