// The Layout demo, as design.
use controls
use widget

val gap = 8.0
val label_width = 110.0
val picker_width = 160.0

pub struct Screen {
    picker: widget.Widget
    row: widget.Widget
    column: widget.Widget
    said: string
}

// A box with a word in it, so the parts of a layout can be told apart.
pub fn block(title: string, colour: controls.Style) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.insets_of(gap, 4.0, gap, 4.0),
        surface: widget.filled(colour.face),
        align: widget.centred(),
        children: [widget.label_of(title, colour.text.caption.size, colour.ink)],
        name: ""
    })
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(gap, [
            widget.wide_of(label_width, widget.label_of("Along the row", style.text.caption.size, style.ink)),
            widget.wide_of(picker_width, it.picker),
            widget.expand(widget.flex())
        ]),
        it.row,
        it.column,
        widget.label_of(it.said, style.text.caption.size, style.ink)
    ])
}
