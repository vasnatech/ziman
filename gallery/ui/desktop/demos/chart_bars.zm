// Bars: one block per label, standing on the baseline.
//
// **A bar says "how much", and it says it by area.** That is why a bar starts at zero and a line
// need not: shorten the axis under a bar chart and the picture lies about the ratio between two
// readings, because the eye reads the blocks against each other and not against the numbers up the
// side. `baseline_of` is what keeps that honest here.
//
// **One series, because two would hide each other.** `bar_ops` centres every series' bars on the
// same slot at the same width, so a second bar series draws straight over the first -- the taller
// one wins and the shorter is simply gone. Grouped and stacked bars are not in this library; a
// chart that needs a second quantity wants `Line` over the bars, which is what the **Line and
// bars** demo shows.
use boxes
use chart
use controls
use demos/chart_bars_ui
use locale
use paint
use widget

pub struct Demo {
    view: controls.ChartView
}

fn data() -> chart.Chart {
    return chart.chart_of(
        ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
        [chart.bar_series("Minutes", [35.0, 50.0, 20.0, 45.0, 60.0, 15.0, 30.0], paint.rgb8(28, 110, 214))]
    )
}

pub fn demo() -> Demo {
    return Demo { view: controls.chart_view_of("chart-bars", "Day", data()) }
}

pub fn view(d: Demo, f: controls.Frame) -> widget.Widget {
    return chart_bars_ui.screen(
        chart_bars_ui.Screen {
            chart: controls.chart_widget(d.view, f),
            said: said(d)
        },
        f
    )
}

fn said(d: Demo) -> string {
    val words = controls.chart_said(d.view, locale.default())
    if words == "" {
        return "Nothing selected. Tab to the chart, then press Left or Right."
    }
    return concat("Reading: ", words)
}

pub fn input(
    d: Demo,
    name: string,
    input: controls.Input,
    laid: widget.Laid,
    f: controls.Frame
) -> Demo {
    val step = controls.chart_input(d.view, input, boxes.bounds_of(laid, "chart-bars"), f)
    if !step.moved {
        return d
    }
    return with d { view: step.view }
}
