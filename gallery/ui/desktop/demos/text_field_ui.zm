// The Text field demo, as design.
use controls
use widget

val gap = 8.0
val label_width = 110.0

pub struct Screen {
    plain: widget.Widget
    secret: widget.Widget
    said: string
}

pub fn row(title: string, field: widget.Widget, f: controls.Frame) -> widget.Widget {
    return widget.row_of(gap, [
        widget.wide_of(label_width, widget.label_of(title, f.style.text.caption.size, f.style.ink)),
        widget.expand(field)
    ])
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        row("Your name", it.plain, f),
        row("Password", it.secret, f),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}
