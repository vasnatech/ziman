// The Text field demo, as design.
use controls
use widget

val gap = 8.0
val label_width = 110.0

pub struct Screen {
    plain: widget.Widget
    secret: widget.Widget
    said: string
}

pub fn row(title: string, field: widget.Widget, style: controls.Style) -> widget.Widget {
    return widget.row_of(gap, [
        widget.wide_of(label_width, widget.label_of(title, style.text.caption.size, style.ink)),
        widget.expand(field)
    ])
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        row("Your name", it.plain, style),
        row("Password", it.secret, style),
        widget.label_of(it.said, style.text.caption.size, style.ink)
    ])
}
