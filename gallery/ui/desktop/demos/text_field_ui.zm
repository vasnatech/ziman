// The Text field demo, as design.
use controls
use widget

val gap = 8.0
val row_height = 30.0
val label_width = 110.0
val said_height = 20.0
val small_size = 11.0

pub struct Screen {
    plain: widget.Widget
    secret: widget.Widget
    said: string
}

pub fn row(title: string, field: widget.Widget, style: controls.Style) -> widget.Widget {
    return widget.fixed_of(0.0, row_height, widget.row_of(gap, [
        widget.fixed_of(label_width, 0.0, widget.label_of(title, small_size, style.ink)),
        widget.expand(field)
    ]))
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        row("Your name", it.plain, style),
        row("Password", it.secret, style),
        widget.fixed_of(0.0, said_height, widget.label_of(it.said, small_size, style.ink))
    ])
}
