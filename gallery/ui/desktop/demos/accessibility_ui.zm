// The Accessibility demo, as design.
use controls
use widget

val gap = 8.0
val row_height = 30.0
val button_width = 130.0
val said_height = 18.0
val small_size = 11.0
val heading_size = 12.0

pub struct Screen {
    press: widget.Widget
    check: widget.Widget
    picker: widget.Widget
    said: string
    lines: [widget.Widget]
}

pub fn line(said: string, style: controls.Style) -> widget.Widget {
    return widget.fixed_of(0.0, said_height, widget.label_of(said, small_size, style.ink))
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        widget.fixed_of(0.0, row_height, widget.row_of(gap, [
            widget.fixed_of(button_width, 0.0, it.press),
            widget.fixed_of(button_width, 0.0, it.check),
            widget.fixed_of(button_width, 0.0, it.picker),
            widget.expand(widget.flex())
        ])),
        widget.fixed_of(
            0.0,
            row_height,
            widget.label_of("What a screen reader says about them", heading_size, style.ink)
        ),
        widget.column_of(2.0, it.lines),
        widget.fixed_of(0.0, row_height, widget.label_of(it.said, small_size, style.ink))
    ])
}
