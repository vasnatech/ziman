// The Accessibility demo, as design.
use controls
use widget

val gap = 8.0
val row_height = 30.0
val button_width = 130.0

pub struct Screen {
    press: widget.Widget
    check: widget.Widget
    picker: widget.Widget
    said: string
    lines: [widget.Widget]
}

pub fn line(said: string, f: controls.Frame) -> widget.Widget {
    return widget.label_of(said, f.style.text.caption.size, f.style.ink)
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(gap, [
            widget.wide_of(button_width, it.press),
            widget.wide_of(button_width, it.check),
            widget.wide_of(button_width, it.picker),
            widget.expand(widget.flex())
        ]),
        widget.tall_of(
            row_height,
            widget.label_of("What a screen reader says about them", f.style.text.heading.size, f.style.ink)
        ),
        widget.column_of(2.0, it.lines),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}
