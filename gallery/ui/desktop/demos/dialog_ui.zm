// The Dialog demo, as design.
use controls
use widget

val gap = 8.0
val button_width = 150.0
val dialog_width = 360.0
val dialog_height = 120.0

pub struct Screen {
    open: widget.Widget
    said: string
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(gap, [
            widget.wide_of(button_width, it.open),
            widget.expand(widget.flex())
        ]),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}

// What the dialog holds. **Every width is given and none is `expand`**: a dialog is centred by
// its own natural size, so a child asking to fill its parent is asking the box how big it is
// while the box is asking the child.
pub fn body(message: string, confirm: widget.Widget, cancel: widget.Widget, f: controls.Frame) -> widget.Widget {
    return widget.fixed_of(dialog_width, dialog_height, widget.column_of(gap, [
        widget.label_of(message, f.style.text.caption.size, f.style.ink),
        widget.row_of(gap, [
            widget.wide_of(button_width, confirm),
            widget.wide_of(button_width, cancel)
        ])
    ]))
}
