// The Dialog demo, as design.
use controls
use widget

val gap = 8.0
val button_width = 150.0
val dialog_width = 360.0
val dialog_height = 120.0

pub struct Screen {
    open: widget.Widget
    said: string
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(gap, [
            widget.wide_of(button_width, it.open),
            widget.expand(widget.flex())
        ]),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}

// What the dialog says. **Every width is given and none is `expand`**: a dialog is centred by its
// own natural size, so a child asking to fill its parent is asking the box how big it is while
// the box is asking the child.
//
// **The buttons are no longer in here.** They go to `dialog_layer`'s footer, which is what puts a
// rule above them and the same padding around them as the message gets -- see `actions` below.
pub fn body(message: string, f: controls.Frame) -> widget.Widget {
    return widget.wide_of(dialog_width, widget.label_of(message, f.style.text.caption.size, f.style.ink))
}

// The footer's row: confirm first, as every dialog here puts the thing it is offering first.
pub fn actions(confirm: widget.Widget, cancel: widget.Widget) -> widget.Widget {
    return widget.row_of(gap, [
        widget.wide_of(button_width, confirm),
        widget.wide_of(button_width, cancel),
        widget.expand(widget.flex())
    ])
}
