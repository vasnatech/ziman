// The List demo, as design.
use controls
use widget

val gap = 8.0
val list_height = 170.0
val list_width = 240.0
val small_size = 11.0

pub struct Screen {
    list: widget.Widget
    said: string
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        widget.tall_of(list_height, widget.row_of(gap, [
            widget.wide_of(list_width, it.list),
            widget.expand(widget.flex())
        ])),
        widget.label_of(it.said, small_size, style.ink)
    ])
}
