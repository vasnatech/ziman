// The Text area demo, as design.
use controls
use widget

val gap = 8.0
val area_height = 170.0
val small_size = 11.0

pub struct Screen {
    area: widget.Widget
    said: string
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        widget.tall_of(area_height, it.area),
        widget.label_of(it.said, small_size, style.ink)
    ])
}
