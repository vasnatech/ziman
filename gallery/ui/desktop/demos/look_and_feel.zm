// The same controls under every look the library ships, which is what `Style` is for.
//
// **A theme is not a palette.** Swapping every colour gives a different *theme of the same
// widgets*, which is why an application could ship a dark palette long before it could ship a
// button that looked different. What distinguishes a flat look from an edged one, or a rounded
// field from a square one, is **shape** -- `Surface.border` and `Surface.corner` -- and until
// `widget.Surface` widened, this layer had no way to ask for any of it.
//
// **The looks come from `theme.all()` and are not written here.** This file used to invent two
// of the four -- a "Soft" and an "Outlined" that existed nowhere else -- which is an application
// writing a library's content: nothing else could use them, and the real looks went undemonstrated
// beside them. Now the picker is the register, so a look added to `lib/ui/theme` appears here
// with no edit to the gallery at all, and this demo tests that the register is complete.
use boxes
use controls
use demos/look_and_feel_ui
use geom
use paint
use theme
use widget
use widget.Toggle

pub struct Demo {
    picker: controls.ComboBox
    // The editor: two seeds and three choices, which is the whole of what a look is since F295.
    //
    // **This is what replaced a theme file format** (D12). F9 was ranked last on the assumption
    // that a look is thirty-five literals -- which a file can carry and a slider cannot. After D6,
    // D8 and D9 a look is two seeds, a scheme and a short override list, so the thing that made a
    // format necessary is gone: you cannot put a slider on thirty-five literals, and you can put
    // one on two seeds. No schema, no validator, and no new way for a look to be invalid at run
    // time.
    neutral_hue: controls.Slider
    neutral_chroma: controls.Slider
    accent_hue: controls.Slider
    accent_chroma: controls.Slider
    scheme: controls.ComboBox
    surfaces: controls.ComboBox
    // **The one axis that moves the space scale**, and deliberately not six sliders on the six
    // steps. `Space` is `none`/`xs`/`s`/`m`/`l`/`xl` and `theme.Seeds` cannot carry any of them:
    // a look does not state a scale, `theme.at_density` multiplies one. D4 wrote down why --
    // "a scale written out per density is three places for a step to drift: `xs` could end up
    // larger than `s` in exactly one of them and nothing would say so" -- and six sliders would
    // be a fourth place, in a window, with nothing checking the order.
    //
    // So the editor shows the look at each density instead, which is what someone adjusting
    // spacing actually wants to see, and the pasted source says that density is not part of it.
    density: controls.ComboBox
    // **A switch, not a check box.** It is a setting that takes effect the moment it moves --
    // the whole point of this editor being live -- which is the distinction F298 gave its own
    // role. The check box below it is a *preview* of what a check box looks like in the look
    // being edited, and that is the difference between the two in one screen.
    edged: controls.Switch
    press: controls.Button
    notify: controls.CheckBox
    field: controls.Entry
}

pub fn demo() -> Demo {
    return Demo {
        picker: controls.combo_box_of("look-picker", "Look", look_names(), 2),
        // **Continuous, which the slider's own comment anticipated**: "zero means no snapping,
        // which is a continuous slider and a real thing to want -- a colour picker's hue has no
        // steps". Written before there was a colour picker to want it.
        //
        // **The value is set in the same `with` as the step, and that is not a style choice.**
        // `slider_of` snaps what it is given through the default step of 1.0, so a chroma of 0.012
        // arrives as 0 -- which is a grey, and looked like the ramp ignoring its seed until the
        // thumb was seen sitting at the far left.
        neutral_hue: with controls.slider_of("look-nh", "Neutral hue", 0.0, 360.0, 265.0) {
            step: 0.0,
            value: 265.0
        },
        // **A hundredth, not a tenth.** A neutral's chroma is the difference between a grey that
        // belongs to its accent and one that sits beside it; at 0.1 everything is a pastel.
        neutral_chroma: with controls.slider_of("look-nc", "Neutral chroma", 0.0, 0.03, 0.012) {
            step: 0.0,
            value: 0.012
        },
        accent_hue: with controls.slider_of("look-ah", "Accent hue", 0.0, 360.0, 263.0) {
            step: 0.0,
            value: 263.0
        },
        accent_chroma: with controls.slider_of("look-ac", "Accent chroma", 0.0, 0.3, 0.215) {
            step: 0.0,
            value: 0.215
        },
        scheme: controls.combo_box_of("look-scheme", "Scheme", ["Light", "Dark"], 0),
        surfaces: controls.combo_box_of(
            "look-surfaces",
            "Surfaces",
            ["Darker than the window", "Lighter than the window"],
            1
        ),
        edged: controls.switch_of("look-edged", "Edged faces", Toggle.On),
        density: controls.combo_box_of("look-density", "Density", density_names(), 1),
        press: controls.button_of("look-press", "Send"),
        notify: controls.check_box_of("look-notify", "Notify me", Toggle.On),
        field: controls.entry_of("look-field", "Your name", "Ada Lovelace")
    }
}

// The register's looks, and then the one being designed.
//
// **"Designed here" last, so the register stays the demo it was**: a look added to `lib/ui/theme`
// still appears without an edit to this file, and the editor is one more row rather than a
// replacement for it.
fn look_names() -> [string] {
    val names = mutable_array_new<string>()
    for one in theme.all() {
        push(names, one.name)
    }
    push(names, designed_name)
    return snapshot(names)
}

pub val designed_name = "Designed here"

// The seeds the sliders are on.
fn seeds_of(d: Demo) -> theme.Seeds {
    return theme.Seeds {
        neutral: paint.oklch(0.5, d.neutral_chroma.value, d.neutral_hue.value),
        accent: paint.oklch(0.55, d.accent_chroma.value, d.accent_hue.value),
        surfaces: if d.surfaces.items.selected == 0 { theme.Toward.Ink } else { theme.Toward.Away },
        edged: Toggle.is_On(d.edged.on)
    }
}

fn scheme_of(d: Demo) -> theme.Scheme {
    if d.scheme.items.selected == 1 {
        return theme.Scheme.Dark
    }
    return theme.Scheme.Light
}

// What to paste into a `.zm` file.
//
// **The deliverable of the whole exercise**, and the reason this is an editor and not a file
// format: a look designed here leaves as source, so there is no loader, no schema and nothing that
// can be invalid at run time. The numbers are the two seeds and the three choices -- everything
// else about the look is derived from them.
pub fn source_lines(d: Demo) -> [string] {
    return [
        "theme.Seeds {",
        concat(
            "    neutral: paint.oklch(0.5, ",
            format("{:.3}", d.neutral_chroma.value),
            ", ",
            format("{:.1}", d.neutral_hue.value),
            "),"
        ),
        concat(
            "    accent: paint.oklch(0.55, ",
            format("{:.3}", d.accent_chroma.value),
            ", ",
            format("{:.1}", d.accent_hue.value),
            "),"
        ),
        concat("    surfaces: Toward.", if d.surfaces.items.selected == 0 { "Ink" } else { "Away" }, ","),
        concat("    edged: ", if Toggle.is_On(d.edged.on) { "true" } else { "false" }),
        "}",
        "",
        // **The one line that says what is NOT here.** Density changes the look on screen and does
        // not appear in these seeds, which would otherwise read as this editor having forgotten
        // it: it is an axis applied to a look (`theme.at_density`), not a number a look states --
        // the same reason a scheme is not in here either.
        concat(
            "// Shown at ",
            theme.density_name(density_of(d)),
            " density. Density is an axis, not a seed: theme.at_density(style, Density.",
            theme.density_name(density_of(d)),
            ")."
        )
    ]
}

// The source as a widget, built here rather than in the design file.
//
// **A line per label, because a label is one line.** A `\n` in a run of text is not a line break to
// this layer -- it is a code point the face has no glyph for, and it drew as six `.notdef` boxes in
// a row the first time this was tried. A design file cannot loop, so the column is built on this
// side, which is the same split every other list of widgets here uses.
pub fn source_widget(d: Demo, style: controls.Style) -> widget.Widget {
    val lines = mutable_array_new<widget.Widget>()
    for one in source_lines(d) {
        push(lines, widget.label_in_face(one, style.text.code.size, style.ink, style.text.code.face))
    }
    return widget.column_of(0.0, snapshot(lines))
}

// The look the picker is on.
//
// **Not the style this demo was handed**, which the first version got wrong: the gallery wears
// `modern` now, so a demo that started from the style it was given would show four variations of
// modern and call the first one "Plain". A demo comparing looks takes them from the register.
// The look this demo is showing, whichever row the picker is on.
//
// **Public because the editor is worth testing**, and what there is to test is exactly this: that
// the sliders are the look. See `state_test`'s designer tests.
pub fn look_of_demo(d: Demo) -> controls.Style {
    return look_of(d, theme.plain())
}

// **The density is applied to every look the editor shows, designed or built in**, because it is
// a property of the preview rather than of the look: picking "Compact" asks what *this* look is
// like with less room, and that question is as fair of Plain as of the one on the sliders.
fn look_of(d: Demo, style: controls.Style) -> controls.Style {
    return theme.at_density(undensed(d, style), density_of(d))
}

fn density_of(d: Demo) -> theme.Density {
    val all = theme.densities()
    val which = d.density.items.selected
    if which < 0 || which >= len(all) {
        return theme.Density.Comfortable
    }
    return all[which]
}

fn density_names() -> [string] {
    val names = mutable_array_new<string>()
    for one in theme.densities() {
        push(names, theme.density_name(one))
    }
    return snapshot(names)
}

fn undensed(d: Demo, style: controls.Style) -> controls.Style {
    val looks = theme.all()
    val which = d.picker.items.selected
    // **The last row is the one being designed**, derived from the sliders on every frame. That is
    // what makes this an editor rather than a picker: `derive` runs per repaint, which costs two
    // twelve-step ramps and is the whole price of the live feedback.
    if which == len(looks) {
        return theme.derive(seeds_of(d), scheme_of(d))
    }
    if which < 0 || which >= len(looks) {
        return theme.plain()
    }
    return looks[which].style
}

// Whether the picker is on the look being designed.
fn designing(d: Demo) -> bool {
    return d.picker.items.selected == len(theme.all())
}

pub fn view(d: Demo, f: controls.Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    val look = look_of(d, style)
    return look_and_feel_ui.screen(
        look_and_feel_ui.Screen {
            // **The picker keeps the window's own style** so that it stays where the eye expects it
            // while everything beside it changes: a control that restyles itself is harder to find
            // again, and this one is how you get back.
            picker: controls.combo_box_widget(d.picker, controls.frame_of(style, m)),
            button: controls.button_widget(d.press, controls.frame_of(look, m)),
            check: controls.check_box_widget(d.notify, controls.frame_of(look, m)),
            field: controls.entry_widget(d.field, controls.frame_of(look, m)),
            said: said(d),
            look: look,
            // **The editor keeps the window's own style, like the picker** -- a control that
            // restyles itself while you are dragging it is one you cannot aim at.
            neutral_hue: controls.slider_widget(d.neutral_hue, controls.frame_of(style, m)),
            neutral_chroma: controls.slider_widget(d.neutral_chroma, controls.frame_of(style, m)),
            accent_hue: controls.slider_widget(d.accent_hue, controls.frame_of(style, m)),
            accent_chroma: controls.slider_widget(d.accent_chroma, controls.frame_of(style, m)),
            scheme: controls.combo_box_widget(d.scheme, controls.frame_of(style, m)),
            surfaces: controls.combo_box_widget(d.surfaces, controls.frame_of(style, m)),
            density: controls.combo_box_widget(d.density, controls.frame_of(style, m)),
            edged: controls.switch_widget(d.edged, controls.frame_of(style, m)),
            source: source_widget(d, style),
            designing: designing(d)
        },
        f
    )
}

// What the chosen look is, **read off the look itself** rather than written out per name.
//
// A sentence per look goes stale the moment one is added -- and the thing worth saying about a
// look is what it decided, which the style can be asked. The contrast is `paint.contrast_ratio`,
// the same number `theme_test` holds every shipped look to.
fn said(d: Demo) -> string {
    val look = look_of(d, theme.plain())
    return concat(
        edge_word(look),
        ", ",
        corner_word(look),
        ", ",
        shadow_word(look),
        ". Ink on face ",
        format("{:.1}", theme.ink_contrast(look)),
        ":1, where WCAG AA asks 4.5."
    )
}

fn edge_word(look: controls.Style) -> string {
    return switch look.states.rest.border {
        Some(_) { "Edged faces" }
        None { "Flat faces" }
    }
}

fn corner_word(look: controls.Style) -> string {
    return switch look.shape.medium {
        Square { "square corners" }
        Points(r) { concat(format("{:.0}", r), " points of corner") }
        Fraction(_) { "capsule corners" }
    }
}

fn shadow_word(look: controls.Style) -> string {
    return switch look.raised {
        Some(cast) { concat("a shadow at ", format("{:.0}", cast.opacity * 100.0), " per cent under what is in front") }
        None { "nothing raised" }
    }
}

pub fn anchor(d: Demo) -> string {
    if d.picker.open {
        return "look-picker"
    }
    return ""
}

pub fn layer(d: Demo, at: geom.Rect, f: controls.Frame) -> widget.Layer {
    val style = f.style
    val m = f.metrics
    return controls.combo_box_popup_layer(
        d.picker,
        geom.rect_of(
            at.x,
            at.y + at.height,
            at.width,
            (len(d.picker.items.items) as float) * controls.row_height(m, style)
        ),
        controls.frame_of(style, m)
    )
}

pub fn input(
    d: Demo,
    name: string,
    input: controls.Input,
    laid: widget.Laid,
    f: controls.Frame
) -> Demo {
    val style = f.style
    val m = f.metrics
    if name == "look-picker" || name == "look-picker/items" {
        return with d {
            picker: controls.combo_box_input(
                d.picker,
                input,
                boxes.bounds_of(laid, "look-picker"),
                boxes.bounds_of(laid, "look-picker/items"),
                controls.frame_of(style, m)
            ).combo
        }
    }
    if name == "look-nh" {
        return with d { neutral_hue: controls.slider_input(d.neutral_hue, input, boxes.bounds_of(laid, name)).slider }
    }
    if name == "look-nc" {
        return with d {
            neutral_chroma: controls.slider_input(d.neutral_chroma, input, boxes.bounds_of(laid, name)).slider
        }
    }
    if name == "look-ah" {
        return with d { accent_hue: controls.slider_input(d.accent_hue, input, boxes.bounds_of(laid, name)).slider }
    }
    if name == "look-ac" {
        return with d {
            accent_chroma: controls.slider_input(d.accent_chroma, input, boxes.bounds_of(laid, name)).slider
        }
    }
    if name == "look-scheme" || name == "look-scheme/items" {
        return with d {
            scheme: controls.combo_box_input(
                d.scheme,
                input,
                boxes.bounds_of(laid, "look-scheme"),
                boxes.bounds_of(laid, "look-scheme/items"),
                controls.frame_of(style, m)
            ).combo
        }
    }
    if name == "look-surfaces" || name == "look-surfaces/items" {
        return with d {
            surfaces: controls.combo_box_input(
                d.surfaces,
                input,
                boxes.bounds_of(laid, "look-surfaces"),
                boxes.bounds_of(laid, "look-surfaces/items"),
                controls.frame_of(style, m)
            ).combo
        }
    }
    if name == "look-density" || name == "look-density/items" {
        return with d {
            density: controls.combo_box_input(
                d.density,
                input,
                boxes.bounds_of(laid, "look-density"),
                boxes.bounds_of(laid, "look-density/items"),
                controls.frame_of(style, m)
            ).combo
        }
    }
    if name == "look-edged" {
        return with d { edged: controls.switch_input(d.edged, input, boxes.bounds_of(laid, name)).control }
    }
    if name == "look-press" {
        return with d { press: controls.button_input(d.press, input, boxes.bounds_of(laid, name)).button }
    }
    if name == "look-notify" {
        return with d { notify: controls.check_box_input(d.notify, input, boxes.bounds_of(laid, name)).check_box }
    }
    if name == "look-field" {
        return with d {
            field: controls.entry_input(
                d.field,
                input,
                boxes.bounds_of(laid, name),
                controls.frame_of(look_of(d, style), m)
            ).entry
        }
    }
    return d
}
