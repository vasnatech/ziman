// The same controls under every look the library ships, which is what `Style` is for.
//
// **A theme is not a palette.** Swapping every colour gives a different *theme of the same
// widgets*, which is why an application could ship a dark palette long before it could ship a
// button that looked different. What distinguishes a flat look from an edged one, or a rounded
// field from a square one, is **shape** -- `Surface.border` and `Surface.corner` -- and until
// `widget.Surface` widened, this layer had no way to ask for any of it.
//
// **The looks come from `theme.all()` and are not written here.** This file used to invent two
// of the four -- a "Soft" and an "Outlined" that existed nowhere else -- which is an application
// writing a library's content: nothing else could use them, and the real looks went undemonstrated
// beside them. Now the picker is the register, so a look added to `lib/ui/theme` appears here
// with no edit to the gallery at all, and this demo tests that the register is complete.
use boxes
use controls
use demos/look_and_feel_ui
use geom
use paint
use theme
use widget
use widget.Toggle

pub struct Demo {
    picker: controls.ComboBox
    press: controls.Button
    notify: controls.CheckBox
    field: controls.Entry
}

pub fn demo() -> Demo {
    return Demo {
        picker: controls.combo_box_of("look-picker", "Look", look_names(), 2),
        press: controls.button_of("look-press", "Send"),
        notify: controls.check_box_of("look-notify", "Notify me", Toggle.On),
        field: controls.entry_of("look-field", "Your name", "Ada Lovelace")
    }
}

fn look_names() -> [string] {
    val names = mutable_array_new<string>()
    for one in theme.all() {
        push(names, one.name)
    }
    return snapshot(names)
}

// The look the picker is on.
//
// **Not the style this demo was handed**, which the first version got wrong: the gallery wears
// `modern` now, so a demo that started from the style it was given would show four variations of
// modern and call the first one "Plain". A demo comparing looks takes them from the register.
fn look_of(d: Demo, style: controls.Style) -> controls.Style {
    val looks = theme.all()
    val which = d.picker.items.selected
    if which < 0 || which >= len(looks) {
        return theme.plain()
    }
    return looks[which].style
}

pub fn view(d: Demo, f: controls.Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    val look = look_of(d, style)
    return look_and_feel_ui.screen(
        look_and_feel_ui.Screen {
            // **The picker keeps the window's own style** so that it stays where the eye expects it
            // while everything beside it changes: a control that restyles itself is harder to find
            // again, and this one is how you get back.
            picker: controls.combo_box_widget(d.picker, controls.frame_of(style, m)),
            button: controls.button_widget(d.press, controls.frame_of(look, m)),
            check: controls.check_box_widget(d.notify, controls.frame_of(look, m)),
            field: controls.entry_widget(d.field, controls.frame_of(look, m)),
            said: said(d),
            look: look
        },
        f
    )
}

// What the chosen look is, **read off the look itself** rather than written out per name.
//
// A sentence per look goes stale the moment one is added -- and the thing worth saying about a
// look is what it decided, which the style can be asked. The contrast is `paint.contrast_ratio`,
// the same number `theme_test` holds every shipped look to.
fn said(d: Demo) -> string {
    val look = look_of(d, theme.plain())
    return concat(
        edge_word(look),
        ", ",
        corner_word(look),
        ", ",
        shadow_word(look),
        ". Ink on face ",
        format("{:.1}", theme.ink_contrast(look)),
        ":1, where WCAG AA asks 4.5."
    )
}

fn edge_word(look: controls.Style) -> string {
    return switch look.states.rest.border {
        Some(_) { "Edged faces" }
        None { "Flat faces" }
    }
}

fn corner_word(look: controls.Style) -> string {
    return switch look.shape.medium {
        Square { "square corners" }
        Points(r) { concat(format("{:.0}", r), " points of corner") }
        Fraction(_) { "capsule corners" }
    }
}

fn shadow_word(look: controls.Style) -> string {
    return switch look.raised {
        Some(cast) { concat("a shadow at ", format("{:.0}", cast.opacity * 100.0), " per cent under what is in front") }
        None { "nothing raised" }
    }
}

pub fn anchor(d: Demo) -> string {
    if d.picker.open {
        return "look-picker"
    }
    return ""
}

pub fn layer(d: Demo, at: geom.Rect, f: controls.Frame) -> widget.Layer {
    val style = f.style
    val m = f.metrics
    return controls.combo_box_popup_layer(
        d.picker,
        geom.rect_of(
            at.x,
            at.y + at.height,
            at.width,
            (len(d.picker.items.items) as float) * controls.row_height(m, style)
        ),
        controls.frame_of(style, m)
    )
}

pub fn input(
    d: Demo,
    name: string,
    input: controls.Input,
    laid: widget.Laid,
    f: controls.Frame
) -> Demo {
    val style = f.style
    val m = f.metrics
    if name == "look-picker" || name == "look-picker/items" {
        return with d {
            picker: controls.combo_box_input(
                d.picker,
                input,
                boxes.bounds_of(laid, "look-picker"),
                boxes.bounds_of(laid, "look-picker/items"),
                controls.frame_of(style, m)
            ).combo
        }
    }
    if name == "look-press" {
        return with d { press: controls.button_input(d.press, input, boxes.bounds_of(laid, name)).button }
    }
    if name == "look-notify" {
        return with d { notify: controls.check_box_input(d.notify, input, boxes.bounds_of(laid, name)).check_box }
    }
    if name == "look-field" {
        return with d {
            field: controls.entry_input(
                d.field,
                input,
                boxes.bounds_of(laid, name),
                controls.frame_of(look_of(d, style), m)
            ).entry
        }
    }
    return d
}
