// The Switch demo, as design.
use controls
use widget

val gap = 8.0

pub struct Screen {
    master: widget.Widget
    first: widget.Widget
    second: widget.Widget
    said: string
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        it.master,
        it.first,
        it.second,
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}
