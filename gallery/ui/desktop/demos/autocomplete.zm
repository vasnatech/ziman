// A field that suggests from a known set as it is typed into.
//
// **Type `amox`.** The list narrows to the two medicines that contain it -- a substring and not a
// prefix, because the part of a long drug name a user remembers is often in the middle.
//
// **Then press Enter without arrowing onto anything.** The strict field below gives your typing
// up rather than taking the first match, which is how a form ends up holding a diagnosis nobody
// chose. The free-text field keeps it. That difference is the one decision this control cannot
// take for a caller.
//
// **Then arrow down and look at the field.** The text does not change as the highlight moves.
// Filling the entry as you arrow reads well in a demonstration and destroys the typing of anyone
// who arrows past their answer: moving the highlight is looking, Enter is choosing.
//
// **Then type `zzz`.** The popup stays, and says there are no suggestions -- one that vanished
// would be indistinguishable from one that broke.
//
// The caption is what a screen reader is told. It is the half of an autocomplete that every
// hand-rolled one leaves out: a list that silently goes from a hundred rows to three has told a
// sighted user something and a blind user nothing.
use boxes
use controls
use demos/autocomplete_ui
use geom
use widget

pub struct Demo {
    drug: controls.Autocomplete
    note: controls.Autocomplete
    chosen: string
}

fn medicines() -> [string] {
    return [
        "Amoxicillin",
        "Aspirin",
        "Atorvastatin",
        "Co-amoxiclav",
        "Ibuprofen",
        "Levothyroxine",
        "Metformin",
        "Omeprazole",
        "Paracetamol",
        "Ramipril",
        "Salbutamol",
        "Simvastatin"
    ]
}

pub fn demo() -> Demo {
    return Demo {
        drug: controls.autocomplete_of("auto-drug", "Medication", medicines()),
        note: with controls.autocomplete_of("auto-note", "Or anything", medicines()) {
            free_text: true
        },
        chosen: "Nothing chosen yet."
    }
}

fn label(text: string, f: controls.Frame) -> widget.Widget {
    return widget.label_of(text, f.style.text.label.size, f.style.ink)
}

pub fn view(d: Demo, f: controls.Frame) -> widget.Widget {
    return autocomplete_ui.screen(
        autocomplete_ui.Screen {
            says: label("Medication -- only a name from the list", f),
            strict_says: label("Or anything -- this one keeps what you type", f),
            field: controls.autocomplete_widget(d.drug, f),
            strict: controls.autocomplete_widget(d.note, f),
            chosen: d.chosen,
            said: controls.autocomplete_said(d.drug)
        },
        f
    )
}

// **Only one popup can be open**, so the demo shows whichever field is. Two open lists would
// overlap and the second would be unreachable.
pub fn layer_at(d: Demo, laid: widget.Laid, f: controls.Frame) -> Option<widget.Layer> {
    if d.drug.open {
        return controls.autocomplete_popup_layer(d.drug, popup_under(d.drug, "auto-drug", laid, f), f)
    }
    return controls.autocomplete_popup_layer(d.note, popup_under(d.note, "auto-note", laid, f), f)
}

fn popup_under(
    a: controls.Autocomplete,
    name: string,
    laid: widget.Laid,
    f: controls.Frame
) -> geom.Rect {
    val at = boxes.bounds_of(laid, name)
    return geom.rect_of(at.x, at.y + at.height, at.width, controls.autocomplete_popup_height(a, f))
}

pub fn input(
    d: Demo,
    name: string,
    input: controls.Input,
    laid: widget.Laid,
    f: controls.Frame
) -> Demo {
    if d.drug.open || name == "auto-drug" {
        val step = controls.autocomplete_input(
            d.drug,
            input,
            boxes.bounds_of(laid, "auto-drug"),
            popup_under(d.drug, "auto-drug", laid, f),
            f
        )
        return with d { drug: step.field, chosen: said_of(step.chosen, d.chosen) }
    }
    if d.note.open || name == "auto-note" {
        val step = controls.autocomplete_input(
            d.note,
            input,
            boxes.bounds_of(laid, "auto-note"),
            popup_under(d.note, "auto-note", laid, f),
            f
        )
        return with d { note: step.field, chosen: said_of(step.chosen, d.chosen) }
    }
    return d
}

fn said_of(chosen: string, before: string) -> string {
    if chosen == "" {
        return before
    }
    return concat("Chosen: ", chosen)
}
