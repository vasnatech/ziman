// The Wrapping demo, as design.
//
// **The panel itself is a `border_of`**, which is the honest way to show one: a border is an
// arrangement, so it arranges something rather than being the subject.
use controls
use widget

val gap = 12.0
val chip_gap = 8.0
val line_gap = 8.0
val stack_gap = 10.0
val label_width = 90.0

pub struct Screen {
    title: widget.Widget
    chips: [widget.Widget]
    at: float
    width: widget.Widget
    said: string
}

pub fn chips(it: Screen) -> widget.Widget {
    return widget.row_of(0.0, [
        widget.wide_of(it.at, widget.flow_of(chip_gap, line_gap, it.chips)),
        widget.flex()
    ])
}

pub fn footer(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(stack_gap, [
        widget.row_of(stack_gap, [
            widget.wide_of(label_width, widget.label_of("Room", f.style.text.caption.size, f.style.ink)),
            widget.expand(it.width)
        ]),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.border_of(
        it.title,
        footer(it, f),
        widget.Widget.Nothing,
        widget.Widget.Nothing,
        chips(it),
        gap
    )
}
