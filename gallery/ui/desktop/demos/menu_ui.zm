// The Menu demo, as design.
use controls
use widget

val gap = 8.0
val title_width = 110.0

pub struct Screen {
    file: widget.Widget
    edit: widget.Widget
    said: string
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(gap, [
            widget.wide_of(title_width, it.file),
            widget.wide_of(title_width, it.edit),
            widget.expand(widget.flex())
        ]),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}
