// The Check box demo, as design.
use controls
use widget

val gap = 8.0

pub struct Screen {
    on: widget.Widget
    mixed: widget.Widget
    off: widget.Widget
    said: string
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        it.on,
        it.mixed,
        it.off,
        widget.label_of(it.said, style.text.caption.size, style.ink)
    ])
}
