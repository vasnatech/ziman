// The Radio group demo, as design.
use controls
use widget

val gap = 8.0
val group_height = 110.0
val group_width = 240.0

pub struct Screen {
    group: widget.Widget
    said: string
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        widget.tall_of(group_height, widget.row_of(gap, [
            widget.wide_of(group_width, it.group),
            widget.expand(widget.flex())
        ])),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}
