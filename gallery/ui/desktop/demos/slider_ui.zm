// The Slider demo, as design.
use controls
use widget

val gap = 8.0
val row_height = 30.0
val label_width = 90.0
val value_width = 70.0
val said_height = 20.0
val small_size = 11.0

pub struct Screen {
    volume: widget.Widget
    volume_said: string
    steps: widget.Widget
    steps_said: string
    said: string
}

pub fn row(title: string, slider: widget.Widget, value: string, style: controls.Style) -> widget.Widget {
    return widget.fixed_of(0.0, row_height, widget.row_of(gap, [
        widget.fixed_of(label_width, 0.0, widget.label_of(title, small_size, style.ink)),
        widget.expand(slider),
        widget.fixed_of(value_width, 0.0, widget.label_of(value, small_size, style.ink))
    ]))
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        row("Volume", it.volume, it.volume_said, style),
        row("Quarters", it.steps, it.steps_said, style),
        widget.fixed_of(0.0, said_height, widget.label_of(it.said, small_size, style.ink))
    ])
}
