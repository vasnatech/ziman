    }
}

// The two files the Code tab shows, in the order a reader wants them: what it does, then how it
// is arranged.
pub fn files_of(d: Demo) -> [string] {
    return [concat(stem_of(d), ".zm"), concat(stem_of(d), "_ui.zm")]
}

// The demo's next frame, or nothing when it has none.
//
// **An `Option` and not a `Demo`**, because the window repaints what changed: a tick that always
// answered with a demo would leave the loop unable to tell a gallery showing a moving bar from one
// showing twenty still pictures, and it would repaint all of them sixty times a second forever.
//
// Every other arm is `None` by hand rather than by a default, which is the rule everywhere here --
// and it earns its keep in this one: a demo that starts animating and forgets to say so is a demo
// that is simply never redrawn, which looks like the animation being broken rather than unasked
// for.
pub fn tick_of(d: Demo, f: controls.Frame) -> Option<Demo> {
    return switch d {
        Button(_) { Option<Demo>.None }
        CheckBox(_) { Option<Demo>.None }
        Switch(_) { Option<Demo>.None }
        Radios(_) { Option<Demo>.None }
        TextField(_) { Option<Demo>.None }
        TextArea(_) { Option<Demo>.None }
        List(_) { Option<Demo>.None }
        Tabs(_) { Option<Demo>.None }
        Tree(_) { Option<Demo>.None }
        Table(_) { Option<Demo>.None }
        ScrollBar(_) { Option<Demo>.None }
        Slider(_) { Option<Demo>.None }
        SplitPane(_) { Option<Demo>.None }
        ComboBox(_) { Option<Demo>.None }
        Menu(_) { Option<Demo>.None }
        Link(_) { Option<Demo>.None }
        Dialog(_) { Option<Demo>.None }
        Layout(_) { Option<Demo>.None }
        Picture(_) { Option<Demo>.None }
        LookAndFeel(_) { Option<Demo>.None }
        Accessibility(_) { Option<Demo>.None }
        Composing(_) { Option<Demo>.None }
        Progress(it) { Option<Demo>.Some(Demo.Progress(progress.tick(it))) }
        NumberField(_) { Option<Demo>.None }
        Tooltip(it) { Option<Demo>.Some(Demo.Tooltip(tooltip.tick(it, f))) }
        Expander(_) { Option<Demo>.None }
        Toolbar(_) { Option<Demo>.None }
        Context(_) { Option<Demo>.None }
        DateField(_) { Option<Demo>.None }
        Grid(_) { Option<Demo>.None }
        Flow(_) { Option<Demo>.None }
        Autocomplete(_) { Option<Demo>.None }
        Panel(it) {
            switch panel.tick(it, f) {
                Some(one) { Option<Demo>.Some(Demo.Panel(one)) }
                None { Option<Demo>.None }
            }
        }
        Search(_) { Option<Demo>.None }
        Badge(_) { Option<Demo>.None }
        Card(it) {
            switch card.tick(it, f) {
                Some(one) { Option<Demo>.Some(Demo.Card(one)) }
                None { Option<Demo>.None }
            }
        }
    }
}

