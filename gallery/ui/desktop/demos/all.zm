// Every demo the gallery knows, and the one place that switches over them.
//
// **One enum and six switches, in one file, on purpose.** Ziman has no dynamic dispatch and a
// lambda cannot capture a `var`, so thirteen demos cannot be thirteen closures: it is a variant
// per demo, and something has to switch. Keeping all of it here means adding a demo is one edit
// to one file plus two new files, and a missing arm is a compile error rather than a demo that
// silently never draws. **This file is the gallery's whole cost of growing**, and it is worth
// watching: at thirteen it is a page of arms, at fifty it would be an argument for something else.
//
// **A demo is exactly two files**, the logic and the design, and `files_of` derives both from the
// stem rather than listing them -- so a demo cannot be added with its design file forgotten.
use controls
use demos/accessibility
use demos/button
use demos/check_box
use demos/combo_box
use demos/dialog
use demos/layout
use demos/link
use demos/list
use demos/look_and_feel
use demos/menu
use demos/radios
use demos/scroll_bar
use demos/slider
use demos/split_pane
use demos/table
use demos/tabs
use demos/text_area
use demos/text_field
use demos/tree
use geom
use widget

pub enum Demo {
    Button(button.Demo)
    CheckBox(check_box.Demo)
    Radios(radios.Demo)
    TextField(text_field.Demo)
    TextArea(text_area.Demo)
    List(list.Demo)
    Tabs(tabs.Demo)
    Tree(tree.Demo)
    Table(table.Demo)
    ScrollBar(scroll_bar.Demo)
    Slider(slider.Demo)
    SplitPane(split_pane.Demo)
    ComboBox(combo_box.Demo)
    Menu(menu.Demo)
    Link(link.Demo)
    Dialog(dialog.Demo)
    Layout(layout.Demo)
    LookAndFeel(look_and_feel.Demo)
    Accessibility(accessibility.Demo)
}

// The catalogue, in the order the tree shows it: the plain controls, then the ones that hold
// other controls, then the ones that open something over the window.
pub fn all() -> [Demo] {
    return [
        Demo.Button(button.demo()),
        Demo.CheckBox(check_box.demo()),
        Demo.Radios(radios.demo()),
        Demo.TextField(text_field.demo()),
        Demo.TextArea(text_area.demo()),
        Demo.List(list.demo()),
        Demo.Tabs(tabs.demo()),
        Demo.Tree(tree.demo()),
        Demo.Table(table.demo()),
        Demo.ScrollBar(scroll_bar.demo()),
        Demo.Slider(slider.demo()),
        Demo.SplitPane(split_pane.demo()),
        Demo.ComboBox(combo_box.demo()),
        Demo.Menu(menu.demo()),
        Demo.Link(link.demo()),
        Demo.Dialog(dialog.demo()),
        Demo.Layout(layout.demo()),
        Demo.LookAndFeel(look_and_feel.demo()),
        Demo.Accessibility(accessibility.demo())
    ]
}

pub fn title_of(d: Demo) -> string {
    return switch d {
        Button(_) { "Button" }
        CheckBox(_) { "Check box" }
        Radios(_) { "Radio group" }
        TextField(_) { "Text field" }
        TextArea(_) { "Text area" }
        List(_) { "List" }
        Tabs(_) { "Tabs" }
        Tree(_) { "Tree" }
        Table(_) { "Table" }
        ScrollBar(_) { "Scroll bar" }
        Slider(_) { "Slider" }
        SplitPane(_) { "Split pane" }
        ComboBox(_) { "Combo box" }
        Menu(_) { "Menu" }
        Link(_) { "Link" }
        Dialog(_) { "Dialog" }
        Layout(_) { "Rows and columns" }
        LookAndFeel(_) { "Three looks" }
        Accessibility(_) { "What a reader says" }
    }
}

// The file stem both of its files are named after.
pub fn stem_of(d: Demo) -> string {
    return switch d {
        Button(_) { "button" }
        CheckBox(_) { "check_box" }
        Radios(_) { "radios" }
        TextField(_) { "text_field" }
        TextArea(_) { "text_area" }
        List(_) { "list" }
        Tabs(_) { "tabs" }
        Tree(_) { "tree" }
        Table(_) { "table" }
        ScrollBar(_) { "scroll_bar" }
        Slider(_) { "slider" }
        SplitPane(_) { "split_pane" }
        ComboBox(_) { "combo_box" }
        Menu(_) { "menu" }
        Link(_) { "link" }
        Dialog(_) { "dialog" }
        Layout(_) { "layout" }
        LookAndFeel(_) { "look_and_feel" }
        Accessibility(_) { "accessibility" }
    }
}

// The two files the Code tab shows, in the order a reader wants them: what it does, then how it
// is arranged.
pub fn files_of(d: Demo) -> [string] {
    return [concat(stem_of(d), ".zm"), concat(stem_of(d), "_ui.zm")]
}

pub fn view_of(d: Demo, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return switch d {
        Button(it) { button.view(it, style, m) }
        CheckBox(it) { check_box.view(it, style, m) }
        Radios(it) { radios.view(it, style, m) }
        TextField(it) { text_field.view(it, style, m) }
        TextArea(it) { text_area.view(it, style, m) }
        List(it) { list.view(it, style, m) }
        Tabs(it) { tabs.view(it, style, m) }
        Tree(it) { tree.view(it, style, m) }
        Table(it) { table.view(it, style, m) }
        ScrollBar(it) { scroll_bar.view(it, style, m) }
        Slider(it) { slider.view(it, style, m) }
        SplitPane(it) { split_pane.view(it, style, m) }
        ComboBox(it) { combo_box.view(it, style, m) }
        Menu(it) { menu.view(it, style, m) }
        Link(it) { link.view(it, style, m) }
        Dialog(it) { dialog.view(it, style, m) }
        Layout(it) { layout.view(it, style, m) }
        LookAndFeel(it) { look_and_feel.view(it, style, m) }
        Accessibility(it) { accessibility.view(it, style, m) }
    }
}

pub fn input_to(
    d: Demo,
    name: string,
    input: controls.Input,
    laid: widget.Laid,
    style: controls.Style,
    m: widget.Metrics
) -> Demo {
    return switch d {
        Button(it) { Demo.Button(button.input(it, name, input, laid, style, m)) }
        CheckBox(it) { Demo.CheckBox(check_box.input(it, name, input, laid, style, m)) }
        Radios(it) { Demo.Radios(radios.input(it, name, input, laid, style, m)) }
        TextField(it) { Demo.TextField(text_field.input(it, name, input, laid, style, m)) }
        TextArea(it) { Demo.TextArea(text_area.input(it, name, input, laid, style, m)) }
        List(it) { Demo.List(list.input(it, name, input, laid, style, m)) }
        Tabs(it) { Demo.Tabs(tabs.input(it, name, input, laid, style, m)) }
        Tree(it) { Demo.Tree(tree.input(it, name, input, laid, style, m)) }
        Table(it) { Demo.Table(table.input(it, name, input, laid, style, m)) }
        ScrollBar(it) { Demo.ScrollBar(scroll_bar.input(it, name, input, laid, style, m)) }
        Slider(it) { Demo.Slider(slider.input(it, name, input, laid, style, m)) }
        SplitPane(it) { Demo.SplitPane(split_pane.input(it, name, input, laid, style, m)) }
        ComboBox(it) { Demo.ComboBox(combo_box.input(it, name, input, laid, style, m)) }
        Menu(it) { Demo.Menu(menu.input(it, name, input, laid, style, m)) }
        Link(it) { Demo.Link(link.input(it, name, input, laid, style, m)) }
        Dialog(it) { Demo.Dialog(dialog.input(it, name, input, laid, style, m)) }
        Layout(it) { Demo.Layout(layout.input(it, name, input, laid, style, m)) }
        LookAndFeel(it) { Demo.LookAndFeel(look_and_feel.input(it, name, input, laid, style, m)) }
        Accessibility(it) { Demo.Accessibility(accessibility.input(it, name, input, laid, style, m)) }
    }
}

// ---- the demos that open something over the window

// The control a popup hangs under, or "" for a demo with nothing open.
//
// **A popup belongs under the control that opened it, and where that is cannot be known until the
// tree has been laid out** -- so the window is laid out twice when one is open, and only then.
// Computing the position from the layout arithmetic instead would be a second copy of the layout,
// in a comment, drifting.
pub fn anchor_of(d: Demo) -> string {
    return switch d {
        ComboBox(it) { combo_box.anchor(it) }
        Menu(it) { menu.anchor(it) }
        Layout(it) { layout.anchor(it) }
        LookAndFeel(it) { look_and_feel.anchor(it) }
        Accessibility(it) { accessibility.anchor(it) }
        Button(_) { "" }
        CheckBox(_) { "" }
        Radios(_) { "" }
        Slider(_) { "" }
        Link(_) { "" }
        TextField(_) { "" }
        TextArea(_) { "" }
        List(_) { "" }
        Tabs(_) { "" }
        Tree(_) { "" }
        Table(_) { "" }
        ScrollBar(_) { "" }
        SplitPane(_) { "" }
        Dialog(_) { "" }
    }
}

// The layer this demo wants over the window, if any. `at` is the box of whatever `anchor_of`
// named, which a modal dialog ignores: `dialog_layer` centres itself.
pub fn layer_of(d: Demo, style: controls.Style, m: widget.Metrics, at: geom.Rect) -> Option<widget.Layer> {
    return switch d {
        ComboBox(it) {
            if combo_box.anchor(it) == "" {
                Option<widget.Layer>.None
            } else {
                Option<widget.Layer>.Some(combo_box.layer(it, style, at))
            }
        }
        Menu(it) {
            if menu.anchor(it) == "" {
                Option<widget.Layer>.None
            } else {
                Option<widget.Layer>.Some(menu.layer(it, style, at))
            }
        }
        Dialog(it) {
            if dialog.showing(it) {
                Option<widget.Layer>.Some(dialog.layer(it, style, m))
            } else {
                Option<widget.Layer>.None
            }
        }
        Layout(it) {
            if layout.anchor(it) == "" {
                Option<widget.Layer>.None
            } else {
                Option<widget.Layer>.Some(layout.layer(it, style, at))
            }
        }
        LookAndFeel(it) {
            if look_and_feel.anchor(it) == "" {
                Option<widget.Layer>.None
            } else {
                Option<widget.Layer>.Some(look_and_feel.layer(it, style, at))
            }
        }
        Accessibility(it) {
            if accessibility.anchor(it) == "" {
                Option<widget.Layer>.None
            } else {
                Option<widget.Layer>.Some(accessibility.layer(it, style, at))
            }
        }
        Button(_) { Option<widget.Layer>.None }
        CheckBox(_) { Option<widget.Layer>.None }
        Radios(_) { Option<widget.Layer>.None }
        Slider(_) { Option<widget.Layer>.None }
        Link(_) { Option<widget.Layer>.None }
        TextField(_) { Option<widget.Layer>.None }
        TextArea(_) { Option<widget.Layer>.None }
        List(_) { Option<widget.Layer>.None }
        Tabs(_) { Option<widget.Layer>.None }
        Tree(_) { Option<widget.Layer>.None }
        Table(_) { Option<widget.Layer>.None }
        ScrollBar(_) { Option<widget.Layer>.None }
        SplitPane(_) { Option<widget.Layer>.None }
    }
}

// Which branch of the catalogue a demo hangs under.
//
// **A group with one demo in it is still a group.** The branches say what the gallery is *about*
// -- the controls, the box model, the look, what a reader hears -- and a tree that grew its
// second branch later would change every row index at once, which is the arithmetic every test
// here depends on.
pub fn group_of(d: Demo) -> string {
    return switch d {
        Layout(_) { "Layout" }
        LookAndFeel(_) { "Look and feel" }
        Accessibility(_) { "Accessibility" }
        Button(_) { "Controls" }
        CheckBox(_) { "Controls" }
        Radios(_) { "Controls" }
        Slider(_) { "Controls" }
        Link(_) { "Controls" }
        TextField(_) { "Controls" }
        TextArea(_) { "Controls" }
        List(_) { "Controls" }
        Tabs(_) { "Controls" }
        Tree(_) { "Controls" }
        Table(_) { "Controls" }
        ScrollBar(_) { "Controls" }
        SplitPane(_) { "Controls" }
        ComboBox(_) { "Controls" }
        Menu(_) { "Controls" }
        Dialog(_) { "Controls" }
    }
}

// The branches, in the order the tree shows them.
pub fn groups() -> [string] {
    return ["Controls", "Layout", "Look and feel", "Accessibility"]
}
