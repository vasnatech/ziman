// ---- the demos that open something over the window

// The control a popup hangs under, or "" for a demo with nothing open.
//
// **A popup belongs under the control that opened it, and where that is cannot be known until the
// tree has been laid out** -- so the window is laid out twice when one is open, and only then.
// Computing the position from the layout arithmetic instead would be a second copy of the layout,
// in a comment, drifting.
pub fn anchor_of(d: Demo) -> string {
    return switch d {
        ComboBox(it) { combo_box.anchor(it) }
        Menu(it) { menu.anchor(it) }
        Layout(it) { layout.anchor(it) }
        LookAndFeel(it) { look_and_feel.anchor(it) }
        Accessibility(it) { accessibility.anchor(it) }
        Button(_) { "" }
        CheckBox(_) { "" }
        Switch(_) { "" }
        Progress(_) { "" }
        NumberField(_) { "" }
        Tooltip(it) { tooltip.anchor(it) }
        Expander(_) { "" }
        Toolbar(_) { "" }
        Context(_) { "" }
        DateField(_) { "" }
        Grid(_) { "grid-method" }
        Flow(_) { "" }
        Autocomplete(_) { "" }
        Panel(_) { "" }
        Search(_) { "" }
        Badge(_) { "" }
        Card(_) { "" }
        Radios(_) { "" }
        Slider(_) { "" }
        Link(_) { "" }
        TextField(_) { "" }
        TextArea(_) { "" }
        List(_) { "" }
        Tabs(_) { "" }
        Tree(_) { "" }
        Table(_) { "" }
        ScrollBar(_) { "" }
        SplitPane(_) { "" }
        Dialog(_) { "" }
        Picture(_) { "" }
        Composing(_) { "" }
    }
}

// The layer this demo wants over the window, if any. `at` is the box of whatever `anchor_of`
// named, which a modal dialog ignores: `dialog_layer` centres itself.
// `laid` is the whole tree, not only the anchor's box: a tooltip's words come from the control the
// pointer is on, which means asking the tree what that control declares. The popups ignore it.
pub fn layer_of(d: Demo, at: geom.Rect, laid: widget.Laid, f: controls.Frame) -> Option<widget.Layer> {
    return switch d {
        ComboBox(it) {
            if combo_box.anchor(it) == "" {
                Option<widget.Layer>.None
            } else {
                Option<widget.Layer>.Some(combo_box.layer(it, at, f))
            }
        }
        Menu(it) {
            if menu.anchor(it) == "" {
                Option<widget.Layer>.None
            } else {
                Option<widget.Layer>.Some(menu.layer(it, at, f))
            }
        }
        Dialog(it) {
            if dialog.showing(it) {
                Option<widget.Layer>.Some(dialog.layer(it, f))
            } else {
                Option<widget.Layer>.None
            }
        }
        Layout(it) {
            if layout.anchor(it) == "" {
                Option<widget.Layer>.None
            } else {
                Option<widget.Layer>.Some(layout.layer(it, at, f))
            }
        }
        LookAndFeel(it) {
            if look_and_feel.anchor(it) == "" {
                Option<widget.Layer>.None
            } else {
                Option<widget.Layer>.Some(look_and_feel.layer(it, at, f))
            }
        }
        Accessibility(it) {
            if accessibility.anchor(it) == "" {
                Option<widget.Layer>.None
            } else {
                Option<widget.Layer>.Some(accessibility.layer(it, at, f))
            }
        }
        Button(_) { Option<widget.Layer>.None }
        CheckBox(_) { Option<widget.Layer>.None }
        Switch(_) { Option<widget.Layer>.None }
        Progress(_) { Option<widget.Layer>.None }
        NumberField(_) { Option<widget.Layer>.None }
        Tooltip(it) { tooltip.layer(it, at, laid, f) }
        Expander(_) { Option<widget.Layer>.None }
        Toolbar(it) { toolbar.layer_at(it, laid, f) }
        Context(it) { context.layer_at(it, laid, f) }
        DateField(it) { date_field.layer_at(it, laid, f) }
        Grid(it) { grid.layer_at(it, at, f) }
        Flow(_) { Option<widget.Layer>.None }
        Autocomplete(it) { autocomplete.layer_at(it, laid, f) }
        Panel(_) { Option<widget.Layer>.None }
        Search(_) { Option<widget.Layer>.None }
        Badge(_) { Option<widget.Layer>.None }
        Card(_) { Option<widget.Layer>.None }
        Radios(_) { Option<widget.Layer>.None }
        Slider(_) { Option<widget.Layer>.None }
        Link(_) { Option<widget.Layer>.None }
        TextField(_) { Option<widget.Layer>.None }
        TextArea(_) { Option<widget.Layer>.None }
        List(_) { Option<widget.Layer>.None }
        Tabs(_) { Option<widget.Layer>.None }
        Tree(_) { Option<widget.Layer>.None }
        Table(_) { Option<widget.Layer>.None }
        ScrollBar(_) { Option<widget.Layer>.None }
        SplitPane(_) { Option<widget.Layer>.None }
        Picture(_) { Option<widget.Layer>.None }
        Composing(_) { Option<widget.Layer>.None }
    }
}

// Which branch of the catalogue a demo hangs under.
//
// **A group with one demo in it is still a group.** The branches say what the gallery is *about*
// -- the controls, the box model, the look, what a reader hears -- and a tree that grew its
// second branch later would change every row index at once, which is the arithmetic every test
// here depends on.
pub fn group_of(d: Demo) -> string {
    return switch d {
        Layout(_) { "Layout" }
        Picture(_) { "Drawing" }
        LookAndFeel(_) { "Look and feel" }
        Accessibility(_) { "Accessibility" }
        Composing(_) { "Accessibility" }
        Button(_) { "Controls" }
        CheckBox(_) { "Controls" }
        Switch(_) { "Controls" }
        Progress(_) { "Controls" }
        NumberField(_) { "Controls" }
        Tooltip(_) { "Controls" }
        Expander(_) { "Controls" }
        Toolbar(_) { "Controls" }
        Context(_) { "Controls" }
        DateField(_) { "Controls" }
        Grid(_) { "Layout" }
        Flow(_) { "Layout" }
        Autocomplete(_) { "Controls" }
        Panel(_) { "Controls" }
        Search(_) { "Controls" }
        Badge(_) { "Controls" }
        Card(_) { "Controls" }
        Radios(_) { "Controls" }
        Slider(_) { "Controls" }
        Link(_) { "Controls" }
        TextField(_) { "Controls" }
        TextArea(_) { "Controls" }
        List(_) { "Controls" }
        Tabs(_) { "Controls" }
        Tree(_) { "Controls" }
        Table(_) { "Controls" }
        ScrollBar(_) { "Controls" }
        SplitPane(_) { "Controls" }
        ComboBox(_) { "Controls" }
        Menu(_) { "Controls" }
        Dialog(_) { "Controls" }
    }
}

// The branches, in the order the tree shows them.
pub fn groups() -> [string] {
    return ["Controls", "Layout", "Drawing", "Look and feel", "Accessibility"]
}

// The shape the pointer should take over this demo, at a point in the demo's own box.
//
// **Only two demos have an answer and the rest say arrow**, which is the honest shape of it: a
// cursor is a promise that something will happen if you drag, and only a divider and a column
// edge make that promise. See `controls.split_pane_cursor`.
pub fn cursor_of(
    d: Demo,
    laid: widget.Laid,
    at: geom.Point,
    f: controls.Frame
) -> widget.Cursor {
    return switch d {
        SplitPane(it) { split_pane.cursor(it, laid, at, f) }
        Table(it) { table.cursor(it, laid, at, f) }
        Button(_) { widget.Cursor.Arrow }
        CheckBox(_) { widget.Cursor.Arrow }
        Switch(_) { widget.Cursor.Arrow }
        Progress(_) { widget.Cursor.Arrow }
        NumberField(_) { widget.Cursor.Text }
        Tooltip(_) { widget.Cursor.Arrow }
        Expander(_) { widget.Cursor.Arrow }
        Toolbar(_) { widget.Cursor.Arrow }
        Context(_) { widget.Cursor.Arrow }
        DateField(_) { widget.Cursor.Text }
        Grid(_) { widget.Cursor.Arrow }
        Flow(_) { widget.Cursor.Arrow }
        Autocomplete(_) { widget.Cursor.Text }
        Panel(_) { widget.Cursor.Arrow }
        Search(_) { widget.Cursor.Text }
        Badge(_) { widget.Cursor.Arrow }
        Card(_) { widget.Cursor.Arrow }
        Radios(_) { widget.Cursor.Arrow }
        Slider(_) { widget.Cursor.Arrow }
        Link(_) { widget.Cursor.Arrow }
        TextField(_) { widget.Cursor.Arrow }
        TextArea(_) { widget.Cursor.Arrow }
        List(_) { widget.Cursor.Arrow }
        Tabs(_) { widget.Cursor.Arrow }
        Tree(_) { widget.Cursor.Arrow }
        ScrollBar(_) { widget.Cursor.Arrow }
        ComboBox(_) { widget.Cursor.Arrow }
        Menu(_) { widget.Cursor.Arrow }
        Dialog(_) { widget.Cursor.Arrow }
        Layout(_) { widget.Cursor.Arrow }
        Picture(_) { widget.Cursor.Arrow }
        LookAndFeel(_) { widget.Cursor.Arrow }
