// Every demo the gallery knows, and the one place that switches over them.
//
// **One enum and six switches, in one file, on purpose.** Ziman has no dynamic dispatch and a
// lambda cannot capture a `var`, so thirteen demos cannot be thirteen closures: it is a variant
// per demo, and something has to switch. Keeping all of it here means adding a demo is one edit
// to one file plus two new files, and a missing arm is a compile error rather than a demo that
// silently never draws. **This file is the gallery's whole cost of growing**, and it is worth
// watching: at thirteen it is a page of arms, at fifty it would be an argument for something else.
//
// **A demo is exactly two files**, the logic and the design, and `files_of` derives both from the
// stem rather than listing them -- so a demo cannot be added with its design file forgotten.
use controls
use demos/accessibility
use demos/autocomplete
use demos/badge
use demos/button
use demos/card
use demos/check_box
use demos/combo_box
use demos/composing
use demos/context
use demos/date_field
use demos/dialog
use demos/expander
use demos/flow
use demos/grid
use demos/layout
use demos/link
use demos/list
use demos/look_and_feel
use demos/menu
use demos/number_field
use demos/panel
use demos/picture
use demos/progress
use demos/radios
use demos/scroll_bar
use demos/search
use demos/slider
use demos/split_pane
use demos/switches
use demos/table
use demos/tabs
use demos/text_area
use demos/text_field
use demos/toolbar
use demos/tooltip
use demos/tree
use geom
use widget

pub enum Demo {
    Button(button.Demo)
    CheckBox(check_box.Demo)
    Switch(switches.Demo)
    Progress(progress.Demo)
    NumberField(number_field.Demo)
    Tooltip(tooltip.Demo)
    Expander(expander.Demo)
    Toolbar(toolbar.Demo)
    Context(context.Demo)
    DateField(date_field.Demo)
    Grid(grid.Demo)
    Flow(flow.Demo)
    Autocomplete(autocomplete.Demo)
    Panel(panel.Demo)
    Search(search.Demo)
    Badge(badge.Demo)
    Card(card.Demo)
    Radios(radios.Demo)
    TextField(text_field.Demo)
    TextArea(text_area.Demo)
    List(list.Demo)
    Tabs(tabs.Demo)
    Tree(tree.Demo)
    Table(table.Demo)
    ScrollBar(scroll_bar.Demo)
    Slider(slider.Demo)
    SplitPane(split_pane.Demo)
    ComboBox(combo_box.Demo)
    Menu(menu.Demo)
    Link(link.Demo)
    Dialog(dialog.Demo)
    Layout(layout.Demo)
    Picture(picture.Demo)
    LookAndFeel(look_and_feel.Demo)
    Accessibility(accessibility.Demo)
    Composing(composing.Demo)
}

// The catalogue, in the order the tree shows it: the plain controls, then the ones that hold
// other controls, then the ones that open something over the window.
pub fn all() -> [Demo] {
    return [
        Demo.Button(button.demo()),
        Demo.CheckBox(check_box.demo()),
        Demo.Switch(switches.demo()),
        Demo.Progress(progress.demo()),
        Demo.NumberField(number_field.demo()),
        Demo.Tooltip(tooltip.demo()),
        Demo.Expander(expander.demo()),
        Demo.Toolbar(toolbar.demo()),
        Demo.Context(context.demo()),
        Demo.DateField(date_field.demo()),
        Demo.Grid(grid.demo()),
        Demo.Flow(flow.demo()),
        Demo.Autocomplete(autocomplete.demo()),
        Demo.Panel(panel.demo()),
        Demo.Search(search.demo()),
        Demo.Badge(badge.demo()),
        Demo.Card(card.demo()),
        Demo.Radios(radios.demo()),
        Demo.TextField(text_field.demo()),
        Demo.TextArea(text_area.demo()),
        Demo.List(list.demo()),
        Demo.Tabs(tabs.demo()),
        Demo.Tree(tree.demo()),
        Demo.Table(table.demo()),
        Demo.ScrollBar(scroll_bar.demo()),
        Demo.Slider(slider.demo()),
        Demo.SplitPane(split_pane.demo()),
        Demo.ComboBox(combo_box.demo()),
        Demo.Menu(menu.demo()),
        Demo.Link(link.demo()),
        Demo.Dialog(dialog.demo()),
        Demo.Layout(layout.demo()),
        Demo.Picture(picture.demo()),
        Demo.LookAndFeel(look_and_feel.demo()),
        Demo.Accessibility(accessibility.demo()),
        Demo.Composing(composing.demo())
    ]
}

