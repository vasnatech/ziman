// The Table demo, as design.
use controls
use widget

val gap = 8.0
val table_height = 180.0

pub struct Screen {
    table: widget.Widget
    said: string
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        widget.tall_of(table_height, it.table),
        widget.label_of(it.said, style.text.caption.size, style.ink)
    ])
}
