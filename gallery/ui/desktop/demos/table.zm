// A table: a header that stays, rows that scroll, columns you can drag by their edges.
//
// **Press a column's title to sort by it**, again to reverse it, and a third time to put the
// order back the way it was given. Three states and not two, because the order a caller gave is
// meaningful and a header that could only toggle would throw it away the moment somebody touched
// it. Sort by Mass and watch 9 come before 10 -- held as text it would not, which is what F321
// was for.
//
// **Drag a column's trailing edge in the header** -- the grip is four points either side of it,
// in the header and nowhere else, because four points from a boundary in the middle of the data
// is a selection in every table ever written. The title between the grips is what sorts.
//
// **A cell holds a value, not a string**, which is `TableModel.getColumnClass` without the
// reflection: the atomic numbers are `Whole`, the masses are `Number`, "Metal" is a `Flag` drawn
// as a check box, and the years are `Code`. Nothing here was formatted by this demo -- the table
// writes each value in its own locale, which is why the masses carry the separators they do and
// the years do not.
use boxes
use controls
use demos/table_ui
use geom
use widget
use widget.Toggle

pub struct Demo {
    table: controls.Table
    chosen: int
}

pub fn demo() -> Demo {
    return Demo {
        table: controls.table_of("table-demo", "Elements", columns(), rows()),
        chosen: 0
    }
}

// A number reads from the right, which is what `numeric_column_of` says and why it is a second
// constructor rather than a field to remember to set.
fn columns() -> [controls.Column] {
    return [
        controls.numeric_column_of("Z", 50.0),
        controls.column_of("Element", 130.0),
        controls.column_of("Symbol", 80.0),
        controls.numeric_column_of("Mass", 100.0),
        controls.column_of("Metal", 60.0),
        controls.column_of("Found", 110.0)
    ]
}

fn element(z: int, name: string, symbol: string, mass: float, metal: bool, year: int) -> [controls.Value] {
    return [
        controls.Value.Whole(z),
        controls.Value.Text(name),
        controls.Value.Text(symbol),
        controls.Value.Number(mass),
        controls.Value.Flag(if metal { Toggle.On } else { Toggle.Off }),
        // **A year is a `Code` and not a `Whole`**, which is the distinction the render of this
        // very demo found: written as a quantity it came out "1,766". A year identifies, it does
        // not count. A real date column is `Value.Date`.
        controls.Value.Code(year)
    ]
}

fn rows() -> [[controls.Value]] {
    return [
        element(1, "Hydrogen", "H", 1.008, false, 1766),
        element(2, "Helium", "He", 4.0026, false, 1868),
        element(3, "Lithium", "Li", 6.94, true, 1817),
        element(6, "Carbon", "C", 12.011, false, 1789),
        element(7, "Nitrogen", "N", 14.007, false, 1772),
        element(8, "Oxygen", "O", 15.999, false, 1771),
        element(11, "Sodium", "Na", 22.99, true, 1807),
        element(26, "Iron", "Fe", 55.845, true, 1500),
        element(29, "Copper", "Cu", 63.546, true, 1500),
        element(47, "Silver", "Ag", 107.87, true, 1500),
        element(79, "Gold", "Au", 196.97, true, 1500),
        // A short row, which a table built from a query gets sooner or later: the cells past its
        // end are `Blank` and drawn empty rather than refused.
        [controls.Value.Whole(118), controls.Value.Text("Oganesson")]
    ]
}

pub fn view(d: Demo, f: controls.Frame) -> widget.Widget {
    val style = f.style
    val m = f.metrics
    return table_ui.screen(
        table_ui.Screen {
            table: controls.table_widget(d.table, controls.frame_of(style, m)),
            said: said(d)
        },
        f
    )
}

fn said(d: Demo) -> string {
    return concat(
        "Selected: ",
        controls.row_label(d.table, d.table.selected),
        ". ",
        ordered_by(d.table)
    )
}

fn ordered_by(t: controls.Table) -> string {
    if t.sorted_by < 0 {
        return "In the order they were given -- press a title to sort."
    }
    return concat(
        "Sorted by ",
        t.columns[t.sorted_by].title,
        if t.ascending { ", ascending." } else { ", descending." }
    )
}

// What the pointer is over, asked of the control so the pointer cannot show arrows where a drag would select a row.
pub fn cursor(d: Demo, laid: widget.Laid, at: geom.Point, f: controls.Frame) -> widget.Cursor {
    val style = f.style
    val m = f.metrics
    return controls.table_cursor(d.table, style, boxes.bounds_of(laid, "table-demo"), at, m)
}

pub fn input(
    d: Demo,
    name: string,
    input: controls.Input,
    laid: widget.Laid,
    f: controls.Frame
) -> Demo {
    val style = f.style
    val m = f.metrics
    if name == "table-demo" {
        return with d { table: controls.table_input(
            d.table,
            input,
            boxes.bounds_of(laid, name),
            controls.frame_of(style, m)
        ).table }
    }
    return d
}
