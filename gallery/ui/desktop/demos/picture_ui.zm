// The Pictures and paths demo, as design.
use controls
use widget

val gap = 8.0
val label_width = 90.0

pub struct Screen {
    size: widget.Widget
    size_said: string
    picture: widget.Widget
    drawing: widget.Widget
    said: string
}

// The two side by side, **centred across rather than stretched**.
//
// A row stretches every child to its own height by default, so a `Fixed` asking for a square
// comes out a square wide and a band tall -- which the picture survives, because
// `picture_fitted` keeps its aspect inside whatever box it is given, and the drawing does not:
// a path scaled into a 64-by-180 box is a stretched path. A stack cannot be given a child whose
// shape it must keep; it can only be told not to stretch it.
pub fn band(picture: widget.Widget, drawing: widget.Widget) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: gap,
        padding: widget.no_insets(),
        surface: widget.no_surface(),
        align: widget.Alignment { across: widget.Across.Centre, along: widget.Along.Start },
        children: [picture, drawing, widget.flex()],
        name: ""
    })
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(gap, [
            widget.wide_of(label_width, widget.label_of("Drawn at", style.text.caption.size, style.ink)),
            widget.expand(it.size),
            widget.wide_of(label_width, widget.label_of(it.size_said, style.text.caption.size, style.ink))
        ]),
        band(it.picture, it.drawing),
        widget.label_of(it.said, style.text.caption.size, style.ink)
    ])
}
