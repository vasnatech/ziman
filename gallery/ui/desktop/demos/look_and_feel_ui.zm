// The Look and feel demo, as design.
use controls
use widget

val gap = 8.0
val label_width = 110.0
val picker_width = 160.0
val field_width = 220.0
val button_width = 120.0
val row_height = 24.0

pub struct Screen {
    picker: widget.Widget
    button: widget.Widget
    check: widget.Widget
    field: widget.Widget
    said: string
    // The editor: two seeds and three choices, which is the whole of what a look is (D12).
    neutral_hue: widget.Widget
    neutral_chroma: widget.Widget
    accent_hue: widget.Widget
    accent_chroma: widget.Widget
    scheme: widget.Widget
    surfaces: widget.Widget
    density: widget.Widget
    edged: widget.Widget
    // What to paste into a `.zm` file: the deliverable, and the reason there is no file format.
    // **A widget rather than a string**, because it is one line per line and a design file cannot
    // loop -- see `look_and_feel.source_widget`.
    source: widget.Widget
    // Whether the picker is on the look being designed. **The editor is shown either way** -- a
    // control that appears and disappears as a list changes is one the eye has to hunt for -- but
    // the source below it is only worth reading when it is what you are looking at.
    designing: bool
    // The chosen look, for the band's own background. **A demo of a dark look on a light window
    // is not a demo of a dark look**: a button and a field carry their own faces and read fine,
    // but a check box's *label* has no face under it, so it was drawn in the dark look's near
    // white ink straight onto the gallery's near white window and disappeared. `Style.window` is
    // the token that fixes it, which is a fair demonstration of why that token exists.
    look: controls.Style
}

// The controls under the chosen look, on that look's own window colour.
pub fn band(it: Screen) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: gap,
        padding: widget.insets_of(gap, gap, gap, gap),
        surface: widget.filled(it.look.window),
        // **Stretched, not centred**, which is what `widget.row_of` uses and why the controls
        // vanished the first time this band had a surface: every child here is
        // `fixed_of(width, 0.0, ..)`, and a height of zero across an axis nothing stretches stays
        // zero. Same trap as the table's header band, the link, the slider's thumb and the check
        // box's mark -- nothing drawn, no error, every test green.
        align: widget.stretched(),
        children: [
            widget.wide_of(button_width, it.button),
            widget.wide_of(field_width, it.field),
            widget.expand(it.check)
        ],
        name: ""
    })
}

// One labelled control of the editor, on its own line.
pub fn knob(said: string, control: widget.Widget, f: controls.Frame) -> widget.Widget {
    return widget.tall_of(row_height, widget.row_of(gap, [
        widget.wide_of(label_width, widget.label_of(said, f.style.text.caption.size, f.style.ink)),
        widget.expand(control)
    ]))
}

// The two seeds and the three choices.
//
// **Every one of these is a thing a ramp cannot derive**, which is why they and only they are here:
// the hue and chroma of the two seeds, which end the look is read from, which way its surfaces move
// from the window, and whether a face wears step 7's border. Everything else -- twelve neutral
// steps, twelve accent steps, five state rows -- follows from them.
pub fn editor(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        knob("Neutral hue", it.neutral_hue, f),
        knob("Neutral chroma", it.neutral_chroma, f),
        knob("Accent hue", it.accent_hue, f),
        knob("Accent chroma", it.accent_chroma, f),
        knob("Scheme", it.scheme, f),
        knob("Surfaces", it.surfaces, f),
        knob("Edges", it.edged, f),
        // Last, and below the line the others are above: the seeds and the choices make the
        // look, and this one does not -- it is how much room to show it in.
        knob("Density", it.density, f)
    ])
}

// What the designed look is, as source.
//
// **In the code face, because it is code** -- it is pasted into a `.zm` file, and a monospaced
// run is the difference between something to read and something to copy. See D12: a look leaves
// this window as two seeds, so there is no loader, no schema and nothing to be invalid at run
// time.
pub fn source(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Column,
        spacing: 0.0,
        padding: widget.insets_of(gap, gap, gap, gap),
        surface: widget.filled(f.style.panel),
        align: widget.stretched(),
        children: [it.source],
        name: ""
    })
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(gap, [
            widget.wide_of(label_width, widget.label_of("Look and feel", f.style.text.caption.size, f.style.ink)),
            widget.wide_of(picker_width, it.picker),
            widget.expand(widget.flex())
        ]),
        band(it),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink),
        editor(it, f),
        source(it, f)
    ])
}
