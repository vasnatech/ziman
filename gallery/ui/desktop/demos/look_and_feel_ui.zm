// The Look and feel demo, as design.
use controls
use widget

val gap = 8.0
val label_width = 110.0
val picker_width = 160.0
val field_width = 220.0
val button_width = 120.0

pub struct Screen {
    picker: widget.Widget
    button: widget.Widget
    check: widget.Widget
    field: widget.Widget
    said: string
    // The chosen look, for the band's own background. **A demo of a dark look on a light window
    // is not a demo of a dark look**: a button and a field carry their own faces and read fine,
    // but a check box's *label* has no face under it, so it was drawn in the dark look's near
    // white ink straight onto the gallery's near white window and disappeared. `Style.window` is
    // the token that fixes it, which is a fair demonstration of why that token exists.
    look: controls.Style
}

// The controls under the chosen look, on that look's own window colour.
pub fn band(it: Screen) -> widget.Widget {
    return widget.Widget.Group(widget.Stack {
        direction: widget.Direction.Row,
        spacing: gap,
        padding: widget.insets_of(gap, gap, gap, gap),
        surface: widget.filled(it.look.window),
        // **Stretched, not centred**, which is what `widget.row_of` uses and why the controls
        // vanished the first time this band had a surface: every child here is
        // `fixed_of(width, 0.0, ..)`, and a height of zero across an axis nothing stretches stays
        // zero. Same trap as the table's header band, the link, the slider's thumb and the check
        // box's mark -- nothing drawn, no error, every test green.
        align: widget.stretched(),
        children: [
            widget.wide_of(button_width, it.button),
            widget.wide_of(field_width, it.field),
            widget.expand(it.check)
        ],
        name: ""
    })
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(gap, [
            widget.wide_of(label_width, widget.label_of("Look and feel", f.style.text.caption.size, f.style.ink)),
            widget.wide_of(picker_width, it.picker),
            widget.expand(widget.flex())
        ]),
        band(it),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}
