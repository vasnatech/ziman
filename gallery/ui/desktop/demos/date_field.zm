// A date, picked off a calendar.
//
// **One box, not a field with a button beside it.** This is the combo box's shape and the combo
// box's argument: the value, the mark that says it opens, one stop in the tab order and one thing
// a reader names. A text field with a calendar button next to it is two controls that have to
// agree about one value.
//
// **It cannot hold anything that is not a date**, which is what not being editable buys: `date_in`
// answers a `LocalDate` and no caller has to check. When typing arrives the value becomes text
// again, because a field being typed into has to hold `2026-11-` -- not a date, and plainly on
// the way to one.
//
// **Paging the months writes nothing.** Open it and press PageDown, or the arrows, and watch the
// box stay where it was: moving the highlight is looking, and Enter is choosing.
//
// **Press the header to zoom out** -- days to months to years, and choosing zooms back in. A year
// twelve years away is four presses this way and a hundred and forty-four on a month arrow.
//
// The week starts where the locale says it does: Sunday in the United States and Japan, Monday
// across most of Europe, Saturday in much of the Arabic-speaking world. The grid rotates rather
// than being relabelled, so the 19th stays under Thursday either way.
use controls
use demos/date_field_ui
use time
use widget

pub struct Demo {
    due: controls.DateField
}

pub fn demo() -> Demo {
    return Demo { due: controls.date_field_of("date-due", "Due", chosen()) }
}

fn chosen() -> time.LocalDate {
    return switch time.localdate_of(2026, 11, 19) {
        Ok(d) { d }
        Err(_) { time.localdate_from_epoch_day(0) }
    }
}

pub fn view(d: Demo, f: controls.Frame) -> widget.Widget {
    return date_field_ui.screen(
        date_field_ui.Screen { field: controls.date_field_widget(d.due, f), said: said(d) },
        f
    )
}

fn said(d: Demo) -> string {
    return concat(
        "That is ",
        time.format(controls.date_in(d.due), time.datetime_format_of("EEEE dd MMMM yyyy"), d.due.locale),
        ". Press the header to pick a month, and again to pick a year -- the box will not move until you choose a day."
    )
}

pub fn layer_at(d: Demo, laid: widget.Laid, f: controls.Frame) -> Option<widget.Layer> {
    return controls.calendar_layer(d.due, laid, laid.bounds, f)
}

pub fn input(
    d: Demo,
    name: string,
    input: controls.Input,
    laid: widget.Laid,
    f: controls.Frame
) -> Demo {
    // While the calendar is open every input belongs to it, which is what lets a click anywhere
    // dismiss it. Shut, only the box's own name counts.
    if !d.due.open && name != "date-due" {
        return d
    }
    return with d { due: controls.date_field_input(d.due, input, laid, laid.bounds, f).field }
}
