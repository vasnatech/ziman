// The Scroll bar demo, as design.
use controls
use widget

val gap = 8.0
val bar_height = 180.0
val bar_width = 12.0

pub struct Screen {
    bar: widget.Widget
    said: string
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        widget.tall_of(bar_height, widget.row_of(gap, [
            widget.wide_of(bar_width, it.bar),
            widget.expand(widget.flex())
        ])),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}
