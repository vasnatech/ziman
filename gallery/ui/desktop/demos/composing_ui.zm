// The Input method demo, as design.
use controls
use widget

val gap = 8.0
val label_width = 110.0
val button_width = 120.0

pub struct Screen {
    field: widget.Widget
    back: widget.Widget
    on: widget.Widget
    stage: string
    said: string
    note: string
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(gap, [
            widget.wide_of(label_width, widget.label_of("Your name", f.style.text.caption.size, f.style.ink)),
            widget.expand(it.field)
        ]),
        widget.row_of(gap, [
            widget.wide_of(button_width, it.back),
            widget.wide_of(button_width, it.on),
            widget.expand(widget.label_of(it.stage, f.style.text.heading.size, f.style.ink))
        ]),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink),
        widget.label_of(it.note, f.style.text.caption.size, f.style.ink)
    ])
}
