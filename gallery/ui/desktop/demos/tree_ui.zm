// The Tree demo, as design.
use controls
use widget

val gap = 8.0
val tree_height = 200.0
val tree_width = 260.0

pub struct Screen {
    tree: widget.Widget
    said: string
}

pub fn screen(it: Screen, f: controls.Frame) -> widget.Widget {
    return widget.column_of(gap, [
        widget.tall_of(tree_height, widget.row_of(gap, [
            widget.wide_of(tree_width, it.tree),
            widget.expand(widget.flex())
        ])),
        widget.label_of(it.said, f.style.text.caption.size, f.style.ink)
    ])
}
