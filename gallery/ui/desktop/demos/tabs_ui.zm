// The Tabs demo, as design.
use controls
use widget

val gap = 8.0
val strip_width = 400.0
val panel_height = 120.0

pub struct Screen {
    strip: widget.Widget
    panel: string
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        widget.row_of(gap, [
            widget.wide_of(strip_width, it.strip),
            widget.expand(widget.flex())
        ]),
        widget.tall_of(panel_height, widget.label_of(it.panel, style.text.caption.size, style.ink))
    ])
}
