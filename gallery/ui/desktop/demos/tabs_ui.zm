// The Tabs demo, as design.
use controls
use widget

val gap = 8.0
val row_height = 30.0
val strip_width = 400.0
val panel_height = 120.0
val small_size = 11.0

pub struct Screen {
    strip: widget.Widget
    panel: string
}

pub fn screen(it: Screen, style: controls.Style, m: widget.Metrics) -> widget.Widget {
    return widget.column_of(gap, [
        widget.fixed_of(0.0, row_height, widget.row_of(gap, [
            widget.fixed_of(strip_width, 0.0, it.strip),
            widget.expand(widget.flex())
        ])),
        widget.fixed_of(0.0, panel_height, widget.label_of(it.panel, small_size, style.ink))
    ])
}
