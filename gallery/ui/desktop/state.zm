// The gallery's state and what an input does to it.
//
// **Everything the window is, in one value.** A control here cannot act -- Ziman will not let a
// lambda mutate what it captured -- so there is nowhere for a callback to put anything, and the
// window's state has to be a value the program threads through. That is the architecture, not a
// style choice, and twenty demos is where it is worth seeing whether it scales.
use boxes
use controls
use demos/all
use focus
use gallery_ui
use gallery_ui.catalogue_min
use gallery_ui.catalogue_width
use gallery_ui.demo_min
use gallery_ui.file_tab_width
use gallery_ui.frame_width
use gallery_ui.tab_width
use geom
use highlight
use os
use source
use widget

// The demo tab and the code tab, by index into `tabs`.
val demo_tab = 0
val code_tab = 1

// The face the Code tab reads in: index 1 of whatever the window loaded, which `gallery.zm`
// guarantees is a real face even on a machine with no monospaced font.
//
// **Code is read in a monospaced face because code is written in one.** A proportional face turns
// an aligned comment into a ragged one and makes two spaces look like one, which in a pane whose
// whole job is to show indentation is not a small thing.
val code_face = 1

pub struct State {
    split: controls.SplitPane
    // How wide the window is, in points: the divider's position is in points and `view` is handed
    // no bounds to clamp it against, so the event loop writes it here on every resize.
    window_width: float
    tree: controls.Tree
    // Which demo each tree row shows. See `row_demos`.
    row_demo: [int]
    tabs: controls.ToggleGroup
    // One tab per file of the chosen demo, named after the file.
    files: controls.ToggleGroup
    // The file the strip chose, as a read-only text area.
    //
    // **A field rather than a column of labels**, which is the lesson curly's response pane
    // learned: labels are not focusable, so Tab could not reach the code and the only way to
    // scroll it was the wheel. A read-only `Entry` moves a caret through the text, scrolls to
    // follow it, and publishes its contents so a reader can read the code out.
    source: controls.Entry
    // Every demo's state, kept while you are looking at another one: coming back to a demo and
    // finding it as you left it is what makes a gallery feel like an application rather than a
    // slideshow.
    demos: [all.Demo]
    at: int
    status: string
    // The sentence the demo's own file opens with, shown in the view's header.
    //
    // **Captured when the demo changes, not when a file is chosen.** `loaded` swaps `source` for
    // whichever file the strip picked, so reading the description out of `source` would make it
    // change to the design file's first line the moment you clicked `*_ui.zm`.
    summary: string
    focused: string
    // The control the pointer is on, or "" for none.
    //
    // **Held beside the focus and for the same reason.** Hover is a fact about the pointer rather
    // than about any widget, so a `hovered` flag inside the tree would be a second copy of it,
    // free to disagree -- and a control left lit after the pointer had gone is exactly how that
    // disagreement shows. One name, painted by `widget.paint_hovered`.
    hovered: string
    // The control holding the pointer: what the last press was delivered to, until the release.
    //
    // **Without it a scroll bar can be grabbed and not dragged.** A move used to be routed to the
    // focus, which is the pressed control only when that control is a tab stop -- and a scroll bar
    // and a split pane's divider are precisely the two a pointer works and Tab cannot reach. See
    // `controls.target`, which carries the measurement.
    pressed: string
}

// **Takes the style, because the Code tab's colours are computed against it.** A colourer that
// picked fixed hexes would be unreadable the moment a theme changed the surface under them, which
// is exactly what the first version of this did: ziman.dev's light-theme values on a light
// control face, at 2.2:1. See `highlight.legible`.
// Which demo to open on, from `ZIMAN_GALLERY_DEMO`, or the first.
//
// **Because a demo you cannot open is a demo you cannot look at.** Every other way into this
// window is a click, which is fine for a person and useless for a screenshot or a bug report that
// says "the slider under Look and feel" -- and the gallery already reads `ZIMAN_GALLERY_ROOT`,
// `_FONT`, `_MONO` and `_SCALE`, so this is the convention and not a new one. The name is the
// demo's own stem, the same string its files are named after.
//
// An unknown name opens the first demo rather than failing: a typo in an environment variable
// should not stop a window opening.
fn opening_at(demos: [all.Demo]) -> int {
    switch os.get_env("ZIMAN_GALLERY_DEMO") {
        Some(want) {
            var i = 0
            while i < len(demos) {
                if all.stem_of(demos[i]) == want {
                    return i
                }
                i = i + 1
            }
        }
        None { unit }
    }
    return 0
}

pub fn opening_state(f: controls.Frame) -> State {
    val style = f.style
    val demos = all.all()
    val begin = State {
        split: with controls.split_pane_of(
            "layout",
            "Catalogue",
            widget.Direction.Row,
            catalogue_width
        ) {
            first_min: catalogue_min,
            second_min: demo_min
        },
        window_width: 1100.0,
        // **The row of the demo that is about to open, found rather than assumed.** This said
        // `selected: 1` -- the row after the one branch, which was the first demo until the
        // catalogue was sorted and row 1 became a different demo from the one `opening_at` picks.
        // The window then opened with one control highlighted and another one drawn, and nothing
        // failed on it. `ZIMAN_GALLERY_DEMO` had the same hole: it moved the demo and not the row.
        tree: with controls.tree_of("catalogue", "Controls", tree_rows(demos)) {
            selected: row_for(demos, opening_at(demos))
        },
        row_demo: row_demos(demos),
        // **Toggle groups, not tab strips.** A tab chooses what is shown *beneath* it and is
        // drawn as an index card; these two choose between two renderings of the same thing, which
        // is a value and reads as a segmented control. `controls.Tabs` is deliberately drawn as
        // cards -- see `tabs_widget` -- so the look had to come from somewhere else.
        tabs: controls.exclusive_group_of("tabs", "Views", views(), demo_tab),
        files: controls.exclusive_group_of("files", "Files", no_segments(), 0),
        source: code_entry("", style),
        demos: demos,
        at: opening_at(demos),
        status: "",
        summary: "",
        focused: "catalogue",
        hovered: "",
        pressed: ""
    }
    return showing(begin, opening_at(demos), f)
}

// The description, cut to the room the header leaves it.
//
// **Measured here and not in the design file**, which computes nothing: the width is the demo
// pane's, less the tabs beside it and the gaps around them, and that is arithmetic over the
// window's own extent. `widget.elided` does the cutting with the metrics the layout will use.
//
// A long sentence folded instead of cut would be better reading, and a wrapping label in a row
// measures one line -- see `widget.wrapping_label`, whose own comment says why. So it is cut.
// The gaps the header spends beside its two children: one between them and one at each end.
val header_gaps = 24.0

fn header_summary(s: State, f: controls.Frame) -> string {
    val pane = s.window_width - frame_width - catalogue_width
    val room = pane - tabs_room(s, f) - header_gaps
    return widget.elided(s.summary, room, f.style.text.caption.face, f.style.text.caption.size, f.metrics)
}

// How wide the view's two tabs come out, which only a measurement can say: a toggle group is as
// wide as the words in it.
fn tabs_room(s: State, f: controls.Frame) -> float {
    return widget.measure(controls.toggle_group_widget(s.tabs, f), f.metrics).width
}

// Which catalogue row shows a given demo.
//
// **Read out of `row_demo` rather than worked out**, which is the rule that array exists for: it
// is the one place that knows a row's index is not its demo's, and anything that computes the
// pairing a second time is the thing that disagrees with it.
fn row_for(demos: [all.Demo], at: int) -> int {
    val rows = row_demos(demos)
    var i = 0
    while i < len(rows) {
        if rows[i] == at {
            return i
        }
        i = i + 1
    }
    return 0
}

// Which segment of a group is lit. **An index, because the callers ask "which of the two",** and
// an exclusive group always has exactly one -- see `exclusive_group_of`, which will not let it
// empty itself.
//
// Named apart from `showing(State, int, Frame)` below, which is a different question with the same
// English word: Ziman would overload the two happily and a reader would not.
fn lit_segment(g: controls.ToggleGroup) -> int {
    switch controls.chosen_in(g) {
        Some(at) { return at }
        None { return 0 }
    }
}

fn views() -> [controls.ToggleButton] {
    return segments_of("tabs", ["Demo", "Code"])
}

// A segment per name, each named after the group and its position so the group can address it.
fn segments_of(group: string, names: [string]) -> [controls.ToggleButton] {
    val out = mutable_array_new<controls.ToggleButton>()
    var i = 0
    for name in names {
        push(out, controls.toggle_button_of(concat(group, "-", str(i)), name, widget.Toggle.Off))
        i = i + 1
    }
    return snapshot(out)
}

fn no_segments() -> [controls.ToggleButton] {
    val none = mutable_array_new<controls.ToggleButton>()
    return snapshot(none)
}

// A branch per group, with its demos under it.
//
// **Built in `all.groups()`'s order, not in the demos' order**, so a demo can be added anywhere
// in the catalogue without being filed anywhere it does not belong. A group with nothing in it
// draws no branch, which is what lets `groups()` name a branch before its first demo exists.
fn tree_rows(demos: [all.Demo]) -> [controls.TreeRow] {
    val rows = mutable_array_new<controls.TreeRow>()
    for group in all.groups() {
        if any_in(demos, group) {
            push(rows, controls.tree_branch(group, 0, true))
            for at in in_group(demos, group) {
                push(rows, controls.tree_row(all.title_of(demos[at]), 1))
            }
        }
    }
    return snapshot(rows)
}

// The demos in one group, by index into `demos`, **in the order the catalogue shows them**.
//
// Alphabetical by title, which is the order someone looking for a control reads in: `all.zm`'s
// declaration order is the order demos were written, and nobody hunting for "Tabs" knows that.
//
// **One function, because `tree_rows` and `row_demos` must agree.** They are a tree and the
// parallel array that says which demo each of its rows is, and `row_demos`'s own comment is about
// exactly this: two walks that could disagree is how a catalogue selects the wrong thing. Sorting
// in one and not the other would have done it on the first click.
fn in_group(demos: [all.Demo], group: string) -> [int] {
    val found = mutable_array_new<int>()
    var i = 0
    while i < len(demos) {
        if all.group_of(demos[i]) == group {
            push(found, i)
        }
        i = i + 1
    }
    return sort_by(snapshot(found), fn(at: int) -> string { return all.title_of(demos[at]) })
}

// Which demo each tree row shows, by row index, or -1 for a branch.
//
// **A parallel array rather than arithmetic**, which the single-group version could get away
// with: with branches between them a row's index is no longer its demo's index plus one, and
// working it out at the point of use is how a catalogue ends up selecting the wrong thing after
// someone adds a group.
fn row_demos(demos: [all.Demo]) -> [int] {
    val out = mutable_array_new<int>()
    for group in all.groups() {
        if any_in(demos, group) {
            push(out, 0 - 1)
            for at in in_group(demos, group) {
                push(out, at)
            }
        }
    }
    return snapshot(out)
}

fn any_in(demos: [all.Demo], group: string) -> bool {
    for d in demos {
        if all.group_of(d) == group {
            return true
        }
    }
    return false
}

// A code pane: a text area nobody can type into, as many rows as the pane will show.
//
// **`readonly` and not `disabled`**: the caret still moves and the text can still be selected, so
// the code can be read with the keyboard and by a screen reader, which is the whole reason it is
// a field.
fn code_entry(text: string, style: controls.Style) -> controls.Entry {
    return with controls.text_area_of("source", "Source", text, 24) {
        readonly: true,
        // **Tokenised once, when the file is loaded**, and not in `view`: `view` runs on every
        // frame that changes anything, and colouring a 200-line file sixty times a second to get
        // the same answer is the shape `dirty` exists to avoid. The spans are a property of the
        // text, so they are computed where the text is.
        inks: highlight.inks_of(text, style)
    }
}

// Moves to a demo: its files name the sub-tabs, and the first of them is loaded.
fn showing(s: State, at: int, f: controls.Frame) -> State {
    if at < 0 || at >= len(s.demos) {
        return s
    }
    val d = s.demos[at]
    val names = all.files_of(d)
    return loaded(
        with s {
            at: at,
            files: controls.exclusive_group_of("files", "Files", segments_of("files", names), 0),
            status: all.title_of(d),
            summary: source.summary_of(source.read_demo(all.stem_of(d), names[0]))
        },
        0,
        f
    )
}

// The Demo/Code choice, moved the way a press moves it. **Public for the same reason
// `chose_file` is**: a test and a probe need to reach the other tab without synthesising a click.
pub fn chose_tab(s: State, tab: int, f: controls.Frame) -> State {
    return with s { tabs: controls.choosing(s.tabs, tab) }
}

// Loads one of the chosen demo's files into the code pane.
//
// **Public, so a test can move the file strip the way a press does.** The description in the
// header must not follow it -- see `summary` -- and a test that could not move it could not say so.
pub fn chose_file(s: State, file: int, f: controls.Frame) -> State {
    return loaded(s, file, f)
}

fn loaded(s: State, file: int, f: controls.Frame) -> State {
    val style = f.style
    val d = s.demos[s.at]
    val names = all.files_of(d)
    if file < 0 || file >= len(names) {
        return s
    }
    return with s {
        files: controls.exclusive_group_of("files", "Files", segments_of("files", names), file),
        source: code_entry(source.read_demo(all.stem_of(d), names[file]), style)
    }
}

// A style whose body text is the look's `code` role, in whatever monospaced face this window
// managed to load. See `code_face`.
fn as_code(style: controls.Style) -> controls.Style {
    val mono = with style.text.code { face: code_face }
    return with style { text: with style.text { body: mono } }
}

pub fn view(s: State, f: controls.Frame) -> widget.Widget {
    val style = f.style
    // **Which tab is showing is a conditional, and a conditional is not design.** The design file
    // takes a slot; this is what fills it.
    val body = if lit_segment(s.tabs) == code_tab {
        // **The code pane asks for the `code` role by name**, which is what a type scale is for:
        // an `Entry` reads `style.text.body`, so an application that wants a monospaced one hands
        // it a style whose body *is* the code role. Before F293 this said
        // `with style { text_font: code_face }` -- an index poked into the one font field there
        // was, with nothing to say what it meant.
        // **The same frame in a different look**, which is what a frame being a value buys: the
        // pointer, the press and the focus are unchanged, and only the style the pane reads is
        // the code one. Before the frame this was a fourth argument that could disagree.
        gallery_ui.code_pane(s.files, s.source, with f { style: as_code(style) })
    } else {
        gallery_ui.demo_box(all.view_of(s.demos[s.at], f))
    }
    return gallery_ui.screen(
        gallery_ui.Screen {
            split: s.split,
            split_extent: s.window_width - frame_width,
            tree: s.tree,
            tabs: s.tabs,
            body: body,
            summary: header_summary(s, f),
            status: s.status
        },
        f
    )
}

// The layer the demo on show wants over the window, if any -- a combo box's list, a menu's
// popup, a modal dialog.
//
// **Asked after the first layout and only when the demo is showing.** A popup hangs under the
// control that opened it, and where that is is a fact about the laid tree; and a popup over the
// Code tab would hang under a control that is not drawn, which is a box of zero at the corner of
// the window.
pub fn layer_of(s: State, laid: widget.Laid, f: controls.Frame) -> Option<widget.Layer> {
    if lit_segment(s.tabs) != demo_tab {
        return Option<widget.Layer>.None
    }
    val d = s.demos[s.at]
    return all.layer_of(d, boxes.bounds_of(laid, all.anchor_of(d)), laid, f)
}

pub fn step(s: State, input: controls.Input, laid: widget.Laid, f: controls.Frame) -> State {
    val style = f.style
    val m = f.metrics
    // Tab moves the focus and reaches no control, which is why it is taken before `target`.
    if is_tab(input) {
        val forward = !shift_held(input)
        return with s {
            focused: if forward { focus.next(laid, s.focused) } else { focus.previous(laid, s.focused) }
        }
    }
    val focused_now = switch input {
        Press(at) { focus.clicked(laid, at, s.focused) }
        // **A secondary press moves the focus too**, which is what every desktop does: the
        // commands a context menu offers are the focused thing's, so the focus has to arrive
        // before the menu does or the two disagree about what is being acted on.
        SecondaryPress(at) { focus.clicked(laid, at, s.focused) }
        Wheel(_) { s.focused }
        Release(_) { s.focused }
        Move(_) { s.focused }
        KeyDown(_) { s.focused }
        KeyUp(_) { s.focused }
        Text(_) { s.focused }
        Paste(_) { s.focused }
    }
    val name = controls.target(laid, input, focused_now, s.pressed)
    val here = with s {
        focused: focused_now,
        hovered: hovered_now(s, laid, input),
        pressed: controls.pressed_after(s.pressed, input, name)
    }
    if name == "layout/divider" {
        return with here { split: controls.split_pane_input(
            here.split,
            input,
            boxes.bounds_of(laid, "layout"),
            controls.frame_of(style, m)
        ).split }
    }
    if name == "catalogue" {
        val taken = controls.tree_input(
            here.tree,
            input,
            boxes.bounds_of(laid, "catalogue"),
            controls.frame_of(style, m)
        )
        val moved = with here { tree: taken.tree }
        // **Selecting shows it; there is nothing to activate.** A tree whose rows had to be
        // opened as well as reached would make the catalogue two gestures deep for no gain --
        // the demo is already on screen beside it.
        // **A branch shows nothing rather than the demo above it.** Opening and closing a
        // group moves the selection onto the branch, and a catalogue that answered that with
        // "whatever was last in the group" would change the pane for a gesture that was about
        // the tree.
        if taken.moved {
            return showing_row(moved, moved.tree.selected, f)
        }
        return moved
    }
    if name == "tabs" {
        return with here { tabs: controls.toggle_group_input(here.tabs, input, laid, f).group }
    }
    if name == "files" {
        val taken = controls.toggle_group_input(here.files, input, laid, f)
        if taken.changed >= 0 {
            return loaded(with here { files: taken.group }, taken.changed, f)
        }
        return with here { files: taken.group }
    }
    if name == "source" {
        // **Driven with the frame it is drawn with**, which is the code style and not this
        // window's. `view` hands the code pane `as_code(style)` -- a style whose body *is* the
        // monospaced `code` role, a different size in a different face -- and this passed the
        // plain one, so every measurement the entry made about itself was a quarter out: it
        // scrolled a notch that was too short, and it worked out the file's height from the wrong
        // line, which put the end of the text several hundred points past where it would agree to
        // go. A control measured by one style and painted by another is the divider you can see in
        // one place and take hold of in another.
        return with here { source: controls.entry_input(
            here.source,
            input,
            boxes.bounds_of(laid, "source"),
            controls.frame_of(as_code(style), m)
        ).entry }
    }
    // Anything else belongs to the demo on show, which routes it by name itself.
    return with here {
        demos: demo_set(here.demos, here.at, all.input_to(here.demos[here.at], name, input, laid, f))
    }
}

// Which demo a tree row shows, or -1 for a branch. **Public so the shell's own test can ask**:
// the mapping is the thing that breaks when a group is added, and a test that could not see it
// would have to infer it from what the pane happened to draw.
pub fn demo_at(s: State, row: int) -> int {
    if row < 0 || row >= len(s.row_demo) {
        return 0 - 1
    }
    return s.row_demo[row]
}

// Moves the pane to whatever the tree row at  shows, which is nothing for a branch.
pub fn showing_row(s: State, row: int, f: controls.Frame) -> State {
    return showing(s, demo_at(s, row), f)
}

// The next frame of the demo on show, or nothing when it does not move.
//
// **The window repaints what changed**, so this answers an `Option` and the loop marks the frame
// dirty only when there is one: a gallery that ticked unconditionally would repaint twenty still
// pictures sixty times a second to animate the one bar that moves.
pub fn ticked(s: State, f: controls.Frame) -> Option<State> {
    return switch all.tick_of(s.demos[s.at], f) {
        Some(one) { Option<State>.Some(with s { demos: demo_set(s.demos, s.at, one) }) }
        None { Option<State>.None }
    }
}

fn demo_set(demos: [all.Demo], at: int, one: all.Demo) -> [all.Demo] {
    val out = mutable_array_new<all.Demo>()
    var i = 0
    while i < len(demos) {
        push(out, if i == at { one } else { demos[i] })
        i = i + 1
    }
    return snapshot(out)
}

// What the pointer is on after this input.
//
// **Only a move changes it**, which is the whole of the rule: a press, a key or a wheel leaves the
// pointer exactly where it was, and recomputing it would be asking the same question for the same
// answer on every keystroke.
fn hovered_now(s: State, laid: widget.Laid, input: controls.Input) -> string {
    if Move(at) = input {
        return switch focus.control_at(laid, at) {
            Some(one) { one.name }
            None { "" }
        }
    }
    return s.hovered
}

fn is_tab(input: controls.Input) -> bool {
    if KeyDown(k) = input {
        return controls.Key.is_Tab(k.key)
    }
    return false
}

fn shift_held(input: controls.Input) -> bool {
    if KeyDown(k) = input {
        return k.shift
    }
    return false
}
