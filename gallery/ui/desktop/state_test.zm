// The gallery's own shell: the catalogue, the two tabs, and the file strip under them.
//
// **These are the cases the demos cannot cover.** Every demo tests the control it shows; nothing
// tested the window that shows them -- the mapping from a tree row to a demo, what a branch row
// does, which file the Code tab loads. The mapping in particular is the thing that breaks the day
// someone adds a group, which is exactly what `row_demos` exists to stop and what nothing was
// checking.
use a11y
use controls
use demos/all
use demos/look_and_feel
use focus
use geom
use highlight
use paint
use state
use test
use theme
use widget

// Ten points a character and a line twice the size, so a box's arithmetic is readable in a
// failure. The real metrics come from a font the gate has no reason to load.
fn metrics() -> widget.Metrics {
    return widget.metrics_of(
        fn(text: string, size: float) -> float { return (len(text) as float) * 10.0 },
        fn(size: float) -> float { return size * 2.0 }
    )
}

fn style() -> controls.Style {
    return theme.plain()
}

// The resting frame these tests draw in: nothing hovered, pressed or focused.
fn frame() -> controls.Frame {
    return controls.frame_of(style(), metrics())
}

val window = geom.rect_of(0.0, 0.0, 1100.0, 720.0)

fn opened() -> state.State {
    return state.opening_state(frame())
}

fn laid_of(s: state.State) -> widget.Laid {
    return widget.layout(state.view(s, frame()), window, metrics())
}

fn acted(s: state.State, input: controls.Input) -> state.State {
    return state.step(s, input, laid_of(s), frame())
}

// Presses the middle of the control called `name`.
fn pressed(s: state.State, name: string) -> state.State {
    val at = boxes_of(s, name)
    return acted(s, controls.Input.Press(geom.point_of(at.x + at.width / 2.0, at.y + at.height / 2.0)))
}

fn boxes_of(s: state.State, name: string) -> geom.Rect {
    return switch widget.node_named(laid_of(s), name) {
        Some(node) { node.bounds }
        None { geom.rect_of(0.0, 0.0, 0.0, 0.0) }
    }
}

// ---------------------------------------------------------------- the catalogue

// **A tree row is not a demo index.** With a branch between the groups it is not even that index
// plus a constant, which is why the mapping is an array and not arithmetic -- and why this test
// exists: the day someone adds a group, this is what says the catalogue still selects what it
// points at.
#[test]
fn every_demo_is_reachable_from_the_tree_by_its_own_name() {
    val s = opened()
    val rows = s.tree.rows
    var row = 0
    var seen = 0
    while row < len(rows) {
        val at = state.demo_at(s, row)
        if at >= 0 {
            // The row's label is the demo's title: the catalogue points where it says it does.
            test.assert_eq(rows[row].label, all.title_of(s.demos[at]))
            seen = seen + 1
        } else {
            // A branch row, whose label is a group name and nothing else.
            test.assert(contains(all.groups(), rows[row].label))
        }
        row = row + 1
    }
    test.assert_eq(seen, len(s.demos))
}

// **A branch shows nothing rather than the demo above it.** Opening and closing a group moves the
// selection onto the branch, and a catalogue that answered that with "whatever was last in the
// group" would change the pane for a gesture that was about the tree.
#[test]
fn selecting_a_branch_leaves_the_demo_alone() {
    val s = opened()
    test.assert_eq(state.demo_at(s, 0), 0 - 1)
    val moved = with s { tree: with s.tree { selected: 0 } }
    val after = state.showing_row(moved, 0, frame())
    test.assert_eq(after.at, s.at)
}

// Selecting a demo row moves the pane to it and renames the file strip after its two files.
#[test]
fn selecting_a_demo_loads_its_own_two_files() {
    val s = opened()
    val last = len(s.demos) - 1
    val row = row_of(s, last)
    val after = state.showing_row(s, row, frame())
    test.assert_eq(after.at, last)
    test.assert_eq(after.files.items, all.files_of(s.demos[last]))
    test.assert_eq(after.status, all.title_of(s.demos[last]))
}

fn row_of(s: state.State, demo: int) -> int {
    var row = 0
    while row < len(s.tree.rows) {
        if state.demo_at(s, row) == demo {
            return row
        }
        row = row + 1
    }
    return 0 - 1
}

// ---------------------------------------------------------------- the two tabs

// The Code tab shows the demo's own first file, and the file strip switches to the second.
#[test]
fn the_code_tab_shows_the_demo_being_looked_at() {
    val s = opened()
    test.assert_len(2, s.files.items)
    test.assert_eq(s.files.items[0], concat(all.stem_of(s.demos[0]), ".zm"))
    test.assert_eq(s.files.items[1], concat(all.stem_of(s.demos[0]), "_ui.zm"))
    // The source pane holds something: either the file or the message saying where it looked.
    test.assert(len(s.source.editor.text) > 0)
}

// **Tab reaches the shell's own controls and the demo's**, which is the only check that a new
// demo has been wired into the focus order rather than merely drawn.
#[test]
fn the_shells_controls_are_all_reachable() {
    val names = mutable_array_new<string>()
    for one in focus.controls(laid_of(opened())) {
        push(names, one.name)
    }
    val reachable = snapshot(names)
    for wanted in ["catalogue", "tabs", "layout/divider"] {
        test.assert(contains(reachable, wanted))
    }
}

// ---------------------------------------------------------------- every demo

// **No two demos name a control the same thing.** Every name in this window is flat and routing
// is by name, so a copy-pasted demo that kept its neighbour's name would send its input to the
// wrong demo -- silently, and only when both are on screen, which they never are. Nineteen demos
// is where that stops being hypothetical.
#[test]
fn no_two_demos_use_the_same_control_name() {
    val seen = mutable_set_new<string>()
    var i = 0
    while i < len(all.all()) {
        val d = all.all()[i]
        val laid = widget.layout(all.view_of(d, frame()), window, metrics())
        for one in focus.controls(laid) {
            test.assert_false(contains(seen, one.name))
            add(seen, one.name)
        }
        i = i + 1
    }
}

// **Every demo lays out and describes itself**, which is the cheapest possible smoke test and
// catches the thing a type check cannot: a demo whose view raises, or one that declares no
// control at all and is therefore a picture of a control rather than one.
#[test]
fn every_demo_lays_out_and_declares_at_least_one_control() {
    for d in all.all() {
        val laid = widget.layout(all.view_of(d, frame()), window, metrics())
        val tree = a11y.tree_of(laid, "gallery", "")
        test.assert(len(tree.nodes) > 1)
        // **Two demos have nothing Tab can reach, and both exceptions are deliberate -- for
        // different reasons.** A scroll bar is not a tab stop because the content it scrolls is
        // what a keyboard user moves through, and a stop on the bar would be one they tab to and
        // cannot use: it is reachable by a pointer and by a reader, but not by Tab. A progress bar
        // is not a tab stop because there is nothing to operate at all -- it is reachable by a
        // reader alone, which is the whole reason it is still in the tree.
        //
        // The list is spelled out rather than derived, so that a third demo with no focusable
        // control has to be argued for here instead of joining a pattern.
        if all.stem_of(d) != "scroll_bar" && all.stem_of(d) != "progress" {
            test.assert(len(focus.controls(laid)) > 0)
        }
    }
}

// **Every kind of widget is shown somewhere.** `controls` is covered by a gate that asks the
// library what it offers; `widget`'s own vocabulary was not covered by anything, so a gallery
// could show thirteen controls and never a picture, a drawing or a layer. This walks what the
// demos actually lay out and asks which variants never appear.
#[test]
fn every_kind_of_widget_appears_in_some_demo() {
    val seen = mutable_set_new<string>()
    for d in all.all() {
        val laid = widget.layout(all.view_of(d, frame()), window, metrics())
        gather_kinds(laid, seen)
        // A demo's layer counts too: a popup and a modal dialog are the only `Layered` in the
        // window, and only while they are open.
        switch all.layer_of(d, geom.rect_of(0.0, 0.0, 100.0, 20.0), laid, frame()) {
            Some(over) {
                gather_kinds(
                    widget.layout(
                        widget.layered_of([widget.base_layer(widget.Widget.Nothing), over]),
                        window,
                        metrics()
                    ),
                    seen
                )
            }
            None {}
        }
    }
    val missing = mutable_array_new<string>()
    for kind in ["Text", "Drawing", "Picture", "Group", "Sized", "Flex", "Expand", "Control", "Scroll", "Layered"] {
        if !contains(seen, kind) {
            push(missing, kind)
        }
    }
    // Named rather than counted, so a failure says which kind of widget nothing shows.
    test.assert_eq(join(separator: ", ", pieces: snapshot(missing)), "")
}

fn gather_kinds(l: widget.Laid, seen: MutableSet<string>) {
    add(seen, kind_of(l.widget))
    for child in l.children {
        gather_kinds(child, seen)
    }
}

fn kind_of(w: widget.Widget) -> string {
    return switch w {
        Nothing { "Nothing" }
        Text(_) { "Text" }
        Drawing(_) { "Drawing" }
        Picture(_) { "Picture" }
        Group(_) { "Group" }
        Sized(_) { "Sized" }
        Flex(_) { "Flex" }
        Expand(_) { "Expand" }
        Control(_) { "Control" }
        Scroll(_) { "Scroll" }
        Layered(_) { "Layered" }
    }
}

// ---------------------------------------------------------------- the theme

// **Every pair of colours a theme asks text to be read in clears WCAG AA.** A look and feel is
// the one place where "it looked fine on my screen" is a whole methodology, and the gallery
// already owns the arithmetic for its Code pane -- so the theme it wears is held to the same
// number its syntax colouring is. 4.5:1 is body text; nothing here is large enough for the 3:1
// allowance.
fn reads_on_every_stop(p: controls.Parts) -> bool {
    for stop in stops_of(p.face) {
        if paint.contrast_ratio(p.ink, stop) < 4.5 {
            return false
        }
    }
    return true
}

fn stops_of(p: paint.Paint) -> [paint.Color] {
    return switch p {
        Solid(c) { [c] }
        LinearGradient(g) { stop_colours(g.stops) }
        RadialGradient(g) { stop_colours(g.stops) }
        Pattern(_) { [] }
    }
}

fn stop_colours(stops: [paint.Stop]) -> [paint.Color] {
    val out = mutable_array_new<paint.Color>()
    for one in stops {
        push(out, one.color)
    }
    return snapshot(out)
}

#[test]
fn the_modern_theme_is_legible_everywhere_it_puts_text() {
    val look = theme.modern()
    // Body text on each surface it is drawn on.
    test.assert(paint.contrast_ratio(look.ink, look.face) >= 4.5)
    test.assert(paint.contrast_ratio(look.ink, look.panel) >= 4.5)
    // **Every stop of every live row**, since F295 made a face a span of ramp steps: a gradient
    // face passes only if its text reads at both ends, and a flat one has the single stop it
    // always had. `theme_test` holds every look in the register to the same rule.
    test.assert(reads_on_every_stop(look.states.selected))
    test.assert(reads_on_every_stop(look.states.pressed))
    test.assert(reads_on_every_stop(look.states.hovered))
    // And whatever a theme says reads on its accent.
    test.assert(paint.contrast_ratio(look.on_accent, look.accent) >= 4.5)
}

// **A selection is not a press and a border is not a face.** Each of these was one colour doing
// two jobs, and in a flat light theme that is how a selected tab becomes invisible: when a press
// is only slightly darker than a face -- which is what a light theme wants -- anything sharing
// the press colour to mean "chosen" disappears.
#[test]
fn the_modern_theme_tells_its_states_apart() {
    val look = theme.modern()
    test.assert(paint.contrast_ratio(paint.flat_of(look.states.selected.face), look.face) >= 1.08)
    test.assert(paint.contrast_ratio(look.accent, look.face) >= 3.0)
    switch look.states.rest.border {
        Some(edge) { test.assert(paint.contrast_ratio(edge.colour, look.face) >= 1.3) }
        None { test.fail("the modern theme has no border, which is what tells a face from a window") }
    }
}

// The default look is still the plainest thing that is legible, which is what makes it the one an
// application replaces rather than undoes.
#[test]
fn the_default_theme_stays_plain() {
    val plain = theme.plain()
    test.assert(Option.is_None(plain.states.rest.border))
    test.assert(widget.Radius.is_Square(plain.shape.medium))
    test.assert(paint.contrast_ratio(plain.ink, plain.face) >= 4.5)
}

// ------------------------------------------- the theme designer (F297, D12)

fn designer() -> look_and_feel.Demo {
    return with look_and_feel.demo() {
        // The last row of the picker is the look being designed; the ones before it are the
        // register's own.
        picker: with look_and_feel.demo().picker {
            items: with look_and_feel.demo().picker.items { selected: len(theme.all()) }
        }
    }
}

fn designed(d: look_and_feel.Demo) -> controls.Style {
    return look_and_feel.look_of_demo(d)
}

// **The sliders are the look.** This is what replaced a theme file format (D12): the argument was
// that a look had become small enough to put sliders on, and this is that claim as a test -- move
// the accent's hue and the derived accent moves with it.
#[test]
fn moving_a_seed_moves_the_look() {
    val before = designed(designer())
    val after = designed(with designer() {
        accent_hue: with designer().accent_hue { value: 30.0 }
    })
    val was = paint.to_oklch(before.accent)
    val now = paint.to_oklch(after.accent)
    test.assert(now.hue - was.hue < -100.0 || was.hue - now.hue < -100.0)
}

// **A designed look is held to the same gate as a shipped one.** `derive` is what the register's
// looks go through, so a look designed here cannot be less legible than one in `theme.all()` --
// which is the thing a file format could never promise, because a file of hand-written literals
// has nothing to check.
#[test]
fn a_designed_look_is_legible_too() {
    for hue in [0.0, 90.0, 180.0, 270.0] {
        val look = designed(with designer() {
            accent_hue: with designer().accent_hue { value: hue },
            neutral_hue: with designer().neutral_hue { value: hue }
        })
        test.assert(paint.contrast_ratio(look.states.rest.ink, paint.flat_of(look.states.rest.face)) >= 4.5)
        test.assert(paint.contrast_ratio(look.on_accent, look.accent) >= 4.5)
    }
}

// The source is what leaves this window, so it says what the sliders say.
#[test]
fn the_source_carries_the_numbers_the_sliders_are_on() {
    val lines = look_and_feel.source_lines(with designer() {
        accent_hue: with designer().accent_hue { value: 30.0 }
    })
    test.assert_eq(lines[0], "theme.Seeds {")
    test.assert(contains(lines[2], "30.0"))
    test.assert(contains(lines[3], "Toward."))
    test.assert_eq(lines[5], "}")
}

// **The register keeps its rows**, which the editor must not quietly replace: a look added to
// `lib/ui/theme` still appears here, and the designed one is one more row after them.
#[test]
fn the_picker_is_the_register_plus_one() {
    test.assert_eq(len(look_and_feel.demo().picker.items.items), len(theme.all()) + 1)
}

// ------------------------- the measures-as-nothing guard (eight victims, F297)

// **No demo draws anything into no space.** This is the trap that has cost this library eight
// victims -- the table's header band, the link, the slider's thumb, the star, the popup's rows,
// the slider's track, the check mark and the look-and-feel band -- and every one presented
// identically: nothing drawn, no error, every test green.
//
// **It is a test and not a lint because it cannot be seen before layout.** A zero measurement is
// ordinary: half the controls in `lib/ui` are `fixed_of(width, 0.0, ..)` inside a stack that
// stretches them, which is the right spelling. What is wrong is a node that still has no extent
// when the layout is finished and has ink to put down -- which depends on what its parent did, and
// no reading of the source can tell you that.
//
// Twenty-one demos is also what makes this worth having: the gallery draws every control the
// library has, so a control that measures as nothing anywhere fails here.
#[test]
fn no_demo_paints_into_no_space() {
    val f = controls.frame_of(theme.plain(), metrics())
    for d in all.all() {
        val laid = widget.layout(all.view_of(d, f), window, metrics())
        val lost = widget.measured_as_nothing(laid)
        if len(lost) > 0 {
            test.fail(concat(all.stem_of(d), " paints ", str(len(lost)), " node(s) into no space"))
        }
    }
}

// The popups too, which is where two of the eight were: a menu's rows and a combo box's list are
// laid out in a layer of their own and so are not reached by the walk above.
#[test]
fn no_popup_paints_into_no_space() {
    val f = controls.frame_of(theme.plain(), metrics())
    val at = geom.rect_of(0.0, 0.0, 200.0, 120.0)
    for d in all.all() {
        // The demo's own tree, because a tooltip's words come from the control the pointer is on.
        val base = widget.layout(all.view_of(d, f), window, metrics())
        switch all.layer_of(d, at, base, f) {
            Some(over) {
                val laid = widget.layout(
                    widget.layered_of([widget.base_layer(widget.Widget.Nothing), over]),
                    window,
                    metrics()
                )
                val lost = widget.measured_as_nothing(laid)
                if len(lost) > 0 {
                    test.fail(concat(all.stem_of(d), "'s popup paints ", str(len(lost)), " node(s) into no space"))
                }
            }
            None { unit }
        }
    }
}
