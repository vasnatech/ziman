// The ziman UI gallery: every control the widget set has, with the code that drew it.
//
// **What it is for, beyond showing the controls.** It is the first program that uses *all* of
// `lib/ui`, which makes it the thing that notices an API break, and the place a new control gets
// looked at by someone rather than only asserted about. Both of today's controls were shipped with
// a defect no test could see and only running them showed; a gallery is where that happens on
// purpose instead of by luck.
//
// Run it:
//
//     make gui                                  # ziman-gui is a separate binary and goes stale
//     ./ziman-gui gallery/ui/desktop/gallery.zm # from the repository root, so it can read its own source
use a11y
use atspi
use clock
use controls
use desktop
use font
use fs
use geom
use os
use paint
use pictures.images
use raster
use scene
use state
use theme
use widget
use window

val start_width = 1100
val start_height = 720

fn main() {
    switch run() {
        Ok(_) { unit }
        Err(why) { print(concat("gallery: ", why, "\n")) }
    }
}

// ---- the font
//
// **A window needs a face and `lib/graphics` has no notion of a system font**: there is no library
// to resolve a name against, so a caller hands it bytes. `ZIMAN_GALLERY_FONT` is the explicit
// choice; the rest is what the common distributions ship.
fn text_candidates() -> [string] {
    val out = mutable_array_new<string>()
    if Some(explicit) = os.get_env("ZIMAN_GALLERY_FONT") {
        push(out, explicit)
    }
    push(out, "/usr/share/fonts/liberation-sans-fonts/LiberationSans-Regular.ttf")
    push(out, "/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf")
    push(out, "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
    push(out, "/usr/share/fonts/TTF/DejaVuSans.ttf")
    push(out, "/usr/share/fonts/google-noto-vf/NotoSans[wdth,wght].ttf")
    push(out, "/Library/Fonts/Arial.ttf")
    return snapshot(out)
}

// The faces a window draws in, in the order `raster.Options.fonts` holds them: the text face,
// then the one the Code tab reads in.
//
// **Always two, even when there is only one face on the machine.** `Style.text_font` names a face
// by index, and `widget` lays a tree out against face 0 whatever index it is given -- but the
// *renderer* refuses a run naming a face the options do not hold. So a code pane set to face 1
// would lay out correctly and then fail to paint, which is the worst of the three outcomes.
// Repeating the text face keeps the index real and costs the code pane nothing but its
// proportions.
fn load_fonts() -> Result<[font.FontRef], string> {
    val text = try load_one(text_candidates(), "text")
    val mono = switch first_of(mono_candidates()) {
        Some(f) { f }
        None { text }
    }
    return ok([text, mono])
}

// A monospaced face for code. **Not an error when there is none**: a proportional code pane is
// harder to read and still a code pane, where a window that refuses to open is not.
fn mono_candidates() -> [string] {
    val out = mutable_array_new<string>()
    if Some(explicit) = os.get_env("ZIMAN_GALLERY_MONO") {
        push(out, explicit)
    }
    push(out, "/usr/share/fonts/liberation-mono-fonts/LiberationMono-Regular.ttf")
    push(out, "/usr/share/fonts/dejavu-sans-mono-fonts/DejaVuSansMono.ttf")
    push(out, "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf")
    push(out, "/usr/share/fonts/adwaita-mono-fonts/AdwaitaMono-Regular.ttf")
    push(out, "/usr/share/fonts/gnu-free-mono-fonts/FreeMono.ttf")
    push(out, "/usr/share/fonts/TTF/DejaVuSansMono.ttf")
    return snapshot(out)
}

fn first_of(paths: [string]) -> Option<font.FontRef> {
    for path in paths {
        if fs.exists(path) {
            switch fs.read_bytes(path) {
                Ok(data) {
                    switch font.load(data) {
                        Ok(f) { return Option<font.FontRef>.Some(f) }
                        Err(_) { unit }
                    }
                }
                Err(_) { unit }
            }
        }
    }
    return Option<font.FontRef>.None
}

// The resting frame with this frame's three names filled in.
//
// **One place, so the three cannot be filled in differently in two of them.** A paint that read
// `st.hovered` and an input routed with an empty one would disagree about what the pointer is on,
// and the symptom is a control that lights up and does not respond.
fn frame_at(resting: controls.Frame, st: state.State) -> controls.Frame {
    return with resting { hovered: st.hovered, pressed: st.pressed, focused: st.focused }
}

fn load_one(paths: [string], what: string) -> Result<font.FontRef, string> {
    switch first_of(paths) {
        Some(f) { return ok(f) }
        None {
            return err(concat(
                "no usable ",
                what,
                " font. Set ZIMAN_GALLERY_FONT to a TrueType file. Tried: ",
                join(separator: ", ", pieces: paths)
            ))
        }
    }
}

// How many device pixels a point is: the user's own setting, what the display reports, or 1.0.
// A display's number is a guess about someone's eyes from the pixels on a panel -- right often
// enough to be the default, wrong often enough that overriding it has to be possible.
fn chosen_density() -> widget.Resolved {
    return widget.resolve_density(asked_scale(), window.display_scale())
}

fn asked_scale() -> Option<float> {
    if Some(text) = os.get_env("ZIMAN_GALLERY_SCALE") {
        switch parse_float(trim(text)) {
            Ok(v) { return Option<float>.Some(v) }
            Err(_) { return Option<float>.None }
        }
    }
    return Option<float>.None
}

fn is_close(e: window.Event) -> bool {
    return switch e {
        Close { true }
        Exposed { false }
        KeyDown(_) { false }
        KeyUp(_) { false }
        Char(_) { false }
        PointerDown(_) { false }
        PointerUp(_) { false }
        PointerMove(_) { false }
        Scroll(_) { false }
        Resize(_) { false }
        FocusIn { false }
        FocusOut { false }
        SchemeChanged(_) { false }
    }
}

fn is_exposed(e: window.Event) -> bool {
    return switch e {
        Exposed { true }
        Close { false }
        KeyDown(_) { false }
        KeyUp(_) { false }
        Char(_) { false }
        PointerDown(_) { false }
        PointerUp(_) { false }
        PointerMove(_) { false }
        Scroll(_) { false }
        Resize(_) { false }
        FocusIn { false }
        FocusOut { false }
        SchemeChanged(_) { false }
    }
}

fn resized_to(e: window.Event) -> Option<window.Size> {
    return switch e {
        Resize(size) { Option<window.Size>.Some(size) }
        Exposed { Option<window.Size>.None }
        Close { Option<window.Size>.None }
        KeyDown(_) { Option<window.Size>.None }
        KeyUp(_) { Option<window.Size>.None }
        Char(_) { Option<window.Size>.None }
        PointerDown(_) { Option<window.Size>.None }
        PointerUp(_) { Option<window.Size>.None }
        PointerMove(_) { Option<window.Size>.None }
        Scroll(_) { Option<window.Size>.None }
        FocusIn { Option<window.Size>.None }
        FocusOut { Option<window.Size>.None }
        SchemeChanged(_) { Option<window.Size>.None }
    }
}

// The look to wear, for what the desktop says it wants.
//
// **Chosen from the register by scheme, not matched on a name** -- `theme.Look.scheme` exists for
// exactly this, and a program that looked for the word "dark" would be one look called "Midnight"
// away from being wrong. The gallery wears the modern family, which is also the only way anyone
// finds out that it is wrong about something.
//
// **`NoPreference` keeps the light one**, which is a policy and therefore this file's to make:
// the library reports and the application decides (D11).
fn look_for(want: window.Preference) -> controls.Style {
    val dark = switch want {
        Dark { true }
        Light { false }
        NoPreference { false }
    }
    for one in theme.all() {
        val is_dark = switch one.scheme {
            Dark { true }
            Light { false }
        }
        if one.name == "Modern" || one.name == "Modern dark" {
            if is_dark == dark {
                // The marks have to be characters the face actually has: `lib/ui` defaults to
                // triangles, which is right for a toolkit and wrong for whatever font a machine
                // happens to have. A face without U+25B8 would draw `.notdef` and every branch
                // would look alike.
                return one.style
            }
        }
    }
    return theme.modern()
}

// **The look's own colour behind every control, which this file used to argue was the renderer's.**
// The window is the largest area in the window, so a look that cannot name it cannot be dark;
// `Style.window` holds it and the clearing is still the application's, which is the part the old
// argument had right. Rebuilt when the look changes, because the window behind a dark look is not
// the window behind a light one.
fn options_for(look: controls.Style, faces: [font.FontRef], scale: float) -> raster.Options {
    return with raster.options() {
        fonts: faces,
        // The demo's own picture, made rather than loaded. See `pictures`.
        images: images,
        samples: 1,
        background: Option<paint.Color>.Some(look.window),
        max_pixels: ((8000000 as float) * scale * scale) as int,
        px_per_pt: scale
    }
}

// The preference a scheme change carries, or nothing for any other event.
fn scheme_asked(e: window.Event) -> Option<window.Preference> {
    return switch e {
        SchemeChanged(p) { Option<window.Preference>.Some(p) }
        Exposed { Option<window.Preference>.None }
        Close { Option<window.Preference>.None }
        KeyDown(_) { Option<window.Preference>.None }
        KeyUp(_) { Option<window.Preference>.None }
        Char(_) { Option<window.Preference>.None }
        PointerDown(_) { Option<window.Preference>.None }
        PointerUp(_) { Option<window.Preference>.None }
        PointerMove(_) { Option<window.Preference>.None }
        Scroll(_) { Option<window.Preference>.None }
        Resize(_) { Option<window.Preference>.None }
        FocusIn { Option<window.Preference>.None }
        FocusOut { Option<window.Preference>.None }
    }
}

fn run() -> Result<unit, string> {
    val faces = try load_fonts()
    val m = try widget.metrics_for_faces(faces)
    // **The window says which density it chose and where that came from.**
    //
    // `resolve_density` has always answered with a `Source` -- UserSetting, Display or Default --
    // and nothing read it, so a run that fell back to 1.0 because the display said nothing looked
    // exactly like a run on a 1x display. That is why "display_scale answers 1x or 2x
    // inconsistently" sat unchased for weeks: the evidence was a screenshot of the wrong size,
    // taken after the fact, with nothing to say whether `Xft.dpi` had been read or missed.
    //
    // One line on stderr, once, at startup. The next time it happens it says so.
    val resolved = chosen_density()
    val density = resolved.density
    // **Through `/dev/stderr` rather than `print`, and that is the trap this diagnostic exists to
    // survive.** `print` is block-buffered when standard output is a file, and a window never
    // exits, so a line printed at startup sits in the buffer for the life of the program -- which
    // is exactly how instrumentation disappears when someone redirects a run to a log in order to
    // read it later. Opening, writing and closing flushes.
    switch fs.append_text("/dev/stderr", concat(
        "gallery: ",
        format("{:.3}", density.px_per_pt),
        "x from ",
        switch resolved.from {
            UserSetting { "ZIMAN_GALLERY_SCALE" }
            Display { "the display" }
            Default { "nothing -- the display did not say, so 1x" }
        },
        "\n"
    )) {
        Ok(_) { unit }
        Err(_) { unit }
    }
    val scale = density.px_per_pt
    val outcome = window.with_window<unit>(
        "ziman gallery",
        ((start_width as float) * scale) as int,
        ((start_height as float) * scale) as int,
        fn(w: window.Window) -> Result<unit, string> {
            var painter = try desktop.painter_of(start_width as float, start_height as float, scale)
            // **The desktop is asked once here and answered again whenever it changes.** GNOME's
            // automatic dark mode switches at sunset, so a window that read this only at startup
            // would go stale in the middle of an ordinary session -- which is why `poll` delivers
            // a `SchemeChanged` and why these three are variables.
            var style = look_for(window.color_scheme())
            var resting = controls.frame_of(style, m)
            var options = options_for(style, faces, scale)
            var st = with state.opening_state(resting) { window_width: start_width as float }
            // The accessibility bridge is optional and its absence is not an error: said once and
            // then left alone, which is what curly's window does with the same two calls.
            var readable = switch atspi.publish(a11y.tree_of(
                widget.layout(
                    state.view(st, frame_at(resting, st)),
                    geom.rect_of(0.0, 0.0, start_width as float, start_height as float),
                    m
                ),
                "ziman gallery",
                st.focused
            ), "ziman gallery") {
                Ok(_) { true }
                Err(_) { false }
            }
            // The tree as it was last published, which is what a live region's words are compared
            // against. Empty to begin with, so a region that is there on the first frame counts as
            // having appeared -- which is what makes an error banner speak when it opens.
            var spoken = a11y.no_tree()
            var width_pt = start_width as float
            var height_pt = start_height as float
            var closing = false
            // **The laid-out tree outlives the frame that made it**: it is both what is drawn and
            // what an input is routed by, and an idle window needs the second long after it has
            // stopped needing the first.
            var laid = widget.layout(
                state.view(st, frame_at(resting, st)),
                geom.rect_of(0.0, 0.0, width_pt, height_pt),
                m
            )
            // Nothing is rebuilt until something changes it. An idle window costs a sleep and a
            // poll; rebuilding, laying out, painting and diffing sixty times a second to discover
            // that nothing moved is what this flag is for.
            var dirty = true
            while !closing {
                if dirty {
                    // Laid out once per pass and used for both halves -- the scene to draw and the
                    // geometry an input is routed by. Two layouts could disagree, and a press would
                    // land on where a control used to be.
                    //
                    // **Laid out twice when a demo has something open, and only then.** A popup
                    // belongs under the control that opened it, and where that is cannot be known
                    // until the tree has been laid out: the first pass finds it and the second
                    // puts the popup there. A modal dialog needs the second pass too, though it
                    // centres itself -- it is a layer either way.
                    val whole = geom.rect_of(0.0, 0.0, width_pt, height_pt)
                    val f = frame_at(resting, st)
                    val base = state.view(st, f)
                    val first = widget.layout(base, whole, m)
                    laid = switch state.layer_of(st, first, f) {
                        Some(over) { widget.layout(widget.layered_of([widget.base_layer(base), over]), whole, m) }
                        None { first }
                    }
                    // The focus is drawn: Tab moves it and every control takes its keys, so a
                    // window that looked identical either way would make the focus invisible.
                    //
                    // **The hover is no longer painted here, and that is F294.** This used to lay
                    // a translucent veil over the finished tree from `st.hovered`, because a veil
                    // was the only thing a post-pass could do; the name now reaches the control in
                    // the frame and the control draws itself in its hovered row, edge, corner,
                    // words and all. The focus ring stays a pass, because focus is *additive* --
                    // a control can be focused and hovered and pressed at once, so it cannot be
                    // one of five exclusive rows.
                    //
                    // **The theme's accent, not a blue written here.** This call site was the only
                    // place the identity colour lived, which is what made it worth a token.
                    val with_focus = widget.paint_focused(laid, m, st.focused, style.accent, 2.0)
                    // Painted after the layout, because only the layout knows how tall a viewport
                    // turned out to be -- and a thumb's length is the view's share of the content.
                    val painted = try desktop.repaint(
                        painter,
                        w,
                        controls.paint_scroll_bars(laid, with_focus, f),
                        options
                    )
                    painter = painted.next
                    if readable {
                        // **The tree is published and then diffed against the last one**, which is
                        // how a live region speaks: a reader is a cursor and reads what the user
                        // arrives at, so a count that changed under their typing would otherwise
                        // be said to nobody. `a11y.announcements` is a pure function of two trees
                        // and this is the state it needs -- threaded through the loop exactly as
                        // `hovered`, `pressed` and `focused` already are.
                        val now = a11y.tree_of(laid, "ziman gallery", st.focused)
                        switch atspi.publish(now, "ziman gallery") {
                            Ok(_) {
                                for said in a11y.announcements(spoken, now) {
                                    atspi.announce(said)
                                }
                                spoken = now
                            }
                            Err(_) { readable = false }
                        }
                    }
                    dirty = false
                }
                if readable {
                    atspi.pump()
                }
                for e in try window.poll(w) {
                    if is_close(e) {
                        closing = true
                    }
                    // The contents are gone and the scene has not changed, so without this the
                    // window would stay as the compositor left it.
                    if is_exposed(e) {
                        painter = desktop.forget(painter)
                        dirty = true
                    }
                    if Some(want) = scheme_asked(e) {
                        // **Everything the look touches is rebuilt**, which is three things: the
                        // frame every control is drawn in, the colour behind them, and the painter,
                        // whose last scene is in the old colours and would otherwise be diffed
                        // against the new one and found "unchanged".
                        style = look_for(want)
                        resting = controls.frame_of(style, m)
                        options = options_for(style, faces, scale)
                        painter = desktop.forget(painter)
                        dirty = true
                    }
                    if Some(size) = resized_to(e) {
                        width_pt = (size.width as float) / scale
                        height_pt = (size.height as float) / scale
                        // The split pane's divider is at a position in points and `view` is handed
                        // no bounds to clamp it against, so the state carries the width too.
                        st = with st { window_width: width_pt }
                        dirty = true
                    }
                    // **`input_in` and not `input_of`**, which is the one difference a real
                    // application makes: it can reach the clipboard, so Ctrl+V arrives as the text
                    // it means rather than as a keystroke nothing answers. `input_of` stays pure
                    // for everything that replays recorded events without a window.
                    if Some(input) = desktop.input_in(w, e, density) {
                        // **The pointer's shape, on every move.** `controls.cursor_at` reads it
                        // off the laid tree by role, so this is the whole of the wiring an
                        // application needs -- and without it the window showed an arrow over the
                        // split pane's divider, which is the one control whose entire affordance
                        // is the cursor. `set_cursor` compares against the shape the window is
                        // already showing, so a move that changes nothing costs an X round trip
                        // of nothing.
                        if Move(at) = input {
                            switch desktop.set_cursor(w, controls.cursor_at(laid, at)) {
                                Ok(_) { unit }
                                Err(_) { unit }
                            }
                        }
                        // Every input marks the frame dirty rather than each branch deciding: a
                        // control that changed nothing is the cheap wrong answer, and one that
                        // changed something and did not say so is a window that stops repainting.
                        dirty = true
                        st = state.step(st, input, laid, frame_at(resting, st))
                    }
                }
                // **The one demo that moves gets its next frame**, and says so by answering at
                // all: a demo with no animation returns nothing and the window stays as it was.
                // This is the only thing in the gallery that repaints without an event, which is
                // what an animation is.
                if Some(moved) = state.ticked(st, frame_at(resting, st)) {
                    st = moved
                    dirty = true
                }
                // A frame budget, not a frame rate.
                clock.sleep_millis(16)
            }
            return ok(unit)
        }
    )
    return outcome
}
