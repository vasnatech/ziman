{
  "name": "ziman",
  "displayName": "Ziman",
  "description": "Syntax highlighting for the Ziman programming language (.zm files)",
  "version": "0.1.0",
  "publisher": "ziman-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "ziman",
        "aliases": ["Ziman", "ziman"],
        "extensions": [".zm"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ziman",
        "scopeName": "source.ziman",
        "path": "./syntaxes/ziman.tmLanguage.json"
      }
    ]
  }
}
