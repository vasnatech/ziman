{
  "name": "ziman",
  "displayName": "Ziman",
  "description": "Ziman language support: syntax highlighting and a language server client (.zm files)",
  "version": "0.2.0",
  "publisher": "ziman-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ziman",
        "aliases": [
          "Ziman",
          "ziman"
        ],
        "extensions": [
          ".zm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ziman",
        "scopeName": "source.ziman",
        "path": "./syntaxes/ziman.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Ziman",
      "properties": {
        "ziman.serverPath": {
          "type": "string",
          "default": "ziman",
          "description": "Path to the ziman executable (run as `ziman --lsp`)."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ziman"
  ],
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "icon": "icon.png"
}
