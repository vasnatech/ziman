{
  "main": {
    "prefix": "main",
    "body": ["fn main() {", "\t$0", "}"],
    "description": "The program's entry point"
  },
  "fn": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:param}: ${3:int}) -> ${4:int} {", "\t$0", "}"],
    "description": "A function"
  },
  "pub fn": {
    "prefix": "pubfn",
    "body": ["// ${1:What it does.}", "pub fn ${2:name}(${3:param}: ${4:int}) -> ${5:int} {", "\t$0", "}"],
    "description": "A public function with its comment"
  },
  "fn returning Result": {
    "prefix": "fnr",
    "body": ["fn ${1:name}(${2:param}: ${3:string}) -> Result<${4:int}, ${5:string}> {", "\t$0", "}"],
    "description": "A function that can fail"
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "\t${2:field}: ${3:string}", "}"],
    "description": "A struct"
  },
  "enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "\t${2:First}", "\t${3:Second}(${4:string})", "}"],
    "description": "An enum; a variant may carry one payload"
  },
  "derive": {
    "prefix": "derive",
    "body": ["#[derive(${1|Json,Row|})]"],
    "description": "A derive attribute"
  },
  "switch": {
    "prefix": "switch",
    "body": ["switch ${1:value} {", "\t${2:Variant}${3:(v)} { $4 }", "\t$0", "}"],
    "description": "Switch on an enum"
  },
  "switch on Result": {
    "prefix": "switchr",
    "body": ["val ${1:result} = ${2:call()}", "return switch ${1:result} {", "\tOk(${3:value}) { $4 }", "\tErr(${5:failure}) { $6 }", "}"],
    "description": "Switch on a Result"
  },
  "if": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "\t$0", "}"]
  },
  "if else": {
    "prefix": "ifelse",
    "body": ["if ${1:condition} {", "\t$2", "} else {", "\t$0", "}"]
  },
  "for": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:items} {", "\t$0", "}"]
  },
  "for with index": {
    "prefix": "fori",
    "body": ["for ${1:i}, ${2:item} in ${3:items} {", "\t$0", "}"]
  },
  "for range": {
    "prefix": "forr",
    "body": ["for ${1:i} in 0..${2:n} {", "\t$0", "}"]
  },
  "while": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "\t$0", "}"]
  },
  "val": {
    "prefix": "val",
    "body": ["val ${1:name} = $0"]
  },
  "val with ?": {
    "prefix": "valq",
    "body": ["val ${1:name} = ${2:call()}?"],
    "description": "Unwrap a Result or Option, returning early on the failure"
  },
  "use": {
    "prefix": "use",
    "body": ["use ${1:module}"]
  },
  "use as": {
    "prefix": "usea",
    "body": ["use ${1:path/to/module} as ${2:alias}"]
  },
  "use name": {
    "prefix": "usen",
    "body": ["use ${1:module}.${2:Name}"]
  },
  "spawn": {
    "prefix": "spawn",
    "body": ["spawn ${1:worker}(${2:args})"]
  },
  "defer": {
    "prefix": "defer",
    "body": ["defer ${1:close(handle)}"]
  },
  "text block": {
    "prefix": "block",
    "body": ["\"\"\"", "\t$0", "\"\"\""],
    "description": "A multi-line text block"
  },
  "print": {
    "prefix": "pr",
    "body": ["print($0)"]
  }
}
