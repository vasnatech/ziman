{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ziman",
  "scopeName": "source.ziman",
  "fileTypes": ["zm"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#text-blocks" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#attributes" },
    { "include": "#primitive-types" },
    { "include": "#builtin-types" },
    { "include": "#builtin-functions" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#function-calls" },
    { "include": "#type-names" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ziman",
          "match": "//.*$"
        }
      ]
    },
    "text-blocks": {
      "name": "string.quoted.triple.ziman",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "name": "constant.character.escape.ziman",
          "match": "\\\\[ntr\"\\\\]"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ziman",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ziman",
          "match": "\\\\[ntr\"\\\\]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "comment": "bigint (123n), decimal (19.99d) and byte (200b) literals",
          "name": "constant.numeric.suffixed.ziman",
          "match": "\\b[0-9]+(\\.[0-9]+)?[nd]\\b|\\b[0-9]+b\\b"
        },
        {
          "name": "constant.numeric.float.ziman",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.ziman",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.ziman",
      "match": "\\b(true|false)\\b"
    },
    "primitive-types": {
      "name": "support.type.primitive.ziman",
      "match": "\\b(int|float|bool|string|bigint|decimal|byte|unit)\\b"
    },
    "attributes": {
      "comment": "#[derive(Json, Ord, ...)] and the module-level #![experimental] / #![deprecated(\"...\")]. The `!` is optional: without it this rule did not match the module form at all, so the `!` coloured as logical-not and the attribute name was left bare (docs/reviews/tasks.md F75).",
      "name": "meta.attribute.ziman",
      "match": "#!?\\[[^\\]]*\\]"
    },
    "builtin-types": {
      "comment": "the language's built-in generic types",
      "name": "support.type.builtin.ziman",
      "match": "\\\\b(Channel|Guard|Iter|Map|MapEntry|Mutable|MutableArray|MutableMap|MutableSet|MutableString|Option|Result|Selected|Set)\\\\b"
    },
    "builtin-functions": {
      "comment": "builtins available without a use; a call to one is highlighted as a builtin, not an ordinary function",
      "name": "support.function.builtin.ziman",
      "match": "\\\\b(abs|add|all|any|append|append_byte|binary_search|bytes_to_string|channel_close|channel_len|channel_new|char_at|char_count|chars|clear|compare|concat|contains|count|difference|discard|distinct|ends_with|entries|equals_ignore_case|err|error_message|filter|filter_err|filter_ok|filter_present|find|first|flat_map|fold|for_each|format|format_dynamic|frequencies|get|get_or|group_by|guard_new|hash|index_by|index_of|insert|intersect|inverse|is_None|is_Some|is_blank|is_char_at|is_empty|is_ok|is_sorted|is_subset|items|iter|iter_close|iter_from|iter_next|join|keys|last|last_index_of|len|lines|lower_bound|map|max|max_by|merge|min|min_by|mutable|mutable_array_filled|mutable_array_new|mutable_get|mutable_map_new|mutable_new|mutable_set|mutable_set_new|mutable_string_get|mutable_string_index_of|mutable_string_last_index_of|mutable_string_new|mutable_string_set|narrow|ok|option_to_result|parse_bigint|parse_decimal|parse_float|parse_int|print|printf|push|receive|receive_option|receive_timeout|remove|remove_all|replace|result_map_err|result_to_option|reverse|reverse_string|select2|send|set|slice|snapshot|sort|sort_by|sort_by_desc|sort_desc|sort_with|split|split_once|starts_with|str|string_to_bytes|substring|sum|swap|to_lower|to_mutable_set|to_set|to_upper|trim|truncate_chars|try_receive|try_send|union|unwrap|unwrap_Some|unwrap_err|update|update_all|upper_bound|values)(?=\\\\s*[(<])"
    },
    "declarations": {
      "comment": "Captures the name at a fn/struct declaration site distinctly from an ordinary reference to it.",
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.function.ziman" },
            "2": { "name": "entity.name.function.ziman" }
          }
        },
        {
          "match": "\\b(struct)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.struct.ziman" },
            "2": { "name": "entity.name.type.struct.ziman" }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.enum.ziman" },
            "2": { "name": "entity.name.type.enum.ziman" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ziman",
          "match": "\\b(if|else|while|for|in|break|continue|spawn|return|switch|defer|try)\\b"
        },
        {
          "name": "keyword.control.import.ziman",
          "match": "\\b(use|as)\\b"
        },
        {
          "name": "keyword.other.ziman",
          "match": "\\b(with)\\b"
        },
        {
          "comment": "All three visibility levels, plus `variadic`, which modifies a parameter's type (`xs: variadic int`) rather than a declaration but belongs to the same family and is a hard keyword, so unlike `internal` it cannot be miscoloured. `internal` was missing, so one of exactly three was invisible; it is a soft keyword, so `val internal = 1` miscolours it -- the same trade the grammar already accepts for `unit` (docs/reviews/tasks.md F75).",
          "name": "storage.modifier.ziman",
          "match": "\\b(pub|internal|native|builtin|variadic)\\b"
        },
        {
          "comment": "val and var are separate scopes so a theme can tell them apart. They differ by one character and that character flips mutability, which DESIGN.md's own \"val/var differ by one character\" entry names as a hazard and names colour as the answer; sharing one scope made that impossible. A use site still has no scope -- that needs semantic tokens (docs/reviews/tasks.md F76).",
          "name": "storage.modifier.immutable.ziman",
          "match": "\\b(val)\\b"
        },
        {
          "name": "storage.modifier.mutable.ziman",
          "match": "\\b(var)\\b"
        },
        {
          "comment": "Bare fn/struct/enum fallback -- 'declarations' already handles the common case of a keyword immediately followed by a valid name.",
          "name": "storage.type.ziman",
          "match": "\\b(fn|struct|enum)\\b"
        }
      ]
    },
    "function-calls": {
      "comment": "A lowercase identifier immediately before '(' -- reliable in Ziman since call syntax is always IDENT(...) or qualifier.IDENT(...), never an arbitrary expression.",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()",
      "name": "entity.name.function.ziman"
    },
    "type-names": {
      "comment": "Ziman enforces PascalCase for struct/type names (a value or function name can never start uppercase), so this is a reliable syntactic signal, not a guess.",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.ziman"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ziman",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.ziman",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.ziman",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.ziman",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.ziman",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.ziman",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    }
  }
}
