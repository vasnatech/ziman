{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ziman",
  "scopeName": "source.ziman",
  "fileTypes": ["zm"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#text-blocks" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#attributes" },
    { "include": "#primitive-types" },
    { "include": "#builtin-types" },
    { "include": "#builtin-functions" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#function-calls" },
    { "include": "#type-names" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ziman",
          "match": "//.*$"
        }
      ]
    },
    "text-blocks": {
      "name": "string.quoted.triple.ziman",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "name": "constant.character.escape.ziman",
          "match": "\\\\[ntr\"\\\\]"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ziman",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ziman",
          "match": "\\\\[ntr\"\\\\]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "comment": "bigint (123n), decimal (19.99d) and byte (200b) literals",
          "name": "constant.numeric.suffixed.ziman",
          "match": "\\b[0-9]+(\\.[0-9]+)?[nd]\\b|\\b[0-9]+b\\b"
        },
        {
          "name": "constant.numeric.float.ziman",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.ziman",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.ziman",
      "match": "\\b(true|false)\\b"
    },
    "primitive-types": {
      "name": "support.type.primitive.ziman",
      "match": "\\b(int|float|bool|string|bigint|decimal|byte|unit)\\b"
    },
    "attributes": {
      "comment": "#[derive(Json, Ord, ...)]",
      "name": "meta.attribute.ziman",
      "match": "#\\[[^\\]]*\\]"
    },
    "builtin-types": {
      "comment": "the language's built-in generic types",
      "name": "support.type.builtin.ziman",
      "match": "\\b(Result|Option|Channel|Map|Set|MapBuilder|SetBuilder|ArrayBuilder|StringBuilder)\\b"
    },
    "builtin-functions": {
      "comment": "builtins available without a use; a call to one is highlighted as a builtin, not an ordinary function",
      "name": "support.function.builtin.ziman",
      "match": "\\b(print|printf|format|str|len|push|insert|set|remove|contains|hash|compare|abs|min|max|ok|err|is_ok|unwrap|unwrap_err|channel_new|send|receive|try_send|try_receive|channel_len|map_get|map_keys|map_values|set_items|map_get_or|map_merge|map_filter|map_remove_all|map_from_arrays|set_union|set_intersect|set_difference|set_is_subset|set_from_array|set_insert_all|set_filter|concat_arrays|sb_new|sb_append|sb_append_byte|sb_to_string|sb_len|ab_new|ab_append|ab_to_array|ab_len|mapb_new|mapb_set|mapb_get|mapb_remove|mapb_contains|mapb_len|mapb_to_map|setb_new|setb_add|setb_remove|setb_contains|setb_len|setb_to_set|string_to_bytes|bytes_to_string|bytes_concat)(?=\\s*[(<])"
    },
    "declarations": {
      "comment": "Captures the name at a fn/struct declaration site distinctly from an ordinary reference to it.",
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.function.ziman" },
            "2": { "name": "entity.name.function.ziman" }
          }
        },
        {
          "match": "\\b(struct)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.struct.ziman" },
            "2": { "name": "entity.name.type.struct.ziman" }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.enum.ziman" },
            "2": { "name": "entity.name.type.enum.ziman" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ziman",
          "match": "\\b(if|else|while|for|in|break|continue|spawn|return|switch|defer|try)\\b"
        },
        {
          "name": "keyword.control.import.ziman",
          "match": "\\b(use|as)\\b"
        },
        {
          "name": "keyword.other.ziman",
          "match": "\\b(with)\\b"
        },
        {
          "name": "storage.modifier.ziman",
          "match": "\\b(pub|native|val|var)\\b"
        },
        {
          "comment": "Bare fn/struct/enum fallback -- 'declarations' already handles the common case of a keyword immediately followed by a valid name.",
          "name": "storage.type.ziman",
          "match": "\\b(fn|struct|enum)\\b"
        }
      ]
    },
    "function-calls": {
      "comment": "A lowercase identifier immediately before '(' -- reliable in Ziman since call syntax is always IDENT(...) or qualifier.IDENT(...), never an arbitrary expression.",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()",
      "name": "entity.name.function.ziman"
    },
    "type-names": {
      "comment": "Ziman enforces PascalCase for struct/type names (a value or function name can never start uppercase), so this is a reliable syntactic signal, not a guess.",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.ziman"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ziman",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.ziman",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.ziman",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.ziman",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.ziman",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.ziman",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    }
  }
}
