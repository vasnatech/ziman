// Exercises every construct the grammar highlights -- open this file to eyeball a grammar change.
//
// **`make showcase-check` compiles it**, which is the only thing keeping the claim above true. It
// did not until 2026-10-21, and by then it called `set_union` and `map_get`, both renamed to `union`
// and `get` in the Map/Set pairing pass (F195-F201) -- so the file a new user opens to see the
// highlighting had named two functions that no longer exist for three passes. Nothing compiled it,
// which is the same failure the grammar's own name lists had before `gen_vscode_grammar.py`
// derived them from `--api builtins`.
//
// Add a construct here whenever the grammar learns one: a rule with nothing to colour in this file
// is a rule nobody will notice breaking.

use models/user as u
use os

native fn read_file(path: string) -> string

struct Point {
    x: int
    y: int
}

enum Shape {
    Circle(float)
    Rectangle(Point)
    Origin
}

pub fn distance_squared(a: Point, b: Point) -> int {
    val dx = a.x - b.x
    val dy = a.y - b.y
    return dx * dx + dy * dy
}

fn double_worker(inbox: Channel<int>, reply: Channel<int>) {
    val n = receive(inbox)
    send(reply, n * 2)
}

// **An attribute whose message contains `[`, `]` and quotes**, which broke highlighting for the
// rest of the file until 2026-10-22: the grammar's attribute rule was one `match` of
// `#!?\[[^\]]*\]`, a negated class that cannot see past the `]` in `'[]'`. The scan ended inside
// the message, the remainder coloured as code, and the closing quote opened a string that ran to
// the end of the file -- 191 lines of lib/prelude/array.zm, measured with vscode-textmate. The rule
// is a begin/end pair including `#strings` now, and `tools/check_grammar.py` keeps it that way.
// This line is the shape that found it; if the highlighting below is a single string colour, that
// rule has regressed.
#[deprecated("replaced -- an empty list is '[]' and an empty map is 'Map<K, V> {}'")]
fn superseded() -> int {
    return 7
}

#[derive(Json)]
struct Profile {
    scores: Map<string, int>
    tags: Set<string>
}

fn maps_and_sets() {
    var scores = Map<string, int> { "ann": 12, "bob": 3 }
    scores = set(scores, "cy", 40)
    for name, score in scores {
        printf("{} = {}\n", name, score)
    }
    val tags = union(Set<string> { "a" }, Set<string> { "b" })
    print(get(scores, "ann"))
    print(contains(tags, "a"))
    val amount: decimal = 19.99d + 0.01d
    val level: byte = 200b
    val huge: bigint = 123456789012345678901234567890n
    print(amount)
    print(level)
    print(huge)
}

// The builder half of the two collection worlds, and the one place `snapshot` reads as the
// crossing it is.
fn builders() -> [string] {
    val names = mutable_array_new<string>()
    push(names, "ada", "grace")
    val text = mutable_string_new()
    append(text, "hello", ", ", "world")
    print(snapshot(text))
    print(len(names))
    return snapshot(names)
}

// `variadic` on a parameter, `internal` on a declaration, and a `unit` return written out: three
// things the grammar colours that nothing else here was exercising.
internal fn total(label: string, values: variadic int) -> unit {
    var sum = 0
    for v in values {
        sum = sum + v
    }
    printf("{} = {}\n", label, sum)
}

// `switch`, `defer`, `try` and a `Result`, with `ok`/`err` -- and a text block, which the grammar
// has a rule of its own for. `switch` covers every variant and has no default arm, so adding one to
// `Shape` turns this into a compile error rather than into a silent fallthrough.
fn classify(shape: Shape) -> Result<string, string> {
    defer print("classified")
    val word = switch shape {
        Circle(r) { concat("circle ", str(r)) }
        Rectangle(corner) { concat("rect ", str(corner.x)) }
        Origin { "origin" }
    }
    if len(word) == 0 {
        return err("empty")
    }
    return ok(word)
}

fn report() -> Result<string, string> {
    val word = try classify(Shape.Circle(2.0))
    val banner = """
        a text block keeps its newlines
        and needs no escaping for "quotes"
        """
    print(banner)
    return ok(word)
}

// `Type::field`, the field-accessor shorthand: `Point::x` is `fn(p: Point) { p.x }`, and the
// grammar colours `::` as one operator with a property after it. No type arguments: `map`'s result
// type is read off the lambda's body, which it was not until 2026-10-21 -- this line had to be
// `map<Point, int>(points, Point::x)`, naming both the type the field is read from and the field's
// own type, at a call site whose whole point is not naming them.
fn accessors(points: [Point]) -> [int] {
    return map(points, Point::x)
}

fn main() {
    val p1 = Point { x: 0, y: 0 }
    val p2 = Point { x: 3, y: 4 }
    print(distance_squared(p1, p2))

    val p3 = with p2 { x: 99 }
    print(p3)

    var i = 0
    var nums: [int] = []
    while i < 5 {
        nums = push(nums, i * i)
        i = i + 1
    }

    if len(nums) > 0 && nums[0] == 0 {
        print("starts at zero")
    } else if !true {
        print("unreachable")
    }

    for n in nums {
        print(n)
    }
    for idx in 0..len(nums) {
        print(idx)
    }
    for idx, n in nums {
        if n == 4 {
            continue
        }
        if n > 10 {
            break
        }
        print(idx)
        print(n)
    }

    val pi = 3.14
    val greeting = "hello \"world\"\n"
    val flag = true
    val ratio = (pi / 2.0) as int

    // These four are here to show a float, an escaped string, a bool and a cast to the
    // highlighter, and they are printed because a file shown off as exemplary should pass
    // `--lint` too -- which said all four were "never read" for as long as nothing ran the
    // linter over it.
    print(greeting)
    print(flag)
    print(ratio)

    val account = u.User { id: 1, name: "Ada" }
    print(u.greet(account))

    val shape = Shape.Circle(2.0)
    if Shape.is_Circle(shape) {
        print(Shape.unwrap_Circle(shape))
    }
    print(Shape.Origin == Shape.Origin)

    print(superseded())
    total("squares", 1, 4, 9)
    print(builders())
    print(unwrap(report()))
    print(accessors([p1, p2]))
    maps_and_sets()

    val work_in: Channel<int> = channel_new()
    val work_out: Channel<int> = channel_new()
    // `on_error os.fatal` because `receive(work_out)` below waits on that channel: a worker that
    // fails without a handler leaves the receive waiting for ever, which is what `--lint` says.
    spawn double_worker(work_in, work_out) on_error os.fatal
    send(work_in, 21)
    print(receive(work_out))
}
